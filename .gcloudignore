# Keep the Cloud Run build context tiny: only app/app.py + scripts/sr_engine.py
# are needed by the Dockerfile. Exclude everything heavy/irrelevant.
.git/
.venv/
__pycache__/
*.pyc
_test_outputs/
_generated/
Text BOOKS/
*.pdf
.env
schedule/*.log
schedule/_*.txt
schedule/_*.json
schedule/_*.log

# The owner's 28 recorded lectures: 14GB of MP4 sitting in the project folder.
# Cloud Build uploads the whole context, so leaving these in meant shipping 14GB
# to build an image that copies two Python files.
הקלטות לימודי המשך/
*.mp4
*.wav
*.png
_bulk/
_proto/
