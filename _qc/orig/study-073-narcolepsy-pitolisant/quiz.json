{
  "title": "Narcolepsy Quiz",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\u05e0\u05e2\u05e8\u05d4 \u05d1\u05ea 16 \u05de\u05d5\u05e4\u05e0\u05d9\u05ea \u05dc\u05d4\u05e2\u05e8\u05db\u05d4 \u05e2\u05e7\u05d1 \u05d9\u05e9\u05e0\u05d5\u05e0\u05d9\u05d5\u05ea \u05d9\u05d5\u05de\u05d9\u05ea \u05e7\u05e9\u05d4 (EDS) \u05d5\u05d4\u05d9\u05e8\u05d3\u05de\u05d5\u05d9\u05d5\u05ea \u05e4\u05ea\u05d0\u05d5\u05de\u05d9\u05d5\u05ea \u05d1\u05de\u05d4\u05dc\u05da \u05e9\u05d9\u05e2\u05d5\u05e8\u05d9\u05dd. \u05d4\u05d9\u05d0 \u05de\u05ea\u05d0\u05e8\u05ea \u05db\u05d9 \u05d1\u05e2\u05ea \u05e6\u05d7\u05d5\u05e7 \u05e2\u05dd \u05d7\u05d1\u05e8\u05d5\u05ea, \u05d4\u05d9\u05d0 \u05d7\u05e9\u05d4 \u05dc\u05e2\u05d9\u05ea\u05d9\u05dd \u05d7\u05d5\u05dc\u05e9\u05d4 \u05e4\u05ea\u05d0\u05d5\u05de\u05d9\u05ea \u05d1\u05d1\u05e8\u05db\u05d9\u05d9\u05dd \u05d4\u05de\u05d0\u05dc\u05e6\u05ea \u05d0\u05d5\u05ea\u05d4 \u05dc\u05d4\u05ea\u05d9\u05d9\u05e9\u05d1, \u05dc\u05dc\u05d0 \u05d0\u05d5\u05d1\u05d3\u05df \u05d4\u05db\u05e8\u05d4. \u05de\u05d4\u05d5 \u05e7\u05d5\u05d3 \u05d4-ICD-10 \u05d4\u05de\u05ea\u05d0\u05d9\u05dd \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05e1\u05d1\u05d9\u05e8\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d1\u05de\u05e7\u05e8\u05d4 \u05d6\u05d4, \u05d5\u05de\u05d4\u05d5 \u05d4\u05de\u05de\u05e6\u05d0 \u05d4\u05d0\u05d1\u05d7\u05e0\u05ea\u05d9 \u05d4\u05e6\u05e4\u05d5\u05d9 \u05d1-CSF?",
      "answerOptions": [
        {
          "text": "\u05e7\u05d5\u05d3 G47.411; \u05e8\u05de\u05d5\u05ea Hypocretin-1 \u05e0\u05de\u05d5\u05db\u05d5\u05ea \u05de- $110\\text{ pg/mL}$.",
          "isCorrect": true,
          "rationale": "\u05d4\u05de\u05e7\u05e8\u05d4 \u05de\u05ea\u05d0\u05e8 Narcolepsy Type 1 (NT1) \u05d4\u05de\u05d0\u05d5\u05e4\u05d9\u05d9\u05df \u05d1\u05e7\u05d8\u05e4\u05dc\u05e7\u05e1\u05d9\u05d4 \u05d5\u05d3\u05d5\u05e8\u05e9 \u05e8\u05de\u05d5\u05ea Hypocretin-1 \u05e0\u05de\u05d5\u05db\u05d5\u05ea \u05d1-CSF (DSM p.422-424)."
        },
        {
          "text": "\u05e7\u05d5\u05d3 G47.419; \u05e8\u05de\u05d5\u05ea Hypocretin-1 \u05d1\u05d8\u05d5\u05d5\u05d7 \u05d4\u05e0\u05d5\u05e8\u05de\u05d4.",
          "isCorrect": false,
          "rationale": "\u05e7\u05d5\u05d3 G47.419 \u05de\u05ea\u05d9\u05d9\u05d7\u05e1 \u05dc-NT2, \u05d0\u05da \u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05e7\u05d8\u05e4\u05dc\u05e7\u05e1\u05d9\u05d4 (\u05d7\u05d5\u05dc\u05e9\u05d4 \u05d1\u05e6\u05d7\u05d5\u05e7) \u05de\u05db\u05d5\u05d5\u05d9\u05e0\u05d4 \u05dc\u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc NT1 (DSM p.422)."
        },
        {
          "text": "\u05e7\u05d5\u05d3 G47.411; \u05e8\u05de\u05d5\u05ea Histamine \u05e0\u05de\u05d5\u05db\u05d5\u05ea \u05d1-TMN.",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05e9-Histamine \u05de\u05e2\u05d5\u05e8\u05d1 \u05d1\u05e2\u05d5\u05e8\u05e8\u05d5\u05ea, \u05d4\u05de\u05d3\u05d3 \u05d4\u05d0\u05d1\u05d7\u05e0\u05ea\u05d9 \u05d1-CSF \u05dc\u05e0\u05e8\u05e7\u05d5\u05dc\u05e4\u05e1\u05d9\u05d4 \u05de\u05e1\u05d5\u05d2 1 \u05d4\u05d5\u05d0 Hypocretin-1 \u05d5\u05dc\u05d0 Histamine (StahlNeuro p.434)."
        },
        {
          "text": "\u05e7\u05d5\u05d3 F51.11; \u05e7\u05d9\u05e6\u05d5\u05e8 \u05e9\u05dc REM latency \u05de\u05ea\u05d7\u05ea \u05dc-15 \u05d3\u05e7\u05d5\u05ea.",
          "isCorrect": false,
          "rationale": "\u05e7\u05d5\u05d3 F51.11 \u05de\u05ea\u05d9\u05d9\u05d7\u05e1 \u05dc-Hypersomnolence Disorder, \u05e9\u05d0\u05d9\u05e0\u05d5 \u05db\u05d5\u05dc\u05dc \u05e7\u05d8\u05e4\u05dc\u05e7\u05e1\u05d9\u05d4 \u05d0\u05d5 \u05de\u05de\u05e6\u05d0\u05d9 REM \u05e4\u05ea\u05d5\u05dc\u05d5\u05d2\u05d9\u05d9\u05dd \u05d1-PSG \u05db\u05e4\u05d9 \u05e9\u05de\u05ea\u05d5\u05d0\u05e8 \u05d1\u05e0\u05e8\u05e7\u05d5\u05dc\u05e4\u05e1\u05d9\u05d4 (DSM p.417, p.428)."
        }
      ],
      "hint": "\u05d6\u05d4\u05d5 \u05d0\u05ea \u05d4\u05e7\u05e9\u05e8 \u05d1\u05d9\u05df \u05e7\u05d8\u05e4\u05dc\u05e7\u05e1\u05d9\u05d4 \u05dc\u05e1\u05d5\u05d2 \u05d4\u05e0\u05e8\u05e7\u05d5\u05dc\u05e4\u05e1\u05d9\u05d4 \u05d4\u05e1\u05e4\u05e6\u05d9\u05e4\u05d9 \u05d5\u05d4\u05de\u05e8\u05e7\u05e8 \u05d4\u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d4\u05de\u05d5\u05d1\u05d4\u05e7 \u05e9\u05dc\u05d4.",
      "citation": "(DSM p.422, p.424; StahlNeuro p.434)"
    },
    {
      "type": "multiple_choice",
      "question": "\u05d9\u05dc\u05d3 \u05d1\u05df 8 \u05de\u05d5\u05d1\u05d0 \u05dc\u05de\u05e8\u05e4\u05d0\u05d4 \u05e2\u05e7\u05d1 \u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea, \u05ea\u05d5\u05e7\u05e4\u05e0\u05d5\u05ea \u05d5\u05d9\u05e8\u05d9\u05d3\u05d4 \u05d1\u05dc\u05d9\u05de\u05d5\u05d3\u05d9\u05dd. \u05d4\u05d4\u05d5\u05e8\u05d9\u05dd \u05de\u05e6\u05d9\u05d9\u05e0\u05d9\u05dd \u05db\u05d9 \u05d4\u05d9\u05dc\u05d3 \u05e2\u05dc\u05d4 \u05d1\u05de\u05e9\u05e7\u05dc \u05d1\u05d0\u05d5\u05e4\u05df \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9 \u05d1\u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05d4\u05d0\u05d7\u05e8\u05d5\u05e0\u05d9\u05dd \u05d5\u05e0\u05e8\u05d0\u05d4 '\u05e2\u05d9\u05d9\u05e3 \u05ea\u05de\u05d9\u05d3\u05d9\u05ea', \u05d0\u05dd \u05db\u05d9 \u05d4\u05d5\u05d0 \u05de\u05ea\u05e0\u05d2\u05d3 \u05dc\u05e9\u05d9\u05e0\u05d4. \u05d1\u05d1\u05d3\u05d9\u05e7\u05d4 \u05d2\u05d5\u05e4\u05e0\u05d9\u05ea \u05e0\u05e6\u05e4\u05d5 \u05e1\u05d9\u05de\u05e0\u05d9\u05dd \u05e9\u05dc Precocious puberty. \u05e2\u05dc \u05e4\u05d9 \u05d4-Dulcan, \u05de\u05d4\u05d5 \u05d4\u05e6\u05e2\u05d3 \u05d4\u05d1\u05d0 \u05d4\u05de\u05d5\u05de\u05dc\u05e5 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d1\u05d4\u05e2\u05e8\u05db\u05d4 \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9\u05ea?",
      "answerOptions": [
        {
          "text": "\u05d4\u05e4\u05e0\u05d9\u05d4 \u05dc\u05de\u05e2\u05d1\u05d3\u05ea \u05e9\u05d9\u05e0\u05d4 \u05dc\u05d1\u05d9\u05e6\u05d5\u05e2 PSG \u05d5-MSLT \u05dc\u05e9\u05dc\u05d9\u05dc\u05ea \u05e0\u05e8\u05e7\u05d5\u05dc\u05e4\u05e1\u05d9\u05d4.",
          "isCorrect": true,
          "rationale": "\u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05e6\u05e2\u05d9\u05e8\u05d9\u05dd, \u05e0\u05e8\u05e7\u05d5\u05dc\u05e4\u05e1\u05d9\u05d4 \u05e2\u05dc\u05d5\u05dc\u05d4 \u05dc\u05d4\u05d5\u05e4\u05d9\u05e2 \u05e2\u05dd \u05ea\u05d5\u05e7\u05e4\u05e0\u05d5\u05ea, \u05d4\u05e9\u05de\u05e0\u05d4 \u05d5\u05d4\u05ea\u05d1\u05d2\u05e8\u05d5\u05ea \u05de\u05d5\u05e7\u05d3\u05de\u05ea, \u05d5\u05dc\u05db\u05df \u05e0\u05d3\u05e8\u05e9\u05ea \u05d4\u05e2\u05e8\u05db\u05d4 \u05d0\u05d5\u05d1\u05d9\u05d9\u05e7\u05d8\u05d9\u05d1\u05d9\u05ea \u05d1\u05de\u05e2\u05d1\u05d3\u05ea \u05e9\u05d9\u05e0\u05d4 (Dulcan p.483-484, p.490)."
        },
        {
          "text": "\u05d4\u05ea\u05d7\u05dc\u05ea \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Methylphenidate \u05d1\u05d7\u05e9\u05d3 \u05dc-ADHD \u05e2\u05dd Comorbid obesity.",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05e9\u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05de\u05d6\u05db\u05d9\u05e8\u05d9\u05dd ADHD, \u05d4\u05e6\u05d9\u05e8\u05d5\u05e3 \u05e9\u05dc \u05d4\u05e9\u05de\u05e0\u05d4 \u05de\u05d4\u05d9\u05e8\u05d4 \u05d5\u05d4\u05ea\u05d1\u05d2\u05e8\u05d5\u05ea \u05de\u05d5\u05e7\u05d3\u05de\u05ea \u05de\u05d7\u05d9\u05d9\u05d1 \u05e9\u05dc\u05d9\u05dc\u05ea \u05e0\u05e8\u05e7\u05d5\u05dc\u05e4\u05e1\u05d9\u05d4 \u05dc\u05e4\u05e0\u05d9 \u05d8\u05d9\u05e4\u05d5\u05dc \u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d8\u05d9 (Dulcan p.483, p.490)."
        },
        {
          "text": "\u05d1\u05d9\u05e6\u05d5\u05e2 \u05d1\u05d3\u05d9\u05e7\u05ea \u05d3\u05dd \u05dc\u05e8\u05de\u05d5\u05ea TSH \u05d5-Glucose \u05dc\u05e9\u05dc\u05d9\u05dc\u05ea \u05de\u05e6\u05d1\u05d9\u05dd \u05d0\u05e0\u05d3\u05d5\u05e7\u05e8\u05d9\u05e0\u05d9\u05d9\u05dd.",
          "isCorrect": false,
          "rationale": "\u05d1\u05e2\u05d5\u05d3 \u05e9\u05d1\u05d9\u05e8\u05d5\u05e8 \u05d0\u05e0\u05d3\u05d5\u05e7\u05e8\u05d9\u05e0\u05d9 \u05d7\u05e9\u05d5\u05d1, \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05de\u05d1\u05d3\u05dc\u05ea \u05d4\u05e7\u05e8\u05d9\u05d8\u05d9\u05ea \u05d1\u05d9\u05dc\u05d3 \u05e2\u05d9\u05d9\u05e3 \u05d5\u05ea\u05d5\u05e7\u05e4\u05e0\u05d9 \u05e2\u05dd \u05d4\u05e9\u05de\u05e0\u05d4 \u05e4\u05ea\u05d0\u05d5\u05de\u05d9\u05ea \u05d4\u05d9\u05d0 \u05d4\u05e4\u05e8\u05e2\u05ea \u05e9\u05d9\u05e0\u05d4 \u05de\u05e8\u05db\u05d6\u05d9\u05ea (Dulcan p.487, p.490)."
        },
        {
          "text": "\u05d4\u05d3\u05e8\u05db\u05ea \u05d4\u05d5\u05e8\u05d9\u05dd \u05dc\u05e9\u05d9\u05e4\u05d5\u05e8 Sleep hygiene \u05d5\u05d4\u05e6\u05d1\u05ea \u05d2\u05d1\u05d5\u05dc\u05d5\u05ea (Limit-setting type).",
          "isCorrect": false,
          "rationale": "\u05d4\u05e1\u05d9\u05de\u05e0\u05d9\u05dd \u05d4\u05e4\u05d9\u05d6\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05d9\u05dd (\u05d4\u05e9\u05de\u05e0\u05d4, \u05d4\u05ea\u05d1\u05d2\u05e8\u05d5\u05ea \u05de\u05d5\u05e7\u05d3\u05de\u05ea) \u05de\u05e2\u05d9\u05d3\u05d9\u05dd \u05e2\u05dc \u05d1\u05e2\u05d9\u05d4 \u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea \u05e2\u05de\u05d5\u05e7\u05d4 \u05de\u05e2\u05d1\u05e8 \u05dc\u05e7\u05e9\u05d9\u05d9 \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d1\u05e9\u05d9\u05e0\u05d4 (Dulcan p.483)."
        }
      ],
      "hint": "\u05d6\u05db\u05e8\u05d5 \u05d0\u05ea \u05d4\u05de\u05d5\u05e4\u05e2 \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9 \u05d4\u05d9\u05d9\u05d7\u05d5\u05d3\u05d9 \u05e9\u05dc \u05e0\u05e8\u05e7\u05d5\u05dc\u05e4\u05e1\u05d9\u05d4 \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05e6\u05e2\u05d9\u05e8\u05d9\u05dd \u05dc\u05e2\u05d5\u05de\u05ea \u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd.",
      "citation": "(Dulcan p.483, p.490)"
    },
    {
      "type": "fill_in_the_blank",
      "question": "\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05e4\u05e2\u05d5\u05dc\u05d4 \u05e9\u05dc \u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 Pitolisant, \u05d4\u05de\u05e9\u05de\u05e9\u05ea \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05e0\u05e8\u05e7\u05d5\u05dc\u05e4\u05e1\u05d9\u05d4, \u05de\u05d1\u05d5\u05e1\u05e1 \u05e2\u05dc \u05d4\u05d9\u05d5\u05ea\u05d4 ___ \u05e9\u05dc \u05e7\u05d5\u05dc\u05d8\u05df Histamine H3, \u05de\u05d4 \u05e9\u05de\u05d5\u05d1\u05d9\u05dc \u05dc\u05d4\u05d2\u05d1\u05e8\u05ea \u05d4\u05e9\u05d7\u05e8\u05d5\u05e8 \u05e9\u05dc Histamine \u05d1-TMN \u05d5\u05e9\u05d9\u05e4\u05d5\u05e8 \u05d4\u05e2\u05e8\u05e0\u05d5\u05ea (StahlNeuro).",
      "bestAnswer": "inverse agonist",
      "acceptableAnswers": [
        "H3 inverse agonist",
        "antagonist",
        "H3 antagonist"
      ],
      "rationale": "Pitolisant \u05e4\u05d5\u05e2\u05dc\u05ea \u05db-Inverse agonist \u05e2\u05dc \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 H3 \u05e4\u05e8\u05d4-\u05e1\u05d9\u05e0\u05e4\u05d8\u05d9\u05d9\u05dd (Autoreceptors), \u05d5\u05d1\u05db\u05da \u05de\u05e1\u05d9\u05e8\u05d4 \u05d0\u05ea \u05d4\u05e2\u05d9\u05db\u05d5\u05d1 \u05e2\u05dc \u05e9\u05d7\u05e8\u05d5\u05e8 Histamine \u05d5\u05de\u05e7\u05d3\u05de\u05ea \u05e2\u05d5\u05e8\u05e8\u05d5\u05ea (StahlNeuro p.594; StahlNeuro m. DSM-5-TR).",
      "hint": "\u05d7\u05e9\u05d1\u05d5 \u05e2\u05dc \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05e9\u05d1\u05d5 \u05d7\u05e1\u05d9\u05de\u05ea \u05e8\u05e6\u05e4\u05d8\u05d5\u05e8 \u05e4\u05e8\u05d4-\u05e1\u05d9\u05e0\u05e4\u05d8\u05d9 \u05d2\u05d5\u05e8\u05de\u05ea \u05dc\u05d4\u05d2\u05d1\u05e8\u05ea \u05e9\u05d7\u05e8\u05d5\u05e8 \u05d4\u05de\u05d5\u05dc\u05d9\u05da \u05d4\u05e2\u05e6\u05d1\u05d9.",
      "citation": "(StahlNeuro p.594)"
    },
    {
      "type": "multiple_select",
      "question": "\u05d1\u05de\u05d4\u05dc\u05da \u05d1\u05d9\u05e6\u05d5\u05e2 Multiple Sleep Latency Test (MSLT) \u05dc\u05d0\u05d1\u05d7\u05d5\u05df \u05e0\u05e8\u05e7\u05d5\u05dc\u05e4\u05e1\u05d9\u05d4, \u05d0\u05d9\u05dc\u05d5 \u05de\u05d4\u05ea\u05e0\u05d0\u05d9\u05dd \u05d4\u05d1\u05d0\u05d9\u05dd \u05d7\u05d9\u05d9\u05d1\u05d9\u05dd \u05dc\u05d4\u05ea\u05e7\u05d9\u05d9\u05dd \u05db\u05d3\u05d9 \u05dc\u05d4\u05d1\u05d8\u05d9\u05d7 \u05d0\u05ea \u05de\u05d4\u05d9\u05de\u05e0\u05d5\u05ea \u05d4\u05ea\u05d5\u05e6\u05d0\u05d5\u05ea \u05d5\u05dc\u05de\u05e0\u05d5\u05e2 False positive?",
      "answerOptions": [
        {
          "text": "\u05d4\u05e4\u05e1\u05e7\u05ea \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05e0\u05d5\u05d2\u05d3\u05d5\u05ea \u05d3\u05d9\u05db\u05d0\u05d5\u05df (\u05db\u05d2\u05d5\u05df SSRI/SNRI) \u05dc\u05e4\u05d7\u05d5\u05ea \u05e9\u05d1\u05d5\u05e2\u05d9\u05d9\u05dd \u05dc\u05e4\u05e0\u05d9 \u05d4\u05d1\u05d3\u05d9\u05e7\u05d4.",
          "isCorrect": true,
          "rationale": "\u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05d0\u05dc\u05d5 \u05de\u05e2\u05db\u05d1\u05d5\u05ea \u05e9\u05e0\u05ea REM, \u05d5\u05d4\u05e4\u05e1\u05e7\u05ea\u05df \u05d4\u05d7\u05e8\u05d9\u05e4\u05d4 \u05e2\u05dc\u05d5\u05dc\u05d4 \u05dc\u05d2\u05e8\u05d5\u05dd \u05dc-REM rebound \u05e9\u05d9\u05d1\u05d9\u05d0 \u05dc\u05d4\u05d5\u05e4\u05e2\u05ea SOREMPs \u05db\u05d5\u05d6\u05d1\u05d9\u05dd (DSM p.424)."
        },
        {
          "text": "\u05ea\u05d9\u05e2\u05d5\u05d3 \u05e9\u05dc \u05e9\u05d9\u05e0\u05d4 \u05e1\u05d3\u05d9\u05e8\u05d4 \u05d5\u05de\u05e1\u05e4\u05e7\u05ea \u05d1\u05e9\u05d1\u05d5\u05e2\u05d9\u05d9\u05dd \u05e9\u05e7\u05d3\u05de\u05d5 \u05dc\u05d1\u05d3\u05d9\u05e7\u05d4 \u05d1\u05d0\u05de\u05e6\u05e2\u05d5\u05ea Actigraphy \u05d0\u05d5 \u05d9\u05d5\u05de\u05df \u05e9\u05d9\u05e0\u05d4.",
          "isCorrect": true,
          "rationale": "\u05d7\u05e1\u05da \u05e9\u05d9\u05e0\u05d4 \u05db\u05e8\u05d5\u05e0\u05d9 \u05e2\u05dc\u05d5\u05dc \u05dc\u05d2\u05e8\u05d5\u05dd \u05dc\u05ea\u05d5\u05e6\u05d0\u05d4 \u05d7\u05d9\u05d5\u05d1\u05d9\u05ea \u05d1-MSLT \u05d2\u05dd \u05dc\u05dc\u05d0 \u05e0\u05e8\u05e7\u05d5\u05dc\u05e4\u05e1\u05d9\u05d4 (DSM p.424)."
        },
        {
          "text": "\u05d1\u05d9\u05e6\u05d5\u05e2 \u05e4\u05d5\u05dc\u05d9\u05e1\u05d5\u05de\u05e0\u05d5\u05d2\u05e8\u05e4\u05d9\u05d4 (PSG) \u05dc\u05d9\u05dc\u05d9\u05ea \u05d1\u05dc\u05d9\u05dc\u05d4 \u05e9\u05e7\u05d5\u05d3\u05dd \u05dc\u05d1\u05d3\u05d9\u05e7\u05ea \u05d4-MSLT.",
          "isCorrect": true,
          "rationale": "\u05d4-PSG \u05e0\u05d5\u05e2\u05d3 \u05dc\u05d5\u05d5\u05d3\u05d0 \u05e9\u05d4\u05e0\u05d1\u05d3\u05e7 \u05d9\u05e9\u05df \u05de\u05e1\u05e4\u05d9\u05e7 \u05d1\u05dc\u05d9\u05dc\u05d4 \u05d5\u05e9\u05d0\u05d9\u05df \u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05e9\u05d9\u05e0\u05d4 \u05d0\u05d7\u05e8\u05d5\u05ea \u05db\u05de\u05d5 OSA \u05e9\u05de\u05e1\u05d1\u05d9\u05e8\u05d5\u05ea \u05d0\u05ea \u05d4\u05d9\u05e9\u05e0\u05d5\u05e0\u05d9\u05d5\u05ea (DSM p.424; Dulcan p.477)."
        },
        {
          "text": "\u05de\u05ea\u05df \u05de\u05e0\u05d4 \u05d1\u05d5\u05d3\u05d3\u05ea \u05e9\u05dc Modafinil \u05d1\u05d1\u05d5\u05e7\u05e8 \u05d4\u05d1\u05d3\u05d9\u05e7\u05d4 \u05db\u05d3\u05d9 \u05dc\u05d5\u05d5\u05d3\u05d0 \u05e9\u05d9\u05ea\u05d5\u05e3 \u05e4\u05e2\u05d5\u05dc\u05d4 \u05e9\u05dc \u05d4\u05e0\u05d1\u05d3\u05e7.",
          "isCorrect": false,
          "rationale": "\u05e1\u05d8\u05d9\u05de\u05d5\u05dc\u05e0\u05d8\u05d9\u05dd \u05de\u05e2\u05dc\u05d9\u05dd \u05d0\u05ea \u05d7\u05d1\u05d9\u05d5\u05df \u05d4\u05e9\u05d9\u05e0\u05d4 \u05d5\u05e2\u05dc\u05d5\u05dc\u05d9\u05dd \u05dc\u05de\u05e1\u05da \u05d0\u05ea \u05d4\u05e4\u05ea\u05d5\u05dc\u05d5\u05d2\u05d9\u05d4 \u05d1-MSLT (DSM p.424)."
        }
      ],
      "hint": "\u05d4\u05ea\u05de\u05e7\u05d3\u05d5 \u05d1\u05d2\u05d5\u05e8\u05de\u05d9\u05dd \u05e9\u05de\u05e9\u05e4\u05d9\u05e2\u05d9\u05dd \u05e2\u05dc \u05e4\u05d9\u05d6\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05d9\u05ea \u05d4-REM \u05d5\u05e2\u05dc \u05e8\u05de\u05ea \u05d4\u05e2\u05d9\u05d9\u05e4\u05d5\u05ea \u05d4\u05d1\u05e1\u05d9\u05e1\u05d9\u05ea.",
      "citation": "(DSM p.424)",
      "hasAllOfTheAbove": false,
      "hasNoneOfTheAbove": false
    },
    {
      "type": "short_answer",
      "question": "\u05d4\u05e1\u05d1\u05d9\u05e8\u05d5 \u05de\u05d3\u05d5\u05e2 \u05e7\u05d9\u05d9\u05dd \u05d4\u05d1\u05d3\u05dc \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9 \u05d1-Test-retest reliability \u05e9\u05dc \u05d1\u05d3\u05d9\u05e7\u05ea \u05d4-MSLT \u05d1\u05d9\u05df \u05e0\u05e8\u05e7\u05d5\u05dc\u05e4\u05e1\u05d9\u05d4 \u05de\u05e1\u05d5\u05d2 1 (NT1) \u05dc\u05e0\u05e8\u05e7\u05d5\u05dc\u05e4\u05e1\u05d9\u05d4 \u05de\u05e1\u05d5\u05d2 2 (NT2), \u05d5\u05de\u05d4\u05d5 \u05d0\u05d7\u05d5\u05d6 \u05d4\u05de\u05d4\u05d9\u05de\u05e0\u05d5\u05ea \u05d1-NT2?",
      "grading": {
        "modelAnswer": "\u05d1-NT1 \u05d4\u05de\u05d4\u05d9\u05de\u05e0\u05d5\u05ea \u05d2\u05d1\u05d5\u05d4\u05d4 (85%-95%) \u05d1\u05e9\u05dc \u05d4\u05e4\u05ea\u05d5\u05dc\u05d5\u05d2\u05d9\u05d4 \u05d4\u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea \u05d4\u05d9\u05e6\u05d9\u05d1\u05d4 (\u05d7\u05e1\u05e8 \u05d4\u05d9\u05e4\u05d5\u05e7\u05e8\u05d8\u05d9\u05df). \u05d1-NT2 \u05d4\u05de\u05d4\u05d9\u05de\u05e0\u05d5\u05ea \u05e0\u05de\u05d5\u05db\u05d4 \u05de-50% \u05d1\u05e9\u05dc \u05ea\u05e0\u05d5\u05d3\u05ea\u05d9\u05d5\u05ea \u05e4\u05d9\u05d6\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea \u05d9\u05d5\u05de\u05d9\u05d5\u05de\u05d9\u05ea, \u05e8\u05d2\u05d9\u05e9\u05d5\u05ea \u05d2\u05d1\u05d5\u05d4\u05d4 \u05dc\u05de\u05e9\u05ea\u05e0\u05d9\u05dd \u05e1\u05d1\u05d9\u05d1\u05ea\u05d9\u05d9\u05dd \u05d5\u05dc\u05d5\u05d7\u05d5\u05ea \u05d6\u05de\u05e0\u05d9 \u05e9\u05d9\u05e0\u05d4, \u05de\u05d4 \u05e9\u05e2\u05dc\u05d5\u05dc \u05dc\u05d4\u05d5\u05d1\u05d9\u05dc \u05dc\u05ea\u05d5\u05e6\u05d0\u05d5\u05ea \u05de\u05e9\u05ea\u05e0\u05d5\u05ea \u05d1\u05d1\u05d3\u05d9\u05e7\u05d5\u05ea \u05d7\u05d5\u05d6\u05e8\u05d5\u05ea.",
        "rationale": "\u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc NT2 \u05e0\u05d7\u05e9\u05d1\u05ea \u05e4\u05d7\u05d5\u05ea \u05d9\u05e6\u05d9\u05d1\u05d4 \u05d1\u05d1\u05d3\u05d9\u05e7\u05d5\u05ea \u05d7\u05d5\u05d6\u05e8\u05d5\u05ea \u05d1\u05e9\u05dc \u05d4\u05d9\u05e2\u05d3\u05e8 \u05e1\u05de\u05df \u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05e7\u05d1\u05d5\u05e2 \u05db\u05de\u05d5 \u05d7\u05e1\u05e8 \u05d4\u05d9\u05e4\u05d5\u05e7\u05e8\u05d8\u05d9\u05df \u05d4\u05e7\u05d9\u05d9\u05dd \u05d1-NT1.",
        "requiredAttributes": [
          "\u05e6\u05d5\u05d9\u05df \u05e9\u05d4\u05de\u05d4\u05d9\u05de\u05e0\u05d5\u05ea \u05d1-NT2 \u05e0\u05de\u05d5\u05db\u05d4 \u05de-50%.",
          "\u05d4\u05d5\u05e1\u05d1\u05e8 \u05e9\u05d4\u05d4\u05d1\u05d3\u05dc \u05e0\u05d5\u05d1\u05e2 \u05de\u05ea\u05e0\u05d5\u05d3\u05ea\u05d9\u05d5\u05ea \u05e4\u05d9\u05d6\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea \u05d0\u05d5 \u05d4\u05e9\u05e4\u05e2\u05ea \u05d2\u05d5\u05e8\u05de\u05d9\u05dd \u05e1\u05d1\u05d9\u05d1\u05ea\u05d9\u05d9\u05dd \u05d1-NT2 \u05dc\u05e2\u05d5\u05de\u05ea \u05d9\u05e6\u05d9\u05d1\u05d5\u05ea \u05d1-NT1.",
          "\u05e6\u05d5\u05d9\u05df \u05d4\u05e7\u05e9\u05e8 \u05dc\u05d7\u05e1\u05e8 \u05d4\u05d9\u05e4\u05d5\u05e7\u05e8\u05d8\u05d9\u05df \u05d1-NT1 \u05db\u05d2\u05d5\u05e8\u05dd \u05dc\u05d9\u05e6\u05d9\u05d1\u05d5\u05ea."
        ],
        "errors": {
          "misconceptions": [
            "\u05d8\u05e2\u05e0\u05d4 \u05e9\u05d4-MSLT \u05d0\u05d9\u05e0\u05d5 \u05db\u05dc\u05d9 \u05d0\u05d1\u05d7\u05e0\u05ea\u05d9 \u05ea\u05e7\u05e3 \u05dc-NT1.",
            "\u05d8\u05e2\u05e0\u05d4 \u05e9\u05d0\u05d9\u05df \u05d4\u05d1\u05d3\u05dc \u05d1\u05de\u05d4\u05d9\u05de\u05e0\u05d5\u05ea \u05d1\u05d9\u05df \u05d4\u05e1\u05d5\u05d2\u05d9\u05dd."
          ],
          "bluffs": [
            "\u05d0\u05de\u05d9\u05e8\u05d5\u05ea \u05db\u05dc\u05dc\u05d9\u05d5\u05ea \u05e2\u05dc \u05db\u05da \u05e9\u05d1\u05d3\u05d9\u05e7\u05d5\u05ea \u05e9\u05d9\u05e0\u05d4 \u05d0\u05d9\u05e0\u05df \u05de\u05d3\u05d5\u05d9\u05e7\u05d5\u05ea \u05d1\u05dc\u05d9 \u05dc\u05e6\u05d9\u05d9\u05df \u05d0\u05d7\u05d5\u05d6\u05d9\u05dd \u05d0\u05d5 \u05e1\u05d9\u05d1\u05d5\u05ea \u05e4\u05d9\u05d6\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05d5\u05ea."
          ]
        }
      },
      "hint": "\u05d7\u05e9\u05d1\u05d5 \u05e2\u05dc \u05d4\u05d9\u05e6\u05d9\u05d1\u05d5\u05ea \u05e9\u05dc \u05d4\u05de\u05de\u05e6\u05d0 \u05d4\u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d1\u05d1\u05e1\u05d9\u05e1 \u05d4\u05de\u05d7\u05dc\u05d4 \u05dc\u05e2\u05d5\u05de\u05ea \u05de\u05e6\u05d1\u05d9\u05dd \u05e9\u05d1\u05d4\u05dd \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05d9\u05d0 \u05e2\u05dc \u05d3\u05e8\u05da \u05d4\u05e9\u05dc\u05d9\u05dc\u05d4.",
      "citation": "(DSM p.424)"
    },
    {
      "type": "multiple_choice",
      "question": "\u05e2\u05dc \u05e4\u05d9 \u05d4-StahlNeuro, \u05de\u05e2\u05e8\u05db\u05ea \u05d4-Orexin/Hypocretin \u05de\u05d9\u05d9\u05e6\u05d1\u05ea \u05d0\u05ea \u05d4\u05e2\u05d5\u05e8\u05e8\u05d5\u05ea \u05d3\u05e8\u05da \u05d0\u05d9\u05e0\u05d8\u05e8\u05d0\u05e7\u05e6\u05d9\u05d4 \u05e2\u05dd \u05de\u05e8\u05db\u05d6\u05d9 \u05d4-Monoamine \u05d1\u05de\u05d5\u05d7. \u05d0\u05d9\u05dc\u05d5 \u05e8\u05e6\u05e4\u05d8\u05d5\u05e8\u05d9\u05dd \u05e9\u05dc Orexin \u05de\u05d1\u05d5\u05d8\u05d0\u05d9\u05dd \u05d1\u05d0\u05d5\u05e4\u05df \u05d3\u05d5\u05de\u05d9\u05e0\u05e0\u05d8\u05d9 \u05d1-Locus Coeruleus (LC) \u05d5\u05d1-Tuberomammillary Nucleus (TMN) \u05d1\u05d4\u05ea\u05d0\u05de\u05d4?",
      "answerOptions": [
        {
          "text": "OX1R \u05d1-LC; \u05d5-OX2R \u05d1-TMN.",
          "isCorrect": true,
          "rationale": "\u05e8\u05e6\u05e4\u05d8\u05d5\u05e8 OX1R \u05de\u05d1\u05d5\u05d8\u05d0 \u05d1\u05e6\u05e4\u05d9\u05e4\u05d5\u05ea \u05d1-LC \u05d4\u05e0\u05d5\u05e8\u05d0\u05d3\u05e8\u05e0\u05e8\u05d2\u05d9, \u05d1\u05e2\u05d5\u05d3 OX2R \u05de\u05d1\u05d5\u05d8\u05d0 \u05d1-TMN \u05d4\u05d4\u05d9\u05e1\u05d8\u05de\u05d9\u05e0\u05e8\u05d2\u05d9 (StahlNeuro p.407-408, p.433)."
        },
        {
          "text": "OX2R \u05d1-LC; \u05d5-OX1R \u05d1-TMN.",
          "isCorrect": false,
          "rationale": "\u05d4\u05d1\u05d9\u05d8\u05d5\u05d9 \u05d4\u05d5\u05d0 \u05d4\u05e4\u05d5\u05da; \u05d4-LC \u05de\u05d2\u05d9\u05d1 \u05d1\u05e2\u05d9\u05e7\u05e8 \u05dc-OX1 \u05d5-TMN \u05dc-OX2 (StahlNeuro p.407)."
        },
        {
          "text": "NMDA \u05d1-LC; \u05d5-GIRK \u05d1-TMN.",
          "isCorrect": false,
          "rationale": "\u05d0\u05dc\u05d5 \u05d4\u05dd \u05d0\u05e4\u05e7\u05d8\u05d5\u05e8\u05d9\u05dd \u05ea\u05d0\u05d9\u05d9\u05dd \u05d4\u05de\u05d5\u05e4\u05e2\u05dc\u05d9\u05dd \u05e2\u05dc \u05d9\u05d3\u05d9 \u05e8\u05e6\u05e4\u05d8\u05d5\u05e8\u05d9 Orexin, \u05d0\u05da \u05dc\u05d0 \u05d4\u05e8\u05e6\u05e4\u05d8\u05d5\u05e8\u05d9\u05dd \u05e2\u05e6\u05de\u05dd (StahlNeuro p.408)."
        },
        {
          "text": "H3 \u05d1-LC; \u05d5-D2 \u05d1-TMN.",
          "isCorrect": false,
          "rationale": "\u05d0\u05dc\u05d5 \u05e8\u05e6\u05e4\u05d8\u05d5\u05e8\u05d9\u05dd \u05dc\u05de\u05d5\u05e0\u05d5\u05d0\u05de\u05d9\u05e0\u05d9\u05dd \u05d0\u05d7\u05e8\u05d9\u05dd \u05d5\u05d0\u05d9\u05e0\u05dd \u05d4\u05e8\u05e6\u05e4\u05d8\u05d5\u05e8\u05d9\u05dd \u05d4\u05d9\u05e9\u05d9\u05e8\u05d9\u05dd \u05e9\u05dc \u05de\u05e2\u05e8\u05db\u05ea \u05d4-Orexin \u05d1\u05de\u05e7\u05d5\u05de\u05d5\u05ea \u05d0\u05dc\u05d5 (StahlNeuro p.407)."
        }
      ],
      "hint": "\u05d4\u05e7\u05d5\u05dc\u05d8\u05e0\u05d9\u05dd \u05de\u05de\u05d5\u05e1\u05e4\u05e8\u05d9\u05dd, \u05d5\u05db\u05dc \u05d0\u05d7\u05d3 \u05de\u05d4\u05dd \u05de\u05d6\u05d5\u05d4\u05d4 \u05e2\u05dd \u05de\u05e8\u05db\u05d6 \u05e0\u05d5\u05d9\u05e8\u05d5\u05d8\u05e8\u05e0\u05e1\u05de\u05d9\u05d8\u05d5\u05e8 \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9 \u05d1\u05de\u05e2\u05d2\u05dc\u05d9 \u05d4\u05e2\u05d5\u05e8\u05e8\u05d5\u05ea.",
      "citation": "(StahlNeuro p.407, p.408)"
    },
    {
      "type": "multiple_choice",
      "question": "\u05de\u05d8\u05d5\u05e4\u05dc \u05e2\u05dd \u05e0\u05e8\u05e7\u05d5\u05dc\u05e4\u05e1\u05d9\u05d4 \u05de\u05d0\u05d5\u05d1\u05d7\u05e0\u05ea \u05de\u05d3\u05d5\u05d5\u05d7 \u05e2\u05dc \u05d0\u05d9\u05e8\u05d5\u05e2\u05d9\u05dd \u05e9\u05dc \u05d4\u05d6\u05d9\u05d5\u05ea \u05d5\u05d9\u05d6\u05d5\u05d0\u05dc\u05d9\u05d5\u05ea \u05de\u05e4\u05d7\u05d9\u05d3\u05d5\u05ea \u05d4\u05de\u05ea\u05e8\u05d7\u05e9\u05d5\u05ea \u05de\u05d9\u05d3 \u05e2\u05dd \u05d4\u05d9\u05e7\u05d9\u05e6\u05d4 \u05d1\u05d1\u05d5\u05e7\u05e8, \u05de\u05dc\u05d5\u05d5\u05ea \u05d1\u05d7\u05d5\u05e1\u05e8 \u05d9\u05db\u05d5\u05dc\u05ea \u05dc\u05d6\u05d5\u05d6 \u05d1\u05de\u05e9\u05da \u05de\u05e1\u05e4\u05e8 \u05e9\u05e0\u05d9\u05d5\u05ea. \u05db\u05d9\u05e6\u05d3 \u05de\u05d2\u05d3\u05d9\u05e8 \u05d4-DSM-5-TR \u05d0\u05ea \u05d4\u05ea\u05e1\u05de\u05d9\u05df \u05e9\u05dc \u05d4\u05d4\u05d6\u05d9\u05d5\u05ea \u05d1\u05de\u05e6\u05d1 \u05d6\u05d4?",
      "answerOptions": [
        {
          "text": "Hypnopompic hallucinations.",
          "isCorrect": true,
          "rationale": "\u05d4\u05d6\u05d9\u05d5\u05ea \u05d4\u05de\u05ea\u05e8\u05d7\u05e9\u05d5\u05ea \u05d1\u05e2\u05ea \u05d4\u05d9\u05e7\u05d9\u05e6\u05d4 (Upon waking) \u05de\u05d5\u05d2\u05d3\u05e8\u05d5\u05ea \u05db-Hypnopompic, \u05d1\u05e2\u05d5\u05d3 \u05d0\u05dc\u05d5 \u05e9\u05de\u05ea\u05e8\u05d7\u05e9\u05d5\u05ea \u05d1\u05e2\u05ea \u05d4\u05d4\u05d9\u05e8\u05d3\u05de\u05d5\u05ea \u05d4\u05df Hypnagogic (DSM p.427; Dulcan p.483)."
        },
        {
          "text": "Hypnagogic hallucinations.",
          "isCorrect": false,
          "rationale": "\u05d4\u05d6\u05d9\u05d5\u05ea \u05d4\u05d9\u05e4\u05e0\u05d2\u05d5\u05d2\u05d9\u05d5\u05ea \u05de\u05ea\u05e8\u05d7\u05e9\u05d5\u05ea \u05d1\u05e2\u05ea \u05d4\u05de\u05e2\u05d1\u05e8 \u05de\u05e2\u05e8\u05e0\u05d5\u05ea \u05dc\u05e9\u05d9\u05e0\u05d4 (Sleep onset), \u05dc\u05d0 \u05d1\u05e2\u05ea \u05d4\u05d9\u05e7\u05d9\u05e6\u05d4 (DSM p.427)."
        },
        {
          "text": "Cataplexy associated with REM intrusion.",
          "isCorrect": false,
          "rationale": "\u05d1\u05e2\u05d5\u05d3 \u05e9\u05d6\u05d4\u05d5 \u05d7\u05dc\u05e7 \u05de\u05d7\u05d3\u05d9\u05e8\u05ea REM, \u05d4\u05de\u05d5\u05e0\u05d7 \u05d4\u05e1\u05e4\u05e6\u05d9\u05e4\u05d9 \u05dc\u05d4\u05d6\u05d9\u05d5\u05ea \u05d1\u05d9\u05e7\u05d9\u05e6\u05d4 \u05d4\u05d5\u05d0 \u05d4\u05d9\u05e4\u05e0\u05d5\u05e4\u05d5\u05de\u05e4\u05d9 (DSM p.427)."
        },
        {
          "text": "Nightmare disorder symptoms.",
          "isCorrect": false,
          "rationale": "\u05d4\u05d6\u05d9\u05d5\u05ea \u05e0\u05e8\u05e7\u05d5\u05dc\u05e4\u05d8\u05d9\u05d5\u05ea \u05d4\u05df \u05d7\u05d5\u05d5\u05d9\u05d5\u05ea \u05d7\u05d6\u05d5\u05ea\u05d9\u05d5\u05ea/\u05ea\u05d7\u05d5\u05e9\u05ea\u05d9\u05d5\u05ea \u05d1\u05e2\u05ea \u05e2\u05e8\u05d5\u05ea \u05d7\u05dc\u05e7\u05d9\u05ea, \u05d1\u05e0\u05d9\u05d2\u05d5\u05d3 \u05dc\u05d7\u05dc\u05d5\u05de\u05d5\u05ea \u05d1\u05dc\u05d4\u05d4 \u05d4\u05de\u05ea\u05e8\u05d7\u05e9\u05d9\u05dd \u05d1\u05de\u05d4\u05dc\u05da \u05e9\u05e0\u05ea REM \u05de\u05dc\u05d0\u05d4 (DSM p.428, p.457)."
        }
      ],
      "hint": "\u05d4\u05d1\u05d7\u05d9\u05e0\u05d5 \u05d1\u05d9\u05df \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d4\u05de\u05ea\u05e8\u05d7\u05e9\u05d9\u05dd \u05d1\u05ea\u05d7\u05d9\u05dc\u05ea \u05d4\u05e9\u05d9\u05e0\u05d4 \u05dc\u05d1\u05d9\u05df \u05d0\u05dc\u05d5 \u05d4\u05de\u05ea\u05e8\u05d7\u05e9\u05d9\u05dd \u05d1\u05e1\u05d9\u05d5\u05de\u05d4.",
      "citation": "(DSM p.427, p.428)"
    },
    {
      "type": "multiple_select",
      "question": "\u05e2\u05dc \u05e4\u05d9 \u05d4-DSM-5-TR \u05d5\u05d4-Dulcan, \u05de\u05d4\u05dd \u05d4\u05de\u05e6\u05d1\u05d9\u05dd \u05d4\u05e8\u05e4\u05d5\u05d0\u05d9\u05d9\u05dd \u05d0\u05d5 \u05d4\u05e0\u05d5\u05d9\u05e8\u05d5\u05dc\u05d5\u05d2\u05d9\u05d9\u05dd \u05d4\u05e2\u05dc\u05d5\u05dc\u05d9\u05dd \u05dc\u05d2\u05e8\u05d5\u05dd \u05dc\u05e0\u05e8\u05e7\u05d5\u05dc\u05e4\u05e1\u05d9\u05d4 \u05de\u05e9\u05e0\u05d9\u05ea (Secondary Narcolepsy)?",
      "answerOptions": [
        {
          "text": "\u05d2\u05d9\u05d3\u05d5\u05dc\u05d9\u05dd \u05d1\u05d4\u05d9\u05e4\u05d5\u05ea\u05dc\u05de\u05d5\u05e1 \u05d0\u05d5 \u05e4\u05d2\u05d9\u05e2\u05d5\u05ea \u05e8\u05d0\u05e9 \u05d8\u05e8\u05d0\u05d5\u05de\u05d8\u05d9\u05d5\u05ea.",
          "isCorrect": true,
          "rationale": "\u05e0\u05d6\u05e7 \u05d9\u05e9\u05d9\u05e8 \u05dc\u05e0\u05d5\u05d9\u05e8\u05d5\u05e0\u05d9\u05dd \u05de\u05d9\u05d9\u05e6\u05e8\u05d9 \u05d4\u05d9\u05e4\u05d5\u05e7\u05e8\u05d8\u05d9\u05df \u05d1\u05d4\u05d9\u05e4\u05d5\u05ea\u05dc\u05de\u05d5\u05e1 \u05e2\u05e7\u05d1 \u05d8\u05e8\u05d0\u05d5\u05de\u05d4 \u05d0\u05d5 \u05d2\u05d9\u05d3\u05d5\u05dc \u05d4\u05d5\u05d0 \u05e1\u05d9\u05d1\u05d4 \u05de\u05d5\u05db\u05e8\u05ea \u05dc\u05e0\u05e8\u05e7\u05d5\u05dc\u05e4\u05e1\u05d9\u05d4 \u05de\u05e9\u05e0\u05d9\u05ea (DSM p.426)."
        },
        {
          "text": "\u05de\u05d7\u05dc\u05d5\u05ea \u05d2\u05e0\u05d8\u05d9\u05d5\u05ea \u05db\u05d2\u05d5\u05df Myotonic Dystrophy \u05d0\u05d5 Prader-Willi syndrome.",
          "isCorrect": true,
          "rationale": "\u05ea\u05e1\u05de\u05d5\u05e0\u05d5\u05ea \u05d0\u05dc\u05d5 \u05e0\u05de\u05e6\u05d0\u05d5 \u05e7\u05e9\u05d5\u05e8\u05d5\u05ea \u05dc\u05e4\u05d9\u05d6\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05d4 \u05d3\u05de\u05d5\u05d9\u05d9\u05ea \u05e0\u05e8\u05e7\u05d5\u05dc\u05e4\u05e1\u05d9\u05d4 (NT2-like) \u05d0\u05d5 \u05e7\u05d8\u05e4\u05dc\u05e7\u05e1\u05d9\u05d4 (DSM p.426)."
        },
        {
          "text": "\u05d8\u05e8\u05e9\u05ea \u05e0\u05e4\u05d5\u05e6\u05d4 (Multiple Sclerosis) \u05e2\u05dd \u05e0\u05d2\u05e2\u05d9\u05dd \u05d3\u05dc\u05e7\u05ea\u05d9\u05d9\u05dd \u05d1\u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05e2\u05e6\u05d1\u05d9\u05dd \u05d4\u05de\u05e8\u05db\u05d6\u05d9\u05ea.",
          "isCorrect": true,
          "rationale": "\u05e0\u05d2\u05e2\u05d9\u05dd \u05d3\u05dc\u05e7\u05ea\u05d9\u05d9\u05dd \u05d1\u05de\u05d9\u05e7\u05d5\u05de\u05d9\u05dd \u05d0\u05e1\u05d8\u05e8\u05d8\u05d2\u05d9\u05d9\u05dd \u05d9\u05db\u05d5\u05dc\u05d9\u05dd \u05dc\u05e4\u05d2\u05d5\u05e2 \u05d1\u05de\u05e1\u05dc\u05d5\u05dc\u05d9 \u05d4\u05e2\u05d5\u05e8\u05e8\u05d5\u05ea \u05d5\u05dc\u05d2\u05e8\u05d5\u05dd \u05dc\u05e0\u05e8\u05e7\u05d5\u05dc\u05e4\u05e1\u05d9\u05d4 (DSM p.426)."
        },
        {
          "text": "\u05e9\u05d9\u05de\u05d5\u05e9 \u05de\u05de\u05d5\u05e9\u05da \u05d1-Benzodiazepines \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05d7\u05e8\u05d3\u05d4.",
          "isCorrect": false,
          "rationale": "\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05d0\u05dc\u05d5 \u05d2\u05d5\u05e8\u05dd \u05dc\u05d9\u05e9\u05e0\u05d5\u05e0\u05d9\u05d5\u05ea \u05db\u05ea\u05d5\u05e6\u05d0\u05d4 \u05de\u05d4\u05e9\u05e4\u05e2\u05d4 \u05d9\u05e9\u05d9\u05e8\u05d4 \u05e9\u05dc \u05d4\u05d7\u05d5\u05de\u05e8, \u05d0\u05da \u05d0\u05d9\u05e0\u05d5 \u05de\u05d5\u05d2\u05d3\u05e8 \u05db\u05e0\u05e8\u05e7\u05d5\u05dc\u05e4\u05e1\u05d9\u05d4 \u05de\u05e9\u05e0\u05d9\u05ea \u05dc\u05de\u05e6\u05d1 \u05e8\u05e4\u05d5\u05d0\u05d9 (DSM p.428)."
        }
      ],
      "hint": "\u05d7\u05e4\u05e9\u05d5 \u05de\u05e6\u05d1\u05d9\u05dd \u05d4\u05d2\u05d5\u05e8\u05de\u05d9\u05dd \u05dc\u05d4\u05e8\u05e1 \u05de\u05d1\u05e0\u05d9 \u05d0\u05d5 \u05ea\u05e4\u05e7\u05d5\u05d3\u05d9 \u05e9\u05dc \u05e0\u05d5\u05d9\u05e8\u05d5\u05e0\u05d9 \u05d4\u05d4\u05d9\u05e4\u05d5\u05e7\u05e8\u05d8\u05d9\u05df \u05d0\u05d5 \u05de\u05e1\u05dc\u05d5\u05dc\u05d9 \u05d4\u05e2\u05d5\u05e8\u05e8\u05d5\u05ea.",
      "citation": "(DSM p.426)",
      "hasAllOfTheAbove": false,
      "hasNoneOfTheAbove": false
    },
    {
      "type": "multiple_choice",
      "question": "\u05de\u05d4\u05d5 \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9 \u05d4\u05de\u05d1\u05d3\u05d9\u05dc \u05d1\u05e6\u05d5\u05e8\u05d4 \u05d4\u05d8\u05d5\u05d1\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d1\u05d9\u05df \u05e0\u05e8\u05e7\u05d5\u05dc\u05e4\u05e1\u05d9\u05d4 \u05dc\u05d1\u05d9\u05df Hypersomnolence Disorder \u05e2\u05dc \u05e4\u05d9 \u05d4-DSM-5-TR?",
      "answerOptions": [
        {
          "text": "\u05d1\u05e0\u05e8\u05e7\u05d5\u05dc\u05e4\u05e1\u05d9\u05d4 \u05ea\u05e0\u05d5\u05de\u05d5\u05ea \u05d4\u05d9\u05d5\u05dd \u05d4\u05df \u05d1\u05d3\u05e8\u05da \u05db\u05dc\u05dc \u05e7\u05e6\u05e8\u05d5\u05ea \u05d5\u05de\u05e8\u05e2\u05e0\u05e0\u05d5\u05ea, \u05d1\u05e2\u05d5\u05d3 \u05d1-Hypersomnolence Disorder \u05d4\u05df \u05d0\u05e8\u05d5\u05db\u05d5\u05ea \u05d5\u05d0\u05d9\u05e0\u05df \u05de\u05e8\u05e2\u05e0\u05e0\u05d5\u05ea.",
          "isCorrect": true,
          "rationale": "\u05d6\u05d4\u05d5 \u05d4\u05d1\u05d3\u05dc \u05e7\u05dc\u05d9\u05e0\u05d9 \u05de\u05e8\u05db\u05d6\u05d9; \u05e0\u05e8\u05e7\u05d5\u05dc\u05e4\u05d8\u05d9\u05dd \u05d7\u05e9\u05d9\u05dd \u05e8\u05e2\u05e0\u05e0\u05d5\u05ea \u05dc\u05d0\u05d7\u05e8 \u05ea\u05e0\u05d5\u05de\u05d4 \u05e7\u05e6\u05e8\u05d4 (10-20 \u05d3\u05e7\u05d5\u05ea), \u05d1\u05e0\u05d9\u05d2\u05d5\u05d3 \u05dc\u05dc\u05d5\u05e7\u05d9\u05dd \u05d1\u05d4\u05d9\u05e4\u05e8\u05e1\u05d5\u05de\u05e0\u05d5\u05dc\u05e0\u05e1\u05d9 (DSM p.421, p.428)."
        },
        {
          "text": "\u05e8\u05e7 \u05d1\u05e0\u05e8\u05e7\u05d5\u05dc\u05e4\u05e1\u05d9\u05d4 \u05e7\u05d9\u05d9\u05de\u05ea \u05d9\u05e9\u05e0\u05d5\u05e0\u05d9\u05d5\u05ea \u05d9\u05ea\u05e8 \u05d4\u05de\u05d5\u05e4\u05d9\u05e2\u05d4 \u05dc\u05e4\u05d7\u05d5\u05ea 3 \u05e4\u05e2\u05de\u05d9\u05dd \u05d1\u05e9\u05d1\u05d5\u05e2.",
          "isCorrect": false,
          "rationale": "\u05e9\u05ea\u05d9 \u05d4\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05d3\u05d5\u05e8\u05e9\u05d5\u05ea \u05ea\u05d3\u05d9\u05e8\u05d5\u05ea \u05e9\u05dc \u05dc\u05e4\u05d7\u05d5\u05ea 3 \u05e4\u05e2\u05de\u05d9\u05dd \u05d1\u05e9\u05d1\u05d5\u05e2 \u05d1\u05de\u05e9\u05da 3 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd (DSM p.417, p.422)."
        },
        {
          "text": "\u05d1-Hypersomnolence Disorder \u05e7\u05d9\u05d9\u05de\u05ea \u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d2\u05d1\u05d5\u05d4\u05d4 \u05d9\u05d5\u05ea\u05e8 \u05e9\u05dc SOREMPs \u05d1-MSLT.",
          "isCorrect": false,
          "rationale": "\u05dc\u05d4\u05d9\u05e4\u05da, SOREMPs \u05d4\u05dd \u05e1\u05d9\u05de\u05df \u05d4\u05d9\u05db\u05e8 \u05e9\u05dc \u05e0\u05e8\u05e7\u05d5\u05dc\u05e4\u05e1\u05d9\u05d4 \u05d5\u05e0\u05d3\u05d9\u05e8\u05d9\u05dd \u05de\u05d0\u05d5\u05d3 \u05d1-Hypersomnolence Disorder (DSM p.428)."
        },
        {
          "text": "\u05e8\u05e7 \u05d1-Hypersomnolence Disorder \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05e1\u05d5\u05d1\u05dc \u05de\u05e7\u05e9\u05d9\u05d9 \u05d9\u05e7\u05d9\u05e6\u05d4 (Sleep drunkenness).",
          "isCorrect": false,
          "rationale": "\u05d1\u05e2\u05d5\u05d3 \u05e9\u05d6\u05d4 \u05e0\u05e4\u05d5\u05e5 \u05d9\u05d5\u05ea\u05e8 \u05d1\u05d4\u05d9\u05e4\u05e8\u05e1\u05d5\u05de\u05e0\u05d5\u05dc\u05e0\u05e1\u05d9, \u05d2\u05dd \u05e0\u05e8\u05e7\u05d5\u05dc\u05e4\u05d8\u05d9\u05dd \u05d9\u05db\u05d5\u05dc\u05d9\u05dd \u05dc\u05d7\u05d5\u05d5\u05ea \u05e7\u05e9\u05d9\u05d9 \u05d9\u05e7\u05d9\u05e6\u05d4, \u05d5\u05dc\u05db\u05df \u05d6\u05d4\u05d5 \u05d0\u05d9\u05e0\u05d5 \u05d4\u05de\u05d3\u05d3 \u05d4\u05de\u05d1\u05d7\u05d9\u05df \u05d4\u05d8\u05d5\u05d1 \u05d1\u05d9\u05d5\u05ea\u05e8 (DSM p.417, p.428)."
        }
      ],
      "hint": "\u05d4\u05ea\u05de\u05e7\u05d3\u05d5 \u05d1\u05d0\u05d9\u05db\u05d5\u05ea \u05d5\u05d1\u05d9\u05e2\u05d9\u05dc\u05d5\u05ea \u05e9\u05dc \u05ea\u05e0\u05d5\u05de\u05d5\u05ea \u05d4\u05d9\u05d5\u05dd \u05d4\u05de\u05d3\u05d5\u05d5\u05d7\u05d5\u05ea \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d4\u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd.",
      "citation": "(DSM p.421, p.428)"
    }
  ]
