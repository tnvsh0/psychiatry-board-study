    {
      "type": "short_answer",
      "question": "\u05de\u05d4\u05d5 \u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05e4\u05e2\u05d5\u05dc\u05d4 \u05e9\u05dc Botulinum Toxin A \u05d1\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05e1\u05e4\u05e1\u05d8\u05d9\u05d5\u05ea \u05de\u05de\u05d5\u05e7\u05d3\u05ea \u05d1\u05e9\u05d9\u05ea\u05d5\u05e7 \u05de\u05d5\u05d7\u05d9\u05df, \u05d5\u05de\u05d4\u05df \u05d4\u05de\u05d2\u05d1\u05dc\u05d5\u05ea \u05e9\u05dc \u05d8\u05d9\u05e4\u05d5\u05dc \u05d6\u05d4?",
      "grading": {
        "modelAnswer": "\u05d1\u05d5\u05d8\u05d5\u05dc\u05d9\u05e0\u05d5\u05dd \u05d8\u05d5\u05e7\u05e1\u05d9\u05df \u05de\u05e2\u05db\u05d1 \u05d0\u05ea \u05e9\u05d7\u05e8\u05d5\u05e8 \u05d4-Acetylcholine (ACh) \u05de\u05d4\u05d8\u05e8\u05de\u05d9\u05e0\u05dc \u05d4\u05e4\u05e8\u05d4-\u05e1\u05d9\u05e0\u05e4\u05d8\u05d9 \u05d1\u05e6\u05d5\u05de\u05ea \u05d4\u05e2\u05e6\u05d1-\u05e9\u05e8\u05d9\u05e8 (NMJ), \u05d5\u05d1\u05db\u05da \u05d2\u05d5\u05e8\u05dd \u05dc\u05d4\u05e8\u05e4\u05d9\u05d9\u05ea \u05d4\u05e9\u05e8\u05d9\u05e8 \u05d4\u05de\u05d5\u05d6\u05e8\u05e7. \u05d4\u05de\u05d2\u05d1\u05dc\u05d5\u05ea \u05d4\u05df \u05e9\u05d4\u05e9\u05e4\u05e2\u05ea\u05d5 \u05d6\u05de\u05e0\u05d9\u05ea (3-6 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd), \u05d4\u05d5\u05d0 \u05d3\u05d5\u05e8\u05e9 \u05d4\u05d6\u05e8\u05e7\u05d5\u05ea \u05d7\u05d5\u05d6\u05e8\u05d5\u05ea, \u05d5\u05d4\u05d5\u05d0 \u05d9\u05e2\u05d9\u05dc \u05e8\u05e7 \u05dc\u05e1\u05e4\u05e1\u05d8\u05d9\u05d5\u05ea \u05de\u05de\u05d5\u05e7\u05d3\u05ea \u05d5\u05dc\u05d0 \u05de\u05d5\u05e4\u05e9\u05d8\u05ea.",
        "rationale": "\u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05e0\u05d5\u05d9\u05e8\u05d5\u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05de\u05d5\u05e1\u05d1\u05e8 \u05d1-StahlNeuro \u05d5\u05d4\u05d9\u05d9\u05e9\u05d5\u05dd \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9 \u05d1-Dulcan (StahlNeuro p.504; Dulcan p.124).",
        "requiredAttributes": [
          "\u05e6\u05d9\u05d5\u05df \u05e2\u05d9\u05db\u05d5\u05d1 \u05e9\u05d7\u05e8\u05d5\u05e8 Acetylcholine (ACh).",
          "\u05de\u05d9\u05e7\u05d5\u05dd \u05d4\u05e4\u05e2\u05d5\u05dc\u05d4: \u05e6\u05d5\u05de\u05ea \u05e2\u05e6\u05d1-\u05e9\u05e8\u05d9\u05e8 (NMJ).",
          "\u05e6\u05d9\u05d5\u05df \u05de\u05d2\u05d1\u05dc\u05ea \u05d4\u05d6\u05de\u05df (\u05d6\u05de\u05e0\u05d9\u05d5\u05ea \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc)."
        ],
        "errors": {
          "misconceptions": [
            "\u05de\u05d7\u05e9\u05d1\u05d4 \u05e9\u05d4\u05e8\u05e2\u05dc\u05df \u05e4\u05d5\u05e2\u05dc \u05e2\u05dc \u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05e2\u05e6\u05d1\u05d9\u05dd \u05d4\u05de\u05e8\u05db\u05d6\u05d9\u05ea (CNS) \u05d5\u05dc\u05d0 \u05d1\u05d0\u05d5\u05e4\u05df \u05de\u05e7\u05d5\u05de\u05d9."
          ],
          "bluffs": [
            "\u05d0\u05de\u05d9\u05e8\u05d4 \u05db\u05dc\u05dc\u05d9\u05ea \u05e9\u05d4\u05e8\u05e2\u05dc\u05df '\u05de\u05e8\u05d2\u05d9\u05e2 \u05d0\u05ea \u05d4\u05e9\u05e8\u05d9\u05e8' \u05d1\u05dc\u05d9 \u05dc\u05d4\u05e1\u05d1\u05d9\u05e8 \u05d0\u05ea \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05e1\u05d9\u05e0\u05e4\u05d8\u05d9."
          ]
        }
      },
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05e7\u05e9\u05e8 \u05d4\u05db\u05d9\u05de\u05d9 \u05d1\u05d9\u05df \u05d4\u05e2\u05e6\u05d1 \u05d4\u05de\u05d5\u05d8\u05d5\u05e8\u05d9 \u05dc\u05e9\u05e8\u05d9\u05e8 \u05d4\u05e9\u05dc\u05d3.",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05dc\u05e4\u05d9 \u05d4-DSM-5-TR, \u05de\u05d4\u05d5 \u05e9\u05d9\u05e2\u05d5\u05e8 \u05d4\u05ea\u05d7\u05dc\u05d5\u05d0\u05d4 \u05d4\u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9\u05ea \u05d5\u05d4\u05e0\u05d5\u05d9\u05e8\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea \u05d4\u05e0\u05dc\u05d5\u05d5\u05d9\u05ea (Comorbidity) \u05d1\u05d0\u05d5\u05db\u05dc\u05d5\u05e1\u05d9\u05d5\u05ea \u05e2\u05dd \u05e4\u05d2\u05d9\u05e2\u05d5\u05ea \u05e0\u05d5\u05d9\u05e8\u05d5-\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9\u05d5\u05ea \u05de\u05e8\u05db\u05d6\u05d9\u05d5\u05ea \u05db\u05de\u05d5 CP \u05d5-IDD?",
      "answerOptions": [
        {
          "text": "\u05e4\u05d9 3 \u05e2\u05d3 4 \u05d2\u05d1\u05d5\u05d4 \u05d9\u05d5\u05ea\u05e8 \u05de\u05d0\u05e9\u05e8 \u05d1\u05d0\u05d5\u05db\u05dc\u05d5\u05e1\u05d9\u05d9\u05d4 \u05d4\u05db\u05dc\u05dc\u05d9\u05ea",
          "isCorrect": true,
          "rationale": "\u05d4-DSM-5-TR \u05de\u05e6\u05d9\u05d9\u05df \u05de\u05e4\u05d5\u05e8\u05e9\u05d5\u05ea \u05e9\u05e9\u05d9\u05e2\u05d5\u05e8 \u05d4\u05ea\u05d7\u05dc\u05d5\u05d0\u05d4 \u05d4\u05e0\u05dc\u05d5\u05d5\u05d9\u05ea (\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05e0\u05e4\u05e9\u05d9\u05d5\u05ea, \u05d0\u05e4\u05d9\u05dc\u05e4\u05e1\u05d9\u05d4 \u05d5\u05db\u05d5') \u05d2\u05d1\u05d5\u05d4 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05d1\u05d0\u05d5\u05db\u05dc\u05d5\u05e1\u05d9\u05d5\u05ea \u05d0\u05dc\u05d5 (DSM p.45)."
        },
        {
          "text": "\u05d6\u05d4\u05d4 \u05dc\u05e9\u05d9\u05e2\u05d5\u05e8 \u05d1\u05d0\u05d5\u05db\u05dc\u05d5\u05e1\u05d9\u05d9\u05d4 \u05d4\u05db\u05dc\u05dc\u05d9\u05ea \u05d0\u05da \u05e2\u05dd \u05d7\u05d5\u05de\u05e8\u05d4 \u05d2\u05d1\u05d5\u05d4\u05d4 \u05d9\u05d5\u05ea\u05e8",
          "isCorrect": false,
          "rationale": "\u05d4\u05e9\u05d9\u05e2\u05d5\u05e8 \u05d2\u05d1\u05d5\u05d4 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea (Prevalence), \u05d5\u05dc\u05d0 \u05e8\u05e7 \u05d4\u05d7\u05d5\u05de\u05e8\u05d4 (DSM p.45)."
        },
        {
          "text": "\u05e0\u05de\u05d5\u05da \u05d9\u05d5\u05ea\u05e8 \u05e2\u05e7\u05d1 '\u05d4\u05d2\u05e0\u05d4' \u05e9\u05dc \u05d4\u05dc\u05d9\u05e7\u05d5\u05d9 \u05d4\u05de\u05d5\u05d8\u05d5\u05e8\u05d9 \u05e2\u05dc \u05d7\u05e9\u05d9\u05e4\u05d4 \u05dc\u05d2\u05d5\u05e8\u05de\u05d9 \u05e1\u05d8\u05e8\u05e1",
          "isCorrect": false,
          "rationale": "\u05dc\u05d4\u05d9\u05e4\u05da, \u05d4\u05de\u05d5\u05d7 \u05d4\u05e4\u05d2\u05d5\u05e2 \u05e8\u05d2\u05d9\u05e9 \u05d9\u05d5\u05ea\u05e8 \u05d5\u05d4\u05e9\u05d9\u05e2\u05d5\u05e8 \u05d2\u05d1\u05d5\u05d4 \u05e4\u05d9 \u05db\u05de\u05d4 (DSM p.45)."
        },
        {
          "text": "\u05de\u05d5\u05e4\u05d9\u05e2 \u05e8\u05e7 \u05d1-10% \u05de\u05d4\u05de\u05e7\u05e8\u05d9\u05dd \u05d4\u05e7\u05e9\u05d9\u05dd \u05d1\u05d9\u05d5\u05ea\u05e8",
          "isCorrect": false,
          "rationale": "\u05ea\u05d7\u05dc\u05d5\u05d0\u05d4 \u05e0\u05dc\u05d5\u05d5\u05d9\u05ea \u05d4\u05d9\u05d0 \u05d4\u05db\u05dc\u05dc \u05d5\u05dc\u05d0 \u05d4\u05d9\u05d5\u05e6\u05d0 \u05de\u05df \u05d4\u05db\u05dc\u05dc \u05d1-CP (DSM p.45; Dulcan p.92)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05e4\u05d2\u05d9\u05e2\u05d5\u05ea \u05d4\u05de\u05d5\u05d7\u05d9\u05ea \u05d4\u05de\u05d1\u05e0\u05d9\u05ea \u05db\u05d2\u05d5\u05e8\u05dd \u05e1\u05d9\u05db\u05d5\u05df \u05e8\u05d5\u05d7\u05d1\u05d9 \u05dc\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05e0\u05d5\u05e1\u05e4\u05d5\u05ea.",
