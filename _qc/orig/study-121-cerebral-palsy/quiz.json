    {
      "type": "multiple_select",
      "question": "\u05d0\u05d9\u05dc\u05d5 \u05de\u05d4\u05de\u05de\u05e6\u05d0\u05d9\u05dd \u05d4\u05d1\u05d0\u05d9\u05dd \u05e0\u05d7\u05e9\u05d1\u05d9\u05dd \u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05d9\u05d9\u05dd \u05dc\u05e9\u05d9\u05ea\u05d5\u05e7 \u05de\u05d5\u05d7\u05d9\u05df \u05de\u05e1\u05d5\u05d2 Spastic Diplegia \u05d5\u05de\u05e7\u05d5\u05e9\u05e8\u05d9\u05dd \u05dc\u05e8\u05d5\u05d1 \u05dc\u05e4\u05d2\u05d5\u05ea (Prematurity)?",
      "answerOptions": [
