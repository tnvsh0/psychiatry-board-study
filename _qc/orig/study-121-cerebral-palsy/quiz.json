{
  "title": "Neurology Quiz",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\u05d9\u05dc\u05d3 \u05d1\u05df 4 \u05de\u05d5\u05e4\u05e0\u05d4 \u05dc\u05d4\u05e2\u05e8\u05db\u05d4 \u05e2\u05e7\u05d1 \u05d0\u05d9\u05d7\u05d5\u05e8 \u05d1\u05e8\u05db\u05d9\u05e9\u05ea \u05d0\u05d1\u05e0\u05d9 \u05d3\u05e8\u05da \u05de\u05d5\u05d8\u05d5\u05e8\u05d9\u05d5\u05ea. \u05d1\u05d1\u05d3\u05d9\u05e7\u05d4 \u05e0\u05d5\u05d9\u05e8\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea \u05e0\u05e6\u05e4\u05d4 \u05e9\u05d9\u05ea\u05d5\u05e7 \u05e1\u05e4\u05e1\u05d8\u05d9 \u05d4\u05de\u05dc\u05d5\u05d5\u05d4 \u05d1-Hypertonia, \u05d4\u05d7\u05d6\u05e8\u05d9\u05dd \u05d2\u05d9\u05d3\u05d9\u05d9\u05dd \u05e2\u05e8\u05d9\u05dd \u05de\u05d0\u05d5\u05d3 (Hyperreflexia), \u05d5\u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05e9\u05dc \u05e1\u05d9\u05de\u05df Babinski \u05d7\u05d9\u05d5\u05d1\u05d9 \u05d3\u05d5-\u05e6\u05d3\u05d3\u05d9. \u05de\u05d4\u05d9 \u05d4\u05dc\u05d5\u05e7\u05dc\u05d9\u05d6\u05e6\u05d9\u05d4 \u05d4\u05d0\u05e0\u05d8\u05d5\u05de\u05d9\u05ea \u05d4\u05e1\u05d1\u05d9\u05e8\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05e9\u05dc \u05d4\u05e4\u05d2\u05d9\u05e2\u05d4 \u05dc\u05e4\u05d9 \u05de\u05de\u05e6\u05d0\u05d9\u05dd \u05d0\u05dc\u05d5?",
      "answerOptions": [
        {
          "text": "\u05e4\u05d2\u05d9\u05e2\u05d4 \u05d1\u05de\u05e2\u05e8\u05db\u05ea \u05d4-Upper Motor Neuron (UMN)",
          "isCorrect": true,
          "rationale": "\u05e4\u05d2\u05d9\u05e2\u05d4 \u05d1-UMN, \u05d4\u05db\u05d5\u05dc\u05dc\u05ea \u05d0\u05ea \u05d4\u05de\u05e1\u05dc\u05d5\u05dc \u05d4\u05e7\u05d5\u05e8\u05d8\u05d9\u05e7\u05d5-\u05e1\u05e4\u05d9\u05e0\u05dc\u05d9, \u05de\u05ea\u05d0\u05e4\u05d9\u05d9\u05e0\u05ea \u05d1\u05e9\u05d9\u05ea\u05d5\u05e7 \u05e1\u05e4\u05e1\u05d8\u05d9, \u05d4\u05d9\u05e4\u05e8\u05d8\u05d5\u05e0\u05d9\u05d4, \u05d4\u05d7\u05d6\u05e8\u05d9\u05dd \u05e2\u05e8\u05d9\u05dd \u05d5\u05e1\u05d9\u05de\u05df Babinski \u05d7\u05d9\u05d5\u05d1\u05d9 (Dulcan p.93, Table 6-2)."
        },
        {
          "text": "\u05e4\u05d2\u05d9\u05e2\u05d4 \u05d1\u05de\u05e2\u05e8\u05db\u05ea \u05d4-Lower Motor Neuron (LMN)",
          "isCorrect": false,
          "rationale": "\u05e4\u05d2\u05d9\u05e2\u05d4 \u05d1-LMN \u05de\u05ea\u05d1\u05d8\u05d0\u05ea \u05d1\u05e9\u05d9\u05ea\u05d5\u05e7 \u05e8\u05e4\u05d4 (Flaccid), \u05d4\u05d9\u05e4\u05d5\u05d8\u05d5\u05e0\u05d9\u05d4, \u05d5\u05d4\u05d7\u05d6\u05e8\u05d9\u05dd \u05de\u05d5\u05e4\u05d7\u05ea\u05d9\u05dd \u05d0\u05d5 \u05e0\u05e2\u05d3\u05e8\u05d9\u05dd, \u05d1\u05e0\u05d9\u05d2\u05d5\u05d3 \u05dc\u05de\u05ea\u05d5\u05d0\u05e8 \u05d1\u05de\u05e7\u05e8\u05d4 (Dulcan p.93, Table 6-2)."
        },
        {
          "text": "\u05e4\u05d2\u05d9\u05e2\u05d4 \u05e8\u05d0\u05e9\u05d5\u05e0\u05d9\u05ea \u05d1-Neuromuscular Junction (NMJ)",
          "isCorrect": false,
          "rationale": "\u05e4\u05d2\u05d9\u05e2\u05d4 \u05d1-NMJ, \u05db\u05d2\u05d5\u05df \u05d1\u05de\u05d9\u05d0\u05e1\u05d8\u05e0\u05d9\u05d4, \u05d2\u05d5\u05e8\u05de\u05ea \u05dc\u05d7\u05d5\u05dc\u05e9\u05d4 \u05de\u05e9\u05ea\u05e0\u05d4 \u05dc\u05dc\u05d0 \u05e1\u05d9\u05de\u05e0\u05d9\u05dd \u05e4\u05d9\u05e8\u05de\u05d9\u05d3\u05dc\u05d9\u05d9\u05dd \u05db\u05de\u05d5 Babinski \u05d0\u05d5 \u05e1\u05e4\u05e1\u05d8\u05d9\u05d5\u05ea (StahlNeuro p.504; Dulcan p.93)."
        },
        {
          "text": "\u05e4\u05d2\u05d9\u05e2\u05d4 \u05de\u05de\u05d5\u05e7\u05d3\u05ea \u05d1-Cerebellum",
          "isCorrect": false,
          "rationale": "\u05e4\u05d2\u05d9\u05e2\u05d4 \u05e6\u05e8\u05d1\u05dc\u05e8\u05d9\u05ea \u05de\u05ea\u05d1\u05d8\u05d0\u05ea \u05d1-Ataxia, \u05d4\u05d9\u05e4\u05d5\u05d8\u05d5\u05e0\u05d9\u05d4 \u05d5\u05e8\u05e2\u05d3 \u05db\u05d5\u05d5\u05e0\u05ea\u05d9, \u05d5\u05dc\u05d0 \u05d1\u05e1\u05e4\u05e1\u05d8\u05d9\u05d5\u05ea \u05e4\u05d9\u05e8\u05de\u05d9\u05d3\u05dc\u05d9\u05ea (Dulcan p.92)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05d4\u05d1\u05d3\u05dc\u05d9\u05dd \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9\u05d9\u05dd \u05d1\u05d9\u05df \u05e4\u05d2\u05d9\u05e2\u05d4 \u05d1\u05de\u05e1\u05d9\u05dc\u05d4 \u05d4\u05e7\u05d5\u05e8\u05d8\u05d9\u05e7\u05d5-\u05e1\u05e4\u05d9\u05e0\u05dc\u05d9\u05ea \u05dc\u05d1\u05d9\u05df \u05e4\u05d2\u05d9\u05e2\u05d4 \u05d1\u05e2\u05e6\u05d1 \u05d4\u05d4\u05d9\u05e7\u05e4\u05d9 \u05d0\u05d5 \u05d1\u05e7\u05e8\u05df \u05d4\u05e7\u05d3\u05de\u05d9\u05ea.",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05d2'\u05d5\u05df, \u05d9\u05dc\u05d3 \u05d1\u05df 8 \u05d4\u05e1\u05d5\u05d1\u05dc \u05de-Cerebral Palsy \u05de\u05e1\u05d5\u05d2 Spastic Diplegia, \u05de\u05d5\u05e4\u05e0\u05d4 \u05e2\u05e7\u05d1 \u05ea\u05e1\u05de\u05d9\u05e0\u05d9 ADHD \u05e7\u05e9\u05d9\u05dd \u05d4\u05db\u05d5\u05dc\u05dc\u05d9\u05dd \u05de\u05d5\u05e1\u05d7\u05d5\u05ea \u05e0\u05d9\u05db\u05e8\u05ea, \u05d0\u05d9\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05d5\u05ea \u05d5\u05e7\u05e9\u05d9\u05d9 \u05e9\u05d9\u05e0\u05d4. \u05de\u05d4\u05d5 \u05d4\u05d9\u05ea\u05e8\u05d5\u05df \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05e9\u05dc \u05e9\u05d9\u05de\u05d5\u05e9 \u05d1-Guanfacine \u05d0\u05d5 Clonidine \u05d1\u05d0\u05d5\u05db\u05dc\u05d5\u05e1\u05d9\u05d9\u05d4 \u05d6\u05d5 \u05d1\u05d4\u05e9\u05d5\u05d5\u05d0\u05d4 \u05dc\u05e1\u05d8\u05d9\u05de\u05d5\u05dc\u05e0\u05d8\u05d9\u05dd?",
      "answerOptions": [
        {
          "text": "\u05e9\u05d9\u05e4\u05d5\u05e8 \u05d1-Executive Functioning \u05dc\u05e6\u05d3 \u05e1\u05d9\u05d5\u05e2 \u05d1\u05d5\u05d5\u05d9\u05e1\u05d5\u05ea \u05e2\u05d5\u05e8\u05e8\u05d5\u05ea \u05d9\u05ea\u05e8 \u05d5\u05e7\u05e9\u05d9\u05d9 \u05d4\u05e8\u05d3\u05de\u05d4",
          "isCorrect": true,
          "rationale": "\u05d0\u05d2\u05d5\u05e0\u05d9\u05e1\u05d8\u05d9\u05dd \u05dc\u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 $\\alpha_{2A}$ \u05d1-PFC \u05de\u05e9\u05e4\u05e8\u05d9\u05dd \u05ea\u05e4\u05e7\u05d5\u05d3\u05d9\u05dd \u05e0\u05d9\u05d4\u05d5\u05dc\u05d9\u05d9\u05dd \u05d5\u05de\u05e1\u05d9\u05d9\u05e2\u05d9\u05dd \u05d1\u05d5\u05d5\u05d9\u05e1\u05d5\u05ea \u05e9\u05d9\u05e0\u05d4 \u05d5\u05d0\u05d9-\u05e9\u05e7\u05d8, \u05d4\u05e0\u05e4\u05d5\u05e6\u05d9\u05dd \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd \u05e4\u05d2\u05d9\u05e2\u05d4 \u05de\u05d5\u05d7\u05d9\u05ea (StahlKids p.143, 248; Dulcan p.128)."
        },
        {
          "text": "\u05d4\u05e9\u05e4\u05e2\u05d4 \u05d9\u05e9\u05d9\u05e8\u05d4 \u05e2\u05dc \u05d4-GABA-B \u05dc\u05d4\u05e4\u05d7\u05ea\u05ea \u05d4\u05e1\u05e4\u05e1\u05d8\u05d9\u05d5\u05ea \u05d4\u05e9\u05e8\u05d9\u05e8\u05d9\u05ea",
          "isCorrect": false,
          "rationale": "\u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05d0\u05dc\u05d5 \u05e4\u05d5\u05e2\u05dc\u05d5\u05ea \u05e2\u05dc \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9\u05dd \u05d0\u05d3\u05e8\u05e0\u05e8\u05d2\u05d9\u05d9\u05dd \u05d5\u05dc\u05d0 \u05e2\u05dc \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 GABA-B, \u05e9\u05d4\u05dd \u05d4\u05d9\u05e2\u05d3 \u05e9\u05dc Baclofen (StahlNeuro p.445, 483)."
        },
        {
          "text": "\u05de\u05e0\u05d9\u05e2\u05d4 \u05de\u05d5\u05d7\u05dc\u05d8\u05ea \u05e9\u05dc \u05d4\u05d5\u05e8\u05d3\u05ea \u05e1\u05e3 \u05e4\u05e8\u05db\u05d5\u05e1 \u05d1\u05d4\u05e9\u05d5\u05d5\u05d0\u05d4 \u05dc\u05db\u05dc \u05d8\u05d9\u05e4\u05d5\u05dc \u05d0\u05d7\u05e8",
          "isCorrect": false,
          "rationale": "\u05d1\u05e2\u05d5\u05d3 \u05e9\u05d4\u05df \u05d1\u05d8\u05d5\u05d7\u05d5\u05ea \u05d9\u05d7\u05e1\u05d9\u05ea, \u05db\u05de\u05e2\u05d8 \u05db\u05dc \u05d4\u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05d4\u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05e8\u05d5\u05e4\u05d9\u05d5\u05ea \u05d3\u05d5\u05e8\u05e9\u05d5\u05ea \u05d6\u05d4\u05d9\u05e8\u05d5\u05ea \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd \u05e4\u05e6\u05d9\u05e2\u05d5\u05ea \u05de\u05d5\u05d7\u05d9\u05d5\u05ea \u05d5\u05d0\u05e4\u05d9\u05dc\u05e4\u05e1\u05d9\u05d4 (StahlKids p.11, 143)."
        },
        {
          "text": "\u05d4\u05d2\u05d1\u05e8\u05ea \u05e9\u05d7\u05e8\u05d5\u05e8 Dopamine \u05d1-Nucleus Accumbens \u05dc\u05e9\u05d9\u05e4\u05d5\u05e8 \u05d4\u05de\u05d5\u05d8\u05d9\u05d1\u05e6\u05d9\u05d4",
          "isCorrect": false,
          "rationale": "\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d6\u05d4 \u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05e1\u05d8\u05d9\u05de\u05d5\u05dc\u05e0\u05d8\u05d9\u05dd; Guanfacine \u05e4\u05d5\u05e2\u05dc\u05ea \u05e2\u05dc PFC \u05dc\u05e9\u05d9\u05e4\u05d5\u05e8 \u05e2\u05d5\u05e6\u05de\u05ea \u05d4\u05d0\u05d5\u05ea (Signal) \u05d4\u05e0\u05d9\u05d4\u05d5\u05dc\u05d9 (StahlNeuro p.449, 483)."
        }
      ],
      "hint": "\u05d4\u05ea\u05de\u05e7\u05d3 \u05d1\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05e4\u05e2\u05d5\u05dc\u05d4 \u05e9\u05dc \u05d0\u05d2\u05d5\u05e0\u05d9\u05e1\u05d8\u05d9\u05dd \u05e4\u05d5\u05e1\u05d8-\u05e1\u05d9\u05e0\u05e4\u05d8\u05d9\u05d9\u05dd \u05dc\u05d0\u05dc\u05e4\u05d0-2 \u05d5\u05d1\u05d9\u05ea\u05e8\u05d5\u05e0\u05d5\u05ea\u05d9\u05d4\u05dd \u05d4\u05e0\u05dc\u05d5\u05d5\u05d9\u05dd \u05d1\u05d5\u05d5\u05d9\u05e1\u05d5\u05ea \u05e8\u05d2\u05e9\u05d9 \u05d5\u05e9\u05d9\u05e0\u05d4.",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05d1\u05ea\u05d4\u05dc\u05d9\u05da \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05de\u05d1\u05d3\u05dc\u05ea \u05d1\u05d9\u05df Developmental Coordination Disorder (DCD) \u05dc\u05d1\u05d9\u05df \u05e9\u05d9\u05ea\u05d5\u05e7 \u05de\u05d5\u05d7\u05d9\u05df (CP), \u05de\u05d4\u05d5 \u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df \u05d4\u05de\u05db\u05e8\u05d9\u05e2 \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR \u05d4\u05e9\u05d5\u05dc\u05dc \u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc DCD?",
      "answerOptions": [
        {
          "text": "\u05d4\u05dc\u05d9\u05e7\u05d5\u05d9 \u05d4\u05de\u05d5\u05d8\u05d5\u05e8\u05d9 \u05de\u05d5\u05e1\u05d1\u05e8 \u05d8\u05d5\u05d1 \u05d9\u05d5\u05ea\u05e8 \u05e2\u05dc \u05d9\u05d3\u05d9 \u05de\u05e6\u05d1 \u05e0\u05d5\u05d9\u05e8\u05d5\u05dc\u05d5\u05d2\u05d9 \u05db\u05de\u05d5 Cerebral Palsy",
          "isCorrect": true,
          "rationale": "\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df D \u05d1-DSM-5-TR \u05e7\u05d5\u05d1\u05e2 \u05e9-DCD \u05d0\u05d9\u05e0\u05d5 \u05de\u05d0\u05d5\u05d1\u05d7\u05df \u05d0\u05dd \u05d4\u05dc\u05d9\u05e7\u05d5\u05d9 \u05de\u05d9\u05d5\u05d7\u05e1 \u05dc\u05de\u05d7\u05dc\u05d4 \u05e0\u05d5\u05d9\u05e8\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea \u05d4\u05de\u05e9\u05e4\u05d9\u05e2\u05d4 \u05e2\u05dc \u05d4\u05ea\u05e0\u05d5\u05e2\u05d4 \u05db\u05d2\u05d5\u05df CP (DSM p.86)."
        },
        {
          "text": "\u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05e9\u05dc Neurological Soft Signs \u05d1\u05dc\u05d1\u05d3 \u05d1\u05d1\u05d3\u05d9\u05e7\u05d4 \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9\u05ea",
          "isCorrect": false,
          "rationale": "\u05e1\u05d9\u05de\u05e0\u05d9\u05dd \u05e8\u05db\u05d9\u05dd \u05e0\u05e4\u05d5\u05e6\u05d9\u05dd \u05d1-DCD; \u05d1-CP \u05de\u05e6\u05e4\u05d9\u05dd \u05dc\u05de\u05e6\u05d5\u05d0 \u05e1\u05d9\u05de\u05e0\u05d9\u05dd \u05e0\u05d5\u05d9\u05e8\u05d5\u05dc\u05d5\u05d2\u05d9\u05d9\u05dd '\u05e7\u05e9\u05d9\u05dd' \u05d5\u05e4\u05ea\u05d5\u05dc\u05d5\u05d2\u05d9\u05d9\u05dd (Dulcan p.169, 185)."
        },
        {
          "text": "\u05d4\u05d5\u05e4\u05e2\u05ea \u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05dc\u05d0\u05d7\u05e8 \u05d2\u05d9\u05dc 5 \u05e9\u05e0\u05d9\u05dd",
          "isCorrect": false,
          "rationale": "\u05e9\u05ea\u05d9 \u05d4\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05de\u05ea\u05d7\u05d9\u05dc\u05d5\u05ea \u05d1\u05ea\u05e7\u05d5\u05e4\u05d4 \u05d4\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9\u05ea \u05d4\u05de\u05d5\u05e7\u05d3\u05de\u05ea, \u05d0\u05dd \u05db\u05d9 DCD \u05dc\u05e8\u05d5\u05d1 \u05de\u05d0\u05d5\u05d1\u05d7\u05e0\u05ea \u05e8\u05e9\u05de\u05d9\u05ea \u05e1\u05d1\u05d9\u05d1 \u05d2\u05d9\u05dc 5 (DSM p.86; Dulcan p.85)."
        },
        {
          "text": "\u05d4\u05d9\u05e2\u05d3\u05e8 \u05e4\u05d2\u05d9\u05e2\u05d4 \u05d1\u05ea\u05e4\u05e7\u05d5\u05d3 \u05d4\u05d0\u05e7\u05d3\u05de\u05d9 \u05d0\u05d5 \u05d1\u05e4\u05e2\u05d9\u05dc\u05d5\u05d9\u05d5\u05ea \u05d4\u05d9\u05d5\u05de\u05d9\u05d5\u05dd",
          "isCorrect": false,
          "rationale": "\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df B \u05dc-DCD \u05de\u05d7\u05d9\u05d9\u05d1 \u05e4\u05d2\u05d9\u05e2\u05d4 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05d1\u05ea\u05e4\u05e7\u05d5\u05d3 \u05d4\u05d9\u05d5\u05de\u05d9\u05d5\u05de\u05d9 \u05d0\u05d5 \u05d4\u05d0\u05e7\u05d3\u05de\u05d9 (DSM p.86)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc DCD \u05db\u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05e0\u05d9\u05ea\u05e0\u05ea \u05e8\u05e7 \u05db\u05d0\u05e9\u05e8 \u05d0\u05d9\u05df \u05d4\u05e1\u05d1\u05e8 \u05e8\u05e4\u05d5\u05d0\u05d9-\u05de\u05d1\u05e0\u05d9 \u05d0\u05d7\u05e8 \u05dc\u05dc\u05d9\u05e7\u05d5\u05d9 \u05d4\u05de\u05d5\u05d8\u05d5\u05e8\u05d9.",
      "imageUrls": []
    },
    {
      "type": "fill_in_the_blank",
      "question": "\u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 Baclofen, \u05d4\u05de\u05e9\u05de\u05e9\u05ea \u05dc\u05e0\u05d9\u05d4\u05d5\u05dc \u05e1\u05e4\u05e1\u05d8\u05d9\u05d5\u05ea \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd \u05e9\u05d9\u05ea\u05d5\u05e7 \u05de\u05d5\u05d7\u05d9\u05df, \u05e4\u05d5\u05e2\u05dc\u05ea \u05db\u05d0\u05d2\u05d5\u05e0\u05d9\u05e1\u05d8 \u05e1\u05dc\u05e7\u05d8\u05d9\u05d1\u05d9 \u05dc\u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 ___ \u05d1\u05d7\u05d5\u05d8 \u05d4\u05e9\u05d3\u05e8\u05d4, \u05d5\u05d1\u05db\u05da \u05d2\u05d5\u05e8\u05de\u05ea \u05dc\u05e2\u05d9\u05db\u05d5\u05d1 \u05e4\u05e8\u05d4-\u05e1\u05d9\u05e0\u05e4\u05d8\u05d9 \u05e9\u05dc \u05e9\u05d7\u05e8\u05d5\u05e8 \u05e0\u05d5\u05d9\u05e8\u05d5\u05d8\u05e8\u05e0\u05e1\u05de\u05d9\u05d8\u05d5\u05e8\u05d9\u05dd \u05de\u05e2\u05d5\u05e8\u05e8\u05d9\u05dd.",
      "bestAnswer": "GABA-B",
      "acceptableAnswers": [
        "GABA B",
        "gamma-aminobutyric acid type B"
      ],
      "rationale": "Baclofen \u05e4\u05d5\u05e2\u05dc \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05ea \u05e2\u05dc \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 GABA-B (\u05dc\u05e2\u05d5\u05de\u05ea \u05d1\u05e0\u05d6\u05d5\u05d3\u05d9\u05d0\u05d6\u05e4\u05d9\u05e0\u05d9\u05dd \u05d4\u05e4\u05d5\u05e2\u05dc\u05d9\u05dd \u05e2\u05dc GABA-A) \u05db\u05d3\u05d9 \u05dc\u05d4\u05e4\u05d7\u05d9\u05ea \u05d0\u05ea \u05d4\u05d8\u05d5\u05e0\u05d5\u05e1 \u05d4\u05e9\u05e8\u05d9\u05e8\u05d9 \u05d4\u05e1\u05e4\u05e1\u05d8\u05d9 (StahlNeuro p.445, 524; Dulcan p.124).",
      "hint": "\u05de\u05d3\u05d5\u05d1\u05e8 \u05d1\u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 GABA \u05d4\u05de\u05e6\u05d5\u05de\u05d3\u05d9\u05dd \u05dc\u05d7\u05dc\u05d1\u05d5\u05e0\u05d9 G, \u05dc\u05d4\u05d1\u05d3\u05d9\u05dc \u05de\u05d4\u05e7\u05d5\u05dc\u05d8\u05e0\u05d9\u05dd \u05d4\u05d9\u05d5\u05e0\u05d5\u05d8\u05e8\u05d5\u05e4\u05d9\u05d9\u05dd \u05d4\u05de\u05d4\u05d9\u05e8\u05d9\u05dd."
    },
    {
      "type": "multiple_choice",
      "question": "\u05d9\u05dc\u05d3 \u05d1\u05df 6 \u05e2\u05dd Quadriplegia Spasticity \u05d5\u05d3\u05d9\u05e1\u05d0\u05e8\u05ea\u05e8\u05d9\u05d4 \u05d7\u05de\u05d5\u05e8\u05d4 \u05de\u05d5\u05e4\u05e0\u05d4 \u05dc\u05d4\u05e2\u05e8\u05db\u05d4 \u05e9\u05dc Intellectual Developmental Disorder (IDD). \u05d1\u05e9\u05dc \u05d4\u05de\u05d2\u05d1\u05dc\u05d4 \u05d4\u05de\u05d5\u05d8\u05d5\u05e8\u05d9\u05ea \u05d5\u05d4\u05e9\u05e4\u05ea\u05d9\u05ea \u05d4\u05e7\u05e9\u05d4, \u05d4\u05d5\u05d0 \u05d0\u05d9\u05e0\u05d5 \u05de\u05e1\u05d5\u05d2\u05dc \u05dc\u05d4\u05e9\u05dc\u05d9\u05dd \u05de\u05d1\u05d7\u05df IQ \u05e1\u05d8\u05e0\u05d3\u05e8\u05d8\u05d9. \u05de\u05d4\u05d9 \u05d4\u05d0\u05e1\u05d8\u05e8\u05d8\u05d2\u05d9\u05d4 \u05d4\u05d0\u05d1\u05d7\u05e0\u05ea\u05d9\u05ea \u05d4\u05de\u05d5\u05de\u05dc\u05e6\u05ea \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR?",
      "answerOptions": [
        {
          "text": "\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc Unspecified Intellectual Developmental Disorder (F79)",
          "isCorrect": true,
          "rationale": "\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d6\u05d5 \u05e9\u05de\u05d5\u05e8\u05d4 \u05dc\u05de\u05e7\u05e8\u05d9\u05dd \u05d1\u05d4\u05dd \u05d4\u05e2\u05e8\u05db\u05ea \u05d4\u05de\u05e9\u05db\u05dc \u05d0\u05d9\u05e0\u05d4 \u05e0\u05d9\u05ea\u05e0\u05ea \u05dc\u05d1\u05d9\u05e6\u05d5\u05e2 \u05e2\u05e7\u05d1 \u05dc\u05d9\u05e7\u05d5\u05d9\u05d9\u05dd \u05e1\u05e0\u05e1\u05d5\u05e8\u05d9\u05d9\u05dd \u05d0\u05d5 \u05de\u05d5\u05d8\u05d5\u05e8\u05d9\u05d9\u05dd \u05d7\u05de\u05d5\u05e8\u05d9\u05dd, \u05db\u05e4\u05d9 \u05e9\u05e7\u05d5\u05e8\u05d4 \u05d1-CP \u05e7\u05e9\u05d4 (DSM p.46)."
        },
        {
          "text": "\u05e7\u05d1\u05d9\u05e2\u05ea \u05e8\u05de\u05ea \u05d4\u05d7\u05d5\u05de\u05e8\u05d4 \u05dc\u05e4\u05d9 \u05e6\u05d9\u05d5\u05df \u05d4-IQ \u05d4\u05de\u05e9\u05d5\u05e2\u05e8 \u05de\u05d4\u05ea\u05e8\u05e9\u05de\u05d5\u05ea \u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05d1\u05dc\u05d1\u05d3",
          "isCorrect": false,
          "rationale": "\u05d4-DSM-5-TR \u05d3\u05d5\u05e8\u05e9 \u05d4\u05e2\u05e8\u05db\u05d4 \u05e9\u05dc \u05ea\u05e4\u05e7\u05d5\u05d3 \u05d4\u05e1\u05ea\u05d2\u05dc\u05d5\u05ea\u05d9 \u05dc\u05e7\u05d1\u05d9\u05e2\u05ea \u05d7\u05d5\u05de\u05e8\u05d4, \u05d5\u05dc\u05d0 \u05e8\u05e7 \u05d4\u05e2\u05e8\u05db\u05ea IQ (DSM p.37)."
        },
        {
          "text": "\u05de\u05ea\u05df \u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc Global Developmental Delay (GDD) \u05d1\u05e9\u05dc \u05d2\u05d9\u05dc\u05d5 \u05d4\u05e6\u05e2\u05d9\u05e8",
          "isCorrect": false,
          "rationale": "GDD \u05de\u05d9\u05d5\u05e2\u05d3\u05ea \u05dc\u05d9\u05dc\u05d3\u05d9\u05dd \u05de\u05ea\u05d7\u05ea \u05dc\u05d2\u05d9\u05dc 5; \u05de\u05e2\u05dc \u05d2\u05d9\u05dc \u05d6\u05d4 \u05d9\u05e9 \u05dc\u05e9\u05d0\u05d5\u05e3 \u05dc\u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc IDD \u05d0\u05d5 Unspecified IDD (DSM p.46)."
        },
        {
          "text": "\u05d3\u05d7\u05d9\u05d9\u05ea \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05e2\u05d3 \u05dc\u05e9\u05d9\u05e4\u05d5\u05e8 \u05d1\u05d9\u05db\u05d5\u05dc\u05d5\u05ea \u05d4\u05d3\u05d9\u05d1\u05d5\u05e8 \u05d1\u05e2\u05e7\u05d1\u05d5\u05ea \u05e7\u05dc\u05d9\u05e0\u05d0\u05d5\u05ea \u05ea\u05e7\u05e9\u05d5\u05e8\u05ea",
          "isCorrect": false,
          "rationale": "\u05d0\u05d9\u05df \u05dc\u05e2\u05db\u05d1 \u05d0\u05d1\u05d7\u05e0\u05d4 \u05d5\u05de\u05ea\u05df \u05ea\u05de\u05d9\u05db\u05d5\u05ea; \u05d9\u05e9 \u05dc\u05d4\u05e9\u05ea\u05de\u05e9 \u05d1\u05db\u05dc\u05d9\u05dd \u05de\u05d5\u05ea\u05d0\u05de\u05d9\u05dd \u05db\u05d2\u05d5\u05df \u05de\u05d1\u05d7\u05e0\u05d9\u05dd \u05d0\u05dc-\u05de\u05dc\u05d5\u05dc\u05d9\u05d9\u05dd \u05d0\u05d5 \u05d0\u05d1\u05d7\u05e0\u05d4 \u05dc\u05d0-\u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05ea (Dulcan p.112; DSM p.46)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4 \u05d4\u05d0\u05d1\u05d7\u05e0\u05ea\u05d9\u05ea \u05d4\u05de\u05d9\u05d5\u05e2\u05d3\u05ea \u05dc\u05de\u05e6\u05d1\u05d9\u05dd \u05e9\u05d1\u05d4\u05dd \u05dc\u05d0 \u05e0\u05d9\u05ea\u05df \u05dc\u05d1\u05e6\u05e2 \u05d4\u05e2\u05e8\u05db\u05d4 \u05e4\u05d5\u05e8\u05de\u05dc\u05d9\u05ea \u05de\u05d4\u05d9\u05de\u05e0\u05d4.",
      "imageUrls": []
    },
    {
      "type": "short_answer",
      "question": "\u05de\u05d3\u05d5\u05e2 \u05d7\u05d5\u05d1\u05d4 \u05dc\u05d1\u05e6\u05e2 \u05d1\u05d9\u05e8\u05d5\u05e8 \u05e8\u05e4\u05d5\u05d0\u05d9 \u05de\u05e7\u05d9\u05e3 \u05dc\u05e9\u05dc\u05d9\u05dc\u05ea \u05db\u05d0\u05d1 \u05e4\u05d9\u05d6\u05d9 \u05d1\u05d9\u05dc\u05d3 \u05dc\u05d0-\u05d5\u05e8\u05d1\u05dc\u05d9 \u05e2\u05dd \u05e9\u05d9\u05ea\u05d5\u05e7 \u05de\u05d5\u05d7\u05d9\u05df \u05d4\u05de\u05e6\u05d9\u05d2 \u05d4\u05ea\u05e4\u05e8\u05e6\u05d5\u05ea \u05e4\u05ea\u05d0\u05d5\u05de\u05d9\u05ea \u05e9\u05dc \u05d0\u05d9-\u05e9\u05e7\u05d8 \u05d0\u05d5 Self-Injurious Behavior (SIB)?",
      "grading": {
        "modelAnswer": "\u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05dc\u05d0-\u05d5\u05e8\u05d1\u05dc\u05d9\u05d9\u05dd, \u05db\u05d0\u05d1 \u05e4\u05d9\u05d6\u05d9 \u05e1\u05de\u05d5\u05d9 (\u05db\u05d2\u05d5\u05df GERD, \u05e2\u05e6\u05d9\u05e8\u05d5\u05ea \u05e7\u05e9\u05d4, \u05d0\u05d5 \u05e4\u05e8\u05d9\u05e7\u05ea \u05d9\u05e8\u05da) \u05de\u05ea\u05d1\u05d8\u05d0 \u05dc\u05e2\u05d9\u05ea\u05d9\u05dd \u05e7\u05e8\u05d5\u05d1\u05d5\u05ea \u05d3\u05e8\u05da \u05e9\u05d9\u05e0\u05d5\u05d9\u05d9 \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05e7\u05d9\u05e6\u05d5\u05e0\u05d9\u05d9\u05dd \u05de\u05d0\u05d7\u05e8 \u05e9\u05d4\u05d9\u05dc\u05d3 \u05d0\u05d9\u05e0\u05d5 \u05d9\u05db\u05d5\u05dc \u05dc\u05ea\u05e7\u05e9\u05e8 \u05d0\u05ea \u05d4\u05de\u05e6\u05d5\u05e7\u05d4. \u05d0\u05d1\u05d7\u05d5\u05df \u05e9\u05d2\u05d5\u05d9 \u05e9\u05dc \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d6\u05d5 \u05db\u05d4\u05e4\u05e8\u05e2\u05d4 \u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9\u05ea \u05e8\u05d0\u05e9\u05d5\u05e0\u05d9\u05ea \u05e2\u05dc\u05d5\u05dc \u05dc\u05d4\u05d5\u05d1\u05d9\u05dc \u05dc\u05de\u05ea\u05df \u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05e8\u05d5\u05e4\u05d9\u05d5\u05ea \u05de\u05d9\u05d5\u05ea\u05e8\u05d5\u05ea \u05d1\u05de\u05e7\u05d5\u05dd \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05e1\u05d9\u05d1\u05d4 \u05d4\u05e8\u05e4\u05d5\u05d0\u05d9\u05ea.",
        "rationale": "\u05d4\u05de\u05e7\u05d5\u05e8\u05d5\u05ea \u05de\u05d3\u05d2\u05d9\u05e9\u05d9\u05dd \u05db\u05d9 \u05db\u05d0\u05d1 \u05d4\u05d5\u05d0 \u05d2\u05d5\u05e8\u05dd \u05e9\u05db\u05d9\u05d7 \u05dc\u05d0\u05d9-\u05e9\u05e7\u05d8 \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd \u05de\u05d5\u05d2\u05d1\u05dc\u05d5\u05ea \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9\u05ea \u05d5\u05d7\u05d5\u05d1\u05d4 \u05dc\u05e9\u05dc\u05d5\u05dc \u05d0\u05d5\u05ea\u05d5 \u05dc\u05e4\u05e0\u05d9 \u05d4\u05ea\u05d7\u05dc\u05ea \u05d8\u05d9\u05e4\u05d5\u05dc \u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9 (Dulcan p.124; StahlKids p.494).",
        "requiredAttributes": [
          "\u05e6\u05d9\u05d5\u05df \u05d4\u05e7\u05d5\u05e9\u05d9 \u05d1\u05ea\u05e7\u05e9\u05d5\u05e8\u05ea \u05e9\u05dc \u05db\u05d0\u05d1 \u05d1\u05d9\u05dc\u05d3 \u05dc\u05d0-\u05d5\u05e8\u05d1\u05dc\u05d9.",
          "\u05d3\u05d5\u05d2\u05de\u05d4 \u05dc\u05de\u05e7\u05d5\u05e8 \u05db\u05d0\u05d1 \u05e4\u05d5\u05d8\u05e0\u05e6\u05d9\u05d0\u05dc\u05d9 (GERD, \u05e2\u05e6\u05d9\u05e8\u05d5\u05ea, \u05e1\u05e4\u05d6\u05dd \u05d5\u05db\u05d5').",
