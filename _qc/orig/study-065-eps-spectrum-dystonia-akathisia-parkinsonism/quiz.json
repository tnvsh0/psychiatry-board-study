    {
      "type": "short_answer",
      "question": "\u05ea\u05d0\u05e8 \u05d0\u05ea \u05d4\u05d4\u05e1\u05ea\u05de\u05e0\u05d5\u05ea \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05d4\u05e7\u05dc\u05d0\u05e1\u05d9\u05ea \u05e9\u05dc Neuroleptic Malignant Syndrome (NMS) \u05d5\u05e6\u05d9\u05d9\u05df \u05e9\u05dc\u05d5\u05e9\u05d4 \u05de\u05d3\u05d3\u05d9 \u05de\u05e2\u05d1\u05d3\u05d4 \u05d0\u05d5 \u05de\u05d3\u05d3\u05d9\u05dd \u05d7\u05d9\u05d5\u05e0\u05d9\u05d9\u05dd (Vital signs) \u05d0\u05d1\u05e0\u05d5\u05e8\u05de\u05dc\u05d9\u05d9\u05dd \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9\u05dd \u05de\u05e6\u05d1 \u05d6\u05d4.",
      "grading": {
        "modelAnswer": "\u05d4-NMS \u05de\u05d0\u05d5\u05e4\u05d9\u05d9\u05df \u05d1\u05e7\u05e9\u05d9\u05d7\u05d5\u05ea \u05e9\u05e8\u05d9\u05e8\u05d9\u05ea \u05e7\u05e9\u05d4 ('Lead-pipe'), \u05d4\u05d9\u05e4\u05e8\u05ea\u05e8\u05de\u05d9\u05d4 (\u05d7\u05d5\u05dd \u05de\u05e2\u05dc $38^{\\circ}C$), \u05d5\u05e9\u05d9\u05e0\u05d5\u05d9 \u05d1\u05de\u05e6\u05d1 \u05d4\u05d4\u05db\u05e8\u05d4 (\u05d3\u05dc\u05d9\u05e8\u05d9\u05d5\u05dd \u05e2\u05d3 \u05e7\u05d5\u05de\u05d4). \u05de\u05d3\u05d3\u05d9\u05dd \u05d0\u05d1\u05e0\u05d5\u05e8\u05de\u05dc\u05d9\u05d9\u05dd \u05db\u05d5\u05dc\u05dc\u05d9\u05dd \u05e2\u05dc\u05d9\u05d9\u05d4 \u05d1-Creatine Kinase (CPK) \u05de\u05e2\u05dc \u05e4\u05d9 4 \u05de\u05d4\u05e0\u05d5\u05e8\u05de\u05d4, Leukocytosis (\u05e2\u05dc\u05d9\u05d9\u05d4 \u05d1\u05e1\u05e4\u05d9\u05e8\u05d4 \u05dc\u05d1\u05e0\u05d4), \u05d5\u05d0\u05d9-\u05d9\u05e6\u05d9\u05d1\u05d5\u05ea \u05d0\u05d5\u05d8\u05d5\u05e0\u05d5\u05de\u05d9\u05ea \u05db\u05de\u05d5 Tachycardia \u05d0\u05d5 \u05ea\u05e0\u05d5\u05d3\u05d5\u05ea \u05d1\u05dc\u05d7\u05e5 \u05d4\u05d3\u05dd (DSM p.810).",
        "rationale": "NMS \u05d4\u05d5\u05d0 \u05de\u05e6\u05d1 \u05d7\u05d9\u05e8\u05d5\u05dd \u05e8\u05e4\u05d5\u05d0\u05d9 \u05d4\u05de\u05e9\u05dc\u05d1 \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05de\u05d5\u05d8\u05d5\u05e8\u05d9\u05d9\u05dd, \u05d0\u05d5\u05d8\u05d5\u05e0\u05d5\u05de\u05d9\u05d9\u05dd \u05d5\u05de\u05d8\u05d1\u05d5\u05dc\u05d9\u05d9\u05dd \u05e2\u05e7\u05d1 \u05d7\u05e1\u05d9\u05de\u05d4 \u05de\u05d0\u05e1\u05d9\u05d1\u05d9\u05ea \u05e9\u05dc D2 (DSM p.810-811).",
        "requiredAttributes": [
          "\u05e6\u05d9\u05d5\u05df \u05e7\u05e9\u05d9\u05d7\u05d5\u05ea \u05e9\u05e8\u05d9\u05e8\u05d9\u05ea (Rigidity).",
          "\u05e6\u05d9\u05d5\u05df \u05d7\u05d5\u05dd \u05d2\u05d1\u05d5\u05d4 (Hyperthermia/Fever).",
          "\u05e6\u05d9\u05d5\u05df \u05e2\u05dc\u05d9\u05d9\u05d4 \u05d1-CPK \u05d0\u05d5 Leukocytosis.",
          "\u05e6\u05d9\u05d5\u05df \u05d0\u05d9-\u05d9\u05e6\u05d9\u05d1\u05d5\u05ea \u05d0\u05d5\u05d8\u05d5\u05e0\u05d5\u05de\u05d9\u05ea (Tachycardia/BP fluctuations)."
        ],
        "errors": {
          "misconceptions": [
            "\u05d1\u05dc\u05d1\u05d5\u05dc \u05e2\u05dd Serotonin Syndrome (\u05e9\u05d1\u05d5 \u05d9\u05e9 Hyperreflexia \u05d5\u05dc\u05d0 Lead-pipe rigidity)."
          ],
          "bluffs": [
            "\u05d0\u05de\u05d9\u05e8\u05d4 \u05db\u05dc\u05dc\u05d9\u05ea \u05e9\u05de\u05d3\u05d5\u05d1\u05e8 \u05d1\u05ea\u05d2\u05d5\u05d1\u05d4 \u05d0\u05dc\u05e8\u05d2\u05d9\u05ea \u05dc\u05ea\u05e8\u05d5\u05e4\u05d4."
          ]
        }
      },
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05d8\u05e8\u05d9\u05d0\u05d3\u05d4 \u05e9\u05dc \u05d7\u05d5\u05dd, \u05e0\u05d5\u05e7\u05e9\u05d5\u05ea \u05d5\u05e9\u05d9\u05e0\u05d5\u05d9 \u05de\u05e6\u05d1 \u05d4\u05db\u05e8\u05d4.",
      "covered": [
        "Neuroleptic Malignant Syndrome Recognition"
      ]
    },
    {
      "type": "multiple_choice",
      "question": "\u05d1\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05d0\u05d2\u05d9\u05d8\u05e6\u05d9\u05d4 \u05d7\u05e8\u05d9\u05e4\u05d4 \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd \u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05e0\u05d5\u05d9\u05e8\u05d5-\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9\u05d5\u05ea (\u05db\u05d2\u05d5\u05df ASD), \u05de\u05d3\u05d5\u05e2 \u05d9\u05e9 \u05dc\u05e0\u05e7\u05d5\u05d8 \u05de\u05e9\u05e0\u05d4 \u05d6\u05d4\u05d9\u05e8\u05d5\u05ea \u05d1\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1-Diphenhydramine?",
      "answerOptions": [
        {
          "text": "\u05d4\u05d5\u05d0 \u05e2\u05dc\u05d5\u05dc \u05dc\u05d2\u05e8\u05d5\u05dd \u05dc\u05ea\u05d2\u05d5\u05d1\u05d4 \u05e4\u05e8\u05d3\u05d5\u05e7\u05e1\u05dc\u05d9\u05ea (Paradoxical reaction) \u05d4\u05db\u05d5\u05dc\u05dc\u05ea \u05d4\u05d7\u05de\u05e8\u05d4 \u05d1\u05d0\u05d2\u05d9\u05d8\u05e6\u05d9\u05d4 \u05d5\u05d3\u05dc\u05d9\u05e8\u05d9\u05d5\u05dd.",
          "isCorrect": true,
          "rationale": "\u05d9\u05dc\u05d3\u05d9\u05dd \u05e6\u05e2\u05d9\u05e8\u05d9\u05dd \u05d5\u05d0\u05dc\u05d5 \u05e2\u05dd \u05e2\u05d9\u05db\u05d5\u05d1 \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9 \u05e0\u05de\u05e6\u05d0\u05d9\u05dd \u05d1\u05e1\u05d9\u05db\u05d5\u05df \u05d2\u05d1\u05d5\u05d4 \u05d9\u05d5\u05ea\u05e8 \u05dc\u05ea\u05d2\u05d5\u05d1\u05d5\u05ea \u05d4\u05e4\u05d5\u05db\u05d5\u05ea (Paradoxical) \u05dc-Antihistamines \u05d5-Benzodiazepines (Dulcan p.611-612)."
        },
        {
          "text": "\u05d4\u05d5\u05d0 \u05de\u05e2\u05dc\u05d4 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05d0\u05ea \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05dc-Agranulocytosis \u05d1\u05e9\u05d9\u05dc\u05d5\u05d1 \u05e2\u05dd Clozapine.",
          "isCorrect": false,
          "rationale": "\u05d0\u05d9\u05df \u05e7\u05e9\u05e8 \u05de\u05ea\u05d5\u05e2\u05d3 \u05d1\u05de\u05e7\u05d5\u05e8\u05d5\u05ea \u05d1\u05d9\u05df Diphenhydramine \u05dc\u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05d3\u05d9\u05db\u05d5\u05d9 \u05de\u05d7 \u05e2\u05e6\u05dd; \u05e1\u05d9\u05db\u05d5\u05df \u05d6\u05d4 \u05d9\u05d9\u05d7\u05d5\u05d3\u05d9 \u05dc-Clozapine (StahlKids p.106)."
        },
        {
          "text": "\u05d4\u05d5\u05d0 \u05d2\u05d5\u05e8\u05dd \u05dc\u05d9\u05e8\u05d9\u05d3\u05d4 \u05d7\u05d3\u05d4 \u05d1\u05e1\u05e3 \u05d4\u05e4\u05e8\u05db\u05d5\u05e1 (Seizure threshold) \u05d9\u05d5\u05ea\u05e8 \u05de\u05db\u05dc \u05ea\u05e8\u05d5\u05e4\u05d4 \u05d0\u05d7\u05e8\u05ea.",
          "isCorrect": false,
          "rationale": "\u05d0\u05de\u05e0\u05dd \u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05e8\u05d5\u05e4\u05d9\u05d5\u05ea \u05e8\u05d1\u05d5\u05ea \u05de\u05e9\u05e4\u05d9\u05e2\u05d5\u05ea \u05e2\u05dc \u05e1\u05e3 \u05e4\u05e8\u05db\u05d5\u05e1, \u05d0\u05da \u05d6\u05d5 \u05d0\u05d9\u05e0\u05d4 \u05d4\u05e1\u05d9\u05d1\u05d4 \u05d4\u05e2\u05d9\u05e7\u05e8\u05d9\u05ea \u05dc\u05d6\u05d4\u05d9\u05e8\u05d5\u05ea \u05d1-Diphenhydramine \u05d1\u05d0\u05d5\u05db\u05dc\u05d5\u05e1\u05d9\u05d9\u05d4 \u05d6\u05d5 (Dulcan p.611)."
        },
        {
          "text": "\u05d4\u05d5\u05d0 \u05d7\u05d5\u05e1\u05dd \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 D2 \u05d1\u05d6\u05d9\u05e7\u05d4 \u05d2\u05d1\u05d5\u05d4\u05d4 \u05d5\u05d2\u05d5\u05e8\u05dd \u05dc\u05d3\u05d9\u05e1\u05d8\u05d5\u05e0\u05d9\u05d4 \u05de\u05d9\u05d9\u05d3\u05d9\u05ea.",
          "isCorrect": false,
          "rationale": "Diphenhydramine \u05d4\u05d5\u05d0 \u05d0\u05e0\u05d8\u05d2\u05d5\u05e0\u05d9\u05e1\u05d8 \u05dc\u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 H1 \u05d5\u05d1\u05e2\u05dc \u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05d0\u05e0\u05d8\u05d9\u05db\u05d5\u05dc\u05d9\u05e0\u05e8\u05d2\u05d9\u05ea; \u05d4\u05d5\u05d0 \u05dc\u05de\u05e2\u05e9\u05d4 *\u05de\u05d8\u05e4\u05dc* \u05d1\u05d3\u05d9\u05e1\u05d8\u05d5\u05e0\u05d9\u05d4 \u05d5\u05dc\u05d0 \u05d2\u05d5\u05e8\u05dd \u05dc\u05d4 (StahlKids p.39)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05e9\u05e4\u05e2\u05d5\u05ea \u05dc\u05d0 \u05e6\u05e4\u05d5\u05d9\u05d5\u05ea \u05e9\u05dc \u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05de\u05e8\u05d2\u05d9\u05e2\u05d5\u05ea \u05e2\u05dc \u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05e2\u05e6\u05d1\u05d9\u05dd \u05e9\u05dc \u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd ASD.",
      "covered": [
        "Pediatric Considerations and Paradoxical Reactions"
      ]
    },
    {
      "type": "multiple_select",
      "question": "\u05d0\u05d9\u05dc\u05d5 \u05de\u05d4\u05de\u05e6\u05d1\u05d9\u05dd \u05d4\u05d1\u05d0\u05d9\u05dd \u05de\u05d4\u05d5\u05d5\u05d9\u05dd \u05d0\u05d1\u05d7\u05e0\u05d4 \u05de\u05d1\u05d3\u05dc\u05ea (Differential diagnosis) \u05d4\u05db\u05e8\u05d7\u05d9\u05ea \u05dc\u05d0\u05e7\u05ea\u05d9\u05d6\u05d9\u05d4 \u05d7\u05e8\u05d9\u05e4\u05d4?",
      "answerOptions": [
        {
          "text": "\u05d4\u05d0\u05d8\u05d4 \u05e4\u05e1\u05d9\u05db\u05d5\u05de\u05d5\u05d8\u05d5\u05e8\u05d9\u05ea (Psychomotor retardation) \u05d1\u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05de\u05d2'\u05d5\u05e8\u05d9.",
          "isCorrect": false,
          "rationale": "\u05d4\u05d0\u05d8\u05d4 \u05e4\u05e1\u05d9\u05db\u05d5\u05de\u05d5\u05d8\u05d5\u05e8\u05d9\u05ea \u05d4\u05d9\u05d0 \u05de\u05e6\u05d1 \u05e9\u05dc *\u05d7\u05d5\u05e1\u05e8* \u05ea\u05e0\u05d5\u05e2\u05d4, \u05d4\u05e4\u05d5\u05da \u05de\u05d4\u05d4\u05d9\u05e4\u05e8\u05e7\u05d9\u05e0\u05d6\u05d9\u05d4 \u05d5\u05d4\u05d0\u05d9-\u05e9\u05e7\u05d8 \u05e9\u05dc \u05d0\u05e7\u05ea\u05d9\u05d6\u05d9\u05d4 (DSM p.810)."
        },
        {
          "text": "\u05ea\u05e1\u05de\u05d9\u05e0\u05d9 \u05d2\u05de\u05d9\u05dc\u05d4 \u05de\u05d7\u05d5\u05de\u05e8\u05d9\u05dd (Substance withdrawal), \u05dc\u05de\u05e9\u05dc \u05de\u05d0\u05d5\u05e4\u05d9\u05d5\u05d0\u05d9\u05d3\u05d9\u05dd.",
          "isCorrect": true,
          "rationale": "\u05d2\u05de\u05d9\u05dc\u05d4 \u05de\u05d7\u05d5\u05de\u05e8\u05d9\u05dd \u05d9\u05db\u05d5\u05dc\u05d4 \u05dc\u05d4\u05e6\u05d9\u05d2 \u05d0\u05d2\u05d9\u05d8\u05e6\u05d9\u05d4 \u05d5\u05d0\u05d9-\u05e9\u05e7\u05d8 \u05de\u05d5\u05d8\u05d5\u05e8\u05d9 \u05e9\u05e7\u05e9\u05d4 \u05dc\u05d4\u05d1\u05d7\u05d9\u05df \u05d1\u05d9\u05e0\u05dd \u05dc\u05d1\u05d9\u05df \u05d0\u05e7\u05ea\u05d9\u05d6\u05d9\u05d4 \u05dc\u05dc\u05d0 \u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4 \u05e8\u05e4\u05d5\u05d0\u05d9\u05ea (DSM p.814)."
        },
        {
          "text": "\u05d4\u05d9\u05e4\u05e8\u05d0\u05e7\u05d8\u05d9\u05d1\u05d9\u05d5\u05ea \u05d1\u05d4\u05e4\u05e8\u05e2\u05ea \u05e7\u05e9\u05d1 \u05d5\u05e8\u05d9\u05db\u05d5\u05d6 (ADHD).",
          "isCorrect": true,
          "rationale": "\u05d7\u05d5\u05e1\u05e8 \u05d4\u05e9\u05e7\u05d8 \u05e9\u05dc ADHD \u05e2\u05e9\u05d5\u05d9 \u05dc\u05d4\u05d9\u05d3\u05de\u05d5\u05ea \u05dc\u05d0\u05e7\u05ea\u05d9\u05d6\u05d9\u05d4, \u05d0\u05da \u05d4\u05d5\u05d0 \u05d1\u05d3\u05e8\u05da \u05db\u05dc\u05dc \u05db\u05e8\u05d5\u05e0\u05d9 \u05d5\u05d0\u05d9\u05e0\u05d5 \u05de\u05dc\u05d5\u05d5\u05d4 \u05d1\u05d3\u05d9\u05e1\u05e4\u05d5\u05e8\u05d9\u05d4 \u05d4\u05d7\u05d3\u05e9\u05d4 \u05d5\u05d4\u05e1\u05d5\u05d1\u05d9\u05d9\u05e7\u05d8\u05d9\u05d1\u05d9\u05ea \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05ea \u05d0\u05e7\u05ea\u05d9\u05d6\u05d9\u05d4 (DSM p.813)."
        },
        {
          "text": "Restless Legs Syndrome (RLS) \u05e2\u05dc \u05e8\u05e7\u05e2 \u05d0\u05e0\u05de\u05d9\u05d4 \u05de\u05d7\u05d5\u05e1\u05e8 \u05d1\u05e8\u05d6\u05dc.",
          "isCorrect": true,
          "rationale": "RLS \u05d3\u05d5\u05de\u05d4 \u05e4\u05e0\u05d5\u05de\u05e0\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea \u05dc\u05d0\u05e7\u05ea\u05d9\u05d6\u05d9\u05d4 (\u05d3\u05d7\u05e3 \u05dc\u05d4\u05e0\u05d9\u05e2 \u05e8\u05d2\u05dc\u05d9\u05d9\u05dd), \u05d0\u05da \u05dc\u05e8\u05d5\u05d1 \u05de\u05d5\u05e4\u05d9\u05e2 \u05d1\u05e2\u05e8\u05d1/\u05dc\u05d9\u05dc\u05d4 \u05d5\u05e7\u05e9\u05d5\u05e8 \u05dc\u05de\u05d3\u05d3\u05d9\u05dd \u05de\u05d8\u05d1\u05d5\u05dc\u05d9\u05d9\u05dd (DSM p.814)."
        }
      ],
