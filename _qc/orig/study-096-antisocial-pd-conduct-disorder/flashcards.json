{
  "title": "Psychiatry Flashcards",
  "cards": [
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05d2\u05d9\u05dc \u05d4\u05de\u05d9\u05e0\u05d9\u05de\u05dc\u05d9 \u05d4\u05e0\u05d3\u05e8\u05e9 \u05dc\u05d0\u05d1\u05d7\u05e0\u05d4 \u05e8\u05e9\u05de\u05d9\u05ea \u05e9\u05dc ASPD \u05dc\u05e4\u05d9 DSM-5-TR?",
      "back": "\u05d2\u05d9\u05dc 18 \u05e9\u05e0\u05d9\u05dd \u05dc\u05e4\u05d7\u05d5\u05ea (DSM p.749)."
    },
    {
      "front": "\u05db\u05d3\u05d9 \u05dc\u05d0\u05d1\u05d7\u05df ASPD, \u05de\u05d4\u05d5 \u05d4\u05ea\u05e0\u05d0\u05d9 \u05d4\u05d4\u05db\u05e8\u05d7\u05d9 \u05dc\u05d2\u05d1\u05d9 \u05d4\u05e2\u05d1\u05e8 \u05d4\u05e8\u05e4\u05d5\u05d0\u05d9 \u05e9\u05dc \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05dc\u05e4\u05e0\u05d9 \u05d2\u05d9\u05dc 15?",
      "back": "\u05e7\u05d9\u05d5\u05dd \u05e2\u05d3\u05d5\u05ea \u05dc-Conduct Disorder (CD) \u05e9\u05d4\u05d7\u05dc \u05dc\u05e4\u05e0\u05d9 \u05d2\u05d9\u05dc 15 \u05e9\u05e0\u05d9\u05dd (DSM p.749)."
    },
    {
      "front": "\u05dc\u05e4\u05d9 \u05d4-DSM-5-TR, \u05db\u05de\u05d4 \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e9\u05dc CD \u05e0\u05d3\u05e8\u05e9\u05d9\u05dd \u05dc\u05d4\u05d5\u05e4\u05e2\u05d4 \u05d1-12 \u05d4\u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05d4\u05d0\u05d7\u05e8\u05d5\u05e0\u05d9\u05dd \u05dc\u05e6\u05d5\u05e8\u05da \u05d0\u05d1\u05d7\u05e0\u05d4?",
      "back": "\u05dc\u05e4\u05d7\u05d5\u05ea 3 \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05de\u05ea\u05d5\u05da \u05e8\u05e9\u05d9\u05de\u05ea \u05d4-15 (DSM p.531)."
    },
    {
      "front": "\u05de\u05d4\u05dd \u05d0\u05e8\u05d1\u05e2\u05ea \u05d0\u05e9\u05db\u05d5\u05dc\u05d5\u05ea \u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d4\u05de\u05e8\u05db\u05d9\u05d1\u05d9\u05dd \u05d0\u05ea \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df A \u05d1\u05d0\u05d1\u05d7\u05e0\u05ea Conduct Disorder (CD)?",
      "back": "\u05ea\u05d5\u05e7\u05e4\u05e0\u05d5\u05ea \u05db\u05dc\u05e4\u05d9 \u05d0\u05e0\u05e9\u05d9\u05dd \u05d5\u05d1\u05e2\u05dc\u05d9 \u05d7\u05d9\u05d9\u05dd, \u05d4\u05e8\u05e1 \u05e8\u05db\u05d5\u05e9, \u05de\u05e8\u05de\u05d4 \u05d0\u05d5 \u05d2\u05e0\u05d9\u05d1\u05d4, \u05d5\u05d4\u05e4\u05e8\u05d5\u05ea \u05d7\u05de\u05d5\u05e8\u05d5\u05ea \u05e9\u05dc \u05db\u05dc\u05dc\u05d9\u05dd (DSM p.531)."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05de\u05d5\u05d2\u05d3\u05e8 \u05d4-Subtype \u05e9\u05dc CD \u05de\u05e1\u05d5\u05d2 Childhood-onset type?",
      "back": "\u05d4\u05d5\u05e4\u05e2\u05d4 \u05e9\u05dc \u05dc\u05e4\u05d7\u05d5\u05ea \u05ea\u05e1\u05de\u05d9\u05df \u05d0\u05d7\u05d3 \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05df CD \u05dc\u05e4\u05e0\u05d9 \u05d2\u05d9\u05dc 10 \u05e9\u05e0\u05d9\u05dd (DSM p.532)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05de\u05e9\u05da \u05d4\u05d6\u05de\u05df \u05d4\u05de\u05d9\u05e0\u05d9\u05de\u05dc\u05d9 \u05d4\u05e0\u05d3\u05e8\u05e9 \u05dc\u05e6\u05d5\u05e8\u05da \u05d4\u05d2\u05d3\u05e8\u05ea \u05d4-Specifier \u05e9\u05dc With limited prosocial emotions \u05d1-CD?",
      "back": "\u05dc\u05e4\u05d7\u05d5\u05ea 12 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05e9\u05dc \u05d3\u05e4\u05d5\u05e1 \u05e7\u05d1\u05d5\u05e2 \u05d1\u05de\u05e1\u05e4\u05e8 \u05de\u05e2\u05e8\u05db\u05d5\u05ea \u05d9\u05d7\u05e1\u05d9\u05dd \u05d5\u05d4\u05e7\u05e9\u05e8\u05d9\u05dd (DSM p.532)."
    },
    {
      "front": "\u05de\u05d4\u05dd \u05d0\u05e8\u05d1\u05e2\u05ea \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9\u05dd \u05d4\u05e0\u05d1\u05d7\u05e0\u05d9\u05dd \u05ea\u05d7\u05ea \u05d4-Specifier \u05e9\u05dc With limited prosocial emotions \u05d1-CD?",
      "back": "\u05d7\u05d5\u05e1\u05e8 \u05d7\u05e8\u05d8\u05d4 \u05d0\u05d5 \u05d0\u05e9\u05de\u05d4, \u05d0\u05d3\u05d9\u05e9\u05d5\u05ea/\u05d7\u05d5\u05e1\u05e8 \u05d0\u05de\u05e4\u05ea\u05d9\u05d4 (Callous), \u05d7\u05d5\u05e1\u05e8 \u05d3\u05d0\u05d2\u05d4 \u05dc\u05d2\u05d1\u05d9 \u05d1\u05d9\u05e6\u05d5\u05e2\u05d9\u05dd (Performance), \u05d5\u05d0\u05e4\u05e7\u05d8 \u05e9\u05d8\u05d5\u05d7 \u05d0\u05d5 \u05e8\u05d3\u05d5\u05d3 (DSM p.532)."
    },
    {
      "front": "\u05d1\u05d0\u05d9\u05dc\u05d5 \u05de\u05e7\u05e8\u05d9\u05dd \u05d9\u05d0\u05d5\u05d1\u05d7\u05e0\u05d5 \u05d2\u05dd ODD \u05d5\u05d2\u05dd CD \u05d1\u05de\u05e7\u05d1\u05d9\u05dc \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR?",
      "back": "\u05db\u05d0\u05e9\u05e8 \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05e2\u05d5\u05e0\u05d4 \u05e2\u05dc \u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05d4\u05de\u05dc\u05d0\u05d9\u05dd \u05e9\u05dc \u05e9\u05ea\u05d9 \u05d4\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea (DSM p.536)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4-Prevalence \u05e9\u05dc ASPD \u05d1\u05e7\u05e8\u05d1 \u05d2\u05d1\u05e8\u05d9\u05dd \u05d1\u05de\u05e1\u05d2\u05e8\u05d5\u05ea \u05e4\u05d5\u05e8\u05e0\u05d6\u05d9\u05d5\u05ea \u05d0\u05d5 \u05d1\u05d1\u05ea\u05d9 \u05db\u05dc\u05d0?",
      "back": "\u05de\u05e2\u05dc $70\\%$ (DSM p.751)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05d9\u05d7\u05e1 \u05d1\u05d9\u05df \u05d1\u05e0\u05d9\u05dd \u05dc\u05d1\u05e0\u05d5\u05ea (Male:Female ratio) \u05d1\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05e9\u05dc CD \u05dc\u05e4\u05d9 Dulcan?",
      "back": "\u05d4\u05d4\u05e4\u05e8\u05e2\u05d4 \u05e9\u05db\u05d9\u05d7\u05d4 \u05e4\u05d9 3 \u05e2\u05d3 4 \u05d1\u05e7\u05e8\u05d1 \u05d1\u05e0\u05d9\u05dd \u05dc\u05e2\u05d5\u05de\u05ea \u05d1\u05e0\u05d5\u05ea (Dulcan p.207)."
    },
    {
      "front": "\u05d0\u05d9\u05d6\u05d4 \u05de\u05de\u05e6\u05d0 \u05e4\u05e1\u05d9\u05db\u05d5\u05e4\u05d9\u05d6\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05e0\u05d7\u05e9\u05d1 \u05dc\u05de\u05e8\u05e7\u05e8 \u05d0\u05de\u05d9\u05df \u05d1\u05e7\u05e8\u05d1 \u05d0\u05e0\u05e9\u05d9\u05dd \u05e2\u05dd CD \u05d1\u05d4\u05e9\u05d5\u05d5\u05d0\u05d4 \u05dc\u05e7\u05d1\u05d5\u05e6\u05ea \u05d1\u05d9\u05e7\u05d5\u05e8\u05ea?",
      "back": "\u05e7\u05e6\u05d1 \u05dc\u05d1 \u05e0\u05de\u05d5\u05da \u05d9\u05d5\u05ea\u05e8 \u05d1\u05de\u05e0\u05d5\u05d7\u05d4 (Slower resting heart rate) (DSM p.535)."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05de\u05e9\u05e4\u05d9\u05e2\u05d4 \u05d5\u05e8\u05d9\u05d0\u05e6\u05d9\u05d4 \u05d1\u05d2\u05df MAOA \u05e2\u05dc \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05e4\u05ea\u05d7 CD \u05d1\u05e7\u05e8\u05d1 \u05d1\u05e0\u05d9\u05dd \u05e9\u05e2\u05d1\u05e8\u05d5 \u05d4\u05ea\u05e2\u05dc\u05dc\u05d5\u05ea?",
      "back": "\u05d1\u05e0\u05d9\u05dd \u05e2\u05dd \u05e4\u05e2\u05d9\u05dc\u05d5\u05ea MAOA \u05e0\u05de\u05d5\u05db\u05d4 \u05e0\u05de\u05e6\u05d0\u05d9\u05dd \u05d1\u05e1\u05d9\u05db\u05d5\u05df \u05db\u05e4\u05d5\u05dc \u05dc\u05e4\u05ea\u05d7 CD \u05dc\u05e2\u05d5\u05de\u05ea \u05d0\u05dc\u05d5 \u05e2\u05dd \u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05ea\u05e7\u05d9\u05e0\u05d4 (Dulcan p.210)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05de\u05d1\u05d3\u05dc\u05ea \u05d4\u05de\u05e8\u05db\u05d6\u05d9\u05ea \u05d1\u05d9\u05df CD \u05dc\u05d1\u05d9\u05df ADHD \u05de\u05d1\u05d7\u05d9\u05e0\u05ea \u05d0\u05d5\u05e4\u05d9 \u05d4\u05ea\u05d5\u05e7\u05e4\u05e0\u05d5\u05ea?",
      "back": "\u05d1-ADHD \u05d4\u05ea\u05d5\u05e7\u05e4\u05e0\u05d5\u05ea \u05d4\u05d9\u05d0 \u05dc\u05e8\u05d5\u05d1 \u05d0\u05d9\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05ea, \u05d1\u05e2\u05d5\u05d3 \u05e9\u05d1-CD \u05d4\u05d9\u05d0 \u05e4\u05e8\u05d5\u05d0\u05e7\u05d8\u05d9\u05d1\u05d9\u05ea \u05d5\u05d8\u05d5\u05e8\u05e4\u05e0\u05d9\u05ea (DSM p.536)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df \u05d4\u05db\u05de\u05d5\u05ea\u05d9 \u05dc\u05d4\u05d2\u05d3\u05e8\u05ea \u05d7\u05d5\u05de\u05e8\u05ea CD \u05db-Severe?",
      "back": "\u05e7\u05d9\u05d5\u05dd \u05e9\u05dc \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e8\u05d1\u05d9\u05dd \u05de\u05e2\u05d1\u05e8 \u05dc\u05e0\u05d3\u05e8\u05e9 \u05dc\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d0\u05d5 \u05d2\u05e8\u05d9\u05de\u05ea \u05e0\u05d6\u05e7 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9 \u05dc\u05d0\u05d7\u05e8\u05d9\u05dd (DSM p.533)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05de\u05e9\u05da \u05d4\u05d6\u05de\u05df \u05d4\u05de\u05d9\u05e0\u05d9\u05de\u05dc\u05d9 \u05d4\u05e0\u05d3\u05e8\u05e9 \u05dc\u05d4\u05d5\u05e4\u05e2\u05ea \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05dc\u05e6\u05d5\u05e8\u05da \u05d0\u05d1\u05d7\u05e0\u05ea ODD?",
      "back": "\u05dc\u05e4\u05d7\u05d5\u05ea 6 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd (DSM p.522)."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05de\u05d5\u05d2\u05d3\u05e8\u05ea \u05ea\u05d3\u05d9\u05e8\u05d5\u05ea \u05ea\u05e1\u05de\u05d9\u05e0\u05d9 ODD \u05dc\u05e6\u05d5\u05e8\u05da \u05d0\u05d1\u05d7\u05e0\u05d4 \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05de\u05ea\u05d7\u05ea \u05dc\u05d2\u05d9\u05dc 5?",
      "back": "\u05d4\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05e6\u05e8\u05d9\u05db\u05d4 \u05dc\u05d4\u05d5\u05e4\u05d9\u05e2 \u05d1\u05e8\u05d5\u05d1 \u05d4\u05d9\u05de\u05d9\u05dd (most days) \u05d1\u05de\u05e9\u05da 6 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05dc\u05e4\u05d7\u05d5\u05ea (DSM p.523)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05e7\u05e9\u05e8 \u05d4\u05e1\u05d8\u05d8\u05d9\u05e1\u05d8\u05d9 \u05d1\u05d9\u05df ODD \u05dc\u05d1\u05d9\u05df \u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05d0\u05d5\u05d1\u05d3\u05e0\u05d5\u05ea?",
      "back": "ODD \u05e7\u05e9\u05d5\u05e8 \u05dc\u05e1\u05d9\u05db\u05d5\u05df \u05de\u05d5\u05d2\u05d1\u05e8 \u05dc\u05e0\u05d9\u05e1\u05d9\u05d5\u05e0\u05d5\u05ea \u05d0\u05d5\u05d1\u05d3\u05e0\u05d9\u05d9\u05dd, \u05d2\u05dd \u05dc\u05d0\u05d7\u05e8 \u05e9\u05dc\u05d9\u05d8\u05d4 \u05e2\u05dc \u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05e0\u05dc\u05d5\u05d5\u05ea (DSM p.523)."
    },
    {
      "front": "\u05d0\u05d9\u05d6\u05d4 \u05e1\u05d5\u05d2 \u05e9\u05dc \u05ea\u05d5\u05e7\u05e4\u05e0\u05d5\u05ea \u05e0\u05e4\u05d5\u05e5 \u05d9\u05d5\u05ea\u05e8 \u05d1\u05e7\u05e8\u05d1 \u05d1\u05e0\u05d5\u05ea \u05e2\u05dd CD \u05dc\u05e2\u05d5\u05de\u05ea \u05d1\u05e0\u05d9\u05dd?",
      "back": "\u05ea\u05d5\u05e7\u05e4\u05e0\u05d5\u05ea \u05d9\u05d7\u05e1\u05d9\u05ea (Relational aggression) \u05d5\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05d9\u05d5\u05ea \u05dc\u05d0 \u05e4\u05d9\u05d6\u05d9\u05d5\u05ea \u05db\u05de\u05d5 \u05e9\u05e7\u05e8\u05d9\u05dd \u05d0\u05d5 \u05d6\u05e0\u05d5\u05ea (DSM p.535)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d0\u05d1\u05d7\u05e0\u05ea \u05d4-DMDD \u05d1\u05d9\u05d7\u05e1 \u05dc-ODD \u05d1\u05de\u05e7\u05e8\u05d9\u05dd \u05e9\u05dc \u05d7\u05e4\u05d9\u05e4\u05d4 \u05de\u05dc\u05d0\u05d4 \u05d1\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd?",
      "back": "\u05d0\u05dd \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05e2\u05d5\u05e0\u05d4 \u05dc\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05e9\u05dc \u05e9\u05ea\u05d9 \u05d4\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea, \u05ea\u05d9\u05e0\u05ea\u05df \u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc DMDD \u05d1\u05dc\u05d1\u05d3 (DSM p.523)."
    },
    {
      "front": "\u05de\u05d4 \u05de\u05d1\u05d3\u05d9\u05dc \u05d1\u05d9\u05df ASPD \u05dc\u05d1\u05d9\u05df Narcissistic Personality Disorder?",
      "back": "\u05d4\u05e4\u05e8\u05e2\u05ea \u05d0\u05d9\u05e9\u05d9\u05d5\u05ea \u05e0\u05e8\u05e7\u05d9\u05e1\u05d9\u05e1\u05d8\u05d9\u05ea \u05dc\u05e8\u05d5\u05d1 \u05d0\u05d9\u05e0\u05d4 \u05db\u05d5\u05dc\u05dc\u05ea \u05d0\u05d9\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05d5\u05ea, \u05ea\u05d5\u05e7\u05e4\u05e0\u05d5\u05ea \u05d2\u05dc\u05d5\u05d9\u05d4 \u05d0\u05d5 \u05e2\u05d1\u05e8 \u05e9\u05dc CD (DSM p.752)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05ea\u05e8\u05d5\u05e4\u05ea\u05d9 \u05d4\u05de\u05e7\u05d5\u05d1\u05dc \u05dc\u05d4\u05e4\u05d7\u05ea\u05ea \u05ea\u05d5\u05e7\u05e4\u05e0\u05d5\u05ea \u05d7\u05de\u05d5\u05e8\u05d4 (Aggression) \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d5\u05e0\u05d5\u05e2\u05e8 \u05e2\u05dd CD?",
      "back": "\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05d0\u05e0\u05d8\u05d9-\u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9\u05d5\u05ea, \u05d5\u05d1\u05e8\u05d0\u05e9\u05df Risperidone (StahlKids p.301, \u05de\u05e7\u05d5\u05e8: \u05d4\u05e7\u05e9\u05e8 \u05e8\u05d7\u05d1)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05e4\u05e1\u05d9\u05db\u05d5\u05e1\u05d5\u05e6\u05d9\u05d0\u05dc\u05d9 \u05d4\u05de\u05e2\u05e8\u05db\u05ea\u05d9 \u05d4\u05de\u05d5\u05de\u05dc\u05e5 \u05dc-CD \u05dc\u05e4\u05d9 Dulcan?",
      "back": "Multisystemic Therapy (MST) \u05d4\u05de\u05ea\u05de\u05e7\u05d3\u05ea \u05d1\u05de\u05d2\u05d5\u05d5\u05df \u05d2\u05d5\u05e8\u05de\u05d9\u05dd \u05e1\u05d1\u05d9\u05d1\u05ea\u05d9\u05d9\u05dd (\u05de\u05e9\u05e4\u05d7\u05d4, \u05d1\u05d9\u05ea \u05e1\u05e4\u05e8, \u05d7\u05d1\u05e8\u05d9\u05dd) (Dulcan p.211)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4-Subtype \u05e9\u05dc CD \u05d4\u05de\u05e7\u05d5\u05e9\u05e8 \u05dc\u05e4\u05e8\u05d5\u05d2\u05e0\u05d5\u05d6\u05d4 \u05d2\u05e8\u05d5\u05e2\u05d4 \u05d9\u05d5\u05ea\u05e8 \u05d5\u05e1\u05d9\u05db\u05d5\u05df \u05de\u05d5\u05d2\u05d1\u05e8 \u05dc\u05e4\u05e9\u05d9\u05e2\u05d4 \u05d1\u05d1\u05d2\u05e8\u05d5\u05ea?",
      "back": "Childhood-onset type (DSM p.534)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05de\u05d1\u05d3\u05dc\u05ea \u05d1\u05d9\u05df ASPD \u05dc\u05d1\u05d9\u05df \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05e4\u05dc\u05d9\u05dc\u05d9\u05ea (Criminal behavior) \u05dc\u05dc\u05d0 \u05d4\u05e4\u05e8\u05e2\u05d4 \u05e0\u05e4\u05e9\u05d9\u05ea?",
      "back": "\u05d1-ASPD \u05e7\u05d9\u05d9\u05de\u05d9\u05dd \u05e7\u05d5\u05d5\u05d9 \u05d0\u05d9\u05e9\u05d9\u05d5\u05ea \u05e0\u05d5\u05e7\u05e9\u05d9\u05dd \u05d5\u05de\u05dc-\u05d0\u05d3\u05e4\u05d8\u05d9\u05d1\u05d9\u05d9\u05dd \u05de\u05e2\u05d1\u05e8 \u05dc\u05e8\u05d5\u05d5\u05d7 \u05d4\u05de\u05d9\u05d9\u05d3\u05d9 \u05de\u05d4\u05e4\u05e9\u05e2 (Synopsis ch.19 Personality Disorders)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05e8\u05de\u05ea \u05d4\u05d9\u05e8\u05d5\u05e9\u05d4 (Heritability) \u05d4\u05de\u05e9\u05d5\u05e2\u05e8\u05ea \u05e2\u05d1\u05d5\u05e8 \u05ea\u05d5\u05e7\u05e4\u05e0\u05d5\u05ea \u05d5\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d0\u05e0\u05d8\u05d9-\u05e1\u05d5\u05e6\u05d9\u05d0\u05dc\u05d9\u05ea \u05dc\u05e4\u05d9 Dulcan?",
      "back": "\u05e7\u05d9\u05d9\u05de\u05ea \u05e8\u05de\u05d4 \u05de\u05ea\u05d5\u05e0\u05d4 (Moderate degree) \u05e9\u05dc \u05ea\u05d5\u05e8\u05e9\u05ea\u05d9\u05d5\u05ea \u05de\u05d9\u05dc\u05d3\u05d5\u05ea \u05dc\u05d1\u05d2\u05e8\u05d5\u05ea (Dulcan p.209)."
    },
    {
      "front": "\u05d0\u05d9\u05d6\u05d4 \u05db\u05dc\u05d9 \u05d4\u05e2\u05e8\u05db\u05d4 \u05de\u05e9\u05de\u05e9 \u05dc\u05de\u05d3\u05d9\u05d3\u05ea \u05ea\u05db\u05d5\u05e0\u05d5\u05ea Callous-Unemotional \u05d1\u05e7\u05e8\u05d1 \u05d9\u05dc\u05d3\u05d9\u05dd \u05d5\u05e0\u05d5\u05e2\u05e8?",
      "back": "\u05d4\u05e9\u05d0\u05dc\u05d5\u05df Inventory of Callous-Unemotional Traits (Dulcan p.214)."
    },
    {
      "front": "\u05de\u05d4 \u05e7\u05d5\u05e8\u05d4 \u05dc\u05e8\u05d5\u05d1 \u05dc\u05ea\u05e1\u05de\u05d9\u05e0\u05d9 ASPD \u05db\u05d0\u05e9\u05e8 \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05de\u05d2\u05d9\u05e2 \u05dc\u05e2\u05e9\u05d5\u05e8 \u05d4\u05e8\u05d1\u05d9\u05e2\u05d9 \u05dc\u05d7\u05d9\u05d9\u05d5 (\u05d2\u05d9\u05dc 40)?",
      "back": "\u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e0\u05d5\u05d8\u05d9\u05dd \u05dc\u05d4\u05e4\u05d5\u05da \u05dc\u05e4\u05d7\u05d5\u05ea \u05d1\u05d5\u05dc\u05d8\u05d9\u05dd \u05d0\u05d5 \u05dc\u05d4\u05d9\u05db\u05e0\u05e1 \u05dc-Remission, \u05d1\u05de\u05d9\u05d5\u05d7\u05d3 \u05dc\u05d2\u05d1\u05d9 \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05e4\u05dc\u05d9\u05dc\u05d9\u05ea (DSM p.751)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05e9\u05db\u05d9\u05d7\u05d5\u05ea (Prevalence) \u05d4\u05de\u05e9\u05d5\u05e2\u05e8\u05ea \u05e9\u05dc ASPD \u05d1\u05d0\u05d5\u05db\u05dc\u05d5\u05e1\u05d9\u05d9\u05d4 \u05d4\u05db\u05dc\u05dc\u05d9\u05ea \u05d1\u05e7\u05e8\u05d1 \u05d2\u05d1\u05e8\u05d9\u05dd \u05dc\u05e2\u05d5\u05de\u05ea \u05e0\u05e9\u05d9\u05dd \u05dc\u05e4\u05d9 Synopsis?",
      "back": "\u05d1\u05e2\u05e8\u05da $3\\%$ \u05d1\u05e7\u05e8\u05d1 \u05d2\u05d1\u05e8\u05d9\u05dd \u05d5-$1\\%$ \u05d1\u05e7\u05e8\u05d1 \u05e0\u05e9\u05d9\u05dd (Synopsis ch.19 Personality Disorders)."
    },
    {
      "front": "\u05d0\u05d9\u05d6\u05d5 \u05d4\u05e9\u05e4\u05e2\u05d4 \u05e1\u05d1\u05d9\u05d1\u05ea\u05d9\u05ea \u05d1\u05de\u05e9\u05e4\u05d7\u05d4 \u05de\u05e7\u05d5\u05e9\u05e8\u05ea \u05dc\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea CD \u05dc\u05e4\u05d9 Dulcan?",
      "back": "\u05de\u05e9\u05de\u05e2\u05ea \u05e0\u05d5\u05e7\u05e9\u05d4 (Harsh discipline), \u05d4\u05ea\u05e2\u05dc\u05dc\u05d5\u05ea \u05e4\u05d9\u05d6\u05d9\u05ea \u05d0\u05d5 \u05de\u05d9\u05e0\u05d9\u05ea, \u05d5\u05d4\u05d6\u05e0\u05d7\u05d4 \u05d4\u05d5\u05e8\u05d9\u05ea (Dulcan p.211)."
    },
    {
      "front": "\u05de\u05d3\u05d5\u05e2 \u05d0\u05d9\u05df \u05dc\u05d0\u05d1\u05d7\u05df ASPD \u05db\u05d0\u05e9\u05e8 \u05d4\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d4\u05d0\u05e0\u05d8\u05d9-\u05e1\u05d5\u05e6\u05d9\u05d0\u05dc\u05d9\u05ea \u05de\u05d5\u05e4\u05d9\u05e2\u05d4 \u05d1\u05d0\u05d5\u05e4\u05df \u05d1\u05dc\u05e2\u05d3\u05d9 \u05d1\u05de\u05d4\u05dc\u05da Schizophrenia?",
      "back": "\u05db\u05d9 \u05d4\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05e2\u05e9\u05d5\u05d9\u05d4 \u05dc\u05d4\u05d9\u05d5\u05ea \u05ea\u05d5\u05e6\u05d0\u05d4 \u05e9\u05dc \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9\u05d9\u05dd \u05d5\u05dc\u05d0 \u05d3\u05e4\u05d5\u05e1 \u05d0\u05d9\u05e9\u05d9\u05d5\u05ea\u05d9 \u05e7\u05d1\u05d5\u05e2 (DSM p.749)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05e9\u05dc \u05d4-Subtype \u05de\u05e1\u05d5\u05d2 Adolescent-onset \u05d1-CD?",
      "back": "\u05d4\u05d9\u05e2\u05d3\u05e8 \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e9\u05dc CD \u05dc\u05e4\u05e0\u05d9 \u05d2\u05d9\u05dc 10 \u05e9\u05e0\u05d9\u05dd (DSM p.532)."
    },
    {
      "front": "\u05dc\u05e4\u05d9 StahlNeuro, \u05d0\u05d9\u05d6\u05d4 \u05e0\u05d5\u05d9\u05e8\u05d5\u05d8\u05e8\u05e0\u05e1\u05de\u05d9\u05d8\u05d5\u05e8 \u05de\u05e7\u05d5\u05e9\u05e8 \u05dc\u05ea\u05d5\u05e7\u05e4\u05e0\u05d5\u05ea \u05d0\u05d9\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05ea (Impulsive aggression)?",
      "back": "\u05e1\u05e8\u05d5\u05d8\u05d5\u05e0\u05d9\u05df ($5-HT$), \u05db\u05d0\u05e9\u05e8 \u05e8\u05de\u05d5\u05ea \u05e0\u05de\u05d5\u05db\u05d5\u05ea \u05de\u05e7\u05d5\u05e9\u05e8\u05d5\u05ea \u05dc\u05d7\u05d5\u05e1\u05e8 \u05e9\u05dc\u05d9\u05d8\u05d4 \u05d1\u05d3\u05d7\u05e4\u05d9\u05dd (Dulcan p.211, StahlNeuro p.147 (\u05de\u05e7\u05d5\u05e8: \u05d4\u05e7\u05e9\u05e8 \u05e8\u05d7\u05d1))."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05e7\u05e9\u05e8 \u05d1\u05d9\u05df \u05d7\u05e9\u05d9\u05e4\u05d4 \u05dc\u05e2\u05d5\u05e4\u05e8\u05ea (Lead) \u05dc\u05d1\u05d9\u05df \u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea CD?",
      "back": "\u05d7\u05e9\u05d9\u05e4\u05d4 \u05de\u05d5\u05e7\u05d3\u05de\u05ea \u05dc\u05e8\u05e2\u05dc\u05e0\u05d9\u05dd \u05db\u05de\u05d5 \u05e2\u05d5\u05e4\u05e8\u05ea \u05e7\u05e9\u05d5\u05e8\u05d4 \u05dc\u05e2\u05dc\u05d9\u05d9\u05d4 \u05d1\u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05ea\u05d5\u05e7\u05e4\u05e0\u05d9\u05ea (Dulcan p.210)."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05de\u05d5\u05d2\u05d3\u05e8 \u05d4-Specifier \u05e9\u05dc With psychopathic features \u05d1\u05de\u05d5\u05d3\u05dc \u05d4\u05d0\u05dc\u05d8\u05e8\u05e0\u05d8\u05d9\u05d1\u05d9 \u05e9\u05dc DSM-5?",
      "back": "\u05d5\u05e8\u05d9\u05d0\u05e0\u05d8 \u05d4\u05de\u05ea\u05d0\u05e4\u05d9\u05d9\u05df \u05d1\u05d7\u05d5\u05e1\u05e8 \u05d7\u05e8\u05d3\u05d4 \u05d0\u05d5 \u05e4\u05d7\u05d3 \u05d5\u05d1\u05e1\u05d2\u05e0\u05d5\u05df \u05d1\u05d9\u05df-\u05d0\u05d9\u05e9\u05d9 \u05e0\u05d5\u05e2\u05d6 (Bold) \u05d4\u05de\u05de\u05e1\u05da \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05d9\u05d5\u05ea \u05de\u05dc-\u05d0\u05d3\u05e4\u05d8\u05d9\u05d1\u05d9\u05d5\u05ea (DSM p.885)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05d4\u05d1\u05d3\u05dc \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05d1\u05d9\u05df CD \u05dc\u05d1\u05d9\u05df \u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc Delinquency?",
      "back": "CD \u05d4\u05d9\u05d0 \u05d0\u05d1\u05d7\u05e0\u05d4 \u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9\u05ea, \u05d1\u05e2\u05d5\u05d3 \u05e9-Delinquency \u05d4\u05d5\u05d0 \u05de\u05d5\u05e0\u05d7 \u05de\u05e9\u05e4\u05d8\u05d9 (Dulcan p.205)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df \u05d4\u05db\u05de\u05d5\u05ea\u05d9 \u05d4\u05de\u05d9\u05e0\u05d9\u05de\u05dc\u05d9 \u05dc\u05d0\u05d1\u05d7\u05e0\u05ea ODD \u05d1\u05e7\u05e8\u05d1 \u05d9\u05dc\u05d3\u05d9\u05dd \u05d5\u05e0\u05d5\u05e2\u05e8 \u05de\u05e2\u05dc \u05d2\u05d9\u05dc 5?",
      "back": "\u05dc\u05e4\u05d7\u05d5\u05ea 4 \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d4\u05de\u05d5\u05e4\u05d9\u05e2\u05d9\u05dd \u05dc\u05e4\u05d7\u05d5\u05ea \u05e4\u05e2\u05dd \u05d1\u05e9\u05d1\u05d5\u05e2 \u05d1\u05de\u05e9\u05da 6 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd (DSM p.522)."
    },
    {
      "front": "\u05d0\u05d9\u05d6\u05d5 \u05d4\u05e4\u05e8\u05e2\u05d4 \u05e0\u05d7\u05e9\u05d1\u05ea \u05dc-Precursor (\u05de\u05d1\u05e9\u05e8) \u05d4\u05e0\u05e4\u05d5\u05e5 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05e9\u05dc CD \u05de\u05e1\u05d5\u05d2 Childhood-onset?",
      "back": "Oppositional Defiant Disorder (ODD) (DSM p.534)."
    },
    {
      "front": "\u05de\u05d4 \u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05d0\u05ea \u05e7\u05e9\u05e8 \u05d4-Comorbidity \u05d1\u05d9\u05df CD \u05dc\u05d1\u05d9\u05df ADHD?",
      "back": "\u05d4\u05e7\u05d5\u05de\u05d5\u05e8\u05d1\u05d9\u05d3\u05d9\u05d5\u05ea \u05e0\u05e4\u05d5\u05e6\u05d4 \u05d5\u05de\u05e0\u05d1\u05d0\u05ea \u05e4\u05e8\u05d5\u05d2\u05e0\u05d5\u05d6\u05d4 \u05d2\u05e8\u05d5\u05e2\u05d4 \u05d9\u05d5\u05ea\u05e8 \u05d5\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d7\u05de\u05d5\u05e8\u05d9\u05dd \u05d9\u05d5\u05ea\u05e8 (DSM p.537)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05d4\u05de\u05d1\u05d3\u05d9\u05dc \u05d1\u05d9\u05df ASPD \u05dc\u05d1\u05d9\u05df Borderline Personality Disorder \u05de\u05d1\u05d7\u05d9\u05e0\u05ea Harm avoidance?",
      "back": "\u05d0\u05e0\u05e9\u05d9\u05dd \u05e2\u05dd ASPD \u05de\u05e4\u05d2\u05d9\u05e0\u05d9\u05dd Harm avoidance \u05e0\u05de\u05d5\u05da, \u05d1\u05e2\u05d5\u05d3 \u05e9\u05d1-Borderline \u05d4\u05d5\u05d0 \u05dc\u05e8\u05d5\u05d1 \u05d2\u05d1\u05d5\u05d4 (Synopsis ch.19 Personality Disorders)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d2\u05d9\u05dc \u05d4\u05d5\u05e4\u05e2\u05ea \u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d4\u05de\u05de\u05d5\u05e6\u05e2 \u05d1-CD?",
      "back": "\u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05de\u05ea\u05d7\u05d9\u05dc\u05d9\u05dd \u05dc\u05e8\u05d5\u05d1 \u05d1\u05d9\u05df \u05d2\u05d9\u05dc \u05d4\u05d9\u05dc\u05d3\u05d5\u05ea \u05d4\u05de\u05d5\u05e7\u05d3\u05de\u05ea \u05dc\u05d0\u05de\u05e6\u05e2 \u05d2\u05d9\u05dc \u05d4\u05d4\u05ea\u05d1\u05d2\u05e8\u05d5\u05ea (DSM p.534)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05e9\u05dc \u05d4-Subtype \u05de\u05e1\u05d5\u05d2 Unspecified onset \u05d1-CD?",
      "back": "\u05db\u05d0\u05e9\u05e8 \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05e2\u05d5\u05e0\u05d4 \u05dc\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05e9\u05dc CD \u05d0\u05da \u05d0\u05d9\u05df \u05de\u05d9\u05d3\u05e2 \u05de\u05e1\u05e4\u05e7 \u05dc\u05e7\u05d1\u05d5\u05e2 \u05d0\u05dd \u05d4\u05d7\u05dc \u05dc\u05e4\u05e0\u05d9 \u05d0\u05d5 \u05d0\u05d7\u05e8\u05d9 \u05d2\u05d9\u05dc 10 (DSM p.532)."
    },
    {
      "front": "\u05d0\u05d9\u05d6\u05d5 \u05de\u05e2\u05e8\u05db\u05ea \u05e0\u05d5\u05d9\u05e8\u05d5-\u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea \u05de\u05e7\u05d5\u05e9\u05e8\u05ea \u05dc\u05ea\u05d5\u05e7\u05e4\u05e0\u05d5\u05ea \u05e4\u05e8\u05d5\u05e1\u05d5\u05e6\u05d9\u05d0\u05dc\u05d9\u05ea (Prosocial aggression) \u05d5\u05d3\u05d5\u05de\u05d9\u05e0\u05e0\u05d8\u05d9\u05d5\u05ea \u05d6\u05db\u05e8\u05d9\u05ea?",
      "back": "\u05de\u05e2\u05e8\u05db\u05ea \u05d4-Testosterone (Dulcan p.211)."
    },
    {
      "front": "\u05de\u05d4\u05dd \u05d4\u05de\u05de\u05e6\u05d0\u05d9\u05dd \u05d4\u05de\u05d1\u05e0\u05d9\u05d9\u05dd \u05d1\u05de\u05d5\u05d7 (Neuroimaging) \u05d4\u05de\u05e7\u05d5\u05e9\u05e8\u05d9\u05dd \u05dc-CD?",
      "back": "\u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd \u05d1\u05e0\u05e4\u05d7 \u05d4\u05d7\u05d5\u05de\u05e8 \u05d4\u05d0\u05e4\u05d5\u05e8 \u05d5\u05d1\u05d7\u05d9\u05d1\u05d5\u05e8\u05d9\u05d5\u05ea \u05d1\u05d9\u05df \u05d4-Prefrontal cortex \u05dc-Amygdala (DSM p.535)."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05de\u05d1\u05d7\u05d9\u05e0\u05d9\u05dd \u05d1\u05d9\u05df ODD \u05dc\u05d1\u05d9\u05df Adjustment Disorder?",
      "back": "Adjustment Disorder \u05de\u05d5\u05d2\u05d3\u05e8\u05ea \u05db\u05ea\u05d2\u05d5\u05d1\u05d4 \u05dc\u05e1\u05d8\u05e8\u05e1\u05d5\u05e8 \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9 \u05d5\u05de\u05d5\u05d2\u05d1\u05dc\u05ea \u05dc-6 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05de\u05e1\u05d9\u05d5\u05dd \u05d4\u05e1\u05d8\u05e8\u05e1\u05d5\u05e8 (DSM p.525)."
    },
    {
      "front": "\u05d1\u05d0\u05d9\u05dc\u05d5 \u05de\u05e7\u05e8\u05d9\u05dd \u05ea\u05d9\u05e0\u05ea\u05df \u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc Intermittent Explosive Disorder (IED) \u05d1\u05e0\u05d5\u05e1\u05e3 \u05dc-CD?",
      "back": "\u05db\u05d0\u05e9\u05e8 \u05d4\u05d4\u05ea\u05e7\u05e4\u05d9\u05dd \u05d4\u05ea\u05d5\u05e7\u05e4\u05e0\u05d9\u05d9\u05dd \u05d4\u05d0\u05d9\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05d9\u05dd \u05d7\u05d5\u05e8\u05d2\u05d9\u05dd \u05de\u05d4\u05de\u05e6\u05d5\u05e4\u05d4 \u05d1-CD \u05d5\u05de\u05e6\u05e8\u05d9\u05db\u05d9\u05dd \u05d4\u05ea\u05d9\u05d9\u05d7\u05e1\u05d5\u05ea \u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05e2\u05e6\u05de\u05d0\u05d9\u05ea (DSM p.527)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05de\u05d5\u05e2\u05d3\u05e3 \u05dc\u05e9\u05d9\u05e4\u05d5\u05e8 \u05ea\u05e4\u05e7\u05d5\u05d3 \u05d4\u05d5\u05e8\u05d9 \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd CD \u05d5-ODD?",
      "back": "Parent Management Training (PMT) (Dulcan p.211, StahlKids p.301 (\u05de\u05e7\u05d5\u05e8: \u05d4\u05e7\u05e9\u05e8 \u05e8\u05d7\u05d1))."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05e9\u05dc \u05d9\u05dc\u05d3 \u05e2\u05dd ODD \u05dc\u05e4\u05ea\u05d7 CD \u05d1\u05d4\u05de\u05e9\u05da \u05d7\u05d9\u05d9\u05d5?",
      "back": "\u05e8\u05d5\u05d1 \u05d4\u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd ODD \u05d0\u05d9\u05e0\u05dd \u05de\u05e4\u05ea\u05d7\u05d9\u05dd CD, \u05d0\u05da ODD \u05de\u05d4\u05d5\u05d5\u05d4 \u05d2\u05d5\u05e8\u05dd \u05e1\u05d9\u05db\u05d5\u05df \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9 \u05dc\u05db\u05da (DSM p.521)."
    },
    {
      "front": "\u05d0\u05d9\u05dc\u05d5 \u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05e8\u05d2\u05e9\u05d9\u05d5\u05ea \u05e0\u05de\u05e6\u05d0\u05d5\u05ea \u05d1\u05e1\u05d9\u05db\u05d5\u05df \u05de\u05d5\u05d2\u05d1\u05e8 \u05dc\u05d4\u05ea\u05e4\u05ea\u05d7 \u05d1\u05e7\u05e8\u05d1 \u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd ODD?",
      "back": "\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05d7\u05e8\u05d3\u05d4 \u05d5\u05d3\u05d9\u05db\u05d0\u05d5\u05df (Major Depressive Disorder) (DSM p.524)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05d4\u05d2\u05d3\u05e8\u05d4 \u05e9\u05dc Callousness (\u05d0\u05d8\u05d9\u05de\u05d5\u05ea \u05e8\u05d2\u05e9\u05d9\u05ea) \u05d1-ASPD \u05dc\u05e4\u05d9 \u05d4\u05de\u05d5\u05d3\u05dc \u05d4\u05d0\u05dc\u05d8\u05e8\u05e0\u05d8\u05d9\u05d1\u05d9?",
      "back": "\u05d7\u05d5\u05e1\u05e8 \u05d3\u05d0\u05d2\u05d4 \u05dc\u05e8\u05d2\u05e9\u05d5\u05ea \u05d0\u05d5 \u05d1\u05e2\u05d9\u05d5\u05ea \u05e9\u05dc \u05d0\u05d7\u05e8\u05d9\u05dd, \u05d4\u05d9\u05e2\u05d3\u05e8 \u05d0\u05e9\u05de\u05d4, \u05d0\u05d2\u05e8\u05e1\u05d9\u05d1\u05d9\u05d5\u05ea \u05d5\u05e1\u05d3\u05d9\u05d6\u05dd (DSM p.884)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df \u05d4\u05db\u05de\u05d5\u05ea\u05d9 \u05dc\u05d0\u05d1\u05d7\u05e0\u05ea ASPD \u05d1\u05de\u05d5\u05d3\u05dc \u05d4\u05d0\u05dc\u05d8\u05e8\u05e0\u05d8\u05d9\u05d1\u05d9 (Section III) \u05de\u05d1\u05d7\u05d9\u05e0\u05ea \u05ea\u05db\u05d5\u05e0\u05d5\u05ea \u05d0\u05d9\u05e9\u05d9\u05d5\u05ea?",
      "back": "\u05e0\u05d3\u05e8\u05e9\u05d5\u05ea \u05dc\u05e4\u05d7\u05d5\u05ea 6 \u05de\u05ea\u05d5\u05da 7 \u05ea\u05db\u05d5\u05e0\u05d5\u05ea \u05e4\u05ea\u05d5\u05dc\u05d5\u05d2\u05d9\u05d5\u05ea \u05d1\u05ea\u05d7\u05d5\u05de\u05d9 \u05d4\u05d0\u05e0\u05d8\u05d2\u05d5\u05e0\u05d9\u05d6\u05dd \u05d5\u05d4\u05d3\u05d9\u05e1-\u05d0\u05d9\u05e0\u05d4\u05d9\u05d1\u05d9\u05e6\u05d9\u05d4 (DSM p.884)."
    },
    {
      "front": "\u05d0\u05d9\u05dc\u05d5 \u05d2\u05d5\u05e8\u05de\u05d9\u05dd \u05e1\u05d5\u05e6\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05d9\u05dd \u05d1\u05e9\u05db\u05d5\u05e0\u05ea \u05d4\u05de\u05d2\u05d5\u05e8\u05d9\u05dd \u05de\u05e7\u05d5\u05e9\u05e8\u05d9\u05dd \u05dc\u05e2\u05dc\u05d9\u05d9\u05d4 \u05d1\u05e1\u05d9\u05db\u05d5\u05df \u05dc-CD?",
      "back": "\u05e2\u05d5\u05e0\u05d9, \u05e6\u05e4\u05d9\u05e4\u05d5\u05ea, \u05d7\u05e9\u05d9\u05e4\u05d4 \u05dc\u05d0\u05dc\u05d9\u05de\u05d5\u05ea \u05e7\u05d4\u05d9\u05dc\u05ea\u05d9\u05ea \u05d5\u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05e9\u05dc \u05db\u05e0\u05d5\u05e4\u05d9\u05d5\u05ea (Dulcan p.211)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05e7\u05e9\u05e8 \u05d1\u05d9\u05df \u05e2\u05d9\u05e9\u05d5\u05df \u05d0\u05d9\u05de\u05d4\u05d9 \u05d1\u05d6\u05de\u05df \u05d4\u05d4\u05d9\u05e8\u05d9\u05d5\u05df \u05dc\u05d1\u05d9\u05df CD?",
      "back": "\u05e2\u05d9\u05e9\u05d5\u05df \u05d0\u05d9\u05de\u05d4\u05d9 \u05d1\u05d6\u05de\u05df \u05d4\u05d4\u05d9\u05e8\u05d9\u05d5\u05df \u05de\u05e2\u05dc\u05d4 \u05d0\u05ea \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05dc-CD \u05d5\u05dc\u05d4\u05d5\u05e4\u05e2\u05d4 \u05de\u05d5\u05e7\u05d3\u05de\u05ea \u05e9\u05dc \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05e2\u05d1\u05e8\u05d9\u05d9\u05e0\u05d9\u05ea (Dulcan p.210)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05d4\u05d1\u05d9\u05df-\u05d0\u05d9\u05e9\u05d9 \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05e9\u05dc \u05d0\u05d3\u05dd \u05e2\u05dd ASPD \u05d1\u05d9\u05d7\u05e1 \u05dc\u05e0\u05d9\u05e6\u05d5\u05dc \u05d0\u05d7\u05e8\u05d9\u05dd?",
      "back": "\u05d4\u05dd \u05de\u05e9\u05ea\u05de\u05e9\u05d9\u05dd \u05d1\u05de\u05e0\u05d9\u05e4\u05d5\u05dc\u05e6\u05d9\u05d5\u05ea, \u05d4\u05d5\u05e0\u05d0\u05d4 \u05d5\u05db\u05e4\u05d9\u05d9\u05d4 \u05db\u05d3\u05d9 \u05dc\u05d4\u05e9\u05d9\u05d2 \u05e8\u05d5\u05d5\u05d7 \u05d0\u05d9\u05e9\u05d9, \u05db\u05d5\u05d7 \u05d0\u05d5 \u05d4\u05e0\u05d0\u05d4 (DSM p.750)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05d4\u05d1\u05d3\u05dc \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05d1\u05d9\u05df \u05ea\u05d5\u05e7\u05e4\u05e0\u05d5\u05ea \u05d1-ODD \u05dc\u05d1\u05d9\u05df CD?",
      "back": "\u05d4\u05ea\u05d5\u05e7\u05e4\u05e0\u05d5\u05ea \u05d1-ODD \u05d4\u05d9\u05d0 \u05dc\u05e8\u05d5\u05d1 \u05de\u05d9\u05dc\u05d5\u05dc\u05d9\u05ea \u05d5\u05de\u05ea\u05d1\u05d8\u05d0\u05ea \u05d1\u05d4\u05ea\u05e7\u05e4\u05d9 \u05d6\u05e2\u05dd, \u05d1\u05e2\u05d5\u05d3 \u05d1-CD \u05d4\u05d9\u05d0 \u05db\u05d5\u05dc\u05dc\u05ea \u05ea\u05e7\u05d9\u05e4\u05d4 \u05e4\u05d9\u05d6\u05d9\u05ea \u05d5\u05e0\u05d6\u05e7 \u05dc\u05e8\u05db\u05d5\u05e9 (DSM p.530)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05d9\u05d7\u05e1 \u05d1\u05d9\u05df \u05e8\u05de\u05ea \u05d4\u05de\u05e9\u05db\u05dc (IQ) \u05dc\u05d1\u05d9\u05df CD \u05dc\u05e4\u05d9 \u05de\u05d7\u05e7\u05e8\u05d9\u05dd \u05de\u05d0\u05d5\u05d7\u05e8\u05d9\u05dd?",
      "back": "\u05e7\u05d9\u05d9\u05de\u05ea \u05de\u05ea\u05d0\u05dd \u05d1\u05d9\u05df IQ \u05e0\u05de\u05d5\u05da (\u05d1\u05de\u05d9\u05d5\u05d7\u05d3 \u05de\u05d9\u05dc\u05d5\u05dc\u05d9) \u05dc\u05d1\u05d9\u05df \u05d1\u05e2\u05d9\u05d5\u05ea \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea, \u05d2\u05dd \u05dc\u05d0\u05d7\u05e8 \u05e9\u05dc\u05d9\u05d8\u05d4 \u05e2\u05dc ADHD (Dulcan p.210)."
    }
  ]
}