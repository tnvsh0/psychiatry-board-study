    {
      "type": "short_answer",
      "question": "\u05d4\u05e1\u05d1\u05e8 \u05d0\u05ea \u05d4\u05e7\u05e9\u05e8 \u05d4\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9 \u05d1\u05d9\u05df Oppositional Defiant Disorder (ODD) \u05dc\u05d1\u05d9\u05df Conduct Disorder (CD) \u05d5\u05db\u05d9\u05e6\u05d3 \u05e0\u05d9\u05ea\u05df \u05dc\u05d4\u05d1\u05d7\u05d9\u05df \u05d1\u05d9\u05e0\u05d9\u05d4\u05dd \u05e7\u05dc\u05d9\u05e0\u05d9\u05ea?",
      "grading": {
        "modelAnswer": "ODD \u05e0\u05d7\u05e9\u05d1 \u05dc\u05e2\u05d9\u05ea\u05d9\u05dd \u05e7\u05e8\u05d5\u05d1\u05d5\u05ea \u05dc\u05de\u05d1\u05e9\u05e8 (Precursor) \u05e9\u05dc CD, \u05d1\u05de\u05d9\u05d5\u05d7\u05d3 \u05d1-Childhood-onset type. \u05d4\u05d4\u05d1\u05d3\u05dc \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9 \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05d4\u05d5\u05d0 \u05e9\u05d1-CD \u05e7\u05d9\u05d9\u05de\u05ea \u05d4\u05e4\u05e8\u05d4 \u05e9\u05dc \u05d6\u05db\u05d5\u05d9\u05d5\u05ea \u05d4\u05d6\u05d5\u05dc\u05ea \u05d0\u05d5 \u05e0\u05d5\u05e8\u05de\u05d5\u05ea \u05d7\u05d1\u05e8\u05ea\u05d9\u05d5\u05ea \u05de\u05e8\u05db\u05d6\u05d9\u05d5\u05ea (\u05ea\u05d5\u05e7\u05e4\u05e0\u05d5\u05ea, \u05d4\u05e8\u05e1 \u05e8\u05db\u05d5\u05e9, \u05d2\u05e0\u05d9\u05d1\u05d4), \u05d1\u05e2\u05d5\u05d3 \u05e9-ODD \u05de\u05ea\u05de\u05e7\u05d3 \u05d1\u05e8\u05d2\u05d6\u05e0\u05d5\u05ea, \u05d5\u05db\u05d7\u05e0\u05d5\u05ea \u05d5\u05de\u05e8\u05d3\u05e0\u05d5\u05ea \u05de\u05d5\u05dc \u05e1\u05de\u05db\u05d5\u05ea \u05dc\u05dc\u05d0 \u05ea\u05d5\u05e7\u05e4\u05e0\u05d5\u05ea \u05d7\u05de\u05d5\u05e8\u05d4. \u05d1-DSM-5-TR, \u05d0\u05dd \u05de\u05ea\u05e7\u05d9\u05d9\u05de\u05d9\u05dd \u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05dc\u05e9\u05ea\u05d9 \u05d4\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea, \u05e0\u05d9\u05ea\u05df \u05dc\u05d0\u05d1\u05d7\u05df \u05d0\u05ea \u05e9\u05ea\u05d9\u05d4\u05df \u05d1\u05de\u05e7\u05d1\u05d9\u05dc.",
        "rationale": "\u05d4\u05d4\u05d1\u05d7\u05e0\u05d4 \u05de\u05d1\u05d5\u05e1\u05e1\u05ea \u05e2\u05dc \u05d7\u05d5\u05de\u05e8\u05ea \u05d4\u05e4\u05d2\u05d9\u05e2\u05d4 \u05d1\u05e0\u05d5\u05e8\u05de\u05d5\u05ea \u05d5\u05d6\u05db\u05d5\u05d9\u05d5\u05ea, \u05db\u05d0\u05e9\u05e8 CD \u05de\u05d9\u05d9\u05e6\u05d2\u05ea \u05e8\u05de\u05d4 \u05d7\u05de\u05d5\u05e8\u05d4 \u05d9\u05d5\u05ea\u05e8 \u05e9\u05dc \u05d4\u05e4\u05e8\u05e2\u05d4 \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea\u05d9\u05ea.",
        "requiredAttributes": [
