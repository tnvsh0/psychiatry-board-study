{
  "title": "Conduct Quiz",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\u05d1\u05df 17 \u05de\u05d5\u05d1\u05d0 \u05dc\u05d4\u05e2\u05e8\u05db\u05d4 \u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9\u05ea \u05d1\u05e9\u05dc \u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4 \u05e9\u05dc \u05d2\u05e0\u05d9\u05d1\u05d5\u05ea \u05e8\u05db\u05d1, \u05e4\u05e8\u05d9\u05e6\u05d5\u05ea \u05dc\u05d1\u05ea\u05d9\u05dd \u05d5\u05ea\u05e7\u05d9\u05e4\u05d5\u05ea \u05e4\u05d9\u05d6\u05d9\u05d5\u05ea \u05d7\u05d5\u05d6\u05e8\u05d5\u05ea \u05e9\u05d4\u05d7\u05dc\u05d5 \u05d1\u05d2\u05d9\u05dc 12. \u05d4\u05d5\u05d0 \u05d0\u05d9\u05e0\u05d5 \u05de\u05d1\u05d9\u05e2 \u05d7\u05e8\u05d8\u05d4 \u05e2\u05dc \u05de\u05e2\u05e9\u05d9\u05d5 \u05d5\u05d8\u05d5\u05e2\u05df \u05db\u05d9 \u05d4\u05e7\u05d5\u05e8\u05d1\u05e0\u05d5\u05ea \"\u05d4\u05d9\u05d5 \u05e6\u05e8\u05d9\u05db\u05d9\u05dd \u05dc\u05e9\u05de\u05d5\u05e8 \u05d8\u05d5\u05d1 \u05d9\u05d5\u05ea\u05e8 \u05e2\u05dc \u05d4\u05e8\u05db\u05d5\u05e9 \u05e9\u05dc\u05d4\u05dd\". \u05d1\u05d1\u05d3\u05d9\u05e7\u05d4 \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05d4\u05d5\u05d0 \u05de\u05e9\u05ea\u05e3 \u05e4\u05e2\u05d5\u05dc\u05d4 \u05d1\u05d0\u05d5\u05e4\u05df \u05e9\u05d8\u05d7\u05d9 \u05d0\u05da \u05de\u05e0\u05d9\u05e4\u05d5\u05dc\u05d8\u05d9\u05d1\u05d9. \u05de\u05d4\u05d9 \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05de\u05ea\u05d0\u05d9\u05de\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR?",
      "answerOptions": [
        {
          "text": "Conduct Disorder, Childhood-onset type",
          "isCorrect": true,
          "rationale": "\u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05de\u05ea\u05d0\u05d9\u05de\u05d4 \u05db\u05d9\u05d5\u05d5\u05df \u05e9\u05d4\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05d4\u05d7\u05dc\u05d5 \u05dc\u05e4\u05e0\u05d9 \u05d2\u05d9\u05dc 10 (\u05dc\u05e4\u05d9 \u05d4\u05ea\u05d9\u05d0\u05d5\u05e8 \u05e9\u05dc \u05d2\u05d9\u05dc 12 \u05d6\u05d4\u05d5 Adolescent-onset, \u05d0\u05da \u05db\u05d0\u05df \u05de\u05d3\u05d5\u05d1\u05e8 \u05e2\u05dc \u05d3\u05e4\u05d5\u05e1 \u05d7\u05d5\u05d6\u05e8 \u05d4\u05de\u05e4\u05e8 \u05d6\u05db\u05d5\u05d9\u05d5\u05ea) \u05d5\u05d4\u05d5\u05d0 \u05de\u05ea\u05d7\u05ea \u05dc\u05d2\u05d9\u05dc 18, \u05de\u05d4 \u05e9\u05de\u05d5\u05e0\u05e2 \u05d0\u05d1\u05d7\u05e0\u05ea ASPD (DSM p.531)."
        },
        {
          "text": "Antisocial Personality Disorder (ASPD)",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05d4\u05d3\u05e4\u05d5\u05e1 \u05d4\u05d0\u05e0\u05d8\u05d9-\u05e1\u05d5\u05e6\u05d9\u05d0\u05dc\u05d9 \u05d4\u05de\u05d5\u05d1\u05d4\u05e7, \u05d0\u05d1\u05d7\u05e0\u05ea ASPD \u05de\u05d7\u05d9\u05d9\u05d1\u05ea \u05e9\u05d4\u05e4\u05e8\u05d8 \u05d9\u05d4\u05d9\u05d4 \u05dc\u05e4\u05d7\u05d5\u05ea \u05d1\u05df 18 (DSM p.748)."
        },
        {
          "text": "Oppositional Defiant Disorder (ODD)",
          "isCorrect": false,
          "rationale": "ODD \u05de\u05ea\u05de\u05e7\u05d3 \u05d1\u05e2\u05d9\u05e7\u05e8 \u05d1\u05e2\u05d9\u05de\u05d5\u05ea \u05e2\u05dd \u05e1\u05de\u05db\u05d5\u05ea \u05d5\u05d0\u05d9-\u05d5\u05d9\u05e1\u05d5\u05ea \u05e8\u05d2\u05e9\u05d9, \u05d5\u05d0\u05d9\u05e0\u05d5 \u05db\u05d5\u05dc\u05dc \u05d4\u05e4\u05e8\u05d5\u05ea \u05d7\u05de\u05d5\u05e8\u05d5\u05ea \u05e9\u05dc \u05d6\u05db\u05d5\u05d9\u05d5\u05ea \u05d4\u05d6\u05d5\u05dc\u05ea \u05db\u05de\u05d5 \u05d2\u05e0\u05d9\u05d1\u05d4 \u05d0\u05d5 \u05ea\u05e7\u05d9\u05e4\u05d4 \u05e4\u05d9\u05d6\u05d9\u05ea (DSM p.526)."
        },
        {
          "text": "Adjustment Disorder with disturbance of conduct",
          "isCorrect": false,
          "rationale": "\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d6\u05d5 \u05e8\u05dc\u05d5\u05d5\u05e0\u05d8\u05d9\u05ea \u05e8\u05e7 \u05db\u05d0\u05e9\u05e8 \u05d4\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d4\u05d9\u05d0 \u05ea\u05d2\u05d5\u05d1\u05d4 \u05dc\u05e1\u05d8\u05e8\u05e1\u05d5\u05e8 \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9 \u05d5\u05d0\u05d9\u05e0\u05d4 \u05e2\u05d5\u05de\u05d3\u05ea \u05d1\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05e9\u05dc \u05d4\u05e4\u05e8\u05e2\u05d4 \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05ea \u05d0\u05d7\u05e8\u05ea (DSM p.537)."
        }
      ],
      "hint": "\u05e9\u05d9\u05de\u05d5 \u05dc\u05d1 \u05dc\u05d2\u05d9\u05dc \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05d5\u05dc\u05d3\u05e8\u05d9\u05e9\u05d5\u05ea \u05d4\u05e1\u05e3 \u05e9\u05dc \u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05d0\u05d9\u05e9\u05d9\u05d5\u05ea \u05d1-DSM.",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05e2\u05e8\u05db\u05d4 \u05e9\u05dc \u05e0\u05e2\u05e8 \u05e2\u05dd Conduct Disorder, \u05d4\u05e7\u05dc\u05d9\u05e0\u05d0\u05d9 \u05de\u05ea\u05de\u05e7\u05d3 \u05d1\u05d1\u05d3\u05d9\u05e7\u05ea \u05d4\u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05d9\u05e8 \"With limited prosocial emotions\". \u05d0\u05d9\u05d6\u05d4 \u05de\u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9\u05dd \u05d4\u05d1\u05d0\u05d9\u05dd \u05d4\u05db\u05e8\u05d7\u05d9 \u05dc\u05e6\u05d5\u05e8\u05da \u05de\u05ea\u05df \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05d9\u05e8 \u05d6\u05d4 \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR?",
      "answerOptions": [
        {
          "text": "\u05dc\u05e4\u05d7\u05d5\u05ea \u05e9\u05e0\u05d9 \u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9\u05dd (\u05db\u05d2\u05d5\u05df \u05d7\u05d5\u05e1\u05e8 \u05d0\u05de\u05e4\u05ea\u05d9\u05d4 \u05d0\u05d5 \u05d7\u05d5\u05e1\u05e8 \u05d7\u05e8\u05d8\u05d4) \u05d4\u05e7\u05d9\u05d9\u05de\u05d9\u05dd \u05d1\u05d0\u05d5\u05e4\u05df \u05e2\u05e7\u05d1\u05d9 \u05d1\u05de\u05e9\u05da 12 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05dc\u05e4\u05d7\u05d5\u05ea.",
          "isCorrect": true,
          "rationale": "\u05d4\u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05d9\u05e8 \u05d3\u05d5\u05e8\u05e9 \u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05e9\u05dc \u05dc\u05e4\u05d7\u05d5\u05ea \u05e9\u05e0\u05d9\u05d9\u05dd \u05de\u05ea\u05d5\u05da \u05d0\u05e8\u05d1\u05e2\u05d4 \u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9\u05dd \u05dc\u05d0\u05d5\u05e8\u05da \u05e9\u05e0\u05d4 \u05dc\u05e4\u05d7\u05d5\u05ea \u05d5\u05d1\u05de\u05e1\u05e4\u05e8 \u05d4\u05d2\u05d3\u05e8\u05d5\u05ea \u05d5\u05de\u05e2\u05e8\u05db\u05d5\u05ea \u05d9\u05d7\u05e1\u05d9\u05dd (DSM p.532)."
        },
        {
          "text": "\u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05e9\u05dc \u05d7\u05d5\u05e1\u05e8 \u05d7\u05e8\u05d8\u05d4 \u05d1\u05dc\u05d1\u05d3, \u05d2\u05dd \u05d0\u05dd \u05d4\u05d9\u05d0 \u05de\u05d5\u05d1\u05e2\u05ea \u05e8\u05e7 \u05dc\u05d0\u05d7\u05e8 \u05e9\u05d4\u05e0\u05e2\u05e8 \u05e0\u05ea\u05e4\u05e1.",
          "isCorrect": false,
          "rationale": "\u05d7\u05e8\u05d8\u05d4 \u05d4\u05de\u05d5\u05d1\u05e2\u05ea \u05e8\u05e7 \u05dc\u05d0\u05d7\u05e8 \u05e9\u05e0\u05ea\u05e4\u05e1 \u05d0\u05d5 \u05e2\u05d5\u05de\u05d3 \u05d1\u05e4\u05e0\u05d9 \u05e2\u05d5\u05e0\u05e9 \u05d0\u05d9\u05e0\u05d4 \u05e0\u05d7\u05e9\u05d1\u05ea \u05dc\u05e6\u05d5\u05e8\u05da \u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df \u05e9\u05dc \u05d7\u05d5\u05e1\u05e8 \u05d7\u05e8\u05d8\u05d4 (Dulcan p.206)."
        },
        {
          "text": "\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05ea\u05d5\u05e7\u05e4\u05e0\u05d9\u05ea \u05d0\u05d9\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05ea \u05d5\u05dc\u05d0 \u05de\u05ea\u05d5\u05db\u05e0\u05e0\u05ea (Reactive aggression).",
          "isCorrect": false,
          "rationale": "\u05e4\u05e8\u05d8\u05d9\u05dd \u05e2\u05dd \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05d9\u05e8 \u05d6\u05d4 \u05e0\u05d5\u05d8\u05d9\u05dd \u05d9\u05d5\u05ea\u05e8 \u05dc\u05ea\u05d5\u05e7\u05e4\u05e0\u05d5\u05ea \u05de\u05ea\u05d5\u05db\u05e0\u05e0\u05ea (Instrumental aggression) \u05dc\u05d4\u05e9\u05d2\u05ea \u05e8\u05d5\u05d5\u05d7 \u05d0\u05d9\u05e9\u05d9 (DSM p.533)."
        },
        {
          "text": "\u05e8\u05d2\u05d9\u05e9\u05d5\u05ea \u05d2\u05d1\u05d5\u05d4\u05d4 \u05dc\u05e2\u05d5\u05e0\u05e9\u05d9\u05dd \u05d5\u05d7\u05e8\u05d3\u05d4 \u05d7\u05d1\u05e8\u05ea\u05d9\u05ea \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea.",
          "isCorrect": false,
          "rationale": "\u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9\u05dd \u05e9\u05dc Limited prosocial emotions \u05e7\u05e9\u05d5\u05e8\u05d9\u05dd \u05d3\u05d5\u05d5\u05e7\u05d0 \u05dc\u05d7\u05d5\u05e1\u05e8 \u05e4\u05d7\u05d3, \u05e8\u05d3\u05d9\u05e4\u05ea \u05e8\u05d9\u05d2\u05d5\u05e9\u05d9\u05dd \u05d5\u05d7\u05d5\u05e1\u05e8 \u05e8\u05d2\u05d9\u05e9\u05d5\u05ea \u05dc\u05e2\u05d5\u05e0\u05e9\u05d9\u05dd (Dulcan p.206)."
        }
      ],
      "hint": "\u05d4\u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05d9\u05e8 \u05d3\u05d5\u05e8\u05e9 \u05d9\u05e6\u05d9\u05d1\u05d5\u05ea \u05d1\u05d6\u05de\u05df \u05d5\u05de\u05e1\u05e4\u05e8 \u05de\u05d9\u05e0\u05d9\u05de\u05dc\u05d9 \u05e9\u05dc \u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9\u05dd \u05d0\u05d9\u05e9\u05d9\u05d5\u05ea\u05d9\u05d9\u05dd.",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05de\u05d7\u05e7\u05e8\u05d9\u05dd \u05e0\u05d5\u05d9\u05e8\u05d5\u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05d9\u05dd \u05d5\u05e4\u05d9\u05d6\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05d9\u05dd \u05d6\u05d9\u05d4\u05d5 \u05e1\u05de\u05e0\u05d9\u05dd \u05de\u05e1\u05d5\u05d9\u05de\u05d9\u05dd \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9\u05dd \u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd Conduct Disorder. \u05d0\u05d9\u05d6\u05d4 \u05de\u05d4\u05de\u05de\u05e6\u05d0\u05d9\u05dd \u05d4\u05d1\u05d0\u05d9\u05dd \u05e0\u05d7\u05e9\u05d1 \u05dc\u05e1\u05de\u05df \u05d0\u05de\u05d9\u05df (Relially noted) \u05d1\u05d4\u05e9\u05d5\u05d5\u05d0\u05d4 \u05dc\u05e7\u05d1\u05d5\u05e6\u05ea \u05d1\u05d9\u05e7\u05d5\u05e8\u05ea, \u05d0\u05dd \u05db\u05d9 \u05d0\u05d9\u05e0\u05d5 \u05d0\u05d1\u05d7\u05e0\u05ea\u05d9 \u05db\u05e9\u05dc\u05e2\u05e6\u05de\u05d5?",
      "answerOptions": [
        {
          "text": "\u05e7\u05e6\u05d1 \u05dc\u05d1 \u05d1\u05de\u05e0\u05d5\u05d7\u05d4 \u05d0\u05d9\u05d8\u05d9 \u05d9\u05d5\u05ea\u05e8 (Slower resting heart rate).",
          "isCorrect": true,
          "rationale": "\u05e7\u05e6\u05d1 \u05dc\u05d1 \u05e0\u05de\u05d5\u05da \u05d1\u05de\u05e0\u05d5\u05d7\u05d4 \u05d4\u05d5\u05d0 \u05de\u05de\u05e6\u05d0 \u05e4\u05d9\u05d6\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05e2\u05e7\u05d1\u05d9 \u05d1-CD \u05d5\u05d0\u05d9\u05e0\u05d5 \u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05de\u05e0\u05d8\u05dc\u05d9\u05d5\u05ea \u05d0\u05d7\u05e8\u05d5\u05ea (DSM p.535)."
        },
        {
          "text": "\u05e8\u05de\u05d5\u05ea \u05d2\u05d1\u05d5\u05d4\u05d5\u05ea \u05d1\u05de\u05d9\u05d5\u05d7\u05d3 \u05e9\u05dc $Cortisol$ \u05d1\u05d1\u05d5\u05e7\u05e8.",
          "isCorrect": false,
          "rationale": "\u05de\u05d7\u05e7\u05e8\u05d9\u05dd \u05de\u05e6\u05d1\u05d9\u05e2\u05d9\u05dd \u05d3\u05d5\u05d5\u05e7\u05d0 \u05e2\u05dc \u05ea\u05ea-\u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05e9\u05dc \u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05dc\u05d7\u05e5 \u05d0\u05d5 \u05e8\u05de\u05d5\u05ea \u05e0\u05de\u05d5\u05db\u05d5\u05ea \u05e9\u05dc \u05e2\u05d5\u05e8\u05e8\u05d5\u05ea \u05e4\u05d9\u05d6\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea (Reduced autonomic fear conditioning) (DSM p.535)."
        },
        {
          "text": "\u05de\u05d5\u05dc\u05d9\u05db\u05d5\u05ea \u05e2\u05d5\u05e8 (Skin conductance) \u05d2\u05d1\u05d5\u05d4\u05d4 \u05d1\u05de\u05e6\u05d1\u05d9 \u05dc\u05d7\u05e5.",
          "isCorrect": false,
