{
  "title": "Postpartum Flashcards",
  "cards": [
    {
      "front": "\u05de\u05d4\u05d5 \u05d7\u05dc\u05d5\u05df \u05d4\u05d6\u05de\u05e0\u05d9\u05dd \u05dc\u05d4\u05d2\u05d3\u05e8\u05ea \u05d4\u05de\u05e6\u05d9\u05d9\u05df 'With peripartum onset' \u05e2\u05d1\u05d5\u05e8 \u05d0\u05d9\u05e8\u05d5\u05e2 \u05de\u05e6\u05d1 \u05e8\u05d5\u05d7 \u05dc\u05e4\u05d9 DSM-5-TR?",
      "back": "\u05ea\u05d7\u05d9\u05dc\u05ea \u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05de\u05ea\u05e8\u05d7\u05e9\u05ea \u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05d4\u05d9\u05e8\u05d9\u05d5\u05df \u05d0\u05d5 \u05d1-4 \u05d4\u05e9\u05d1\u05d5\u05e2\u05d5\u05ea \u05d4\u05e8\u05d0\u05e9\u05d5\u05e0\u05d9\u05dd \u05e9\u05dc\u05d0\u05d7\u05e8 \u05d4\u05dc\u05d9\u05d3\u05d4 (DSM p.173)."
    },
    {
      "front": "\u05d0\u05d9\u05d6\u05d4 \u05d0\u05d7\u05d5\u05d6 \u05de\u05d0\u05d9\u05e8\u05d5\u05e2\u05d9 \u05d4\u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05d4\u05de\u05d5\u05d2\u05d3\u05e8\u05d9\u05dd \u05db\u05e4\u05d5\u05e1\u05d8-\u05e4\u05d0\u05e8\u05d8\u05d5\u05dd \u05de\u05ea\u05d7\u05d9\u05dc\u05d9\u05dd \u05dc\u05de\u05e2\u05e9\u05d4 \u05e2\u05d5\u05d3 \u05dc\u05e4\u05e0\u05d9 \u05d4\u05dc\u05d9\u05d3\u05d4 (\u05d8\u05e8\u05d5\u05dd-\u05dc\u05d9\u05d3\u05ea\u05d9)?",
      "back": "\u05db-$50\\%$ \u05de\u05d0\u05d9\u05e8\u05d5\u05e2\u05d9 \u05d4\u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05d4\u05de\u05d5\u05d2\u05d3\u05e8\u05d9\u05dd \u05db\u05e4\u05d5\u05e1\u05d8-\u05e4\u05d0\u05e8\u05d8\u05d5\u05dd \u05de\u05ea\u05d7\u05d9\u05dc\u05d9\u05dd \u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05d4\u05d9\u05e8\u05d9\u05d5\u05df (DSM p.173)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d4\u05e0\u05d0\u05de\u05d3\u05ea \u05e9\u05dc Postpartum Psychosis \u05d1\u05d0\u05d5\u05db\u05dc\u05d5\u05e1\u05d9\u05d9\u05d4 \u05d4\u05db\u05dc\u05dc\u05d9\u05ea?",
      "back": "\u05d4\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d4\u05d9\u05d0 \u05d1\u05d9\u05df 1 \u05dc-500 \u05dc-1,000 \u05dc\u05d9\u05d3\u05d5\u05ea, \u05e9\u05d4\u05dd $0.1\\%-0.2\\%$ \u05de\u05d4\u05dc\u05d9\u05d3\u05d5\u05ea (DSM p.174)."
    },
    {
      "front": "\u05d0\u05d9\u05dc\u05d5 \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05d9\u05dd \u05d1-Postpartum Psychosis \u05e7\u05e9\u05d5\u05e8\u05d9\u05dd \u05d1\u05d0\u05d5\u05e4\u05df \u05de\u05d5\u05d1\u05d4\u05e7 \u05dc\u05e1\u05d9\u05db\u05d5\u05df \u05de\u05d5\u05d2\u05d1\u05e8 \u05dc-Infanticide?",
      "back": "\u05d4\u05d6\u05d9\u05d5\u05ea \u05de\u05e1\u05d5\u05d2 Command hallucinations \u05dc\u05d4\u05e8\u05d5\u05d2 \u05d0\u05ea \u05d4\u05ea\u05d9\u05e0\u05d5\u05e7 \u05d0\u05d5 Delusions \u05e9\u05d4\u05ea\u05d9\u05e0\u05d5\u05e7 \u05d0\u05d7\u05d5\u05d6 \u05d3\u05d9\u05d1\u05d5\u05e7 (DSM p.174)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05e9\u05d9\u05e2\u05d5\u05e8 \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05d4\u05d9\u05e9\u05e0\u05d5\u05ea \u05e9\u05dc \u05d0\u05d9\u05e8\u05d5\u05e2 \u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9 \u05e4\u05d5\u05e1\u05d8-\u05e4\u05d0\u05e8\u05d8\u05d5\u05dd \u05d1\u05db\u05dc \u05dc\u05d9\u05d3\u05d4 \u05e2\u05ea\u05d9\u05d3\u05d9\u05ea \u05dc\u05d0\u05d7\u05e8 \u05d0\u05d9\u05e8\u05d5\u05e2 \u05e7\u05d5\u05d3\u05dd?",
      "back": "\u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05d4\u05d9\u05e9\u05e0\u05d5\u05ea \u05e2\u05d5\u05de\u05d3 \u05e2\u05dc $30\\%$ \u05e2\u05d3 $50\\%$ \u05d1\u05db\u05dc \u05dc\u05d9\u05d3\u05d4 \u05e2\u05ea\u05d9\u05d3\u05d9\u05ea (DSM p.174)."
    },
    {
      "front": "\u05de\u05d3\u05d5\u05e2 Sertraline \u05e0\u05d7\u05e9\u05d1\u05ea \u05dc-Preferred SSRI \u05e2\u05d1\u05d5\u05e8 \u05e0\u05e9\u05d9\u05dd \u05de\u05e0\u05d9\u05e7\u05d5\u05ea (Lactation)?",
      "back": "\u05d1\u05e9\u05dc \u05de\u05e2\u05d1\u05e8 \u05de\u05d6\u05e2\u05e8\u05d9 \u05dc\u05d7\u05dc\u05d1 \u05d0\u05dd \u05d5\u05e8\u05de\u05d5\u05ea \u05e4\u05dc\u05e1\u05de\u05d4 \u05d1\u05dc\u05ea\u05d9 \u05e0\u05d9\u05ea\u05e0\u05d5\u05ea \u05dc\u05d6\u05d9\u05d4\u05d5\u05d9 \u05d1\u05d3\u05dd \u05d4\u05ea\u05d9\u05e0\u05d5\u05e7 \u05d4\u05d9\u05d5\u05e0\u05e7 (StahlKids p.437)."
    },
    {
      "front": "\u05d1\u05e0\u05d5\u05e1\u05e3 \u05dc\u05e2\u05d9\u05db\u05d5\u05d1 SERT, \u05de\u05d4\u05d5 \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05e0\u05d5\u05d9\u05e8\u05d5\u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d4\u05d9\u05d9\u05d7\u05d5\u05d3\u05d9 \u05e9\u05dc Sertraline \u05d4\u05de\u05e2\u05e0\u05d9\u05e7 \u05dc\u05d4 \u05e4\u05e8\u05d5\u05e4\u05d9\u05dc Activating?",
      "back": "\u05e2\u05d9\u05db\u05d5\u05d1 \u05d7\u05dc\u05e9 \u05e9\u05dc \u05d4-Dopamine Transporter (DAT) \u05d5\u05d6\u05d9\u05e7\u05d4 \u05dc\u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 $\\sigma_{1}$ (StahlNeuro p.292)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05e9\u05dc Neonatal Behavioral Syndrome \u05d1\u05d9\u05dc\u05d5\u05d3\u05d9\u05dd \u05e9\u05e0\u05d7\u05e9\u05e4\u05d5 \u05dc-SSRIs \u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05e9\u05dc\u05d9\u05e9 \u05d4\u05e9\u05dc\u05d9\u05e9\u05d9 \u05dc\u05d4\u05d9\u05e8\u05d9\u05d5\u05df?",
      "back": "\u05d4\u05ea\u05e1\u05de\u05d5\u05e0\u05ea \u05de\u05ea\u05e8\u05d7\u05e9\u05ea \u05d1\u05e7\u05d9\u05e8\u05d5\u05d1 \u05d1-$10\\%$ \u05e2\u05d3 $30\\%$ \u05de\u05d4\u05d9\u05dc\u05d5\u05d3\u05d9\u05dd \u05e9\u05e0\u05d7\u05e9\u05e4\u05d5 (Dulcan p.731)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05d4\u05e0\u05d7\u05d9\u05d4 \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05dc\u05d2\u05d1\u05d9 \u05e9\u05d9\u05de\u05d5\u05e9 \u05d1-Valproate \u05d1\u05e0\u05e9\u05d9\u05dd \u05d1\u05d2\u05d9\u05dc \u05d4\u05e4\u05e8\u05d9\u05d5\u05df \u05d0\u05d5 \u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05d9\u05e8\u05d9\u05d5\u05df?",
      "back": "\u05e7\u05d9\u05d9\u05de\u05ea \u05d4\u05ea\u05d5\u05d5\u05d9\u05d9\u05ea \u05e0\u05d2\u05d3 \u05de\u05d5\u05d7\u05dc\u05d8\u05ea (AVOID) \u05d1\u05e9\u05dc \u05d4\u05d9\u05d5\u05ea\u05d4 Teratogen \u05d4\u05d2\u05d5\u05e8\u05dd \u05dc-Neural Tube Defects (StahlKids p.402)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05e4\u05e2\u05d5\u05dc\u05d4 \u05e9\u05dc Brexanolone \u05d5\u05d4\u05e4\u05d5\u05e8\u05de\u05d8 \u05d1\u05d5 \u05d4\u05d9\u05d0 \u05e0\u05d9\u05ea\u05e0\u05ea \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-PPD?",
      "back": "\u05d4\u05d9\u05d0 \u05e0\u05d9\u05ea\u05e0\u05ea \u05d1\u05e2\u05d9\u05e8\u05d5\u05d9 IV \u05dc\u05de\u05e9\u05da 60 \u05e9\u05e2\u05d5\u05ea \u05d5\u05e4\u05d5\u05e2\u05dc\u05ea \u05db-PAM \u05e2\u05dc \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 $GABA_A$ \u05d0\u05e7\u05e1\u05d8\u05e8\u05d4-\u05e1\u05d9\u05e0\u05e4\u05d8\u05d9\u05d9\u05dd (StahlNeuro p.321)."
    },
    {
      "front": "\u05d0\u05d9\u05d6\u05d5 \u05ea\u05e8\u05d5\u05e4\u05d4 \u05e4\u05d5\u05de\u05d9\u05ea (PO) \u05de\u05d4\u05d5\u05d5\u05d4 \u05d0\u05e0\u05dc\u05d5\u05d2 \u05e1\u05d9\u05e0\u05ea\u05d8\u05d9 \u05e9\u05dc Allopregnanolone \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-PPD?",
      "back": "\u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 \u05d4\u05d9\u05d0 Zuranolone (\u05d4\u05d9\u05d3\u05d5\u05e2\u05d4 \u05d2\u05dd \u05db-SAGE-217) (StahlNeuro p.322)."
    },
    {
      "front": "\u05dc\u05d0\u05d9\u05d6\u05d5 \u05d4\u05e4\u05e8\u05e2\u05d4 \u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9\u05ea \u05e7\u05d9\u05d9\u05de\u05ea \u05d4\u05d6\u05d9\u05e7\u05d4 \u05d4\u05d7\u05d6\u05e7\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d1\u05d4\u05d5\u05e4\u05e2\u05ea Postpartum Psychosis?",
      "back": "\u05e7\u05d9\u05d9\u05de\u05ea \u05d6\u05d9\u05e7\u05d4 \u05d7\u05d6\u05e7\u05d4 \u05de\u05d0\u05d5\u05d3 \u05dc-Bipolar I Disorder, \u05db\u05d0\u05e9\u05e8 \u05d4\u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d4 \u05dc\u05e8\u05d5\u05d1 \u05d3\u05d5\u05de\u05d4 \u05dc\u05d0\u05d9\u05e8\u05d5\u05e2 Manic or Mixed (DSM p.174)."
    },
    {
      "front": "\u05d0\u05d9\u05dc\u05d5 \u05db\u05dc\u05d9 \u05e1\u05e7\u05e8 \u05de\u05d5\u05de\u05dc\u05e6\u05d9\u05dd \u05dc\u05d6\u05d9\u05d4\u05d5\u05d9 \u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05d4\u05d5\u05e8\u05d9 \u05d1\u05ea\u05e7\u05d5\u05e4\u05d4 \u05d4\u05e4\u05e8\u05d9\u05e0\u05d8\u05dc\u05d9\u05ea \u05dc\u05e4\u05d9 Dulcan?",
      "back": "\u05de\u05d5\u05de\u05dc\u05e5 \u05dc\u05d4\u05e9\u05ea\u05de\u05e9 \u05d1-Edinburgh Postnatal Depression Scale \u05d5\u05d1-Patient Health Questionnaires (Dulcan p.34)."
    },
    {
      "front": "\u05d0\u05d9\u05dc\u05d5 \u05de\u05e6\u05d1\u05d9\u05dd \u05e8\u05e4\u05d5\u05d0\u05d9\u05d9\u05dd \u05e4\u05e8\u05d9\u05e0\u05d8\u05dc\u05d9\u05d9\u05dd \u05e2\u05dc\u05d5\u05dc\u05d9\u05dd \u05dc\u05d4\u05e6\u05d9\u05d2 \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d3\u05de\u05d5\u05d9\u05d9 \u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05d5\u05de\u05d7\u05d9\u05d9\u05d1\u05d9\u05dd \u05d0\u05d1\u05d7\u05e0\u05d4 \u05de\u05d1\u05d3\u05dc\u05ea?",
      "back": "\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05d1\u05d1\u05dc\u05d5\u05d8\u05ea \u05d4\u05ea\u05e8\u05d9\u05e1, \u05db\u05d2\u05d5\u05df Postpartum Thyroiditis, \u05d4\u05e2\u05dc\u05d5\u05dc\u05d5\u05ea \u05dc\u05d2\u05e8\u05d5\u05dd \u05dc\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d3\u05d9\u05db\u05d0\u05d5\u05e0\u05d9\u05d9\u05dd (DSM p.174)."
    },
    {
      "front": "\u05de\u05d4\u05df \u05d4\u05d4\u05e0\u05d7\u05d9\u05d5\u05ea \u05dc\u05d2\u05d1\u05d9 \u05e9\u05d9\u05de\u05d5\u05e9 \u05d1-Lithium \u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05e0\u05e7\u05d4 (Lactation)?",
      "back": "\u05d4\u05e9\u05d9\u05de\u05d5\u05e9 \u05d0\u05e4\u05e9\u05e8\u05d9 \u05d0\u05da \u05de\u05d7\u05d9\u05d9\u05d1 \u05e0\u05d9\u05d8\u05d5\u05e8 \u05d4\u05d3\u05d5\u05e7 \u05e9\u05dc \u05d4\u05ea\u05d9\u05e0\u05d5\u05e7, \u05db\u05d5\u05dc\u05dc \u05e8\u05de\u05d5\u05ea Lithium \u05d5\u05ea\u05e4\u05e7\u05d5\u05d3\u05d9 \u05db\u05dc\u05d9\u05d5\u05ea/TSH (StahlKids p.288)."
    },
    {
      "front": "\u05de\u05d3\u05d5\u05e2 Paroxetine \u05e0\u05d7\u05e9\u05d1\u05ea \u05dc\u05e4\u05d7\u05d5\u05ea \u05de\u05d5\u05de\u05dc\u05e6\u05ea \u05dc\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05d4\u05d9\u05e8\u05d9\u05d5\u05df \u05d1\u05d4\u05e9\u05d5\u05d5\u05d0\u05d4 \u05dc-SSRIs \u05d0\u05d7\u05e8\u05d9\u05dd?",
      "back": "\u05d4\u05d9\u05d0 \u05e7\u05d5\u05e9\u05e8\u05d4 \u05d1\u05de\u05d7\u05e7\u05e8\u05d9\u05dd \u05dc\u05e1\u05d9\u05db\u05d5\u05df \u05de\u05d5\u05d2\u05d1\u05e8 \u05dc\u05de\u05d5\u05de\u05d9\u05dd \u05dc\u05d1\u05d1\u05d9\u05d9\u05dd (Cardiac defects) \u05d1\u05e2\u05d5\u05d1\u05e8 (Dulcan p.731)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05de\u05e9\u05de\u05e2\u05d5\u05ea \u05d4\u05d0\u05d1\u05e1\u05d5\u05dc\u05d5\u05d8\u05d9\u05ea \u05e9\u05dc \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05dc-PPHN \u05d1\u05d7\u05e9\u05d9\u05e4\u05d4 \u05dc-SSRIs \u05d1\u05e9\u05dc\u05d1 \u05de\u05d0\u05d5\u05d7\u05e8 \u05e9\u05dc \u05d4\u05d4\u05d9\u05e8\u05d9\u05d5\u05df?",
      "back": "\u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05e0\u05d5\u05ea\u05e8 \u05e0\u05de\u05d5\u05da \u05de\u05d0\u05d5\u05d3 \u05d0\u05d1\u05e1\u05d5\u05dc\u05d5\u05d8\u05d9\u05ea, \u05d5\u05e2\u05d5\u05dc\u05d4 \u05de-1-2 \u05de\u05e7\u05e8\u05d9\u05dd \u05dc-1,000 \u05dc\u05d9\u05d3\u05d5\u05ea \u05dc-3-4 \u05de\u05e7\u05e8\u05d9\u05dd \u05dc-1,000 \u05dc\u05d9\u05d3\u05d5\u05ea (Dulcan p.731)."
