          "text": "\u05d1\u05e9\u05dc \u05e8\u05de\u05d5\u05ea \u05e4\u05dc\u05e1\u05de\u05d4 \u05e9\u05dc \u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 \u05d1\u05d3\u05dd \u05d4\u05ea\u05d9\u05e0\u05d5\u05e7 \u05e9\u05d4\u05df \u05d1\u05d3\u05e8\u05da \u05db\u05dc\u05dc Undetectable.",
          "isCorrect": true,
          "rationale": "\u05d4\u05e4\u05e8\u05e9\u05ea Sertraline \u05dc\u05d7\u05dc\u05d1 \u05d0\u05dd \u05d4\u05d9\u05d0 \u05de\u05d6\u05e2\u05e8\u05d9\u05ea \u05d1\u05d9\u05d5\u05ea\u05e8, \u05de\u05d4 \u05e9\u05de\u05d5\u05d1\u05d9\u05dc \u05dc\u05e8\u05de\u05d5\u05ea \u05d6\u05e0\u05d9\u05d7\u05d5\u05ea \u05d0\u05d5 \u05d1\u05dc\u05ea\u05d9 \u05e0\u05d9\u05ea\u05e0\u05d5\u05ea \u05dc\u05d6\u05d9\u05d4\u05d5\u05d9 \u05d1\u05d3\u05dd \u05d4\u05ea\u05d9\u05e0\u05d5\u05e7 \u05d4\u05d9\u05d5\u05e0\u05e7 (StahlKids p.437, Dulcan p.741)."
        },
        {
          "text": "\u05d1\u05e9\u05dc \u05d6\u05de\u05df \u05de\u05d7\u05e6\u05d9\u05ea \u05d7\u05d9\u05d9\u05dd \u05e7\u05e6\u05e8 \u05d1\u05de\u05d9\u05d5\u05d7\u05d3 \u05d4\u05de\u05d5\u05e0\u05e2 \u05d4\u05e6\u05d8\u05d1\u05e8\u05d5\u05ea (Accumulation) \u05d1\u05ea\u05d9\u05e0\u05d5\u05e7.",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05e9\u05d6\u05de\u05df \u05de\u05d7\u05e6\u05d9\u05ea \u05d4\u05d7\u05d9\u05d9\u05dd \u05d0\u05d9\u05e0\u05d5 \u05d4\u05d0\u05e8\u05d5\u05da \u05d1\u05d9\u05d5\u05ea\u05e8, \u05d4\u05e1\u05d9\u05d1\u05d4 \u05d4\u05de\u05e8\u05db\u05d6\u05d9\u05ea \u05d4\u05d9\u05d0 \u05e9\u05d9\u05e2\u05d5\u05e8 \u05d4\u05de\u05e2\u05d1\u05e8 \u05d4\u05e0\u05de\u05d5\u05da \u05dc\u05d7\u05dc\u05d1 (StahlKids p.441)."
        },
        {
          "text": "\u05d1\u05e9\u05dc \u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d9\u05d9\u05d7\u05d5\u05d3\u05d9 \u05e9\u05dc \u05e2\u05d9\u05db\u05d5\u05d1 DAT \u05d4\u05de\u05d2\u05df \u05e2\u05dc \u05d4\u05ea\u05d9\u05e0\u05d5\u05e7 \u05de\u05e4\u05e0\u05d9 \u05e1\u05d3\u05e6\u05d9\u05d4.",
          "isCorrect": false,
          "rationale": "\u05e2\u05d9\u05db\u05d5\u05d1 \u05d4-DAT \u05e8\u05dc\u05d5\u05d5\u05e0\u05d8\u05d9 \u05dc\u05e4\u05e8\u05d5\u05e4\u05d9\u05dc \u05d4\u05de\u05e2\u05d5\u05e8\u05e8 \u05d1\u05d0\u05dd, \u05d0\u05da \u05d0\u05d9\u05e0\u05d5 \u05d4\u05e1\u05d9\u05d1\u05d4 \u05dc\u05d1\u05d7\u05d9\u05e8\u05d4 \u05d1\u05d4 \u05db\u05ea\u05e8\u05d5\u05e4\u05d4 \u05d1\u05d8\u05d5\u05d7\u05d4 \u05d1\u05d4\u05e0\u05e7\u05d4 (StahlNeuro p.315)."
        },
        {
          "text": "\u05d1\u05e9\u05dc \u05d4\u05d9\u05d5\u05ea\u05d4 \u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 \u05d4\u05d9\u05d7\u05d9\u05d3\u05d4 \u05d4\u05de\u05d0\u05d5\u05e9\u05e8\u05ea \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d4-FDA \u05dc\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05d4\u05e0\u05e7\u05d4.",
          "isCorrect": false,
          "rationale": "\u05d4-FDA \u05d0\u05d9\u05e0\u05d5 \u05de\u05d0\u05e9\u05e8 \u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05d1\u05d0\u05d5\u05e4\u05df \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9 \u05dc\u05d4\u05e0\u05e7\u05d4; \u05d4\u05d1\u05d7\u05d9\u05e8\u05d4 \u05de\u05d1\u05d5\u05e1\u05e1\u05ea \u05e2\u05dc \u05e0\u05ea\u05d5\u05e0\u05d9\u05dd \u05e7\u05dc\u05d9\u05e0\u05d9\u05d9\u05dd \u05d5\u05e4\u05e8\u05de\u05e7\u05d5\u05e7\u05d9\u05e0\u05d8\u05d9\u05d9\u05dd (\u05de\u05e7\u05d5\u05e8: \u05d4\u05e7\u05e9\u05e8 \u05e8\u05d7\u05d1)."
        }
      ],
      "hint": "\u05d4\u05ea\u05de\u05e7\u05d3\u05d5 \u05d1\u05e0\u05ea\u05d5\u05e0\u05d9 \u05d4\u05de\u05e2\u05d1\u05d3\u05d4 \u05e9\u05e0\u05de\u05e6\u05d0\u05d5 \u05d1\u05d1\u05d3\u05d9\u05e7\u05d5\u05ea \u05d3\u05dd \u05e9\u05dc \u05ea\u05d9\u05e0\u05d5\u05e7\u05d5\u05ea \u05dc\u05d0\u05de\u05d4\u05d5\u05ea \u05de\u05d8\u05d5\u05e4\u05dc\u05d5\u05ea.",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05e2\u05e8\u05db\u05ea \u05e1\u05d9\u05db\u05d5\u05df-\u05ea\u05d5\u05e2\u05dc\u05ea (Risk-Benefit) \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-SSRIs \u05d1\u05e9\u05dc\u05d9\u05e9 \u05d4\u05e9\u05dc\u05d9\u05e9\u05d9 \u05dc\u05d4\u05e8\u05d9\u05d5\u05df, \u05de\u05d4\u05d5 \u05d4\u05e0\u05ea\u05d5\u05df \u05d4\u05de\u05d3\u05d5\u05d9\u05e7 \u05dc\u05d2\u05d1\u05d9 Poor Neonatal Adaptation Syndrome?",
      "answerOptions": [
        {
          "text": "\u05d4\u05ea\u05e1\u05de\u05d5\u05e0\u05ea \u05de\u05d5\u05e4\u05d9\u05e2\u05d4 \u05d1-10%-30% \u05de\u05d4\u05d9\u05dc\u05d5\u05d3\u05d9\u05dd \u05e9\u05e0\u05d7\u05e9\u05e4\u05d5, \u05d5\u05d4\u05d9\u05d0 \u05dc\u05e8\u05d5\u05d1 \u05d6\u05de\u05e0\u05d9\u05ea \u05d5\u05d7\u05d5\u05dc\u05e4\u05ea \u05de\u05e2\u05e6\u05de\u05d4 (Self-limited).",
          "isCorrect": true,
          "rationale": "\u05d6\u05d5\u05d4\u05d9 \u05ea\u05d5\u05e4\u05e2\u05d4 \u05e9\u05db\u05d9\u05d7\u05d4 \u05d9\u05d7\u05e1\u05d9\u05ea \u05d1\u05d7\u05e9\u05d9\u05e4\u05d4 \u05dc-SSRIs \u05d1\u05e1\u05d5\u05e3 \u05d4\u05d4\u05e8\u05d9\u05d5\u05df, \u05d4\u05db\u05d5\u05dc\u05dc\u05ea \u05e8\u05e2\u05d3 \u05d5\u05e2\u05e6\u05d1\u05e0\u05d5\u05ea, \u05d0\u05da \u05d1\u05d3\u05e8\u05da \u05db\u05dc\u05dc \u05d0\u05d9\u05e0\u05d4 \u05d3\u05d5\u05e8\u05e9\u05ea \u05d4\u05ea\u05e2\u05e8\u05d1\u05d5\u05ea \u05e4\u05d5\u05dc\u05e9\u05e0\u05d9\u05ea (Dulcan p.261, Dulcan p.731)."
        },
        {
          "text": "\u05d4\u05ea\u05e1\u05de\u05d5\u05e0\u05ea \u05e0\u05d3\u05d9\u05e8\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 (\u05e4\u05d7\u05d5\u05ea \u05de-1%) \u05d0\u05da \u05d2\u05d5\u05e8\u05de\u05ea \u05dc\u05e0\u05d6\u05e7 \u05e0\u05d5\u05d9\u05e8\u05d5\u05dc\u05d5\u05d2\u05d9 \u05e7\u05d1\u05d5\u05e2.",
          "isCorrect": false,
          "rationale": "\u05d4\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d2\u05d1\u05d5\u05d4\u05d4 \u05d1\u05d4\u05e8\u05d1\u05d4 \u05de-1%, \u05d5\u05d4\u05de\u05e6\u05d1 \u05d4\u05e4\u05d9\u05da \u05dc\u05d7\u05dc\u05d5\u05d8\u05d9\u05df \u05ea\u05d5\u05da \u05d9\u05de\u05d9\u05dd \u05e2\u05d3 \u05e9\u05d1\u05d5\u05e2\u05d9\u05d9\u05dd (Dulcan p.731)."
        },
        {
          "text": "\u05d4\u05ea\u05e1\u05de\u05d5\u05e0\u05ea \u05de\u05d5\u05e4\u05d9\u05e2\u05d4 \u05e8\u05e7 \u05d1\u05d7\u05e9\u05d9\u05e4\u05d4 \u05dc-Paroxetine \u05d1\u05e9\u05dc \u05de\u05d5\u05de\u05d9\u05dd \u05dc\u05d1\u05d1\u05d9\u05d9\u05dd \u05e0\u05dc\u05d5\u05d5\u05d9\u05dd.",
          "isCorrect": false,
          "rationale": "\u05d4\u05ea\u05e1\u05de\u05d5\u05e0\u05ea \u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05ea \u05d0\u05ea \u05db\u05dc \u05e7\u05d1\u05d5\u05e6\u05ea \u05d4-SSRIs, \u05d1\u05e2\u05d5\u05d3 \u05de\u05d5\u05de\u05d9\u05dd \u05dc\u05d1\u05d1\u05d9\u05d9\u05dd \u05d4\u05dd \u05e1\u05d9\u05db\u05d5\u05df \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9 \u05d9\u05d5\u05ea\u05e8 \u05d4\u05de\u05e9\u05d5\u05d9\u05da \u05dc-Paroxetine (Dulcan p.731)."
        },
        {
          "text": "\u05d4\u05ea\u05e1\u05de\u05d5\u05e0\u05ea \u05de\u05d7\u05d9\u05d9\u05d1\u05ea \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05d1\u05e0\u05d6\u05d5\u05d3\u05d9\u05d0\u05d6\u05e4\u05d9\u05e0\u05d9\u05dd \u05dc\u05d9\u05dc\u05d5\u05d3 \u05d1\u05e9\u05dc \u05ea\u05e1\u05de\u05d9\u05e0\u05d9 \u05d2\u05de\u05d9\u05dc\u05d4 \u05e7\u05e9\u05d9\u05dd.",
          "isCorrect": false,
          "rationale": "\u05d4\u05e0\u05d9\u05d4\u05d5\u05dc \u05d4\u05d5\u05d0 \u05d1\u05d3\u05e8\u05da \u05db\u05dc\u05dc \u05ea\u05d5\u05de\u05da \u05d5\u05e9\u05de\u05e8\u05e0\u05d9 \u05dc\u05dc\u05d0 \u05e6\u05d5\u05e8\u05da \u05d1\u05d8\u05d9\u05e4\u05d5\u05dc \u05ea\u05e8\u05d5\u05e4\u05ea\u05d9 \u05d1\u05d9\u05dc\u05d5\u05d3 (Dulcan p.261)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d1\u05d5 \u05e2\u05dc \u05d4\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d4\u05de\u05d3\u05d5\u05d5\u05d7\u05ea \u05d1\u05e1\u05e4\u05e8\u05d9 \u05d4\u05dc\u05d9\u05de\u05d5\u05d3 (\u05d8\u05d5\u05d5\u05d7 \u05d0\u05d7\u05d5\u05d6\u05d9\u05dd) \u05d5\u05e2\u05dc \u05d4\u05de\u05d4\u05dc\u05da \u05d4\u05d8\u05d1\u05e2\u05d9 \u05e9\u05dc \u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd.",
      "imageUrls": []
    },
    {
      "type": "short_answer",
      "question": "\u05d4\u05e1\u05d1\u05e8 \u05d0\u05ea \u05d4\u05d4\u05d1\u05d3\u05dc \u05d4\u05d0\u05d1\u05d7\u05e0\u05ea\u05d9 \u05d1\u05d9\u05df \"Maternity Blues\" \u05dc\u05d1\u05d9\u05df \u05d0\u05e4\u05d9\u05d6\u05d5\u05d3\u05d4 \u05d3\u05d9\u05db\u05d0\u05d5\u05e0\u05d9\u05ea \u05e2\u05dd \"Peripartum onset\" \u05e2\u05dc \u05e4\u05d9 \u05d4-DSM-5-TR, \u05ea\u05d5\u05da \u05d4\u05ea\u05d9\u05d9\u05d7\u05e1\u05d5\u05ea \u05dc\u05de\u05e9\u05da \u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d5\u05d4\u05e9\u05e4\u05e2\u05d4 \u05e2\u05dc \u05d4\u05ea\u05e4\u05e7\u05d5\u05d3.",
      "grading": {
        "modelAnswer": "Maternity Blues (\u05d0\u05d5 \"Baby Blues\") \u05de\u05ea\u05d0\u05e4\u05d9\u05d9\u05df \u05d1\u05ea\u05e0\u05d5\u05d3\u05d5\u05ea \u05d1\u05de\u05e6\u05d1 \u05d4\u05e8\u05d5\u05d7, \u05d1\u05db\u05d9 \u05d5\u05d7\u05e8\u05d3\u05d4 \u05d4\u05de\u05d5\u05e4\u05d9\u05e2\u05d9\u05dd \u05d1\u05d9\u05de\u05d9\u05dd \u05d4\u05e8\u05d0\u05e9\u05d5\u05e0\u05d9\u05dd \u05dc\u05d0\u05d7\u05e8 \u05d4\u05dc\u05d9\u05d3\u05d4, \u05d7\u05d5\u05dc\u05e4\u05d9\u05dd \u05d1\u05d3\u05e8\u05da \u05db\u05dc\u05dc \u05ea\u05d5\u05da \u05e9\u05d1\u05d5\u05e2 \u05d5\u05d0\u05d9\u05e0\u05dd \u05d2\u05d5\u05e8\u05de\u05d9\u05dd \u05dc\u05e4\u05d2\u05d9\u05e2\u05d4 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05d1\u05ea\u05e4\u05e7\u05d5\u05d3. \u05dc\u05e2\u05d5\u05de\u05ea \u05d6\u05d0\u05ea, Major Depressive Episode \u05d3\u05d5\u05e8\u05e9 \u05e7\u05d9\u05d5\u05dd \u05e9\u05dc \u05dc\u05e4\u05d7\u05d5\u05ea 5 \u05de\u05ea\u05d5\u05da 9 \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05dc\u05de\u05e9\u05da \u05e9\u05d1\u05d5\u05e2\u05d9\u05d9\u05dd \u05dc\u05e4\u05d7\u05d5\u05ea, \u05d2\u05d5\u05e8\u05dd \u05dc\u05de\u05e6\u05d5\u05e7\u05d4 \u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05d0\u05d5 \u05e4\u05d2\u05d9\u05e2\u05d4 \u05ea\u05e4\u05e7\u05d5\u05d3\u05d9\u05ea \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea, \u05d5\u05d0\u05d9\u05e0\u05d5 \u05e0\u05d7\u05e9\u05d1 \u05dc\u05d7\u05dc\u05e7 \u05e0\u05d5\u05e8\u05de\u05d8\u05d9\u05d1\u05d9 \u05de\u05d4\u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd \u05d4\u05e4\u05d9\u05d6\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05d9\u05dd \u05dc\u05d0\u05d7\u05e8 \u05d4\u05dc\u05d9\u05d3\u05d4 (DSM p.174, DSM p.213).",
        "rationale": "\u05d4\u05d4\u05d1\u05d3\u05dc\u05d4 \u05e7\u05e8\u05d9\u05d8\u05d9\u05ea \u05db\u05d3\u05d9 \u05dc\u05de\u05e0\u05d5\u05e2 \u05d0\u05d1\u05d7\u05e0\u05ea \u05d9\u05ea\u05e8 \u05e9\u05dc \u05de\u05e6\u05d1 \u05e0\u05d5\u05e8\u05de\u05d8\u05d9\u05d1\u05d9 \u05d5\u05d7\u05d5\u05dc\u05e3 \u05d0\u05dc \u05de\u05d5\u05dc \u05d6\u05d9\u05d4\u05d5\u05d9 \u05e9\u05dc \u05d4\u05e4\u05e8\u05e2\u05d4 \u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05d4\u05de\u05d7\u05d9\u05d9\u05d1\u05ea \u05d8\u05d9\u05e4\u05d5\u05dc.",
        "requiredAttributes": [
          "\u05e6\u05d9\u05d9\u05df \u05e9-Maternity Blues \u05d4\u05d5\u05d0 \u05de\u05e6\u05d1 \u05e0\u05d5\u05e8\u05de\u05d8\u05d9\u05d1\u05d9/\u05d7\u05d5\u05dc\u05e3 (Self-limited).",
          "\u05e6\u05d9\u05d9\u05df \u05e9\u05de\u05e9\u05da \u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d1-Blues \u05d4\u05d5\u05d0 \u05e7\u05e6\u05e8 (\u05e2\u05d3 \u05e9\u05d1\u05d5\u05e2/\u05d9\u05de\u05d9\u05dd \u05d1\u05d5\u05d3\u05d3\u05d9\u05dd).",
          "\u05d4\u05d3\u05d2\u05d9\u05e9 \u05e9\u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05e7\u05dc\u05d9\u05e0\u05d9 \u05d3\u05d5\u05e8\u05e9 \u05de\u05e9\u05da \u05e9\u05dc \u05e9\u05d1\u05d5\u05e2\u05d9\u05d9\u05dd \u05dc\u05e4\u05d7\u05d5\u05ea \u05d5\u05d2\u05d5\u05e8\u05dd \u05dc\u05e4\u05d2\u05d9\u05e2\u05d4 \u05ea\u05e4\u05e7\u05d5\u05d3\u05d5\u05ea (Functional impairment)."
        ],
        "errors": {
