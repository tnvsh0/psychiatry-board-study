          ],
          "bluffs": [
            "\u05d0\u05de\u05d9\u05e8\u05d4 \u05db\u05dc\u05dc\u05d9\u05ea \u05e9\u05e6\u05e8\u05d9\u05da \u05dc\u05d4\u05ea\u05e8\u05d2\u05dc \u05dc\u05ea\u05e8\u05d5\u05e4\u05d4 \u05d1\u05dc\u05d9 \u05dc\u05e6\u05d9\u05d9\u05df \u05e1\u05d9\u05db\u05d5\u05e0\u05d9\u05dd \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05d9\u05dd."
          ]
