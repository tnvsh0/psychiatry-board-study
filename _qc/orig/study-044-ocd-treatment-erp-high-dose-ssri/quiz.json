    },
    {
      "type": "multiple_choice",
      "question": "\u05d9\u05dc\u05d3\u05d4 \u05d1\u05ea 7 \u05de\u05d5\u05d1\u05d0\u05ea \u05d1\u05e9\u05dc \u05d4\u05d5\u05e4\u05e2\u05d4 \u05e4\u05ea\u05d0\u05d5\u05de\u05d9\u05ea \u05d5\u05d3\u05e8\u05de\u05d8\u05d9\u05ea ('Overnight') \u05e9\u05dc \u05d0\u05d5\u05d1\u05e1\u05e1\u05d9\u05d5\u05ea \u05d6\u05d9\u05d4\u05d5\u05dd, \u05d8\u05d9\u05e7\u05d9\u05dd \u05de\u05d5\u05d8\u05d5\u05e8\u05d9\u05d9\u05dd \u05e7\u05e9\u05d9\u05dd \u05d5\u05d7\u05e8\u05d3\u05ea \u05e4\u05e8\u05d9\u05d3\u05d4 \u05e7\u05d9\u05e6\u05d5\u05e0\u05d9\u05ea \u05dc\u05d0\u05d7\u05e8 \u05d3\u05dc\u05e7\u05ea \u05d2\u05e8\u05d5\u05df. \u05d0\u05d9\u05d6\u05d4 \u05de\u05e6\u05d1 \u05e7\u05dc\u05d9\u05e0\u05d9 \u05d9\u05e9 \u05dc\u05e9\u05e7\u05d5\u05dc \u05d1\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05de\u05d1\u05d3\u05dc\u05ea, \u05dc\u05de\u05e8\u05d5\u05ea \u05e9\u05d0\u05d9\u05e0\u05d5 \u05e0\u05db\u05dc\u05dc \u05db\u05e8\u05d2\u05e2 \u05d1-DSM-5?",
      "answerOptions": [
        {
          "text": "PANDAS (Pediatric Autoimmune Neuropsychiatric Disorders Associated with Streptococcal Infections).",
          "isCorrect": true,
          "rationale": "\u05dc\u05e4\u05d9 (Dulcan p. 372), PANDAS \u05de\u05d0\u05d5\u05e4\u05d9\u05d9\u05df \u05d1\u05d4\u05d5\u05e4\u05e2\u05d4 \u05d7\u05e8\u05d9\u05e4\u05d4 (Abrupt onset) \u05e9\u05dc OCD \u05d0\u05d5 \u05d8\u05d9\u05e7\u05d9\u05dd \u05d4\u05e7\u05e9\u05d5\u05e8\u05d9\u05dd \u05dc\u05d6\u05d9\u05d4\u05d5\u05dd \u05e1\u05d8\u05e8\u05e4\u05d8\u05d5\u05e7\u05d5\u05e7\u05dc\u05d9, \u05d0\u05dd \u05db\u05d9 \u05d0\u05d9\u05e0\u05d5 \u05d0\u05d1\u05d7\u05e0\u05d4 \u05e8\u05e9\u05de\u05d9\u05ea \u05d1-DSM."
        },
        {
          "text": "Early-onset Schizophrenia.",
          "isCorrect": false,
          "rationale": "\u05e1\u05db\u05d9\u05d6\u05d5\u05e4\u05e8\u05e0\u05d9\u05d4 \u05de\u05ea\u05d0\u05e4\u05d9\u05d9\u05e0\u05ea \u05d1\u05d3\u05e8\u05da \u05db\u05dc\u05dc \u05d1\u05d4\u05d5\u05e4\u05e2\u05d4 \u05d4\u05d3\u05e8\u05d2\u05ea\u05d9\u05ea \u05d9\u05d5\u05ea\u05e8 \u05d5\u05d1\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9\u05d9\u05dd \u05d1\u05e8\u05d5\u05e8\u05d9\u05dd, \u05dc\u05d0 \u05e8\u05e7 \u05d1-OCD \u05d5\u05d8\u05d9\u05e7\u05d9\u05dd (\u05de\u05e7\u05d5\u05e8: Dulcan p. 434)."
        },
        {
          "text": "Tourette's Disorder.",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05e9\u05d9\u05e9 \u05d8\u05d9\u05e7\u05d9\u05dd, \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d3\u05d5\u05e8\u05e9\u05ea \u05de\u05e9\u05da \u05e9\u05dc \u05e9\u05e0\u05d4 \u05dc\u05e4\u05d7\u05d5\u05ea \u05d5\u05d4\u05d5\u05e4\u05e2\u05d4 \u05e4\u05ea\u05d0\u05d5\u05de\u05d9\u05ea \u05db\u05d6\u05d5 \u05de\u05e8\u05de\u05d6\u05ea \u05e2\u05dc \u05d0\u05d8\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05d4 \u05d0\u05d7\u05e8\u05ea (\u05de\u05e7\u05d5\u05e8: DSM p. 93)."
        },
        {
          "text": "Separation Anxiety Disorder \u05d1\u05dc\u05d1\u05d3.",
          "isCorrect": false,
