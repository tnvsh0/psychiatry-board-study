    {
      "type": "short_answer",
      "question": "\u05de\u05d3\u05d5\u05e2 \u05e9\u05d9\u05dc\u05d5\u05d1 \u05e9\u05dc SSRI \u05e2\u05dd \u05d0\u05d5\u05d2\u05de\u05e0\u05d8\u05e6\u05d9\u05d4 \u05e9\u05dc Atypical Antipsychotic \u05e0\u05d7\u05e9\u05d1 \u05dc\u05d0\u05e1\u05d8\u05e8\u05d8\u05d2\u05d9\u05d4 \u05d9\u05e2\u05d9\u05dc\u05d4 \u05d1\u05de\u05e7\u05e8\u05d9\u05dd \u05e9\u05dc OCD \u05e2\u05de\u05d9\u05d3 \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd \u05d8\u05d9\u05e7\u05d9\u05dd?",
      "grading": {
        "modelAnswer": "\u05d1-OCD \u05d4\u05de\u05dc\u05d5\u05d5\u05d4 \u05d1\u05d8\u05d9\u05e7\u05d9\u05dd, \u05d9\u05e9 \u05de\u05e2\u05d5\u05e8\u05d1\u05d5\u05ea \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05e9\u05dc \u05d4\u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05d3\u05d5\u05e4\u05de\u05d9\u05e0\u05e8\u05d2\u05d9\u05ea \u05d1\u05de\u05e2\u05d2\u05dc\u05d9 \u05d4-CSTC. \u05d0\u05d5\u05d2\u05de\u05e0\u05d8\u05e6\u05d9\u05d4 \u05e2\u05dd \u05e0\u05d5\u05d2\u05d3\u05d9 \u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d4 (\u05db\u05de\u05d5 Risperidone \u05d0\u05d5 Aripiprazole) \u05d7\u05d5\u05e1\u05de\u05ea \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 $D2$, \u05de\u05d4 \u05e9\u05ea\u05d5\u05e8\u05dd \u05dc\u05d4\u05e4\u05d7\u05ea\u05ea \u05d4\u05d8\u05d9\u05e7\u05d9\u05dd \u05d5\u05dc\u05e9\u05d9\u05e4\u05d5\u05e8 \u05d4\u05e9\u05dc\u05d9\u05d8\u05d4 \u05d1\u05d3\u05d7\u05e4\u05d9\u05dd \u05d4\u05e7\u05d5\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05d9\u05dd \u05e9\u05d0\u05d9\u05e0\u05dd \u05de\u05d2\u05d9\u05d1\u05d9\u05dd \u05dc-SSRI \u05dc\u05d1\u05d3\u05d5.",
        "rationale": "\u05d4\u05e9\u05d9\u05dc\u05d5\u05d1 \u05de\u05d8\u05e4\u05dc \u05d4\u05df \u05d1\u05de\u05e1\u05dc\u05d5\u05dc \u05d4\u05e1\u05e8\u05d5\u05d8\u05d5\u05e0\u05d9\u05e0\u05e8\u05d2\u05d9 (\u05d3\u05e8\u05da \u05d4-SSRI) \u05d5\u05d4\u05df \u05d1\u05de\u05e1\u05dc\u05d5\u05dc \u05d4\u05d3\u05d5\u05e4\u05de\u05d9\u05e0\u05e8\u05d2\u05d9 (\u05d3\u05e8\u05da \u05d4\u05d0\u05e0\u05d8\u05d9-\u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9), \u05d3\u05d1\u05e8 \u05d4\u05d7\u05d9\u05d5\u05e0\u05d9 \u05d1\u05e4\u05e0\u05d5\u05d8\u05d9\u05e4 \u05d4\u05de\u05dc\u05d5\u05d5\u05d4 \u05d1\u05d8\u05d9\u05e7\u05d9\u05dd.",
        "requiredAttributes": [
          "\u05e6\u05d9\u05d5\u05df \u05d4\u05de\u05e2\u05d5\u05e8\u05d1\u05d5\u05ea \u05e9\u05dc \u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05d3\u05d5\u05e4\u05de\u05d9\u05df \u05d0\u05d5 \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 D2.",
          "\u05d4\u05ea\u05d9\u05d9\u05d7\u05e1\u05d5\u05ea \u05dc\u05e9\u05d9\u05e4\u05d5\u05e8 \u05d1\u05d8\u05d9\u05e7\u05d9\u05dd \u05d0\u05d5 \u05d1\u05e9\u05dc\u05d9\u05d8\u05d4 \u05e2\u05dc \u05d3\u05d7\u05e4\u05d9\u05dd/\u05e7\u05d5\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d5\u05ea.",
          "\u05d4\u05d1\u05e0\u05d4 \u05e9\u05d4-SSRI \u05dc\u05d1\u05d3\u05d5 \u05e4\u05d5\u05e2\u05dc \u05d1\u05e2\u05d9\u05e7\u05e8 \u05e2\u05dc \u05e1\u05e8\u05d5\u05d8\u05d5\u05e0\u05d9\u05df \u05d5\u05d0\u05d9\u05e0\u05d5 \u05de\u05e1\u05e4\u05e7 \u05d1\u05de\u05e7\u05e8\u05d9\u05dd \u05d0\u05dc\u05d5."
