      "answerOptions": [
        {
          "text": "\u05d4\u05e4\u05e8\u05d3\u05ea \u05d4-OCD \u05de\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d9\u05ea \u05d4-Anxiety Disorders \u05dc\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4 \u05e2\u05e6\u05de\u05d0\u05d9\u05ea \u05e9\u05dc Obsessive-Compulsive and Related Disorders.",
          "isCorrect": true,
          "rationale": "\u05e9\u05d9\u05e0\u05d5\u05d9 \u05d6\u05d4 \u05de\u05e9\u05e7\u05e3 \u05d0\u05ea \u05d4\u05d4\u05d1\u05e0\u05d4 \u05e9-OCD \u05de\u05d5\u05e0\u05e2 \u05dc\u05e2\u05d9\u05ea\u05d9\u05dd \u05e2\u05dc \u05d9\u05d3\u05d9 \u05e8\u05d2\u05e9\u05d5\u05ea \u05d0\u05d7\u05e8\u05d9\u05dd \u05de\u05dc\u05d1\u05d3 \u05d7\u05e8\u05d3\u05d4 (\u05de\u05e7\u05d5\u05e8: DSM p. 263, Dulcan p. 367)."
        },
        {
          "text": "\u05d4\u05d5\u05e1\u05e4\u05ea specifier \u05e9\u05dc 'Tic-related' \u05dc\u05d0\u05d1\u05d7\u05e0\u05ea OCD.",
          "isCorrect": true,
          "rationale": "\u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05d9\u05e8 \u05d6\u05d4 \u05e0\u05d5\u05e1\u05e3 \u05d1\u05e9\u05dc \u05d4\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d4\u05d2\u05d1\u05d5\u05d4\u05d4 \u05e9\u05dc \u05e7\u05d5\u05de\u05d5\u05e8\u05d1\u05d9\u05d3\u05d9\u05d5\u05ea \u05e2\u05dd \u05d8\u05d9\u05e7\u05d9\u05dd \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d5\u05d4\u05d4\u05d1\u05d3\u05dc\u05d9\u05dd \u05d1\u05e4\u05e0\u05d5\u05d8\u05d9\u05e4 (\u05de\u05e7\u05d5\u05e8: DSM p. 265, Dulcan p. 367)."
        },
        {
          "text": "\u05d4\u05db\u05e8\u05d4 \u05d1\u05db\u05da \u05e9\u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05e9\u05d5\u05d9\u05d9\u05dd \u05dc\u05d4\u05e4\u05d2\u05d9\u05df 'Poor insight' \u05dc\u05d2\u05d1\u05d9 \u05d7\u05d5\u05e1\u05e8 \u05d4\u05d4\u05d9\u05d2\u05d9\u05d5\u05df \u05e9\u05d1\u05d8\u05e7\u05e1\u05d9\u05dd \u05e9\u05dc\u05d4\u05dd.",
          "isCorrect": true,
          "rationale": "\u05d1\u05e0\u05d9\u05d2\u05d5\u05d3 \u05dc\u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd, \u05d9\u05dc\u05d3\u05d9\u05dd \u05dc\u05e2\u05d9\u05ea\u05d9\u05dd \u05e7\u05e8\u05d5\u05d1\u05d5\u05ea \u05d0\u05d9\u05e0\u05dd \u05de\u05e1\u05d5\u05d2\u05dc\u05d9\u05dd \u05dc\u05d4\u05e1\u05d1\u05d9\u05e8 \u05d0\u05ea \u05d4\u05d0\u05d5\u05e4\u05d9 \u05d4\u05dc\u05d0 \u05e8\u05e6\u05d9\u05d5\u05e0\u05dc\u05d9 \u05e9\u05dc \u05e4\u05e2\u05d5\u05dc\u05d5\u05ea\u05d9\u05d4\u05dd (\u05de\u05e7\u05d5\u05e8: Dulcan p. 367)."
        },
        {
