{
  "title": "OCD Quiz",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\u05d1\u05df 10 \u05de\u05d5\u05e4\u05e0\u05d4 \u05dc\u05d4\u05e2\u05e8\u05db\u05d4 \u05d1\u05e9\u05dc \u05d8\u05e7\u05e1\u05d9 \u05e8\u05d7\u05e6\u05d4 \u05d4\u05e0\u05de\u05e9\u05db\u05d9\u05dd \u05db\u05e9\u05e2\u05ea\u05d9\u05d9\u05dd \u05d1\u05db\u05dc \u05e2\u05e8\u05d1 \u05d5\u05e4\u05d7\u05d3 \u05d0\u05d9\u05e0\u05d8\u05e0\u05e1\u05d9\u05d1\u05d9 \u05de\u05d6\u05d9\u05d4\u05d5\u05de\u05d9\u05dd. \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05d9\u05d0 OCD \u05d1\u05d3\u05e8\u05d2\u05ea \u05d7\u05d5\u05de\u05e8\u05d4 \u05d1\u05d9\u05e0\u05d5\u05e0\u05d9\u05ea. \u05dc\u05e4\u05d9 \u05d4-AACAP Practice Parameters \u05d5\u05d4\u05de\u05d7\u05e7\u05e8\u05d9\u05dd \u05d4\u05e2\u05d3\u05db\u05e0\u05d9\u05d9\u05dd, \u05de\u05d4\u05d9 \u05d4\u05d4\u05de\u05dc\u05e6\u05d4 \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc\u05d9\u05ea \u05d4\u05e8\u05d0\u05e9\u05d5\u05e0\u05d4 (First-line) \u05e2\u05d1\u05d5\u05e8\u05d5?",
      "answerOptions": [
        {
          "text": "\u05d8\u05d9\u05e4\u05d5\u05dc \u05e4\u05e1\u05d9\u05db\u05d5\u05ea\u05e8\u05e4\u05d9 \u05de\u05e1\u05d5\u05d2 CBT \u05d4\u05de\u05d1\u05d5\u05e1\u05e1 \u05e2\u05dc ERP \u05d1\u05dc\u05d1\u05d3.",
          "isCorrect": true,
          "rationale": "\u05dc\u05e4\u05d9 (Dulcan p. 378), \u05d4-CBT \u05d4\u05d5\u05d0 \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05e7\u05d5 \u05e8\u05d0\u05e9\u05d5\u05df \u05dc-OCD \u05d1\u05d3\u05e8\u05d2\u05ea \u05d7\u05d5\u05de\u05e8\u05d4 \u05e7\u05dc\u05d4 \u05e2\u05d3 \u05d1\u05d9\u05e0\u05d5\u05e0\u05d9\u05ea \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd, \u05dc\u05dc\u05d0 \u05e7\u05e9\u05e8 \u05dc\u05d7\u05d5\u05de\u05e8\u05ea \u05d4\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05d4\u05d4\u05ea\u05d7\u05dc\u05ea\u05d9\u05ea."
        },
        {
          "text": "\u05d8\u05d9\u05e4\u05d5\u05dc \u05ea\u05e8\u05d5\u05e4\u05ea\u05d9 \u05d1-SSRI \u05d1\u05dc\u05d1\u05d3 (\u05db\u05d2\u05d5\u05df Fluoxetine).",
          "isCorrect": false,
          "rationale": "\u05d8\u05d9\u05e4\u05d5\u05dc \u05ea\u05e8\u05d5\u05e4\u05ea\u05d9 \u05dc\u05d1\u05d3\u05d5 \u05e0\u05d7\u05e9\u05d1 \u05e4\u05d7\u05d5\u05ea \u05d9\u05e2\u05d9\u05dc \u05de-CBT \u05d0\u05d5 \u05de\u05e9\u05d9\u05dc\u05d5\u05d1 \u05e9\u05dc \u05d4\u05e9\u05e0\u05d9\u05d9\u05dd, \u05d5\u05e9\u05de\u05d5\u05e8 \u05dc\u05de\u05e7\u05e8\u05d9\u05dd \u05e7\u05e9\u05d9\u05dd \u05d0\u05d5 \u05db\u05e9\u05d0\u05d9\u05df \u05e0\u05d2\u05d9\u05e9\u05d5\u05ea \u05dc-CBT (\u05de\u05e7\u05d5\u05e8: Dulcan p. 377)."
        },
        {
          "text": "\u05e9\u05d9\u05dc\u05d5\u05d1 \u05e9\u05dc SSRI \u05d5-Clomipramine \u05de\u05d4\u05d4\u05ea\u05d7\u05dc\u05d4 \u05dc\u05de\u05e7\u05e1\u05d5\u05dd \u05ea\u05d2\u05d5\u05d1\u05d4.",
          "isCorrect": false,
          "rationale": "\u05d4\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1-Clomipramine \u05e0\u05d7\u05e9\u05d1 \u05dc\u05e7\u05d5 \u05e9\u05e0\u05d9 \u05d1\u05e9\u05dc \u05e4\u05e8\u05d5\u05e4\u05d9\u05dc \u05ea\u05d5\u05e4\u05e2\u05d5\u05ea \u05d4\u05dc\u05d5\u05d5\u05d0\u05d9, \u05d5\u05e9\u05d9\u05dc\u05d5\u05d1 \u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05d0\u05d9\u05e0\u05d5 \u05de\u05d5\u05de\u05dc\u05e5 \u05db\u05e7\u05d5 \u05e8\u05d0\u05e9\u05d5\u05df (\u05de\u05e7\u05d5\u05e8: StahlKids p. 110)."
        },
        {
          "text": "\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Atypical Antipsychotic \u05db\u05d2\u05d5\u05df Risperidone.",
          "isCorrect": false,
          "rationale": "\u05e0\u05d5\u05d2\u05d3\u05d9 \u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d4 \u05de\u05e9\u05de\u05e9\u05d9\u05dd \u05db-Augmentation \u05d1\u05dc\u05d1\u05d3 \u05d1\u05de\u05e7\u05e8\u05d9\u05dd \u05e2\u05de\u05d9\u05d3\u05d9\u05dd, \u05d5\u05dc\u05d0 \u05db\u05d8\u05d9\u05e4\u05d5\u05dc \u05e8\u05d0\u05e9\u05d5\u05e0\u05d9 \u05d1-OCD (\u05de\u05e7\u05d5\u05e8: StahlKids p. 402)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05d2\u05d9\u05e9\u05d4 \u05d4\u05de\u05d3\u05d5\u05e8\u05d2\u05ea \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd \u05d7\u05d5\u05de\u05e8\u05d4 \u05e9\u05d0\u05d9\u05e0\u05d4 \u05e7\u05d9\u05e6\u05d5\u05e0\u05d9\u05ea."
    },
    {
      "type": "multiple_choice",
      "question": "\u05de\u05ea\u05d1\u05d2\u05e8\u05ea \u05d1\u05ea 15 \u05e2\u05dd OCD \u05de\u05d8\u05d5\u05e4\u05dc\u05ea \u05d1-Sertraline \u05d1\u05de\u05d9\u05e0\u05d5\u05df $50\\text{ mg/day}$ \u05de\u05d6\u05d4 4 \u05e9\u05d1\u05d5\u05e2\u05d5\u05ea. \u05d4\u05d9\u05d0 \u05de\u05d3\u05d5\u05d5\u05d7\u05ea \u05db\u05d9 '\u05d0\u05d9\u05df \u05e9\u05d5\u05dd \u05e9\u05d9\u05e0\u05d5\u05d9' \u05d5\u05d4\u05d4\u05d5\u05e8\u05d9\u05dd \u05dc\u05d7\u05d5\u05e6\u05d9\u05dd \u05dc\u05d4\u05d7\u05dc\u05d9\u05e3 \u05d8\u05d9\u05e4\u05d5\u05dc. \u05de\u05d4\u05d9 \u05d4\u05e4\u05e2\u05d5\u05dc\u05d4 \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05d4\u05e0\u05db\u05d5\u05e0\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05e4\u05d9 \u05d4-StahlKids \u05d5\u05d4-Dulcan?",
      "answerOptions": [
        {
          "text": "\u05d4\u05e2\u05dc\u05d0\u05ea \u05d4\u05de\u05d9\u05e0\u05d5\u05df \u05d1\u05d4\u05d3\u05e8\u05d2\u05d4 \u05dc\u05db\u05d9\u05d5\u05d5\u05df \u05d4\u05d8\u05d5\u05d5\u05d7 \u05d4\u05d2\u05d1\u05d5\u05d4 ($200\\text{ mg/day}$) \u05d5\u05d4\u05de\u05ea\u05e0\u05d4 \u05e9\u05dc 8-12 \u05e9\u05d1\u05d5\u05e2\u05d5\u05ea \u05dc\u05d4\u05e2\u05e8\u05db\u05ea \u05ea\u05d2\u05d5\u05d1\u05d4 \u05de\u05dc\u05d0\u05d4.",
          "isCorrect": true,
          "rationale": "\u05d1-OCD \u05e0\u05d3\u05e8\u05e9\u05d9\u05dd \u05de\u05d9\u05e0\u05d5\u05e0\u05d9\u05dd \u05d2\u05d1\u05d5\u05d4\u05d9\u05dd \u05d9\u05d5\u05ea\u05e8 \u05de\u05d0\u05e9\u05e8 \u05d1-MDD \u05d5\u05ea\u05e7\u05d5\u05e4\u05ea \u05d4\u05de\u05ea\u05e0\u05d4 \u05d0\u05e8\u05d5\u05db\u05d4 \u05d9\u05d5\u05ea\u05e8 \u05e9\u05dc \u05e2\u05d3 12 \u05e9\u05d1\u05d5\u05e2\u05d5\u05ea \u05dc\u05d4\u05e9\u05d2\u05ea \u05d0\u05e4\u05e7\u05d8 \u05d8\u05d9\u05e4\u05d5\u05dc\u05d9 \u05de\u05dc\u05d0 (\u05de\u05e7\u05d5\u05e8: StahlKids p. 427, Dulcan p. 380)."
        },
        {
          "text": "\u05d4\u05d7\u05dc\u05e4\u05d4 \u05de\u05d9\u05d9\u05d3\u05d9\u05ea \u05dc-Fluoxetine \u05d1\u05e9\u05dc \u05d7\u05d5\u05e1\u05e8 \u05ea\u05d2\u05d5\u05d1\u05d4 \u05e8\u05d0\u05e9\u05d5\u05e0\u05d9\u05ea.",
          "isCorrect": false,
          "rationale": "\u05d0\u05e8\u05d1\u05e2\u05d4 \u05e9\u05d1\u05d5\u05e2\u05d5\u05ea \u05d1\u05de\u05d9\u05e0\u05d5\u05df \u05e0\u05de\u05d5\u05da \u05d0\u05d9\u05e0\u05dd \u05de\u05d4\u05d5\u05d5\u05d9\u05dd trial \u05de\u05e1\u05e4\u05e7 \u05dc\u05d4\u05e2\u05e8\u05db\u05ea \u05e2\u05de\u05d9\u05d3\u05d5\u05ea \u05d1-OCD (\u05de\u05e7\u05d5\u05e8: Dulcan p. 382)."
        },
        {
          "text": "\u05d4\u05d5\u05e1\u05e4\u05ea Clomipramine \u05d1\u05de\u05d9\u05e0\u05d5\u05df \u05e0\u05de\u05d5\u05da \u05db-Augmentation.",
          "isCorrect": false,
          "rationale": "\u05d0\u05d5\u05d2\u05de\u05e0\u05d8\u05e6\u05d9\u05d4 \u05e0\u05e9\u05e7\u05dc\u05ea \u05e8\u05e7 \u05dc\u05d0\u05d7\u05e8 \u05db\u05d9\u05e9\u05dc\u05d5\u05df \u05e9\u05dc \u05dc\u05e4\u05d7\u05d5\u05ea \u05e9\u05e0\u05d9 \u05e1\u05d1\u05d1\u05d9 SSRI \u05d1\u05de\u05d9\u05e0\u05d5\u05df \u05de\u05e7\u05e1\u05d9\u05de\u05dc\u05d9 (\u05de\u05e7\u05d5\u05e8: Dulcan p. 382)."
        },
        {
          "text": "\u05d4\u05e4\u05e1\u05e7\u05ea \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05ea\u05e8\u05d5\u05e4\u05ea\u05d9 \u05d5\u05d4\u05ea\u05de\u05e7\u05d3\u05d5\u05ea \u05d1-Insight-oriented psychotherapy.",
          "isCorrect": false,
          "rationale": "\u05d8\u05d9\u05e4\u05d5\u05dc \u05d3\u05d9\u05e0\u05de\u05d9/\u05ea\u05d5\u05d1\u05e0\u05ea\u05d9 \u05e0\u05de\u05e6\u05d0 \u05db\u05de\u05d0\u05db\u05d6\u05d1 \u05d1\u05ea\u05d5\u05e6\u05d0\u05d5\u05ea\u05d9\u05d5 \u05e2\u05d1\u05d5\u05e8 OCD \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d5\u05e0\u05d5\u05e2\u05e8 (\u05de\u05e7\u05d5\u05e8: Dulcan p. 379)."
        }
      ],
      "hint": "\u05d6\u05db\u05d5\u05e8 \u05d0\u05ea \u05d4\u05d4\u05d1\u05d3\u05dc \u05d1\u05d9\u05df \u05e4\u05e8\u05d5\u05d8\u05d5\u05e7\u05d5\u05dc \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-OCD \u05dc\u05d1\u05d9\u05df \u05d6\u05d4 \u05e9\u05dc MDD \u05de\u05d1\u05d7\u05d9\u05e0\u05ea \u05d6\u05de\u05df \u05d5\u05de\u05d9\u05e0\u05d5\u05df."
    },
    {
      "type": "multiple_choice",
      "question": "\u05d1\u05d8\u05d9\u05e4\u05d5\u05dc \u05e4\u05e1\u05d9\u05db\u05d5\u05ea\u05e8\u05e4\u05d9 \u05de\u05e1\u05d5\u05d2 ERP (Exposure and Response Prevention), \u05de\u05d4\u05d5 \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9 \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05d4\u05de\u05d1\u05d9\u05d0 \u05dc\u05d9\u05e8\u05d9\u05d3\u05d4 \u05d1\u05d7\u05e8\u05d3\u05d4 \u05d5\u05d1\u05d3\u05d7\u05e3 \u05dc\u05d1\u05e6\u05e2 \u05d8\u05e7\u05e1\u05d9\u05dd?",
      "answerOptions": [
        {
          "text": "Habituation (\u05d4\u05ea\u05e8\u05d2\u05dc\u05d5\u05ea) \u05dc\u05d2\u05d9\u05e8\u05d5\u05d9 \u05d4\u05de\u05e4\u05d7\u05d9\u05d3 \u05d3\u05e8\u05da \u05d7\u05e9\u05d9\u05e4\u05d4 \u05de\u05de\u05d5\u05e9\u05db\u05ea \u05dc\u05dc\u05d0 \u05d1\u05d9\u05e6\u05d5\u05e2 \u05d4\u05d8\u05e7\u05e1.",
          "isCorrect": true,
          "rationale": "\u05d4\u05de\u05d8\u05e8\u05d4 \u05d1-ERP \u05d4\u05d9\u05d0 \u05d7\u05e9\u05d9\u05e4\u05d4 \u05dc\u05d2\u05d9\u05e8\u05d5\u05d9 \u05d4\u05de\u05e2\u05d5\u05e8\u05e8 \u05d0\u05d5\u05d1\u05e1\u05e1\u05d9\u05d4 \u05d5\u05de\u05e0\u05d9\u05e2\u05ea \u05d4\u05d8\u05e7\u05e1 (Response Prevention), \u05de\u05d4 \u05e9\u05de\u05d5\u05d1\u05d9\u05dc \u05dc\u05d4\u05db\u05d7\u05d3\u05d4 \u05e9\u05dc \u05d4\u05d7\u05e8\u05d3\u05d4 (Habituation) (\u05de\u05e7\u05d5\u05e8: Dulcan p. 378)."
        },
        {
          "text": "\u05d4\u05d1\u05e0\u05ea \u05d4\u05de\u05e7\u05d5\u05e8 \u05d4\u05d3\u05d9\u05e0\u05de\u05d9 \u05e9\u05dc \u05d4\u05e7\u05d5\u05e0\u05e4\u05dc\u05d9\u05e7\u05d8 \u05e9\u05d4\u05d5\u05d1\u05d9\u05dc \u05dc\u05d0\u05d5\u05d1\u05e1\u05e1\u05d9\u05d4.",
          "isCorrect": false,
          "rationale": "ERP \u05de\u05ea\u05de\u05e7\u05d3 \u05d1\u05e9\u05d9\u05e0\u05d5\u05d9 \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea\u05d9 \u05d5\u05e0\u05d5\u05d9\u05e8\u05d5\u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d5\u05dc\u05d0 \u05d1\u05e0\u05d9\u05ea\u05d5\u05d7 \u05e7\u05d5\u05e0\u05e4\u05dc\u05d9\u05e7\u05d8\u05d9\u05dd \u05dc\u05d0 \u05de\u05d5\u05d3\u05e2\u05d9\u05dd (\u05de\u05e7\u05d5\u05e8: StahlNeuro p. 576)."
        },
        {
          "text": "\u05d4\u05e1\u05d7\u05ea \u05d3\u05e2\u05ea \u05d0\u05e7\u05d8\u05d9\u05d1\u05d9\u05ea \u05d1\u05e8\u05d2\u05e2 \u05e9\u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05d7\u05d5\u05d5\u05d4 \u05d0\u05d5\u05d1\u05e1\u05e1\u05d9\u05d4.",
          "isCorrect": false,
          "rationale": "\u05d4\u05e1\u05d7\u05ea \u05d3\u05e2\u05ea \u05e2\u05dc\u05d5\u05dc\u05d4 \u05dc\u05d4\u05d5\u05d5\u05ea \u05e1\u05d5\u05d2 \u05e9\u05dc \u05d4\u05d9\u05de\u05e0\u05e2\u05d5\u05ea \u05d5\u05dc\u05de\u05e0\u05d5\u05e2 \u05d0\u05ea \u05ea\u05d4\u05dc\u05d9\u05da \u05d4-Habituation \u05d4\u05e0\u05d3\u05e8\u05e9 \u05d1-ERP (\u05de\u05e7\u05d5\u05e8: Dulcan p. 378)."
        },
        {
          "text": "\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05d8\u05db\u05e0\u05d9\u05e7\u05d5\u05ea \u05d4\u05e8\u05e4\u05d9\u05d4 (Relaxation) \u05d1\u05d6\u05de\u05df \u05d4\u05d7\u05e9\u05d9\u05e4\u05d4 \u05dc\u05d2\u05d9\u05e8\u05d5\u05d9.",
          "isCorrect": false,
