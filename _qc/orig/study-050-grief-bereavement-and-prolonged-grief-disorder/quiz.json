{
  "title": "Grief Quiz",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\u05e0\u05e2\u05e8 \u05d1\u05df 15 \u05de\u05d5\u05e4\u05e0\u05d4 \u05dc\u05d4\u05e2\u05e8\u05db\u05d4 8 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05dc\u05d0\u05d7\u05e8 \u05de\u05d5\u05ea\u05d4 \u05d4\u05e4\u05ea\u05d0\u05d5\u05de\u05d9 \u05e9\u05dc \u05d0\u05de\u05d5. \u05d4\u05d5\u05d0 \u05de\u05ea\u05d0\u05e8 \u05d2\u05e2\u05d2\u05d5\u05e2 \u05e2\u05de\u05d5\u05e7 \u05d5\u05d1\u05dc\u05ea\u05d9 \u05e4\u05d5\u05e1\u05e7 (yearning) \u05d4\u05de\u05d5\u05e4\u05d9\u05e2 \u05db\u05de\u05e2\u05d8 \u05db\u05dc \u05d9\u05d5\u05dd, \u05d5\u05de\u05ea\u05e7\u05e9\u05d4 \u05dc\u05d4\u05d0\u05de\u05d9\u05df \u05e9\u05d4\u05d9\u05d0 \u05d0\u05d9\u05e0\u05e0\u05d4. \u05d4\u05d5\u05d0 \u05de\u05d3\u05d5\u05d5\u05d7 \u05e2\u05dc \u05ea\u05d7\u05d5\u05e9\u05d4 \u05e9\u05d7\u05dc\u05e7 \u05de\u05de\u05e0\u05d5 \u05de\u05ea \u05d9\u05d7\u05d3 \u05d0\u05d9\u05ea\u05d4 \u05d5\u05de\u05ea\u05e7\u05e9\u05d4 \u05dc\u05ea\u05db\u05e0\u05df \u05d0\u05ea \u05e2\u05ea\u05d9\u05d3\u05d5. \u05d1\u05d1\u05d3\u05d9\u05e7\u05ea\u05d5, \u05de\u05e6\u05d1 \u05d4\u05e8\u05d5\u05d7 \u05d9\u05e8\u05d5\u05d3 \u05d0\u05da \u05d4\u05e2\u05e8\u05db\u05d4 \u05d4\u05e2\u05e6\u05de\u05d9\u05ea (self-esteem) \u05e0\u05e9\u05de\u05e8\u05ea \u05d1\u05e8\u05d5\u05d1\u05d4, \u05d5\u05d4\u05d5\u05d0 \u05de\u05e6\u05dc\u05d9\u05d7 \u05dc\u05d7\u05d5\u05e9 \u05d4\u05e0\u05d0\u05d4 \u05de\u05e1\u05d5\u05d9\u05de\u05ea \u05d1\u05de\u05e4\u05d2\u05e9 \u05e2\u05dd \u05d7\u05d1\u05e8\u05d9\u05dd \u05e7\u05e8\u05d5\u05d1\u05d9\u05dd. \u05de\u05d4\u05d9 \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05e1\u05d1\u05d9\u05e8\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR?",
      "answerOptions": [
        {
          "text": "Prolonged Grief Disorder (PGD)",
          "isCorrect": true,
          "rationale": "\u05d4\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05e9\u05dc \u05d2\u05e2\u05d2\u05d5\u05e2 \u05e2\u05de\u05d5\u05e7, \u05e9\u05d9\u05d1\u05d5\u05e9 \u05d1\u05d6\u05d4\u05d5\u05ea \u05d5\u05e7\u05e9\u05d9\u05d9 \u05d4\u05e1\u05ea\u05d2\u05dc\u05d5\u05ea \u05d4\u05e0\u05de\u05e9\u05db\u05d9\u05dd \u05de\u05e2\u05dc 6 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d5\u05d1\u05e0\u05d9 \u05e0\u05d5\u05e2\u05e8, \u05ea\u05d5\u05da \u05e9\u05de\u05d9\u05e8\u05d4 \u05d9\u05d7\u05e1\u05d9\u05ea \u05e2\u05dc \u05d4\u05e2\u05e8\u05db\u05d4 \u05e2\u05e6\u05de\u05d9\u05ea, \u05ea\u05d5\u05d0\u05de\u05d9\u05dd \u05d0\u05ea \u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05e9\u05dc PGD (DSM p.323-324)."
        },
        {
          "text": "Major Depressive Disorder (MDD)",
          "isCorrect": false,
          "rationale": "\u05d1-MDD \u05de\u05e6\u05d1 \u05d4\u05e8\u05d5\u05d7 \u05d4\u05d9\u05e8\u05d5\u05d3 \u05d4\u05d5\u05d0 \u05e8\u05e6\u05d9\u05e3 \u05d5\u05d0\u05d9\u05e0\u05d5 \u05d2\u05dc\u05d9, \u05d5\u05d4\u05d5\u05d0 \u05de\u05d0\u05d5\u05e4\u05d9\u05d9\u05df \u05d1\u05e2\u05e8\u05db\u05d4 \u05e2\u05e6\u05de\u05d9\u05ea \u05e0\u05de\u05d5\u05db\u05d4 \u05d5\u05ea\u05d7\u05d5\u05e9\u05d5\u05ea \u05d0\u05e9\u05dd \u05d2\u05dc\u05d5\u05d1\u05dc\u05d9\u05d5\u05ea, \u05d1\u05e9\u05d5\u05e0\u05d4 \u05de\u05d4\u05de\u05e7\u05e8\u05d9\u05dd \u05e9\u05dc \u05d0\u05d1\u05dc \u05d1\u05d4\u05dd \u05d4\u05e2\u05e8\u05db\u05d4 \u05d4\u05e2\u05e6\u05de\u05d9\u05ea \u05dc\u05e8\u05d5\u05d1 \u05e0\u05e9\u05de\u05e8\u05ea (DSM p.176)."
        },
        {
          "text": "Adjustment Disorder with depressed mood",
          "isCorrect": false,
          "rationale": "\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d6\u05d5 \u05d0\u05d9\u05e0\u05d4 \u05de\u05ea\u05d0\u05d9\u05de\u05d4 \u05db\u05d0\u05e9\u05e8 \u05d4\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05d7\u05de\u05d5\u05e8\u05d9\u05dd \u05de\u05e1\u05e4\u05d9\u05e7 \u05db\u05d3\u05d9 \u05dc\u05e2\u05e0\u05d5\u05ea \u05e2\u05dc \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05e9\u05dc \u05d4\u05e4\u05e8\u05e2\u05d4 \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05ea \u05d0\u05d7\u05e8\u05ea \u05db\u05de\u05d5 PGD, \u05d5\u05d1\u05e4\u05e8\u05d8 \u05db\u05e9\u05d4\u05dd \u05e0\u05de\u05e9\u05db\u05d9\u05dd \u05de\u05e2\u05dc 6 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05de\u05e1\u05d9\u05d5\u05dd \u05d4\u05e1\u05d8\u05e8\u05e1\u05d5\u05e8 (DSM p.322)."
        },
        {
          "text": "Posttraumatic Stress Disorder (PTSD)",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05e9\u05d4\u05de\u05d5\u05d5\u05ea \u05d4\u05d9\u05d4 \u05e4\u05ea\u05d0\u05d5\u05de\u05d9, \u05d4\u05ea\u05d9\u05d0\u05d5\u05e8 \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9 \u05de\u05ea\u05de\u05e7\u05d3 \u05d1\u05d2\u05e2\u05d2\u05d5\u05e2 \u05d5\u05d1\u05d0\u05d5\u05d1\u05d3\u05df \u05d4\u05e7\u05e9\u05e8 (yearning/separation distress) \u05d5\u05dc\u05d0 \u05d1\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05e9\u05dc \u05d7\u05d5\u05d3\u05e8\u05e0\u05d5\u05ea \u05d0\u05d5 \u05e2\u05d5\u05e8\u05e8\u05d5\u05ea \u05d9\u05ea\u05e8 \u05d4\u05e7\u05e9\u05d5\u05e8\u05d9\u05dd \u05dc\u05d0\u05d9\u05e8\u05d5\u05e2 \u05d4\u05d8\u05e8\u05d0\u05d5\u05de\u05d8\u05d9 \u05e2\u05e6\u05de\u05d5 (DSM p.327)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d1\u05d5 \u05e2\u05dc \u05de\u05e9\u05da \u05d4\u05d6\u05de\u05df \u05e9\u05e2\u05d1\u05e8 \u05de\u05d4\u05d0\u05d5\u05d1\u05d3\u05df \u05d5\u05e2\u05dc \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05d4\u05d9\u05d9\u05d7\u05d5\u05d3\u05d9 \u05e9\u05dc \u05d4\u05e4\u05e8\u05e2\u05d4 \u05d6\u05d5 \u05d4\u05de\u05de\u05d5\u05e7\u05d3 \u05d1\u05e4\u05e8\u05d9\u05d3\u05d4 \u05de\u05d4\u05e0\u05e4\u05d8\u05e8."
    },
    {
      "type": "multiple_choice",
      "question": "\u05db\u05d9\u05e6\u05d3 \u05d4\u05e9\u05e4\u05d9\u05e2 \u05d4\u05e9\u05d9\u05e0\u05d5\u05d9 \u05d1-DSM-5 (\u05d5\u05d1\u05d4\u05de\u05e9\u05da \u05d1-DSM-5-TR) \u05e2\u05dc \u05d4\u05d2\u05d9\u05e9\u05d4 \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05dc\u05d0\u05d1\u05d7\u05e0\u05ea Major Depressive Episode (MDE) \u05dc\u05d0\u05d7\u05e8 \u05d0\u05d5\u05d1\u05d3\u05df \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9?",
      "answerOptions": [
        {
          "text": "\u05d1\u05d9\u05d8\u05d5\u05dc \u05d4-bereavement exclusion \u05d4\u05de\u05d0\u05e4\u05e9\u05e8 \u05dc\u05d0\u05d1\u05d7\u05df MDD \u05d2\u05dd \u05d1\u05e1\u05de\u05d5\u05da \u05dc\u05d0\u05d5\u05d1\u05d3\u05df \u05d0\u05dd \u05de\u05ea\u05e7\u05d9\u05d9\u05de\u05d9\u05dd \u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd.",
          "isCorrect": true,
          "rationale": "\u05d4-DSM-5 \u05d1\u05d9\u05d8\u05dc \u05d0\u05ea \u05d4\u05d7\u05e8\u05d2\u05ea \u05d4\u05e9\u05db\u05d5\u05dc \u05db\u05d3\u05d9 \u05dc\u05d4\u05db\u05d9\u05e8 \u05d1\u05db\u05da \u05e9\u05d0\u05d1\u05dc \u05d9\u05db\u05d5\u05dc \u05dc\u05d4\u05d5\u05d5\u05ea \u05e1\u05d8\u05e8\u05e1\u05d5\u05e8 \u05d7\u05de\u05d5\u05e8 \u05d4\u05de\u05e2\u05d5\u05e8\u05e8 \u05d0\u05e4\u05d9\u05d6\u05d5\u05d3\u05d4 \u05d3\u05d9\u05db\u05d0\u05d5\u05e0\u05d9\u05ea \u05d1\u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd \u05e4\u05d2\u05d9\u05e2\u05d9\u05dd (DSM p.187)."
        },
        {
          "text": "\u05d4\u05d0\u05e8\u05db\u05ea \u05ea\u05e7\u05d5\u05e4\u05ea \u05d4\u05d4\u05de\u05ea\u05e0\u05d4 \u05dc\u05d0\u05d1\u05d7\u05e0\u05d4 \u05dc\u05e9\u05e0\u05d4 \u05db\u05d3\u05d9 \u05dc\u05de\u05e0\u05d5\u05e2 \u05de\u05d3\u05d9\u05e7\u05dc\u05d9\u05d6\u05e6\u05d9\u05d4 \u05e9\u05dc \u05d0\u05d1\u05dc \u05e0\u05d5\u05e8\u05de\u05d8\u05d9\u05d1\u05d9.",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e2\u05e9\u05d4, \u05d1\u05d9\u05d8\u05d5\u05dc \u05d4\u05d4\u05d7\u05e8\u05d2\u05d4 \u05de\u05d0\u05e4\u05e9\u05e8 \u05d0\u05d1\u05d7\u05e0\u05d4 \u05de\u05d5\u05e7\u05d3\u05de\u05ea \u05d9\u05d5\u05ea\u05e8 \u05e9\u05dc \u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05e7\u05dc\u05d9\u05e0\u05d9, \u05d1\u05e2\u05d5\u05d3 \u05e9\u05d4\u05d4\u05de\u05ea\u05e0\u05d4 \u05e9\u05dc \u05e9\u05e0\u05d4 (\u05d0\u05d5 6 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd) \u05e8\u05dc\u05d5\u05d5\u05e0\u05d8\u05d9\u05ea \u05e8\u05e7 \u05dc\u05d0\u05d1\u05d7\u05e0\u05ea PGD (DSM p.323)."
        },
        {
          "text": "\u05e7\u05d1\u05d9\u05e2\u05d4 \u05db\u05d9 \u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05e1\u05d5\u05de\u05d8\u05d9\u05d9\u05dd \u05db\u05de\u05d5 \u05d7\u05d5\u05e1\u05e8 \u05ea\u05d9\u05d0\u05d1\u05d5\u05df \u05d5\u05e0\u05d3\u05d5\u05d3\u05d9 \u05e9\u05d9\u05e0\u05d4 \u05d0\u05d9\u05e0\u05dd \u05e0\u05e1\u05e4\u05e8\u05d9\u05dd \u05d0\u05dd \u05d4\u05d7\u05dc\u05d5 \u05dc\u05d0\u05d7\u05e8 \u05de\u05d5\u05d5\u05ea.",
          "isCorrect": false,
          "rationale": "\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05d0\u05dc\u05d5 \u05e0\u05e1\u05e4\u05e8\u05d9\u05dd \u05db\u05d7\u05dc\u05e7 \u05de\u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05dc-MDE, \u05d0\u05da \u05d4-DSM \u05de\u05d3\u05d2\u05d9\u05e9 \u05e9\u05d9\u05e9 \u05dc\u05d4\u05e4\u05e2\u05d9\u05dc \u05e9\u05d9\u05e7\u05d5\u05dc \u05d3\u05e2\u05ea \u05e7\u05dc\u05d9\u05e0\u05d9 \u05db\u05d3\u05d9 \u05dc\u05d4\u05d1\u05d7\u05d9\u05df \u05d1\u05d9\u05df \u05ea\u05d2\u05d5\u05d1\u05ea \u05d0\u05d1\u05dc \u05e0\u05d5\u05e8\u05de\u05d8\u05d9\u05d1\u05d9\u05ea \u05dc\u05d3\u05d9\u05db\u05d0\u05d5\u05df (DSM p.183)."
        },
        {
          "text": "\u05d4\u05e4\u05e8\u05d3\u05d4 \u05de\u05d5\u05d7\u05dc\u05d8\u05ea \u05d1\u05d9\u05df MDD \u05dc-PGD \u05db\u05da \u05e9\u05dc\u05d0 \u05e0\u05d9\u05ea\u05df \u05dc\u05d0\u05d1\u05d7\u05df \u05d0\u05ea \u05e9\u05ea\u05d9\u05d4\u05df \u05d1\u05d5-\u05d6\u05de\u05e0\u05d9\u05ea.",
          "isCorrect": false,
          "rationale": "\u05e9\u05ea\u05d9 \u05d4\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05d9\u05db\u05d5\u05dc\u05d5\u05ea \u05dc\u05d4\u05ea\u05e7\u05d9\u05d9\u05dd \u05d1\u05ea\u05d7\u05dc\u05d5\u05d0\u05d4 \u05e0\u05dc\u05d5\u05d5\u05d9\u05ea (comorbidity), \u05d5\u05d4\u05df \u05d1\u05e2\u05dc\u05d5\u05ea \u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9\u05dd \u05e7\u05dc\u05d9\u05e0\u05d9\u05d9\u05dd \u05e9\u05d5\u05e0\u05d9\u05dd (DSM p.327)."
        }
      ],
      "hint": "\u05d4\u05ea\u05de\u05e7\u05d3\u05d5 \u05d1\u05e9\u05d9\u05e0\u05d5\u05d9 \u05e9\u05e0\u05d5\u05e2\u05d3 \u05dc\u05d0\u05e4\u05e9\u05e8 \u05d8\u05d9\u05e4\u05d5\u05dc \u05de\u05d5\u05e7\u05d3\u05dd \u05d9\u05d5\u05ea\u05e8 \u05d1\u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05e7\u05dc\u05d9\u05e0\u05d9 \u05d4\u05de\u05d5\u05e4\u05d9\u05e2 \u05dc\u05d0\u05d7\u05e8 \u05e9\u05db\u05d5\u05dc."
    },
    {
      "type": "fill_in_the_blank",
      "question": "\u05dc\u05e4\u05d9 \u05d4-DSM-5-TR, \u05db\u05d3\u05d9 \u05dc\u05d0\u05d1\u05d7\u05df Prolonged Grief Disorder \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d5\u05d1\u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd, \u05e2\u05dc \u05d4\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05dc\u05d4\u05de\u05e9\u05d9\u05da \u05d5\u05dc\u05d4\u05d5\u05e4\u05d9\u05e2 \u05dc\u05de\u05e9\u05da \u05dc\u05e4\u05d7\u05d5\u05ea ___ \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05de\u05d0\u05d6 \u05de\u05d5\u05ea\u05d5 \u05e9\u05dc \u05d0\u05d3\u05dd \u05e7\u05e8\u05d5\u05d1.",
      "bestAnswer": "6",
      "acceptableAnswers": [
        "\u05e9\u05d9\u05e9\u05d4",
        "six"
      ],
      "rationale": "\u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df \u05d4\u05db\u05e8\u05d5\u05e0\u05d5\u05dc\u05d5\u05d2\u05d9 \u05dc\u05d0\u05d1\u05d7\u05e0\u05ea PGD \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d5\u05d1\u05e0\u05d9 \u05e0\u05d5\u05e2\u05e8 \u05d4\u05d5\u05d0 6 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd, \u05d1\u05e9\u05d5\u05e0\u05d4 \u05de\u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd \u05e2\u05d1\u05d5\u05e8\u05dd \u05e0\u05d3\u05e8\u05e9\u05d9\u05dd 12 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd (DSM p.323).",
      "hint": "\u05d6\u05d4\u05d5 \u05e4\u05e8\u05e7 \u05d4\u05d6\u05de\u05df \u05d4\u05de\u05d9\u05e0\u05d9\u05de\u05dc\u05d9 \u05d4\u05e0\u05d3\u05e8\u05e9 \u05d1\u05d0\u05d5\u05db\u05dc\u05d5\u05e1\u05d9\u05d9\u05ea \u05d4\u05d9\u05dc\u05d3\u05d9\u05dd \u05db\u05d3\u05d9 \u05dc\u05d4\u05d2\u05d3\u05d9\u05e8 \u05d0\u05ea \u05d4\u05d0\u05d1\u05dc \u05db'\u05de\u05de\u05d5\u05e9\u05da'."
    },
    {
      "type": "multiple_choice",
      "question": "\u05d9\u05dc\u05d3 \u05d1\u05df 4 \u05d7\u05d5\u05d5\u05d4 \u05d0\u05ea \u05de\u05d5\u05ea \u05e1\u05d1\u05d5. \u05d4\u05d5\u05d0 \u05e9\u05d5\u05d0\u05dc \u05d0\u05ea \u05d0\u05d1\u05d9\u05d5 \u05e9\u05d5\u05d1 \u05d5\u05e9\u05d5\u05d1 '\u05de\u05ea\u05d9 \u05e1\u05d1\u05d0 \u05d9\u05ea\u05e2\u05d5\u05e8\u05e8?' \u05d5\u05de\u05e0\u05e1\u05d4 \u05dc\u05d7\u05e4\u05e9 \u05d0\u05d5\u05ea\u05d5 \u05de\u05ea\u05d7\u05ea \u05dc\u05de\u05d9\u05d8\u05d4. \u05dc\u05e4\u05d9 \u05d4\u05e1\u05e4\u05e8\u05d5\u05ea \u05e2\u05dc \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea \u05d4\u05d9\u05dc\u05d3, \u05de\u05d4\u05d5 \u05d4\u05d4\u05e1\u05d1\u05e8 \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9 \u05d4\u05e1\u05d1\u05d9\u05e8 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d6\u05d5?",
      "answerOptions": [
        {
          "text": "\u05d7\u05d5\u05e1\u05e8 \u05d4\u05d1\u05e0\u05d4 \u05e9\u05dc \u05d4\u05de\u05d5\u05e9\u05d2 '\u05e1\u05d5\u05e4\u05d9\u05d5\u05ea' (permanence) \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05d0\u05ea \u05d4\u05d2\u05d9\u05dc \u05d4\u05e8\u05da.",
          "isCorrect": true,
          "rationale": "\u05d9\u05dc\u05d3\u05d9\u05dd \u05e6\u05e2\u05d9\u05e8\u05d9\u05dd \u05d1\u05d2\u05d9\u05dc \u05d4\u05d2\u05df \u05dc\u05e8\u05d5\u05d1 \u05d0\u05d9\u05e0\u05dd \u05de\u05d1\u05d9\u05e0\u05d9\u05dd \u05d0\u05ea \u05d4\u05e7\u05d1\u05d9\u05e2\u05d5\u05ea \u05d5\u05d4\u05e1\u05d5\u05e4\u05d9\u05d5\u05ea \u05e9\u05dc \u05d4\u05de\u05d5\u05d5\u05ea \u05d5\u05e0\u05d5\u05d8\u05d9\u05dd \u05dc\u05d7\u05e4\u05e9 \u05d0\u05ea \u05d4\u05e0\u05e4\u05d8\u05e8 \u05d0\u05d5 \u05dc\u05d4\u05d0\u05de\u05d9\u05df \u05e9\u05d9\u05d7\u05d6\u05d5\u05e8 (Dulcan p.325)."
        },
        {
          "text": "\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05dd \u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9 \u05d7\u05e8\u05d9\u05e3 \u05e9\u05dc \u05de\u05d7\u05e9\u05d1\u05ea \u05e9\u05d5\u05d5\u05d0 \u05e2\u05dc \u05ea\u05d7\u05d9\u05d9\u05ea \u05d4\u05de\u05ea\u05d9\u05dd.",
          "isCorrect": false,
          "rationale": "\u05e9\u05d0\u05dc\u05d5\u05ea \u05e2\u05dc \u05d7\u05d6\u05e8\u05ea \u05d4\u05e0\u05e4\u05d8\u05e8 \u05d4\u05df \u05d7\u05dc\u05e7 \u05e0\u05d5\u05e8\u05de\u05d8\u05d9\u05d1\u05d9 \u05de\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea \u05d4\u05d1\u05e0\u05ea \u05de\u05d5\u05d5\u05ea \u05d1\u05d2\u05d9\u05dc \u05d6\u05d4 \u05d5\u05d0\u05d9\u05e0\u05df \u05de\u05e2\u05d9\u05d3\u05d5\u05ea \u05e2\u05dc \u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d4 (Dulcan p.325)."
        },
        {
          "text": "\u05d7\u05e9\u05d9\u05e4\u05d4 \u05dc\u05d8\u05e8\u05d0\u05d5\u05de\u05d4 \u05d7\u05de\u05d5\u05e8\u05d4 \u05d4\u05d2\u05d5\u05e8\u05de\u05ea \u05dc\u05e8\u05d2\u05e8\u05e1\u05d9\u05d4 \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9\u05ea \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea.",
          "isCorrect": false,
          "rationale": "\u05d1\u05e2\u05d5\u05d3 \u05e9\u05de\u05d5\u05d5\u05ea \u05d9\u05db\u05d5\u05dc \u05dc\u05d4\u05d9\u05d5\u05ea \u05d8\u05e8\u05d0\u05d5\u05de\u05d8\u05d9, \u05d4\u05d7\u05d9\u05e4\u05d5\u05e9 \u05d0\u05d7\u05e8 \u05d4\u05e0\u05e4\u05d8\u05e8 \u05d5\u05d4\u05e9\u05d0\u05dc\u05d5\u05ea \u05e2\u05dc\u05d9\u05d5 \u05e0\u05d5\u05d1\u05e2\u05d9\u05dd \u05d1\u05e8\u05d0\u05e9 \u05d5\u05d1\u05e8\u05d0\u05e9\u05d5\u05e0\u05d4 \u05de\u05de\u05d2\u05d1\u05dc\u05d4 \u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9\u05ea \u05d1\u05d4\u05d1\u05e0\u05ea \u05de\u05d5\u05d5\u05ea \u05d1\u05d2\u05d9\u05dc \u05d6\u05d4 (Dulcan p.325)."
        },
        {
          "text": "\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05d2\u05e0\u05d4 \u05e9\u05dc \u05d4\u05db\u05d7\u05e9\u05d4 (denial) \u05db\u05d3\u05d9 \u05dc\u05d4\u05ea\u05de\u05d5\u05d3\u05d3 \u05e2\u05dd \u05db\u05d0\u05d1 \u05d1\u05dc\u05ea\u05d9 \u05e0\u05e1\u05d1\u05dc.",
          "isCorrect": false,
          "rationale": "\u05d4\u05e1\u05d1\u05e8 \u05d6\u05d4 \u05de\u05ea\u05d0\u05d9\u05dd \u05d9\u05d5\u05ea\u05e8 \u05dc\u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd \u05d0\u05d5 \u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd; \u05d0\u05e6\u05dc \u05e4\u05e2\u05d5\u05d8\u05d5\u05ea \u05de\u05d3\u05d5\u05d1\u05e8 \u05d1\u05e7\u05d5\u05e9\u05d9 \u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9 \u05dc\u05d4\u05d1\u05d9\u05df \u05d0\u05ea \u05d4\u05de\u05d5\u05e9\u05d2 \u05d4\u05de\u05d5\u05e4\u05e9\u05d8 \u05e9\u05dc \u05de\u05d5\u05d5\u05ea (Dulcan p.325)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d1\u05d5 \u05e2\u05dc \u05d4\u05de\u05d2\u05d1\u05dc\u05d5\u05ea \u05d4\u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9\u05d5\u05ea \u05e9\u05dc \u05d9\u05dc\u05d3\u05d9\u05dd \u05d1\u05d2\u05d9\u05dc \u05d4\u05d2\u05df \u05d1\u05e0\u05d5\u05d2\u05e2 \u05dc\u05de\u05d5\u05e9\u05d2\u05d9\u05dd \u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05d9\u05dd \u05e1\u05d5\u05e4\u05d9\u05d9\u05dd."
    },
    {
      "type": "multiple_select",
      "question": "\u05d0\u05dc\u05d5 \u05de\u05d4\u05de\u05e8\u05db\u05d9\u05d1\u05d9\u05dd \u05d4\u05d1\u05d0\u05d9\u05dd \u05e0\u05d5\u05e1\u05e4\u05d9\u05dd \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-TF-CBT \u05db\u05d0\u05e9\u05e8 \u05d4\u05de\u05d8\u05e8\u05d4 \u05d4\u05d9\u05d0 \u05dc\u05d8\u05e4\u05dc \u05d1\u05d0\u05d1\u05dc \u05d8\u05e8\u05d0\u05d5\u05de\u05d8\u05d9 (Traumatic Grief) \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd?",
      "answerOptions": [
        {
          "text": "Psychoeducation \u05dc\u05d2\u05d1\u05d9 \u05ea\u05d4\u05dc\u05d9\u05da \u05d4\u05d0\u05d1\u05dc.",
          "isCorrect": true,
          "rationale": "\u05d4\u05e1\u05d1\u05e8 \u05e2\u05dc \u05d4\u05d0\u05d5\u05e4\u05df \u05e9\u05d1\u05d5 \u05d0\u05d1\u05dc \u05d5\u05d8\u05e8\u05d0\u05d5\u05de\u05d4 \u05de\u05e9\u05ea\u05dc\u05d1\u05d9\u05dd \u05d4\u05d5\u05d0 \u05e9\u05dc\u05d1 \u05e7\u05e8\u05d9\u05d8\u05d9 \u05d1\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05de\u05d5\u05ea\u05d0\u05dd (Dulcan p.358)."
        },
        {
          "text": "\u05e4\u05ea\u05e8\u05d5\u05df \u05e8\u05d2\u05e9\u05d5\u05ea \u05d0\u05de\u05d1\u05d9\u05d5\u05d5\u05dc\u05e0\u05d8\u05d9\u05d9\u05dd \u05db\u05dc\u05e4\u05d9 \u05d4\u05e0\u05e4\u05d8\u05e8.",
          "isCorrect": true,
          "rationale": "\u05e2\u05d9\u05d1\u05d5\u05d3 \u05d4\u05e7\u05e9\u05e8 \u05d4\u05de\u05d5\u05e8\u05db\u05d1, \u05db\u05d5\u05dc\u05dc \u05e8\u05d2\u05e9\u05d5\u05ea \u05e9\u05dc\u05d9\u05dc\u05d9\u05d9\u05dd \u05d0\u05d5 \u05e7\u05d5\u05e0\u05e4\u05dc\u05d9\u05e7\u05d8\u05d9\u05dd, \u05de\u05e1\u05d9\u05d9\u05e2 \u05d1\u05e8\u05d6\u05d5\u05dc\u05d5\u05e6\u05d9\u05d4 \u05e9\u05dc \u05d4\u05d0\u05d1\u05dc (Dulcan p.358)."
        },
        {
          "text": "\u05e9\u05d9\u05de\u05d5\u05e8 \u05d6\u05d9\u05db\u05e8\u05d5\u05e0\u05d5\u05ea \u05d7\u05d9\u05d5\u05d1\u05d9\u05d9\u05dd \u05de\u05d4\u05e0\u05e4\u05d8\u05e8.",
          "isCorrect": true,
          "rationale": "\u05d4\u05de\u05d8\u05e8\u05d4 \u05d4\u05d9\u05d0 \u05dc\u05e2\u05d6\u05d5\u05e8 \u05dc\u05d9\u05dc\u05d3 \u05dc\u05e2\u05d1\u05d5\u05e8 \u05de\u05de\u05e2\u05e8\u05db\u05ea \u05d9\u05d7\u05e1\u05d9\u05dd \u05e9\u05dc \u05d0\u05d9\u05e0\u05d8\u05e8\u05d0\u05e7\u05e6\u05d9\u05d4 \u05dc\u05de\u05e2\u05e8\u05db\u05ea \u05d9\u05d7\u05e1\u05d9\u05dd \u05e9\u05dc \u05d6\u05d9\u05db\u05e8\u05d5\u05df (Dulcan p.358)."
        },
        {
          "text": "\u05d7\u05e9\u05d9\u05e4\u05d4 \u05d7\u05d9\u05d4 (In vivo exposure) \u05dc\u05d6\u05d9\u05e8\u05ea \u05d4\u05de\u05d5\u05d5\u05ea \u05db\u05e9\u05dc\u05d1 \u05e8\u05d0\u05e9\u05d5\u05df.",
          "isCorrect": false,
          "rationale": "\u05d7\u05e9\u05d9\u05e4\u05d4 \u05db\u05d6\u05d5 \u05e2\u05dc\u05d5\u05dc\u05d4 \u05dc\u05d4\u05e6\u05d9\u05e3 \u05de\u05d3\u05d9; \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05de\u05ea\u05de\u05e7\u05d3 \u05ea\u05d7\u05d9\u05dc\u05d4 \u05d1\u05d9\u05d9\u05e6\u05d5\u05d1 \u05d5\u05d1\u05de\u05e8\u05db\u05d9\u05d1\u05d9 \u05d4-PRACTICE \u05dc\u05e4\u05e0\u05d9 \u05d4\u05e2\u05d9\u05d1\u05d5\u05d3 \u05d4\u05d9\u05e9\u05d9\u05e8 (Dulcan p.358)."
        }
      ],
      "hint": "\u05d4\u05ea\u05de\u05e7\u05d3\u05d5 \u05d1\u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd \u05e9\u05d4\u05d5\u05e4\u05db\u05d9\u05dd \u05d0\u05ea \u05d4-TF-CBT \u05de\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05d8\u05e8\u05d0\u05d5\u05de\u05d4 \u05d1\u05dc\u05d1\u05d3 \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05de\u05e9\u05dc\u05d1 \u05d0\u05ea \u05e2\u05d9\u05d1\u05d5\u05d3 \u05d4\u05d0\u05d5\u05d1\u05d3\u05df.",
      "hasAllOfTheAbove": false,
      "hasNoneOfTheAbove": false
    },
    {
      "type": "short_answer",
      "question": "\u05d4\u05e1\u05d1\u05d9\u05e8\u05d5 \u05d0\u05ea \u05d4\u05d4\u05d1\u05d3\u05dc \u05d4\u05e2\u05d9\u05e7\u05e8\u05d9 \u05d1\u05d9\u05df \u05ea\u05d5\u05db\u05df \u05d4\u05de\u05d7\u05e9\u05d1\u05d4 (thought content) \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05d0\u05d1\u05dc (Grief) \u05dc\u05d1\u05d9\u05df \u05d6\u05d4 \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05d0\u05e4\u05d9\u05d6\u05d5\u05d3\u05d4 \u05d3\u05d9\u05db\u05d0\u05d5\u05e0\u05d9\u05ea (MDE), \u05d1\u05de\u05d9\u05d5\u05d7\u05d3 \u05d1\u05e0\u05d5\u05d2\u05e2 \u05dc\u05e0\u05d5\u05e9\u05d0 \u05d4\u05de\u05d5\u05d5\u05ea.",
      "grading": {
        "modelAnswer": "\u05d1\u05d0\u05d1\u05dc, \u05ea\u05d5\u05db\u05df \u05d4\u05de\u05d7\u05e9\u05d1\u05d4 \u05de\u05de\u05d5\u05e7\u05d3 \u05d1\u05e0\u05e4\u05d8\u05e8, \u05d1\u05d2\u05e2\u05d2\u05d5\u05e2 \u05d0\u05dc\u05d9\u05d5 \u05d5\u05d1\u05e0\u05d8\u05d9\u05d9\u05d4 '\u05dc\u05d4\u05e6\u05d8\u05e8\u05e3' \u05d0\u05dc\u05d9\u05d5. \u05dc\u05e2\u05d5\u05de\u05ea \u05d6\u05d0\u05ea, \u05d1-MDE \u05ea\u05d5\u05db\u05df \u05d4\u05de\u05d7\u05e9\u05d1\u05d4 \u05de\u05de\u05d5\u05e7\u05d3 \u05d1\u05e2\u05e6\u05de\u05d9, \u05d5\u05de\u05d0\u05d5\u05e4\u05d9\u05d9\u05df \u05d1\u05de\u05d7\u05e9\u05d1\u05d5\u05ea \u05e2\u05dc \u05e1\u05d9\u05d5\u05dd \u05d4\u05d7\u05d9\u05d9\u05dd \u05d1\u05e9\u05dc \u05ea\u05d7\u05d5\u05e9\u05d5\u05ea \u05d7\u05d5\u05e1\u05e8 \u05e2\u05e8\u05da, \u05d7\u05d5\u05e1\u05e8 \u05d9\u05db\u05d5\u05dc\u05ea \u05dc\u05d4\u05ea\u05de\u05d5\u05d3\u05d3 \u05e2\u05dd \u05d4\u05db\u05d0\u05d1 \u05d0\u05d5 \u05ea\u05d7\u05d5\u05e9\u05d4 \u05e9\u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05d0\u05d9\u05e0\u05d5 \u05e8\u05d0\u05d5\u05d9 \u05dc\u05d7\u05d9\u05d5\u05ea (DSM p.176).",
        "rationale": "\u05d4\u05d4\u05d1\u05d7\u05e0\u05d4 \u05d4\u05de\u05e8\u05db\u05d6\u05d9\u05ea \u05e0\u05e2\u05d5\u05e6\u05d4 \u05d1\u05de\u05d5\u05e7\u05d3 \u05d4\u05de\u05d7\u05e9\u05d1\u05ea\u05d9 - \u05d4\u05e0\u05e4\u05d8\u05e8 \u05d5\u05d4\u05e7\u05e9\u05e8 \u05d0\u05dc\u05d9\u05d5 (\u05d0\u05d1\u05dc) \u05de\u05d5\u05dc \u05e4\u05d2\u05d9\u05e2\u05d4 \u05d1\u05e2\u05e8\u05da \u05d4\u05e2\u05e6\u05de\u05d9 \u05d5\u05d9\u05d9\u05d0\u05d5\u05e9 \u05d2\u05dc\u05d5\u05d1\u05dc\u05d9 (\u05d3\u05d9\u05db\u05d0\u05d5\u05df).",
        "requiredAttributes": [
          "\u05e6\u05d9\u05d5\u05df \u05d4\u05de\u05d9\u05e7\u05d5\u05d3 \u05d1\u05e0\u05e4\u05d8\u05e8/\u05d2\u05e2\u05d2\u05d5\u05e2 \u05d1\u05d0\u05d1\u05dc.",
          "\u05e6\u05d9\u05d5\u05df \u05d4\u05de\u05d9\u05e7\u05d5\u05d3 \u05d1\u05e2\u05e6\u05de\u05d9/\u05d7\u05d5\u05e1\u05e8 \u05e2\u05e8\u05da \u05d1-MDE.",
          "\u05d4\u05e1\u05d1\u05e8 \u05d4\u05d4\u05d1\u05d3\u05dc \u05d1\u05de\u05d5\u05d8\u05d9\u05d1\u05e6\u05d9\u05d4 \u05dc\u05de\u05d7\u05e9\u05d1\u05d5\u05ea \u05e2\u05dc \u05de\u05d5\u05d5\u05ea (\u05dc\u05d4\u05e6\u05d8\u05e8\u05e3 \u05dc\u05e0\u05e4\u05d8\u05e8 \u05de\u05d5\u05dc \u05dc\u05e1\u05d9\u05d9\u05dd \u05d0\u05ea \u05d4\u05e1\u05d1\u05dc)."
        ],
        "errors": {
          "misconceptions": [
            "\u05d8\u05e2\u05e0\u05d4 \u05e9\u05d1\u05d0\u05d1\u05dc \u05d0\u05d9\u05df \u05de\u05d7\u05e9\u05d1\u05d5\u05ea \u05e2\u05dc \u05de\u05d5\u05d5\u05ea \u05db\u05dc\u05dc."
          ],
          "bluffs": [
            "\u05d0\u05de\u05d9\u05e8\u05d4 \u05db\u05dc\u05dc\u05d9\u05ea \u05e9\u05d0\u05d1\u05dc \u05d4\u05d5\u05d0 \u05e4\u05d7\u05d5\u05ea \u05d7\u05de\u05d5\u05e8 \u05de\u05d3\u05d9\u05db\u05d0\u05d5\u05df."
          ]
        }
      },
      "hint": "\u05d7\u05e9\u05d1\u05d5 \u05e2\u05dc \u05d4\u05e9\u05d0\u05dc\u05d4 '\u05dc\u05de\u05d4 \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05e8\u05d5\u05e6\u05d4 \u05dc\u05de\u05d5\u05ea?' \u05d1\u05db\u05dc \u05d0\u05d7\u05d3 \u05de\u05d4\u05de\u05e6\u05d1\u05d9\u05dd."
    },
    {
      "type": "multiple_choice",
      "question": "\u05de\u05d4 \u05d9\u05d3\u05d5\u05e2 \u05dc\u05d2\u05d1\u05d9 \u05d4\u05e7\u05e9\u05e8 \u05d1\u05d9\u05df Prolonged Grief Disorder \u05dc\u05d1\u05d9\u05df \u05e1\u05d9\u05db\u05d5\u05df \u05d0\u05d5\u05d1\u05d3\u05e0\u05d9 (suicidal risk) \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR?",
      "answerOptions": [
        {
          "text": "\u05e7\u05d9\u05d9\u05dd \u05e1\u05d9\u05db\u05d5\u05df \u05de\u05d5\u05d2\u05d1\u05e8 \u05dc\u05d0\u05d5\u05d1\u05d3\u05e0\u05d5\u05ea \u05d1-PGD, \u05e9\u05e0\u05e9\u05d0\u05e8 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9 \u05d2\u05dd \u05dc\u05d0\u05d7\u05e8 \u05ea\u05e7\u05e0\u05d5\u05df \u05dc\u05e0\u05d5\u05db\u05d7\u05d5\u05ea MDD \u05d0\u05d5 PTSD.",
          "isCorrect": true,
          "rationale": "\u05d4-DSM \u05de\u05e6\u05d9\u05d9\u05df \u05db\u05d9 \u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05e9\u05dc PGD \u05d4\u05dd \u05d2\u05d5\u05e8\u05dd \u05e1\u05d9\u05db\u05d5\u05df \u05e2\u05e6\u05de\u05d0\u05d9 \u05dc\u05d0\u05d5\u05d1\u05d3\u05e0\u05d5\u05ea \u05dc\u05d0\u05d5\u05e8\u05da \u05db\u05dc \u05de\u05e2\u05d2\u05dc \u05d4\u05d7\u05d9\u05d9\u05dd (DSM p.326)."
        },
        {
          "text": "\u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05d4\u05d0\u05d5\u05d1\u05d3\u05e0\u05d9 \u05d1-PGD \u05e0\u05d5\u05d1\u05e2 \u05d0\u05da \u05d5\u05e8\u05e7 \u05de\u05d4\u05ea\u05d7\u05dc\u05d5\u05d0\u05d4 \u05d4\u05e0\u05dc\u05d5\u05d5\u05d9\u05ea \u05dc\u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05e7\u05dc\u05d9\u05e0\u05d9.",
          "isCorrect": false,
          "rationale": "\u05d4\u05de\u05d7\u05e7\u05e8 \u05de\u05e8\u05d0\u05d4 \u05e9\u05d4\u05e7\u05e9\u05e8 \u05dc\u05d0\u05d5\u05d1\u05d3\u05e0\u05d5\u05ea \u05e0\u05e9\u05de\u05e8 \u05d2\u05dd \u05db\u05e9\u05dc\u05d5\u05e7\u05d7\u05d9\u05dd \u05d1\u05d7\u05e9\u05d1\u05d5\u05df \u05d0\u05ea \u05d4\u05e9\u05e4\u05e2\u05ea \u05d4\u05d3\u05d9\u05db\u05d0\u05d5\u05df (DSM p.326)."
        },
        {
          "text": "\u05e1\u05d9\u05db\u05d5\u05df \u05d0\u05d5\u05d1\u05d3\u05e0\u05d9 \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd PGD \u05de\u05d5\u05e4\u05d9\u05e2 \u05e8\u05e7 \u05d0\u05dd \u05d4\u05de\u05d5\u05d5\u05ea \u05e9\u05dc \u05d4\u05e7\u05e8\u05d5\u05d1 \u05d4\u05d9\u05d4 \u05d0\u05dc\u05d9\u05dd (\u05d4\u05ea\u05d0\u05d1\u05d3\u05d5\u05ea \u05d0\u05d5 \u05e8\u05e6\u05d7).",
          "isCorrect": false,
          "rationale": "\u05d1\u05e2\u05d5\u05d3 \u05e9\u05de\u05d5\u05d5\u05ea \u05d0\u05dc\u05d9\u05dd \u05de\u05d2\u05d1\u05d9\u05e8 \u05d0\u05ea \u05d4\u05e1\u05d9\u05db\u05d5\u05df, PGD \u05db\u05e9\u05dc\u05e2\u05e6\u05de\u05d5 \u05de\u05d4\u05d5\u05d5\u05d4 \u05d2\u05d5\u05e8\u05dd \u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05dc\u05d0 \u05e7\u05e9\u05e8 \u05dc\u05e1\u05d9\u05d1\u05ea \u05d4\u05de\u05d5\u05d5\u05ea (DSM p.326)."
        },
        {
          "text": "\u05d1\u05e0\u05d9\u05d2\u05d5\u05d3 \u05dc\u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd, \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d5\u05d1\u05e0\u05d9 \u05e0\u05d5\u05e2\u05e8 PGD \u05d0\u05d9\u05e0\u05d5 \u05de\u05e2\u05dc\u05d4 \u05d0\u05ea \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05de\u05e2\u05e9\u05d9\u05dd \u05d0\u05d5\u05d1\u05d3\u05e0\u05d9\u05d9\u05dd \u05d0\u05dc\u05d0 \u05e8\u05e7 \u05dc\u05de\u05d7\u05e9\u05d1\u05d5\u05ea.",
          "isCorrect": false,
          "rationale": "\u05d4\u05e7\u05e9\u05e8 \u05d1\u05d9\u05df \u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05e9\u05dc PGD \u05dc\u05de\u05d7\u05e9\u05d1\u05d5\u05ea \u05d0\u05d5\u05d1\u05d3\u05e0\u05d9\u05d5\u05ea \u05d4\u05d5\u05d0 \u05e2\u05e7\u05d1\u05d9 \u05dc\u05d0\u05d5\u05e8\u05da \u05db\u05dc \u05d8\u05d5\u05d5\u05d7 \u05d4\u05d2\u05d9\u05dc\u05d0\u05d9\u05dd (DSM p.326)."
        }
      ],
      "hint": "\u05d4\u05d0\u05dd \u05d4\u05e4\u05e8\u05e2\u05ea \u05d4\u05d0\u05d1\u05dc \u05d4\u05d9\u05d0 \u05e8\u05e7 '\u05de\u05e1\u05d5\u05d5\u05d4' \u05dc\u05d3\u05d9\u05db\u05d0\u05d5\u05df, \u05d0\u05d5 \u05e9\u05d9\u05e9 \u05dc\u05d4 \u05de\u05e9\u05de\u05e2\u05d5\u05ea \u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05e0\u05e4\u05e8\u05d3\u05ea \u05d1\u05e0\u05d5\u05d2\u05e2 \u05dc\u05d1\u05d8\u05d9\u05d7\u05d5\u05ea?"
    },
    {
      "type": "multiple_choice",
      "question": "\u05d1\u05ea\u05d4\u05dc\u05d9\u05da \u05d4\u05d4\u05e2\u05e8\u05db\u05d4 \u05e9\u05dc \u05d0\u05d1\u05dc \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd (\u05dc\u05e4\u05d9 Dulcan), \u05de\u05d3\u05d5\u05e2 \u05d7\u05e9\u05d5\u05d1 \u05dc\u05d4\u05e9\u05ea\u05de\u05e9 \u05d1-Multiple Informants (\u05db\u05de\u05d5 \u05d4\u05d5\u05e8\u05d9\u05dd, \u05de\u05d5\u05e8\u05d9\u05dd \u05d5\u05d1\u05d9\u05ea \u05d4\u05e1\u05e4\u05e8)?",
      "answerOptions": [
        {
          "text": "\u05db\u05d3\u05d9 \u05dc\u05d6\u05d4\u05d5\u05ea \u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05e9\u05de\u05d5\u05e4\u05d9\u05e2\u05d9\u05dd \u05e8\u05e7 \u05d1\u05e1\u05d1\u05d9\u05d1\u05d5\u05ea \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05d5\u05ea, \u05db\u05de\u05d5 \u05e7\u05e9\u05d9\u05d9\u05dd \u05d1\u05dc\u05d9\u05de\u05d5\u05d3\u05d9\u05dd \u05d0\u05d5 \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05e0\u05e1\u05d9\u05d2\u05ea\u05d9\u05ea \u05d1\u05d1\u05d9\u05ea \u05d4\u05e1\u05e4\u05e8.",
          "isCorrect": true,
          "rationale": "\u05de\u05d9\u05d3\u05e2 \u05de\u05de\u05e7\u05d5\u05e8\u05d5\u05ea \u05e9\u05d5\u05e0\u05d9\u05dd \u05e2\u05d5\u05d6\u05e8 \u05dc\u05d4\u05d1\u05d4\u05d9\u05e8 \u05d0\u05ea \u05d4\u05d9\u05e7\u05e3 \u05d4\u05e4\u05d2\u05d9\u05e2\u05d4 \u05d4\u05ea\u05e4\u05e7\u05d5\u05d3\u05d9\u05ea \u05d5\u05d0\u05ea \u05d1\u05d9\u05d8\u05d5\u05d9\u05d9 \u05d4\u05d0\u05d1\u05dc \u05e9\u05e2\u05dc\u05d5\u05dc\u05d9\u05dd \u05dc\u05d4\u05d9\u05d5\u05ea \u05de\u05d5\u05e1\u05ea\u05e8\u05d9\u05dd \u05d1\u05d1\u05d9\u05ea (Dulcan p.354)."
        },
        {
          "text": "\u05de\u05db\u05d9\u05d5\u05d5\u05df \u05e9\u05d9\u05dc\u05d3\u05d9\u05dd \u05de\u05ea\u05d7\u05ea \u05dc\u05d2\u05d9\u05dc 12 \u05d0\u05d9\u05e0\u05dd \u05de\u05e1\u05d5\u05d2\u05dc\u05d9\u05dd \u05dc\u05d3\u05d5\u05d5\u05d7 \u05e2\u05dc \u05e8\u05d2\u05e9\u05d5\u05ea\u05d9\u05d4\u05dd \u05d1\u05d0\u05d5\u05e4\u05df \u05de\u05d4\u05d9\u05de\u05df.",
          "isCorrect": false,
          "rationale": "\u05d9\u05dc\u05d3\u05d9\u05dd \u05d9\u05db\u05d5\u05dc\u05d9\u05dd \u05dc\u05d3\u05d5\u05d5\u05d7 \u05e2\u05dc \u05e8\u05d2\u05e9\u05d5\u05ea, \u05d0\u05da \u05d4\u05de\u05d9\u05d3\u05e2 \u05de\u05d4\u05e1\u05d1\u05d9\u05d1\u05d4 \u05de\u05e9\u05dc\u05d9\u05dd \u05d0\u05ea \u05d4\u05ea\u05de\u05d5\u05e0\u05d4 \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05d5\u05de\u05d0\u05de\u05ea \u05d0\u05ea \u05d4\u05d3\u05d9\u05d5\u05d5\u05d7 (Dulcan p.354)."
        },
        {
          "text": "\u05db\u05d3\u05d9 \u05dc\u05e7\u05d1\u05dc \u05d0\u05d9\u05e9\u05d5\u05e8 \u05de\u05e9\u05e4\u05d8\u05d9 \u05dc\u05d0\u05d1\u05d7\u05e0\u05d4 \u05dc\u05e4\u05e0\u05d9 \u05d4\u05ea\u05d7\u05dc\u05ea \u05d8\u05d9\u05e4\u05d5\u05dc \u05ea\u05e8\u05d5\u05e4\u05ea\u05d9.",
          "isCorrect": false,
          "rationale": "\u05d4\u05e6\u05d5\u05e8\u05da \u05d1\u05de\u05e1\u05e4\u05e8 \u05de\u05e7\u05d5\u05e8\u05d5\u05ea \u05d4\u05d5\u05d0 \u05e7\u05dc\u05d9\u05e0\u05d9-\u05d0\u05d1\u05d7\u05e0\u05ea\u05d9 \u05d5\u05dc\u05d0 \u05de\u05e9\u05e4\u05d8\u05d9 \u05d1\u05de\u05d4\u05d5\u05ea\u05d5 (Dulcan p.354)."
        },
        {
          "text": "\u05db\u05d3\u05d9 \u05dc\u05de\u05e0\u05d5\u05e2 '\u05d6\u05d9\u05d4\u05d5\u05dd' \u05e9\u05dc \u05d4\u05d3\u05d9\u05d5\u05d5\u05d7 \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d4\u05d4\u05d5\u05e8\u05d4 \u05e9\u05d7\u05d5\u05d5\u05d4 \u05d0\u05d1\u05dc \u05d1\u05e2\u05e6\u05de\u05d5.",
          "isCorrect": false,
          "rationale": "\u05d0\u05d3\u05e8\u05d1\u05d0, \u05d4\u05d1\u05e0\u05ea \u05de\u05e6\u05d1\u05d5 \u05e9\u05dc \u05d4\u05d4\u05d5\u05e8\u05d4 \u05d4\u05d9\u05d0 \u05d7\u05dc\u05e7 \u05de\u05d4\u05d4\u05e2\u05e8\u05db\u05d4, \u05d0\u05da \u05d4\u05de\u05d8\u05e8\u05d4 \u05d4\u05d9\u05d0 \u05d0\u05d9\u05e0\u05d8\u05d2\u05e8\u05e6\u05d9\u05d4 \u05e9\u05dc \u05de\u05d9\u05d3\u05e2 \u05d5\u05dc\u05d0 \u05e8\u05e7 \u05e9\u05dc\u05d9\u05dc\u05d4 \u05e9\u05dc \u05de\u05e7\u05d5\u05e8 \u05d0\u05d7\u05d3 (Dulcan p.354)."
        }
      ],
