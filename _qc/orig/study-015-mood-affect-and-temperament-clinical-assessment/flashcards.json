{
  "title": "Psychiatry Flashcards",
  "cards": [
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05d4\u05d1\u05d3\u05dc \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05d1\u05d9\u05df Mood \u05dc\u05d1\u05d9\u05df Affect \u05d1\u05de\u05e1\u05d2\u05e8\u05ea \u05d4\u05d1\u05d3\u05d9\u05e7\u05d4 \u05d4\u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9\u05ea (MSE)?",
      "back": "Mood \u05d4\u05d5\u05d0 \u05d4\u05d3\u05d9\u05d5\u05d5\u05d7 \u05d4\u05e1\u05d5\u05d1\u05d9\u05d9\u05e7\u05d8\u05d9\u05d1\u05d9 \u05e9\u05dc \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05e2\u05dc \u05de\u05e6\u05d1\u05d5 \u05d4\u05e8\u05d2\u05e9\u05d9, \u05d1\u05e2\u05d5\u05d3 Affect \u05d4\u05d5\u05d0 \u05d4\u05e2\u05e8\u05db\u05ea \u05d4\u05d1\u05d5\u05d7\u05df \u05d4\u05de\u05d1\u05d5\u05e1\u05e1\u05ea \u05e2\u05dc \u05ea\u05e6\u05e4\u05d9\u05ea \u05d0\u05d5\u05d1\u05d9\u05d9\u05e7\u05d8\u05d9\u05d1\u05d9\u05ea (Dulcan p. 69)."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05de\u05d5\u05d2\u05d3\u05e8 \u05d4\u05de\u05d5\u05e9\u05d2 lability (\u05ea\u05e0\u05d5\u05d3\u05ea\u05d9\u05d5\u05ea) \u05d1\u05d4\u05e7\u05e9\u05e8 \u05e9\u05dc \u05d4\u05e2\u05e8\u05db\u05ea \u05de\u05e6\u05d1 \u05e8\u05d5\u05d7?",
      "back": "\u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd \u05de\u05d4\u05d9\u05e8\u05d9\u05dd \u05d1\u05de\u05e6\u05d1 \u05d4\u05e8\u05d2\u05e9\u05d9 \u05dc\u05d0\u05d5\u05e8\u05da \u05ea\u05e7\u05d5\u05e4\u05d5\u05ea \u05d6\u05de\u05df \u05e7\u05e6\u05e8\u05d5\u05ea, \u05db\u05d2\u05d5\u05df \u05de\u05e2\u05d1\u05e8 \u05ea\u05d3\u05d9\u05e8 \u05d1\u05d9\u05df \u05d0\u05d5\u05e4\u05d5\u05e8\u05d9\u05d4, \u05d3\u05d9\u05e1\u05e4\u05d5\u05e8\u05d9\u05d4 \u05d5\u05d0\u05d9\u05e8\u05d8\u05d1\u05d9\u05dc\u05d9\u05d5\u05ea (DSM p. 144)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d8\u05db\u05e0\u05d9\u05e7\u05ea \u05d4-triangulation \u05d4\u05de\u05d5\u05de\u05dc\u05e6\u05ea \u05d1-StahlKids \u05dc\u05d4\u05e2\u05e8\u05db\u05ea \u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd \u05d1\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d0\u05e6\u05dc \u05d9\u05dc\u05d3\u05d9\u05dd?",
      "back": "\u05d4\u05e6\u05dc\u05d1\u05ea \u05de\u05d9\u05d3\u05e2 \u05d1\u05d9\u05df \u05e0\u05e7\u05d5\u05d3\u05ea \u05d4\u05de\u05d1\u05d8 \u05e9\u05dc \u05d4\u05d9\u05dc\u05d3, \u05e0\u05e7\u05d5\u05d3\u05ea \u05d4\u05de\u05d1\u05d8 \u05e9\u05dc \u05d4\u05e7\u05dc\u05d9\u05e0\u05d0\u05d9 \u05d5\u05d3\u05d9\u05d5\u05d5\u05d7 \u05e9\u05dc \u05e6\u05d3 \u05e9\u05dc\u05d9\u05e9\u05d9 \u05d4\u05de\u05db\u05d9\u05e8 \u05d0\u05ea \u05d4\u05d9\u05dc\u05d3, \u05db\u05de\u05d5 \u05d4\u05d5\u05e8\u05d4 \u05d0\u05d5 \u05de\u05d5\u05e8\u05d4 (StahlKids p. 450)."
    },
    {
      "front": "\u05de\u05d3\u05d5\u05e2 \u05de\u05d5\u05de\u05dc\u05e5 \u05dc\u05d4\u05ea\u05d7\u05d9\u05dc \u05e8\u05d0\u05d9\u05d5\u05df \u05e2\u05dd \u05de\u05ea\u05d1\u05d2\u05e8 \u05d1\u05e9\u05d9\u05d7\u05d4 \u05e2\u05dc \u05ea\u05d7\u05d5\u05de\u05d9 \u05e2\u05e0\u05d9\u05d9\u05df \u05d5\u05d7\u05d5\u05d6\u05e7\u05d5\u05ea \u05d1\u05de\u05e7\u05d5\u05dd \u05d1\u05ea\u05dc\u05d5\u05e0\u05d4 \u05d4\u05de\u05e8\u05db\u05d6\u05d9\u05ea?",
      "back": "\u05db\u05d3\u05d9 \u05dc\u05d1\u05e0\u05d5\u05ea rapport \u05d5\u05dc\u05d4\u05e2\u05d1\u05d9\u05e8 \u05dc\u05de\u05ea\u05d1\u05d2\u05e8 \u05d0\u05ea \u05d4\u05de\u05e1\u05e8 \u05e9\u05d3\u05e2\u05ea\u05d5 \u05d5\u05d6\u05d4\u05d5\u05ea\u05d5 \u05d7\u05e9\u05d5\u05d1\u05d5\u05ea, \u05de\u05d4 \u05e9\u05de\u05e4\u05d7\u05d9\u05ea \u05d4\u05ea\u05e0\u05d2\u05d3\u05d5\u05ea \u05d5\u05de\u05e7\u05dc \u05e2\u05dc \u05d0\u05d9\u05e1\u05d5\u05e3 \u05e0\u05ea\u05d5\u05e0\u05d9\u05dd \u05d1\u05d4\u05de\u05e9\u05da (Dulcan p. 81)."
    },
    {
      "front": "\u05d1\u05d0\u05d9\u05d6\u05d4 \u05db\u05dc\u05d9 \u05e7\u05dc\u05d9\u05e0\u05d9 \u05de\u05d5\u05de\u05dc\u05e5 \u05dc\u05d4\u05e9\u05ea\u05de\u05e9 \u05db\u05d3\u05d9 \u05dc\u05d4\u05de\u05d7\u05d9\u05e9 \u05dc\u05d9\u05dc\u05d3\u05d9\u05dd \u05d5\u05dc\u05d4\u05d5\u05e8\u05d9\u05d4\u05dd \u05d0\u05ea \u05d4-onset \u05d5\u05d4\u05de\u05d4\u05dc\u05da \u05e9\u05dc \u05d4\u05e4\u05e8\u05e2\u05ea \u05de\u05e6\u05d1 \u05e8\u05d5\u05d7?",
      "back": "Mood timeline \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05d1\u05e2\u05d5\u05d2\u05e0\u05d9\u05dd \u05db\u05e8\u05d5\u05e0\u05d5\u05dc\u05d5\u05d2\u05d9\u05d9\u05dd \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05d9\u05dd \u05db\u05de\u05d5 \u05d7\u05d2\u05d9\u05dd, \u05d9\u05de\u05d9 \u05d4\u05d5\u05dc\u05d3\u05ea \u05d5\u05e9\u05e0\u05d5\u05ea \u05dc\u05d9\u05de\u05d5\u05d3 (Dulcan p. 256)."
    },
    {
      "front": "\u05dc\u05e4\u05d9 StahlNeuro, \u05d0\u05d9\u05d6\u05d4 \u05dc\u05d9\u05e7\u05d5\u05d9 \u05e0\u05d5\u05d9\u05e8\u05d5\u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05de\u05e7\u05d5\u05e9\u05e8 \u05dc\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e9\u05dc reduced positive affect (\u05d0\u05d5\u05d1\u05d3\u05df \u05e2\u05e0\u05d9\u05d9\u05df, \u05d4\u05e0\u05d0\u05d4 \u05d5\u05d0\u05e0\u05e8\u05d2\u05d9\u05d4)?",
      "back": "\u05dc\u05d9\u05e7\u05d5\u05d9 \u05d1\u05ea\u05e4\u05e7\u05d5\u05d3 \u05d4\u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05d3\u05d5\u05e4\u05de\u05d9\u05e0\u05e8\u05d2\u05d9\u05ea (DA), \u05e2\u05dd \u05de\u05e2\u05d5\u05e8\u05d1\u05d5\u05ea \u05d0\u05e4\u05e9\u05e8\u05d9\u05ea \u05e9\u05dc \u05d4\u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05e0\u05d5\u05e8\u05d0\u05d3\u05e8\u05e0\u05e8\u05d2\u05d9\u05ea (NE) (StahlNeuro p. 279)."
    },
    {
      "front": "\u05dc\u05e4\u05d9 StahlNeuro, \u05d0\u05d9\u05d6\u05d4 \u05dc\u05d9\u05e7\u05d5\u05d9 \u05e0\u05d5\u05d9\u05e8\u05d5\u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05de\u05e7\u05d5\u05e9\u05e8 \u05dc\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e9\u05dc increased negative affect (\u05d0\u05e9\u05de\u05d4, \u05e4\u05d7\u05d3, \u05e2\u05d5\u05d9\u05e0\u05d5\u05ea \u05d5\u05d0\u05d9\u05e8\u05d8\u05d1\u05d9\u05dc\u05d9\u05d5\u05ea)?",
      "back": "\u05dc\u05d9\u05e7\u05d5\u05d9 \u05d1\u05ea\u05e4\u05e7\u05d5\u05d3 \u05d4\u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05e1\u05e8\u05d5\u05d8\u05d5\u05e0\u05d9\u05e0\u05e8\u05d2\u05d9\u05ea (5HT), \u05e2\u05dd \u05de\u05e2\u05d5\u05e8\u05d1\u05d5\u05ea \u05d0\u05e4\u05e9\u05e8\u05d9\u05ea \u05e9\u05dc \u05d4\u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05e0\u05d5\u05e8\u05d0\u05d3\u05e8\u05e0\u05e8\u05d2\u05d9\u05ea (NE) (StahlNeuro p. 279)."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05e2\u05e9\u05d5\u05d9 \u05dc\u05d4\u05ea\u05d1\u05d8\u05d0 \u05de\u05e6\u05d1 \u05e8\u05d5\u05d7 \u05de\u05d0\u05e0\u05d9 (Criterion A) \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d1\u05d0\u05d5\u05e4\u05df \u05d4\u05e9\u05d5\u05e0\u05d4 \u05de\u05d4\u05e6\u05d2\u05ea \u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd \u05d8\u05d9\u05e4\u05d5\u05e1\u05d9\u05ea?",
      "back": "\u05d3\u05e8\u05da \u05e9\u05d8\u05d5\u05ea\u05d9\u05d5\u05ea (\" + \"goofiness\" +"
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05d7\u05e9\u05d9\u05d1\u05d5\u05ea \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05e9\u05dc \u05e9\u05d0\u05dc\u05ea \"\u05e9\u05dc\u05d5\u05e9 \u05d4\u05de\u05e9\u05d0\u05dc\u05d5\u05ea\" \u05d1\u05e8\u05d0\u05d9\u05d5\u05df \u05e2\u05dd \u05d9\u05dc\u05d3\u05d9\u05dd \u05d1\u05d2\u05d9\u05dc \u05d4\u05d7\u05d1\u05d9\u05d5\u05df (Latency)?",
      "back": "\u05d4\u05d9\u05d0 \u05de\u05e1\u05e4\u05e7\u05ea \u05de\u05d9\u05d3\u05e2 \u05e2\u05dc \u05d4\u05e2\u05e8\u05db\u05d9\u05dd \u05e9\u05dc \u05d4\u05d9\u05dc\u05d3 \u05d5\u05e2\u05dc \u05d4\u05d3\u05d1\u05e8\u05d9\u05dd \u05e9\u05d4\u05d9\u05d4 \u05e8\u05d5\u05e6\u05d4 \u05dc\u05e9\u05e0\u05d5\u05ea \u05d1\u05d7\u05d9\u05d9\u05d5 \u05d1\u05d0\u05d5\u05e4\u05df \u05dc\u05d0 \u05de\u05d0\u05d9\u05d9\u05dd (Dulcan p. 10)."
    },
    {
      "front": "\u05d4\u05d2\u05d3\u05e8 \u05d0\u05ea \u05d4\u05de\u05d5\u05e9\u05d2 Mood reactivity \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05e2\u05dd Atypical features.",
      "back": "\u05d4\u05d9\u05db\u05d5\u05dc\u05ea \u05e9\u05dc \u05de\u05e6\u05d1 \u05d4\u05e8\u05d5\u05d7 \u05dc\u05d4\u05e9\u05ea\u05e4\u05e8 \u05d5\u05dc\u05d4\u05e4\u05d5\u05da \u05dc-euthymic \u05d6\u05de\u05e0\u05d9\u05ea \u05d1\u05ea\u05d2\u05d5\u05d1\u05d4 \u05dc\u05d0\u05d9\u05e8\u05d5\u05e2\u05d9\u05dd \u05d7\u05d9\u05d5\u05d1\u05d9\u05d9\u05dd (DSM p. 173)."
    },
    {
      "front": "\u05de\u05d3\u05d5\u05e2 \u05de\u05d5\u05de\u05dc\u05e5 \u05dc\u05d4\u05d9\u05de\u05e0\u05e2 \u05de\u05e9\u05d0\u05dc\u05d5\u05ea \"\u05dc\u05de\u05d4\" (Why) \u05d1\u05e8\u05d0\u05d9\u05d5\u05df \u05e2\u05dd \u05d9\u05dc\u05d3\u05d9\u05dd \u05d5\u05d1\u05de\u05e7\u05d5\u05dd \u05d6\u05d0\u05ea \u05dc\u05d4\u05e9\u05ea\u05de\u05e9 \u05d1\u05e9\u05d0\u05dc\u05d5\u05ea \"\u05de\u05d4\" \u05d0\u05d5 \"\u05d0\u05d9\u05da\"?",
      "back": "\u05e9\u05d0\u05dc\u05d5\u05ea \"\u05dc\u05de\u05d4\" \u05d3\u05d5\u05e8\u05e9\u05d5\u05ea \u05d7\u05e9\u05d9\u05d1\u05d4 \u05d0\u05e0\u05dc\u05d9\u05d8\u05d9\u05ea \u05de\u05d5\u05e4\u05e9\u05d8\u05ea \u05e9\u05e2\u05dc\u05d5\u05dc\u05d4 \u05dc\u05d4\u05d9\u05d5\u05ea \u05de\u05e2\u05d1\u05e8 \u05dc\u05d9\u05db\u05d5\u05dc\u05ea \u05d4\u05d9\u05dc\u05d3, \u05de\u05d4 \u05e9\u05de\u05d5\u05d1\u05d9\u05dc \u05dc\u05e8\u05d5\u05d1 \u05dc\u05ea\u05e9\u05d5\u05d1\u05d4 \"\u05d0\u05e0\u05d9 \u05dc\u05d0 \u05d9\u05d5\u05d3\u05e2\" (Dulcan p. 68)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05d4\u05d9\u05d9\u05d7\u05d5\u05d3\u05d9 \u05e9\u05dc \u05de\u05e6\u05d1 \u05d4\u05e8\u05d5\u05d7 \u05d1-Major Depressive Episode \u05e2\u05dd melancholic features?",
      "back": "\u05d0\u05d9\u05db\u05d5\u05ea \"\u05e0\u05d1\u05d3\u05dc\u05ea\" (distinct quality) \u05e9\u05dc \u05d9\u05d9\u05d0\u05d5\u05e9 \u05e2\u05de\u05d5\u05e7, \u05d3\u05db\u05d3\u05d5\u05da \u05d0\u05d5 \u05ea\u05d7\u05d5\u05e9\u05ea \u05e8\u05d9\u05e7\u05e0\u05d5\u05ea (\" + \"empty mood\" + \") (DSM p. 172)."
    },
    {
      "front": "\u05d0\u05d9\u05dc\u05d5 \u05d0\u05e8\u05d1\u05e2\u05d4 \u05de\u05de\u05d3\u05d9\u05dd \u05de\u05e8\u05db\u05d6\u05d9\u05d9\u05dd \u05d9\u05e9 \u05dc\u05d4\u05e2\u05e8\u05d9\u05da \u05d1\u05ea\u05d9\u05d0\u05d5\u05e8 \u05d4-Affect \u05d1\u05d1\u05d3\u05d9\u05e7\u05ea \u05d4-MSE \u05e9\u05dc \u05d9\u05dc\u05d3?",
      "back": "\u05d0\u05d9\u05db\u05d5\u05ea (Quality), \u05d9\u05e6\u05d9\u05d1\u05d5\u05ea (Stability), \u05e2\u05d5\u05e6\u05de\u05d4 (Intensity) \u05d5\u05d4\u05ea\u05d0\u05de\u05d4 \u05dc\u05e1\u05d9\u05d8\u05d5\u05d0\u05e6\u05d9\u05d4 \u05d5\u05dc\u05ea\u05d5\u05db\u05df \u05d4\u05de\u05d7\u05e9\u05d1\u05d4 (Appropriateness) (Dulcan p. 69)."
    },
    {
      "front": "\u05de\u05d3\u05d5\u05e2 \u05d0\u05d9\u05df \u05dc\u05d0\u05d1\u05d7\u05df Personality Disorder \u05d1\u05de\u05d4\u05dc\u05da \u05d0\u05e4\u05d9\u05d6\u05d5\u05d3\u05d4 \u05e9\u05dc \u05d4\u05e4\u05e8\u05e2\u05ea \u05de\u05e6\u05d1 \u05e8\u05d5\u05d7 \u05e4\u05e2\u05d9\u05dc\u05d4 \u05d5\u05dc\u05d0 \u05de\u05d8\u05d5\u05e4\u05dc\u05ea?",
      "back": "\u05de\u05db\u05d9\u05d5\u05d5\u05df \u05e9\u05ea\u05e1\u05de\u05d9\u05e0\u05d9 \u05d4\u05d0\u05e4\u05d9\u05d6\u05d5\u05d3\u05d4 (\u05db\u05de\u05d5 \u05d0\u05d9\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05d5\u05ea \u05d0\u05d5 lability) \u05e2\u05dc\u05d5\u05dc\u05d9\u05dd \u05dc\u05d4\u05d9\u05e8\u05d0\u05d5\u05ea \u05db\u05d4\u05e4\u05e8\u05e2\u05ea \u05d0\u05d9\u05e9\u05d9\u05d5\u05ea \u05de\u05d1\u05dc\u05d9 \u05dc\u05e9\u05e7\u05e3 \u05d0\u05ea \u05d4\u05ea\u05e4\u05e7\u05d5\u05d3 \u05d4\u05e7\u05d1\u05d5\u05e2 \u05e9\u05dc \u05d4\u05de\u05d8\u05d5\u05e4\u05dc (DSM p. 151)."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05de\u05e9\u05e4\u05d9\u05e2\u05d9\u05dd Cultural considerations \u05e2\u05dc \u05d4\u05e2\u05e8\u05db\u05ea Affect \u05d5\u05d1\u05d9\u05d8\u05d5\u05d9 \u05e8\u05d2\u05e9\u05d5\u05ea \u05d1\u05d1\u05d3\u05d9\u05e7\u05d4?",
      "back": "\u05d4\u05ea\u05e8\u05d1\u05d5\u05ea \u05e7\u05d5\u05d1\u05e2\u05ea \u05d0\u05ea \u05d4-overtness \u05d0\u05d5 \u05d4-covertness \u05e9\u05dc \u05d4\u05d1\u05e2\u05ea \u05d4\u05e8\u05d2\u05e9\u05d5\u05ea \u05d5\u05de\u05d4 \u05e0\u05d7\u05e9\u05d1 \u05dc\u05ea\u05d2\u05d5\u05d1\u05d4 \u05d4\u05d5\u05dc\u05de\u05ea \u05dc\u05e1\u05d8\u05e8\u05e1 \u05d0\u05d5 \u05d0\u05d5\u05d1\u05d3\u05df (DSM p. 331)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05de\u05d1\u05d3\u05dc\u05ea \u05d4\u05de\u05e8\u05db\u05d6\u05d9\u05ea \u05d1\u05d9\u05df \u05d0\u05d9\u05e8\u05d8\u05d1\u05d9\u05dc\u05d9\u05d5\u05ea \u05db\u05d7\u05dc\u05e7 \u05de-ADHD \u05dc\u05d1\u05d9\u05df \u05d0\u05d9\u05e8\u05d8\u05d1\u05d9\u05dc\u05d9\u05d5\u05ea \u05d1-DMDD?",
      "back": "\u05d1-DMDD \u05d4\u05d0\u05d9\u05e8\u05d8\u05d1\u05d9\u05dc\u05d9\u05d5\u05ea \u05d4\u05d9\u05d0 \u05db\u05e8\u05d5\u05e0\u05d9\u05ea, \u05e0\u05d5\u05db\u05d7\u05ea \u05e8\u05d5\u05d1 \u05d4\u05d9\u05d5\u05dd \u05d5\u05db\u05de\u05e2\u05d8 \u05db\u05dc \u05d9\u05d5\u05dd \u05d1\u05d9\u05df \u05d4\u05d4\u05ea\u05e4\u05e8\u05e6\u05d5\u05d9\u05d5\u05ea, \u05d1\u05e0\u05d9\u05d2\u05d5\u05d3 \u05dc\u05d0\u05d9\u05e8\u05d8\u05d1\u05d9\u05dc\u05d9\u05d5\u05ea \u05ea\u05d2\u05d5\u05d1\u05ea\u05d9\u05ea \u05d1-ADHD (Dulcan p. 12)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05e9\u05dc \u05d4-Affect \u05d1\u05de\u05e4\u05e8\u05d8 \u05e9\u05dc Conduct Disorder \u05e2\u05dd limited prosocial emotions?",
      "back": "\u05d0\u05e4\u05e7\u05d8 \u05e8\u05d3\u05d5\u05d3 \u05d0\u05d5 \u05d7\u05e1\u05e8 (Shallow or deficient affect), \u05e9\u05d1\u05d5 \u05d4\u05d1\u05e2\u05ea \u05d4\u05e8\u05d2\u05e9\u05d5\u05ea \u05d0\u05d9\u05e0\u05d4 \u05db\u05e0\u05d4 \u05d0\u05d5 \u05de\u05e9\u05de\u05e9\u05ea \u05dc\u05d4\u05e9\u05d2\u05ea \u05e8\u05d5\u05d5\u05d7 \u05d5\u05de\u05e0\u05d9\u05e4\u05d5\u05dc\u05e6\u05d9\u05d4 (Dulcan p. 199)."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05ea\u05e4\u05d9\u05e1\u05ea \u05d4-Self-esteem \u05de\u05e9\u05ea\u05e0\u05d4 \u05d1\u05d9\u05df \u05d0\u05d1\u05dc (Grief) \u05dc\u05d1\u05d9\u05df Major Depressive Episode?",
      "back": "\u05d1\u05d0\u05d1\u05dc \u05d4-Self-esteem \u05dc\u05e8\u05d5\u05d1 \u05e0\u05e9\u05de\u05e8, \u05d1\u05e2\u05d5\u05d3 \u05e9\u05d1-MDE \u05e0\u05e4\u05d5\u05e6\u05d5\u05ea \u05ea\u05d7\u05d5\u05e9\u05d5\u05ea \u05e9\u05dc \u05d7\u05d5\u05e1\u05e8 \u05e2\u05e8\u05da (worthlessness) \u05d5\u05ea\u05d9\u05e2\u05d5\u05d1 \u05e2\u05e6\u05de\u05d9 (Dulcan p. 296)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05de\u05d8\u05e8\u05ea \u05d4\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1-Structured Interviews \u05db\u05de\u05d5 \u05d4-K-SADS \u05d1\u05d4\u05e2\u05e8\u05db\u05ea \u05de\u05e6\u05d1 \u05e8\u05d5\u05d7 \u05d0\u05e6\u05dc \u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd?",
      "back": "\u05d4\u05dd \u05de\u05d0\u05e4\u05e9\u05e8\u05d9\u05dd \u05d4\u05e2\u05e8\u05db\u05d4 \u05de\u05e7\u05d9\u05e4\u05d4 \u05d5\u05d0\u05d5\u05d1\u05d9\u05d9\u05e7\u05d8\u05d9\u05d1\u05d9\u05ea \u05d9\u05d5\u05ea\u05e8, \u05db\u05e9\u05d4\u05e4\u05d5\u05e8\u05de\u05d8 \u05d4\u05de\u05d5\u05d1\u05e0\u05d4 (\u05d0\u05d5 \u05d4\u05de\u05de\u05d5\u05d7\u05e9\u05d1) \u05e2\u05e9\u05d5\u05d9 \u05dc\u05d4\u05e4\u05d7\u05d9\u05ea \u05de\u05d1\u05d5\u05db\u05d4 \u05d5\u05dc\u05e2\u05d5\u05d3\u05d3 \u05d3\u05d9\u05d5\u05d5\u05d7 \u05d0\u05de\u05d9\u05df (Dulcan p. 87)."
    },
    {
      "front": "\u05d4\u05d2\u05d3\u05e8 \u05d0\u05ea \u05d4\u05de\u05d5\u05e9\u05d2 temperament \u05dc\u05e4\u05d9 \u05de\u05d5\u05d3\u05dc \u05d4-perspectives of psychiatry \u05d5\u05db\u05d9\u05e6\u05d3 \u05d4\u05d5\u05d0 \u05de\u05e9\u05e4\u05d9\u05e2 \u05e2\u05dc \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4.",
      "back": "\u05d6\u05d4\u05d5 \u05d4\u05de\u05de\u05d3 \u05d4\u05de\u05d5\u05dc\u05d3 (Dimension) \u05e9\u05dc \u05d4\u05d0\u05d9\u05e9\u05d9\u05d5\u05ea, \u05d4\u05de\u05d2\u05d3\u05d9\u05e8 \u05e0\u05d8\u05d9\u05d5\u05ea \u05d1\u05e1\u05d9\u05e1\u05d9\u05d5\u05ea \u05db\u05de\u05d5 \u05e8\u05d2\u05d9\u05e9\u05d5\u05ea \u05d0\u05d5 \u05d0\u05d9\u05e0\u05d8\u05e0\u05e1\u05d9\u05d1\u05d9\u05d5\u05ea \u05e8\u05d2\u05e9\u05d9\u05ea \u05e9\u05de\u05d4\u05d5\u05d5\u05ea \u05e8\u05e7\u05e2 \u05dc\u05d4\u05e4\u05e8\u05e2\u05d4 (Dulcan p. 12)."
    }
  ]
}