        {
          "text": "\u05db\u05d3\u05d9 \u05dc\u05de\u05e0\u05d5\u05e2 Side Effects \u05e9\u05dc \u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05db\u05de\u05d5 Chlorpromazine.",
          "isCorrect": false,
