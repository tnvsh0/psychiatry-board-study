      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05d9\u05dc\u05d3 \u05db\u05e2\u05dc \"Moving Target\" \u05de\u05d1\u05d7\u05d9\u05e0\u05d4 \u05e7\u05dc\u05d9\u05e0\u05d9\u05ea."
    },
    {
      "question": "\u05d1\u05de\u05d4\u05dc\u05da Mental Status Examination \u05e9\u05dc \u05d9\u05dc\u05d3 \u05d1\u05d2\u05d9\u05dc \u05d1\u05d9\u05ea \u05d4\u05e1\u05e4\u05e8 \u05d4\u05d9\u05e1\u05d5\u05d3\u05d9, \u05db\u05d9\u05e6\u05d3 \u05d9\u05e9 \u05dc\u05d4\u05e2\u05e8\u05d9\u05da \u05d0\u05ea \u05d4-Thought Process \u05d5\u05d4-Thought Content \u05d1\u05d4\u05ea\u05d0\u05dd \u05dc\u05e9\u05dc\u05d1 \u05d4\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9?",
      "answerOptions": [
