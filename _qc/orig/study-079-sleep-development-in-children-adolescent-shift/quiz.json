    {
      "type": "multiple_select",
      "question": "\u05d0\u05d9\u05dc\u05d5 \u05de\u05d4\u05d1\u05d0\u05d9\u05dd \u05e0\u05d7\u05e9\u05d1\u05d9\u05dd \u05dc\u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9\u05dd \u05ea\u05e7\u05d9\u05e0\u05d9\u05dd \u05e9\u05dc \u05d0\u05e8\u05db\u05d9\u05d8\u05e7\u05d8\u05d5\u05e8\u05ea \u05d4\u05e9\u05d9\u05e0\u05d4 (Sleep Architecture) \u05d1\u05ea\u05d9\u05e0\u05d5\u05e7\u05d5\u05ea (Infants) \u05de\u05ea\u05d7\u05ea \u05dc\u05d2\u05d9\u05dc 6 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd, \u05d1\u05e9\u05d5\u05e0\u05d4 \u05de\u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd? (\u05d1\u05d7\u05e8\u05d5 \u05d0\u05ea \u05db\u05dc \u05d4\u05ea\u05e9\u05d5\u05d1\u05d5\u05ea \u05d4\u05e0\u05db\u05d5\u05e0\u05d5\u05ea)",
      "answerOptions": [
        {
          "text": "\u05db-50% \u05de\u05d6\u05de\u05df \u05d4\u05e9\u05d9\u05e0\u05d4 \u05d4\u05db\u05d5\u05dc\u05dc \u05de\u05d5\u05e9\u05e7\u05e2 \u05d1\u05e9\u05e0\u05ea REM (\u05d4\u05e0\u05e7\u05e8\u05d0\u05ea Active Sleep).",
          "isCorrect": true,
          "rationale": "\u05ea\u05d9\u05e0\u05d5\u05e7\u05d5\u05ea \u05de\u05d1\u05dc\u05d9\u05dd \u05d0\u05d7\u05d5\u05d6 \u05e0\u05d9\u05db\u05e8 \u05de\u05d6\u05de\u05e0\u05dd \u05d1\u05e9\u05e0\u05ea REM, \u05e4\u05d9 2\u20132.5 \u05de\u05d0\u05e9\u05e8 \u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd (DSM p.408, Dulcan p.473)."
        },
        {
          "text": "\u05db\u05e0\u05d9\u05e1\u05d4 \u05d9\u05e9\u05d9\u05e8\u05d4 \u05de\u05d4\u05e2\u05e8\u05d5\u05ea \u05dc\u05e9\u05e0\u05ea REM (\u05ea\u05d5\u05e4\u05e2\u05ea Sleep-Onset REM).",
          "isCorrect": true,
          "rationale": "\u05d1\u05ea\u05d9\u05e0\u05d5\u05e7\u05d5\u05ea \u05e8\u05db\u05d9\u05dd, \u05de\u05e2\u05d1\u05e8 \u05d9\u05e9\u05d9\u05e8 \u05dc-REM \u05d4\u05d5\u05d0 \u05e4\u05d9\u05d6\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d5\u05ea\u05e7\u05d9\u05df, \u05d1\u05e2\u05d5\u05d3 \u05e9\u05d1\u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd \u05d4\u05d5\u05d0 \u05e2\u05e9\u05d5\u05d9 \u05dc\u05d4\u05e2\u05d9\u05d3 \u05e2\u05dc \u05e0\u05e8\u05e7\u05d5\u05dc\u05e4\u05e1\u05d9\u05d4 \u05d0\u05d5 \u05d7\u05e1\u05da \u05e9\u05d9\u05e0\u05d4 \u05e7\u05d9\u05e6\u05d5\u05e0\u05d9 (DSM p.408, p.422)."
        },
        {
          "text": "\u05de\u05d7\u05d6\u05d5\u05e8 \u05e9\u05d9\u05e0\u05d4 \u05d0\u05d5\u05dc\u05d8\u05e8\u05d3\u05d9\u05d0\u05e0\u05d9 \u05e7\u05e6\u05e8 \u05e9\u05dc \u05db-50\u201360 \u05d3\u05e7\u05d5\u05ea.",
          "isCorrect": true,
          "rationale": "\u05de\u05d7\u05d6\u05d5\u05e8\u05d9 \u05d4\u05e9\u05d9\u05e0\u05d4 \u05e9\u05dc \u05ea\u05d9\u05e0\u05d5\u05e7\u05d5\u05ea \u05e7\u05e6\u05e8\u05d9\u05dd \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05de\u05d0\u05dc\u05d5 \u05e9\u05dc \u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd (80\u2013100 \u05d3\u05e7\u05d5\u05ea) (Dulcan p.473)."
        },
        {
          "text": "\u05d4\u05d9\u05e2\u05d3\u05e8 \u05de\u05d5\u05d7\u05dc\u05d8 \u05e9\u05dc \u05e9\u05e0\u05ea N3 (Slow-Wave Sleep) \u05e2\u05d3 \u05d2\u05d9\u05dc \u05e9\u05e0\u05d4.",
          "isCorrect": false,
          "rationale": "\u05e9\u05e0\u05ea NREM (\u05db\u05d5\u05dc\u05dc \u05e9\u05dc\u05d1\u05d9\u05dd \u05e2\u05de\u05d5\u05e7\u05d9\u05dd) \u05e7\u05d9\u05d9\u05de\u05ea \u05d1\u05ea\u05d9\u05e0\u05d5\u05e7\u05d5\u05ea, \u05d0\u05da \u05d4\u05d0\u05e8\u05d2\u05d5\u05df \u05e9\u05dc\u05d4 \u05e9\u05d5\u05e0\u05d4 \u05d5\u05d4\u05d9\u05d0 \u05de\u05ea\u05d2\u05d1\u05e9\u05ea \u05d1\u05de\u05d4\u05dc\u05da 6 \u05d4\u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05d4\u05e8\u05d0\u05e9\u05d5\u05e0\u05d9\u05dd (Dulcan p.473)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d1\u05d5 \u05e2\u05dc \u05d4\u05d4\u05d1\u05d3\u05dc\u05d9\u05dd \u05d1\u05e0\u05e4\u05d7 \u05e9\u05e0\u05ea \u05d4-REM \u05d5\u05d1\u05d0\u05d5\u05e8\u05da \u05de\u05d7\u05d6\u05d5\u05e8 \u05d4\u05e9\u05d9\u05e0\u05d4 \u05d4\u05d1\u05d5\u05d3\u05d3.",
