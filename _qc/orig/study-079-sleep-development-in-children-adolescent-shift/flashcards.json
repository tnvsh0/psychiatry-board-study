{
  "title": "Sleep Flashcards",
  "cards": [
    {
      "front": "\u05de\u05d4\u05d5 \u05d0\u05d7\u05d5\u05d6 \u05e9\u05e0\u05ea \u05d4-REM \u05de\u05ea\u05d5\u05da \u05d6\u05de\u05df \u05d4\u05e9\u05d9\u05e0\u05d4 \u05d4\u05db\u05d5\u05dc\u05dc (TST) \u05d1\u05e7\u05e8\u05d1 \u05d9\u05d9\u05dc\u05d5\u05d3\u05d9\u05dd?",
      "back": "\u05d4-REM \u05de\u05d4\u05d5\u05d5\u05d4 \u05db-50% \u05de\u05d6\u05de\u05df \u05d4\u05e9\u05d9\u05e0\u05d4 \u05d4\u05db\u05d5\u05dc\u05dc (\u05de\u05db\u05d5\u05e0\u05d4 \u05d2\u05dd Active Sleep). (Dulcan p.473, DSM p.408)"
    },
    {
      "front": "\u05d1\u05d0\u05d9\u05d6\u05d4 \u05d2\u05d9\u05dc \u05de\u05d5\u05e4\u05d9\u05e2\u05d4 \u05dc\u05e8\u05d0\u05e9\u05d5\u05e0\u05d4 \u05d4\u05ea\u05d5\u05e4\u05e2\u05d4 \u05d4\u05e4\u05d9\u05d6\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea \u05e9\u05dc \u05de\u05e2\u05d1\u05e8 \u05d9\u05e9\u05d9\u05e8 \u05de\u05e2\u05e8\u05d5\u05ea \u05dc\u05e9\u05e0\u05ea REM (\u05ea\u05d5\u05e4\u05e2\u05ea SOREMP)?",
      "back": "\u05d1\u05ea\u05d9\u05e0\u05d5\u05e7\u05d5\u05ea \u05e8\u05db\u05d9\u05dd \u05de\u05ea\u05d7\u05ea \u05dc\u05d2\u05d9\u05dc 6 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd (\u05d1\u05e0\u05d9\u05d2\u05d5\u05d3 \u05dc\u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd, \u05e9\u05dd \u05d6\u05d4\u05d5 \u05de\u05de\u05d3 \u05e4\u05ea\u05d5\u05dc\u05d5\u05d2\u05d9). (DSM p.408, p.422)"
    },
    {
      "front": "\u05de\u05d3\u05d5\u05e2 \u05e4\u05e8\u05d0\u05e1\u05d5\u05de\u05e0\u05d9\u05d5\u05ea \u05de\u05e1\u05d5\u05d2 NREM Arousal Disorders (\u05db\u05d2\u05d5\u05df Sleepwalking) \u05de\u05d2\u05d9\u05e2\u05d5\u05ea \u05dc\u05e9\u05d9\u05d0 \u05e9\u05db\u05d9\u05d7\u05d5\u05ea\u05df \u05d1\u05d2\u05d9\u05dc\u05d0\u05d9 4\u201312?",
      "back": "\u05d1\u05e9\u05dc \u05d4\u05e0\u05e4\u05d7 \u05d4\u05de\u05e7\u05e1\u05d9\u05de\u05dc\u05d9 \u05d5\u05d4\u05e2\u05d5\u05de\u05e7 \u05d4\u05e4\u05d9\u05d6\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d4\u05e8\u05d1 \u05e9\u05dc \u05e9\u05e0\u05ea N3/SWS \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9\u05dd \u05d2\u05d9\u05dc \u05d6\u05d4. (Dulcan p.488, DSM p.408)"
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05e9\u05d9\u05e0\u05d5\u05d9 \u05d4\u05d3\u05e8\u05de\u05d8\u05d9 \u05d4\u05de\u05ea\u05e8\u05d7\u05e9 \u05d1\u05db\u05de\u05d5\u05ea \u05e9\u05e0\u05ea \u05d4-N3 (Slow-Wave Sleep) \u05d1\u05de\u05d4\u05dc\u05da \u05d2\u05d9\u05dc \u05d4\u05d4\u05ea\u05d1\u05d2\u05e8\u05d5\u05ea (Puberty)?",
      "back": "\u05d7\u05dc\u05d4 \u05d9\u05e8\u05d9\u05d3\u05d4 \u05e4\u05d9\u05d6\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea \u05ea\u05dc\u05d5\u05dc\u05d4 \u05e9\u05dc \u05e2\u05d3 40% \u05d1\u05db\u05de\u05d5\u05ea \u05e9\u05e0\u05ea \u05d4-N3. (DSM p.408, Dulcan p.490)"
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05de\u05e9\u05da \u05d4\u05e9\u05d9\u05e0\u05d4 \u05d4\u05de\u05d5\u05de\u05dc\u05e5 (TST) \u05e2\u05d1\u05d5\u05e8 \u05d9\u05dc\u05d3\u05d9\u05dd \u05d1\u05d2\u05d9\u05dc \u05d4\u05e8\u05da (Preschoolers) \u05d1\u05d2\u05d9\u05dc\u05d0\u05d9 3\u20135 \u05e9\u05e0\u05d9\u05dd?",
      "back": "10 \u05e2\u05d3 13 \u05e9\u05e2\u05d5\u05ea \u05d1\u05d9\u05de\u05de\u05d4 (\u05db\u05d5\u05dc\u05dc \u05e9\u05e0\u05ea \u05e6\u05d4\u05e8\u05d9\u05d9\u05dd). (Dulcan p.478)"
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05de\u05de\u05d5\u05e6\u05e2 \u05e9\u05e2\u05d5\u05ea \u05d4\u05e9\u05d9\u05e0\u05d4 \u05d4\u05dc\u05d9\u05dc\u05d9 \u05d4\u05e0\u05d3\u05e8\u05e9 \u05e2\u05d1\u05d5\u05e8 \u05d9\u05dc\u05d3\u05d9\u05dd \u05d1\u05d2\u05d9\u05dc \u05d1\u05d9\u05ea \u05d4\u05e1\u05e4\u05e8 \u05d4\u05d9\u05e1\u05d5\u05d3\u05d9 (6\u201312 \u05e9\u05e0\u05d9\u05dd)?",
      "back": "\u05de\u05de\u05d5\u05e6\u05e2 \u05e9\u05dc 10 \u05e9\u05e2\u05d5\u05ea \u05d1\u05dc\u05d9\u05dc\u05d4 (\u05d8\u05d5\u05d5\u05d7 \u05ea\u05e7\u05d9\u05df: 9\u201311 \u05e9\u05e2\u05d5\u05ea). (Dulcan p.478)"
    },
    {
      "front": "\u05dc\u05e4\u05d9 \u05e0\u05d9\u05d9\u05e8 \u05d4\u05e2\u05de\u05d3\u05d4 \u05e9\u05dc \u05d4-AAP, \u05de\u05d4\u05d5 \u05de\u05e9\u05da \u05d4\u05e9\u05d9\u05e0\u05d4 \u05d4\u05d0\u05d5\u05e4\u05d8\u05d9\u05de\u05dc\u05d9 \u05e2\u05d1\u05d5\u05e8 \u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd \u05dc\u05e9\u05de\u05d9\u05e8\u05d4 \u05e2\u05dc \u05d1\u05e8\u05d9\u05d0\u05d5\u05ea \u05e0\u05e4\u05e9\u05d9\u05ea \u05d5\u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9\u05ea?",
      "back": "8.5 \u05e2\u05d3 9 \u05e9\u05e2\u05d5\u05ea \u05d1\u05dc\u05d9\u05dc\u05d4. (Dulcan p.491)"
    },
    {
      "front": "\u05d4\u05e9\u05dc\u05de\u05ea \u05e9\u05d9\u05e0\u05d4 \u05d1\u05e1\u05d5\u05e4\u05d9 \u05e9\u05d1\u05d5\u05e2 (Sleeping in) \u05d1\u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd \u05e2\u05dd \u05d7\u05e1\u05da \u05e9\u05d9\u05e0\u05d4 \u05db\u05e8\u05d5\u05e0\u05d9 \u05d2\u05d5\u05e8\u05de\u05ea \u05dc_____.",
      "back": "\u05d4\u05d7\u05de\u05e8\u05d4 \u05e9\u05dc \u05d4-Circadian Phase Delay \u05e2\u05e7\u05d1 \u05de\u05e0\u05d9\u05e2\u05ea \u05d7\u05e9\u05d9\u05e4\u05d4 \u05dc\u05d0\u05d5\u05e8 \u05d1\u05d5\u05e7\u05e8 \u05d4\u05de\u05d0\u05e4\u05e1 \u05d0\u05ea \u05d4\u05e9\u05e2\u05d5\u05df. (Dulcan p.491, DSM p.445)"
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05de\u05d5\u05d2\u05d3\u05e8 \u05d4\u05de\u05d5\u05e0\u05d7 Social Jetlag \u05d1\u05d4\u05e7\u05e9\u05e8 \u05e9\u05dc \u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd?",
      "back": "\u05d7\u05d5\u05e1\u05e8 \u05d4\u05ea\u05d0\u05de\u05d4 \u05e7\u05d9\u05e6\u05d5\u05e0\u05d9 \u05d1\u05d9\u05df \u05d4\u05e9\u05e2\u05d5\u05df \u05d4\u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d4\u05de\u05e2\u05d5\u05db\u05d1 \u05dc\u05d1\u05d9\u05df \u05d3\u05e8\u05d9\u05e9\u05d5\u05ea \u05d4\u05e9\u05e2\u05d5\u05df \u05d4\u05d7\u05d1\u05e8\u05ea\u05d9/\u05dc\u05d9\u05de\u05d5\u05d3\u05d9. (Dulcan p.491)"
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d3\u05e4\u05d5\u05e1 \u05d4\u05e7\u05e9\u05e8 (Pattern) \u05e9\u05e0\u05de\u05e6\u05d0 \u05d1\u05de\u05d8\u05d4-\u05d0\u05e0\u05dc\u05d9\u05d6\u05d4 \u05d1\u05d9\u05df \u05de\u05e9\u05da \u05e9\u05d9\u05e0\u05d4 \u05dc\u05d1\u05d9\u05df \u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05d0\u05d5\u05d1\u05d3\u05e0\u05d5\u05ea \u05d1\u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd?",
      "back": "\u05d3\u05e4\u05d5\u05e1 \u05d1\u05e6\u05d5\u05e8\u05ea U: \u05e1\u05d9\u05db\u05d5\u05df \u05e9\u05d9\u05d0 \u05d1\u05e9\u05d9\u05e0\u05d4 \u05e9\u05dc \u05e4\u05d7\u05d5\u05ea \u05de-6 \u05e9\u05e2\u05d5\u05ea, \u05d5\u05e1\u05d9\u05db\u05d5\u05df \u05de\u05d5\u05d2\u05d1\u05e8 \u05d1\u05e9\u05d9\u05e0\u05d4 \u05de\u05e2\u05dc 10 \u05e9\u05e2\u05d5\u05ea. (Dulcan p.554)"
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05de\u05ea\u05d1\u05d8\u05d0 \u05d7\u05e1\u05da \u05e9\u05d9\u05e0\u05d4 \u05db\u05e8\u05d5\u05e0\u05d9 \u05d1\u05d0\u05d5\u05e4\u05df \u05e4\u05e8\u05d3\u05d5\u05e7\u05e1\u05dc\u05d9 \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd (\u05d1\u05e0\u05d9\u05d2\u05d5\u05d3 \u05dc\u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd)?",
      "back": "\u05d1\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d3\u05de\u05d5\u05d9\u05ea ADHD: \u05d4\u05d9\u05e4\u05e8\u05d0\u05e7\u05d8\u05d9\u05d1\u05d9\u05d5\u05ea, \u05d0\u05d9\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05d5\u05ea, \u05e2\u05e6\u05d1\u05e0\u05d5\u05ea \u05d5\u05e7\u05d5\u05e9\u05d9 \u05d1\u05d5\u05d5\u05d9\u05e1\u05d5\u05ea \u05e8\u05d2\u05e9\u05d9. (DSM p.432, Dulcan p.491)"
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05e9\u05d9\u05e0\u05d5\u05d9 \u05d4\u05e4\u05d9\u05d6\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d4\u05de\u05ea\u05e8\u05d7\u05e9 \u05d1-DLMO (Dim Light Melatonin Onset) \u05e2\u05dd \u05d4\u05db\u05e0\u05d9\u05e1\u05d4 \u05dc\u05d2\u05d9\u05dc \u05d4\u05d4\u05ea\u05d1\u05d2\u05e8\u05d5\u05ea?",
      "back": "\u05ea\u05d6\u05de\u05d5\u05df \u05ea\u05d7\u05d9\u05dc\u05ea \u05d4\u05e4\u05e8\u05e9\u05ea \u05d4\u05de\u05dc\u05d5\u05d8\u05d5\u05e0\u05d9\u05df \u05e0\u05d3\u05d7\u05d4 (Delay) \u05d1\u05db-1 \u05e2\u05d3 2 \u05e9\u05e2\u05d5\u05ea. (DSM p.445)"
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05ea\u05e4\u05e7\u05d9\u05d3 \u05e9\u05dc \u05d0\u05e0\u05d8\u05d2\u05d5\u05e0\u05d9\u05d6\u05dd \u05dc\u05e7\u05d5\u05dc\u05d8\u05df $5-HT_{7}$ \u05d1\u05e1\u05e0\u05db\u05e8\u05d5\u05df \u05d4\u05de\u05e7\u05e6\u05d1 \u05d4\u05e6\u05d9\u05e8\u05e7\u05d3\u05d9\u05d0\u05e0\u05d9?",
      "back": "\u05d7\u05e1\u05d9\u05de\u05ea \u05d4\u05e7\u05d5\u05dc\u05d8\u05df \u05d1-SCN \u05d5\u05d1-PFC \u05de\u05d1\u05d8\u05dc\u05ea \u05e2\u05d9\u05db\u05d5\u05d1 GABA\u05e8\u05d2\u05d9 \u05d5\u05de\u05e1\u05d9\u05d9\u05e2\u05ea \u05d1-Resynchronization \u05e9\u05dc \u05e4\u05d0\u05d6\u05d4 \u05de\u05e2\u05d5\u05db\u05d1\u05ea. (StahlNeuro p.130, p.322)"
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05de\u05de\u05e6\u05d0 \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9 \u05d4\u05de\u05d1\u05d3\u05d9\u05dc Delayed Sleep Phase Disorder (DSPD) \u05de\u05d0\u05d9\u05e0\u05e1\u05d5\u05de\u05e0\u05d9\u05d4 \u05e8\u05d0\u05e9\u05d5\u05e0\u05d9\u05ea?",
      "back": "\u05d1-DSPD, \u05db\u05d0\u05e9\u05e8 \u05de\u05ea\u05d0\u05e4\u05e9\u05e8 \u05dc\u05d5\u05d7 \u05d6\u05de\u05e0\u05d9\u05dd \u05d7\u05d5\u05e4\u05e9\u05d9 (\u05d7\u05d5\u05e4\u05e9\u05d5\u05ea/\u05e1\u05d5\u05e4\"\u05e9), \u05d0\u05d9\u05db\u05d5\u05ea \u05d5\u05de\u05e9\u05da \u05d4\u05e9\u05d9\u05e0\u05d4 \u05ea\u05e7\u05d9\u05e0\u05d9\u05dd \u05dc\u05d7\u05dc\u05d5\u05d8\u05d9\u05df. (DSM p.444, StahlNeuro p.435)"
    },
    {
      "front": "\u05d0\u05d9\u05dc\u05d5 \u05de\u05d5\u05d8\u05e6\u05d9\u05d5\u05ea \u05d1\u05d2\u05e0\u05d9 \u05e9\u05e2\u05d5\u05df (Clock Genes) \u05e0\u05e7\u05e9\u05e8\u05d5 \u05dc\u05e0\u05d8\u05d9\u05d9\u05d4 \u05de\u05e9\u05e4\u05d7\u05ea\u05d9\u05ea \u05dc-Delayed Sleep Phase Disorder?",
      "back": "\u05de\u05d5\u05d8\u05e6\u05d9\u05d5\u05ea \u05d1\u05d2\u05e0\u05d9\u05dd $CRY1$ \u05d5\u05e4\u05d5\u05dc\u05d9\u05de\u05d5\u05e8\u05e4\u05d9\u05d6\u05dd \u05d1\u05d2\u05df $CLOCK$. (DSM p.445, StahlNeuro p.437)"
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05de\u05d5\u05de\u05dc\u05e5 \u05d1\u05d0\u05d5\u05e8 (Bright Light Therapy) \u05e2\u05d1\u05d5\u05e8 \u05de\u05ea\u05d1\u05d2\u05e8 \u05e2\u05dd DSPD?",
      "back": "\u05d7\u05e9\u05d9\u05e4\u05d4 \u05dc\u05d0\u05d5\u05e8 \u05d1\u05e2\u05d5\u05e6\u05de\u05d4 \u05e9\u05dc 5,000\u201310,000 lux \u05d1\u05d1\u05d5\u05e7\u05e8 \u05de\u05d9\u05d3 \u05dc\u05d0\u05d7\u05e8 \u05d4\u05d9\u05e7\u05d9\u05e6\u05d4. (Dulcan p.491, StahlNeuro p.437)"
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d8\u05d5\u05d5\u05d7 \u05d4\u05de\u05d9\u05e0\u05d5\u05df \u05d4\u05de\u05e7\u05d5\u05d1\u05dc \u05e9\u05dc Melatonin \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Insomnia \u05d1\u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd?",
      "back": "0.3 \u05e2\u05d3 6.0 \u05de\"\u05d2 (\u05d5\u05e2\u05d3 10.0 \u05de\"\u05d2 \u05d1\u05de\u05e7\u05e8\u05d9\u05dd \u05de\u05e1\u05d5\u05d9\u05de\u05d9\u05dd). (Dulcan p.482)"
    },
    {
      "front": "\u05d0\u05d9\u05d6\u05d4 \u05e0\u05d5\u05d9\u05e8\u05d5\u05d8\u05e8\u05e0\u05e1\u05de\u05d9\u05d8\u05d5\u05e8 \u05de\u05d2\u05d9\u05e2 \u05dc\u05e9\u05d9\u05d0 \u05e4\u05e2\u05d9\u05dc\u05d5\u05ea\u05d5 \u05d1\u05de\u05d5\u05d7 \u05d1\u05de\u05d4\u05dc\u05da \u05e9\u05e0\u05ea \u05d4-REM (\u05e9\u05dc\u05d1 \u05d4-\u05d0\u05e6\u05d9\u05ea)?",
      "back": "Acetylcholine (ACh). (StahlNeuro p.413)"
