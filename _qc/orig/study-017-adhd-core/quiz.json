{
  "title": "ADHD Quiz",
  "questions": [
    {
      "question": "\u05e1\u05d8\u05d5\u05d3\u05e0\u05d8 \u05d1\u05df 19 \u05de\u05d2\u05d9\u05e2 \u05dc\u05d4\u05e2\u05e8\u05db\u05d4 \u05d1\u05e9\u05dc \u05e7\u05e9\u05d9\u05d9\u05dd \u05d0\u05e7\u05d3\u05de\u05d9\u05d9\u05dd. \u05d4\u05d5\u05d0 \u05de\u05ea\u05d0\u05e8 \u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4 \u05d0\u05e8\u05d5\u05db\u05d4 \u05e9\u05dc distractibility \u05d5-forgetfulness \u05e9\u05d4\u05d7\u05dc\u05d5 \u05db\u05d1\u05e8 \u05d1\u05d1\u05d9\u05ea \u05d4\u05e1\u05e4\u05e8 \u05d4\u05d9\u05e1\u05d5\u05d3\u05d9 (\u05dc\u05e4\u05e0\u05d9 \u05d2\u05d9\u05dc 12). \u05d1\u05d1\u05d3\u05d9\u05e7\u05d4 \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05d4\u05d5\u05d0 \u05de\u05e6\u05d9\u05d2 \u05d3\u05e4\u05d5\u05e1 \u05e2\u05e7\u05d1\u05d9 \u05e9\u05dc \u05d7\u05d5\u05e1\u05e8 \u05e8\u05d9\u05db\u05d5\u05d6. \u05e2\u05dc \u05e4\u05d9 \u05d4-DSM-5-TR, \u05de\u05d4\u05d5 \u05de\u05e1\u05e4\u05e8 \u05d4\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05d4\u05de\u05d9\u05e0\u05d9\u05de\u05dc\u05d9 \u05d4\u05e0\u05d3\u05e8\u05e9 \u05ea\u05d7\u05ea \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df Inattention \u05dc\u05e6\u05d5\u05e8\u05da \u05d0\u05d1\u05d7\u05e0\u05ea ADHD \u05d1\u05de\u05d8\u05d5\u05e4\u05dc \u05d6\u05d4?",
      "answerOptions": [
        {
          "text": "4 \u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd.",
          "isCorrect": false,
          "rationale": "\u05de\u05e1\u05e4\u05e8 \u05d6\u05d4 \u05e0\u05de\u05d5\u05da \u05de\u05d4\u05e0\u05d3\u05e8\u05e9 \u05e2\u05d1\u05d5\u05e8 \u05db\u05dc \u05e7\u05d1\u05d5\u05e6\u05ea \u05d2\u05d9\u05dc \u05dc\u05e4\u05d9 \u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05d4\u05e8\u05e9\u05de\u05d9\u05d9\u05dd."
        },
        {
          "text": "5 \u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd.",
          "isCorrect": true,
          "rationale": "\u05e2\u05d1\u05d5\u05e8 \u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd \u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd (\u05d1\u05e0\u05d9 17 \u05d5\u05de\u05e2\u05dc\u05d4) \u05d5\u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd, \u05e0\u05d3\u05e8\u05e9\u05d9\u05dd \u05dc\u05e4\u05d7\u05d5\u05ea \u05d7\u05de\u05d9\u05e9\u05d4 \u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05e9\u05dc \u05d7\u05d5\u05e1\u05e8 \u05e7\u05e9\u05d1 \u05d0\u05d5 \u05d4\u05d9\u05e4\u05e8\u05d0\u05e7\u05d8\u05d9\u05d1\u05d9\u05d5\u05ea (DSM p.68)."
        },
        {
          "text": "6 \u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd.",
          "isCorrect": false,
          "rationale": "\u05d6\u05d4\u05d5 \u05e1\u05e3 \u05d4\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05d4\u05e0\u05d3\u05e8\u05e9 \u05dc\u05d9\u05dc\u05d3\u05d9\u05dd \u05e6\u05e2\u05d9\u05e8\u05d9\u05dd \u05d9\u05d5\u05ea\u05e8, \u05d0\u05da \u05e2\u05d1\u05d5\u05e8 \u05d1\u05e0\u05d9 17 \u05d5\u05de\u05e2\u05dc\u05d4 \u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df \u05de\u05d5\u05e4\u05d7\u05ea \u05dc-5 (DSM p.68)."
        },
        {
          "text": "7 \u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd.",
          "isCorrect": false,
          "rationale": "\u05d4-DSM \u05d0\u05d9\u05e0\u05d5 \u05d3\u05d5\u05e8\u05e9 \u05e9\u05d1\u05e2\u05d4 \u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05dc\u05d0\u05d1\u05d7\u05e0\u05d4; \u05e1\u05e3 \u05d6\u05d4 \u05d2\u05d1\u05d5\u05d4 \u05de\u05d4\u05e0\u05d3\u05e8\u05e9 \u05d2\u05dd \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d5\u05d2\u05dd \u05d1\u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd."
        }
      ],
      "hint": "\u05d1\u05d3\u05d5\u05e7 \u05db\u05d9\u05e6\u05d3 \u05d4\u05d2\u05d9\u05dc \u05de\u05e9\u05e4\u05d9\u05e2 \u05e2\u05dc \u05e1\u05e3 \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d1-DSM-5-TR."
    },
    {
      "question": "\u05d9\u05dc\u05d3 \u05d1\u05df 8 \u05de\u05d5\u05e4\u05e0\u05d4 \u05dc\u05d4\u05e2\u05e8\u05db\u05d4 \u05d1\u05e9\u05dc chronic irritability \u05d5-temper outbursts \u05d4\u05de\u05ea\u05e8\u05d7\u05e9\u05d9\u05dd \u05db-4 \u05e4\u05e2\u05de\u05d9\u05dd \u05d1\u05e9\u05d1\u05d5\u05e2 \u05d1\u05e9\u05e0\u05d9 \u05d4\u05e7\u05e9\u05e8\u05d9\u05dd \u05e9\u05d5\u05e0\u05d9\u05dd (\u05d1\u05d9\u05ea \u05d5\u05d1\u05d9\u05ea \u05e1\u05e4\u05e8). \u05d4\u05d4\u05d5\u05e8\u05d9\u05dd \u05de\u05d3\u05d5\u05d5\u05d7\u05d9\u05dd \u05db\u05d9 \u05de\u05e6\u05d1 \u05d4\u05e8\u05d5\u05d7 \u05d1\u05d9\u05df \u05d4\u05d4\u05ea\u05e4\u05e8\u05e6\u05d5\u05d9\u05d5\u05ea \u05d4\u05d5\u05d0 persistently angry. \u05d4\u05e7\u05dc\u05d9\u05e0\u05d0\u05d9 \u05e9\u05d5\u05e7\u05dc \u05d0\u05d1\u05d7\u05e0\u05d4 \u05de\u05d1\u05d3\u05dc\u05ea \u05d1\u05d9\u05df ADHD \u05dc\u05d1\u05d9\u05df Disruptive Mood Dysregulation Disorder (DMDD). \u05de\u05d4\u05d5 \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05d4\u05de\u05d1\u05d3\u05d9\u05dc \u05d4\u05e2\u05d9\u05e7\u05e8\u05d9 \u05d4\u05ea\u05d5\u05de\u05da \u05d1\u05d0\u05d1\u05d7\u05e0\u05ea DMDD \u05d1\u05de\u05e7\u05e8\u05d4 \u05d6\u05d4?",
      "answerOptions": [
        {
          "text": "\u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05e9\u05dc impulsivity \u05d5-disorganized attention.",
          "isCorrect": false,
          "rationale": "\u05d0\u05dc\u05d5 \u05d4\u05dd \u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05de\u05e8\u05db\u05d6\u05d9\u05d9\u05dd \u05e9\u05dc ADHD, \u05d0\u05da \u05d4\u05dd \u05d0\u05d9\u05e0\u05dd \u05e0\u05d7\u05e9\u05d1\u05d9\u05dd \u05dc\u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9 \u05dc\u05d9\u05d1\u05d4 \u05d4\u05db\u05e8\u05d7\u05d9\u05d9\u05dd \u05e9\u05dc DMDD (DSM p.75)."
        },
        {
          "text": "\u05e7\u05d9\u05d5\u05dd \u05e9\u05dc temper outbursts \u05de\u05e2\u05dc 3 \u05e4\u05e2\u05de\u05d9\u05dd \u05d1\u05e9\u05d1\u05d5\u05e2 \u05dc\u05de\u05e9\u05da \u05e9\u05e0\u05d4.",
          "isCorrect": true,
          "rationale": "\u05d0\u05d1\u05d7\u05e0\u05ea DMDD \u05d3\u05d5\u05e8\u05e9\u05ea \u05d4\u05ea\u05e4\u05e8\u05e6\u05d5\u05d9\u05d5\u05ea \u05d6\u05e2\u05dd \u05ea\u05d3\u05d9\u05e8\u05d5\u05ea \u05d5\u05de\u05e6\u05d1 \u05e8\u05d5\u05d7 \u05db\u05e2\u05d5\u05e1 \u05db\u05e8\u05d5\u05e0\u05d9, \u05d1\u05e2\u05d5\u05d3 \u05e9\u05d1-ADHD \u05d4\u05dc\u05d9\u05e7\u05d5\u05d9 \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05d4\u05d5\u05d0 \u05d1\u05e7\u05e9\u05d1 \u05d0\u05d5 \u05d1\u05e9\u05dc\u05d9\u05d8\u05d4 \u05de\u05d5\u05d8\u05d5\u05e8\u05d9\u05ea (Dulcan p.255, DSM p.178)."
        },
        {
          "text": "\u05d4\u05d5\u05e4\u05e2\u05ea \u05d4\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05dc\u05e8\u05d0\u05e9\u05d5\u05e0\u05d4 \u05dc\u05d0\u05d7\u05e8 \u05d2\u05d9\u05dc 10.",
          "isCorrect": false,
          "rationale": "\u05e2\u05dc \u05e4\u05d9 \u05d4-DSM, \u05d2\u05d9\u05dc \u05d4\u05d4\u05d5\u05e4\u05e2\u05d4 \u05e9\u05dc \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd A-E \u05d1-DMDD \u05d7\u05d9\u05d9\u05d1 \u05dc\u05d4\u05d9\u05d5\u05ea \u05dc\u05e4\u05e0\u05d9 \u05d2\u05d9\u05dc 10 (DSM p.178)."
        },
        {
          "text": "\u05ea\u05d2\u05d5\u05d1\u05d4 \u05d7\u05d9\u05d5\u05d1\u05d9\u05ea \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Methylphenidate \u05d1\u05dc\u05d1\u05d3.",
          "isCorrect": false,
          "rationale": "\u05ea\u05d2\u05d5\u05d1\u05d4 \u05dc\u05ea\u05e8\u05d5\u05e4\u05d4 \u05d0\u05d9\u05e0\u05d4 \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df \u05d0\u05d1\u05d7\u05e0\u05ea\u05d9, \u05d5\u05d1-DMDD \u05dc\u05e8\u05d5\u05d1 \u05e0\u05d3\u05e8\u05e9 \u05d8\u05d9\u05e4\u05d5\u05dc \u05de\u05e2\u05d1\u05e8 \u05dc\u05d2\u05d9\u05e8\u05d5\u05d9 \u05e9\u05dc ADHD \u05d1\u05dc\u05d1\u05d3 (Dulcan p.177)."
        }
      ],
      "hint": "\u05d4\u05ea\u05de\u05e7\u05d3 \u05d1\u05d0\u05d5\u05e4\u05d9 \u05d4\u05db\u05e8\u05d5\u05e0\u05d9 \u05d5\u05d4\u05dc\u05d0-\u05d0\u05e4\u05d9\u05d6\u05d5\u05d3\u05d9 \u05e9\u05dc \u05de\u05e6\u05d1 \u05d4\u05e8\u05d5\u05d7 \u05d5\u05d4\u05d4\u05ea\u05e4\u05e8\u05e6\u05d5\u05d9\u05d5\u05ea."
    },
    {
      "question": "\u05e2\u05dc \u05e4\u05d9 \u05d4\u05de\u05d5\u05d3\u05dc \u05d4\u05e0\u05d5\u05d9\u05e8\u05d5\u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05e9\u05dc StahlNeuro, \u05d4\u05e4\u05e8\u05e2\u05d4 \u05d1-selective attention (\u05d4\u05d9\u05db\u05d5\u05dc\u05ea \u05dc\u05d4\u05ea\u05de\u05e7\u05d3 \u05d1\u05d2\u05d9\u05e8\u05d5\u05d9 \u05de\u05e1\u05d5\u05d9\u05dd) \u05de\u05e7\u05d5\u05e9\u05e8\u05ea \u05dc\u05d7\u05d5\u05e1\u05e8 \u05d9\u05e2\u05d9\u05dc\u05d5\u05ea \u05d1\u05e2\u05d9\u05d1\u05d5\u05d3 \u05d4\u05de\u05d9\u05d3\u05e2 \u05d1\u05de\u05e2\u05d2\u05dc \u05de\u05d5\u05d7\u05d9 \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9. \u05d0\u05d9\u05d6\u05d4 \u05de\u05d1\u05e0\u05d4 \u05d0\u05e0\u05d8\u05d5\u05de\u05d9 \u05e0\u05d7\u05e9\u05d1 \u05dc\u05d0\u05d7\u05e8\u05d0\u05d9 \u05e2\u05dc \u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05dd \u05d6\u05d4?",
      "answerOptions": [
        {
          "text": "Dorsolateral Prefrontal Cortex (DLPFC).",
          "isCorrect": false,
          "rationale": "\u05d4-DLPFC \u05de\u05e7\u05d5\u05e9\u05e8 \u05dc-sustained attention \u05d5\u05dc-executive dysfunction, \u05d0\u05da \u05dc\u05d0 \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05ea \u05dc-selective attention (StahlNeuro p.452)."
        },
        {
          "text": "Dorsal Anterior Cingulate Cortex (dACC).",
          "isCorrect": true,
          "rationale": "\u05d4-dACC \u05de\u05d5\u05e4\u05e2\u05dc \u05d1\u05de\u05d8\u05dc\u05d5\u05ea \u05e9\u05dc \u05e7\u05e9\u05d1 \u05e1\u05dc\u05e7\u05d8\u05d9\u05d1\u05d9 (\u05db\u05de\u05d5 \u05de\u05d1\u05d7\u05df Stroop), \u05d5\u05dc\u05d9\u05e7\u05d5\u05d9 \u05d1\u05d5 \u05e7\u05e9\u05d5\u05e8 \u05dc\u05d1\u05e2\u05d9\u05d5\u05ea \u05d1\u05de\u05d9\u05e7\u05d5\u05d3 (StahlNeuro p.452)."
        },
        {
          "text": "Orbitofrontal Cortex (OFC).",
          "isCorrect": false,
          "rationale": "\u05d4-OFC \u05de\u05e7\u05d5\u05e9\u05e8 \u05d1\u05d3\u05e8\u05da \u05db\u05dc\u05dc \u05dc\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05e9\u05dc impulsivity \u05d5\u05e9\u05dc\u05d9\u05d8\u05d4 \u05d1\u05d3\u05d7\u05e4\u05d9\u05dd (StahlNeuro p.452)."
        },
        {
          "text": "Prefrontal Motor Cortex.",
          "isCorrect": false,
          "rationale": "\u05d0\u05d6\u05d5\u05e8 \u05d6\u05d4 \u05d0\u05d7\u05e8\u05d0\u05d9 \u05e2\u05dc \u05de\u05d5\u05d3\u05d5\u05dc\u05e6\u05d9\u05d4 \u05e9\u05dc hyperactivity \u05de\u05d5\u05d8\u05d5\u05e8\u05d9\u05ea (StahlNeuro p.452)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05de\u05d1\u05e0\u05d4 \u05d4\u05de\u05d5\u05e4\u05e2\u05dc \u05d1\u05d6\u05de\u05df \u05de\u05d1\u05d7\u05df \u05d4-Stroop."
    },
    {
      "question": "\u05d1\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-ADHD \u05d1\u05d0\u05de\u05e6\u05e2\u05d5\u05ea \u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05d4\u05de\u05e2\u05dc\u05d4 \u05d0\u05ea \u05e8\u05de\u05d5\u05ea \u05d4-Norepinephrine (NE) \u05d5\u05d4-Dopamine (DA) \u05d1-Prefrontal Cortex (PFC), StahlNeuro \u05de\u05ea\u05d0\u05e8 \u05ea\u05d4\u05dc\u05d9\u05da \u05e9\u05dc 'Tuning'. \u05de\u05d4\u05d5 \u05d4\u05ea\u05e4\u05e7\u05d9\u05d3 \u05d4\u05e1\u05e4\u05e6\u05d9\u05e4\u05d9 \u05e9\u05dc \u05db\u05dc \u05e0\u05d5\u05d9\u05e8\u05d5\u05d8\u05e8\u05e0\u05e1\u05de\u05d9\u05d8\u05d5\u05e8 \u05d1\u05e9\u05d9\u05e4\u05d5\u05e8 \u05d4-signal-to-noise ratio?",
      "answerOptions": [
        {
          "text": "DA \u05de\u05d2\u05d1\u05d9\u05e8 \u05d0\u05ea \u05d4-signal \u05d5-NE \u05de\u05e4\u05d7\u05d9\u05ea \u05d0\u05ea \u05d4-noise.",
          "isCorrect": false,
          "rationale": "\u05d4\u05ea\u05d9\u05d0\u05d5\u05e8\u05d9\u05d4 \u05d4\u05d4\u05e4\u05d5\u05db\u05d4 \u05d4\u05d9\u05d0 \u05d4\u05e0\u05db\u05d5\u05e0\u05d4; NE \u05d0\u05d7\u05e8\u05d0\u05d9 \u05e2\u05dc \u05d7\u05d9\u05d1\u05d5\u05e8 \u05d4\u05e8\u05e9\u05ea\u05d5\u05ea \u05d5\u05d4\u05d2\u05d1\u05e8\u05ea \u05d4\u05d0\u05d5\u05ea (StahlNeuro p.458)."
        },
        {
          "text": "NE \u05de\u05d2\u05d1\u05d9\u05e8 \u05d0\u05ea \u05d4-signal \u05d3\u05e8\u05da \u05e8\u05e6\u05e4\u05d8\u05d5\u05e8\u05d9 $\\alpha_{2A}$ \u05d5-DA \u05de\u05e4\u05d7\u05d9\u05ea \u05d0\u05ea \u05d4-noise \u05d3\u05e8\u05da \u05e8\u05e6\u05e4\u05d8\u05d5\u05e8\u05d9 $D_1$.",
          "isCorrect": true,
          "rationale": "NE \u05de\u05d7\u05d6\u05e7 \u05d0\u05ea \u05d4\u05e7\u05dc\u05d8 \u05d4\u05e0\u05db\u05e0\u05e1 (signal) \u05d1-PFC \u05d1\u05e2\u05d5\u05d3 DA \u05de\u05d5\u05e0\u05e2 \u05d7\u05d9\u05d1\u05d5\u05e8\u05d9\u05dd \u05dc\u05d0 \u05e8\u05dc\u05d5\u05d5\u05e0\u05d8\u05d9\u05d9\u05dd (noise) (StahlNeuro p.458)."
        },
        {
          "text": "NE \u05d5-DA \u05e9\u05e0\u05d9\u05d4\u05dd \u05e4\u05d5\u05e2\u05dc\u05d9\u05dd \u05d0\u05da \u05d5\u05e8\u05e7 \u05dc\u05d4\u05d2\u05d1\u05e8\u05ea \u05d4-noise \u05d1-PFC.",
          "isCorrect": false,
          "rationale": "\u05de\u05d8\u05e8\u05d4 \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc\u05d9\u05ea \u05d4\u05d9\u05d0 \u05d4\u05e4\u05d7\u05ea\u05ea \u05d4\u05e8\u05e2\u05e9 (noise) \u05d5\u05dc\u05d0 \u05d4\u05d2\u05d1\u05e8\u05ea\u05d5 \u05db\u05d3\u05d9 \u05dc\u05d0\u05e4\u05e9\u05e8 \u05de\u05d9\u05e7\u05d5\u05d3 (StahlNeuro p.458)."
        },
        {
          "text": "NE \u05e4\u05d5\u05e2\u05dc \u05d3\u05e8\u05da \u05e8\u05e6\u05e4\u05d8\u05d5\u05e8\u05d9 $\\alpha_1$ \u05db\u05d3\u05d9 \u05dc\u05e9\u05e4\u05e8 \u05d0\u05ea \u05d4-signal-to-noise ratio.",
          "isCorrect": false,
          "rationale": "\u05d2\u05d9\u05e8\u05d5\u05d9 \u05e9\u05dc \u05e8\u05e6\u05e4\u05d8\u05d5\u05e8\u05d9 $\\alpha_1$ \u05d5-$\\beta_1$ \u05de\u05ea\u05e8\u05d7\u05e9 \u05d1\u05e8\u05de\u05d5\u05ea NE \u05d2\u05d1\u05d5\u05d4\u05d5\u05ea \u05de\u05d3\u05d9 (\u05e1\u05d8\u05e8\u05e1) \u05d5\u05d3\u05d5\u05d5\u05e7\u05d0 \u05e4\u05d5\u05d2\u05e2 \u05d1\u05ea\u05e4\u05e7\u05d5\u05d3 (StahlNeuro p.456)."
        }
      ],
      "hint": "\u05d6\u05db\u05d5\u05e8 \u05de\u05d9 \u05de\u05d4\u05dd '\u05de\u05db\u05d1\u05d4' \u05e8\u05e2\u05e9\u05d9 \u05e8\u05e7\u05e2 \u05d5\u05de\u05d9 '\u05de\u05d2\u05d1\u05d9\u05e8' \u05d0\u05ea \u05d4\u05d4\u05d5\u05d3\u05e2\u05d4 \u05d4\u05de\u05e8\u05db\u05d6\u05d9\u05ea."
    },
    {
      "question": "\u05d9\u05dc\u05d3\u05d4 \u05d1\u05ea 6 \u05de\u05e6\u05d9\u05d2\u05d4 \u05e7\u05e9\u05d9\u05d9\u05dd \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05d9\u05dd \u05d1\u05ea\u05e7\u05e9\u05d5\u05e8\u05ea \u05d7\u05d1\u05e8\u05ea\u05d9\u05ea, \u05db\u05d5\u05dc\u05dc \u05e0\u05d8\u05d9\u05d9\u05d4 \u05dc\u05d4\u05ea\u05e4\u05e8\u05e5 \u05dc\u05d3\u05d1\u05e8\u05d9 \u05d0\u05d7\u05e8\u05d9\u05dd \u05d5\u05e7\u05d5\u05e9\u05d9 \u05d1\u05d4\u05d1\u05e0\u05ea \u05e8\u05de\u05d6\u05d9\u05dd \u05d7\u05d1\u05e8\u05ea\u05d9\u05d9\u05dd. \u05d4\u05e7\u05dc\u05d9\u05e0\u05d0\u05d9 \u05de\u05ea\u05dc\u05d1\u05d8 \u05d1\u05d9\u05df ADHD \u05dc\u05d1\u05d9\u05df Autism Spectrum Disorder (ASD). \u05e2\u05dc \u05e4\u05d9 Dulcan, \u05de\u05d4\u05d5 \u05d4\u05de\u05de\u05e6\u05d0 \u05e9\u05ea\u05d5\u05de\u05da \u05d1\u05e6\u05d5\u05e8\u05d4 \u05d4\u05d7\u05d6\u05e7\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d1\u05d0\u05d1\u05d7\u05e0\u05ea ASD \u05e2\u05dc \u05e4\u05e0\u05d9 ADHD?",
      "answerOptions": [
        {
          "text": "\u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05e9\u05dc hyperactivity \u05d5-impulsivity.",
          "isCorrect": false,
          "rationale": "\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05d0\u05dc\u05d5 \u05e0\u05e4\u05d5\u05e6\u05d9\u05dd \u05de\u05d0\u05d5\u05d3 \u05d2\u05dd \u05d1-ADHD \u05d5\u05d2\u05dd \u05d1-ASD \u05d5\u05dc\u05db\u05df \u05d0\u05d9\u05e0\u05dd \u05de\u05d1\u05d7\u05d9\u05e0\u05d9\u05dd (DSM p.73)."
        },
        {
          "text": "\u05dc\u05d9\u05e7\u05d5\u05d9 \u05d1-social communication \u05e9\u05de\u05d5\u05e4\u05d9\u05e2 \u05dc\u05e8\u05d0\u05e9\u05d5\u05e0\u05d4 \u05e8\u05e7 \u05d1\u05d1\u05d9\u05ea \u05d4\u05e1\u05e4\u05e8.",
          "isCorrect": false,
          "rationale": "\u05d1-ASD \u05d4\u05dc\u05d9\u05e7\u05d5\u05d9 \u05d4\u05d5\u05d0 \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9 \u05d5\u05de\u05d5\u05e4\u05d9\u05e2 \u05de\u05d5\u05e7\u05d3\u05dd \u05d9\u05d5\u05ea\u05e8, \u05d1\u05e2\u05d5\u05d3 \u05e9\u05d1-ADHD \u05d4\u05dc\u05d9\u05e7\u05d5\u05d9 \u05e2\u05e9\u05d5\u05d9 \u05dc\u05d4\u05e4\u05d5\u05da \u05dc\u05d1\u05d5\u05dc\u05d8 \u05d9\u05d5\u05ea\u05e8 \u05e2\u05dd \u05d4\u05e2\u05dc\u05d9\u05d9\u05d4 \u05d1\u05d3\u05e8\u05d9\u05e9\u05d5\u05ea \u05d4\u05d7\u05d1\u05e8\u05ea\u05d9\u05d5\u05ea (Dulcan p.165)."
        },
        {
          "text": "\u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05e9\u05dc repetitive and restrictive behaviors \u05d0\u05d5 \u05ea\u05d7\u05d5\u05de\u05d9 \u05e2\u05e0\u05d9\u05d9\u05df \u05d9\u05d5\u05e6\u05d0\u05d9 \u05d3\u05d5\u05e4\u05df.",
          "isCorrect": true,
          "rationale": "\u05e7\u05d9\u05d5\u05dd \u05d3\u05e4\u05d5\u05e1\u05d9\u05dd \u05d7\u05d6\u05e8\u05ea\u05d9\u05d9\u05dd \u05d5\u05de\u05d5\u05d2\u05d1\u05dc\u05d9\u05dd \u05d4\u05d5\u05d0 \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05d4\u05de\u05d1\u05d3\u05d9\u05dc \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05e9\u05dc ASD \u05de-ADHD (Dulcan p.165, DSM p.73)."
        },
        {
          "text": "\u05e7\u05e9\u05d9\u05d9\u05dd \u05d1-working memory \u05d1\u05de\u05d1\u05d7\u05e0\u05d9\u05dd \u05e0\u05d5\u05d9\u05e8\u05d5\u05e4\u05e1\u05d9\u05db\u05d5\u05dc\u05d5\u05d2\u05d9\u05d9\u05dd.",
          "isCorrect": false,
          "rationale": "\u05dc\u05d9\u05e7\u05d5\u05d9\u05d9\u05dd \u05d1-working memory \u05e0\u05e4\u05d5\u05e6\u05d9\u05dd \u05d1-ADHD \u05d0\u05da \u05d0\u05d9\u05e0\u05dd \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05d9\u05dd \u05de\u05e1\u05e4\u05d9\u05e7 \u05db\u05d3\u05d9 \u05dc\u05d4\u05d1\u05d7\u05d9\u05df \u05de-ASD (Dulcan p.178)."
        }
      ],
      "hint": "\u05d7\u05e4\u05e9 \u05d0\u05ea \u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df \u05e9\u05d4\u05d5\u05d0 \u05d9\u05d9\u05d7\u05d5\u05d3\u05d9 \u05dc\u05e1\u05e4\u05e7\u05d8\u05e8\u05d5\u05dd \u05d4\u05d0\u05d5\u05d8\u05d9\u05e1\u05d8\u05d9."
    },
    {
      "question": "\u05de\u05d7\u05e7\u05e8\u05d9\u05dd \u05d0\u05d5\u05e8\u05db\u05d9\u05d9\u05dd (Longitudinal studies) \u05e2\u05dc \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea \u05d4\u05de\u05d5\u05d7 \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd ADHD, \u05db\u05e4\u05d9 \u05e9\u05de\u05ea\u05d5\u05d0\u05e8 \u05d1-Dulcan, \u05d4\u05e8\u05d0\u05d5 \u05d4\u05d1\u05d3\u05dc\u05d9\u05dd \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05d9\u05dd \u05d1-cortical maturation. \u05de\u05d4\u05d5 \u05d4\u05de\u05de\u05e6\u05d0 \u05d4\u05e2\u05d9\u05e7\u05e8\u05d9 \u05dc\u05d2\u05d1\u05d9 \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea \u05d4-cortex \u05d1\u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd \u05d0\u05dc\u05d5?",
      "answerOptions": [
        {
          "text": "\u05d4\u05d0\u05e6\u05d4 \u05d1\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea \u05d4-cortex \u05d4\u05e7\u05d3\u05de\u05d9 \u05db\u05d1\u05e8 \u05d1\u05d2\u05d9\u05dc \u05d4\u05e8\u05da.",
          "isCorrect": false,
          "rationale": "\u05d1-ADHD \u05e0\u05e6\u05e4\u05d4 \u05d0\u05d9\u05d7\u05d5\u05e8 (delay) \u05d5\u05dc\u05d0 \u05d4\u05d0\u05e6\u05d4 \u05d1\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea \u05d4\u05e7\u05d5\u05e8\u05d8\u05d9\u05e7\u05dc\u05d9\u05ea (Dulcan p.179)."
        },
        {
          "text": "\u05e2\u05d9\u05db\u05d5\u05d1 (delay) \u05e9\u05dc \u05db-2 \u05e9\u05e0\u05d9\u05dd \u05d1\u05d4\u05d2\u05e2\u05d4 \u05dc\u05e9\u05d9\u05d0 \u05d4-cortical surface area.",
          "isCorrect": true,
          "rationale": "\u05e0\u05de\u05e6\u05d0 \u05e2\u05d9\u05db\u05d5\u05d1 \u05d2\u05dc\u05d5\u05d1\u05dc\u05d9 \u05d1\u05d4\u05d1\u05e9\u05dc\u05d4 \u05d4\u05e7\u05d5\u05e8\u05d8\u05d9\u05e7\u05dc\u05d9\u05ea, \u05db\u05d0\u05e9\u05e8 \u05d4\u05e9\u05d9\u05d0 \u05d1\u05e9\u05d8\u05d7 \u05d4\u05e4\u05e0\u05d9\u05dd \u05d4\u05e7\u05d5\u05e8\u05d8\u05d9\u05e7\u05dc\u05d9 \u05de\u05d2\u05d9\u05e2 \u05d1\u05d0\u05d9\u05d7\u05d5\u05e8 \u05e9\u05dc \u05e9\u05e0\u05ea\u05d9\u05d9\u05dd \u05d1\u05d9\u05d7\u05e1 \u05dc\u05e7\u05d1\u05d5\u05e6\u05ea \u05d4\u05d1\u05d9\u05e7\u05d5\u05e8\u05ea (Dulcan p.179)."
        },
        {
          "text": "\u05e2\u05d9\u05d1\u05d5\u05d9 \u05d7\u05e8\u05d9\u05d2 \u05e9\u05dc \u05d4-cortex \u05d1\u05d0\u05d6\u05d5\u05e8 \u05d4-Prefrontal Motor Cortex.",
          "isCorrect": false,
          "rationale": "\u05d4\u05de\u05de\u05e6\u05d0\u05d9\u05dd \u05d4\u05e8\u05d0\u05d5 \u05d3\u05d5\u05d5\u05e7\u05d0 cortex \u05d3\u05e7 \u05d9\u05d5\u05ea\u05e8 (thinner) \u05d1\u05d1\u05e1\u05d9\u05e1 \u05d4\u05de\u05d7\u05e7\u05e8 \u05d0\u05e6\u05dc \u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd ADHD (Dulcan p.179)."
        },
        {
          "text": "\u05d7\u05d5\u05e1\u05e8 \u05de\u05d5\u05d7\u05dc\u05d8 \u05d1-synaptic pruning \u05d1\u05de\u05d4\u05dc\u05da \u05d2\u05d9\u05dc \u05d4\u05d4\u05ea\u05d1\u05d2\u05e8\u05d5\u05ea.",
          "isCorrect": false,
          "rationale": "\u05d4\u05d2\u05d9\u05d6\u05d5\u05dd \u05d4\u05e1\u05d9\u05e0\u05e4\u05d8\u05d9 (pruning) \u05de\u05ea\u05e8\u05d7\u05e9, \u05d0\u05da \u05d4\u05d5\u05d0 \u05e2\u05e9\u05d5\u05d9 \u05dc\u05d4\u05d9\u05d5\u05ea \u05de\u05e2\u05d5\u05db\u05d1; \u05d2\u05d9\u05d6\u05d5\u05dd \u05de\u05d5\u05e4\u05d7\u05ea \u05e0\u05de\u05e6\u05d0 \u05e7\u05e9\u05d5\u05e8 \u05d3\u05d5\u05d5\u05e7\u05d0 \u05dc\u05d4\u05e4\u05d5\u05d2\u05d4 \u05d1\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd (Dulcan p.179)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05de\u05d5\u05e9\u05d2 'maturational delay'."
    },
    {
      "question": "\u05d1\u05de\u05d4\u05dc\u05da \u05de\u05e2\u05e7\u05d1 \u05d0\u05d7\u05e8 \u05e0\u05e2\u05e8 \u05d1\u05df 14 \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05d1-Methylphenidate \u05d1\u05e9\u05dc ADHD, \u05d4\u05e7\u05dc\u05d9\u05e0\u05d0\u05d9 \u05e9\u05dd \u05dc\u05d1 \u05dc\u05d9\u05e8\u05d9\u05d3\u05d4 \u05d1\u05e2\u05e8\u05da \u05d4\u05e2\u05e6\u05de\u05d9 (low self-esteem) \u05d5\u05d3\u05d9\u05d1\u05d5\u05e8 \u05e2\u05dc \u05d7\u05d5\u05e1\u05e8 \u05e2\u05e8\u05da. \u05e2\u05dc \u05e4\u05d9 StahlKids, \u05de\u05d4\u05d9 \u05d4\u05d0\u05d6\u05d4\u05e8\u05d4 \u05d4\u05d7\u05e9\u05d5\u05d1\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05e9\u05d9\u05e9 \u05dc\u05e7\u05d7\u05ea \u05d1\u05d7\u05e9\u05d1\u05d5\u05df \u05d1\u05d0\u05d5\u05db\u05dc\u05d5\u05e1\u05d9\u05d9\u05ea \u05d4-ADHD \u05d1\u05e0\u05d5\u05d2\u05e2 \u05dc\u05d0\u05d5\u05d1\u05d3\u05e0\u05d5\u05ea?",
      "answerOptions": [
        {
          "text": "ADHD \u05d0\u05d9\u05e0\u05d5 \u05de\u05d4\u05d5\u05d5\u05d4 \u05d2\u05d5\u05e8\u05dd \u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05d0\u05d5\u05d1\u05d3\u05e0\u05d5\u05ea \u05dc\u05dc\u05d0 \u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05e9\u05dc Mood disorder.",
          "isCorrect": false,
          "rationale": "ADHD \u05de\u05d4\u05d5\u05d5\u05d4 \u05d2\u05d5\u05e8\u05dd \u05e1\u05d9\u05db\u05d5\u05df \u05e2\u05e6\u05de\u05d0\u05d9 \u05dc\u05de\u05d7\u05e9\u05d1\u05d5\u05ea \u05d5\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d0\u05d5\u05d1\u05d3\u05e0\u05d9\u05ea \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd (DSM p.73)."
        },
        {
          "text": "\u05d9\u05e9 \u05dc\u05d4\u05d9\u05d5\u05ea \u05e2\u05e8\u05e0\u05d9\u05d9\u05dd \u05dc\u05d4\u05d5\u05e4\u05e2\u05ea \u05d3\u05d9\u05db\u05d0\u05d5\u05df, \u05e9\u05db\u05df ADHD \u05e7\u05e9\u05d5\u05e8 \u05dc\u05d4\u05e2\u05e8\u05db\u05d4 \u05e2\u05e6\u05de\u05d9\u05ea \u05e0\u05de\u05d5\u05db\u05d4 \u05d5\u05de\u05e2\u05e9\u05d9\u05dd \u05d0\u05d9\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05d9\u05dd \u05db\u05d5\u05dc\u05dc self-injury.",
          "isCorrect": true,
          "rationale": "\u05d7\u05d5\u05e1\u05e8 \u05d8\u05d9\u05e4\u05d5\u05dc \u05d0\u05d5 \u05e7\u05d9\u05d5\u05dd ADHD \u05e2\u05dc\u05d5\u05dc\u05d9\u05dd \u05dc\u05d4\u05d5\u05d1\u05d9\u05dc \u05dc\u05d9\u05d9\u05d0\u05d5\u05e9, \u05d0\u05d9\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05d5\u05ea \u05d5\u05e1\u05d9\u05db\u05d5\u05df \u05de\u05d5\u05d2\u05d1\u05e8 \u05dc\u05e0\u05d9\u05e1\u05d9\u05d5\u05e0\u05d5\u05ea \u05d0\u05d5\u05d1\u05d3\u05e0\u05d9\u05d9\u05dd (StahlKids p.345, DSM p.73)."
        },
        {
          "text": "\u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05d0\u05d5\u05d1\u05d3\u05e0\u05d5\u05ea \u05d1-ADHD \u05e7\u05d9\u05d9\u05dd \u05e8\u05e7 \u05d1\u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd \u05d5\u05dc\u05d0 \u05d1\u05d1\u05e0\u05d9 \u05e0\u05d5\u05e2\u05e8.",
          "isCorrect": false,
          "rationale": "\u05d0\u05d5\u05d1\u05d3\u05e0\u05d5\u05ea \u05d4\u05d9\u05d0 \u05d0\u05d7\u05ea \u05de\u05e1\u05d9\u05d1\u05d5\u05ea \u05d4\u05de\u05d5\u05d5\u05ea \u05d4\u05de\u05d5\u05d1\u05d9\u05dc\u05d5\u05ea \u05d1\u05e7\u05d1\u05d5\u05e6\u05ea \u05d4\u05d2\u05d9\u05dc \u05e9\u05dc \u05d9\u05dc\u05d3\u05d9\u05dd \u05d5\u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd (StahlKids p.345)."
        },
        {
          "text": "\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05e1\u05d8\u05d9\u05dc\u05d5\u05de\u05e0\u05d8\u05d9\u05dd \u05d4\u05d5\u05d0 \u05d4\u05d2\u05d5\u05e8\u05dd \u05d4\u05e2\u05d9\u05e7\u05e8\u05d9 \u05dc\u05e2\u05dc\u05d9\u05d9\u05d4 \u05d1\u05e9\u05d9\u05e2\u05d5\u05e8 \u05d4\u05d0\u05d5\u05d1\u05d3\u05e0\u05d5\u05ea \u05d1-ADHD.",
          "isCorrect": false,
          "rationale": "\u05d0\u05d9\u05df \u05e2\u05d3\u05d5\u05ea \u05dc\u05db\u05da \u05e9\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05e1\u05d8\u05d9\u05dc\u05d5\u05de\u05e0\u05d8\u05d9\u05dd \u05db\u05e9\u05dc\u05e2\u05e6\u05de\u05d5 \u05d4\u05d5\u05d0 \u05d4\u05d2\u05d5\u05e8\u05dd \u05d4\u05de\u05e8\u05db\u05d6\u05d9; \u05dc\u05e2\u05d9\u05ea\u05d9\u05dd \u05e7\u05e8\u05d5\u05d1\u05d5\u05ea \u05d7\u05d5\u05e1\u05e8 \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05de\u05d7\u05dc\u05d4 \u05d4\u05d1\u05e1\u05d9\u05e1\u05d9\u05ea \u05d4\u05d5\u05d0 \u05d4\u05d1\u05e2\u05d9\u05d4 (StahlKids p.345)."
        }
      ],
      "hint": "\u05e9\u05e7\u05d5\u05dc \u05d0\u05ea \u05d4\u05e9\u05d9\u05dc\u05d5\u05d1 \u05d1\u05d9\u05df \u05d4\u05e2\u05e8\u05db\u05d4 \u05e2\u05e6\u05de\u05d9\u05ea \u05e0\u05de\u05d5\u05db\u05d4 \u05dc\u05d1\u05d9\u05df \u05d0\u05d9\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05d5\u05ea."
    },
    {
      "question": "\u05e0\u05e2\u05e8 \u05d1\u05df 16 \u05e2\u05dd \u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4 \u05e9\u05dc \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d0\u05d2\u05e8\u05e1\u05d9\u05d1\u05d9\u05ea, \u05d2\u05e0\u05d9\u05d1\u05d5\u05ea \u05d5\u05d4\u05e4\u05e8\u05ea \u05db\u05dc\u05dc\u05d9\u05dd \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05de\u05d0\u05d5\u05d1\u05d7\u05df \u05e2\u05dd Conduct Disorder (CD). \u05d4\u05d5\u05d0 \u05de\u05e6\u05d9\u05d2 \u05d2\u05dd \u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05e7\u05e9\u05d9\u05dd \u05e9\u05dc \u05d7\u05d5\u05e1\u05e8 \u05e8\u05d9\u05db\u05d5\u05d6 \u05d5\u05d4\u05d9\u05e4\u05e8\u05d0\u05e7\u05d8\u05d9\u05d1\u05d9\u05d5\u05ea. \u05e2\u05dc \u05e4\u05d9 \u05d4-DSM-5-TR, \u05de\u05d4\u05d9 \u05d4\u05d4\u05e0\u05d7\u05d9\u05d4 \u05dc\u05d2\u05d1\u05d9 \u05d0\u05d1\u05d7\u05e0\u05d4 \u05d1\u05d5-\u05d6\u05de\u05e0\u05d9\u05ea \u05e9\u05dc ADHD \u05d5-CD?",
      "answerOptions": [
        {
          "text": "\u05d0\u05d9\u05df \u05dc\u05d0\u05d1\u05d7\u05df ADHD \u05d0\u05dd \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05e2\u05d5\u05de\u05d3 \u05d1\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05e9\u05dc Conduct Disorder.",
          "isCorrect": false,
          "rationale": "\u05e9\u05ea\u05d9 \u05d4\u05d0\u05d1\u05d7\u05e0\u05d5\u05ea \u05d9\u05db\u05d5\u05dc\u05d5\u05ea \u05dc\u05d4\u05ea\u05e7\u05d9\u05d9\u05dd \u05d9\u05d7\u05d3, \u05d5\u05d9\u05e9 \u05dc\u05ea\u05ea \u05d0\u05ea \u05e9\u05ea\u05d9\u05d4\u05df \u05d0\u05dd \u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05de\u05ea\u05de\u05dc\u05d0\u05d9\u05dd (DSM p.183)."
        },
        {
          "text": "\u05e0\u05d9\u05ea\u05df \u05dc\u05d0\u05d1\u05d7\u05df \u05d0\u05ea \u05e9\u05ea\u05d9\u05d4\u05df; \u05e7\u05d5\u05de\u05d5\u05e8\u05d1\u05d9\u05d3\u05d9\u05d5\u05ea \u05d6\u05d5 \u05de\u05e2\u05dc\u05d4 \u05d0\u05ea \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05d7\u05d5\u05de\u05e8\u05d9\u05dd \u05d5\u05d0\u05d5\u05d1\u05d3\u05df \u05ea\u05e4\u05e7\u05d5\u05d3 \u05d1\u05e2\u05ea\u05d9\u05d3.",
          "isCorrect": true,
          "rationale": "ADHD \u05d5-CD \u05de\u05d5\u05e4\u05d9\u05e2\u05d9\u05dd \u05d9\u05d7\u05d3 \u05dc\u05e2\u05d9\u05ea\u05d9\u05dd \u05e7\u05e8\u05d5\u05d1\u05d5\u05ea (\u05d1\u05db-25% \u05de\u05d4\u05de\u05e7\u05e8\u05d9\u05dd \u05e9\u05dc combined type), \u05d5\u05d4\u05e9\u05d9\u05dc\u05d5\u05d1 \u05d1\u05d9\u05e0\u05d9\u05d4\u05dd \u05de\u05d7\u05de\u05d9\u05e8 \u05d0\u05ea \u05d4\u05e4\u05e8\u05d5\u05d2\u05e0\u05d5\u05d6\u05d4 (Dulcan p.190, DSM p.73)."
        },
        {
          "text": "\u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05e9\u05dc ADHD \u05e0\u05d1\u05dc\u05e2\u05d9\u05dd \u05d1\u05ea\u05d5\u05da \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc CD \u05d1\u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd.",
          "isCorrect": false,
          "rationale": "\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05e7\u05e9\u05d1 \u05d5\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d4\u05df \u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d5\u05ea \u05e0\u05e4\u05e8\u05d3\u05d5\u05ea \u05d1-DSM, \u05d2\u05dd \u05d0\u05dd \u05d9\u05e9 \u05d1\u05d9\u05e0\u05d9\u05d4\u05df \u05d7\u05e4\u05d9\u05e4\u05d4 \u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d8\u05d9\u05ea (DSM p.73)."
        },
        {
          "text": "\u05d0\u05d1\u05d7\u05e0\u05ea CD \u05d3\u05d5\u05e8\u05e9\u05ea \u05e9\u05dc\u05d9\u05dc\u05d4 \u05de\u05d5\u05d7\u05dc\u05d8\u05ea \u05e9\u05dc ADHD \u05db\u05d2\u05d5\u05e8\u05dd \u05dc\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea.",
          "isCorrect": false,
          "rationale": "\u05d4\u05d4\u05e4\u05da \u05d4\u05d5\u05d0 \u05d4\u05e0\u05db\u05d5\u05df; \u05dc\u05e2\u05d9\u05ea\u05d9\u05dd \u05e7\u05e8\u05d5\u05d1\u05d5\u05ea \u05d4-ADHD \u05e7\u05d5\u05d3\u05dd \u05dc-CD \u05d5\u05de\u05d4\u05d5\u05d5\u05d4 \u05d2\u05d5\u05e8\u05dd \u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d5 (DSM p.73)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05e4\u05e8\u05d5\u05d2\u05e0\u05d5\u05d6\u05d4 \u05e9\u05dc \u05de\u05d8\u05d5\u05e4\u05dc \u05e2\u05dd \u05e9\u05ea\u05d9 \u05d4\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea."
    }
  ]
}