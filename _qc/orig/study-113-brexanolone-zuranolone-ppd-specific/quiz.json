{
  "title": "Postpartum Quiz",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\u05d0\u05d9\u05e9\u05d4 \u05d1\u05ea 28, \u05db\u05e9\u05d1\u05d5\u05e2\u05d9\u05d9\u05dd \u05dc\u05d0\u05d7\u05e8 \u05dc\u05d9\u05d3\u05d4 \u05e8\u05d0\u05e9\u05d5\u05e0\u05d4 \u05ea\u05e7\u05d9\u05e0\u05d4, \u05de\u05ea\u05dc\u05d5\u05e0\u05e0\u05ea \u05e2\u05dc \u05ea\u05e0\u05d5\u05d3\u05ea\u05d9\u05d5\u05ea \u05e8\u05d2\u05e9\u05d9\u05ea, \u05e4\u05e8\u05e6\u05d9 \u05d1\u05db\u05d9 \u05e4\u05ea\u05d0\u05d5\u05de\u05d9\u05d9\u05dd, \u05e7\u05e9\u05d9\u05d9 \u05e9\u05d9\u05e0\u05d4 \u05e7\u05dc\u05d9\u05dd \u05d5\u05d1\u05dc\u05d1\u05d5\u05dc. \u05d4\u05d9\u05d0 \u05de\u05e6\u05d9\u05d9\u05e0\u05ea \u05db\u05d9 \u05d4\u05d9\u05d0 \u05de\u05e6\u05dc\u05d9\u05d7\u05d4 \u05dc\u05d8\u05e4\u05dc \u05d1\u05ea\u05d9\u05e0\u05d5\u05e7 \u05d5\u05dc\u05d9\u05d4\u05e0\u05d5\u05ea \u05de\u05de\u05e0\u05d5 \u05dc\u05e2\u05d9\u05ea\u05d9\u05dd, \u05d5\u05d0\u05d9\u05df \u05e2\u05d3\u05d5\u05ea \u05dc\u05e4\u05d2\u05d9\u05e2\u05d4 \u05ea\u05e4\u05e7\u05d5\u05d3\u05d9\u05ea \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea. \u05de\u05d4\u05d9 \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05e1\u05d1\u05d9\u05e8\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8?",
      "answerOptions": [
        {
          "text": "Maternity Blues",
          "isCorrect": true,
          "rationale": "\u05de\u05e6\u05d1 \u05d6\u05d4 \u05de\u05d0\u05d5\u05e4\u05d9\u05d9\u05df \u05d1\u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd \u05e4\u05ea\u05d0\u05d5\u05de\u05d9\u05d9\u05dd \u05d1\u05de\u05e6\u05d1 \u05d4\u05e8\u05d5\u05d7 \u05d5\u05d1\u05dc\u05d1\u05d5\u05dc \u05e7\u05dc, \u05d0\u05d9\u05e0\u05d5 \u05d2\u05d5\u05e8\u05dd \u05dc\u05e4\u05d2\u05d9\u05e2\u05d4 \u05ea\u05e4\u05e7\u05d5\u05d3\u05d9\u05ea \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05d5\u05d7\u05d5\u05dc\u05e3 \u05d1\u05d3\u05e8\u05da \u05db\u05dc\u05dc \u05ea\u05d5\u05da \u05e9\u05d1\u05d5\u05e2 \u05dc\u05dc\u05d0 \u05d8\u05d9\u05e4\u05d5\u05dc (DSM p.174, p.214)."
        },
        {
          "text": "Major Depressive Disorder with peripartum onset",
          "isCorrect": false,
          "rationale": "\u05d3\u05d9\u05db\u05d0\u05d5\u05df Peripartum \u05d3\u05d5\u05e8\u05e9 \u05e2\u05de\u05d9\u05d3\u05d4 \u05d1\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05de\u05dc\u05d0\u05d9\u05dd \u05e9\u05dc MDE \u05d5\u05d2\u05d5\u05e8\u05dd \u05dc\u05de\u05e6\u05d5\u05e7\u05d4 \u05e7\u05e9\u05d4 \u05d0\u05d5 \u05e4\u05d2\u05d9\u05e2\u05d4 \u05ea\u05e4\u05e7\u05d5\u05d3\u05d9\u05ea \u05e0\u05d9\u05db\u05e8\u05ea, \u05d1\u05e0\u05d9\u05d2\u05d5\u05d3 \u05dc-Maternity Blues (DSM p.173, p.213)."
        },
        {
          "text": "Postpartum Psychosis",
          "isCorrect": false,
          "rationale": "\u05de\u05e6\u05d1 \u05d6\u05d4 \u05e0\u05d3\u05d9\u05e8 \u05d1\u05d4\u05e8\u05d1\u05d4 \u05d5\u05de\u05e2\u05e8\u05d1 \u05d4\u05d6\u05d9\u05d5\u05ea, \u05de\u05d7\u05e9\u05d1\u05d5\u05ea \u05e9\u05d5\u05d5\u05d0 \u05d0\u05d5 \u05e1\u05db\u05e0\u05d4 \u05dc\u05d0\u05dd \u05d0\u05d5 \u05dc\u05ea\u05d9\u05e0\u05d5\u05e7, \u05e9\u05d0\u05d9\u05e0\u05dd \u05de\u05d5\u05e4\u05d9\u05e2\u05d9\u05dd \u05d1\u05de\u05e7\u05e8\u05d4 \u05d6\u05d4 (DSM p.174)."
        },
        {
          "text": "Adjustment Disorder with depressed mood",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05e7\u05d9\u05d5\u05dd \u05d2\u05d5\u05e8\u05dd \u05d3\u05d7\u05e7 (\u05dc\u05d9\u05d3\u05d4), \u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d4\u05de\u05ea\u05d5\u05d0\u05e8\u05d9\u05dd \u05d4\u05dd \u05e7\u05dc\u05d0\u05e1\u05d9\u05d9\u05dd \u05dc\u05ea\u05d2\u05d5\u05d1\u05d4 \u05d4\u05e4\u05d9\u05d6\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea \u05d4\u05d7\u05d5\u05dc\u05e4\u05ea \u05e9\u05dc Maternity Blues \u05d5\u05dc\u05d0 \u05dc\u05d4\u05e4\u05e8\u05e2\u05ea \u05d4\u05e1\u05ea\u05d2\u05dc\u05d5\u05ea (DSM p.174)."
        }
      ],
      "hint": "\u05e9\u05d9\u05de\u05d5 \u05dc\u05d1 \u05dc\u05d4\u05d9\u05e2\u05d3\u05e8 \u05e4\u05d2\u05d9\u05e2\u05d4 \u05ea\u05e4\u05e7\u05d5\u05d3\u05d9\u05ea \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05d5\u05dc\u05e2\u05d9\u05ea\u05d5\u05d9 \u05d4\u05de\u05d5\u05e7\u05d3\u05dd \u05dc\u05d0\u05d7\u05e8 \u05d4\u05dc\u05d9\u05d3\u05d4.",
      "citation": "(DSM p.174)"
    },
    {
      "type": "multiple_choice",
      "question": "\u05de\u05d4\u05d5 \u05d4\u05d1\u05e1\u05d9\u05e1 \u05d4\u05e0\u05d5\u05d9\u05e8\u05d5\u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d4\u05de\u05d5\u05e6\u05e2 \u05d1\u05e1\u05e4\u05e8\u05d5\u05ea \u05dc\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1-Neuroactive steroids \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05de\u05d4\u05d9\u05e8 \u05d1-Postpartum Depression (PPD)?",
      "answerOptions": [
        {
          "text": "\u05e0\u05e4\u05d9\u05dc\u05d4 \u05d7\u05d3\u05d4 \u05d1\u05e8\u05de\u05d5\u05ea Allopregnanolone \u05d4\u05d2\u05d5\u05e8\u05de\u05ea \u05dc\u05d0\u05d5\u05d1\u05d3\u05df Tonic inhibition \u05d4\u05de\u05ea\u05d5\u05d5\u05da \u05e2\u05dc \u05d9\u05d3\u05d9 \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 $GABA_{A}$ \u05d0\u05e7\u05e1\u05d8\u05e8\u05d4-\u05e1\u05d9\u05e0\u05e4\u05d8\u05d9\u05d9\u05dd.",
          "isCorrect": true,
          "rationale": "\u05d4\u05ea\u05d9\u05d0\u05d5\u05e8\u05d9\u05d4 \u05de\u05e6\u05d9\u05e2\u05d4 \u05db\u05d9 \u05d4\u05d9\u05e8\u05d9\u05d3\u05d4 \u05d1\u05e1\u05d8\u05e8\u05d5\u05d0\u05d9\u05d3\u05d9\u05dd \u05e0\u05d5\u05d9\u05e8\u05d5\u05d0\u05e7\u05d8\u05d9\u05d1\u05d9\u05d9\u05dd \u05dc\u05d0\u05d7\u05e8 \u05d4\u05dc\u05d9\u05d3\u05d4 \u05e4\u05d5\u05d2\u05e2\u05ea \u05d1\u05e2\u05d9\u05db\u05d5\u05d1 \u05d4\u05d8\u05d5\u05e0\u05d9, \u05d5\u05d4\u05d7\u05d6\u05e8\u05ea\u05dd \u05db-PAM \u05de\u05e9\u05e7\u05de\u05ea \u05d0\u05ea \u05d4\u05d0\u05d9\u05d6\u05d5\u05df (StahlNeuro p.262, p.320)."
        },
        {
          "text": "\u05d7\u05e1\u05d9\u05de\u05d4 \u05e1\u05dc\u05e7\u05d8\u05d9\u05d1\u05d9\u05ea \u05e9\u05dc \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 $5HT_{7}$ \u05d1-Raphe nucleus \u05d4\u05de\u05d5\u05d1\u05d9\u05dc\u05d4 \u05dc\u05e2\u05dc\u05d9\u05d9\u05d4 \u05d1\u05e9\u05d7\u05e8\u05d5\u05e8 \u05e1\u05e8\u05d5\u05d8\u05d5\u05e0\u05d9\u05df.",
          "isCorrect": false,
          "rationale": "\u05d1\u05e2\u05d5\u05d3 \u05e9\u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 $5HT_{7}$ \u05de\u05d5\u05d5\u05e1\u05ea\u05d9\u05dd \u05e9\u05d7\u05e8\u05d5\u05e8 \u05e1\u05e8\u05d5\u05d8\u05d5\u05e0\u05d9\u05df, \u05d6\u05d4\u05d5 \u05d0\u05d9\u05e0\u05d5 \u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05e4\u05e2\u05d5\u05dc\u05d4 \u05e9\u05dc Brexanolone \u05d0\u05d5 Zuranolone (StahlNeuro p.320)."
        },
        {
          "text": "Positive allosteric modulation (PAM) \u05e1\u05dc\u05e7\u05d8\u05d9\u05d1\u05d9 \u05dc\u05d9\u05d7\u05d9\u05d3\u05d5\u05ea $\\alpha_{1}$ \u05e9\u05dc \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 $GABA_{A}$ \u05d1\u05dc\u05d1\u05d3.",
          "isCorrect": false,
          "rationale": "\u05e1\u05d8\u05e8\u05d5\u05d0\u05d9\u05d3\u05d9\u05dd \u05e0\u05d5\u05d9\u05e8\u05d5\u05d0\u05e7\u05d8\u05d9\u05d1\u05d9\u05d9\u05dd \u05e4\u05d5\u05e2\u05dc\u05d9\u05dd \u05e2\u05dc \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 $GABA_{A}$ \u05e8\u05d2\u05d9\u05e9\u05d9\u05dd \u05d5\u05d0\u05d3\u05d9\u05e9\u05d9\u05dd \u05dc\u05d1\u05e0\u05d6\u05d5\u05d3\u05d9\u05d0\u05d6\u05e4\u05d9\u05e0\u05d9\u05dd (\u05db\u05d5\u05dc\u05dc \u05d9\u05d7\u05d9\u05d3\u05d5\u05ea $\\delta$), \u05d5\u05dc\u05d0 \u05e8\u05e7 \u05e2\u05dc $\\alpha_{1}$ (StahlNeuro p.322)."
        },
        {
          "text": "\u05e2\u05d9\u05db\u05d5\u05d1 \u05e9\u05dc \u05d4\u05d0\u05e0\u05d6\u05d9\u05dd $CYP450$ $2D6$ \u05d4\u05de\u05d5\u05d1\u05d9\u05dc \u05dc\u05e2\u05dc\u05d9\u05d9\u05d4 \u05d1\u05d6\u05de\u05d9\u05e0\u05d5\u05ea \u05d4\u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea \u05e9\u05dc GABA.",
          "isCorrect": false,
          "rationale": "\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05e4\u05e2\u05d5\u05dc\u05d4 \u05d0\u05d9\u05e0\u05d5 \u05e7\u05e9\u05d5\u05e8 \u05dc\u05e2\u05d9\u05db\u05d5\u05d1 \u05d0\u05e0\u05d6\u05d9\u05de\u05d8\u05d9 \u05e9\u05dc \u05e4\u05d9\u05e8\u05d5\u05e7 GABA, \u05d0\u05dc\u05d0 \u05dc\u05de\u05d5\u05d3\u05d5\u05dc\u05e6\u05d9\u05d4 \u05d0\u05dc\u05d5\u05e1\u05d8\u05e8\u05d9\u05ea \u05d9\u05e9\u05d9\u05e8\u05d4 \u05e9\u05dc \u05d4\u05e7\u05d5\u05dc\u05d8\u05df (StahlNeuro p.322)."
        }
      ],
      "hint": "\u05d4\u05ea\u05de\u05e7\u05d3\u05d5 \u05d1\u05e7\u05e9\u05e8 \u05e9\u05d1\u05d9\u05df \u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd \u05d4\u05d5\u05e8\u05de\u05d5\u05e0\u05dc\u05d9\u05d9\u05dd \u05dc\u05d0\u05d7\u05e8 \u05dc\u05d9\u05d3\u05d4 \u05dc\u05d1\u05d9\u05df \u05e1\u05d5\u05d2 \u05d4\u05e2\u05d9\u05db\u05d5\u05d1 \u05d4\u05e2\u05e6\u05d1\u05d9 (Tonic vs. Phasic).",
      "citation": "(StahlNeuro p.262, p.320-321)"
    },
    {
      "type": "multiple_choice",
      "question": "\u05de\u05d8\u05d5\u05e4\u05dc\u05ea \u05d1\u05ea 32 \u05d4\u05de\u05d0\u05d5\u05d1\u05d7\u05e0\u05ea \u05e2\u05dd PPD \u05e7\u05e9\u05d4 \u05de\u05ea\u05d7\u05d9\u05dc\u05d4 \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Brexanolone (Zulresso) \u05d1\u05e2\u05d9\u05e8\u05d5\u05d9 \u05d5\u05e8\u05d9\u05d3\u05d9. \u05de\u05d4\u05df \u05d3\u05e8\u05d9\u05e9\u05d5\u05ea \u05d4\u05e0\u05d9\u05d8\u05d5\u05e8 \u05d4\u05de\u05d7\u05de\u05d9\u05e8\u05d5\u05ea \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05dc\u05e4\u05d9 \u05d4-Black Box Warning?",
      "answerOptions": [
        {
          "text": "\u05e0\u05d9\u05d8\u05d5\u05e8 \u05e8\u05e6\u05d9\u05e3 \u05e9\u05dc \u05e8\u05d5\u05d5\u05d9\u05d9\u05ea \u05d7\u05de\u05e6\u05df (Pulse Oximetry) \u05d5\u05d4\u05e2\u05e8\u05db\u05ea \u05de\u05e6\u05d1 \u05d4\u05db\u05e8\u05d4 \u05d1\u05e9\u05dc \u05e1\u05d9\u05db\u05d5\u05df \u05dc-Excessive sedation \u05d5\u05d0\u05d5\u05d1\u05d3\u05df \u05d4\u05db\u05e8\u05d4 \u05e4\u05ea\u05d0\u05d5\u05de\u05d9.",
          "isCorrect": true,
          "rationale": "Brexanolone \u05e0\u05d5\u05e9\u05d0 \u05d0\u05d6\u05d4\u05e8\u05d4 \u05d7\u05de\u05d5\u05e8\u05d4 \u05dc\u05d2\u05d1\u05d9 \u05e1\u05d3\u05e6\u05d9\u05d4 \u05e2\u05de\u05d5\u05e7\u05d4 \u05d5\u05d0\u05d5\u05d1\u05d3\u05df \u05d4\u05db\u05e8\u05d4, \u05d4\u05de\u05d7\u05d9\u05d9\u05d1\u05d9\u05dd \u05d4\u05e9\u05d2\u05d7\u05d4 \u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05e6\u05de\u05d5\u05d3\u05d4 \u05dc\u05d0\u05d5\u05e8\u05da \u05db\u05dc 60 \u05e9\u05e2\u05d5\u05ea \u05d4\u05e2\u05d9\u05e8\u05d5\u05d9 (StahlNeuro p.320, \u05d4\u05e7\u05e9\u05e8 \u05e8\u05d7\u05d1)."
        },
        {
          "text": "\u05d1\u05d3\u05d9\u05e7\u05ea \u05e8\u05de\u05d5\u05ea trough \u05e9\u05dc \u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 \u05d1\u05d3\u05dd \u05db\u05dc 12 \u05e9\u05e2\u05d5\u05ea \u05db\u05d3\u05d9 \u05dc\u05de\u05e0\u05d5\u05e2 \u05e8\u05e2\u05d9\u05dc\u05d5\u05ea \u05db\u05dc\u05d9\u05d9\u05ea\u05d9\u05ea.",
          "isCorrect": false,
          "rationale": "\u05e0\u05d9\u05d8\u05d5\u05e8 \u05e8\u05de\u05d5\u05ea \u05d1\u05d3\u05dd \u05e0\u05d3\u05e8\u05e9 \u05dc\u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05db\u05de\u05d5 Lithium, \u05d0\u05da \u05d0\u05d9\u05e0\u05d5 \u05d7\u05dc\u05e7 \u05de\u05e4\u05e8\u05d5\u05d8\u05d5\u05e7\u05d5\u05dc \u05d4\u05e0\u05d9\u05d8\u05d5\u05e8 \u05d4\u05e1\u05d8\u05e0\u05d3\u05e8\u05d8\u05d9 \u05e9\u05dc Brexanolone (StahlKids p.291)."
        },
        {
          "text": "\u05d1\u05d9\u05e6\u05d5\u05e2 ECG \u05d9\u05d5\u05de\u05d9 \u05dc\u05de\u05e2\u05e7\u05d1 \u05d0\u05d7\u05e8 \u05d4\u05d0\u05e8\u05db\u05ea \u05de\u05e8\u05d5\u05d5\u05d7 QTc.",
          "isCorrect": false,
          "rationale": "\u05d4\u05d0\u05e8\u05db\u05ea QTc \u05d4\u05d9\u05d0 \u05e1\u05d9\u05db\u05d5\u05df \u05e9\u05dc \u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05de\u05e1\u05d5\u05d9\u05de\u05d5\u05ea (\u05db\u05de\u05d5 Ziprasidone \u05d0\u05d5 TCA), \u05d0\u05da \u05d0\u05d9\u05e0\u05d4 \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05d4\u05de\u05d7\u05d9\u05d9\u05d1 \u05e0\u05d9\u05d8\u05d5\u05e8 \u05d1-Brexanolone (StahlKids p.121)."
        },
        {
          "text": "\u05de\u05e2\u05e7\u05d1 \u05d0\u05d7\u05e8 \u05e1\u05e4\u05d9\u05e8\u05ea \u05d3\u05dd (ANC) \u05d0\u05d7\u05ea \u05dc\u05e9\u05d1\u05d5\u05e2 \u05d1\u05e9\u05dc \u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05d0\u05d2\u05e8\u05e0\u05d5\u05dc\u05d5\u05e6\u05d9\u05d8\u05d5\u05d6\u05d9\u05e1.",
          "isCorrect": false,
          "rationale": "\u05e0\u05d9\u05d8\u05d5\u05e8 ANC \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9 \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Clozapine \u05d5\u05dc\u05d0 \u05dc\u05e1\u05d8\u05e8\u05d5\u05d0\u05d9\u05d3\u05d9\u05dd \u05e0\u05d5\u05d9\u05e8\u05d5\u05d0\u05e7\u05d8\u05d9\u05d1\u05d9\u05d9\u05dd (StahlKids p.150)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d1\u05d5 \u05e2\u05dc \u05ea\u05d5\u05e4\u05e2\u05ea \u05d4\u05dc\u05d5\u05d5\u05d0\u05d9 \u05d4\u05e1\u05d3\u05d8\u05d9\u05d1\u05d9\u05ea \u05d4\u05de\u05d4\u05d9\u05e8\u05d4 \u05d5\u05d4\u05de\u05e1\u05d5\u05db\u05e0\u05ea \u05d1\u05d9\u05d5\u05ea\u05e8 \u05e9\u05dc \u05d4\u05ea\u05e8\u05d5\u05e4\u05d4.",
      "citation": "(StahlNeuro p.320)"
    },
    {
      "type": "multiple_choice",
      "question": "\u05de\u05d8\u05d5\u05e4\u05dc\u05ea \u05e2\u05dd PPD \u05de\u05e2\u05d5\u05e0\u05d9\u05d9\u05e0\u05ea \u05d1\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Zuranolone (Zurzuvae) \u05d1\u05d1\u05d9\u05ea\u05d4. \u05de\u05d4\u05df \u05d4\u05d4\u05e0\u05d7\u05d9\u05d5\u05ea \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9\u05d5\u05ea \u05d4\u05e0\u05db\u05d5\u05e0\u05d5\u05ea \u05dc\u05d2\u05d1\u05d9 \u05de\u05e9\u05da \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d5\u05d0\u05d5\u05e4\u05df \u05d4\u05e0\u05d8\u05d9\u05dc\u05d4?",
      "answerOptions": [
        {
          "text": "\u05e0\u05d8\u05d9\u05dc\u05d4 \u05e4\u05d5\u05de\u05d1\u05d9\u05ea \u05e4\u05e2\u05dd \u05d1\u05d9\u05d5\u05dd \u05d1\u05e2\u05e8\u05d1 \u05dc\u05de\u05e9\u05da 14 \u05d9\u05de\u05d9\u05dd, \u05d9\u05d7\u05d3 \u05e2\u05dd \u05d0\u05e8\u05d5\u05d7\u05d4 \u05d4\u05de\u05db\u05d9\u05dc\u05d4 \u05e9\u05d5\u05de\u05df.",
          "isCorrect": true,
          "rationale": "Zuranolone \u05d4\u05d5\u05d0 \u05d0\u05e0\u05dc\u05d5\u05d2 \u05d0\u05d5\u05e8\u05d0\u05dc\u05d9 \u05d4\u05e0\u05d9\u05ea\u05df \u05db\u05e7\u05d5\u05e8\u05e1 \u05e7\u05e6\u05e8 \u05e9\u05dc 14 \u05d9\u05d5\u05dd, \u05d5\u05e0\u05d8\u05d9\u05dc\u05ea\u05d5 \u05e2\u05dd \u05de\u05d6\u05d5\u05df \u05e9\u05d5\u05de\u05e0\u05d9 \u05d7\u05d9\u05d5\u05e0\u05d9\u05ea \u05dc\u05e1\u05e4\u05d9\u05d2\u05d4 (StahlNeuro p.322, \u05d4\u05e7\u05e9\u05e8 \u05e8\u05d7\u05d1)."
        },
        {
          "text": "\u05e0\u05d8\u05d9\u05dc\u05d4 \u05e4\u05d5\u05de\u05d1\u05d9\u05ea \u05e4\u05e2\u05dd \u05d1\u05d9\u05d5\u05dd \u05dc\u05de\u05e9\u05da 60 \u05e9\u05e2\u05d5\u05ea \u05d1\u05dc\u05d1\u05d3, \u05dc\u05dc\u05d0 \u05e7\u05e9\u05e8 \u05dc\u05de\u05d6\u05d5\u05df.",
          "isCorrect": false,
          "rationale": "60 \u05e9\u05e2\u05d5\u05ea \u05d4\u05d5\u05d0 \u05de\u05e9\u05da \u05d4\u05e2\u05d9\u05e8\u05d5\u05d9 \u05e9\u05dc Brexanolone, \u05d1\u05e2\u05d5\u05d3 Zuranolone \u05d3\u05d5\u05e8\u05e9 \u05e7\u05d5\u05e8\u05e1 \u05e9\u05dc \u05e9\u05d1\u05d5\u05e2\u05d9\u05d9\u05dd (StahlNeuro p.320, p.322)."
        },
        {
          "text": "\u05e0\u05d8\u05d9\u05dc\u05d4 \u05d1\u05d1\u05d5\u05e7\u05e8 \u05e2\u05dc \u05e7\u05d9\u05d1\u05d4 \u05e8\u05d9\u05e7\u05d4 \u05dc\u05de\u05e9\u05da \u05d7\u05d5\u05d3\u05e9 \u05d9\u05de\u05d9\u05dd \u05dc\u05e4\u05d7\u05d5\u05ea.",
          "isCorrect": false,
          "rationale": "\u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 \u05e0\u05d9\u05ea\u05e0\u05ea \u05d1\u05e2\u05e8\u05d1 \u05d1\u05e9\u05dc \u05d4\u05e9\u05e4\u05e2\u05d5\u05ea\u05d9\u05d4 \u05d4\u05e1\u05d3\u05d8\u05d9\u05d1\u05d9\u05d5\u05ea \u05d5\u05dc\u05de\u05e9\u05da 14 \u05d9\u05de\u05d9\u05dd \u05d1\u05dc\u05d1\u05d3 (StahlNeuro p.322)."
        },
        {
          "text": "\u05e9\u05d9\u05de\u05d5\u05e9 \u05db\u05d8\u05d9\u05e4\u05d5\u05dc PRN \u05e8\u05e7 \u05d1\u05d9\u05de\u05d9\u05dd \u05d1\u05d4\u05dd \u05de\u05e6\u05d1 \u05d4\u05e8\u05d5\u05d7 \u05d9\u05e8\u05d5\u05d3 \u05d1\u05de\u05d9\u05d5\u05d7\u05d3.",
          "isCorrect": false,
          "rationale": "\u05d6\u05d5\u05d4\u05d9 \u05ea\u05e8\u05d5\u05e4\u05d4 \u05d4\u05d3\u05d5\u05e8\u05e9\u05ea \u05e8\u05e6\u05e3 \u05d8\u05d9\u05e4\u05d5\u05dc\u05d9 (Course) \u05dc\u05d4\u05e9\u05d2\u05ea \u05d0\u05e4\u05e7\u05d8 \u05e0\u05d5\u05d2\u05d3 \u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05de\u05d4\u05d9\u05e8 \u05d5\u05d9\u05e6\u05d9\u05d1 (StahlNeuro p.322)."
        }
      ],
      "hint": "\u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 \u05d4\u05d9\u05d0 \u05d0\u05e0\u05dc\u05d5\u05d2 \u05e1\u05d9\u05e0\u05ea\u05d8\u05d9 \u05d0\u05d5\u05e8\u05d0\u05dc\u05d9 \u05d1\u05e2\u05dc \u05e4\u05e8\u05d5\u05d8\u05d5\u05e7\u05d5\u05dc \u05d8\u05d9\u05e4\u05d5\u05dc \u05e7\u05e6\u05e8 \u05d5\u05de\u05d5\u05d2\u05d3\u05e8.",
      "citation": "(StahlNeuro p.322)"
    },
    {
      "type": "short_answer",
      "question": "\u05db\u05d9\u05e6\u05d3 \u05de\u05e9\u05e4\u05d9\u05e2 \u05d8\u05d9\u05e4\u05d5\u05dc \u05de\u05d5\u05e6\u05dc\u05d7 \u05d5\u05e8\u05de\u05d9\u05e1\u05d9\u05d4 \u05d1\u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05e9\u05dc \u05d4\u05d0\u05dd \u05e2\u05dc \u05d1\u05e8\u05d9\u05d0\u05d5\u05ea \u05d4\u05e0\u05e4\u05e9 \u05e9\u05dc \u05d9\u05dc\u05d3\u05d9\u05d4, \u05e2\u05dc \u05e4\u05d9 \u05de\u05d7\u05e7\u05e8 \u05d4-STAR*D-child \u05d4\u05de\u05d5\u05d6\u05db\u05e8 \u05d1-Dulcan?",
      "grading": {
        "modelAnswer": "\u05d8\u05d9\u05e4\u05d5\u05dc \u05de\u05d5\u05e6\u05dc\u05d7 \u05d1\u05e8\u05de\u05d9\u05e1\u05d9\u05d4 \u05e9\u05dc \u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05d0\u05d9\u05de\u05d4\u05d9 \u05e7\u05e9\u05d5\u05e8 \u05dc\u05d9\u05e8\u05d9\u05d3\u05d4 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05d1\u05d0\u05d1\u05d7\u05e0\u05d5\u05ea \u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9\u05d5\u05ea \u05d7\u05d3\u05e9\u05d5\u05ea \u05d1\u05e7\u05e8\u05d1 \u05d4\u05d9\u05dc\u05d3\u05d9\u05dd \u05d5\u05dc\u05e9\u05d9\u05e2\u05d5\u05e8\u05d9 \u05e8\u05de\u05d9\u05e1\u05d9\u05d4 \u05d2\u05d1\u05d5\u05d4\u05d9\u05dd \u05d9\u05d5\u05ea\u05e8 \u05e9\u05dc \u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05e7\u05d9\u05d9\u05de\u05d5\u05ea \u05d0\u05e6\u05dc\u05dd. \u05d6\u05d9\u05d4\u05d5\u05d9 \u05d5\u05d8\u05d9\u05e4\u05d5\u05dc \u05e0\u05de\u05e8\u05e5 \u05d1\u05d0\u05dd \u05d4\u05dd \u05e7\u05e8\u05d9\u05d8\u05d9\u05d9\u05dd \u05dc\u05de\u05e0\u05d9\u05e2\u05ea \u05d4\u05e9\u05dc\u05db\u05d5\u05ea \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9\u05d5\u05ea \u05e9\u05dc\u05d9\u05dc\u05d9\u05d5\u05ea \u05d1\u05d9\u05dc\u05d3 (Dulcan p.252).",
        "rationale": "\u05d4\u05e1\u05e4\u05e8\u05d5\u05ea \u05de\u05d3\u05d2\u05d9\u05e9\u05d4 \u05e9\u05d4\u05d8\u05d1\u05d4 \u05d1\u05de\u05e6\u05d1 \u05d4\u05d0\u05dd \u05de\u05e9\u05e4\u05e8\u05ea \u05d9\u05e9\u05d9\u05e8\u05d5\u05ea \u05d0\u05ea \u05d4\u05ea\u05d5\u05e6\u05d0\u05d5\u05ea \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9\u05d5\u05ea \u05e9\u05dc \u05d4\u05d9\u05dc\u05d3 \u05d3\u05e8\u05da \u05e9\u05d9\u05e4\u05d5\u05e8 \u05d1\u05ea\u05e4\u05e7\u05d5\u05d3 \u05d4\u05d4\u05d5\u05e8\u05d9 \u05d5\u05d1\u05e7\u05e9\u05e8 \u05d4\u05d0\u05d9\u05de\u05d4\u05d9 (Dulcan p.34, p.252).",
        "requiredAttributes": [
          "\u05e6\u05d9\u05d5\u05df \u05d4\u05e7\u05e9\u05e8 \u05d1\u05d9\u05df \u05e8\u05de\u05d9\u05e1\u05d9\u05d4 \u05d0\u05e6\u05dc \u05d4\u05d0\u05dd \u05dc\u05d9\u05e8\u05d9\u05d3\u05d4 \u05d1\u05ea\u05d7\u05dc\u05d5\u05d0\u05d4 \u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9\u05ea \u05d0\u05e6\u05dc \u05d4\u05d9\u05dc\u05d3.",
          "\u05e6\u05d9\u05d5\u05df \u05d4\u05e2\u05dc\u05d9\u05d9\u05d4 \u05d1\u05e9\u05d9\u05e2\u05d5\u05e8\u05d9 \u05d4\u05e8\u05de\u05d9\u05e1\u05d9\u05d4 \u05e9\u05dc \u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05e7\u05d9\u05d9\u05de\u05d5\u05ea \u05d0\u05e6\u05dc \u05d4\u05d9\u05dc\u05d3\u05d9\u05dd.",
          "\u05d4\u05ea\u05d9\u05d9\u05d7\u05e1\u05d5\u05ea \u05dc\u05d7\u05e9\u05d9\u05d1\u05d5\u05ea \u05d4\u05d6\u05d9\u05d4\u05d5\u05d9 \u05d5\u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05de\u05d5\u05e7\u05d3\u05dd \u05d1\u05d0\u05dd \u05db\u05d4\u05ea\u05e2\u05e8\u05d1\u05d5\u05ea \u05de\u05d5\u05e0\u05e2\u05ea \u05dc\u05d9\u05dc\u05d3."
        ],
        "errors": {
          "misconceptions": [
            "\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05d0\u05dd \u05d0\u05d9\u05e0\u05d5 \u05de\u05e9\u05e4\u05d9\u05e2 \u05e2\u05dc \u05d4\u05d9\u05dc\u05d3 \u05d0\u05dc\u05d0 \u05d0\u05dd \u05d4\u05d9\u05dc\u05d3 \u05de\u05e7\u05d1\u05dc \u05d8\u05d9\u05e4\u05d5\u05dc \u05d9\u05e9\u05d9\u05e8 \u05d1\u05e2\u05e6\u05de\u05d5."
          ],
          "bluffs": [
            "\u05d0\u05de\u05d9\u05e8\u05d5\u05ea \u05db\u05dc\u05dc\u05d9\u05d5\u05ea \u05e2\u05dc '\u05e7\u05e9\u05e8 \u05d8\u05d5\u05d1' \u05d1\u05dc\u05d9 \u05dc\u05e6\u05d9\u05d9\u05df \u05d0\u05ea \u05d4\u05de\u05de\u05e6\u05d0\u05d9\u05dd \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9\u05d9\u05dd \u05dc\u05d2\u05d1\u05d9 \u05e8\u05de\u05d9\u05e1\u05d9\u05d4 \u05d5\u05ea\u05d7\u05dc\u05d5\u05d0\u05d4."
          ]
        }
      },
      "hint": "\u05d7\u05e9\u05d1\u05d5 \u05e2\u05dc \u05d4\u05d4\u05e9\u05e4\u05e2\u05d4 \u05e9\u05dc \u05de\u05e6\u05d1 \u05d4\u05d0\u05dd \u05e2\u05dc \u05d4-Attachment \u05d5\u05e2\u05dc \u05e9\u05d9\u05e2\u05d5\u05e8\u05d9 \u05d4\u05e8\u05de\u05d9\u05e1\u05d9\u05d4 \u05e9\u05dc \u05d4\u05d9\u05dc\u05d3\u05d9\u05dd.",
      "citation": "(Dulcan p.252)"
    },
    {
      "type": "multiple_choice",
      "question": "\u05d0\u05d9\u05e9\u05d4 \u05e2\u05dd \u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4 \u05e9\u05dc Bipolar I Disorder \u05e0\u05de\u05e6\u05d0\u05ea \u05dc\u05e7\u05e8\u05d0\u05ea \u05dc\u05d9\u05d3\u05d4. \u05e2\u05dc \u05e4\u05d9 \u05d4-DSM-5-TR, \u05de\u05d4\u05d5 \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05d4\u05d9\u05e9\u05e0\u05d5\u05ea \u05e9\u05dc Postpartum episode with psychotic features \u05d1\u05dc\u05d9\u05d3\u05d4 \u05d4\u05e0\u05d5\u05db\u05d7\u05d9\u05ea?",
      "answerOptions": [
        {
          "text": "\u05d1\u05d9\u05df 30% \u05dc-50%.",
          "isCorrect": true,
          "rationale": "\u05e0\u05e9\u05d9\u05dd \u05e2\u05dd \u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4 \u05e9\u05dc \u05d4\u05e4\u05e8\u05e2\u05d4 \u05d1\u05d9\u05e4\u05d5\u05dc\u05e8\u05d9\u05ea \u05d0\u05d5 \u05d0\u05d9\u05e8\u05d5\u05e2\u05d9\u05dd \u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9\u05d9\u05dd \u05e7\u05d5\u05d3\u05de\u05d9\u05dd \u05dc\u05d0\u05d7\u05e8 \u05dc\u05d9\u05d3\u05d4 \u05e0\u05de\u05e6\u05d0\u05d5\u05ea \u05d1\u05e1\u05d9\u05db\u05d5\u05df \u05d2\u05d1\u05d5\u05d4 \u05de\u05d0\u05d5\u05d3 \u05dc\u05d4\u05d9\u05e9\u05e0\u05d5\u05ea, \u05d4\u05e0\u05d0\u05de\u05d3 \u05d1\u05d8\u05d5\u05d5\u05d7 \u05d6\u05d4 (DSM p.174, p.213)."
        },
        {
          "text": "\u05e4\u05d7\u05d5\u05ea \u05de-1%.",
          "isCorrect": false,
          "rationale": "\u05e0\u05ea\u05d5\u05df \u05d6\u05d4 (1 \u05dc-500 \u05e2\u05d3 1,000) \u05de\u05ea\u05d9\u05d9\u05d7\u05e1 \u05dc\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d1\u05d0\u05d5\u05db\u05dc\u05d5\u05e1\u05d9\u05d9\u05d4 \u05d4\u05db\u05dc\u05dc\u05d9\u05ea, \u05dc\u05d0 \u05d1\u05e7\u05d1\u05d5\u05e6\u05ea \u05e1\u05d9\u05db\u05d5\u05df \u05e2\u05dd \u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4 \u05d1\u05d9\u05e4\u05d5\u05dc\u05e8\u05d9\u05ea (DSM p.174)."
        },
        {
          "text": "\u05e7\u05e8\u05d5\u05d1 \u05dc-100%, \u05d0\u05dc\u05d0 \u05d0\u05dd \u05ea\u05ea\u05d7\u05d9\u05dc \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Zuranolone \u05de\u05d9\u05d9\u05d3 \u05dc\u05d0\u05d7\u05e8 \u05d4\u05dc\u05d9\u05d3\u05d4.",
          "isCorrect": false,
          "rationale": "\u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05d2\u05d1\u05d5\u05d4 \u05d0\u05da \u05d0\u05d9\u05e0\u05d5 \u05d5\u05d3\u05d0\u05d9, \u05d5-Zuranolone \u05d0\u05d9\u05e0\u05d5 \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05de\u05e0\u05d9\u05e2\u05ea\u05d9 \u05d4\u05e1\u05d8\u05e0\u05d3\u05e8\u05d8\u05d9 \u05dc\u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d4 \u05d1\u05d9\u05e4\u05d5\u05dc\u05e8\u05d9\u05ea \u05dc\u05d0\u05d7\u05e8 \u05dc\u05d9\u05d3\u05d4 (DSM p.174)."
        },
        {
          "text": "\u05e1\u05d9\u05db\u05d5\u05df \u05d6\u05d4\u05d4 \u05dc\u05e1\u05d9\u05db\u05d5\u05df \u05dc-Maternity blues.",
          "isCorrect": false,
