        }
      ],
      "hint": "\u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4 \u05e9\u05dc \u05d4\u05e4\u05e8\u05e2\u05d4 \u05d1\u05d9\u05e4\u05d5\u05dc\u05e8\u05d9\u05ea \u05de\u05e2\u05dc\u05d4 \u05d0\u05ea \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05d1\u05d0\u05d5\u05e4\u05df \u05d3\u05e8\u05de\u05d8\u05d9 \u05dc\u05e2\u05d5\u05de\u05ea \u05d4\u05d0\u05d5\u05db\u05dc\u05d5\u05e1\u05d9\u05d9\u05d4 \u05d4\u05db\u05dc\u05dc\u05d9\u05ea.",
      "citation": "(DSM p.174)"
    },
    {
      "type": "multiple_select",
      "question": "\u05d0\u05d9\u05dc\u05d5 \u05de\u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9\u05dd \u05d4\u05d1\u05d0\u05d9\u05dd \u05de\u05d9\u05d9\u05d7\u05d3\u05d9\u05dd \u05d0\u05ea \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05e9\u05dc Neuroactive steroids (\u05db\u05de\u05d5 Allopregnanolone) \u05d1\u05d4\u05e9\u05d5\u05d5\u05d0\u05d4 \u05dc\u05d1\u05e0\u05d6\u05d5\u05d3\u05d9\u05d0\u05d6\u05e4\u05d9\u05e0\u05d9\u05dd \u05e7\u05dc\u05d0\u05e1\u05d9\u05d9\u05dd \u05e2\u05dc \u05e4\u05d9 StahlNeuro?",
      "answerOptions": [
        {
          "text": "\u05d9\u05db\u05d5\u05dc\u05ea \u05e7\u05d9\u05e9\u05d5\u05e8 \u05dc\u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 $GABA_{A}$ \u05d0\u05e7\u05e1\u05d8\u05e8\u05d4-\u05e1\u05d9\u05e0\u05e4\u05d8\u05d9\u05d9\u05dd \u05d4\u05de\u05db\u05d9\u05dc\u05d9\u05dd \u05ea\u05ea-\u05d9\u05d7\u05d9\u05d3\u05d4 $\\delta$.",
          "isCorrect": true,
          "rationale": "\u05e1\u05d8\u05e8\u05d5\u05d0\u05d9\u05d3\u05d9\u05dd \u05e0\u05d5\u05d9\u05e8\u05d5\u05d0\u05e7\u05d8\u05d9\u05d1\u05d9\u05d9\u05dd \u05e4\u05d5\u05e2\u05dc\u05d9\u05dd \u05e2\u05dc \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9\u05dd \u05d0\u05dc\u05d5 \u05d4\u05ea\u05d5\u05e8\u05de\u05d9\u05dd \u05dc\u05e2\u05d9\u05db\u05d5\u05d1 \u05d8\u05d5\u05e0\u05d9, \u05d1\u05e2\u05d5\u05d3 \u05d1\u05e0\u05d6\u05d5\u05d3\u05d9\u05d0\u05d6\u05e4\u05d9\u05e0\u05d9\u05dd \u05d0\u05d9\u05e0\u05dd \u05e4\u05d5\u05e2\u05dc\u05d9\u05dd \u05e2\u05dc\u05d9\u05d4\u05dd (StahlNeuro p.262, p.322)."
        },
        {
          "text": "\u05e7\u05d9\u05e9\u05d5\u05e8 \u05dc\u05d0\u05ea\u05e8 \u05de\u05d5\u05d3\u05d5\u05dc\u05e6\u05d9\u05d4 \u05d0\u05dc\u05d5\u05e1\u05d8\u05e8\u05d9 \u05d4\u05e9\u05d5\u05e0\u05d4 \u05de\u05d4\u05d0\u05ea\u05e8 \u05d4\u05d1\u05e0\u05d6\u05d5\u05d3\u05d9\u05d0\u05d6\u05e4\u05d9\u05e0\u05d9.",
          "isCorrect": true,
          "rationale": "\u05d4\u05e1\u05d8\u05e8\u05d5\u05d0\u05d9\u05d3\u05d9\u05dd \u05e0\u05e7\u05e9\u05e8\u05d9\u05dd \u05dc\u05d0\u05ea\u05e8 \u05d9\u05d9\u05e2\u05d5\u05d3\u05d9 (Neuroactive steroid site) \u05d4\u05de\u05de\u05d5\u05e7\u05dd \u05d1\u05ea\u05d5\u05da \u05d4-Channel \u05d0\u05d5 \u05d1\u05d9\u05df \u05d9\u05d7\u05d9\u05d3\u05d5\u05ea \u05d0\u05d7\u05e8\u05d5\u05ea (StahlNeuro p.322, p.325)."
        },
        {
          "text": "\u05d4\u05e9\u05d2\u05ea \u05d0\u05e4\u05e7\u05d8 \u05e0\u05d5\u05d2\u05d3 \u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05de\u05d4\u05d9\u05e8 (Rapid-onset) \u05d1-PPD.",
          "isCorrect": true,
          "rationale": "\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d6\u05d4 \u05de\u05d0\u05e4\u05e9\u05e8 \u05d4\u05d8\u05d1\u05d4 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05ea\u05d5\u05da \u05d9\u05de\u05d9\u05dd, \u05d1\u05e0\u05d9\u05d2\u05d5\u05d3 \u05dc\u05d1\u05e0\u05d6\u05d5\u05d3\u05d9\u05d0\u05d6\u05e4\u05d9\u05e0\u05d9\u05dd \u05e9\u05d0\u05d9\u05e0\u05dd \u05e0\u05d7\u05e9\u05d1\u05d9\u05dd \u05e0\u05d5\u05d2\u05d3\u05d9 \u05d3\u05d9\u05db\u05d0\u05d5\u05df (StahlNeuro p.320)."
        },
        {
          "text": "\u05d7\u05e1\u05d9\u05de\u05d4 \u05de\u05d5\u05d7\u05dc\u05d8\u05ea \u05e9\u05dc \u05ea\u05e2\u05dc\u05ea \u05d4\u05db\u05dc\u05d5\u05e8 \u05dc\u05dc\u05d0 \u05ea\u05dc\u05d5\u05ea \u05d1\u05e0\u05d5\u05db\u05d7\u05d5\u05ea GABA.",
          "isCorrect": false,
          "rationale": "\u05d4\u05dd \u05e4\u05d5\u05e2\u05dc\u05d9\u05dd \u05db-Positive Allosteric Modulators (PAMs) \u05d5\u05dc\u05db\u05df \u05de\u05d7\u05d6\u05e7\u05d9\u05dd \u05d0\u05ea \u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05d4-GABA \u05d4\u05e7\u05d9\u05d9\u05de\u05ea, \u05d5\u05dc\u05d0 \u05d7\u05d5\u05e1\u05de\u05d9\u05dd \u05d0\u05ea \u05d4\u05ea\u05e2\u05dc\u05d4 (StahlNeuro p.322)."
        }
