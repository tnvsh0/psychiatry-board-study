      "hint": "\u05d7\u05e9\u05d1\u05d5 \u05e2\u05dc \u05de\u05d9\u05e7\u05d5\u05dd \u05d4\u05e7\u05d5\u05dc\u05d8\u05e0\u05d9\u05dd (\u05e1\u05d9\u05e0\u05e4\u05d8\u05d9 \u05dc\u05e2\u05d5\u05de\u05ea \u05d0\u05e7\u05e1\u05d8\u05e8\u05d4-\u05e1\u05d9\u05e0\u05e4\u05d8\u05d9) \u05d5\u05e2\u05dc \u05d0\u05ea\u05e8 \u05d4\u05e7\u05d9\u05e9\u05d5\u05e8 \u05d4\u05de\u05d5\u05dc\u05e7\u05d5\u05dc\u05e8\u05d9.",
      "citation": "(StahlNeuro p.262, p.322, p.325)",
      "hasAllOfTheAbove": false,
      "hasNoneOfTheAbove": false
    },
    {
      "type": "fill_in_the_blank",
      "question": "\u05e2\u05dc \u05e4\u05d9 \u05d4-DSM-5-TR, \u05d1\u05de\u05e7\u05e8\u05d4 \u05e9\u05dc \u05d4\u05d5\u05e4\u05e2\u05ea \u05ea\u05e1\u05de\u05d9\u05e0\u05d9 \u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05ea\u05e7\u05d5\u05e4\u05d4 \u05e1\u05d1\u05d9\u05d1 \u05d4\u05dc\u05d9\u05d3\u05d4, \u05d9\u05e9 \u05dc\u05d1\u05e6\u05e2 \u05d0\u05d1\u05d7\u05e0\u05d4 \u05de\u05d1\u05d3\u05dc\u05ea \u05e2\u05dd \u05de\u05e6\u05d1\u05d9\u05dd \u05e8\u05e4\u05d5\u05d0\u05d9\u05d9\u05dd, \u05d5\u05d1\u05de\u05d9\u05d5\u05d7\u05d3 \u05e2\u05dd ___ \u05d0\u05e9\u05e8 \u05e2\u05dc\u05d5\u05dc\u05d4 \u05dc\u05d2\u05e8\u05d5\u05dd \u05dc\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d3\u05de\u05d5\u05d9\u05d9 \u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05d1\u05e0\u05e9\u05d9\u05dd \u05e4\u05e8\u05e0\u05d9\u05d8\u05dc\u05d9\u05d5\u05ea.",
      "bestAnswer": "thyroid abnormalities",
      "acceptableAnswers": [
        "\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05d1\u05d1\u05dc\u05d5\u05d8\u05ea \u05d4\u05ea\u05e8\u05d9\u05e1",
        "thyroid dysfunction",
        "hypothyroidism"
      ],
      "rationale": "\u05d4-DSM \u05de\u05e6\u05d9\u05d9\u05df \u05de\u05e4\u05d5\u05e8\u05e9\u05d5\u05ea \u05e9\u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd \u05d1\u05ea\u05e4\u05e7\u05d5\u05d3 \u05d1\u05dc\u05d5\u05d8\u05ea \u05d4\u05ea\u05e8\u05d9\u05e1 \u05e0\u05e4\u05d5\u05e6\u05d9\u05dd \u05d1\u05ea\u05e7\u05d5\u05e4\u05d4 \u05e9\u05dc\u05d0\u05d7\u05e8 \u05d4\u05dc\u05d9\u05d3\u05d4 \u05d5\u05e2\u05dc\u05d5\u05dc\u05d9\u05dd \u05dc\u05d7\u05e7\u05d5\u05ea \u05ea\u05e1\u05de\u05d9\u05e0\u05d9 MDE, \u05d5\u05dc\u05db\u05df \u05d9\u05e9 \u05dc\u05e9\u05dc\u05d5\u05dc \u05d0\u05d5\u05ea\u05dd \u05dc\u05e4\u05e0\u05d9 \u05d0\u05d1\u05d7\u05e0\u05ea PPD (DSM p.174, p.214).",
      "hint": "\u05de\u05d3\u05d5\u05d1\u05e8 \u05d1\u05d4\u05e4\u05e8\u05e2\u05d4 \u05d0\u05e0\u05d3\u05d5\u05e7\u05e8\u05d9\u05e0\u05d9\u05ea \u05e0\u05e4\u05d5\u05e6\u05d4 \u05de\u05d0\u05d5\u05d3 \u05d1\u05ea\u05e7\u05d5\u05e4\u05d4 \u05e9\u05dc\u05d0\u05d7\u05e8 \u05d4\u05dc\u05d9\u05d3\u05d4.",
