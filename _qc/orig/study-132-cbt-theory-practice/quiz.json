{
  "title": "CBT Quiz",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\u05de\u05ea\u05d1\u05d2\u05e8 \u05d1\u05df 16 \u05e2\u05dd Major Depressive Disorder \u05de\u05d3\u05d5\u05d5\u05d7 \u05dc\u05de\u05d8\u05e4\u05dc: \"\u05e0\u05db\u05e9\u05dc\u05ea\u05d9 \u05d1\u05de\u05d1\u05d7\u05df \u05d1\u05e0\u05d4\u05d9\u05d2\u05d4 \u05d4\u05d9\u05d5\u05dd. \u05d6\u05d4 \u05de\u05d5\u05db\u05d9\u05d7 \u05e9\u05d0\u05e0\u05d9 \u05db\u05d9\u05e9\u05dc\u05d5\u05df \u05de\u05d5\u05d7\u05dc\u05d8 \u05d5\u05e9\u05db\u05dc\u05d5\u05dd \u05dc\u05d0 \u05d9\u05d9\u05dc\u05da \u05dc\u05d9 \u05d1\u05d7\u05d9\u05d9\u05dd\". \u05d4\u05de\u05d8\u05e4\u05dc \u05de\u05d6\u05d4\u05d4 \u05d0\u05ea \u05d4-Cognitive Triad \u05e9\u05dc Beck. \u05e2\u05dc \u05e4\u05d9 \u05d4-Synopsis, \u05d0\u05d9\u05d6\u05d4 \u05e8\u05db\u05d9\u05d1 \u05d1\u05d8\u05e8\u05d9\u05d0\u05d3\u05d4 \u05d1\u05d0 \u05dc\u05d9\u05d3\u05d9 \u05d1\u05d9\u05d8\u05d5\u05d9 \u05d1\u05d8\u05e2\u05e0\u05d4 \"\u05db\u05dc\u05d5\u05dd \u05dc\u05d0 \u05d9\u05d9\u05dc\u05da \u05dc\u05d9 \u05d1\u05d7\u05d9\u05d9\u05dd\"?",
      "answerOptions": [
        {
          "text": "The Future",
          "isCorrect": true,
          "rationale": "\u05d4-Cognitive triad \u05db\u05d5\u05dc\u05dc \u05de\u05d7\u05e9\u05d1\u05d5\u05ea \u05e9\u05dc\u05d9\u05dc\u05d9\u05d5\u05ea \u05e2\u05dc \u05d4\u05e2\u05e6\u05de\u05d9, \u05d4\u05e2\u05d5\u05dc\u05dd \u05d5\u05d4\u05e2\u05ea\u05d9\u05d3; \u05d4\u05d9\u05d9\u05d0\u05d5\u05e9 \u05de\u05d4\u05e1\u05d9\u05db\u05d5\u05d9 \u05dc\u05d4\u05e6\u05dc\u05d9\u05d7 \u05d1\u05d4\u05de\u05e9\u05da \u05de\u05e9\u05e7\u05e3 \u05d0\u05ea \u05de\u05e8\u05db\u05d9\u05d1 \u05d4\u05e2\u05ea\u05d9\u05d3 (Synopsis ch.23)."
        },
        {
          "text": "The Self",
          "isCorrect": false,
          "rationale": "\u05d0\u05de\u05e0\u05dd \u05d4\u05d0\u05de\u05d9\u05e8\u05d4 \"\u05d0\u05e0\u05d9 \u05db\u05d9\u05e9\u05dc\u05d5\u05df\" \u05de\u05ea\u05d9\u05d9\u05d7\u05e1\u05ea \u05dc\u05e2\u05e6\u05de\u05d9, \u05d0\u05da \u05d4\u05d7\u05dc\u05e7 \u05d4\u05de\u05d3\u05d2\u05d9\u05e9 \u05e9\u05e9\u05d5\u05dd \u05d3\u05d1\u05e8 \u05dc\u05d0 \u05d9\u05e6\u05dc\u05d9\u05d7 \u05d1\u05e2\u05ea\u05d9\u05d3 \u05de\u05ea\u05de\u05e7\u05d3 \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05ea \u05d1-Future (Synopsis ch.23)."
        },
        {
          "text": "The World",
          "isCorrect": false,
          "rationale": "\u05ea\u05e4\u05d9\u05e1\u05ea \u05d4\u05e2\u05d5\u05dc\u05dd \u05db\u05d1\u05dc\u05ea\u05d9 \u05ea\u05d5\u05de\u05da \u05d0\u05d5 \u05e2\u05d5\u05d9\u05df \u05d4\u05d9\u05d0 \u05d7\u05dc\u05e7 \u05de\u05d4\u05d8\u05e8\u05d9\u05d0\u05d3\u05d4, \u05d0\u05da \u05d4\u05e6\u05d9\u05e4\u05d9\u05d9\u05d4 \u05dc\u05db\u05d9\u05e9\u05dc\u05d5\u05df \u05de\u05ea\u05de\u05e9\u05da \u05d4\u05d9\u05d0 \u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05e9\u05dc \u05ea\u05e4\u05d9\u05e1\u05ea \u05d4\u05e2\u05ea\u05d9\u05d3 (Synopsis ch.23)."
        },
        {
          "text": "The Environment",
          "isCorrect": false,
          "rationale": "\u05d4\u05e1\u05d1\u05d9\u05d1\u05d4 \u05d0\u05d9\u05e0\u05d4 \u05e8\u05db\u05d9\u05d1 \u05e0\u05e4\u05e8\u05d3 \u05d1\u05d8\u05e8\u05d9\u05d0\u05d3\u05d4 \u05d4\u05de\u05e7\u05d5\u05e8\u05d9\u05ea \u05e9\u05dc Beck, \u05d0\u05dc\u05d0 \u05e0\u05db\u05dc\u05dc\u05ea \u05ea\u05d7\u05ea \u05ea\u05e4\u05d9\u05e1\u05ea \u05d4-World (Synopsis ch.23)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05e6\u05d9\u05e8 \u05d4\u05d6\u05de\u05df \u05d4\u05de\u05e9\u05ea\u05e7\u05e3 \u05d1\u05d0\u05de\u05d9\u05e8\u05d4 \u05e2\u05dc \u05d7\u05d5\u05e1\u05e8 \u05d4\u05e6\u05dc\u05d7\u05d4 \u05e2\u05ea\u05d9\u05d3\u05d9."
    },
    {
      "type": "multiple_choice",
      "question": "\u05d9\u05dc\u05d3\u05d4 \u05d1\u05ea 9 \u05d4\u05e1\u05d5\u05d1\u05dc\u05ea \u05de-OCD \u05e2\u05dd \u05de\u05d7\u05e9\u05d1\u05d5\u05ea \u05d7\u05d5\u05d3\u05e8\u05e0\u05d9\u05d5\u05ea \u05e2\u05dc \u05d6\u05d9\u05d4\u05d5\u05dd (Contamination) \u05de\u05ea\u05d7\u05d9\u05dc\u05d4 \u05d8\u05d9\u05e4\u05d5\u05dc ERP. \u05d1\u05de\u05d4\u05dc\u05da \u05d4-In-vivo exposure, \u05d4\u05d9\u05d0 \u05e0\u05d5\u05d2\u05e2\u05ea \u05d1\u05d9\u05d3\u05d9\u05ea \u05e9\u05dc \u05e9\u05d9\u05e8\u05d5\u05ea\u05d9\u05dd \u05e6\u05d9\u05d1\u05d5\u05e8\u05d9\u05d9\u05dd. \u05de\u05d4\u05d5 \u05d4\u05de\u05e8\u05db\u05d9\u05d1 \u05d4\u05e7\u05e8\u05d9\u05d8\u05d9 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d1-Response Prevention (RP) \u05d1\u05de\u05e7\u05e8\u05d4 \u05d6\u05d4 \u05db\u05d3\u05d9 \u05dc\u05d4\u05e9\u05d9\u05d2 Fear extinction learning?",
      "answerOptions": [
        {
          "text": "\u05d7\u05e1\u05d9\u05de\u05ea \u05d4\u05d7\u05d9\u05d6\u05d5\u05e7 \u05d4\u05e9\u05dc\u05d9\u05dc\u05d9 (Negative reinforcement) \u05e9\u05e0\u05d5\u05e6\u05e8 \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d4\u05d8\u05e7\u05e1\u05d9\u05dd",
          "isCorrect": true,
          "rationale": "\u05d4-Response prevention \u05e0\u05d5\u05e2\u05d3 \u05dc\u05de\u05e0\u05d5\u05e2 \u05d0\u05ea \u05d4\u05d8\u05e7\u05e1 \u05e9\u05de\u05e4\u05d7\u05d9\u05ea \u05d7\u05e8\u05d3\u05d4, \u05d5\u05d1\u05db\u05da \u05dc\u05d7\u05e1\u05d5\u05dd \u05d0\u05ea \u05d4\u05d7\u05d9\u05d6\u05d5\u05e7 \u05d4\u05e9\u05dc\u05d9\u05dc\u05d9 \u05e9\u05de\u05e9\u05de\u05e8 \u05d0\u05ea \u05d4\u05d4\u05e4\u05e8\u05e2\u05d4 (Dulcan p.374)."
        },
        {
          "text": "\u05e2\u05d9\u05d3\u05d5\u05d3 \u05d4\u05de\u05d8\u05d5\u05e4\u05dc\u05ea \u05dc\u05d4\u05e9\u05ea\u05de\u05e9 \u05d1\u05d8\u05db\u05e0\u05d9\u05e7\u05d5\u05ea \u05d4\u05e8\u05e4\u05d9\u05d4 \u05d1\u05d6\u05de\u05df \u05d4\u05d7\u05e9\u05d9\u05e4\u05d4",
          "isCorrect": false,
          "rationale": "\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05d8\u05db\u05e0\u05d9\u05e7\u05d5\u05ea \u05d4\u05e8\u05e4\u05d9\u05d4 \u05e2\u05dc\u05d5\u05dc \u05dc\u05e9\u05de\u05e9 \u05db-Safety behavior \u05e9\u05de\u05d5\u05e0\u05e2 \u05d7\u05e9\u05d9\u05e4\u05d4 \u05de\u05dc\u05d0\u05d4 \u05dc\u05d7\u05e8\u05d3\u05d4 \u05d5\u05de\u05e2\u05db\u05d1 \u05dc\u05de\u05d9\u05d3\u05d4 \u05de\u05e2\u05db\u05d1\u05ea (Dulcan p.968)."
        },
        {
          "text": "\u05d4\u05e1\u05d7\u05ea \u05d3\u05e2\u05ea \u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9\u05ea \u05de\u05d4\u05de\u05d2\u05e2 \u05d4\u05de\u05d6\u05d5\u05d4\u05dd",
          "isCorrect": false,
          "rationale": "\u05d4\u05e1\u05d7\u05ea \u05d3\u05e2\u05ea \u05de\u05d5\u05e0\u05e2\u05ea \u05d0\u05ea \u05d4\u05e4\u05e2\u05dc\u05ea \u05d4-Fear networks \u05d4\u05d3\u05e8\u05d5\u05e9\u05d4 \u05dc\u05e9\u05d9\u05e0\u05d5\u05d9 \u05e7\u05dc\u05d9\u05e0\u05d9 (Dulcan p.968)."
        },
        {
          "text": "\u05de\u05ea\u05df \u05d7\u05d9\u05d6\u05d5\u05e7 \u05d7\u05d9\u05d5\u05d1\u05d9 (Positive reinforcement) \u05de\u05d9\u05d3 \u05dc\u05d0\u05d7\u05e8 \u05d4\u05d8\u05e7\u05e1",
          "isCorrect": false,
          "rationale": "\u05d7\u05d9\u05d6\u05d5\u05e7 \u05d4\u05d8\u05e7\u05e1 \u05e8\u05e7 \u05d9\u05d2\u05d1\u05d9\u05e8 \u05d0\u05ea \u05ea\u05d3\u05d9\u05e8\u05d5\u05ea \u05d4\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d4\u05db\u05e4\u05d9\u05d9\u05ea\u05d9\u05ea \u05d1\u05de\u05e7\u05d5\u05dd \u05dc\u05d4\u05e4\u05e1\u05d9\u05e7\u05d4 (Dulcan p.148)."
        }
      ],
      "hint": "\u05d4\u05ea\u05de\u05e7\u05d3 \u05d1\u05de\u05d4 \u05e9\u05e7\u05d5\u05e8\u05d4 \u05db\u05d0\u05e9\u05e8 \u05de\u05d5\u05e0\u05e2\u05d9\u05dd \u05de\u05d4\u05de\u05d8\u05d5\u05e4\u05dc\u05ea \u05dc\u05d1\u05e6\u05e2 \u05d0\u05ea \u05d4\u05e4\u05e2\u05d5\u05dc\u05d4 \u05d4\u05de\u05e8\u05d2\u05d9\u05e2\u05d4."
    },
    {
      "type": "fill_in_the_blank",
      "question": "\u05d1\u05d8\u05d9\u05e4\u05d5\u05dc \u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9-\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea\u05d9 \u05d1-Depression, \u05d4\u05de\u05d5\u05e9\u05d2 ___ \u05de\u05ea\u05d9\u05d9\u05d7\u05e1 \u05dc\u05e0\u05d9\u05e1\u05d9\u05d5\u05df \u05de\u05d5\u05d1\u05e0\u05d4 \u05dc\u05d4\u05d2\u05d1\u05d9\u05e8 \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05d9\u05d5\u05ea \u05d2\u05dc\u05d5\u05d9\u05d5\u05ea \u05e9\u05de\u05d1\u05d9\u05d0\u05d5\u05ea \u05d0\u05ea \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05d1\u05de\u05d2\u05e2 \u05e2\u05dd \u05d7\u05d9\u05d6\u05d5\u05e7\u05d9\u05dd \u05e1\u05d1\u05d9\u05d1\u05ea\u05d9\u05d9\u05dd \u05d7\u05d9\u05d5\u05d1\u05d9\u05d9\u05dd (Synopsis ch.23).",
      "bestAnswer": "Behavioral activation",
      "acceptableAnswers": [
