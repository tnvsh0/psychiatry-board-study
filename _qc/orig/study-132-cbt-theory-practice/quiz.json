      ],
      "rationale": "Behavioral activation \u05de\u05d1\u05d5\u05e1\u05e1 \u05e2\u05dc \u05d4\u05d4\u05e0\u05d7\u05d4 \u05e9\u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05e0\u05e9\u05de\u05e8 \u05e2\u05e7\u05d1 \u05d7\u05d5\u05e1\u05e8 \u05d1\u05d7\u05d9\u05d6\u05d5\u05e7\u05d9\u05dd \u05d7\u05d9\u05d5\u05d1\u05d9\u05d9\u05dd \u05d5\u05e0\u05e1\u05d9\u05d2\u05d4 \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea\u05d9\u05ea (Synopsis ch.23).",
      "hint": "\u05d6\u05d4\u05d5 \u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05e2\u05d5\u05de\u05d3 \u05d1\u05e4\u05e0\u05d9 \u05e2\u05e6\u05de\u05d5 \u05d0\u05d5 \u05db\u05d7\u05dc\u05e7 \u05de-CBT \u05d5\u05de\u05ea\u05de\u05e7\u05d3 \u05d1\u05e9\u05d9\u05e0\u05d5\u05d9 \u05e8\u05de\u05ea \u05d4\u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05e9\u05dc \u05d4\u05de\u05d8\u05d5\u05e4\u05dc."
    },
    {
      "type": "multiple_select",
      "question": "\u05de\u05d8\u05e4\u05dc \u05de\u05d1\u05e6\u05e2 Functional behavior analysis \u05e2\u05d1\u05d5\u05e8 \u05d9\u05dc\u05d3 \u05e2\u05dd ADHD \u05d5\u05e7\u05e9\u05d9\u05d9\u05dd \u05d1\u05d4\u05e9\u05dc\u05de\u05ea \u05de\u05d8\u05dc\u05d5\u05ea \u05d1\u05d1\u05d9\u05ea \u05d4\u05e1\u05e4\u05e8. \u05e2\u05dc \u05e4\u05d9 \u05d4-ABC model \u05d4\u05de\u05ea\u05d5\u05d0\u05e8 \u05d1-Dulcan, \u05d0\u05d9\u05dc\u05d5 \u05de\u05d4\u05e4\u05e2\u05d5\u05dc\u05d5\u05ea \u05d4\u05d1\u05d0\u05d5\u05ea \u05e0\u05d7\u05e9\u05d1\u05d5\u05ea \u05dc\u05e9\u05d9\u05e0\u05d5\u05d9 \u05e9\u05dc \u05d4-Antecedents?",
      "answerOptions": [
        {
          "text": "\u05d7\u05dc\u05d5\u05e7\u05ea \u05d4\u05de\u05d8\u05dc\u05d4 \u05d4\u05dc\u05d9\u05de\u05d5\u05d3\u05d9\u05ea \u05dc\u05e9\u05dc\u05d1\u05d9\u05dd \u05e7\u05d8\u05e0\u05d9\u05dd \u05d5\u05d1\u05e8\u05d5\u05e8\u05d9\u05dd",
          "isCorrect": true,
          "rationale": "\u05e9\u05d9\u05e0\u05d5\u05d9 \u05d4\u05de\u05d8\u05dc\u05d4 \u05e2\u05e6\u05de\u05d4 \u05dc\u05e4\u05e0\u05d9 \u05e9\u05d4\u05d9\u05dc\u05d3 \u05de\u05ea\u05d7\u05d9\u05dc \u05dc\u05d1\u05e6\u05e2 \u05d0\u05d5\u05ea\u05d4 \u05d4\u05d5\u05d0 \u05d4\u05ea\u05e2\u05e8\u05d1\u05d5\u05ea \u05d1\u05e8\u05de\u05ea \u05d4-Antecedent (Dulcan p.148)."
        },
        {
          "text": "\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05e2\u05d6\u05e8\u05d9\u05dd \u05d5\u05d9\u05d6\u05d5\u05d0\u05dc\u05d9\u05d9\u05dd \u05dc\u05d4\u05de\u05d7\u05e9\u05ea \u05e1\u05d3\u05e8 \u05d4\u05d9\u05d5\u05dd",
          "isCorrect": true,
          "rationale": "\u05d0\u05e8\u05d2\u05d5\u05df \u05d4\u05e1\u05d1\u05d9\u05d1\u05d4 \u05dc\u05e4\u05e0\u05d9 \u05d4\u05d1\u05d9\u05e6\u05d5\u05e2 \u05e0\u05d5\u05e2\u05d3 \u05dc\u05d4\u05d2\u05d3\u05d9\u05e8 \u05d0\u05ea \u05d4\u05d2\u05d9\u05e8\u05d5\u05d9 \u05d4\u05de\u05e7\u05d3\u05d9\u05dd \u05dc\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d4\u05e8\u05e6\u05d5\u05d9\u05d4 (Dulcan p.148)."
        },
        {
          "text": "\u05de\u05ea\u05df \u05de\u05d3\u05d1\u05e7\u05d4 \u05de\u05d9\u05d3 \u05dc\u05d0\u05d7\u05e8 \u05e1\u05d9\u05d5\u05dd \u05db\u05dc \u05e9\u05dc\u05d1 \u05d1\u05de\u05d8\u05dc\u05d4",
          "isCorrect": false,
          "rationale": "\u05de\u05ea\u05df \u05e4\u05e8\u05e1 \u05dc\u05d0\u05d7\u05e8 \u05d4\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d4\u05d5\u05d0 \u05e9\u05d9\u05e0\u05d5\u05d9 \u05e9\u05dc \u05d4-Consequence, \u05dc\u05d0 \u05d4-Antecedent (Dulcan p.148)."
        },
        {
