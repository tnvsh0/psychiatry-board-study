        },
        {
          "text": "\u05db\u05d4\u05e4\u05e8\u05e2\u05d4 \u05d4\u05de\u05ea\u05d5\u05d5\u05db\u05ea \u05d1\u05dc\u05e2\u05d3\u05d9\u05ea \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d7\u05d5\u05e1\u05e8 \u05d1-$Serotonin$ \u05d1-$Prefrontal$ $Cortex$.",
          "isCorrect": false,
          "rationale": "\u05d4\u05de\u05d5\u05d3\u05dc \u05e9\u05dc \u05e1\u05db\u05d9\u05d6\u05d5\u05e4\u05e8\u05e0\u05d9\u05d4 \u05d5\u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d4 \u05de\u05d5\u05e8\u05db\u05d1 \u05d5\u05db\u05d5\u05dc\u05dc \u05d0\u05d9\u05e0\u05d8\u05e8\u05d0\u05e7\u05e6\u05d9\u05d4 \u05d1\u05d9\u05df \u05d3\u05d5\u05e4\u05de\u05d9\u05df, \u05d2\u05dc\u05d5\u05d8\u05de\u05d8 \u05d5\u05e1\u05e8\u05d5\u05d8\u05d5\u05e0\u05d9\u05df, \u05d5\u05dc\u05d0 \u05e8\u05e7 \u05de\u05d5\u05dc\u05d9\u05da \u05e2\u05e6\u05d1\u05d9 \u05d0\u05d7\u05d3 (StahlNeuro p.150)."
