{
  "title": "Gender Quiz",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\u05d1\u05df 7 \u05de\u05d5\u05e4\u05e0\u05d4 \u05dc\u05d4\u05e2\u05e8\u05db\u05d4 \u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9\u05ea \u05e2\u05e7\u05d1 \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05e9\u05d0\u05d9\u05e0\u05d4 \u05ea\u05d5\u05d0\u05de\u05ea \u05de\u05d2\u05d3\u05e8. \u05d4\u05d4\u05d5\u05e8\u05d9\u05dd \u05de\u05d3\u05d5\u05d5\u05d7\u05d9\u05dd \u05db\u05d9 \u05d4\u05d9\u05dc\u05d3 \u05de\u05e2\u05d3\u05d9\u05e3 \u05dc\u05e9\u05d7\u05e7 \u05d1\u05d1\u05d5\u05d1\u05d5\u05ea, \u05e0\u05de\u05e0\u05e2 \u05d1\u05d0\u05d5\u05e4\u05df \u05e2\u05e7\u05d1\u05d9 \u05de\u05de\u05e9\u05d7\u05e7\u05d9 rough-and-tumble play, \u05d5\u05de\u05e2\u05d3\u05d9\u05e3 \u05d7\u05d1\u05e8\u05d5\u05ea \u05d1\u05e0\u05d5\u05ea \u05d1\u05dc\u05d1\u05d3. \u05d1\u05e8\u05d0\u05d9\u05d5\u05df, \u05d4\u05d9\u05dc\u05d3 \u05de\u05e6\u05d9\u05d9\u05df \u05db\u05d9 \u05d4\u05d5\u05d0 \u05d0\u05d5\u05d4\u05d1 \u05dc\u05e9\u05d7\u05e7 \u05e2\u05dd \u05d1\u05e0\u05d5\u05ea \u05db\u05d9 \u05d4\u05df '\u05e0\u05d7\u05de\u05d3\u05d5\u05ea \u05d9\u05d5\u05ea\u05e8' \u05d0\u05da \u05d4\u05d5\u05d0 \u05de\u05e6\u05d9\u05d9\u05df \u05e9\u05d8\u05d5\u05d1 \u05dc\u05d5 \u05dc\u05d4\u05d9\u05d5\u05ea \u05d1\u05df \u05d5\u05d0\u05d9\u05df \u05dc\u05d5 \u05e8\u05e6\u05d5\u05df \u05dc\u05d4\u05d9\u05d5\u05ea \u05d1\u05ea. \u05de\u05d4\u05d5 \u05d4\u05e6\u05e2\u05d3 \u05d4\u05d0\u05d1\u05d7\u05e0\u05ea\u05d9 \u05d4\u05e0\u05db\u05d5\u05df \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR?",
      "answerOptions": [
        {
          "text": "\u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc Gender nonconformity \u05d5\u05dc\u05d0 Gender Dysphoria.",
          "isCorrect": true,
          "rationale": "\u05d1\u05d0\u05d1\u05d7\u05d5\u05df \u05d9\u05dc\u05d3\u05d9\u05dd, \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df A1 (\u05e8\u05e6\u05d5\u05df \u05e2\u05d6 \u05dc\u05d4\u05d9\u05d5\u05ea \u05d1\u05df \u05d4\u05de\u05d2\u05d3\u05e8 \u05d4\u05e9\u05e0\u05d9 \u05d0\u05d5 \u05d4\u05ea\u05e2\u05e7\u05e9\u05d5\u05ea \u05e2\u05dc \u05db\u05da) \u05d4\u05d5\u05d0 \u05ea\u05e0\u05d0\u05d9 \u05d7\u05d5\u05d1\u05d4. \u05d1\u05d4\u05d9\u05e2\u05d3\u05e8 \u05e8\u05e6\u05d5\u05df \u05d6\u05d4, \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05d9\u05d5\u05ea \u05e1\u05d8\u05e8\u05d9\u05d0\u05d5\u05d8\u05d9\u05e4\u05d9\u05d5\u05ea \u05dc\u05d1\u05d3\u05df \u05d0\u05d9\u05e0\u05df \u05de\u05e1\u05e4\u05d9\u05e7\u05d5\u05ea \u05dc\u05d0\u05d1\u05d7\u05e0\u05d4 (DSM p.512, p.519)."
        },
        {
          "text": "\u05de\u05ea\u05df \u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc Gender Dysphoria in Children (F64.2) \u05e2\u05e7\u05d1 \u05e2\u05de\u05d9\u05d3\u05d4 \u05d1-3 \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea\u05d9\u05d9\u05dd.",
          "isCorrect": false,
          "rationale": "\u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d3\u05d5\u05e8\u05e9\u05ea \u05dc\u05e4\u05d7\u05d5\u05ea 6 \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05de\u05ea\u05d5\u05da 8, \u05db\u05d0\u05e9\u05e8 \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df A1 \u05d4\u05d5\u05d0 \u05d7\u05d5\u05d1\u05d4 (DSM p.512)."
        },
        {
          "text": "\u05d4\u05e4\u05e0\u05d9\u05d4 \u05dc\u05d1\u05d3\u05d9\u05e7\u05ea \u05e7\u05e8\u05d9\u05d5\u05d8\u05d9\u05e4 \u05dc\u05e9\u05dc\u05d9\u05dc\u05ea Disorders of Sex Development (DSD).",
          "isCorrect": false,
          "rationale": "\u05d0\u05de\u05e0\u05dd DSD \u05e2\u05e9\u05d5\u05d9\u05d9\u05dd \u05dc\u05d4\u05ea\u05e7\u05d9\u05d9\u05dd, \u05d0\u05da \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9\u05e7\u05d4 \u05d4\u05de\u05ea\u05d5\u05d0\u05e8\u05ea \u05d0\u05d9\u05e0\u05d4 \u05de\u05e6\u05d1\u05d9\u05e2\u05d4 \u05e2\u05dc \u05e6\u05d5\u05e8\u05da \u05e8\u05e4\u05d5\u05d0\u05d9 \u05de\u05d9\u05d9\u05d3\u05d9 \u05d1\u05d1\u05d9\u05e8\u05d5\u05e8 \u05d2\u05e0\u05d8\u05d9 \u05dc\u05e4\u05e0\u05d9 \u05d4\u05e2\u05e8\u05db\u05d4 \u05e4\u05e1\u05d9\u05db\u05d5-\u05e1\u05d5\u05e6\u05d9\u05d0\u05dc\u05d9\u05ea (DSM p.511)."
        },
        {
          "text": "\u05de\u05ea\u05df \u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc Unspecified Gender Dysphoria \u05e2\u05e7\u05d1 \u05d4\u05de\u05e6\u05d5\u05e7\u05d4 \u05e9\u05dc \u05d4\u05d4\u05d5\u05e8\u05d9\u05dd.",
          "isCorrect": false,
          "rationale": "\u05d0\u05d1\u05d7\u05e0\u05ea Gender Dysphoria \u05d3\u05d5\u05e8\u05e9\u05ea \u05de\u05e6\u05d5\u05e7\u05d4 \u05d0\u05d5 \u05d4\u05e4\u05e8\u05e2\u05d4 \u05ea\u05e4\u05e7\u05d5\u05d3\u05d9\u05ea \u05e9\u05dc \u05d4\u05e4\u05e8\u05d8 \u05e2\u05e6\u05de\u05d5, \u05d5\u05dc\u05d0 \u05e9\u05dc \u05d4\u05e1\u05d1\u05d9\u05d1\u05d4 \u05d1\u05dc\u05d1\u05d3, \u05d5\u05d0\u05d9\u05e0\u05d4 \u05e0\u05d9\u05ea\u05e0\u05ea \u05e2\u05dc \u05e1\u05de\u05da \u05d0\u05d9-\u05ea\u05d0\u05d9\u05de\u05d5\u05ea \u05ea\u05e4\u05e7\u05d9\u05d3\u05d9 \u05de\u05d2\u05d3\u05e8 (DSM p.512, p.519)."
        }
      ],
      "hint": "\u05d1\u05d3\u05d5\u05e7 \u05d0\u05ea \u05d3\u05e8\u05d9\u05e9\u05d5\u05ea \u05d4\u05d7\u05d5\u05d1\u05d4 \u05e2\u05d1\u05d5\u05e8 \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df A \u05d1\u05d0\u05d1\u05d7\u05e0\u05ea \u05d9\u05dc\u05d3\u05d9\u05dd \u05dc\u05e2\u05d5\u05de\u05ea \u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd."
    },
    {
      "type": "multiple_choice",
      "question": "\u05de\u05ea\u05d1\u05d2\u05e8 \u05d1\u05df 16, \u05d4\u05de\u05d0\u05d5\u05d1\u05d7\u05df \u05e2\u05dd Gender Dysphoria, \u05de\u05d3\u05d5\u05d5\u05d7 \u05e2\u05dc \u05ea\u05d7\u05d5\u05e9\u05d5\u05ea \u05e7\u05e9\u05d5\u05ea \u05e9\u05dc \u05d3\u05db\u05d0\u05d5\u05df, \u05d7\u05e8\u05d3\u05d4 \u05d7\u05d1\u05e8\u05ea\u05d9\u05ea \u05d5\u05e2\u05e8\u05da \u05e2\u05e6\u05de\u05d9 \u05e0\u05de\u05d5\u05da. \u05d4\u05d5\u05d0 \u05de\u05e6\u05d9\u05d9\u05df \u05db\u05d9 \u05d4\u05d5\u05d0 '\u05de\u05e8\u05d2\u05d9\u05e9 \u05e4\u05d2\u05d5\u05dd' \u05d5\u05d7\u05d5\u05e9\u05e9 \u05e9\u05d7\u05d1\u05e8\u05d9\u05d5 \u05dc\u05db\u05d9\u05ea\u05d4 \u05d9\u05d2\u05dc\u05d5 \u05d0\u05ea \u05d6\u05d4\u05d5\u05ea\u05d5 \u05d5\u05d9\u05dc\u05e2\u05d2\u05d5 \u05dc\u05d5. \u05dc\u05e4\u05d9 \u05d4-Minority Stress Model, \u05db\u05d9\u05e6\u05d3 \u05de\u05d5\u05d2\u05d3\u05e8 \u05d4\u05e8\u05db\u05d9\u05d1 \u05e9\u05dc '\u05d7\u05e9\u05e9 \u05de\u05d4\u05dc\u05e2\u05d2' \u05d5'\u05d4\u05ea\u05d7\u05d5\u05e9\u05d4 \u05e9\u05d4\u05d5\u05d0 \u05e4\u05d2\u05d5\u05dd'?",
      "answerOptions": [
        {
          "text": "\u05d4\u05e8\u05d0\u05e9\u05d5\u05df \u05d4\u05d5\u05d0 Proximal stressor (internalized transphobia) \u05d5\u05d4\u05e9\u05e0\u05d9 \u05d4\u05d5\u05d0 Distal stressor.",
          "isCorrect": false,
          "rationale": "\u05d4\u05ea\u05d7\u05d5\u05e9\u05d4 \u05d4\u05e2\u05e6\u05de\u05d9\u05ea \u05e9\u05dc '\u05e4\u05d2\u05d5\u05dd' \u05d4\u05d9\u05d0 \u05e1\u05d8\u05e8\u05e1\u05d5\u05e8 \u05e4\u05e0\u05d9\u05de\u05d9 (Internalized), \u05d1\u05e2\u05d5\u05d3 \u05d4\u05d7\u05e9\u05e9 \u05de\u05e4\u05e0\u05d9 \u05dc\u05e2\u05d2 \u05e2\u05ea\u05d9\u05d3\u05d9 \u05d4\u05d5\u05d0 \u05e6\u05d9\u05e4\u05d9\u05d9\u05d4 \u05dc\u05d3\u05d7\u05d9\u05d9\u05d4 (Anticipated rejection), \u05e9\u05e0\u05d9\u05d4\u05dd \u05e0\u05d7\u05e9\u05d1\u05d9\u05dd \u05e1\u05d8\u05e8\u05e1\u05d5\u05e8\u05d9\u05dd \u05e4\u05e8\u05d5\u05e7\u05e1\u05d9\u05de\u05dc\u05d9\u05d9\u05dd (Dulcan p.570)."
        },
        {
          "text": "\u05e9\u05e0\u05d9\u05d4\u05dd \u05de\u05d4\u05d5\u05d5\u05d9\u05dd Distal stressors \u05d4\u05e0\u05d5\u05d1\u05e2\u05d9\u05dd \u05de\u05d0\u05e4\u05dc\u05d9\u05d4 \u05de\u05d1\u05e0\u05d9\u05ea.",
          "isCorrect": false,
          "rationale": "\u05e1\u05d8\u05e8\u05e1\u05d5\u05e8\u05d9\u05dd \u05d3\u05d9\u05e1\u05d8\u05dc\u05d9\u05d9\u05dd \u05d4\u05dd \u05d0\u05d9\u05e8\u05d5\u05e2\u05d9\u05dd \u05d0\u05d5\u05d1\u05d9\u05d9\u05e7\u05d8\u05d9\u05d1\u05d9\u05d9\u05dd \u05d7\u05d9\u05e6\u05d5\u05e0\u05d9\u05d9\u05dd \u05db\u05de\u05d5 \u05d0\u05e4\u05dc\u05d9\u05d4 \u05d1\u05e4\u05d5\u05e2\u05dc \u05d0\u05d5 \u05d0\u05dc\u05d9\u05de\u05d5\u05ea, \u05d5\u05dc\u05d0 \u05ea\u05d7\u05d5\u05e9\u05d5\u05ea \u05e4\u05e0\u05d9\u05de\u05d9\u05d5\u05ea \u05d0\u05d5 \u05e6\u05d9\u05e4\u05d9\u05d5\u05ea (Dulcan p.570)."
        },
        {
          "text": "\u05d4\u05ea\u05d7\u05d5\u05e9\u05d4 \u05e9\u05d4\u05d5\u05d0 '\u05e4\u05d2\u05d5\u05dd' \u05d4\u05d9\u05d0 Internalized stigma \u05d5\u05d4\u05d7\u05e9\u05e9 \u05de\u05dc\u05d2\u05dc\u05d5\u05d2 \u05d4\u05d5\u05d0 Expectation of rejection.",
          "isCorrect": true,
          "rationale": "\u05de\u05d5\u05d3\u05dc \u05dc\u05d7\u05e5 \u05d4\u05de\u05d9\u05e2\u05d5\u05d8 \u05de\u05d1\u05d7\u05d9\u05df \u05d1\u05d9\u05df \u05e1\u05d8\u05e8\u05e1\u05d5\u05e8\u05d9\u05dd \u05d7\u05d9\u05e6\u05d5\u05e0\u05d9\u05d9\u05dd (Distal) \u05dc\u05e4\u05e0\u05d9\u05de\u05d9\u05d9\u05dd (Proximal), \u05d4\u05db\u05d5\u05dc\u05dc\u05d9\u05dd \u05e1\u05d8\u05d9\u05d2\u05de\u05d4 \u05de\u05d5\u05e4\u05e0\u05de\u05ea \u05d5\u05e6\u05d9\u05e4\u05d9\u05d9\u05d4 \u05dc\u05d0\u05d9\u05e8\u05d5\u05e2\u05d9 \u05d3\u05d7\u05d9\u05d9\u05d4 (Dulcan p.570; Hendricks & Testa 2012)."
        },
        {
          "text": "\u05de\u05d3\u05d5\u05d1\u05e8 \u05d1\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05e9\u05dc MDD \u05e9\u05d0\u05d9\u05e0\u05dd \u05e7\u05e9\u05d5\u05e8\u05d9\u05dd \u05dc\u05d6\u05d4\u05d5\u05ea \u05d4\u05de\u05d2\u05d3\u05e8\u05d9\u05ea.",
          "isCorrect": false,
          "rationale": "\u05d4\u05de\u05d5\u05d3\u05dc \u05de\u05d3\u05d2\u05d9\u05e9 \u05db\u05d9 \u05e4\u05e2\u05e8\u05d9\u05dd \u05d1\u05d1\u05e8\u05d9\u05d0\u05d5\u05ea \u05d4\u05e0\u05e4\u05e9 \u05d1\u05e7\u05d4\u05d9\u05dc\u05ea \u05d4-LGBTQ+ \u05de\u05ea\u05d5\u05d5\u05db\u05d9\u05dd \u05e2\u05dc \u05d9\u05d3\u05d9 \u05dc\u05d7\u05e5 \u05d4\u05de\u05d9\u05e2\u05d5\u05d8 \u05d5\u05dc\u05d0 \u05e0\u05d5\u05d1\u05e2\u05d9\u05dd \u05de\u05e2\u05e6\u05dd \u05d4\u05d6\u05d4\u05d5\u05ea (Dulcan p.570)."
        }
      ],
      "hint": "\u05d4\u05d1\u05d7\u05df \u05d1\u05d9\u05df \u05d0\u05d9\u05e8\u05d5\u05e2\u05d9\u05dd \u05d7\u05d9\u05e6\u05d5\u05e0\u05d9\u05d9\u05dd \u05d0\u05d5\u05d1\u05d9\u05d9\u05e7\u05d8\u05d9\u05d1\u05d9\u05d9\u05dd \u05dc\u05d1\u05d9\u05df \u05ea\u05d4\u05dc\u05d9\u05db\u05d9\u05dd \u05e4\u05e1\u05d9\u05db\u05d5\u05dc\u05d5\u05d2\u05d9\u05d9\u05dd \u05e4\u05e0\u05d9\u05de\u05d9\u05d9\u05dd \u05d4\u05de\u05ea\u05d5\u05d5\u05db\u05d9\u05dd \u05d0\u05ea \u05d4\u05dc\u05d7\u05e5."
    },
    {
      "type": "multiple_choice",
      "question": "\u05de\u05d8\u05d5\u05e4\u05dc\u05ea \u05d1\u05ea 19 \u05d4\u05de\u05d5\u05e4\u05e0\u05d9\u05ea \u05e2\u05e7\u05d1 \u05e8\u05e6\u05d5\u05df \u05dc\u05d1\u05d9\u05e6\u05d5\u05e2 \u05e0\u05d9\u05ea\u05d5\u05d7 \u05dc\u05db\u05e8\u05d9\u05ea\u05ea \u05e9\u05d3\u05d9\u05d9\u05dd (Mastectomy). \u05d4\u05d9\u05d0 \u05de\u05d3\u05d5\u05d5\u05d7\u05ea \u05db\u05d9 \u05d4\u05d9\u05d0 \u05d7\u05e9\u05d4 \u05e9\u05d4\u05e9\u05d3\u05d9\u05d9\u05dd \u05e9\u05dc\u05d4 '\u05de\u05e2\u05d5\u05d5\u05ea\u05d9\u05dd \u05d5\u05d0\u05e1\u05d9\u05de\u05d8\u05e8\u05d9\u05d9\u05dd \u05d1\u05d0\u05d5\u05e4\u05df \u05d3\u05d5\u05d7\u05d4' \u05d5\u05db\u05d9 \u05d4\u05d9\u05d0 \u05de\u05e8\u05d2\u05d9\u05e9\u05d4 \u05e9\u05d4\u05dd \u05d0\u05d9\u05e0\u05dd \u05e9\u05d9\u05d9\u05db\u05d9\u05dd \u05dc\u05d2\u05d5\u05e4\u05d4 \u05db\u05d9\u05d5\u05d5\u05df \u05e9\u05d4\u05dd '\u05e4\u05d2\u05dd \u05d0\u05e1\u05ea\u05d8\u05d9'. \u05d4\u05d9\u05d0 \u05d0\u05d9\u05e0\u05d4 \u05de\u05d3\u05d5\u05d5\u05d7\u05ea \u05e2\u05dc \u05d0\u05d9-\u05ea\u05d0\u05d9\u05de\u05d5\u05ea \u05de\u05d2\u05d3\u05e8\u05d9\u05ea \u05d0\u05d5 \u05e8\u05e6\u05d5\u05df \u05dc\u05d4\u05d9\u05d5\u05ea \u05d2\u05d1\u05e8. \u05de\u05d4\u05d9 \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05de\u05d1\u05d3\u05dc\u05ea \u05d4\u05e2\u05d9\u05e7\u05e8\u05d9\u05ea \u05d1\u05de\u05e7\u05e8\u05d4 \u05d6\u05d4?",
      "answerOptions": [
        {
          "text": "Gender Dysphoria (F64.0).",
          "isCorrect": false,
          "rationale": "\u05d3\u05d9\u05e1\u05e4\u05d5\u05e8\u05d9\u05d4 \u05de\u05d2\u05d3\u05e8\u05d9\u05ea \u05de\u05d7\u05d9\u05d9\u05d1\u05ea \u05d0\u05d9-\u05ea\u05d0\u05d9\u05de\u05d5\u05ea \u05d1\u05d9\u05df \u05d4\u05de\u05d2\u05d3\u05e8 \u05d4\u05e0\u05d7\u05d5\u05d5\u05d4 \u05dc\u05de\u05d2\u05d3\u05e8 \u05d4\u05de\u05d9\u05d5\u05d7\u05e1, \u05d5\u05dc\u05d0 \u05d4\u05ea\u05de\u05e7\u05d3\u05d5\u05ea \u05d1\u05e4\u05d2\u05dd \u05d0\u05e1\u05ea\u05d8\u05d9 \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9 (DSM p.519)."
        },
        {
          "text": "Body Dysmorphic Disorder (BDD).",
          "isCorrect": true,
          "rationale": "\u05d1-BDD \u05d4\u05de\u05d9\u05e7\u05d5\u05d3 \u05d4\u05d5\u05d0 \u05d1\u05ea\u05d9\u05e7\u05d5\u05df \u05d7\u05dc\u05e7 \u05d2\u05d5\u05e3 \u05d4\u05e0\u05ea\u05e4\u05e1 \u05db\u05e4\u05d2\u05d5\u05dd \u05d0\u05d5 \u05de\u05e2\u05d5\u05d5\u05ea, \u05d1\u05e2\u05d5\u05d3 \u05e9\u05d1-GD \u05d4\u05de\u05d9\u05e7\u05d5\u05d3 \u05d4\u05d5\u05d0 \u05e2\u05dc \u05d4\u05d0\u05d9\u05d1\u05e8\u05d9\u05dd \u05db\u05d1\u05d9\u05d8\u05d5\u05d9 \u05e9\u05dc \u05de\u05d9\u05df/\u05de\u05d2\u05d3\u05e8 \u05dc\u05d0 \u05e8\u05e6\u05d5\u05d9 (DSM p.519)."
        },
        {
          "text": "Transvestic Disorder.",
          "isCorrect": false,
          "rationale": "\u05d4\u05e4\u05e8\u05e2\u05d4 \u05d6\u05d5 \u05de\u05ea\u05d9\u05d9\u05d7\u05e1\u05ea \u05dc\u05e2\u05d5\u05e8\u05e8\u05d5\u05ea \u05de\u05d9\u05e0\u05d9\u05ea \u05de\u05dc\u05d1\u05d9\u05e9\u05ea \u05d1\u05d2\u05d3\u05d9 \u05d4\u05de\u05d9\u05df \u05d4\u05e9\u05e0\u05d9 \u05d5\u05d0\u05d9\u05e0\u05d4 \u05e8\u05dc\u05d5\u05d5\u05e0\u05d8\u05d9\u05ea \u05dc\u05de\u05e7\u05e8\u05d4 \u05e9\u05dc \u05e1\u05dc\u05d9\u05d3\u05d4 \u05de\u05d0\u05d9\u05d1\u05e8 \u05d2\u05d5\u05e3 (DSM p.519)."
        },
        {
          "text": "Somatization Disorder.",
          "isCorrect": false,
          "rationale": "\u05d4\u05ea\u05de\u05e7\u05d3\u05d5\u05ea \u05d1\u05e4\u05d2\u05dd \u05d0\u05e1\u05ea\u05d8\u05d9 \u05d3\u05de\u05d9\u05d5\u05e0\u05d9 \u05d0\u05d5 \u05de\u05d9\u05e0\u05d5\u05e8\u05d9 \u05e2\u05dd \u05de\u05e6\u05d5\u05e7\u05d4 \u05e0\u05d9\u05db\u05e8\u05ea \u05d4\u05d9\u05d0 \u05e1\u05d9\u05de\u05df \u05d4\u05d4\u05d9\u05db\u05e8 \u05e9\u05dc BDD, \u05dc\u05d0 \u05e9\u05dc \u05d4\u05e4\u05e8\u05e2\u05ea \u05e1\u05d5\u05de\u05d8\u05d9\u05d6\u05e6\u05d9\u05d4 \u05db\u05dc\u05dc\u05d9\u05ea (DSM p.519)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05d4\u05d0\u05dd \u05d4\u05de\u05e6\u05d5\u05e7\u05d4 \u05e0\u05d5\u05d1\u05e2\u05ea \u05de\u05d4\u05d6\u05d4\u05d5\u05ea \u05d4\u05de\u05d2\u05d3\u05e8\u05d9\u05ea \u05e9\u05dc \u05d4\u05d0\u05d9\u05d1\u05e8 \u05d0\u05d5 \u05de\u05d4\u05de\u05e8\u05d0\u05d4 \u05d4\u05d0\u05e1\u05ea\u05d8\u05d9 \u05e9\u05dc\u05d5."
    },
    {
      "type": "multiple_choice",
      "question": "\u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05e2\u05e8\u05db\u05d4 \u05e9\u05dc \u05d9\u05dc\u05d3 \u05d1\u05df 10 \u05e2\u05dd \u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc Autistic Spectrum Disorder (ASD), \u05e2\u05d5\u05dc\u05d4 \u05d7\u05e9\u05d3 \u05dc-Gender Dysphoria. \u05d4\u05d9\u05dc\u05d3 \u05de\u05d1\u05d9\u05e2 \u05e2\u05d9\u05e1\u05d5\u05e7 \u05e0\u05d5\u05e7\u05e9\u05d4 \u05d1\u05dc\u05d1\u05d9\u05e9\u05ea \u05d1\u05d2\u05d3\u05d9 \u05e0\u05e9\u05d9\u05dd \u05d5\u05de\u05ea\u05e2\u05e7\u05e9 \u05e9\u05d4\u05d5\u05d0 \u05d1\u05ea. \u05de\u05d4\u05d5 \u05d4\u05d3\u05d2\u05e9 \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9 \u05d4\u05de\u05d5\u05e4\u05d9\u05e2 \u05d1-DSM-5-TR \u05dc\u05d2\u05d1\u05d9 \u05d4\u05e2\u05e8\u05db\u05d4 \u05d6\u05d5?",
      "answerOptions": [
        {
          "text": "\u05d9\u05e9 \u05dc\u05d4\u05d1\u05d7\u05d9\u05df \u05d1\u05d9\u05df \u05e2\u05d9\u05e1\u05d5\u05e7 \u05d0\u05d5\u05d1\u05e1\u05e1\u05d9\u05d1\u05d9 \u05d0\u05d5\u05d8\u05d9\u05e1\u05d8\u05d9 \u05d1\u05ea\u05e4\u05e7\u05d9\u05d3\u05d9 \u05de\u05d2\u05d3\u05e8 \u05dc\u05d1\u05d9\u05df GD \u05d0\u05de\u05d9\u05ea\u05d9\u05ea.",
          "isCorrect": true,
          "rationale": "\u05d4\u05d7\u05e9\u05d9\u05d1\u05d4 \u05d4\u05e7\u05d5\u05e0\u05e7\u05e8\u05d8\u05d9\u05ea \u05d5\u05d4\u05e0\u05d5\u05e7\u05e9\u05d4 \u05d1\u05d0\u05d5\u05d8\u05d9\u05d6\u05dd \u05e2\u05dc\u05d5\u05dc\u05d4 \u05dc\u05d4\u05d5\u05d1\u05d9\u05dc \u05dc\u05e2\u05d9\u05e1\u05d5\u05e7 \u05d9\u05ea\u05e8 \u05d1\u05ea\u05e4\u05e7\u05d9\u05d3\u05d9 \u05de\u05d2\u05d3\u05e8, \u05d5\u05d9\u05e9 \u05e6\u05d5\u05e8\u05da \u05d1\u05d4\u05e2\u05e8\u05db\u05d4 \u05d6\u05d4\u05d9\u05e8\u05d4 \u05db\u05d3\u05d9 \u05dc\u05d4\u05d1\u05d7\u05d9\u05df \u05d1\u05d9\u05df \u05d6\u05d4 \u05dc\u05d1\u05d9\u05df \u05d3\u05d9\u05e1\u05e4\u05d5\u05e8\u05d9\u05d4 \u05de\u05d2\u05d3\u05e8\u05d9\u05ea (DSM p.519-520)."
        },
        {
          "text": "\u05d0\u05d1\u05d7\u05e0\u05ea ASD \u05e9\u05d5\u05dc\u05dc\u05ea \u05d0\u05e4\u05e9\u05e8\u05d5\u05ea \u05dc\u05d0\u05d1\u05d7\u05e0\u05d4 \u05de\u05e7\u05d1\u05d9\u05dc\u05d4 \u05e9\u05dc GD.",
          "isCorrect": false,
          "rationale": "\u05e7\u05d9\u05d9\u05de\u05ea \u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05de\u05d5\u05d2\u05d1\u05e8\u05ea \u05e9\u05dc ASD \u05d1\u05e7\u05e8\u05d1 \u05d0\u05e0\u05e9\u05d9\u05dd \u05e2\u05dd GD, \u05d5\u05e9\u05ea\u05d9 \u05d4\u05d0\u05d1\u05d7\u05e0\u05d5\u05ea \u05d9\u05db\u05d5\u05dc\u05d5\u05ea \u05dc\u05d4\u05ea\u05e7\u05d9\u05d9\u05dd \u05d9\u05d7\u05d3 (DSM p.515, p.520)."
        },
        {
          "text": "\u05e2\u05d9\u05e1\u05d5\u05e7 \u05d1\u05de\u05d2\u05d3\u05e8 \u05d1\u05d0\u05d5\u05d8\u05d9\u05d6\u05dd \u05ea\u05de\u05d9\u05d3 \u05e0\u05d7\u05e9\u05d1 \u05db\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05dd \u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9 (Delusion).",
          "isCorrect": false,
          "rationale": "\u05d4\u05ea\u05e2\u05e7\u05e9\u05d5\u05ea \u05e2\u05dc \u05d6\u05d4\u05d5\u05ea \u05de\u05d2\u05d3\u05e8\u05d9\u05ea \u05d0\u05d9\u05e0\u05d4 \u05e0\u05d7\u05e9\u05d1\u05ea \u05de\u05d7\u05e9\u05d1\u05ea \u05e9\u05d5\u05d5\u05d0 \u05d0\u05dc\u05d0 \u05d0\u05dd \u05d4\u05d9\u05d0 \u05de\u05d5\u05e4\u05d9\u05e2\u05d4 \u05d1\u05d4\u05e7\u05e9\u05e8 \u05e9\u05dc \u05e1\u05db\u05d9\u05d6\u05d5\u05e4\u05e8\u05e0\u05d9\u05d4 \u05d0\u05d5 \u05d4\u05e4\u05e8\u05e2\u05d4 \u05e4\u05e1\u05d9\u05db\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea \u05d0\u05d7\u05e8\u05ea \u05e2\u05dd \u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9\u05dd \u05d1\u05d9\u05d6\u05d0\u05e8\u05d9\u05d9\u05dd (DSM p.520)."
        },
        {
          "text": "\u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd ASD \u05d0\u05d9\u05e0\u05dd \u05d7\u05d5\u05d5\u05d9\u05dd \u05de\u05e6\u05d5\u05e7\u05d4 (Dysphoria) \u05d5\u05dc\u05db\u05df \u05d0\u05d9\u05df \u05dc\u05d0\u05d1\u05d7\u05df \u05d0\u05d5\u05ea\u05dd.",
          "isCorrect": false,
          "rationale": "\u05d4\u05d3\u05d9\u05e1\u05e4\u05d5\u05e8\u05d9\u05d4 \u05d4\u05d9\u05d0 \u05d4\u05de\u05e6\u05d5\u05e7\u05d4 \u05d4\u05e0\u05dc\u05d5\u05d5\u05d9\u05ea \u05dc\u05d0\u05d9-\u05ea\u05d0\u05d9\u05de\u05d5\u05ea, \u05d5\u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd ASD \u05d1\u05d4\u05d7\u05dc\u05d8 \u05d9\u05db\u05d5\u05dc\u05d9\u05dd \u05dc\u05d7\u05d5\u05d5\u05ea \u05d0\u05d5\u05ea\u05d4 (Dulcan p.570)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9\u05dd \u05d4\u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9\u05d9\u05dd \u05e9\u05dc \u05d0\u05d5\u05d8\u05d9\u05d6\u05dd \u05d5\u05db\u05d9\u05e6\u05d3 \u05d4\u05dd \u05de\u05e9\u05e4\u05d9\u05e2\u05d9\u05dd \u05e2\u05dc \u05ea\u05e4\u05d9\u05e1\u05ea \u05ea\u05e4\u05e7\u05d9\u05d3\u05d9\u05dd \u05d7\u05d1\u05e8\u05ea\u05d9\u05d9\u05dd."
    },
    {
      "type": "multiple_choice",
      "question": "\u05db\u05d7\u05dc\u05e7 \u05de\u05d4\u05e2\u05e8\u05db\u05d4 \u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05de\u05e7\u05d9\u05e4\u05d4 \u05e9\u05dc \u05de\u05ea\u05d1\u05d2\u05e8\u05ea \u05d8\u05e8\u05e0\u05e1\u05d2'\u05e0\u05d3\u05e8\u05d9\u05ea (Trans woman), \u05d4\u05e7\u05dc\u05d9\u05e0\u05d0\u05d9 \u05de\u05e2\u05d5\u05e0\u05d9\u05d9\u05df \u05dc\u05d4\u05e2\u05e8\u05d9\u05da \u05d0\u05ea \u05e8\u05de\u05ea \u05d7\u05d5\u05e1\u05e8 \u05d4\u05e0\u05d7\u05ea \u05d5\u05d4\u05e1\u05dc\u05d9\u05d3\u05d4 \u05e9\u05dc\u05d4 \u05de\u05d0\u05d6\u05d5\u05e8\u05d9\u05dd \u05d0\u05e0\u05d8\u05d5\u05de\u05d9\u05d9\u05dd \u05de\u05d5\u05d1\u05d7\u05e0\u05d9\u05dd (\u05db\u05de\u05d5 \u05d7\u05d6\u05d4, \u05e7\u05d5\u05dc \u05d5\u05d0\u05d9\u05d1\u05e8\u05d9 \u05de\u05d9\u05df). \u05d1\u05d0\u05d9\u05d6\u05d4 \u05e9\u05d0\u05dc\u05d5\u05df \u05de\u05ea\u05d5\u05e7\u05e3 \u05de\u05ea\u05d5\u05da \u05d4-Dulcan's Textbook \u05d4\u05db\u05d9 \u05de\u05ea\u05d0\u05d9\u05dd \u05dc\u05d4\u05e9\u05ea\u05de\u05e9?",
      "answerOptions": [
        {
          "text": "Utrecht Gender Dysphoria Scale (UGDS).",
          "isCorrect": false,
          "rationale": "\u05e1\u05d5\u05dc\u05dd UGDS \u05de\u05e2\u05e8\u05d9\u05da \u05d0\u05ea \u05e2\u05d5\u05e6\u05de\u05ea \u05d4\u05de\u05e6\u05d5\u05e7\u05d4 \u05d4\u05db\u05dc\u05dc\u05d9\u05ea \u05d5\u05d4\u05d0\u05d9-\u05ea\u05d0\u05d9\u05de\u05d5\u05ea \u05d4\u05de\u05d2\u05d3\u05e8\u05d9\u05ea, \u05d0\u05da \u05dc\u05d0 \u05de\u05de\u05d5\u05e7\u05d3 \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05ea \u05d1\u05d0\u05d6\u05d5\u05e8\u05d9\u05dd \u05d0\u05e0\u05d8\u05d5\u05de\u05d9\u05d9\u05dd (Dulcan p.573)."
        },
        {
          "text": "Body Image Scale (BIS).",
          "isCorrect": true,
          "rationale": "\u05e9\u05d0\u05dc\u05d5\u05df \u05d4-BIS (\u05e9\u05dc Lindgren & Pauly) \u05de\u05d9\u05d5\u05e2\u05d3 \u05dc\u05d4\u05e2\u05e8\u05db\u05d4 \u05db\u05de\u05d5\u05ea\u05d9\u05ea \u05d5\u05d0\u05d9\u05db\u05d5\u05ea\u05d9\u05ea \u05e9\u05dc \u05e1\u05dc\u05d9\u05d3\u05d4 \u05de\u05d0\u05d6\u05d5\u05e8\u05d9\u05dd \u05d0\u05e0\u05d8\u05d5\u05de\u05d9\u05d9\u05dd \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05d9\u05dd \u05d1\u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd \u05e2\u05dd \u05d3\u05d9\u05e1\u05e4\u05d5\u05e8\u05d9\u05d4 (Dulcan p.573)."
        },
        {
          "text": "Gender Identity Questionnaire for Children (GIQC).",
          "isCorrect": false,
          "rationale": "\u05e9\u05d0\u05dc\u05d5\u05df \u05d4-GIQC \u05de\u05d9\u05d5\u05e2\u05d3 \u05dc\u05d3\u05d9\u05d5\u05d5\u05d7 \u05d4\u05d5\u05e8\u05d9\u05dd \u05e2\u05dc \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05d9\u05d5\u05ea \u05e9\u05dc \u05d9\u05dc\u05d3\u05d9\u05dd \u05e7\u05d3\u05dd-\u05e4\u05d9\u05d5\u05d1\u05e8\u05d8\u05dc\u05d9\u05d9\u05dd (Dulcan p.573)."
        },
        {
          "text": "Transgender Congruence Scale (TCS).",
          "isCorrect": false,
          "rationale": "\u05e1\u05d5\u05dc\u05dd \u05d4-TCS \u05de\u05e2\u05e8\u05d9\u05da \u05d0\u05ea \u05e8\u05de\u05ea \u05d4\u05e0\u05d5\u05d7\u05d5\u05ea \u05d5\u05d4\u05d4\u05dc\u05d9\u05de\u05d4 \u05d4\u05db\u05dc\u05dc\u05d9\u05ea \u05d1\u05d9\u05df \u05d4\u05d6\u05d4\u05d5\u05ea \u05d4\u05e4\u05e0\u05d9\u05de\u05d9\u05ea \u05dc\u05de\u05e8\u05d0\u05d4 \u05d4\u05d7\u05d9\u05e6\u05d5\u05e0\u05d9 (Dulcan p.573)."
        }
      ],
      "hint": "\u05d7\u05e4\u05e9 \u05db\u05dc\u05d9 \u05e9\u05de\u05ea\u05de\u05e7\u05d3 \u05d1-Body Image \u05d5\u05d1\u05d7\u05dc\u05e7\u05d9 \u05d2\u05d5\u05e3 \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05d9\u05dd."
    },
    {
      "type": "multiple_choice",
      "question": "\u05e0\u05d1\u05d3\u05e7 46,XY \u05d4\u05de\u05d0\u05d5\u05e4\u05d9\u05d9\u05df \u05d1\u05d0\u05d9\u05d1\u05e8\u05d9 \u05de\u05d9\u05df \u05e0\u05e7\u05d1\u05d9\u05d9\u05dd \u05d1\u05dc\u05d9\u05d3\u05d4, \u05de\u05d2\u05d9\u05e2 \u05dc\u05d2\u05d9\u05dc \u05d4\u05d4\u05ea\u05d1\u05d2\u05e8\u05d5\u05ea \u05d5\u05d7\u05d5\u05d5\u05d4 \u05d5\u05d9\u05e8\u05d9\u05dc\u05d9\u05d6\u05e6\u05d9\u05d4 \u05e1\u05d5\u05de\u05d8\u05d9\u05ea \u05d7\u05e8\u05d9\u05e4\u05d4 (\u05e6\u05de\u05d9\u05d7\u05ea \u05e4\u05d9\u05df, \u05e9\u05d9\u05e0\u05d5\u05d9 \u05e7\u05d5\u05dc). \u05d4\u05d5\u05d0 \u05de\u05e4\u05ea\u05d7 \u05d3\u05d9\u05e1\u05e4\u05d5\u05e8\u05d9\u05d4 \u05de\u05d2\u05d3\u05e8\u05d9\u05ea \u05e7\u05e9\u05d4 \u05d5\u05de\u05d1\u05e7\u05e9 \u05dc\u05d7\u05d9\u05d5\u05ea \u05db\u05d2\u05d1\u05e8. \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR, \u05d0\u05d9\u05d6\u05d4 \u05de\u05e6\u05d1 \u05e8\u05e4\u05d5\u05d0\u05d9 (Medical mimic) \u05d4\u05db\u05d9 \u05e1\u05d1\u05d9\u05e8 \u05e9\u05d9\u05d5\u05d1\u05d9\u05dc \u05dc\u05de\u05d4\u05dc\u05da \u05db\u05d6\u05d4?",
      "answerOptions": [
        {
          "text": "Complete Androgen Insensitivity Syndrome (CAIS).",
          "isCorrect": false,
          "rationale": "\u05d1-CAIS \u05d4\u05e4\u05e0\u05d5\u05d8\u05d9\u05e4 \u05d4\u05d5\u05d0 \u05e0\u05e7\u05d1\u05d9 \u05de\u05d5\u05e9\u05dc\u05dd \u05dc\u05dc\u05d0 \u05d5\u05d9\u05e8\u05d9\u05dc\u05d9\u05d6\u05e6\u05d9\u05d4 \u05e4\u05d9\u05d5\u05d1\u05e8\u05d8\u05dc\u05d9\u05ea \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea, \u05d5\u05dc\u05e8\u05d5\u05d1 \u05d0\u05d9\u05df \u05d3\u05d9\u05e1\u05e4\u05d5\u05e8\u05d9\u05d4 \u05de\u05d2\u05d3\u05e8\u05d9\u05ea (DSM p.511, p.517)."
        },
        {
          "text": "Congenital Adrenal Hyperplasia (CAH).",
          "isCorrect": false,
          "rationale": "\u05de\u05e6\u05d1 \u05d6\u05d4 \u05e8\u05dc\u05d5\u05d5\u05e0\u05d8\u05d9 \u05d1\u05e2\u05d9\u05e7\u05e8 \u05dc\u05e0\u05d1\u05d3\u05e7\u05d5\u05ea 46,XX \u05e9\u05e0\u05d7\u05e9\u05e4\u05d5 \u05dc\u05d0\u05e0\u05d3\u05e8\u05d5\u05d2\u05e0\u05d9\u05dd \u05d1\u05e8\u05d7\u05dd (DSM p.512)."
        },
        {
          "text": "5-Alpha Reductase-2 Deficiency.",
          "isCorrect": true,
          "rationale": "\u05d1\u05d7\u05e1\u05e8 \u05d1-5-\u05d0\u05dc\u05e4\u05d0 \u05e8\u05d3\u05d5\u05e7\u05d8\u05d0\u05d6, \u05e0\u05d1\u05d3\u05e7\u05d9 46,XY \u05e0\u05d5\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd \u05d0\u05d9\u05d1\u05e8\u05d9 \u05de\u05d9\u05df \u05e2\u05de\u05d5\u05de\u05d9\u05dd/\u05e0\u05e7\u05d1\u05d9\u05d9\u05dd \u05d0\u05da \u05e2\u05d5\u05d1\u05e8\u05d9\u05dd \u05d5\u05d9\u05e8\u05d9\u05dc\u05d9\u05d6\u05e6\u05d9\u05d4 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05d1-puberty, \u05de\u05d4 \u05e9\u05de\u05d5\u05d1\u05d9\u05dc \u05d1\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d2\u05d1\u05d5\u05d4\u05d4 \u05dc\u05de\u05e2\u05d1\u05e8 \u05de\u05d2\u05d3\u05e8\u05d9 \u05de\u05e0\u05e7\u05d1\u05d4 \u05dc\u05d6\u05db\u05e8 (DSM p.517-518)."
        },
        {
          "text": "Cloacal Exstrophy.",
          "isCorrect": false,
          "rationale": "\u05d6\u05d4\u05d5 \u05de\u05d5\u05dd \u05d0\u05e0\u05d8\u05d5\u05de\u05d9 \u05e9\u05d1\u05d5 \u05d4\u05ea\u05d9\u05e0\u05d5\u05e7 \u05e0\u05d5\u05dc\u05d3 \u05dc\u05dc\u05d0 \u05e4\u05d9\u05df \u05ea\u05e7\u05d9\u05df \u05d0\u05da \u05e2\u05dd \u05d4\u05d5\u05e8\u05de\u05d5\u05e0\u05d9\u05dd \u05d2\u05d1\u05e8\u05d9\u05d9\u05dd \u05ea\u05e7\u05d9\u05e0\u05d9\u05dd; \u05d4\u05de\u05e2\u05d1\u05e8 \u05d4\u05de\u05d2\u05d3\u05e8\u05d9 \u05e2\u05e9\u05d5\u05d9 \u05dc\u05e7\u05e8\u05d5\u05ea \u05d0\u05da \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d0\u05d9\u05e0\u05d5 \u05e4\u05d2\u05dd \u05d0\u05e0\u05d6\u05d9\u05de\u05d8\u05d9 \u05d1\u05d4\u05de\u05e8\u05ea \u05d8\u05e1\u05d8\u05d5\u05e1\u05d8\u05e8\u05d5\u05df (DSM p.518)."
        }
      ],
      "hint": "\u05d7\u05e4\u05e9 \u05d4\u05e4\u05e8\u05e2\u05d4 \u05d4\u05de\u05e2\u05e8\u05d1\u05ea \u05d7\u05d5\u05e1\u05e8 \u05d1-DHT \u05d1\u05e8\u05d7\u05dd \u05d0\u05da \u05e2\u05dd \u05e8\u05de\u05d5\u05ea \u05d8\u05e1\u05d8\u05d5\u05e1\u05d8\u05e8\u05d5\u05df \u05ea\u05e7\u05d9\u05e0\u05d5\u05ea \u05d1\u05d2\u05d9\u05dc \u05d4\u05d4\u05ea\u05d1\u05d2\u05e8\u05d5\u05ea."
    },
    {
      "type": "multiple_choice",
      "question": "\u05dc\u05e4\u05d9 \u05e0\u05ea\u05d5\u05e0\u05d9 \u05d4\u05d0\u05e4\u05d9\u05d3\u05de\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05d4 \u05d5\u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05d4\u05d0\u05d5\u05d1\u05d3\u05e0\u05d9 \u05d1-DSM-5-TR \u05d5\u05d1-Dulcan's Textbook, \u05d0\u05d9\u05d6\u05d5 \u05e7\u05d1\u05d5\u05e6\u05d4 \u05e0\u05de\u05e6\u05d0\u05ea \u05d1\u05e1\u05d9\u05db\u05d5\u05df \u05d4\u05d2\u05d1\u05d5\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05e0\u05d9\u05e1\u05d9\u05d5\u05e0\u05d5\u05ea \u05d0\u05d5\u05d1\u05d3\u05e0\u05d9\u05d9\u05dd \u05d1\u05ea\u05d5\u05da \u05d4\u05e7\u05d4\u05d9\u05dc\u05d4 \u05d4\u05d8\u05e8\u05e0\u05e1\u05d2'\u05e0\u05d3\u05e8\u05d9\u05ea?",
      "answerOptions": [
        {
          "text": "Transgender women (AMAB) \u05d1\u05d2\u05d9\u05dc \u05d4\u05e2\u05de\u05d9\u05d3\u05d4.",
          "isCorrect": false,
          "rationale": "\u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05d4\u05d0\u05d5\u05d1\u05d3\u05e0\u05d9 \u05d2\u05d1\u05d5\u05d4 \u05d1\u05db\u05dc \u05d4\u05e7\u05d4\u05d9\u05dc\u05d4, \u05d0\u05da \u05e9\u05d9\u05d0 \u05d4\u05e0\u05d9\u05e1\u05d9\u05d5\u05e0\u05d5\u05ea \u05de\u05d3\u05d5\u05d5\u05d7 \u05d0\u05e6\u05dc \u05e6\u05e2\u05d9\u05e8\u05d9\u05dd \u05d9\u05d5\u05ea\u05e8 \u05d5\u05d1\u05e7\u05d1\u05d5\u05e6\u05d5\u05ea \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05d5\u05ea \u05d0\u05d7\u05e8\u05d5\u05ea (DSM p.518-519)."
        },
        {
          "text": "Transgender young men (AFAB).",
          "isCorrect": true,
          "rationale": "\u05de\u05d7\u05e7\u05e8\u05d9\u05dd \u05de\u05e8\u05d0\u05d9\u05dd \u05db\u05d9 \u05e9\u05d9\u05e2\u05d5\u05e8 \u05e0\u05d9\u05e1\u05d9\u05d5\u05e0\u05d5\u05ea \u05d4\u05d4\u05ea\u05d0\u05d1\u05d3\u05d5\u05ea \u05d4\u05d2\u05d1\u05d5\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05e0\u05de\u05e6\u05d0 \u05d1\u05e7\u05e8\u05d1 \u05d2\u05d1\u05e8\u05d9\u05dd \u05d8\u05e8\u05e0\u05e1\u05d9\u05dd (AFAB), \u05d5\u05d0\u05d7\u05e8\u05d9\u05d4\u05dd \u05d1\u05e7\u05e8\u05d1 \u05d0\u05dc\u05d5 \u05d4\u05de\u05d2\u05d3\u05d9\u05e8\u05d9\u05dd \u05e2\u05e6\u05de\u05dd \u05db-non-binary (DSM p.519)."
        },
        {
          "text": "Cisgender sexual minority youth.",
          "isCorrect": false,
          "rationale": "\u05d0\u05de\u05e0\u05dd \u05e1\u05d9\u05db\u05d5\u05df \u05d6\u05d4 \u05d2\u05d1\u05d5\u05d4 \u05e4\u05d9 \u05db\u05de\u05d4 \u05de\u05e0\u05d5\u05e2\u05e8 \u05d4\u05d8\u05e8\u05d5\u05e1\u05e7\u05e1\u05d5\u05d0\u05dc\u05d9, \u05d0\u05da \u05d4\u05d5\u05d0 \u05e0\u05de\u05d5\u05da \u05d9\u05d5\u05ea\u05e8 \u05d1\u05d4\u05e9\u05d5\u05d5\u05d0\u05d4 \u05dc\u05e0\u05d5\u05e2\u05e8 \u05d8\u05e8\u05e0\u05e1\u05d2'\u05e0\u05d3\u05e8 (Dulcan p.552, 565)."
