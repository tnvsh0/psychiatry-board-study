{
  "title": "Neurology Quiz",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\u05e4\u05e2\u05d5\u05d8 \u05d1\u05df 10 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05de\u05d5\u05d1\u05d0 \u05dc\u05d4\u05e2\u05e8\u05db\u05d4 \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9\u05ea. \u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05d1\u05d3\u05d9\u05e7\u05d4, \u05d4\u05e7\u05dc\u05d9\u05e0\u05d0\u05d9 \u05de\u05d1\u05d7\u05d9\u05df \u05db\u05d9 \u05d4\u05d9\u05dc\u05d3 \u05de\u05e9\u05ea\u05de\u05e9 \u05d1\u05d0\u05d5\u05e4\u05df \u05e2\u05e7\u05d1\u05d9 \u05d5\u05d1\u05dc\u05e2\u05d3\u05d9 \u05d1\u05d9\u05d3\u05d5 \u05d4\u05d9\u05de\u05e0\u05d9\u05ea \u05dc\u05e6\u05d5\u05e8\u05da \u05d4\u05d2\u05e2\u05d4 \u05dc\u05d7\u05e4\u05e6\u05d9\u05dd \u05d5\u05d0\u05d7\u05d9\u05d6\u05ea\u05dd ($reaching \\space and \\space grasping$). \u05de\u05d4\u05d9 \u05d4\u05de\u05e9\u05de\u05e2\u05d5\u05ea \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05d4\u05de\u05d9\u05d9\u05d3\u05d9\u05ea \u05e9\u05dc \u05de\u05de\u05e6\u05d0 \u05d6\u05d4?",
      "answerOptions": [
        {
          "text": "\u05de\u05d3\u05d5\u05d1\u05e8 \u05d1\u05de\u05de\u05e6\u05d0 \u05e4\u05ea\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d4\u05de\u05e2\u05d5\u05e8\u05e8 \u05d7\u05e9\u05d3 \u05dc-Hemiparesis \u05d1\u05e6\u05d3 \u05e9\u05de\u05d0\u05dc.",
          "isCorrect": true,
          "rationale": "\u05e7\u05d1\u05d9\u05e2\u05ea \u05d4\u05e2\u05d3\u05e4\u05ea \u05d9\u05d3 ($Hand \\space dominance$) \u05dc\u05e4\u05e0\u05d9 \u05d2\u05d9\u05dc \u05e9\u05e0\u05d4 \u05d0\u05d9\u05e0\u05d4 \u05ea\u05e7\u05d9\u05e0\u05d4 \u05de\u05d1\u05d7\u05d9\u05e0\u05d4 \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9\u05ea \u05d5\u05de\u05d7\u05e9\u05d9\u05d3\u05d4 \u05dc\u05d7\u05d5\u05dc\u05e9\u05d4 \u05de\u05d5\u05d8\u05d5\u05e8\u05d9\u05ea \u05d0\u05d5 \u05d4\u05de\u05d9\u05e4\u05e8\u05d6\u05d9\u05e1 \u05d1\u05e6\u05d3 \u05d4\u05e0\u05d2\u05d3\u05d9 (Dulcan p.92)."
        },
        {
          "text": "\u05d6\u05d4\u05d5 \u05e9\u05dc\u05d1 \u05ea\u05e7\u05d9\u05df \u05d1\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea \u05d4\u05de\u05d5\u05d8\u05d5\u05e8\u05d9\u05ea \u05d4\u05de\u05e2\u05d9\u05d3 \u05e2\u05dc \u05d4\u05d1\u05e9\u05dc\u05d4 \u05de\u05d5\u05e7\u05d3\u05de\u05ea \u05e9\u05dc \u05d4-Cerebral cortex.",
          "isCorrect": false,
          "rationale": "\u05d4\u05e2\u05d3\u05e4\u05ea \u05d9\u05d3 \u05d1\u05e9\u05dc\u05d1 \u05db\u05d4 \u05de\u05d5\u05e7\u05d3\u05dd (\u05dc\u05e4\u05e0\u05d9 \u05d2\u05d9\u05dc 12 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd) \u05d0\u05d9\u05e0\u05d4 \u05e0\u05d7\u05e9\u05d1\u05ea \u05dc\u05d4\u05d1\u05e9\u05dc\u05d4 \u05ea\u05e7\u05d9\u05e0\u05d4 \u05d0\u05dc\u05d0 \u05dc\u05e1\u05d9\u05de\u05df \u05d0\u05d6\u05d4\u05e8\u05d4 \u05e0\u05d5\u05d9\u05e8\u05d5\u05dc\u05d5\u05d2\u05d9 (Dulcan p.92)."
        },
        {
          "text": "\u05d4\u05de\u05de\u05e6\u05d0 \u05de\u05e8\u05de\u05d6 \u05e2\u05dc \u05e4\u05d2\u05d9\u05e2\u05d4 \u05d1-Lower Motor Neuron (LMN) \u05d1\u05d2\u05e4\u05d4 \u05d4\u05d9\u05de\u05e0\u05d9\u05ea.",
          "isCorrect": false,
          "rationale": "\u05e9\u05d9\u05de\u05d5\u05e9 \u05de\u05d5\u05d2\u05d1\u05e8 \u05d1\u05d9\u05d3 \u05d9\u05de\u05d9\u05df \u05de\u05e2\u05d9\u05d3 \u05e2\u05dc \u05ea\u05e4\u05e7\u05d5\u05d3 \u05e9\u05de\u05d5\u05e8 \u05e9\u05dc\u05d4, \u05d1\u05e2\u05d5\u05d3 \u05e9\u05d4\u05d7\u05e9\u05d3 \u05d4\u05d5\u05d0 \u05dc\u05d7\u05d5\u05dc\u05e9\u05d4 \u05d1\u05d9\u05d3 \u05d4\u05e0\u05d2\u05d3\u05d9\u05ea, \u05dc\u05e8\u05d5\u05d1 \u05e2\u05dc \u05e8\u05e7\u05e2 \u05e4\u05d2\u05d9\u05e2\u05d4 \u05de\u05e8\u05db\u05d6\u05d9\u05ea (UMN) \u05d5\u05dc\u05d0 \u05d4\u05d9\u05e7\u05e4\u05d9\u05ea (Dulcan p.92)."
        },
        {
          "text": "\u05d9\u05e9 \u05dc\u05d1\u05e6\u05e2 \u05d1\u05d9\u05e8\u05d5\u05e8 \u05d3\u05d7\u05d5\u05e3 \u05dc-Metabolic storage disease \u05e2\u05e7\u05d1 \u05d0\u05e1\u05d9\u05de\u05d8\u05e8\u05d9\u05d4 \u05ea\u05e4\u05e7\u05d5\u05d3\u05d9\u05ea.",
          "isCorrect": false,
          "rationale": "\u05d1\u05e2\u05d5\u05d3 \u05e9\u05d0\u05e1\u05d9\u05de\u05d8\u05e8\u05d9\u05d4 \u05d4\u05d9\u05d0 \u05e1\u05d9\u05de\u05df \u05de\u05d3\u05d0\u05d9\u05d2, \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05de\u05d1\u05d3\u05dc\u05ea \u05d4\u05e8\u05d0\u05e9\u05d5\u05e0\u05d4 \u05d1\u05ea\u05d9\u05e0\u05d5\u05e7 \u05e2\u05dd \u05d4\u05e2\u05d3\u05e4\u05ea \u05d9\u05d3 \u05de\u05d5\u05e7\u05d3\u05de\u05ea \u05d4\u05d9\u05d0 \u05e0\u05d6\u05e7 \u05de\u05d1\u05e0\u05d9 \u05d0\u05d5 \u05d4\u05de\u05d9\u05e4\u05e8\u05d6\u05d9\u05e1, \u05d5\u05dc\u05d0 \u05d1\u05d4\u05db\u05e8\u05d7 \u05de\u05d7\u05dc\u05d4 \u05de\u05d8\u05d1\u05d5\u05dc\u05d9\u05ea (Dulcan p.92)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05d2\u05d9\u05dc \u05d4\u05db\u05e8\u05d5\u05e0\u05d5\u05dc\u05d5\u05d2\u05d9 \u05e9\u05d1\u05d5 \u05d4\u05e2\u05d3\u05e4\u05ea \u05e6\u05d3 \u05d4\u05d5\u05e4\u05db\u05ea \u05dc\u05ea\u05e7\u05d9\u05e0\u05d4 \u05e4\u05d9\u05d6\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea.",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05e0\u05e2\u05e8 \u05d1\u05df 15 \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05d1-Haloperidol \u05d1\u05e9\u05dc \u05d4\u05e4\u05e8\u05e2\u05d4 \u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9\u05ea \u05de\u05e6\u05d9\u05d2 \u05d1\u05d1\u05d3\u05d9\u05e7\u05d4 \u05e0\u05d5\u05d9\u05e8\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea \u05e0\u05d5\u05e7\u05e9\u05d5\u05ea \u05de\u05e1\u05d5\u05d2 $Cogwheel \\space rigidity$ \u05d5\u05e8\u05e2\u05d3 \u05d1\u05de\u05e0\u05d5\u05d7\u05d4. \u05e2\u05dd \u05d6\u05d0\u05ea, \u05d1\u05d1\u05d3\u05d9\u05e7\u05ea \u05d4\u05d4\u05d7\u05d6\u05e8\u05d9\u05dd \u05e0\u05de\u05e6\u05d0 $Babinski \\space sign$ \u05d7\u05d9\u05d5\u05d1\u05d9 \u05d3\u05d5-\u05e6\u05d3\u05d3\u05d9. \u05de\u05d4\u05d9 \u05d4\u05d2\u05d9\u05e9\u05d4 \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05d4\u05e0\u05db\u05d5\u05e0\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8?",
      "answerOptions": [
        {
          "text": "\u05d4\u05e4\u05e1\u05e7\u05ea \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05d0\u05e0\u05d8\u05d9-\u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9 \u05d5\u05de\u05ea\u05df Diphenhydramine \u05d1\u05e9\u05dc \u05d7\u05e9\u05d3 \u05dc-EPS \u05d7\u05de\u05d5\u05e8.",
          "isCorrect": false,
          "rationale": "\u05e0\u05d5\u05db\u05d7\u05d5\u05ea $Babinski$ \u05d7\u05d9\u05d5\u05d1\u05d9 \u05e9\u05d5\u05dc\u05dc\u05ea \u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc MIP \u05d8\u05d4\u05d5\u05e8 \u05d5\u05de\u05d7\u05d9\u05d9\u05d1\u05ea \u05d1\u05d9\u05e8\u05d5\u05e8 \u05e0\u05e8\u05d7\u05d1 \u05d9\u05d5\u05ea\u05e8 \u05de\u05e2\u05d1\u05e8 \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05ea\u05d5\u05e4\u05e2\u05d5\u05ea \u05dc\u05d5\u05d5\u05d0\u05d9 (DSM p.809)."
        },
        {
          "text": "\u05d1\u05d9\u05e6\u05d5\u05e2 \u05d1\u05d9\u05e8\u05d5\u05e8 \u05e0\u05d5\u05d9\u05e8\u05d5\u05dc\u05d5\u05d2\u05d9 \u05de\u05e7\u05d9\u05e3 (\u05db\u05d5\u05dc\u05dc $Neuroimaging$) \u05dc\u05e9\u05dc\u05d9\u05dc\u05ea \u05e0\u05d6\u05e7 \u05de\u05d1\u05e0\u05d9 \u05d1-Corticospinal tract.",
          "isCorrect": true,
          "rationale": "\u05d4\u05d5\u05e4\u05e2\u05ea \u05e1\u05d9\u05de\u05e0\u05d9\u05dd \u05e0\u05d5\u05d9\u05e8\u05d5\u05dc\u05d5\u05d2\u05d9\u05d9\u05dd \u05de\u05d5\u05e7\u05d3\u05d9\u05d9\u05dd \u05d0\u05d5 $Babinski$ \u05d7\u05d9\u05d5\u05d1\u05d9 \u05d1\u05e0\u05e2\u05e8 \u05e9\u05d5\u05dc\u05dc\u05ea Medication-Induced Parkinsonism (MIP) \u05d5\u05de\u05d7\u05d9\u05d9\u05d1\u05ea \u05e9\u05dc\u05d9\u05dc\u05ea \u05e0\u05d6\u05e7 \u05de\u05d1\u05e0\u05d9 \u05de\u05e8\u05db\u05d6\u05d9 (DSM p.809)."
        },
        {
          "text": "\u05d4\u05d5\u05e1\u05e4\u05ea Benztropine \u05d5\u05d4\u05de\u05e9\u05da \u05de\u05e2\u05e7\u05d1 \u05e7\u05dc\u05d9\u05e0\u05d9 \u05d0\u05d7\u05e8 \u05e1\u05d9\u05de\u05e0\u05d9 \u05d4-Parkinsonism.",
          "isCorrect": false,
          "rationale": "\u05de\u05ea\u05df \u05d8\u05d9\u05e4\u05d5\u05dc \u05d0\u05e0\u05d8\u05d9-\u05db\u05d5\u05dc\u05d9\u05e0\u05e8\u05d2\u05d9 \u05e2\u05e9\u05d5\u05d9 \u05dc\u05e2\u05d6\u05d5\u05e8 \u05dc\u05e0\u05d5\u05e7\u05e9\u05d5\u05ea, \u05d0\u05da \u05d4\u05d5\u05d0 \u05d0\u05d9\u05e0\u05d5 \u05e0\u05d5\u05ea\u05df \u05de\u05e2\u05e0\u05d4 \u05dc\u05de\u05de\u05e6\u05d0 \u05d4\u05e4\u05ea\u05d5\u05dc\u05d5\u05d2\u05d9 \u05e9\u05dc $Babinski$, \u05e9\u05d0\u05d9\u05e0\u05d5 \u05d7\u05dc\u05e7 \u05de-EPS \u05e1\u05d8\u05e0\u05d3\u05e8\u05d8\u05d9 (DSM p.809)."
        },
        {
          "text": "\u05ea\u05d9\u05e2\u05d5\u05d3 \u05d4\u05de\u05de\u05e6\u05d0\u05d9\u05dd \u05db\u05d1\u05d9\u05d8\u05d5\u05d9 \u05dc\u05ea\u05d5\u05e4\u05e2\u05ea \u05dc\u05d5\u05d5\u05d0\u05d9 \u05ea\u05e7\u05d9\u05e0\u05d4 \u05e9\u05dc $D_2$ blockade \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd.",
          "isCorrect": false,
          "rationale": "\u05e1\u05d9\u05de\u05df $Babinski$ \u05d7\u05d9\u05d5\u05d1\u05d9 \u05de\u05e2\u05dc \u05d2\u05d9\u05dc 18 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05d4\u05d5\u05d0 \u05ea\u05de\u05d9\u05d3 \u05e4\u05ea\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d5\u05de\u05e2\u05d9\u05d3 \u05e2\u05dc \u05e4\u05d2\u05d9\u05e2\u05ea UMN, \u05d5\u05dc\u05d0 \u05e2\u05dc \u05d7\u05e1\u05d9\u05de\u05d4 \u05d3\u05d5\u05e4\u05de\u05d9\u05e0\u05e8\u05d2\u05d9\u05ea \u05e0\u05d9\u05d2\u05e8\u05d5\u05e1\u05d8\u05e8\u05d9\u05d0\u05d8\u05dc\u05d9\u05ea \u05e4\u05e9\u05d5\u05d8\u05d4 (Dulcan p.93, StahlNeuro p.87)."
        }
      ],
      "hint": "\u05e9\u05d9\u05dd \u05dc\u05d1 \u05dc\u05de\u05de\u05e6\u05d0 \u05e9\u05d0\u05d9\u05e0\u05d5 \u05de\u05ea\u05d9\u05d9\u05e9\u05d1 \u05e2\u05dd \u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc Medication-Induced Parkinsonism \u05d1\u05dc\u05d1\u05d3.",
      "imageUrls": []
    },
    {
      "type": "fill_in_the_blank",
      "question": "\u05d4\u05dc\u05d9\u05db\u05ea ___ \u05e0\u05e8\u05db\u05e9\u05ea \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9\u05ea \u05d1\u05d2\u05d9\u05dc 6 \u05e9\u05e0\u05d9\u05dd; \u05e7\u05d5\u05e9\u05d9 \u05d1\u05d1\u05d9\u05e6\u05d5\u05e2\u05d4 \u05dc\u05d0\u05d7\u05e8 \u05d2\u05d9\u05dc \u05d6\u05d4 \u05e2\u05e9\u05d5\u05d9 \u05dc\u05d4\u05e2\u05d9\u05d3 \u05e2\u05dc \u05dc\u05d9\u05e7\u05d5\u05d9 \u05d1\u05ea\u05e4\u05e7\u05d5\u05d3 \u05d4-Cerebellum \u05d0\u05d5 \u05d1\u05e9\u05d9\u05d5\u05d5\u05d9 \u05d4\u05de\u05e9\u05e7\u05dc (Dulcan p.93).",
      "bestAnswer": "Tandem Gait",
      "acceptableAnswers": [
        "tandem",
        "\u05e2\u05e7\u05d1 \u05d1\u05e6\u05d3 \u05d0\u05d2\u05d5\u05d3\u05dc"
      ],
      "rationale": "\u05d4\u05dc\u05d9\u05db\u05ea $Tandem$ (\u05e2\u05e7\u05d1 \u05d1\u05e6\u05d3 \u05d0\u05d2\u05d5\u05d3\u05dc) \u05d3\u05d5\u05e8\u05e9\u05ea \u05ea\u05d9\u05d0\u05d5\u05dd \u05de\u05d5\u05d8\u05d5\u05e8\u05d9 \u05e2\u05d3\u05d9\u05df \u05d5\u05e9\u05d9\u05d5\u05d5\u05d9 \u05de\u05e9\u05e7\u05dc \u05d4\u05de\u05d1\u05e9\u05d9\u05dc\u05d9\u05dd \u05e1\u05d1\u05d9\u05d1 \u05d2\u05d9\u05dc 6, \u05d5\u05dc\u05db\u05df \u05d4\u05d9\u05d0 \u05de\u05e9\u05de\u05e9\u05ea \u05db\u05db\u05dc\u05d9 \u05dc\u05d4\u05e2\u05e8\u05db\u05ea \u05ea\u05e7\u05d9\u05e0\u05d5\u05ea \u05d4\u05e6\u05e8\u05d1\u05dc\u05d5\u05dd (Dulcan p.93).",
      "hint": "\u05d6\u05d5\u05d4\u05d9 \u05d1\u05d3\u05d9\u05e7\u05ea \u05d4\u05dc\u05d9\u05db\u05d4 \u05e9\u05d1\u05d4 \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05de\u05ea\u05d1\u05e7\u05e9 \u05dc\u05e6\u05e2\u05d5\u05d3 \u05d1\u05e7\u05d5 \u05d9\u05e9\u05e8 \u05db\u05d0\u05e9\u05e8 \u05d4\u05e2\u05e7\u05d1 \u05e0\u05d5\u05d2\u05e2 \u05d1\u05d1\u05d5\u05d4\u05df \u05e9\u05dc \u05d4\u05e8\u05d2\u05dc \u05d4\u05e9\u05e0\u05d9\u05d9\u05d4."
    },
    {
      "type": "multiple_choice",
      "question": "\u05e2\u05dc \u05e4\u05d9 \u05de\u05d5\u05d3\u05dc \u05d4-CSTC ($Cortico-Striato-Thalamo-Cortical \\space loop$), \u05d0\u05d9\u05d6\u05d4 \u05de\u05e1\u05dc\u05d5\u05dc \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9 \u05e0\u05d7\u05e9\u05d1 \u05dc\u05d0\u05d7\u05e8\u05d0\u05d9 \u05e2\u05dc \u05d5\u05d9\u05e1\u05d5\u05ea \u05d4\u05d9\u05e4\u05e8\u05d0\u05e7\u05d8\u05d9\u05d1\u05d9\u05d5\u05ea \u05de\u05d5\u05d8\u05d5\u05e8\u05d9\u05ea \u05d5\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05e9\u05dc $Psychomotor \\space agitation$ \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd ADHD?",
      "answerOptions": [
        {
          "text": "\u05de\u05d4-Prefrontal motor cortex \u05d0\u05dc \u05d4-Putamen, \u05de\u05e9\u05dd \u05dc-Thalamus \u05d5\u05d1\u05d7\u05d6\u05e8\u05d4 \u05dc\u05e7\u05d5\u05e8\u05d8\u05e7\u05e1.",
          "isCorrect": true,
          "rationale": "\u05d4\u05d9\u05e4\u05e8\u05d0\u05e7\u05d8\u05d9\u05d1\u05d9\u05d5\u05ea \u05de\u05d5\u05d8\u05d5\u05e8\u05d9\u05ea \u05de\u05d5\u05d5\u05e1\u05ea\u05ea \u05e2\u05dc \u05d9\u05d3\u05d9 \u05dc\u05d5\u05dc\u05d0\u05ea CSTC \u05d4\u05de\u05d7\u05d1\u05e8\u05ea \u05d1\u05d9\u05df \u05d4\u05e7\u05d5\u05e8\u05d8\u05e7\u05e1 \u05d4\u05de\u05d5\u05d8\u05d5\u05e8\u05d9 \u05d4\u05e4\u05e8\u05d5\u05e0\u05d8\u05dc\u05d9 \u05dc\u05e1\u05d8\u05e8\u05d9\u05d9\u05d8\u05d5\u05dd \u05d4\u05dc\u05d8\u05e8\u05dc\u05d9 (Putamen) \u05d5\u05d4\u05ea\u05dc\u05de\u05d5\u05e1 (StahlNeuro p.451)."
        },
        {
          "text": "\u05de\u05d4-Orbitofrontal cortex (OFC) \u05d0\u05dc \u05d4-Caudate nucleus \u05d5\u05d4-Thalamus.",
          "isCorrect": false,
          "rationale": "\u05de\u05e1\u05dc\u05d5\u05dc \u05d6\u05d4 (OFC-Caudate) \u05e7\u05e9\u05d5\u05e8 \u05d9\u05d5\u05ea\u05e8 \u05dc\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05d9\u05d5\u05ea \u05e7\u05d5\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05d5\u05ea \u05d5\u05d5\u05d9\u05e1\u05d5\u05ea \u05d3\u05d7\u05e4\u05d9\u05dd ($Compulsivity$), \u05d5\u05dc\u05d0 \u05dc\u05d4\u05d9\u05e4\u05e8\u05d0\u05e7\u05d8\u05d9\u05d1\u05d9\u05d5\u05ea \u05de\u05d5\u05d8\u05d5\u05e8\u05d9\u05ea \u05d2\u05e8\u05d9\u05d3\u05d0 (StahlNeuro p.515)."
        },
        {
          "text": "\u05de\u05d4-Anterior cingulate cortex (ACC) \u05d0\u05dc \u05d4-Nucleus accumbens.",
          "isCorrect": false,
          "rationale": "\u05de\u05e1\u05dc\u05d5\u05dc \u05d6\u05d4 \u05de\u05e2\u05d5\u05e8\u05d1 \u05d1\u05d5\u05d5\u05d9\u05e1\u05d5\u05ea \u05e8\u05d2\u05e9\u05d9 \u05d5\u05de\u05d5\u05d8\u05d9\u05d1\u05e6\u05d9\u05d4 ($Affective \\space loop$), \u05d5\u05dc\u05d0 \u05d1\u05d1\u05d9\u05d8\u05d5\u05d9 \u05d4\u05de\u05d5\u05d8\u05d5\u05e8\u05d9 \u05e9\u05dc \u05d4\u05d9\u05e4\u05e8\u05d0\u05e7\u05d8\u05d9\u05d1\u05d9\u05d5\u05ea (StahlNeuro p.451)."
        },
        {
          "text": "\u05de\u05d4-Substantia nigra \u05d9\u05e9\u05d9\u05e8\u05d5\u05ea \u05d0\u05dc \u05d4-Primary motor cortex.",
          "isCorrect": false,
          "rationale": "\u05d4\u05de\u05e1\u05dc\u05d5\u05dc \u05d4\u05e0\u05d9\u05d2\u05e8\u05d5\u05e1\u05d8\u05e8\u05d9\u05d0\u05d8\u05dc\u05d9 \u05de\u05e7\u05e9\u05e8 \u05d0\u05ea \u05d4-Substantia nigra \u05dc\u05e1\u05d8\u05e8\u05d9\u05d9\u05d8\u05d5\u05dd (Basal ganglia), \u05d0\u05da \u05d4\u05d5\u05d5\u05d9\u05e1\u05d5\u05ea \u05e9\u05dc \u05d4\u05d9\u05e4\u05e8\u05d0\u05e7\u05d8\u05d9\u05d1\u05d9\u05d5\u05ea \u05e2\u05d5\u05d1\u05e8 \u05d3\u05e8\u05da \u05d4\u05dc\u05d5\u05dc\u05d0\u05d4 \u05d4\u05e7\u05d5\u05e8\u05d8\u05d9\u05e7\u05dc\u05d9\u05ea \u05d4\u05e9\u05dc\u05de\u05d4 (StahlNeuro p.87)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05dc\u05d5\u05dc\u05d0\u05d4 \u05d4\u05de\u05e7\u05e9\u05e8\u05ea \u05d1\u05d9\u05df \u05d0\u05d6\u05d5\u05e8\u05d9 \u05ea\u05db\u05e0\u05d5\u05df \u05ea\u05e0\u05d5\u05e2\u05d4 \u05d1\u05e4\u05e8\u05d5\u05e0\u05d8\u05dc \u05dc\u05d1\u05d9\u05df \u05d4\u05e1\u05d8\u05e8\u05d9\u05d9\u05d8\u05d5\u05dd \u05d4\u05d7\u05d9\u05e6\u05d5\u05e0\u05d9.",
      "imageUrls": []
    },
    {
      "type": "short_answer",
      "question": "\u05ea\u05d0\u05e8/\u05d9 \u05d0\u05ea \u05d4\u05d0\u05d1\u05d5\u05dc\u05d5\u05e6\u05d9\u05d4 \u05e9\u05dc $Babinski \\space reflex$ \u05de\u05dc\u05d9\u05d3\u05d4 \u05d5\u05e2\u05d3 \u05d2\u05d9\u05dc \u05d4\u05d9\u05dc\u05d3\u05d5\u05ea \u05d4\u05de\u05d5\u05e7\u05d3\u05de\u05ea, \u05d5\u05d4\u05e1\u05d1\u05e8/\u05d9 \u05de\u05ea\u05d9 \u05d4\u05d5\u05d0 \u05d4\u05d5\u05e4\u05da \u05dc\u05de\u05de\u05e6\u05d0 \u05e4\u05ea\u05d5\u05dc\u05d5\u05d2\u05d9.",
      "grading": {
        "modelAnswer": "\u05e8\u05e4\u05dc\u05e7\u05e1 \u05d1\u05d1\u05d9\u05e0\u05e1\u05e7\u05d9 (\u05ea\u05d2\u05d5\u05d1\u05d4 \u05d0\u05e7\u05e1\u05d8\u05e0\u05e1\u05d5\u05e8\u05d9\u05ea \u05e9\u05dc \u05d4\u05d1\u05d5\u05d4\u05df) \u05d4\u05d5\u05d0 \u05ea\u05e7\u05d9\u05df \u05d5\u05e4\u05d9\u05d6\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d1\u05ea\u05d9\u05e0\u05d5\u05e7\u05d5\u05ea \u05e2\u05d3 \u05d2\u05d9\u05dc 12\u201318 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05e2\u05e7\u05d1 \u05d7\u05d5\u05e1\u05e8 \u05de\u05d9\u05d0\u05dc\u05d9\u05e0\u05d9\u05d6\u05e6\u05d9\u05d4 \u05de\u05dc\u05d0\u05d4 \u05e9\u05dc \u05d4-Corticospinal tract. \u05dc\u05d0\u05d7\u05e8 \u05d2\u05d9\u05dc 18 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd, \u05d4\u05d5\u05e4\u05e2\u05ea\u05d5 \u05e0\u05d7\u05e9\u05d1\u05ea \u05dc\u05e4\u05ea\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea \u05d5\u05de\u05e2\u05d9\u05d3\u05d4 \u05e2\u05dc \u05e4\u05d2\u05d9\u05e2\u05d4 \u05d1-Upper Motor Neuron (UMN) (Dulcan p.93, DSM p.809).",
        "rationale": "\u05d4\u05d1\u05e0\u05ea \u05d4\u05ea\u05d4\u05dc\u05d9\u05da \u05d4\u05e4\u05d9\u05d6\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05e9\u05dc \u05de\u05d9\u05d0\u05dc\u05d9\u05e0\u05d9\u05d6\u05e6\u05d9\u05d4 \u05e7\u05e8\u05d9\u05d8\u05d9\u05ea \u05dc\u05d4\u05d1\u05d7\u05e0\u05d4 \u05d1\u05d9\u05df \u05e8\u05e4\u05dc\u05e7\u05e1 \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9 \u05ea\u05e7\u05d9\u05df \u05dc\u05d1\u05d9\u05df \u05e1\u05d9\u05de\u05df \u05e0\u05d5\u05d9\u05e8\u05d5\u05dc\u05d5\u05d2\u05d9 \u05e4\u05ea\u05d5\u05dc\u05d5\u05d2\u05d9.",
        "requiredAttributes": [
          "\u05e6\u05d9\u05d5\u05df \u05d8\u05d5\u05d5\u05d7 \u05d4\u05d2\u05d9\u05dc \u05d4\u05ea\u05e7\u05d9\u05df (\u05e2\u05d3 12-18 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd).",
          "\u05d4\u05e1\u05d1\u05e8 \u05d4\u05e1\u05d9\u05d1\u05d4 \u05d4\u05e4\u05d9\u05d6\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea (\u05de\u05d9\u05d0\u05dc\u05d9\u05e0\u05d9\u05d6\u05e6\u05d9\u05d4 \u05e9\u05dc \u05d4-Corticospinal tract).",
          "\u05e6\u05d9\u05d5\u05df \u05d4\u05de\u05e9\u05de\u05e2\u05d5\u05ea \u05d4\u05e4\u05ea\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea \u05dc\u05d0\u05d7\u05e8 \u05d2\u05d9\u05dc \u05d6\u05d4 (\u05e4\u05d2\u05d9\u05e2\u05ea UMN)."
        ],
        "errors": {
          "misconceptions": [
            "\u05d4\u05e0\u05d7\u05d4 \u05e9\u05e8\u05e4\u05dc\u05e7\u05e1 \u05d1\u05d1\u05d9\u05e0\u05e1\u05e7\u05d9 \u05d7\u05d9\u05d5\u05d1\u05d9 \u05d4\u05d5\u05d0 \u05ea\u05de\u05d9\u05d3 \u05e4\u05ea\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d1\u05db\u05dc \u05d2\u05d9\u05dc.",
            "\u05d1\u05dc\u05d1\u05d5\u05dc \u05d1\u05d9\u05df \u05e4\u05d2\u05d9\u05e2\u05ea UMN \u05dc\u05e4\u05d2\u05d9\u05e2\u05ea LMN \u05d1\u05d4\u05e7\u05e9\u05e8 \u05e9\u05dc \u05d1\u05d1\u05d9\u05e0\u05e1\u05e7\u05d9."
          ],
          "bluffs": []
        }
      },
      "hint": "\u05d4\u05ea\u05d9\u05d9\u05d7\u05e1/\u05d9 \u05dc\u05ea\u05d4\u05dc\u05d9\u05da \u05d4\u05de\u05d9\u05d0\u05dc\u05d9\u05e0\u05d9\u05d6\u05e6\u05d9\u05d4 \u05e9\u05dc \u05d4\u05de\u05e1\u05dc\u05d5\u05dc\u05d9\u05dd \u05d4\u05e4\u05d9\u05e8\u05de\u05d9\u05d3\u05dc\u05d9\u05d9\u05dd.",
      "imageUrls": []
    },
    {
      "type": "multiple_select",
      "question": "\u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05e2\u05e8\u05db\u05d4 \u05e9\u05dc \u05d9\u05dc\u05d3 \u05e2\u05dd \u05d7\u05e9\u05d3 \u05dc\u05d4\u05e4\u05e8\u05e2\u05d4 \u05e0\u05d5\u05d9\u05e8\u05d5-\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9\u05ea, \u05d0\u05d9\u05dc\u05d5 \u05de\u05d4\u05de\u05de\u05e6\u05d0\u05d9\u05dd \u05d4\u05d1\u05d0\u05d9\u05dd \u05d1\u05d1\u05d3\u05d9\u05e7\u05ea \u05d4\u05e2\u05e6\u05d1\u05d9\u05dd \u05d4\u05e7\u05e8\u05e0\u05d9\u05d0\u05dc\u05d9\u05d9\u05dd ($Cranial \\space Nerves$) \u05e0\u05d7\u05e9\u05d1\u05d9\u05dd \u05dc\u05e1\u05d9\u05de\u05e0\u05d9 \u05d0\u05d6\u05d4\u05e8\u05d4 \u05d4\u05de\u05d7\u05d9\u05d9\u05d1\u05d9\u05dd \u05d1\u05d9\u05e8\u05d5\u05e8 \u05e0\u05d5\u05d9\u05e8\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d3\u05d7\u05d5\u05e3?",
      "answerOptions": [
        {
          "text": "\u05e4\u05d8\u05d5\u05d6\u05d9\u05e1 ($Ptosis$) \u05d0\u05d5 \u05e6\u05e0\u05d9\u05d7\u05ea \u05e2\u05e4\u05e2\u05e3 \u05d7\u05d3\u05e9\u05d4 \u05d4\u05de\u05dc\u05d5\u05d5\u05d4 \u05d1\u05d7\u05d5\u05dc\u05e9\u05d4.",
          "isCorrect": true,
          "rationale": "\u05e4\u05d8\u05d5\u05d6\u05d9\u05e1 \u05e2\u05e9\u05d5\u05d9 \u05dc\u05d4\u05e2\u05d9\u05d3 \u05e2\u05dc \u05e4\u05d2\u05d9\u05e2\u05d4 \u05d1-CN III \u05d0\u05d5 \u05e2\u05dc \u05d4\u05e4\u05e8\u05e2\u05d4 \u05e0\u05d5\u05d9\u05e8\u05d5-\u05e9\u05e8\u05d9\u05e8\u05d9\u05ea \u05db\u05de\u05d5 Myasthenia Gravis (Dulcan p.92)."
        },
        {
          "text": "\u05d0\u05d8\u05e8\u05d5\u05e4\u05d9\u05d4 \u05d0\u05d5 \u05e4\u05e1\u05d9\u05e7\u05d5\u05dc\u05e6\u05d9\u05d5\u05ea \u05e9\u05dc \u05d4\u05dc\u05e9\u05d5\u05df \u05d1\u05d1\u05d3\u05d9\u05e7\u05ea CN XII.",
          "isCorrect": true,
          "rationale": "\u05de\u05de\u05e6\u05d0\u05d9\u05dd \u05d0\u05dc\u05d5 \u05d1-CN XII \u05de\u05d7\u05e9\u05d9\u05d3\u05d9\u05dd \u05dc\u05e4\u05d2\u05d9\u05e2\u05d4 \u05d1-Lower Motor Neuron \u05d0\u05d5 \u05dc\u05de\u05d7\u05dc\u05d5\u05ea \u05e0\u05d9\u05d5\u05d5\u05e0\u05d9\u05d5\u05ea/\u05d0\u05d2\u05d9\u05e8\u05d4 (Dulcan p.92)."
        },
        {
          "text": "\u05d0\u05e1\u05d9\u05de\u05d8\u05e8\u05d9\u05d4 \u05e4\u05e0\u05d9\u05d0\u05dc\u05d9\u05ea \u05d1\u05d5\u05dc\u05d8\u05ea \u05d1\u05d6\u05de\u05df \u05d1\u05db\u05d9 \u05d0\u05d5 \u05d7\u05d9\u05d5\u05da.",
          "isCorrect": true,
          "rationale": "\u05d0\u05e1\u05d9\u05de\u05d8\u05e8\u05d9\u05d4 \u05d1\u05e4\u05e0\u05d9\u05dd \u05de\u05e2\u05d9\u05d3\u05d4 \u05e2\u05dc \u05e4\u05d2\u05d9\u05e2\u05d4 \u05d1-CN VII (\u05e2\u05e6\u05d1 \u05d4\u05e4\u05e0\u05d9\u05dd) \u05d5\u05e2\u05e9\u05d5\u05d9\u05d4 \u05dc\u05e0\u05d1\u05d5\u05e2 \u05de\u05e1\u05d9\u05d1\u05d5\u05ea \u05de\u05d5\u05dc\u05d3\u05d5\u05ea \u05d0\u05d5 \u05e0\u05e8\u05db\u05e9\u05d5\u05ea (Dulcan p.92)."
        },
        {
          "text": "\u05d4\u05d9\u05e2\u05d3\u05e8 \u05d9\u05db\u05d5\u05dc\u05ea \u05dc\u05d4\u05e8\u05d9\u05d7 \u05d7\u05d5\u05de\u05e8\u05d9\u05dd \u05d7\u05e8\u05d9\u05e4\u05d9\u05dd \u05d1\u05ea\u05d9\u05e0\u05d5\u05e7 \u05d1\u05df 3 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd.",
          "isCorrect": false,
          "rationale": "\u05d1\u05d3\u05d9\u05e7\u05ea CN I (Olfactory) \u05d0\u05d9\u05e0\u05d4 \u05de\u05d1\u05d5\u05e6\u05e2\u05ea \u05d1\u05d0\u05d5\u05e4\u05df \u05e9\u05d2\u05e8\u05ea\u05d9 \u05d1\u05ea\u05d9\u05e0\u05d5\u05e7\u05d5\u05ea \u05d5\u05d0\u05d9\u05e0\u05d4 \u05e0\u05d7\u05e9\u05d1\u05ea \u05dc\u05de\u05d3\u05d3 \u05d0\u05de\u05d9\u05df \u05d1\u05d2\u05d9\u05dc \u05d6\u05d4 (Dulcan p.92)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05de\u05de\u05dc\u05de\u05d3\u05d9\u05dd \u05d4\u05de\u05e2\u05d9\u05d3\u05d9\u05dd \u05e2\u05dc \u05e4\u05d2\u05d9\u05e2\u05d4 \u05d1\u05d2\u05e8\u05e2\u05d9\u05e0\u05d9 \u05d2\u05d6\u05e2 \u05d4\u05de\u05d5\u05d7 \u05d0\u05d5 \u05e2\u05dc \u05d7\u05d5\u05dc\u05e9\u05d4 \u05de\u05d5\u05d8\u05d5\u05e8\u05d9\u05ea \u05d4\u05d9\u05e7\u05e4\u05d9\u05ea.",
