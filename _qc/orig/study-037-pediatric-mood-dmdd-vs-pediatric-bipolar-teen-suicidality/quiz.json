{
  "title": "Psychiatry Quiz",
  "questions": [
    {
      "question": "\u05d1\u05df 9 \u05de\u05d5\u05e4\u05e0\u05d4 \u05dc\u05d4\u05e2\u05e8\u05db\u05d4 \u05e2\u05e7\u05d1 \u05d4\u05ea\u05e4\u05e8\u05e6\u05d5\u05d9\u05d5\u05ea \u05d6\u05e2\u05dd \u05e7\u05e9\u05d5\u05ea \u05d4\u05de\u05ea\u05e8\u05d7\u05e9\u05d5\u05ea \u05dc\u05e4\u05d7\u05d5\u05ea 4 \u05e4\u05e2\u05de\u05d9\u05dd \u05d1\u05e9\u05d1\u05d5\u05e2 \u05d1\u05d1\u05d9\u05ea \u05d5\u05d1\u05d1\u05d9\u05ea \u05d4\u05e1\u05e4\u05e8. \u05d4\u05d4\u05d5\u05e8\u05d9\u05dd \u05de\u05ea\u05d0\u05e8\u05d9\u05dd \u05db\u05d9 \u05d1\u05d9\u05df \u05d4\u05d4\u05ea\u05e4\u05e8\u05e6\u05d5\u05d9\u05d5\u05ea, \u05d4\u05d9\u05dc\u05d3 \u05e0\u05e8\u05d0\u05d4 \u05db\u05e2\u05d5\u05e1 \u05d5\u05e8\u05d2\u05d9\u05d6 \u05e8\u05d5\u05d1 \u05d4\u05d9\u05d5\u05dd, \u05db\u05de\u05e2\u05d8 \u05db\u05dc \u05d9\u05d5\u05dd, \u05de\u05e6\u05d1 \u05e9\u05e0\u05de\u05e9\u05da \u05db\u05d1\u05e8 \u05e9\u05e0\u05d4 \u05d5\u05d7\u05e6\u05d9. \u05dc\u05d0 \u05ea\u05d5\u05e2\u05d3\u05d5 \u05de\u05e2\u05d5\u05dc\u05dd \u05d0\u05e4\u05d9\u05d6\u05d5\u05d3\u05d5\u05ea \u05e9\u05dc \u05d9\u05e8\u05d9\u05d3\u05d4 \u05d1\u05e6\u05d5\u05e8\u05da \u05d1\u05e9\u05d9\u05e0\u05d4, \u05d8\u05d9\u05e1\u05d4 \u05e9\u05dc \u05de\u05d7\u05e9\u05d1\u05d5\u05ea \u05d0\u05d5 \u05d2\u05e8\u05e0\u05d3\u05d9\u05d5\u05d6\u05d9\u05d5\u05ea. \u05de\u05d4\u05d9 \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05de\u05d3\u05d5\u05d9\u05e7\u05ea \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR?",
      "answerOptions": [
        {
          "text": "Disruptive Mood Dysregulation Disorder (DMDD)",
          "isCorrect": true,
          "rationale": "\u05d4\u05e4\u05e8\u05e2\u05ea DMDD \u05de\u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05ea \u05d1\u05d0\u05d9\u05e8\u05d9\u05d8\u05d1\u05d9\u05dc\u05d9\u05d5\u05ea \u05db\u05e8\u05d5\u05e0\u05d9\u05ea \u05d5\u05de\u05ea\u05de\u05e9\u05db\u05ea \u05e9\u05d0\u05d9\u05e0\u05d4 \u05d0\u05e4\u05d9\u05d6\u05d5\u05d3\u05d9\u05ea, \u05d1\u05e0\u05d9\u05d2\u05d5\u05d3 \u05dc\u05de\u05d4\u05dc\u05da \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05df Bipolar Disorder \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd. (DSM p.181)"
        },
        {
          "text": "Bipolar I Disorder",
          "isCorrect": false,
          "rationale": "\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d6\u05d5 \u05d3\u05d5\u05e8\u05e9\u05ea \u05d0\u05e4\u05d9\u05d6\u05d5\u05d3\u05d5\u05ea \u05d1\u05e8\u05d5\u05e8\u05d5\u05ea \u05d5\u05ea\u05d7\u05d5\u05de\u05d5\u05ea \u05d1\u05d6\u05de\u05df \u05e9\u05dc \u05de\u05d0\u05e0\u05d9\u05d4 (\u05dc\u05e4\u05d7\u05d5\u05ea \u05e9\u05d1\u05d5\u05e2) \u05e2\u05dd \u05e9\u05d9\u05e0\u05d5\u05d9 \u05d1\u05d5\u05dc\u05d8 \u05de\u05de\u05e6\u05d1 \u05d4\u05d1\u05e1\u05d9\u05e1, \u05de\u05d4 \u05e9\u05dc\u05d0 \u05de\u05ea\u05e7\u05d9\u05d9\u05dd \u05d1\u05de\u05e7\u05e8\u05d4 \u05e9\u05dc \u05d0\u05d9\u05e8\u05d9\u05d8\u05d1\u05d9\u05dc\u05d9\u05d5\u05ea \u05db\u05e8\u05d5\u05e0\u05d9\u05ea. (DSM p.181)"
        },
        {
          "text": "Intermittent Explosive Disorder (IED)",
          "isCorrect": false,
          "rationale": "\u05d1\u05e0\u05d9\u05d2\u05d5\u05d3 \u05dc-DMDD, \u05d4\u05e4\u05e8\u05e2\u05ea IED \u05d0\u05d9\u05e0\u05d4 \u05d3\u05d5\u05e8\u05e9\u05ea \u05e7\u05d9\u05d5\u05dd \u05e9\u05dc \u05de\u05e6\u05d1 \u05e8\u05d5\u05d7 \u05e8\u05d2\u05d9\u05d6 \u05d0\u05d5 \u05db\u05e2\u05d5\u05e1 \u05d1\u05d9\u05df \u05d4\u05ea\u05e4\u05e8\u05e6\u05d5\u05d9\u05d5\u05ea \u05d4\u05d6\u05e2\u05dd. (DSM p.182)"
        },
        {
          "text": "Oppositional Defiant Disorder (ODD)",
          "isCorrect": false,
          "rationale": "\u05d0\u05e3 \u05e9\u05ea\u05e1\u05de\u05d9\u05e0\u05d9 ODD \u05e7\u05d9\u05d9\u05de\u05d9\u05dd, \u05d4-DSM \u05e7\u05d5\u05d1\u05e2 \u05e9\u05d0\u05dd \u05d4\u05d9\u05dc\u05d3 \u05e2\u05d5\u05de\u05d3 \u05d1\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05dc-DMDD, \u05d0\u05d1\u05d7\u05e0\u05d4 \u05d6\u05d5 \u05de\u05e7\u05d1\u05dc\u05ea \u05e7\u05d3\u05d9\u05de\u05d5\u05ea \u05d5\u05d0\u05d9\u05df \u05dc\u05d0\u05d1\u05d7\u05df ODD \u05d1\u05de\u05e7\u05d1\u05d9\u05dc. (DSM p.178)"
        }
      ],
      "hint": "\u05d4\u05ea\u05de\u05e7\u05d3 \u05d1\u05d4\u05d1\u05d3\u05dc \u05e9\u05d1\u05d9\u05df \u05d0\u05d9\u05e8\u05d9\u05d8\u05d1\u05d9\u05dc\u05d9\u05d5\u05ea \u05db\u05e8\u05d5\u05e0\u05d9\u05ea \u05d5\u05de\u05ea\u05de\u05e9\u05db\u05ea \u05dc\u05d1\u05d9\u05df \u05de\u05e6\u05d1\u05d9 \u05e8\u05d5\u05d7 \u05d4\u05de\u05d5\u05e4\u05d9\u05e2\u05d9\u05dd \u05d1\u05d0\u05e4\u05d9\u05d6\u05d5\u05d3\u05d5\u05ea \u05ea\u05d7\u05d5\u05de\u05d5\u05ea."
    },
    {
      "question": "\u05e0\u05e2\u05e8\u05d4 \u05d1\u05ea 15 \u05de\u05d5\u05d1\u05d0\u05ea \u05dc\u05d7\u05d3\u05e8 \u05d4\u05de\u05d9\u05d5\u05df (ED) \u05dc\u05d0\u05d7\u05e8 \u05e9\u05e0\u05d8\u05dc\u05d4 15 \u05db\u05d3\u05d5\u05e8\u05d9 \u05d5\u05d9\u05d8\u05de\u05d9\u05e0\u05d9\u05dd \u05d1\u05e0\u05d9\u05e1\u05d9\u05d5\u05df \u05dc\u05e9\u05d9\u05dd \u05e7\u05e5 \u05dc\u05d7\u05d9\u05d9\u05d4. \u05d4\u05d9\u05d0 \u05de\u05d1\u05d9\u05e2\u05d4 \u05d0\u05db\u05d6\u05d1\u05d4 \u05de\u05db\u05da \u05e9\u05e0\u05e9\u05d0\u05e8\u05d4 \u05d1\u05d7\u05d9\u05d9\u05dd \u05d5\u05de\u05e6\u05d9\u05d9\u05e0\u05ea \u05e9\u05ea\u05db\u05e0\u05e0\u05d4 \u05d0\u05ea \u05d4\u05de\u05e2\u05e9\u05d4 \u05d1\u05de\u05e9\u05da \u05e9\u05d1\u05d5\u05e2\u05d9\u05d9\u05dd. \u05db\u05d9\u05e6\u05d3 \u05d9\u05e9 \u05dc\u05d4\u05e2\u05e8\u05d9\u05da \u05d0\u05ea \u05d7\u05d5\u05de\u05e8\u05ea \u05d4\u05de\u05e2\u05e9\u05d4 \u05dc\u05e4\u05d9 \u05d4-Dulcan?",
      "answerOptions": [
        {
          "text": "\u05db\u05d5\u05d5\u05e0\u05ea \u05d4\u05de\u05d8\u05d5\u05e4\u05dc\u05ea (Intent) \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05d9\u05d5\u05ea\u05e8 \u05de\u05d4\u05e7\u05d8\u05dc\u05e0\u05d9\u05d5\u05ea \u05d4\u05e8\u05e4\u05d5\u05d0\u05d9\u05ea (Medical lethality) \u05d1\u05e4\u05d5\u05e2\u05dc",
          "isCorrect": true,
          "rationale": "\u05d1\u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9\u05d4 \u05e9\u05dc \u05d9\u05dc\u05d3\u05d9\u05dd, \u05e7\u05d8\u05dc\u05e0\u05d9\u05d5\u05ea \u05e8\u05e4\u05d5\u05d0\u05d9\u05ea \u05d0\u05d9\u05e0\u05d4 \u05d1\u05d4\u05db\u05e8\u05d7 \u05e7\u05e9\u05d5\u05e8\u05d4 \u05dc\u05db\u05d5\u05d5\u05e0\u05d4, \u05e9\u05db\u05df \u05d9\u05dc\u05d3\u05d9\u05dd \u05e0\u05d5\u05d8\u05d9\u05dd \u05dc\u05d4\u05e2\u05e8\u05db\u05ea \u05d7\u05e1\u05e8 \u05d0\u05d5 \u05d4\u05e2\u05e8\u05db\u05ea \u05d9\u05ea\u05e8 \u05e9\u05dc \u05e8\u05de\u05ea \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05d1\u05e9\u05d9\u05d8\u05d4 \u05e9\u05d1\u05d7\u05e8\u05d5. (Dulcan p.607)"
        },
        {
          "text": "\u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05e0\u05de\u05d5\u05da \u05db\u05d9\u05d5\u05d5\u05df \u05e9\u05d4\u05e9\u05d9\u05d8\u05d4 \u05e9\u05e0\u05d1\u05d7\u05e8\u05d4 \u05d0\u05d9\u05e0\u05d4 \u05e7\u05d8\u05dc\u05e0\u05d9\u05ea \u05de\u05d1\u05d7\u05d9\u05e0\u05d4 \u05e4\u05d9\u05d6\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea",
          "isCorrect": false,
          "rationale": "\u05d1\u05d7\u05d9\u05e8\u05d4 \u05d1\u05e9\u05d9\u05d8\u05d4 \u05d1\u05e2\u05dc\u05ea \u05e7\u05d8\u05dc\u05e0\u05d9\u05d5\u05ea \u05e0\u05de\u05d5\u05db\u05d4 \u05d0\u05d9\u05e0\u05d4 \u05de\u05e2\u05d9\u05d3\u05d4 \u05e2\u05dc \u05db\u05d5\u05d5\u05e0\u05d4 \u05d0\u05d5\u05d1\u05d3\u05e0\u05d9\u05ea \u05e0\u05de\u05d5\u05db\u05d4, \u05d1\u05de\u05d9\u05d5\u05d7\u05d3 \u05d1\u05e7\u05e8\u05d1 \u05e6\u05e2\u05d9\u05e8\u05d9\u05dd \u05e9\u05e2\u05dc\u05d5\u05dc\u05d9\u05dd \u05dc\u05d8\u05e2\u05d5\u05ea \u05d1\u05d4\u05e2\u05e8\u05db\u05ea \u05d4\u05e1\u05d9\u05db\u05d5\u05df. (Dulcan p.556)"
        },
        {
          "text": "\u05e0\u05d9\u05ea\u05df \u05dc\u05e9\u05d7\u05e8\u05e8 \u05d0\u05ea \u05d4\u05de\u05d8\u05d5\u05e4\u05dc\u05ea \u05dc\u05d1\u05d9\u05ea\u05d4 \u05e2\u05dd '\u05d7\u05d5\u05d6\u05d4 \u05dc\u05e2\u05e8\u05d1\u05d5\u05ea \u05dc\u05d7\u05d9\u05d9\u05dd' (No-suicide contract)",
          "isCorrect": false,
          "rationale": "\u05de\u05de\u05e6\u05d0\u05d9\u05dd \u05de\u05d7\u05e7\u05e8\u05d9\u05d9\u05dd \u05d0\u05d9\u05e0\u05dd \u05ea\u05d5\u05de\u05db\u05d9\u05dd \u05d1\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05d7\u05d5\u05d6\u05d9\u05dd \u05db\u05d0\u05dc\u05d5 \u05dc\u05d4\u05e4\u05d7\u05ea\u05ea \u05e1\u05d9\u05db\u05d5\u05df, \u05d5\u05d9\u05e9 \u05dc\u05d4\u05e2\u05d3\u05d9\u05e3 \u05d1\u05e0\u05d9\u05d9\u05ea Safety plan \u05d1\u05e9\u05d9\u05ea\u05d5\u05e3 \u05d4\u05de\u05e9\u05e4\u05d7\u05d4. (Dulcan p.609)"
        },
        {
          "text": "\u05d9\u05e9 \u05dc\u05d4\u05de\u05ea\u05d9\u05df \u05dc\u05d1\u05d3\u05d9\u05e7\u05d5\u05ea \u05d8\u05d5\u05e7\u05e1\u05d9\u05e7\u05d5\u05dc\u05d5\u05d2\u05d9\u05d4 \u05dc\u05e4\u05e0\u05d9 \u05d4\u05e2\u05e8\u05db\u05ea \u05d4\u05db\u05d5\u05d5\u05e0\u05d4 \u05d4\u05d0\u05d5\u05d1\u05d3\u05e0\u05d9\u05ea",
          "isCorrect": false,
          "rationale": "\u05d0\u05e3 \u05e9\u05d8\u05d5\u05e7\u05e1\u05d9\u05e7\u05d5\u05dc\u05d5\u05d2\u05d9\u05d4 \u05d7\u05e9\u05d5\u05d1\u05d4 \u05e8\u05e4\u05d5\u05d0\u05d9\u05ea, \u05d4\u05e2\u05e8\u05db\u05ea \u05d4\u05db\u05d5\u05d5\u05e0\u05d4 \u05d5\u05d4\u05ea\u05db\u05e0\u05d5\u05df \u05e6\u05e8\u05d9\u05db\u05d4 \u05dc\u05d4\u05ea\u05d1\u05e1\u05e1 \u05e2\u05dc \u05d4\u05e8\u05d0\u05d9\u05d5\u05df \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9 \u05d5\u05e2\u05dc \u05e0\u05e1\u05d9\u05d1\u05d5\u05ea \u05d4\u05e0\u05d9\u05e1\u05d9\u05d5\u05df \u05dc\u05dc\u05d0 \u05e7\u05e9\u05e8 \u05dc\u05ea\u05d5\u05e6\u05d0\u05d5\u05ea \u05d4\u05de\u05e2\u05d1\u05d3\u05d4. (Dulcan p.607)"
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05e4\u05e2\u05e8 \u05d4\u05de\u05e7\u05d5\u05d1\u05dc \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d1\u05d9\u05df \u05d4\u05d9\u05d3\u05e2 \u05d4\u05e8\u05e4\u05d5\u05d0\u05d9 \u05e9\u05dc\u05d4\u05dd \u05dc\u05d1\u05d9\u05df \u05e2\u05d5\u05e6\u05de\u05ea \u05d4\u05e8\u05e6\u05d5\u05df \u05dc\u05de\u05d5\u05ea."
    },
    {
      "question": "\u05d1\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05d9\u05dc\u05d3 \u05d1\u05df 10 \u05d4\u05de\u05d0\u05d5\u05d1\u05d7\u05df \u05e2\u05dd Major Depressive Disorder (MDD), \u05de\u05d4\u05d5 \u05d4\u05de\u05d9\u05d3\u05e2 \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9 \u05d4\u05de\u05d3\u05d5\u05d9\u05e7 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05d2\u05d1\u05d9 \u05e9\u05d9\u05de\u05d5\u05e9 \u05d1-SSRIs \u05d5\u05d4-Black-box warning \u05e9\u05dc \u05d4-FDA?",
      "answerOptions": [
        {
          "text": "\u05e7\u05d9\u05d9\u05dd \u05e1\u05d9\u05db\u05d5\u05df \u05de\u05d5\u05d2\u05d1\u05e8 \u05dc\u05de\u05d7\u05e9\u05d1\u05d5\u05ea \u05d5\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d0\u05d5\u05d1\u05d3\u05e0\u05d9\u05ea, \u05d0\u05da \u05d1\u05e0\u05d9\u05e1\u05d5\u05d9\u05d9\u05dd \u05de\u05d1\u05d5\u05e7\u05e8\u05d9\u05dd \u05dc\u05d0 \u05e0\u05e8\u05e9\u05de\u05d5 \u05de\u05e7\u05e8\u05d9 \u05d4\u05ea\u05d0\u05d1\u05d3\u05d5\u05ea \u05e9\u05d4\u05d5\u05e9\u05dc\u05de\u05d5 (Completed suicides)",
          "isCorrect": true,
          "rationale": "\u05d4\u05d0\u05d6\u05d4\u05e8\u05d4 \u05de\u05ea\u05d9\u05d9\u05d7\u05e1\u05ea \u05dc\u05e2\u05dc\u05d9\u05d9\u05d4 \u05d1-suicidality (\u05de\u05d7\u05e9\u05d1\u05d5\u05ea \u05d5\u05e0\u05d9\u05e1\u05d9\u05d5\u05e0\u05d5\u05ea), \u05d0\u05da \u05dc\u05d0 \u05e0\u05de\u05e6\u05d0\u05d4 \u05d4\u05d5\u05db\u05d7\u05d4 \u05dc\u05d4\u05ea\u05d0\u05d1\u05d3\u05d5\u05d9\u05d5\u05ea \u05de\u05d5\u05e9\u05dc\u05de\u05d5\u05ea \u05ea\u05d7\u05ea \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05e0\u05d9\u05e1\u05d5\u05d9\u05d9\u05dd \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9\u05d9\u05dd. (StahlKids p.452)"
        },
        {
          "text": "\u05d4\u05d0\u05d6\u05d4\u05e8\u05d4 \u05d7\u05dc\u05d4 \u05e8\u05e7 \u05e2\u05dc Fluoxetine \u05d5\u05d0\u05d9\u05e0\u05d4 \u05e8\u05dc\u05d5\u05d5\u05e0\u05d8\u05d9\u05ea \u05dc\u05e9\u05d0\u05e8 \u05de\u05e9\u05e4\u05d7\u05ea \u05d4-SSRIs",
          "isCorrect": false,
          "rationale": "\u05d4-Black-box warning \u05e8\u05dc\u05d5\u05d5\u05e0\u05d8\u05d9 \u05dc\u05db\u05dc\u05dc \u05d4\u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05d4\u05d0\u05e0\u05d8\u05d9-\u05d3\u05d9\u05db\u05d0\u05d5\u05e0\u05d9\u05d5\u05ea \u05d4\u05de\u05e9\u05de\u05e9\u05d5\u05ea \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d5\u05d1\u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd. (StahlKids p.184)"
        },
        {
          "text": "\u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05d4\u05d2\u05d1\u05d5\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05d0\u05d5\u05d1\u05d3\u05e0\u05d5\u05ea \u05de\u05d5\u05e4\u05d9\u05e2 \u05dc\u05d0\u05d7\u05e8 6 \u05d7\u05d5\u05d3\u05e9\u05d9 \u05d8\u05d9\u05e4\u05d5\u05dc \u05d9\u05e6\u05d9\u05d1",
          "isCorrect": false,
          "rationale": "\u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05d4\u05d2\u05d3\u05d5\u05dc \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d0\u05d5\u05d1\u05d3\u05e0\u05d9\u05ea \u05e0\u05de\u05e6\u05d0 \u05d3\u05d5\u05d5\u05e7\u05d0 \u05d1\u05d7\u05d5\u05d3\u05e9 \u05e9\u05dc\u05e4\u05e0\u05d9 \u05ea\u05d7\u05d9\u05dc\u05ea \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc, \u05d1\u05de\u05d9\u05d5\u05d7\u05d3 \u05d1\u05e9\u05d1\u05d5\u05e2 \u05e9\u05dc\u05e4\u05e0\u05d9 \u05d4\u05e4\u05e0\u05d9\u05d9\u05d4 \u05dc\u05e2\u05d6\u05e8\u05d4. (StahlKids p.451)"
        },
        {
          "text": "\u05d0\u05d9\u05df \u05e6\u05d5\u05e8\u05da \u05d1\u05e0\u05d9\u05d8\u05d5\u05e8 \u05de\u05d5\u05d2\u05d1\u05e8 \u05d1\u05e9\u05d1\u05d5\u05e2\u05d5\u05ea \u05d4\u05e8\u05d0\u05e9\u05d5\u05e0\u05d9\u05dd \u05d0\u05dd \u05d4\u05d9\u05dc\u05d3 \u05d0\u05d9\u05e0\u05d5 \u05e1\u05d5\u05d1\u05dc \u05de\u05ea\u05d5\u05e4\u05e2\u05d5\u05ea \u05dc\u05d5\u05d5\u05d0\u05d9",
          "isCorrect": false,
          "rationale": "\u05d9\u05e9 \u05e6\u05d5\u05e8\u05da \u05d1\u05e0\u05d9\u05d8\u05d5\u05e8 \u05e7\u05e4\u05d3\u05e0\u05d9 \u05d0\u05d7\u05e8 \u05ea\u05e1\u05de\u05d9\u05e0\u05d9 \u05d0\u05e7\u05d8\u05d9\u05d1\u05e6\u05d9\u05d4 (TEAS) \u05d5\u05e9\u05d9\u05e0\u05d5\u05d9\u05d9 \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d1\u05de\u05d9\u05d5\u05d7\u05d3 \u05d1\u05ea\u05d7\u05d9\u05dc\u05ea \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d5\u05d1\u05e9\u05d9\u05e0\u05d5\u05d9\u05d9 \u05de\u05d9\u05e0\u05d5\u05df. (StahlKids p.452)"
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05d4\u05d1\u05d3\u05dc \u05e9\u05d1\u05d9\u05df \u05de\u05d7\u05e9\u05d1\u05d5\u05ea/\u05e0\u05d9\u05e1\u05d9\u05d5\u05e0\u05d5\u05ea \u05dc\u05d1\u05d9\u05df \u05ea\u05d5\u05e6\u05d0\u05d4 \u05e1\u05d5\u05e4\u05d9\u05ea \u05e9\u05dc \u05de\u05d5\u05d5\u05ea \u05d1\u05e0\u05d9\u05e1\u05d5\u05d9\u05d9\u05dd \u05de\u05d1\u05d5\u05e7\u05e8\u05d9\u05dd."
    },
    {
      "question": "\u05de\u05d7\u05e7\u05e8\u05d9 \u05d3\u05d9\u05de\u05d5\u05ea \u05e0\u05d5\u05d9\u05e8\u05d5\u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05d9\u05dd (DTI \u05d5-fMRI) \u05de\u05e6\u05d1\u05d9\u05e2\u05d9\u05dd \u05e2\u05dc \u05d4\u05d1\u05d3\u05dc\u05d9\u05dd \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05d9\u05dd \u05d1\u05d9\u05df DMDD \u05dc\u05d1\u05d9\u05df Bipolar Disorder \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd. \u05de\u05d4\u05d5 \u05d4\u05de\u05de\u05e6\u05d0 \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05d1\u05d0\u05d5\u05e4\u05df \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9 \u05d0\u05ea \u05d4-DMDD?",
      "answerOptions": [
        {
          "text": "\u05e4\u05d2\u05d9\u05e2\u05d4 \u05d0\u05d6\u05d5\u05e8\u05d9\u05ea \u05de\u05de\u05d5\u05e7\u05d3\u05ea \u05d1\u05d7\u05d5\u05de\u05e8 \u05d4\u05dc\u05d1\u05df \u05e2\u05dd \u05e2\u05e8\u05db\u05d9 Fractional Anisotropy (FA) \u05de\u05d5\u05e4\u05d7\u05ea\u05d9\u05dd",
          "isCorrect": true,
          "rationale": "\u05de\u05d7\u05e7\u05e8\u05d9 DTI \u05d4\u05e8\u05d0\u05d5 \u05e9\u05d1-DMDD \u05d4\u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd \u05d1\u05d7\u05d5\u05de\u05e8 \u05d4\u05dc\u05d1\u05df \u05d4\u05dd \u05d3\u05d9\u05e1\u05e7\u05e8\u05d8\u05d9\u05d9\u05dd \u05d5\u05de\u05de\u05d5\u05e7\u05d3\u05d9\u05dd, \u05d1\u05e2\u05d5\u05d3 \u05e9\u05d1-Bipolar Disorder \u05d4\u05e4\u05d2\u05d9\u05e2\u05d4 \u05d4\u05d9\u05d0 \u05d1\u05ea\u05d4\u05dc\u05d9\u05da \u05d4\u05de\u05d9\u05d0\u05dc\u05d9\u05e0\u05d9\u05d6\u05e6\u05d9\u05d4. (Dulcan p.290)"
        },
        {
          "text": "\u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd \u05e0\u05e8\u05d7\u05d1\u05d9\u05dd \u05d1\u05de\u05d9\u05d0\u05dc\u05d9\u05e0\u05d9\u05d6\u05e6\u05d9\u05d4 (Altered myelination)",
          "isCorrect": false,
          "rationale": "\u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd \u05d1\u05ea\u05d4\u05dc\u05d9\u05da \u05d4\u05de\u05d9\u05d0\u05dc\u05d9\u05e0\u05d9\u05d6\u05e6\u05d9\u05d4 \u05e0\u05de\u05e6\u05d0\u05d5 \u05db\u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9\u05dd \u05d9\u05d5\u05ea\u05e8 \u05d0\u05ea \u05d4-Bipolar Disorder \u05d4\u05e4\u05d3\u05d9\u05d0\u05d8\u05e8\u05d9 \u05de\u05d0\u05e9\u05e8 DMDD. (Dulcan p.290)"
        },
        {
          "text": "\u05d4\u05e2\u05d3\u05e8 \u05de\u05d5\u05d7\u05dc\u05d8 \u05e9\u05dc \u05dc\u05d9\u05e7\u05d5\u05d9\u05d9\u05dd \u05d1\u05d6\u05d9\u05d4\u05d5\u05d9 \u05d4\u05d1\u05e2\u05d5\u05ea \u05e4\u05e0\u05d9\u05dd (Face-emotion labeling)",
          "isCorrect": false,
          "rationale": "\u05e9\u05ea\u05d9 \u05d4\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea (DMDD \u05d5-BP) \u05de\u05e6\u05d9\u05d2\u05d5\u05ea \u05dc\u05d9\u05e7\u05d5\u05d9\u05d9\u05dd \u05d1\u05d6\u05d9\u05d4\u05d5\u05d9 \u05e8\u05d2\u05e9\u05d5\u05ea \u05d1\u05e4\u05e0\u05d9\u05dd, \u05d0\u05da \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05e2\u05e6\u05d1\u05d9 \u05d4\u05de\u05ea\u05d5\u05d5\u05da \u05d0\u05ea \u05d4\u05dc\u05d9\u05e7\u05d5\u05d9 \u05e9\u05d5\u05e0\u05d4. (DSM p.180)"
        },
        {
          "text": "\u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05d9\u05ea\u05e8 \u05e9\u05dc \u05d4\u05d0\u05de\u05d9\u05d2\u05d3\u05dc\u05d4 \u05d1\u05ea\u05d2\u05d5\u05d1\u05d4 \u05dc\u05d2\u05d9\u05e8\u05d5\u05d9\u05d9\u05dd \u05e0\u05d9\u05d8\u05e8\u05dc\u05d9\u05d9\u05dd \u05d1\u05dc\u05d1\u05d3",
          "isCorrect": false,
          "rationale": "\u05d4\u05de\u05e7\u05d5\u05e8\u05d5\u05ea \u05de\u05e6\u05d1\u05d9\u05e2\u05d9\u05dd \u05e2\u05dc \u05d4\u05d1\u05d3\u05dc\u05d9\u05dd \u05d1\u05d3\u05e4\u05d5\u05e1\u05d9 \u05ea\u05d2\u05d5\u05d1\u05d4 \u05dc\u05d2\u05d9\u05e8\u05d5\u05d9\u05d9\u05dd \u05e8\u05d2\u05e9\u05d9\u05d9\u05dd, \u05d0\u05da \u05dc\u05d0 \u05de\u05e6\u05d9\u05d9\u05e0\u05d9\u05dd \u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05d9\u05ea\u05e8 \u05d1\u05dc\u05e2\u05d3\u05d9\u05ea \u05dc\u05d2\u05d9\u05e8\u05d5\u05d9\u05d9\u05dd \u05e0\u05d9\u05d8\u05e8\u05dc\u05d9\u05d9\u05dd \u05d1-DMDD. (\u05de\u05e7\u05d5\u05e8: \u05d4\u05e7\u05e9\u05e8 \u05e8\u05d7\u05d1)"
        }
      ],
      "hint": "\u05d4\u05ea\u05de\u05e7\u05d3 \u05d1\u05e1\u05d5\u05d2 \u05d4\u05e4\u05d2\u05d9\u05e2\u05d4 \u05d1\u05d7\u05d5\u05de\u05e8 \u05d4\u05dc\u05d1\u05df (\u05de\u05d1\u05e0\u05d9\u05ea \u05de\u05de\u05d5\u05e7\u05d3\u05ea \u05de\u05d5\u05dc \u05ea\u05d4\u05dc\u05d9\u05da \u05d4\u05de\u05d9\u05d0\u05dc\u05d9\u05df)."
    },
    {
      "question": "\u05de\u05d4\u05d5 \u05d4\u05e6\u05e2\u05d3 \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9 \u05d4\u05e8\u05d0\u05e9\u05d5\u05e0\u05d9 \u05d5\u05d4\u05e7\u05e8\u05d9\u05d8\u05d9 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d1\u05e0\u05d9\u05d4\u05d5\u05dc Means restriction \u05db\u05d7\u05dc\u05e7 \u05de\u05ea\u05d5\u05db\u05e0\u05d9\u05ea \u05d1\u05d8\u05d9\u05d7\u05d5\u05ea (Safety plan) \u05dc\u05e0\u05e2\u05e8 \u05d0\u05d5\u05d1\u05d3\u05e0\u05d9?",
      "answerOptions": [
        {
          "text": "\u05d4\u05e1\u05e8\u05ea \u05db\u05dc\u05d9 \u05e0\u05e9\u05e7 (Firearms) \u05de\u05d4\u05d1\u05d9\u05ea \u05d5\u05e6\u05de\u05e6\u05d5\u05dd \u05d2\u05d9\u05e9\u05d4 \u05dc\u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05d5\u05d7\u05e4\u05e6\u05d9\u05dd \u05d7\u05d3\u05d9\u05dd",
          "isCorrect": true,
          "rationale": "\u05e6\u05de\u05e6\u05d5\u05dd \u05d4\u05d2\u05d9\u05e9\u05d4 \u05dc\u05d0\u05de\u05e6\u05e2\u05d9\u05dd \u05e7\u05d8\u05dc\u05e0\u05d9\u05d9\u05dd, \u05d5\u05d1\u05de\u05d9\u05d5\u05d7\u05d3 \u05dc\u05db\u05dc\u05d9 \u05e0\u05e9\u05e7, \u05d4\u05d5\u05d0 \u05d4\u05e6\u05e2\u05d3 \u05d4\u05e8\u05d0\u05e9\u05d5\u05df \u05d5\u05d4\u05d7\u05e9\u05d5\u05d1 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d1\u05de\u05e0\u05d9\u05e2\u05ea \u05d0\u05d5\u05d1\u05d3\u05e0\u05d5\u05ea \u05d0\u05d9\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05ea. (Dulcan p.609)"
        },
        {
          "text": "\u05d7\u05ea\u05d9\u05de\u05d4 \u05e2\u05dc \u05de\u05e1\u05de\u05da 'No-suicide contract' \u05d1\u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05d4\u05d4\u05d5\u05e8\u05d9\u05dd",
          "isCorrect": false,
          "rationale": "\u05d7\u05d5\u05d6\u05d9\u05dd \u05d0\u05dc\u05d5 \u05d0\u05d9\u05e0\u05dd \u05d9\u05e2\u05d9\u05dc\u05d9\u05dd \u05d1\u05de\u05e0\u05d9\u05e2\u05ea \u05d0\u05d5\u05d1\u05d3\u05e0\u05d5\u05ea \u05d5\u05d9\u05db\u05d5\u05dc\u05d9\u05dd \u05dc\u05d4\u05e7\u05e0\u05d5\u05ea \u05ea\u05d7\u05d5\u05e9\u05ea \u05d1\u05d9\u05d8\u05d7\u05d5\u05df \u05e9\u05d2\u05d5\u05d9\u05d4 \u05dc\u05de\u05d8\u05e4\u05dc\u05d9\u05dd. (Dulcan p.609)"
        },
        {
          "text": "\u05d4\u05d3\u05e8\u05db\u05ea \u05d4\u05d4\u05d5\u05e8\u05d9\u05dd \u05db\u05d9\u05e6\u05d3 \u05dc\u05d6\u05d4\u05d5\u05ea \u05e1\u05d9\u05de\u05e0\u05d9 \u05d0\u05d6\u05d4\u05e8\u05d4 \u05e8\u05d2\u05e9\u05d9\u05d9\u05dd \u05d1\u05dc\u05d1\u05d3",
          "isCorrect": false,
          "rationale": "\u05d6\u05d9\u05d4\u05d5\u05d9 \u05e1\u05d9\u05de\u05e0\u05d9 \u05d0\u05d6\u05d4\u05e8\u05d4 \u05d4\u05d5\u05d0 \u05d7\u05dc\u05e7 \u05de\u05d4\u05ea\u05d5\u05db\u05e0\u05d9\u05ea, \u05d0\u05da \u05d4\u05d5\u05d0 \u05d0\u05d9\u05e0\u05d5 \u05de\u05d7\u05dc\u05d9\u05e3 \u05d0\u05ea \u05d4\u05e6\u05d5\u05e8\u05da \u05d4\u05d0\u05e7\u05d5\u05d8\u05d9 \u05d1\u05d4\u05d2\u05d1\u05dc\u05ea \u05d2\u05d9\u05e9\u05d4 \u05e4\u05d9\u05d6\u05d9\u05ea \u05dc\u05d0\u05de\u05e6\u05e2\u05d9\u05dd \u05e7\u05d8\u05dc\u05e0\u05d9\u05d9\u05dd. (Dulcan p.608)"
        },
        {
          "text": "\u05d4\u05e4\u05e0\u05d9\u05d4 \u05de\u05d9\u05d9\u05d3\u05d9\u05ea \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05e4\u05e1\u05d9\u05db\u05d5\u05ea\u05e8\u05e4\u05d9 \u05de\u05e1\u05d5\u05d2 CBT-SP \u05dc\u05dc\u05d0 \u05de\u05e2\u05d5\u05e8\u05d1\u05d5\u05ea \u05d4\u05de\u05e9\u05e4\u05d7\u05d4",
          "isCorrect": false,
          "rationale": "\u05ea\u05d5\u05db\u05e0\u05d9\u05ea \u05d1\u05d8\u05d9\u05d7\u05d5\u05ea \u05d7\u05d9\u05d9\u05d1\u05ea \u05dc\u05db\u05dc\u05d5\u05dc \u05e9\u05d9\u05ea\u05d5\u05e3 \u05e4\u05e2\u05d5\u05dc\u05d4 \u05d4\u05d3\u05d5\u05e7 \u05e2\u05dd \u05d4\u05de\u05e9\u05e4\u05d7\u05d4 \u05db\u05d3\u05d9 \u05dc\u05d4\u05d1\u05d8\u05d9\u05d7 \u05d0\u05ea \u05e1\u05d1\u05d9\u05d1\u05ea \u05d4\u05de\u05d8\u05d5\u05e4\u05dc. (Dulcan p.609)"
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05e4\u05e2\u05d5\u05dc\u05d4 \u05d4\u05e4\u05d9\u05d6\u05d9\u05ea \u05d1\u05e1\u05d1\u05d9\u05d1\u05ea \u05d4\u05d1\u05d9\u05ea \u05e9\u05d9\u05db\u05d5\u05dc\u05d4 \u05dc\u05de\u05e0\u05d5\u05e2 \u05de\u05d5\u05d5\u05ea \u05d1\u05de\u05e7\u05e8\u05d4 \u05e9\u05dc \u05d3\u05d7\u05e3 \u05e8\u05d2\u05e2\u05b4\u05d9."
    },
    {
      "question": "\u05dc\u05e4\u05d9 \u05de\u05d7\u05e7\u05e8\u05d9 \u05de\u05e2\u05e7\u05d1 \u05d0\u05e8\u05d5\u05db\u05d9 \u05d8\u05d5\u05d5\u05d7 (Longitudinal), \u05de\u05d4\u05d5 \u05d4\u05d2\u05d5\u05e8\u05dc \u05d4\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9 \u05d4\u05e1\u05d1\u05d9\u05e8 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05e9\u05dc \u05d9\u05dc\u05d3\u05d9\u05dd \u05d4\u05de\u05d0\u05d5\u05d1\u05d7\u05e0\u05d9\u05dd \u05e2\u05dd DMDD (\u05d0\u05d9\u05e8\u05d9\u05d8\u05d1\u05d9\u05dc\u05d9\u05d5\u05ea \u05db\u05e8\u05d5\u05e0\u05d9\u05ea) \u05d1\u05d1\u05d2\u05e8\u05d5\u05ea\u05dd?",
      "answerOptions": [
        {
          "text": "\u05e1\u05d9\u05db\u05d5\u05df \u05de\u05d5\u05d2\u05d1\u05e8 \u05dc\u05e4\u05ea\u05d7 Unipolar Depression \u05d5-Anxiety Disorders",
          "isCorrect": true,
          "rationale": "\u05de\u05d7\u05e7\u05e8\u05d9\u05dd \u05de\u05e8\u05d0\u05d9\u05dd \u05db\u05d9 \u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd \u05d0\u05d9\u05e8\u05d9\u05d8\u05d1\u05d9\u05dc\u05d9\u05d5\u05ea \u05db\u05e8\u05d5\u05e0\u05d9\u05ea \u05e0\u05d5\u05d8\u05d9\u05dd \u05dc\u05e4\u05ea\u05d7 \u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05d5\u05d7\u05e8\u05d3\u05d4 \u05d1\u05d1\u05d2\u05e8\u05d5\u05ea\u05dd, \u05d5\u05dc\u05d0 \u05d4\u05e4\u05e8\u05e2\u05d4 \u05d3\u05d5-\u05e7\u05d5\u05d8\u05d1\u05d9\u05ea. (DSM p.179)"
        },
        {
          "text": "\u05d4\u05de\u05e8\u05d4 (Conversion) \u05dc-Bipolar I Disorder \u05d1\u05e9\u05d9\u05e2\u05d5\u05e8\u05d9\u05dd \u05d2\u05d1\u05d5\u05d4\u05d9\u05dd",
          "isCorrect": false,
          "rationale": "\u05e9\u05d9\u05e2\u05d5\u05e8\u05d9 \u05d4\u05d4\u05de\u05e8\u05d4 \u05de-DMDD \u05dc-Bipolar Disorder \u05d4\u05dd \u05e0\u05de\u05d5\u05db\u05d9\u05dd \u05de\u05d0\u05d5\u05d3, \u05de\u05d4 \u05e9\u05de\u05d1\u05d3\u05d9\u05dc \u05d0\u05d5\u05ea\u05d4 \u05de\u05d4\u05e4\u05e8\u05e2\u05d4 \u05d3\u05d5-\u05e7\u05d5\u05d8\u05d1\u05d9\u05ea \u05e4\u05d3\u05d9\u05d0\u05d8\u05e8\u05d9\u05ea \u05e7\u05dc\u05d0\u05e1\u05d9\u05ea. (DSM p.179)"
        },
        {
          "text": "\u05e1\u05d9\u05db\u05d5\u05df \u05d2\u05d1\u05d5\u05d4 \u05dc\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea Schizophrenia \u05d1\u05d2\u05d9\u05dc \u05d4\u05d4\u05ea\u05d1\u05d2\u05e8\u05d5\u05ea",
          "isCorrect": false,
          "rationale": "\u05d0\u05d9\u05df \u05e2\u05d3\u05d5\u05ea \u05de\u05d7\u05e7\u05e8\u05d9\u05ea \u05d7\u05d6\u05e7\u05d4 \u05d4\u05de\u05e7\u05e9\u05e8\u05ea \u05d1\u05d0\u05d5\u05e4\u05df \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9 \u05d1\u05d9\u05df DMDD \u05dc\u05d1\u05d9\u05df \u05e1\u05d9\u05db\u05d5\u05df \u05de\u05d5\u05d2\u05d1\u05e8 \u05dc\u05e1\u05db\u05d9\u05d6\u05d5\u05e4\u05e8\u05e0\u05d9\u05d4 \u05d1\u05d4\u05e9\u05d5\u05d5\u05d0\u05d4 \u05dc\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05de\u05e6\u05d1 \u05e8\u05d5\u05d7 \u05d0\u05d7\u05e8\u05d5\u05ea. (\u05de\u05e7\u05d5\u05e8: \u05d4\u05e7\u05e9\u05e8 \u05e8\u05d7\u05d1)"
        },
        {
          "text": "\u05d4\u05d7\u05dc\u05de\u05d4 \u05de\u05dc\u05d0\u05d4 \u05d1-90% \u05de\u05d4\u05de\u05e7\u05e8\u05d9\u05dd \u05e2\u05d3 \u05d2\u05d9\u05dc 18 \u05dc\u05dc\u05d0 \u05e7\u05d5\u05de\u05d5\u05e8\u05d1\u05d9\u05d3\u05d9\u05d5\u05ea",
          "isCorrect": false,
          "rationale": "\u05d0\u05e3 \u05e9\u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05de\u05e9\u05ea\u05e0\u05d9\u05dd, \u05d9\u05dc\u05d3\u05d9\u05dd \u05d0\u05dc\u05d5 \u05e0\u05d5\u05ea\u05e8\u05d9\u05dd \u05d1\u05e1\u05d9\u05db\u05d5\u05df \u05d2\u05d1\u05d5\u05d4 \u05dc\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9\u05d5\u05ea \u05d0\u05d7\u05e8\u05d5\u05ea \u05d1\u05d1\u05d2\u05e8\u05d5\u05ea\u05dd. (DSM p.179)"
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05de\u05d3\u05d5\u05e2 \u05d4\u05d5\u05d7\u05dc\u05d8 \u05dc\u05d4\u05db\u05e0\u05d9\u05e1 \u05d0\u05ea \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05dc\u05e4\u05e8\u05e7 \u05e9\u05dc \u05d4\u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05d5\u05dc\u05d0 \u05dc\u05e4\u05e8\u05e7 \u05e9\u05dc \u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05d1\u05d9\u05e4\u05d5\u05dc\u05e8\u05d9\u05d5\u05ea."
    },
    {
      "question": "\u05db\u05d9\u05e6\u05d3 \u05de\u05d2\u05d3\u05d9\u05e8 \u05d4-DSM-5-TR \u05d0\u05ea \u05d9\u05d7\u05e1\u05d9 \u05d4\u05d2\u05d5\u05de\u05dc\u05d9\u05df (Comorbidity) \u05d1\u05d9\u05df DMDD \u05dc\u05d1\u05d9\u05df Oppositional Defiant Disorder (ODD)?",
      "answerOptions": [
        {
          "text": "\u05d0\u05dd \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05e2\u05d5\u05de\u05d3 \u05d1\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05dc\u05e9\u05ea\u05d9 \u05d4\u05d0\u05d1\u05d7\u05e0\u05d5\u05ea, \u05d9\u05e9 \u05dc\u05ea\u05ea \u05e8\u05e7 \u05d0\u05ea \u05d0\u05d1\u05d7\u05e0\u05ea DMDD",
          "isCorrect": true,
          "rationale": "\u05d4-DSM \u05e7\u05d5\u05d1\u05e2 \u05e9-DMDD \u05d5-ODD \u05d0\u05d9\u05e0\u05df \u05d9\u05db\u05d5\u05dc\u05d5\u05ea \u05dc\u05d4\u05d9\u05e0\u05ea\u05df \u05d9\u05d7\u05d3\u05d9\u05d5; \u05d1\u05de\u05e7\u05e8\u05d4 \u05e9\u05dc \u05d7\u05e4\u05d9\u05e4\u05d4, DMDD \u05de\u05e7\u05d1\u05dc\u05ea \u05e2\u05d3\u05d9\u05e4\u05d5\u05ea. (DSM p.178)"
        },
        {
          "text": "\u05e0\u05d9\u05ea\u05df \u05dc\u05d0\u05d1\u05d7\u05df \u05d0\u05ea \u05e9\u05ea\u05d9\u05d4\u05df \u05d1\u05de\u05e7\u05d1\u05d9\u05dc \u05d0\u05dd \u05ea\u05e1\u05de\u05d9\u05e0\u05d9 \u05d4-ODD \u05e7\u05d3\u05de\u05d5 \u05dc-DMDD",
          "isCorrect": false,
          "rationale": "\u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05e9\u05dc DMDD \u05e9\u05d5\u05dc\u05dc\u05d9\u05dd \u05d0\u05d1\u05d7\u05e0\u05d4 \u05de\u05e7\u05d1\u05d9\u05dc\u05d4 \u05e9\u05dc ODD \u05dc\u05dc\u05d0 \u05e7\u05e9\u05e8 \u05dc\u05e1\u05d3\u05e8 \u05d4\u05d5\u05e4\u05e2\u05ea \u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd. (DSM p.182)"
        },
        {
          "text": "ODD \u05d4\u05d9\u05d0 \u05d0\u05d1\u05d7\u05e0\u05d4 \u05d7\u05de\u05d5\u05e8\u05d4 \u05d9\u05d5\u05ea\u05e8 \u05d5\u05dc\u05db\u05df \u05d4\u05d9\u05d0 \u05de\u05d1\u05d8\u05dc\u05ea \u05d0\u05ea \u05d0\u05d1\u05d7\u05e0\u05ea \u05d4-DMDD",
          "isCorrect": false,
          "rationale": "DMDD \u05e0\u05d7\u05e9\u05d1\u05ea \u05dc\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05db\u05d5\u05dc\u05dc\u05ea \u05de\u05e8\u05db\u05d9\u05d1 \u05de\u05e6\u05d1 \u05e8\u05d5\u05d7 \u05d7\u05de\u05d5\u05e8 \u05d9\u05d5\u05ea\u05e8 \u05d5\u05dc\u05db\u05df \u05d4\u05d9\u05d0 \u05d6\u05d5 \u05e9\u05e0\u05d9\u05ea\u05e0\u05ea. (DSM p.181)"
        },
        {
          "text": "\u05d4\u05df \u05d9\u05db\u05d5\u05dc\u05d5\u05ea \u05dc\u05d4\u05ea\u05e7\u05d9\u05d9\u05dd \u05d9\u05d7\u05d3 \u05e8\u05e7 \u05d0\u05dd \u05d4\u05ea\u05e4\u05e8\u05e6\u05d5\u05d9\u05d5\u05ea \u05d4\u05d6\u05e2\u05dd \u05de\u05d5\u05e4\u05e0\u05d5\u05ea \u05db\u05dc\u05e4\u05d9 \u05d0\u05d7\u05d9\u05dd \u05d1\u05dc\u05d1\u05d3",
          "isCorrect": false,
          "rationale": "\u05d0\u05d1\u05d7\u05e0\u05ea ODD \u05d3\u05d5\u05e8\u05e9\u05ea \u05e9\u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d9\u05d5\u05e4\u05e2\u05dc\u05d5 \u05db\u05dc\u05e4\u05d9 \u05d0\u05d3\u05dd \u05e9\u05d0\u05d9\u05e0\u05d5 \u05d0\u05d7, \u05d0\u05da \u05d7\u05d5\u05e7 \u05d4\u05d4\u05d7\u05e8\u05d2\u05d4 \u05e9\u05dc DMDD \u05d7\u05dc \u05d1\u05db\u05dc \u05de\u05e7\u05e8\u05d4. (Dulcan p.267)"
        }
      ],
      "hint": "\u05d7\u05e4\u05e9 \u05d0\u05ea \u05d4\u05db\u05dc\u05dc \u05d4\u05d0\u05d1\u05d7\u05e0\u05ea\u05d9 \u05dc\u05d2\u05d1\u05d9 \u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9'\u05d1\u05d5\u05dc\u05e2\u05ea' \u05d0\u05d1\u05d7\u05e0\u05d4 \u05d0\u05d7\u05e8\u05ea \u05db\u05e9\u05d9\u05e9 \u05d7\u05e4\u05d9\u05e4\u05d4 \u05d1\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd."
    },
    {
      "question": "\u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05e2\u05e8\u05db\u05ea \u05d0\u05d5\u05d1\u05d3\u05e0\u05d5\u05ea \u05d1\u05de\u05d9\u05d5\u05df (ED), \u05de\u05d4\u05dd '\u05d2\u05d5\u05e8\u05de\u05d9 \u05d4\u05d4\u05d2\u05e0\u05d4' (Protective factors) \u05d4\u05e2\u05e9\u05d5\u05d9\u05d9\u05dd \u05dc\u05d4\u05e4\u05d7\u05d9\u05ea \u05d0\u05ea \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05d1\u05d9\u05e6\u05d5\u05e2 \u05e0\u05d9\u05e1\u05d9\u05d5\u05df \u05e0\u05d5\u05e1\u05e3 \u05d1\u05e7\u05e8\u05d1 \u05d1\u05e0\u05d9 \u05e0\u05d5\u05e2\u05e8?",
      "answerOptions": [
        {
          "text": "\u05ea\u05d7\u05d5\u05e9\u05ea \u05d0\u05d7\u05e8\u05d9\u05d5\u05ea \u05db\u05dc\u05e4\u05d9 \u05de\u05e9\u05e4\u05d7\u05d4 \u05d5\u05d7\u05d1\u05e8\u05d9\u05dd, \u05d0\u05de\u05d5\u05e0\u05d5\u05ea \u05d3\u05ea\u05d9\u05d5\u05ea \u05d5\u05de\u05d9\u05d5\u05de\u05e0\u05d5\u05d9\u05d5\u05ea \u05d4\u05ea\u05de\u05d5\u05d3\u05d3\u05d5\u05ea",
          "isCorrect": true,
          "rationale": "\u05d2\u05d5\u05e8\u05de\u05d9 \u05d4\u05d2\u05e0\u05d4 \u05db\u05d5\u05dc\u05dc\u05d9\u05dd \u05e7\u05e9\u05e8\u05d9\u05dd \u05ea\u05d5\u05de\u05db\u05d9\u05dd, \u05ea\u05d7\u05d5\u05e9\u05ea \u05de\u05d7\u05d5\u05d9\u05d1\u05d5\u05ea \u05d7\u05d1\u05e8\u05ea\u05d9\u05ea/\u05de\u05e9\u05e4\u05d7\u05ea\u05d9\u05ea \u05d5\u05d9\u05db\u05d5\u05dc\u05ea \u05dc\u05e4\u05ea\u05e8\u05d5\u05df \u05d1\u05e2\u05d9\u05d5\u05ea. (Dulcan p.608)"
        },
        {
