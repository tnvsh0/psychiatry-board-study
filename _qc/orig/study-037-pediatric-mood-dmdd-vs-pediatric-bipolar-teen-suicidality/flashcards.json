{
  "title": "Psychiatry Flashcards",
  "cards": [
    {
      "front": "\u05de\u05d4\u05d5 \u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05d4\u05dc\u05d9\u05d1\u05d4 (Core feature) \u05d4\u05de\u05d1\u05d3\u05d9\u05dc \u05d1\u05d9\u05df \u05d4\u05de\u05d4\u05dc\u05da \u05d4\u05d6\u05de\u05e0\u05d9 \u05e9\u05dc DMDD \u05dc\u05d1\u05d9\u05df \u05d6\u05d4 \u05e9\u05dc Bipolar Disorder \u05e4\u05d3\u05d9\u05d0\u05d8\u05e8\u05d9?",
      "back": "\u05d1-DMDD \u05d4\u05d0\u05d9\u05e8\u05d9\u05d8\u05d1\u05d9\u05dc\u05d9\u05d5\u05ea \u05d4\u05d9\u05d0 \u05db\u05e8\u05d5\u05e0\u05d9\u05ea \u05d5\u05de\u05ea\u05de\u05e9\u05db\u05ea (Nonepisodic), \u05d1\u05e2\u05d5\u05d3 \u05e9\u05d1-Bipolar Disorder \u05de\u05d3\u05d5\u05d1\u05e8 \u05d1\u05de\u05d7\u05dc\u05d4 \u05d0\u05e4\u05d9\u05d6\u05d5\u05d3\u05d9\u05ea (Episodic) \u05e2\u05dd \u05e9\u05d9\u05e0\u05d5\u05d9 \u05d1\u05e8\u05d5\u05e8 \u05de\u05de\u05e6\u05d1 \u05d4\u05d1\u05e1\u05d9\u05e1 (DSM p.181)."
    },
    {
      "front": "\u05dc\u05e4\u05d9 \u05d4-DSM-5-TR, \u05de\u05d4\u05d5 \u05d8\u05d5\u05d5\u05d7 \u05d4\u05d2\u05d9\u05dc\u05d9\u05dd \u05e9\u05d1\u05d5 \u05e0\u05d9\u05ea\u05df \u05dc\u05d0\u05d1\u05d7\u05df \u05dc\u05e8\u05d0\u05e9\u05d5\u05e0\u05d4 DMDD?",
      "back": "\u05d1\u05d9\u05df \u05d2\u05d9\u05dc 6 \u05e9\u05e0\u05d9\u05dd \u05dc\u05d1\u05d9\u05df \u05d2\u05d9\u05dc 18 \u05e9\u05e0\u05d9\u05dd (DSM p.178)."
    },
    {
      "front": "\u05e0\u05e2\u05e8 \u05d4\u05e2\u05d5\u05de\u05d3 \u05d1\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05d4\u05df \u05e9\u05dc DMDD \u05d5\u05d4\u05df \u05e9\u05dc Oppositional Defiant Disorder (ODD). \u05de\u05d4 \u05ea\u05d4\u05d9\u05d4 \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05e0\u05db\u05d5\u05e0\u05d4?",
      "back": "DMDD \u05d1\u05dc\u05d1\u05d3 (DSM p.178)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05d2\u05d9\u05dc \u05d4\u05de\u05e7\u05e1\u05d9\u05de\u05dc\u05d9 \u05dc\u05d4\u05d5\u05e4\u05e2\u05ea \u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd (Onset) \u05d4\u05e0\u05d3\u05e8\u05e9 \u05dc\u05e6\u05d5\u05e8\u05da \u05d0\u05d1\u05d7\u05e0\u05ea DMDD?",
      "back": "\u05dc\u05e4\u05e0\u05d9 \u05d2\u05d9\u05dc 10 \u05e9\u05e0\u05d9\u05dd (DSM p.178)."
    },
    {
      "front": "\u05de\u05d4\u05dd \u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d4\u05e7\u05dc\u05d0\u05e1\u05d9\u05d9\u05dd \u05e9\u05dc \u05de\u05d0\u05e0\u05d9\u05d4 \u05d4\u05de\u05d5\u05e4\u05d9\u05e2\u05d9\u05dd \u05d1-Bipolar Disorder \u05d0\u05da \u05d0\u05d9\u05e0\u05dd \u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9\u05dd DMDD?",
      "back": "\u05de\u05e6\u05d1 \u05e8\u05d5\u05d7 \u05de\u05e8\u05d5\u05de\u05dd (Elevated mood), \u05d0\u05e7\u05e1\u05e4\u05e0\u05e1\u05d9\u05d1\u05d9\u05d5\u05ea, \u05d2\u05e8\u05e0\u05d3\u05d9\u05d5\u05d6\u05d9\u05d5\u05ea (Grandiosity) \u05d5\u05d9\u05e8\u05d9\u05d3\u05d4 \u05d1\u05e6\u05d5\u05e8\u05da \u05d1\u05e9\u05d9\u05e0\u05d4 (DSM p.181)."
    },
    {
      "front": "\u05d1\u05de\u05e2\u05e7\u05d1 \u05d0\u05e8\u05d5\u05da \u05d8\u05d5\u05d5\u05d7, \u05de\u05d4\u05d5 \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05d4\u05e2\u05d9\u05e7\u05e8\u05d9 \u05e9\u05dc \u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd DMDD \u05d1\u05d1\u05d2\u05e8\u05d5\u05ea\u05dd?",
      "back": "\u05e1\u05d9\u05db\u05d5\u05df \u05de\u05d5\u05d2\u05d1\u05e8 \u05dc\u05e4\u05ea\u05d7 Unipolar Depression (\u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05d7\u05d3-\u05e7\u05d5\u05d8\u05d1\u05d9) \u05d5/\u05d0\u05d5 Anxiety Disorders (DSM p.179)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05de\u05d7\u05e9\u05d1\u05d5\u05ea \u05d0\u05d5\u05d1\u05d3\u05e0\u05d9\u05d5\u05ea (Suicidal ideation) \u05d1\u05e7\u05e8\u05d1 \u05ea\u05dc\u05de\u05d9\u05d3\u05d9 \u05ea\u05d9\u05db\u05d5\u05df \u05d1\u05d0\u05e8\u05d4\"\u05d1 \u05dc\u05e4\u05d9 \u05e0\u05ea\u05d5\u05e0\u05d9 \u05d4-CDC?",
      "back": "\u05d1\u05d9\u05df $15\\%$ \u05dc-$20\\%$ \u05de\u05ea\u05dc\u05de\u05d9\u05d3\u05d9 \u05d4\u05ea\u05d9\u05db\u05d5\u05df \u05d3\u05d9\u05d5\u05d5\u05d7\u05d5 \u05e2\u05dc \u05de\u05d7\u05e9\u05d1\u05d5\u05ea \u05d0\u05d5\u05d1\u05d3\u05e0\u05d9\u05d5\u05ea \u05e8\u05e6\u05d9\u05e0\u05d9\u05d5\u05ea \u05d1\u05e9\u05e0\u05d4 \u05d4\u05d0\u05d7\u05e8\u05d5\u05e0\u05d4 (StahlKids p.15)."
    },
    {
      "front": "\u05dc\u05e4\u05d9 \u05e0\u05ea\u05d5\u05e0\u05d9 \u05d4-CDC, \u05d0\u05d9\u05d6\u05d4 \u05d0\u05d7\u05d5\u05d6 \u05de\u05ea\u05dc\u05de\u05d9\u05d3\u05d9 \u05d4\u05ea\u05d9\u05db\u05d5\u05df \u05d1\u05d9\u05e6\u05e2\u05d5 \u05e0\u05d9\u05e1\u05d9\u05d5\u05df \u05d0\u05d5\u05d1\u05d3\u05e0\u05d9 \u05d1\u05e9\u05e0\u05d4 \u05d4\u05d0\u05d7\u05e8\u05d5\u05e0\u05d4?",
      "back": "\u05d1\u05d9\u05df $8\\%$ \u05dc-$10\\%$ (StahlKids p.15)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05de\u05de\u05e6\u05d0 \u05d4\u05e0\u05d5\u05d9\u05e8\u05d5\u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d1-DTI \u05d4\u05de\u05d1\u05d3\u05d9\u05dc \u05d1\u05d9\u05df DMDD \u05dc\u05d1\u05d9\u05df Bipolar Disorder \u05e4\u05d3\u05d9\u05d0\u05d8\u05e8\u05d9?",
      "back": "\u05d1-DMDD \u05e0\u05de\u05e6\u05d0\u05d4 \u05e4\u05d2\u05d9\u05e2\u05d4 \u05de\u05de\u05d5\u05e7\u05d3\u05ea \u05d1\u05d7\u05d5\u05de\u05e8 \u05d4\u05dc\u05d1\u05df (Reduced fractional anisotropy), \u05d1\u05e2\u05d5\u05d3 \u05e9\u05d1-Bipolar Disorder \u05e0\u05de\u05e6\u05d0 \u05e9\u05d9\u05e0\u05d5\u05d9 \u05e0\u05e8\u05d7\u05d1 \u05d1\u05ea\u05d4\u05dc\u05d9\u05da \u05d4\u05de\u05d9\u05d0\u05dc\u05d9\u05e0\u05d9\u05d6\u05e6\u05d9\u05d4 (Altered myelination) (Dulcan p.290)."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05de\u05e9\u05e4\u05d9\u05e2 \u05e8\u05e7\u05e2 \u05de\u05e9\u05e4\u05d7\u05ea\u05d9 (Family history) \u05e2\u05dc \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05de\u05d1\u05d3\u05dc\u05ea \u05d1\u05d9\u05df DMDD \u05dc-Bipolar Disorder?",
      "back": "\u05dc\u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd Bipolar Disorder \u05d9\u05e9 \u05e9\u05d9\u05e2\u05d5\u05e8 \u05d2\u05d1\u05d5\u05d4 \u05d9\u05d5\u05ea\u05e8 \u05e9\u05dc \u05e7\u05e8\u05d5\u05d1\u05d9 \u05de\u05e9\u05e4\u05d7\u05d4 \u05e2\u05dd \u05d4\u05e4\u05e8\u05e2\u05d4 \u05d3\u05d5-\u05e7\u05d5\u05d8\u05d1\u05d9\u05ea (\u05e7\u05d5\u05d8\u05d1 \u05e6\u05e4\u05d5\u05e0\u05d9) \u05d1\u05d4\u05e9\u05d5\u05d5\u05d0\u05d4 \u05dc\u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd DMDD (DSM p.179)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05d0\u05d6\u05d4\u05e8\u05d4 \u05d4\u05de\u05e8\u05db\u05d6\u05d9\u05ea (Black box warning) \u05d1\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1-SSRI \u05d1\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Pediatric MDD?",
      "back": "\u05e2\u05dc\u05d9\u05d9\u05d4 \u05d1\u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05de\u05d7\u05e9\u05d1\u05d5\u05ea \u05d5\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d0\u05d5\u05d1\u05d3\u05e0\u05d9\u05ea (Suicidality) \u05d1\u05e7\u05e8\u05d1 \u05d9\u05dc\u05d3\u05d9\u05dd, \u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd \u05d5\u05e6\u05e2\u05d9\u05e8\u05d9\u05dd (Dulcan p.246)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05e7\u05d5 \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc\u05d9 \u05d4\u05e8\u05d0\u05e9\u05d5\u05df \u05d4\u05de\u05d5\u05de\u05dc\u05e5 \u05dc-DMDD?",
      "back": "\u05d4\u05ea\u05e2\u05e8\u05d1\u05d5\u05d9\u05d5\u05ea \u05e4\u05e1\u05d9\u05db\u05d5\u05ea\u05e8\u05e4\u05d9\u05d5\u05ea \u05db\u05d2\u05d5\u05df Behavioral Parent Training (BPT) \u05d5\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05e7\u05d5\u05de\u05d5\u05e8\u05d1\u05d9\u05d3\u05d9\u05d9\u05dd (Dulcan p.268)."
    },
    {
      "front": "\u05d1\u05d8\u05d9\u05e4\u05d5\u05dc \u05ea\u05e8\u05d5\u05e4\u05ea\u05d9 \u05d1-DMDD \u05e2\u05dd ADHD \u05e7\u05d5\u05de\u05d5\u05e8\u05d1\u05d9\u05d3\u05d9, \u05de\u05d4\u05d9 \u05d4\u05de\u05d2\u05d1\u05dc\u05d4 \u05d1\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1-Stimulants?",
      "back": "\u05d4\u05dd \u05e2\u05e9\u05d5\u05d9\u05d9\u05dd \u05e9\u05dc\u05d0 \u05dc\u05d4\u05d9\u05e1\u05d1\u05dc \u05d4\u05d9\u05d8\u05d1 (Poorly tolerated) \u05d5\u05d0\u05d9\u05e0\u05dd \u05de\u05d9\u05d5\u05e2\u05d3\u05d9\u05dd \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05ea\u05e1\u05de\u05d9\u05e0\u05d9 \u05d4\u05dc\u05d9\u05d1\u05d4 \u05e9\u05dc DMDD (StahlKids p.15)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05de\u05e8\u05db\u05d9\u05d1 \u05d4\u05d7\u05e9\u05d5\u05d1 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d1-Safety plan \u05e2\u05d1\u05d5\u05e8 \u05e0\u05e2\u05e8 \u05d0\u05d5\u05d1\u05d3\u05e0\u05d9 \u05de\u05d1\u05d7\u05d9\u05e0\u05ea \u05e1\u05d1\u05d9\u05d1\u05ea \u05d4\u05d1\u05d9\u05ea?",
      "back": "\u05d4\u05d2\u05d1\u05dc\u05ea \u05d0\u05de\u05e6\u05e2\u05d9\u05dd (Means restriction), \u05d1\u05de\u05d9\u05d5\u05d7\u05d3 \u05d4\u05e8\u05d7\u05e7\u05ea \u05db\u05dc\u05d9 \u05e0\u05e9\u05e7 (StahlKids p.292)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4-Timeframe \u05d4\u05de\u05d9\u05e0\u05d9\u05de\u05dc\u05d9 \u05d4\u05e0\u05d3\u05e8\u05e9 \u05dc\u05d4\u05d5\u05e4\u05e2\u05ea \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05dc\u05e6\u05d5\u05e8\u05da \u05d0\u05d1\u05d7\u05e0\u05ea DMDD?",
      "back": "\u05dc\u05e4\u05d7\u05d5\u05ea 12 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd, \u05dc\u05dc\u05d0 \u05ea\u05e7\u05d5\u05e4\u05d4 \u05e9\u05dc \u05de\u05e2\u05dc 3 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05e8\u05e6\u05d5\u05e4\u05d9\u05dd \u05dc\u05dc\u05d0 \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd (DSM p.178)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05ea\u05d3\u05d9\u05e8\u05d5\u05ea \u05d4\u05de\u05d9\u05e0\u05d9\u05de\u05dc\u05d9\u05ea \u05d4\u05e0\u05d3\u05e8\u05e9\u05ea \u05e9\u05dc \u05d4\u05ea\u05e4\u05e8\u05e6\u05d5\u05d9\u05d5\u05ea \u05d6\u05e2\u05dd (Temper outbursts) \u05dc\u05e6\u05d5\u05e8\u05da \u05d0\u05d1\u05d7\u05e0\u05ea DMDD?",
      "back": "\u05d1\u05de\u05de\u05d5\u05e6\u05e2 3 \u05e4\u05e2\u05de\u05d9\u05dd \u05d0\u05d5 \u05d9\u05d5\u05ea\u05e8 \u05d1\u05e9\u05d1\u05d5\u05e2 (DSM p.178)."
    },
    {
      "front": "\u05d1\u05d0\u05d9\u05dc\u05d5 \u05d4\u05d2\u05d3\u05e8\u05d5\u05ea (Settings) \u05d7\u05d9\u05d9\u05d1\u05d9\u05dd \u05dc\u05d4\u05d5\u05e4\u05d9\u05e2 \u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e9\u05dc DMDD?",
      "back": "\u05d1\u05dc\u05e4\u05d7\u05d5\u05ea \u05e9\u05ea\u05d9\u05d9\u05dd \u05de\u05ea\u05d5\u05da \u05e9\u05dc\u05d5\u05e9 \u05d4\u05d2\u05d3\u05e8\u05d5\u05ea (\u05d1\u05d9\u05ea, \u05d1\u05d9\u05ea \u05e1\u05e4\u05e8, \u05e7\u05d1\u05d5\u05e6\u05ea \u05d4\u05e9\u05d5\u05d5\u05d9\u05dd), \u05db\u05d0\u05e9\u05e8 \u05d1\u05d0\u05d7\u05ea \u05de\u05d4\u05df \u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d7\u05d9\u05d9\u05d1\u05d9\u05dd \u05dc\u05d4\u05d9\u05d5\u05ea \u05d7\u05de\u05d5\u05e8\u05d9\u05dd (Severe) (DSM p.178)."
    },
    {
      "front": "\u05de\u05d3\u05d5\u05e2 \u05d4\u05d5\u05db\u05e0\u05e1\u05d4 \u05d0\u05d1\u05d7\u05e0\u05ea DMDD \u05dc-DSM-5?",
      "back": "\u05db\u05d3\u05d9 \u05dc\u05e6\u05de\u05e6\u05dd \u05d0\u05ea \u05d0\u05d1\u05d7\u05e0\u05ea \u05d4\u05d9\u05ea\u05e8 \u05e9\u05dc Bipolar Disorder \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05e9\u05d4\u05e6\u05d9\u05d2\u05d5 \u05d0\u05d9\u05e8\u05d9\u05d8\u05d1\u05d9\u05dc\u05d9\u05d5\u05ea \u05db\u05e8\u05d5\u05e0\u05d9\u05ea \u05dc\u05dc\u05d0 \u05d0\u05e4\u05d9\u05d6\u05d5\u05d3\u05d9\u05d5\u05ea (DSM p.179)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05de\u05d1\u05d3\u05dc\u05ea \u05e9\u05dc DMDD \u05de\u05d5\u05dc Intermittent Explosive Disorder (IED)?",
      "back": "\u05d1-DMDD \u05e0\u05d3\u05e8\u05e9 \u05de\u05e6\u05d1 \u05e8\u05d5\u05d7 \u05d0\u05d9\u05e8\u05d9\u05d8\u05d1\u05d9\u05dc\u05d9/\u05db\u05e2\u05d5\u05e1 \u05de\u05ea\u05de\u05e9\u05da \u05d1\u05d9\u05df \u05d4\u05d4\u05ea\u05e4\u05e8\u05e6\u05d5\u05d9\u05d5\u05ea, \u05d1\u05e2\u05d5\u05d3 \u05e9\u05d1-IED \u05de\u05e6\u05d1 \u05d4\u05e8\u05d5\u05d7 \u05d1\u05d9\u05df \u05d4\u05d4\u05ea\u05e4\u05e8\u05e6\u05d5\u05d9\u05d5\u05ea \u05d0\u05d9\u05e0\u05d5 \u05d1\u05d4\u05db\u05e8\u05d7 \u05d0\u05d9\u05e8\u05d9\u05d8\u05d1\u05d9\u05dc\u05d9 (DSM p.182)."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05e0\u05d1\u05d7\u05d9\u05df \u05d1\u05d9\u05df \u05d0\u05d9\u05e8\u05d9\u05d8\u05d1\u05d9\u05dc\u05d9\u05d5\u05ea \u05e9\u05dc MDD \u05dc\u05d1\u05d9\u05df DMDD?",
      "back": "\u05d1-MDD \u05d4\u05d0\u05d9\u05e8\u05d9\u05d8\u05d1\u05d9\u05dc\u05d9\u05d5\u05ea \u05de\u05d5\u05d2\u05d1\u05dc\u05ea \u05dc\u05d0\u05e4\u05d9\u05d6\u05d5\u05d3\u05ea \u05d4\u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05d1\u05dc\u05d1\u05d3, \u05d1\u05e2\u05d5\u05d3 \u05d1-DMDD \u05d4\u05d9\u05d0 \u05db\u05e8\u05d5\u05e0\u05d9\u05ea \u05d5\u05e7\u05d1\u05d5\u05e2\u05d4 (DSM p.182)."
    },
    {
      "front": "\u05d0\u05d9\u05dc\u05d5 \u05de\u05e6\u05d1\u05d9\u05dd \u05e8\u05e4\u05d5\u05d0\u05d9\u05d9\u05dd/\u05e0\u05d5\u05d9\u05e8\u05d5\u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05d9\u05dd \u05d9\u05db\u05d5\u05dc\u05d9\u05dd \u05dc\u05d7\u05e7\u05d5\u05ea \u05ea\u05e1\u05de\u05d9\u05e0\u05d9 \u05d4\u05ea\u05e4\u05e8\u05e6\u05d5\u05d9\u05d5\u05ea \u05d6\u05e2\u05dd \u05d5\u05d0\u05d9\u05e8\u05d9\u05d8\u05d1\u05d9\u05dc\u05d9\u05d5\u05ea (Medical mimics)?",
      "back": "\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05e4\u05e8\u05db\u05d5\u05e1\u05d9\u05dd (Seizure disorders), \u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd \u05de\u05d8\u05d1\u05d5\u05dc\u05d9\u05d9\u05dd \u05d4\u05d2\u05d5\u05e8\u05de\u05d9\u05dd \u05dc-Delirium, \u05d5\u05e4\u05d2\u05d9\u05e2\u05d5\u05ea \u05e8\u05d0\u05e9 (Dulcan p.594)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4-Level 1 Cross-Cutting Symptom Measure \u05e2\u05d1\u05d5\u05e8 \u05d9\u05dc\u05d3\u05d9\u05dd \u05d1\u05d2\u05d9\u05dc 6-17?",
      "back": "\u05db\u05dc\u05d9 \u05d3\u05d9\u05e8\u05d5\u05d2 \u05e9\u05dc \u05d4\u05d4\u05d5\u05e8\u05d4/\u05d0\u05e4\u05d5\u05d8\u05e8\u05d5\u05e4\u05d5\u05e1 \u05d4\u05de\u05e2\u05e8\u05d9\u05da 12 \u05d3\u05d5\u05de\u05d9\u05d9\u05e0\u05d9\u05dd \u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9\u05d9\u05dd (\u05db\u05d5\u05dc\u05dc \u05d3\u05d9\u05db\u05d0\u05d5\u05df, \u05d0\u05d9\u05e8\u05d9\u05d8\u05d1\u05d9\u05dc\u05d9\u05d5\u05ea \u05d5\u05d0\u05d5\u05d1\u05d3\u05e0\u05d5\u05ea) \u05dc\u05e6\u05d5\u05e8\u05da \u05e1\u05e7\u05e8 \u05e8\u05d0\u05e9\u05d5\u05e0\u05d9 (DSM p.845)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05e1\u05e3 \u05d4\u05d3\u05d9\u05e8\u05d5\u05d2 \u05d1-Level 1 Cross-Cutting Measure \u05d4\u05de\u05e6\u05d3\u05d9\u05e7 \u05d1\u05d9\u05e8\u05d5\u05e8 \u05de\u05e2\u05de\u05d9\u05e7 (Level 2) \u05d1\u05ea\u05d7\u05d5\u05dd \u05d4\u05d0\u05d5\u05d1\u05d3\u05e0\u05d5\u05ea?",
      "back": "\u05db\u05dc \u05d3\u05d9\u05e8\u05d5\u05d2 \u05d4\u05e9\u05d5\u05e0\u05d4 \u05de-\"No\" (\u05db\u05dc\u05d5\u05de\u05e8 \"Yes\" \u05d0\u05d5 \"Don't Know\") \u05de\u05d7\u05d9\u05d9\u05d1 \u05d4\u05e2\u05e8\u05db\u05d4 \u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05de\u05d9\u05d9\u05d3\u05d9\u05ea (DSM p.846)."
    },
    {
      "front": "\u05d1\u05d4\u05e2\u05e8\u05db\u05ea \u05d0\u05d5\u05d1\u05d3\u05e0\u05d5\u05ea \u05d1\u05e0\u05e2\u05e8, \u05de\u05d4 \u05db\u05d5\u05dc\u05dc \u05d4-Assessment \u05e9\u05dc \u05d4-\"Method\"?",
      "back": "\u05d1\u05d3\u05d9\u05e7\u05ea \u05d4\u05de\u05d4\u05d9\u05e8\u05d5\u05ea, \u05d4\u05d6\u05de\u05d9\u05e0\u05d5\u05ea \u05d5\u05d4\u05e7\u05d8\u05dc\u05e0\u05d9\u05d5\u05ea (Lethality) \u05e9\u05dc \u05d4\u05d0\u05de\u05e6\u05e2\u05d9 \u05e9\u05d1\u05d5 \u05d4\u05e0\u05e2\u05e8 \u05de\u05ea\u05db\u05e0\u05df \u05dc\u05d4\u05e9\u05ea\u05de\u05e9 (Dulcan p.554)."
    },
    {
      "front": "\u05de\u05d4 \u05d4\u05d4\u05d1\u05d3\u05dc \u05d1\u05d9\u05df \u05de\u05d7\u05e9\u05d1\u05d5\u05ea \u05d0\u05d5\u05d1\u05d3\u05e0\u05d9\u05d5\u05ea (Ideation) \u05dc\u05d1\u05d9\u05df \u05db\u05d5\u05d5\u05e0\u05d4 (Intent) \u05d1\u05d4\u05e2\u05e8\u05db\u05ea \u05e1\u05d9\u05db\u05d5\u05df?",
      "back": "\u05de\u05d7\u05e9\u05d1\u05d5\u05ea \u05d4\u05df \u05d4\u05e2\u05d9\u05e1\u05d5\u05e7 \u05d1\u05e8\u05e2\u05d9\u05d5\u05df, \u05d1\u05e2\u05d5\u05d3 \u05db\u05d5\u05d5\u05e0\u05d4 \u05de\u05e9\u05e7\u05e4\u05ea \u05d4\u05d7\u05dc\u05d8\u05d4 \u05d0\u05e7\u05d8\u05d9\u05d1\u05d9\u05ea \u05d5\u05e8\u05e6\u05d5\u05df \u05dc\u05d4\u05d5\u05e6\u05d9\u05d0 \u05d0\u05ea \u05d4\u05ea\u05d5\u05db\u05e0\u05d9\u05ea \u05dc\u05e4\u05d5\u05e2\u05dc (Dulcan p.554)."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05ea\u05e1\u05de\u05d9\u05e0\u05d9 PTSD \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05de\u05ea\u05d7\u05ea \u05dc\u05d2\u05d9\u05dc 6 \u05e9\u05e0\u05d9\u05dd \u05e2\u05e9\u05d5\u05d9\u05d9\u05dd \u05dc\u05d7\u05e7\u05d5\u05ea DMDD \u05d0\u05d5 ODD?",
      "back": "\u05d4\u05dd \u05e2\u05e9\u05d5\u05d9\u05d9\u05dd \u05dc\u05d4\u05e6\u05d9\u05d2 \u05d0\u05d9-\u05d5\u05d9\u05e1\u05d5\u05ea \u05e8\u05d2\u05e9\u05d9, \u05d4\u05ea\u05e4\u05e8\u05e6\u05d5\u05d9\u05d5\u05ea \u05d6\u05e2\u05dd, \u05d4\u05ea\u05e0\u05d2\u05d3\u05d5\u05ea \u05d5\u05d0\u05d9\u05e8\u05d9\u05d8\u05d1\u05d9\u05dc\u05d9\u05d5\u05ea \u05db\u05ea\u05d2\u05d5\u05d1\u05d4 \u05dc\u05d8\u05e8\u05d0\u05d5\u05de\u05d4 (Dulcan p.355)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05ea\u05e4\u05e7\u05d9\u05d3 \u05d4-Safety plan \u05d1\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05e0\u05e2\u05e8 \u05d0\u05d5\u05d1\u05d3\u05e0\u05d9?",
      "back": "\u05de\u05ea\u05df \u05db\u05dc\u05d9\u05dd \u05dc\u05d6\u05d9\u05d4\u05d5\u05d9 \u05e1\u05d9\u05de\u05e0\u05d9 \u05d0\u05d6\u05d4\u05e8\u05d4, \u05d0\u05e1\u05d8\u05e8\u05d8\u05d2\u05d9\u05d5\u05ea \u05d4\u05ea\u05de\u05d5\u05d3\u05d3\u05d5\u05ea \u05e4\u05e0\u05d9\u05de\u05d9\u05d5\u05ea, \u05d5\u05d9\u05e6\u05d9\u05e8\u05ea \u05e8\u05e9\u05d9\u05de\u05ea \u05e7\u05e9\u05e8 \u05dc\u05e2\u05d6\u05e8\u05d4 \u05de\u05e7\u05e6\u05d5\u05e2\u05d9\u05ea \u05d5\u05d7\u05d1\u05e8\u05ea\u05d9\u05ea \u05d1\u05d6\u05de\u05df \u05de\u05e9\u05d1\u05e8 (Dulcan p.565)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d4\u05de\u05d5\u05e2\u05e8\u05db\u05ea \u05e9\u05dc DMDD \u05d1\u05e7\u05e8\u05d1 \u05d9\u05dc\u05d3\u05d9\u05dd \u05d4\u05de\u05d2\u05d9\u05e2\u05d9\u05dd \u05dc\u05de\u05e8\u05e4\u05d0\u05d5\u05ea \u05d1\u05e8\u05d9\u05d0\u05d5\u05ea \u05d4\u05e0\u05e4\u05e9 \u05e4\u05d3\u05d9\u05d0\u05d8\u05e8\u05d9\u05d5\u05ea?",
      "back": "\u05d4\u05e4\u05e8\u05e2\u05d4 \u05d6\u05d5 \u05e0\u05d7\u05e9\u05d1\u05ea \u05dc\u05e0\u05e4\u05d5\u05e6\u05d4 (Common) \u05d1\u05e7\u05e8\u05d1 \u05e7\u05dc\u05d9\u05e0\u05d9\u05e7\u05d5\u05ea \u05d0\u05dc\u05d5, \u05e2\u05dd \u05d4\u05e2\u05e8\u05db\u05d5\u05ea \u05d1\u05e7\u05d4\u05d9\u05dc\u05d4 \u05e9\u05e0\u05e2\u05d5\u05ea \u05e1\u05d1\u05d9\u05d1 $0.8\\%$ \u05e2\u05d3 $3.3\\%$ (DSM p.179, Dulcan p.268)."
    },
    {
      "front": "\u05dc\u05e4\u05d9 \u05de\u05d7\u05e7\u05e8\u05d9 \u05d4-NIMH \u05e2\u05dc Severe Mood Dysregulation (SMD), \u05de\u05d4\u05d9 \u05d4\u05e7\u05d5\u05de\u05d5\u05e8\u05d1\u05d9\u05d3\u05d9\u05d5\u05ea \u05d4\u05e9\u05db\u05d9\u05d7\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8?",
      "back": "\u05dc\u05e8\u05d5\u05d1 \u05d4\u05de\u05d5\u05d7\u05dc\u05d8 ($100\\%$) \u05d9\u05e9 \u05e7\u05d5\u05de\u05d5\u05e8\u05d1\u05d9\u05d3\u05d9\u05d5\u05ea \u05e2\u05dd ADHD \u05d5/\u05d0\u05d5 ODD (Dulcan p.268)."
    },
    {
      "front": "\u05de\u05d4\u05dd \u05d4-Predictors \u05d4\u05e2\u05d9\u05e7\u05e8\u05d9\u05d9\u05dd \u05dc\u05de\u05e2\u05d1\u05e8 \u05de-MDD \u05dc-Bipolar Disorder \u05d1\u05e7\u05e8\u05d1 \u05e0\u05d5\u05e2\u05e8?",
      "back": "\u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9, \u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4 \u05de\u05e9\u05e4\u05d7\u05ea\u05d9\u05ea \u05e9\u05dc \u05d4\u05e4\u05e8\u05e2\u05d4 \u05d3\u05d5-\u05e7\u05d5\u05d8\u05d1\u05d9\u05ea (\u05e7\u05d5\u05d8\u05d1 \u05e6\u05e4\u05d5\u05e0\u05d9), \u05d5\u05de\u05d0\u05e0\u05d9\u05d4/\u05d4\u05d9\u05e4\u05d5\u05de\u05d0\u05e0\u05d9\u05d4 \u05de\u05d5\u05e9\u05e8\u05d9\u05ea \u05ea\u05e8\u05d5\u05e4\u05ea\u05d9\u05ea (Dulcan p.254)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05de\u05d2\u05d3\u05e8 (Sex) \u05d4\u05e9\u05db\u05d9\u05d7 \u05d9\u05d5\u05ea\u05e8 \u05d1-DMDD \u05dc\u05e4\u05d9 \u05d3\u05d2\u05d9\u05de\u05d5\u05ea \u05e7\u05dc\u05d9\u05e0\u05d9\u05d5\u05ea?",
      "back": "\u05d9\u05e9\u05e0\u05d4 \u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d2\u05d1\u05d5\u05d4\u05d4 \u05d9\u05d5\u05ea\u05e8 \u05d1\u05e7\u05e8\u05d1 \u05d1\u05e0\u05d9\u05dd (Male preponderance) (DSM p.179)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05d4\u05e0\u05d7\u05d9\u05d4 \u05dc\u05d2\u05d1\u05d9 \u05d0\u05d1\u05d7\u05e0\u05ea DMDD \u05d5-Intermittent Explosive Disorder (IED)?",
      "back": "\u05e9\u05ea\u05d9 \u05d4\u05d0\u05d1\u05d7\u05e0\u05d5\u05ea \u05dc\u05d0 \u05d9\u05db\u05d5\u05dc\u05d5\u05ea \u05dc\u05d4\u05d9\u05e0\u05ea\u05df \u05d9\u05d7\u05d3; \u05d0\u05dd \u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05dc\u05e9\u05e0\u05d9\u05d4\u05dd \u05de\u05ea\u05e7\u05d9\u05d9\u05de\u05d9\u05dd, \u05ea\u05d9\u05e0\u05ea\u05df \u05d0\u05d1\u05d7\u05e0\u05ea DMDD \u05d1\u05dc\u05d1\u05d3 (DSM p.182)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4-Differential Diagnosis \u05d4\u05e7\u05e8\u05d9\u05d8\u05d9 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05e9\u05d9\u05e9 \u05dc\u05e9\u05dc\u05d5\u05dc \u05dc\u05e4\u05e0\u05d9 \u05d0\u05d1\u05d7\u05e0\u05ea DMDD?",
      "back": "\u05e7\u05d9\u05d5\u05de\u05d4 \u05e9\u05dc \u05d0\u05e4\u05d9\u05d6\u05d5\u05d3\u05d4 \u05de\u05d0\u05e0\u05d9\u05ea \u05d0\u05d5 \u05d4\u05d9\u05e4\u05d5\u05de\u05d0\u05e0\u05d9\u05ea \u05d1\u05e2\u05d1\u05e8 \u05d0\u05d5 \u05d1\u05d4\u05d5\u05d5\u05d4 (DSM p.178)."
    },
    {
      "front": "\u05d4\u05d0\u05dd \u05e0\u05d9\u05ea\u05df \u05dc\u05d0\u05d1\u05d7\u05df DMDD \u05d1\u05d9\u05dc\u05d3 \u05e2\u05dd Autism Spectrum Disorder (ASD)?",
      "back": "\u05dc\u05d0, \u05d0\u05dd \u05d4\u05ea\u05e4\u05e8\u05e6\u05d5\u05d9\u05d5\u05ea \u05d4\u05d6\u05e2\u05dd \u05de\u05d5\u05e1\u05d1\u05e8\u05d5\u05ea \u05d8\u05d5\u05d1 \u05d9\u05d5\u05ea\u05e8 \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d4\u05e4\u05e8\u05e2\u05d4 \u05d1\u05e8\u05e6\u05e3 \u05d4\u05d0\u05d5\u05d8\u05d9\u05e1\u05d8\u05d9 (\u05dc\u05de\u05e9\u05dc, \u05e2\u05e7\u05d1 \u05e9\u05d9\u05e0\u05d5\u05d9 \u05d1\u05e9\u05d2\u05e8\u05d4) (DSM p.182)."
    },
    {
      "front": "\u05d0\u05d9\u05d6\u05d4 \u05d8\u05d9\u05e4\u05d5\u05dc \u05e4\u05e1\u05d9\u05db\u05d5\u05ea\u05e8\u05e4\u05d9 \u05d4\u05e8\u05d0\u05d4 \u05d9\u05e2\u05d9\u05dc\u05d5\u05ea \u05d1\u05d4\u05e4\u05d7\u05ea\u05ea \u05e0\u05d9\u05e1\u05d9\u05d5\u05e0\u05d5\u05ea \u05d0\u05d5\u05d1\u05d3\u05e0\u05d5\u05ea \u05d5-NSSI \u05d1\u05e7\u05e8\u05d1 \u05e0\u05d5\u05e2\u05e8?",
      "back": "Dialectical Behavior Therapy (DBT) \u05d4\u05de\u05d5\u05ea\u05d0\u05dd \u05dc\u05e0\u05d5\u05e2\u05e8 (Dulcan p.565)."
    },
    {
      "front": "\u05de\u05d4 \u05db\u05d5\u05dc\u05dc\u05ea \u05d4\u05e2\u05e8\u05db\u05ea \u05d4-\"Intent\" \u05d1\u05d0\u05d5\u05d1\u05d3\u05e0\u05d5\u05ea?",
      "back": "\u05d1\u05d3\u05d9\u05e7\u05ea \u05d4\u05e8\u05e6\u05d5\u05df \u05d4\u05e1\u05d5\u05d1\u05d9\u05d9\u05e7\u05d8\u05d9\u05d1\u05d9 \u05dc\u05de\u05d5\u05ea \u05d5\u05d4\u05de\u05d9\u05d3\u05d4 \u05e9\u05d1\u05d4 \u05d4\u05e0\u05e2\u05e8 \u05de\u05d0\u05de\u05d9\u05df \u05e9\u05d4\u05e9\u05d9\u05d8\u05d4 \u05e9\u05d1\u05d7\u05e8 \u05ea\u05d5\u05d1\u05d9\u05dc \u05dc\u05de\u05d5\u05d5\u05ea (Dulcan p.554)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05d7\u05e9\u05d9\u05d1\u05d5\u05ea \u05e9\u05dc \u05d1\u05d9\u05e8\u05d5\u05e8 \u05d4-\"Access to means\" \u05d1\u05e0\u05e2\u05e8 \u05e2\u05dd \u05de\u05d7\u05e9\u05d1\u05d5\u05ea \u05d0\u05d5\u05d1\u05d3\u05df?",
      "back": "\u05d6\u05de\u05d9\u05e0\u05d5\u05ea \u05d4\u05d0\u05de\u05e6\u05e2\u05d9 (\u05db\u05de\u05d5 \u05e0\u05e9\u05e7 \u05d1\u05d1\u05d9\u05ea \u05d0\u05d5 \u05ea\u05e8\u05d5\u05e4\u05d5\u05ea) \u05de\u05e2\u05dc\u05d4 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05d0\u05ea \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05de\u05e2\u05d1\u05e8 \u05de\u05de\u05d7\u05e9\u05d1\u05d4 \u05dc\u05d1\u05d9\u05e6\u05d5\u05e2 (StahlKids p.292)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d2\u05d9\u05dc \u05d4\u05de\u05d9\u05e0\u05d9\u05de\u05d5\u05dd \u05dc\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea DMDD \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR?",
      "back": "\u05dc\u05d0 \u05e0\u05d9\u05ea\u05df \u05dc\u05ea\u05ea \u05d0\u05ea \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05dc\u05d9\u05dc\u05d3\u05d9\u05dd \u05e9\u05d2\u05d9\u05dc\u05dd \u05d4\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9 \u05e0\u05de\u05d5\u05da \u05de-6 \u05e9\u05e0\u05d9\u05dd (DSM p.179)."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05e0\u05d2\u05d3\u05d9\u05e8 \u05d4\u05ea\u05e4\u05e8\u05e6\u05d5\u05ea \u05d6\u05e2\u05dd \u05d1-DMDD \u05dc\u05e4\u05d9 \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df A?",
      "back": "\u05d4\u05ea\u05e4\u05e8\u05e6\u05d5\u05d9\u05d5\u05ea \u05d7\u05de\u05d5\u05e8\u05d5\u05ea \u05d5\u05d7\u05d5\u05d6\u05e8\u05d5\u05ea, \u05de\u05d9\u05dc\u05d5\u05dc\u05d9\u05d5\u05ea \u05d0\u05d5 \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea\u05d9\u05d5\u05ea, \u05e9\u05d0\u05d9\u05e0\u05df \u05e4\u05e8\u05d5\u05e4\u05d5\u05e8\u05e6\u05d9\u05d5\u05e0\u05dc\u05d9\u05d5\u05ea \u05d1\u05e2\u05d5\u05e6\u05de\u05ea\u05df \u05d0\u05d5 \u05d1\u05de\u05e9\u05db\u05df \u05dc\u05e1\u05d9\u05d8\u05d5\u05d0\u05e6\u05d9\u05d4 (DSM p.178)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05de\u05e6\u05d1 \u05d4\u05e8\u05d5\u05d7 \u05d4\u05e0\u05d3\u05e8\u05e9 \u05d1\u05d9\u05df \u05d4\u05ea\u05e4\u05e8\u05e6\u05d5\u05d9\u05d5\u05ea \u05d4\u05d6\u05e2\u05dd \u05d1-DMDD?",
      "back": "\u05de\u05e6\u05d1 \u05e8\u05d5\u05d7 \u05d0\u05d9\u05e8\u05d9\u05d8\u05d1\u05d9\u05dc\u05d9 \u05d0\u05d5 \u05db\u05e2\u05d5\u05e1 \u05e8\u05d5\u05d1 \u05d4\u05d9\u05d5\u05dd, \u05db\u05de\u05e2\u05d8 \u05db\u05dc \u05d9\u05d5\u05dd, \u05d4\u05e0\u05e6\u05e4\u05d4 \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d0\u05d7\u05e8\u05d9\u05dd (DSM p.178)."
    },
    {
      "front": "\u05de\u05d4 \u05d4\u05e7\u05e9\u05e8 \u05d4\u05d2\u05e0\u05d8\u05d9 \u05e9\u05e0\u05de\u05e6\u05d0 \u05e2\u05d1\u05d5\u05e8 DMDD?",
      "back": "\u05e0\u05de\u05e6\u05d0 \u05e7\u05e9\u05e8 \u05dc\u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4 \u05de\u05e9\u05e4\u05d7\u05ea\u05d9\u05ea \u05e9\u05dc \u05d3\u05d9\u05db\u05d0\u05d5\u05df (MDD) \u05d5\u05d7\u05e8\u05d3\u05d4, \u05d5\u05dc\u05d0\u05d5 \u05d3\u05d5\u05d5\u05e7\u05d0 \u05dc\u05d4\u05e4\u05e8\u05e2\u05d4 \u05d3\u05d5-\u05e7\u05d5\u05d8\u05d1\u05d9\u05ea (DSM p.180)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05dc\u05d9\u05e7\u05d5\u05d9 \u05d4\u05e0\u05d5\u05d9\u05e8\u05d5-\u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9 \u05d4\u05de\u05e9\u05d5\u05ea\u05e3 \u05dc-DMDD \u05d5\u05dc-Bipolar Disorder \u05e4\u05d3\u05d9\u05d0\u05d8\u05e8\u05d9?",
      "back": "\u05dc\u05d9\u05e7\u05d5\u05d9\u05d9\u05dd \u05d1\u05d6\u05d9\u05d4\u05d5\u05d9 \u05d4\u05d1\u05e2\u05d5\u05ea \u05e4\u05e0\u05d9\u05dd \u05e8\u05d2\u05e9\u05d9\u05d5\u05ea (Face-emotion labeling deficits) (DSM p.180)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05d4\u05de\u05dc\u05e6\u05d4 \u05dc\u05d2\u05d1\u05d9 \u05e9\u05d9\u05de\u05d5\u05e9 \u05d1-Lithium \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd \u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05e7\u05e9\u05d5\u05ea \u05dc\u05dc\u05d0 \u05d0\u05d1\u05d7\u05e0\u05d4 \u05de\u05d3\u05d5\u05d9\u05e7\u05ea?",
      "back": "\u05d4\u05e9\u05d9\u05de\u05d5\u05e9 \u05d0\u05e1\u05d5\u05e8 \u05dc\u05dc\u05d0 \u05d4\u05e2\u05e8\u05db\u05d4 \u05d0\u05d1\u05d7\u05e0\u05ea\u05d9\u05ea \u05e0\u05d0\u05d5\u05ea\u05d4, \u05d1\u05de\u05d9\u05d5\u05d7\u05d3 \u05d1\u05e7\u05e8\u05d1 \u05d9\u05dc\u05d3\u05d9\u05dd \u05d1\u05e7\u05d1\u05d5\u05e6\u05d5\u05ea \u05e1\u05d9\u05db\u05d5\u05df \u05db\u05de\u05d5 \u05d9\u05dc\u05d3\u05d9 \u05d0\u05d5\u05de\u05e0\u05d4 (StahlKids p.292)."
    },
    {
      "front": "\u05d1\u05d0\u05d9\u05dc\u05d5 \u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05e0\u05d9\u05ea\u05df \u05dc\u05e9\u05e7\u05d5\u05dc \u05e9\u05d9\u05de\u05d5\u05e9 \u05d1-DMDD \u05db\u05d0\u05e9\u05e8 \u05d9\u05e9\u05e0\u05d4 \u05ea\u05d7\u05dc\u05d5\u05d0\u05d4 \u05e0\u05dc\u05d5\u05d5\u05d9\u05ea \u05e9\u05dc \u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d4 \u05d0\u05d5 \u05de\u05d0\u05e0\u05d9\u05d4?",
      "back": "\u05e0\u05d9\u05ea\u05df \u05dc\u05e9\u05e7\u05d5\u05dc Antipsychotics \u05e2\u05d1\u05d5\u05e8 \u05d4\u05e7\u05d5\u05de\u05d5\u05e8\u05d1\u05d9\u05d3\u05d9\u05d5\u05ea, \u05d0\u05da \u05dc\u05d0 \u05db\u05d8\u05d9\u05e4\u05d5\u05dc \u05e8\u05d0\u05e9\u05d5\u05e0\u05d9 \u05dc\u05ea\u05e1\u05de\u05d9\u05e0\u05d9 \u05d4-DMDD \u05e2\u05e6\u05de\u05dd (StahlKids p.266)."
    },
    {
      "front": "\u05e0\u05e2\u05e8 \u05de\u05e6\u05d9\u05d2 \u05d0\u05d9\u05e8\u05d9\u05d8\u05d1\u05d9\u05dc\u05d9\u05d5\u05ea \u05e7\u05d9\u05e6\u05d5\u05e0\u05d9\u05ea \u05e8\u05e7 \u05d1\u05d6\u05de\u05df \u05d0\u05e4\u05d9\u05d6\u05d5\u05d3\u05d4 \u05e9\u05dc MDD. \u05d4\u05d0\u05dd \u05d9\u05d0\u05d5\u05d1\u05d7\u05df \u05d1-DMDD?",
      "back": "\u05dc\u05d0, \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05dc\u05d0 \u05ea\u05d9\u05e0\u05ea\u05df \u05d0\u05dd \u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05de\u05d5\u05e4\u05d9\u05e2\u05d9\u05dd \u05e8\u05e7 \u05d1\u05de\u05d4\u05dc\u05da \u05d0\u05e4\u05d9\u05d6\u05d5\u05d3\u05d4 \u05e9\u05dc MDD (DSM p.178)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4-Prevalence \u05e9\u05dc MDD \u05d1\u05e7\u05e8\u05d1 \u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd?",
      "back": "$4\\%$ \u05e2\u05d3 $8\\%$, \u05e2\u05dd \u05d9\u05d7\u05e1 \u05e9\u05dc $1:2$ \u05dc\u05d8\u05d5\u05d1\u05ea \u05e0\u05e7\u05d1\u05d5\u05ea \u05dc\u05d0\u05d7\u05e8 \u05d2\u05d9\u05dc \u05d4\u05d4\u05ea\u05d1\u05d2\u05e8\u05d5\u05ea (Dulcan p.247)."
    },
    {
      "front": "\u05de\u05d3\u05d5\u05e2 \u05d1\u05d5\u05d8\u05dc \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df \u05d4\u05d4\u05d7\u05e8\u05d2\u05d4 \u05e9\u05dc \u05e9\u05db\u05d5\u05dc (Bereavement) \u05d1\u05d0\u05d1\u05d7\u05e0\u05ea MDD \u05d1-DSM-5?",
      "back": "\u05db\u05d9 \u05e0\u05de\u05e6\u05d0 \u05e9\u05d2\u05d5\u05e8\u05de\u05d9 \u05d4\u05e1\u05d9\u05db\u05d5\u05df, \u05d4\u05e4\u05e0\u05d5\u05de\u05e0\u05d5\u05dc\u05d5\u05d2\u05d9\u05d4 \u05d5\u05d4\u05de\u05d4\u05dc\u05da \u05e9\u05dc \u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05d4\u05e7\u05e9\u05d5\u05e8 \u05dc\u05e9\u05db\u05d5\u05dc \u05d3\u05d5\u05de\u05d9\u05dd \u05dc\u05d0\u05dc\u05d5 \u05e9\u05dc \u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05e9\u05d0\u05d9\u05e0\u05d5 \u05e7\u05e9\u05d5\u05e8 \u05dc\u05e9\u05db\u05d5\u05dc (Dulcan p.247)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4-Differential diagnosis \u05d1\u05d9\u05df Hyperactivity \u05e9\u05dc ADHD \u05dc\u05d1\u05d9\u05df \u05d4\u05de\u05d0\u05e0\u05d9\u05d4 \u05e9\u05dc Bipolar Disorder?",
      "back": "\u05d1-ADHD \u05d4\u05d4\u05d9\u05e4\u05e8-\u05d0\u05e7\u05d8\u05d9\u05d1\u05d9\u05d5\u05ea \u05d4\u05d9\u05d0 \u05db\u05e8\u05d5\u05e0\u05d9\u05ea \u05d5\u05e7\u05d1\u05d5\u05e2\u05d4, \u05d1\u05e2\u05d5\u05d3 \u05e9\u05d1\u05de\u05d0\u05e0\u05d9\u05d4 \u05d4\u05d9\u05d0 \u05d0\u05e4\u05d9\u05d6\u05d5\u05d3\u05d9\u05ea \u05d5\u05de\u05dc\u05d5\u05d5\u05d4 \u05d1\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05e9\u05dc \u05de\u05e6\u05d1 \u05e8\u05d5\u05d7 \u05de\u05e8\u05d5\u05de\u05dd/\u05d2\u05e8\u05e0\u05d3\u05d9\u05d5\u05d6\u05d9\u05d5\u05ea (Dulcan p.176)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05d7\u05e9\u05d9\u05d1\u05d5\u05ea \u05e9\u05dc \u05d1\u05d9\u05e8\u05d5\u05e8 \"Safety plan\" \u05de\u05d5\u05dc \u05d4\u05d4\u05d5\u05e8\u05d9\u05dd?",
      "back": "\u05d4\u05d4\u05d5\u05e8\u05d9\u05dd \u05d7\u05d9\u05d9\u05d1\u05d9\u05dd \u05dc\u05d4\u05d9\u05d5\u05ea \u05e9\u05d5\u05ea\u05e4\u05d9\u05dd \u05d0\u05e7\u05d8\u05d9\u05d1\u05d9\u05d9\u05dd \u05d1\u05d4\u05d2\u05d1\u05dc\u05ea \u05d4\u05d2\u05d9\u05e9\u05d4 \u05dc\u05d0\u05de\u05e6\u05e2\u05d9\u05dd \u05d5\u05d1\u05e0\u05d9\u05d8\u05d5\u05e8 \u05de\u05e6\u05d1\u05d5 \u05e9\u05dc \u05d4\u05e0\u05e2\u05e8 (Dulcan p.686)."
    },
    {
      "front": "\u05de\u05d4 \u05d4\u05e7\u05e9\u05e8 \u05d1\u05d9\u05df \u05d0\u05d5\u05d1\u05d3\u05e0\u05d5\u05ea \u05dc\u05d1\u05d9\u05df \u05e9\u05d9\u05de\u05d5\u05e9 \u05d1-Substances \u05d1\u05e7\u05e8\u05d1 \u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd?",
      "back": "\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1-Substances \u05de\u05e2\u05dc\u05d4 \u05d0\u05ea \u05d4\u05d0\u05d9\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05d5\u05ea \u05d5\u05de\u05d5\u05e8\u05d9\u05d3 \u05e2\u05db\u05d1\u05d5\u05ea, \u05d5\u05d1\u05db\u05da \u05de\u05d4\u05d5\u05d5\u05d4 \u05d2\u05d5\u05e8\u05dd \u05e1\u05d9\u05db\u05d5\u05df \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9 \u05dc\u05d1\u05d9\u05e6\u05d5\u05e2 \u05e0\u05d9\u05e1\u05d9\u05d5\u05df \u05d0\u05d5\u05d1\u05d3\u05e0\u05d9 (Dulcan p.554)."
    }
  ]
}