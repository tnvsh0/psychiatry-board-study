          "isCorrect": true,
          "rationale": "\u05d0\u05d9\u05df \u05ea\u05e8\u05d5\u05e4\u05d4 \u05d4\u05de\u05e8\u05e4\u05d0\u05ea BPD; \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05d5\u05d0 \u05e4\u05e1\u05d9\u05db\u05d5\u05ea\u05e8\u05e4\u05d9 \u05d5\u05d4\u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05e0\u05d5\u05e2\u05d3\u05d5 \u05dc\u05d4\u05e7\u05dc \u05e2\u05dc \u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05d9\u05dd, \u05db\u05d0\u05e9\u05e8 \u05d1\u05e0\u05d6\u05d5\u05d3\u05d9\u05d0\u05d6\u05e4\u05d9\u05e0\u05d9\u05dd \u05d0\u05e1\u05d5\u05e8\u05d9\u05dd \u05d1\u05e9\u05dc \u05e1\u05db\u05e0\u05ea \u05d3\u05d4-\u05d0\u05d9\u05e0\u05d4\u05d9\u05d1\u05d9\u05e6\u05d9\u05d4. (Dulcan p.484, p.685)"
        },
        {
          "text": "\u05de\u05ea\u05df Benzodiazepines (\u05db\u05d2\u05d5\u05df Lorazepam) \u05dc\u05d4\u05e8\u05d2\u05e2\u05d4 \u05de\u05d9\u05d9\u05d3\u05d9\u05ea \u05d1\u05de\u05e6\u05d1\u05d9 \u05d7\u05e8\u05d3\u05d4 \u05d5\u05d0\u05d9\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05d5\u05ea.",
          "isCorrect": false,
          "rationale": "\u05d1\u05e0\u05d6\u05d5\u05d3\u05d9\u05d0\u05d6\u05e4\u05d9\u05e0\u05d9\u05dd \u05e2\u05dc\u05d5\u05dc\u05d9\u05dd \u05dc\u05d4\u05d7\u05de\u05d9\u05e8 \u05d0\u05d9\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05d5\u05ea (Disinhibition) \u05d5\u05dc\u05d4\u05d2\u05d1\u05d9\u05e8 \u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05e0\u05d9\u05e1\u05d9\u05d5\u05e0\u05d5\u05ea \u05d0\u05d5\u05d1\u05d3\u05e0\u05d9\u05d9\u05dd \u05d3\u05e8\u05da OD \u05d1\u05de\u05d8\u05d5\u05e4\u05dc\u05d9 BPD. (Dulcan p.484)"
        },
        {
          "text": "\u05e9\u05d9\u05dc\u05d5\u05d1 \u05e9\u05dc Lithium \u05d5-Valproate \u05db\u05e7\u05d5 \u05e8\u05d0\u05e9\u05d5\u05df \u05dc\u05d9\u05d9\u05e6\u05d5\u05d1 \u05d4\u05de\u05d1\u05e0\u05d4 \u05d4\u05d0\u05d9\u05e9\u05d9\u05d5\u05ea\u05d9.",
          "isCorrect": false,
          "rationale": "\u05de\u05d9\u05d9\u05e6\u05d1\u05d9 \u05de\u05e6\u05d1 \u05e8\u05d5\u05d7 \u05e2\u05e9\u05d5\u05d9\u05d9\u05dd \u05dc\u05e1\u05d9\u05d9\u05e2 \u05d1\u05d0\u05d9\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05d5\u05ea, \u05d0\u05da \u05d4\u05dd \u05d0\u05d9\u05e0\u05dd \u05e7\u05d5 \u05e8\u05d0\u05e9\u05d5\u05df '\u05dc\u05d9\u05d9\u05e6\u05d5\u05d1 \u05d4\u05d0\u05d9\u05e9\u05d9\u05d5\u05ea' \u05d5\u05d4\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05d4\u05dd \u05d4\u05d5\u05d0 \u05de\u05de\u05d5\u05e7\u05d3 \u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05dd. (StahlKids p.501)"
        },
        {
          "text": "\u05de\u05d9\u05e0\u05d5\u05e0\u05d9\u05dd \u05d2\u05d1\u05d5\u05d4\u05d9\u05dd \u05e9\u05dc SSRIs \u05dc\u05de\u05e0\u05d9\u05e2\u05ea \u05d4-Splitting \u05d4\u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05d9.",
          "isCorrect": false,
          "rationale": "SSRIs \u05e2\u05e9\u05d5\u05d9\u05d9\u05dd \u05dc\u05e2\u05d6\u05d5\u05e8 \u05d1\u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05d0\u05d5 \u05d7\u05e8\u05d3\u05d4 \u05e0\u05dc\u05d5\u05d5\u05d9\u05dd, \u05d0\u05da \u05d0\u05d9\u05df \u05dc\u05d4\u05dd \u05d4\u05e9\u05e4\u05e2\u05d4 \u05d9\u05e9\u05d9\u05e8\u05d4 \u05e2\u05dc \u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05d4\u05d2\u05e0\u05d4 \u05e9\u05dc \u05e4\u05d9\u05e6\u05d5\u05dc (Splitting). (Synopsis ch.19 Personality Disorders)"
        }
      ],
      "hint": "\u05d6\u05db\u05d5\u05e8 \u05d0\u05ea \u05d4\u05d0\u05d6\u05d4\u05e8\u05d4 \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05d4\u05d7\u05de\u05d5\u05e8\u05d4 \u05dc\u05d2\u05d1\u05d9 \u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05d4\u05e8\u05d2\u05e2\u05d4 \u05d4\u05de\u05d5\u05e8\u05d9\u05d3\u05d5\u05ea \u05e2\u05db\u05d1\u05d5\u05ea.",
      "source": "(Dulcan p.484, 685)"
    },
    {
      "type": "multiple_choice",
      "question": "\u05d1\u05de\u05e1\u05d2\u05e8\u05ea \u05d4-Alternative DSM-5 Model for Personality Disorders (Section III), \u05de\u05d4\u05dd \u05e9\u05e0\u05d9 \u05d4\u05e8\u05db\u05d9\u05d1\u05d9\u05dd \u05d4\u05de\u05e8\u05db\u05d6\u05d9\u05d9\u05dd \u05d4\u05e0\u05d3\u05e8\u05e9\u05d9\u05dd \u05dc\u05e7\u05d1\u05d9\u05e2\u05ea \u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc Borderline Personality Disorder?",
      "answerOptions": [
        {
          "text": "Moderate or greater impairment \u05d1-Personality functioning (Criterion A) \u05d5\u05e7\u05d9\u05d5\u05dd \u05e9\u05dc Pathological traits \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05d9\u05dd (Criterion B).",
          "isCorrect": true,
          "rationale": "\u05d4\u05de\u05d5\u05d3\u05dc \u05d4\u05de\u05d5\u05d3\u05e8\u05e0\u05d9 \u05de\u05d7\u05d9\u05d9\u05d1 \u05d4\u05e2\u05e8\u05db\u05d4 \u05e9\u05dc \u05e8\u05de\u05ea \u05d4\u05ea\u05e4\u05e7\u05d5\u05d3 \u05d4\u05d0\u05d9\u05e9\u05d9\u05d5\u05ea\u05d9 (\u05e2\u05e6\u05de\u05d9 \u05d5\u05d1\u05d9\u05e0\u05d0\u05d9\u05e9\u05d9) \u05d5\u05d6\u05d9\u05d4\u05d5\u05d9 \u05ea\u05db\u05d5\u05e0\u05d5\u05ea \u05db\u05de\u05d5 \u05d0\u05d9\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05d5\u05ea, \u05e2\u05d5\u05d9\u05e0\u05d5\u05ea \u05d5\u05d7\u05e8\u05d3\u05ea\u05d9\u05d5\u05ea. (DSM p.882, 886)"
        },
        {
          "text": "\u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05e9\u05dc \u05dc\u05e4\u05d7\u05d5\u05ea 5 \u05de\u05ea\u05d5\u05da 9 \u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05d4\u05e7\u05dc\u05d0\u05e1\u05d9\u05d9\u05dd \u05d4\u05db\u05d5\u05dc\u05dc\u05d9\u05dd \u05e4\u05d7\u05d3 \u05de\u05e0\u05d8\u05d9\u05e9\u05d4 \u05d5\u05e4\u05d9\u05e6\u05d5\u05dc.",
          "isCorrect": false,
          "rationale": "\u05d6\u05d4\u05d5 \u05d4\u05de\u05d5\u05d3\u05dc \u05d4\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d0\u05dc\u05d9 \u05e9\u05dc Section II, \u05d5\u05dc\u05d0 \u05d4\u05de\u05d5\u05d3\u05dc \u05d4\u05d0\u05dc\u05d8\u05e8\u05e0\u05d8\u05d9\u05d1\u05d9 \u05e9\u05dc Section III. (DSM p.752)"
        },
        {
          "text": "\u05d4\u05d5\u05db\u05d7\u05d4 \u05dc\u05d8\u05e8\u05d0\u05d5\u05de\u05ea \u05d9\u05dc\u05d3\u05d5\u05ea \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05d1\u05e9\u05d9\u05dc\u05d5\u05d1 \u05e2\u05dd \u05e2\u05d3\u05d5\u05ea \u05dc-Neuroticism \u05d2\u05d1\u05d5\u05d4 \u05d1\u05de\u05d1\u05d7\u05e0\u05d9 \u05d0\u05d9\u05e9\u05d9\u05d5\u05ea.",
          "isCorrect": false,
          "rationale": "\u05d4-DSM \u05d0\u05d9\u05e0\u05d5 \u05d3\u05d5\u05e8\u05e9 \u05d4\u05d5\u05db\u05d7\u05ea \u05d8\u05e8\u05d0\u05d5\u05de\u05d4 \u05db\u05d0\u05d1\u05df \u05d1\u05d5\u05d7\u05df \u05d0\u05d1\u05d7\u05e0\u05ea\u05d9\u05ea \u05dc\u05d0\u05d9\u05e9\u05d9\u05d5\u05ea \u05d2\u05d1\u05d5\u05dc\u05d9\u05ea, \u05d2\u05dd \u05dc\u05d0 \u05d1\u05de\u05d5\u05d3\u05dc \u05d4\u05d0\u05dc\u05d8\u05e8\u05e0\u05d8\u05d9\u05d1\u05d9. (DSM p.881)"
        },
        {
          "text": "\u05dc\u05d9\u05e7\u05d5\u05d9 \u05d1\u05d9\u05db\u05d5\u05dc\u05ea \u05d4-Mentalization (Criterion A) \u05d5\u05e7\u05d9\u05d5\u05dd \u05e9\u05dc \u05e1\u05db\u05de\u05d5\u05ea \u05e4\u05ea\u05d5\u05dc\u05d5\u05d2\u05d9\u05d5\u05ea (Criterion B).",
          "isCorrect": false,
          "rationale": "\u05d0\u05de\u05e0\u05dd \u05de\u05e0\u05d8\u05dc\u05d9\u05d6\u05e6\u05d9\u05d4 \u05d5\u05e1\u05db\u05de\u05d5\u05ea \u05d4\u05dd \u05de\u05d5\u05e9\u05d2\u05d9\u05dd \u05d8\u05d9\u05e4\u05d5\u05dc\u05d9\u05d9\u05dd \u05d7\u05e9\u05d5\u05d1\u05d9\u05dd, \u05d0\u05da \u05d4-DSM \u05de\u05e9\u05ea\u05de\u05e9 \u05d1\u05de\u05d5\u05e0\u05d7\u05d9\u05dd \u05e9\u05dc Personality functioning \u05d5-Pathological traits. (DSM p.882)"
        }
      ],
      "hint": "\u05d7\u05e4\u05e9 \u05d0\u05ea \u05d4\u05de\u05d5\u05e0\u05d7\u05d9\u05dd '\u05ea\u05e4\u05e7\u05d5\u05d3 \u05d0\u05d9\u05e9\u05d9\u05d5\u05ea\u05d9' (LPFS) \u05d5'\u05ea\u05db\u05d5\u05e0\u05d5\u05ea \u05e4\u05ea\u05d5\u05dc\u05d5\u05d2\u05d9\u05d5\u05ea'.",
      "source": "(DSM p.881-886)"
    },
    {
      "type": "short_answer",
      "question": "\u05d4\u05e1\u05d1\u05e8 \u05d0\u05ea \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc\u05d9 \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05e9\u05dc Mentalization-Based Treatment (MBT-A) \u05d5\u05d4\u05e9\u05e4\u05e2\u05ea\u05d5 \u05e2\u05dc \u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd \u05e2\u05dd BPD, \u05db\u05e4\u05d9 \u05e9\u05de\u05ea\u05d5\u05d0\u05e8 \u05d1-Synopsis \u05d5\u05d1-Dulcan.",
      "grading": {
        "modelAnswer": "MBT-A \u05de\u05ea\u05de\u05e7\u05d3 \u05d1\u05e9\u05d9\u05e4\u05d5\u05e8 \u05d4\u05d9\u05db\u05d5\u05dc\u05ea \u05e9\u05dc \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05dc\u05de\u05e0\u05d8\u05dc\u05d9\u05d6\u05e6\u05d9\u05d4 - \u05d4\u05d9\u05db\u05d5\u05dc\u05ea \u05dc\u05d4\u05d1\u05d9\u05df \u05d0\u05ea \u05d4\u05de\u05e6\u05d1\u05d9\u05dd \u05d4\u05de\u05e0\u05d8\u05dc\u05d9\u05d9\u05dd (\u05e8\u05d2\u05e9\u05d5\u05ea, \u05de\u05d7\u05e9\u05d1\u05d5\u05ea, \u05db\u05d5\u05d5\u05e0\u05d5\u05ea) \u05e9\u05dc \u05e2\u05e6\u05de\u05d5 \u05d5\u05e9\u05dc \u05d0\u05d7\u05e8\u05d9\u05dd \u05d1\u05d4\u05e7\u05e9\u05e8 \u05d1\u05d9\u05e0\u05d0\u05d9\u05e9\u05d9. \u05d4\u05d4\u05e0\u05d7\u05d4 \u05d4\u05d9\u05d0 \u05e9\u05ea\u05e1\u05de\u05d9\u05e0\u05d9 BPD \u05e0\u05d5\u05d1\u05e2\u05d9\u05dd \u05de\u05db\u05d9\u05e9\u05dc\u05d5\u05df \u05d1\u05d9\u05db\u05d5\u05dc\u05ea \u05d6\u05d5 \u05ea\u05d7\u05ea \u05e2\u05d5\u05e8\u05e8\u05d5\u05ea \u05e8\u05d2\u05e9\u05d9\u05ea \u05d2\u05d1\u05d5\u05d4\u05d4, \u05d5\u05e9\u05d9\u05e7\u05d5\u05de\u05d4 \u05de\u05d0\u05e4\u05e9\u05e8 \u05d5\u05d9\u05e1\u05d5\u05ea \u05e8\u05d2\u05e9\u05d9 \u05d8\u05d5\u05d1 \u05d9\u05d5\u05ea\u05e8 \u05d5\u05e0\u05d9\u05d4\u05d5\u05dc \u05e7\u05e9\u05e8\u05d9\u05dd \u05d9\u05e6\u05d9\u05d1 \u05d9\u05d5\u05ea\u05e8.",
        "rationale": "\u05d4\u05de\u05e0\u05d8\u05dc\u05d9\u05d6\u05e6\u05d9\u05d4 \u05d4\u05d9\u05d0 \u05d4\u05d1\u05e1\u05d9\u05e1 \u05dc\u05d4\u05d1\u05e0\u05ea \u05e2\u05d5\u05dc\u05de\u05d5 \u05d4\u05e4\u05e0\u05d9\u05de\u05d9 \u05e9\u05dc \u05d4\u05d0\u05d7\u05e8, \u05d5\u05e9\u05d9\u05e7\u05d5\u05de\u05d4 \u05d1\u05d8\u05d9\u05e4\u05d5\u05dc MBT-A \u05e0\u05de\u05e6\u05d0 \u05d9\u05e2\u05d9\u05dc \u05d1\u05d4\u05e4\u05d7\u05ea\u05ea \u05e4\u05d2\u05d9\u05e2\u05d4 \u05e2\u05e6\u05de\u05d9\u05ea \u05d5\u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05d1\u05e7\u05e8\u05d1 \u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd. (Dulcan p.558, Synopsis ch.19)",
        "requiredAttributes": [
          "\u05d4\u05d2\u05d3\u05e8\u05d4 \u05e9\u05dc \u05de\u05e0\u05d8\u05dc\u05d9\u05d6\u05e6\u05d9\u05d4 \u05db\u05d4\u05d1\u05e0\u05ea \u05de\u05e6\u05d1\u05d9\u05dd \u05de\u05e0\u05d8\u05dc\u05d9\u05d9\u05dd \u05e9\u05dc \u05d4\u05e2\u05e6\u05de\u05d9 \u05d5\u05d4\u05d0\u05d7\u05e8.",
          "\u05e7\u05d9\u05e9\u05d5\u05e8 \u05d1\u05d9\u05df \u05db\u05e9\u05dc \u05d1\u05de\u05e0\u05d8\u05dc\u05d9\u05d6\u05e6\u05d9\u05d4 \u05dc\u05d1\u05d9\u05df \u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05e9\u05dc BPD (\u05d7\u05d5\u05e1\u05e8 \u05d5\u05d9\u05e1\u05d5\u05ea, \u05e7\u05e9\u05d9\u05d9\u05dd \u05d1\u05d9\u05e0\u05d0\u05d9\u05e9\u05d9\u05d9\u05dd).",
          "\u05de\u05d8\u05e8\u05ea \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05d9\u05d0 \u05e9\u05d9\u05e7\u05d5\u05dd \u05d0\u05d5 \u05e4\u05d9\u05ea\u05d5\u05d7 \u05d4\u05d9\u05db\u05d5\u05dc\u05ea \u05d4\u05d6\u05d5."
        ],
        "errors": {
          "misconceptions": [
            "\u05d8\u05e2\u05d5\u05ea \u05dc\u05d7\u05e9\u05d5\u05d1 \u05e9-MBT \u05de\u05d1\u05d5\u05e1\u05e1 \u05e2\u05dc \u05dc\u05de\u05d9\u05d3\u05ea \u05de\u05d9\u05d5\u05de\u05e0\u05d5\u05d9\u05d5\u05ea \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea\u05d9\u05d5\u05ea \u05db\u05de\u05d5 DBT.",
            "\u05d8\u05e2\u05d5\u05ea \u05dc\u05d7\u05e9\u05d5\u05d1 \u05e9\u05d6\u05d4\u05d5 \u05d8\u05d9\u05e4\u05d5\u05dc \u05ea\u05e8\u05d5\u05e4\u05ea\u05d9."
          ],
          "bluffs": [
            "\u05d0\u05de\u05d9\u05e8\u05d4 \u05db\u05dc\u05dc\u05d9\u05ea \u05e9\u05d6\u05d4 \u05d8\u05d9\u05e4\u05d5\u05dc \u05e9\u05e2\u05d5\u05d6\u05e8 \u05dc\u05d4\u05d1\u05d9\u05df \u05d0\u05ea \u05d4\u05e8\u05d2\u05e9\u05d5\u05ea \u05d1\u05dc\u05d9 \u05dc\u05d4\u05d6\u05db\u05d9\u05e8 \u05d0\u05ea \u05de\u05d5\u05e9\u05d2 \u05d4\u05de\u05e0\u05d8\u05dc\u05d9\u05d6\u05e6\u05d9\u05d4."
          ]
