      "hint": "\u05d7\u05e9\u05d1\u05d5 \u05e2\u05dc \u05d4\u05e7\u05d5\u05dc\u05d8\u05df \u05d4\u05de\u05ea\u05d5\u05d5\u05da \u05d0\u05ea \u05e9\u05d7\u05e8\u05d5\u05e8 \u05d4\u05d3\u05d5\u05e4\u05de\u05d9\u05df \u05d1-VTA \u05d1\u05ea\u05d2\u05d5\u05d1\u05d4 \u05dc\u05d0\u05dc\u05db\u05d5\u05d4\u05d5\u05dc.",
      "imageUrls": []
