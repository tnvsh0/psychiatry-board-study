      ],
      "hint": "\u05d6\u05d5\u05d4\u05d9 \u05ea\u05e8\u05d5\u05e4\u05d4 \u05d0\u05e0\u05d8\u05d9-\u05d0\u05e4\u05d9\u05dc\u05e4\u05d8\u05d9\u05ea \u05d4\u05de\u05e9\u05de\u05e9\u05ea \u05dc\u05e2\u05d9\u05ea\u05d9\u05dd \u05d2\u05dd \u05dc\u05d9\u05e8\u05d9\u05d3\u05d4 \u05d1\u05de\u05e9\u05e7\u05dc \u05d5\u05de\u05d5\u05d6\u05db\u05e8\u05ea \u05db-Off-label \u05dc-AUD.",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05d1\u05ea\u05d4\u05dc\u05d9\u05da \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05de\u05d1\u05d3\u05dc\u05ea \u05e9\u05dc \u05de\u05ea\u05d1\u05d2\u05e8 \u05d4\u05de\u05e6\u05d9\u05d2 \u05e1\u05d9\u05de\u05e0\u05d9 \u05e9\u05db\u05d7\u05d4, \u05d7\u05d5\u05e1\u05e8 \u05e7\u05d5\u05d0\u05d5\u05e8\u05d3\u05d9\u05e0\u05e6\u05d9\u05d4 \u05d5\u05d3\u05d9\u05d1\u05d5\u05e8 \u05de\u05e2\u05d5\u05e8\u05e4\u05dc, \u05d4-DSM-5-TR \u05de\u05d3\u05d2\u05d9\u05e9 \u05d0\u05ea \u05d4\u05e6\u05d5\u05e8\u05da \u05dc\u05d4\u05d1\u05d7\u05d9\u05df \u05d1\u05d9\u05df Alcohol Use Disorder \u05dc\u05d1\u05d9\u05df \u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05d0\u05d7\u05e8\u05d5\u05ea. \u05d0\u05d9\u05d6\u05d5 \u05d4\u05e4\u05e8\u05e2\u05d4 \u05de\u05e6\u05d9\u05d2\u05d4 \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d3\u05d5\u05de\u05d9\u05dd \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05d0\u05dc\u05d5 \u05e9\u05dc \u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05d0\u05dc\u05db\u05d5\u05d4\u05d5\u05dc, \u05d5\u05de\u05d7\u05d9\u05d9\u05d1\u05ea \u05d4\u05d1\u05d7\u05e0\u05d4 \u05d6\u05d4\u05d9\u05e8\u05d4?",
      "answerOptions": [
        {
          "text": "Sedative, Hypnotic, or Anxiolytic Use Disorder.",
          "isCorrect": true,
          "rationale": "\u05d4\u05e1\u05d9\u05de\u05e0\u05d9\u05dd \u05d5\u05d4\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05e9\u05dc AUD \u05d3\u05d5\u05de\u05d9\u05dd \u05de\u05d0\u05d5\u05d3 \u05dc\u05d0\u05dc\u05d5 \u05e9\u05dc \u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05d7\u05d5\u05de\u05e8\u05d9\u05dd \u05de\u05e8\u05d2\u05d9\u05e2\u05d9\u05dd \u05d0\u05d5 \u05e0\u05d5\u05d2\u05d3\u05d9 \u05d7\u05e8\u05d3\u05d4, \u05d5\u05d4\u05d4\u05d1\u05d7\u05e0\u05d4 \u05d7\u05e9\u05d5\u05d1\u05d4 \u05e2\u05e7\u05d1 \u05d4\u05e9\u05dc\u05db\u05d5\u05ea \u05e8\u05e4\u05d5\u05d0\u05d9\u05d5\u05ea \u05e9\u05d5\u05e0\u05d5\u05ea (DSM p. 561)."
        },
        {
          "text": "Cannabis Use Disorder.",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05e9\u05e7\u05e0\u05d0\u05d1\u05d9\u05e1 \u05de\u05e9\u05e4\u05d9\u05e2 \u05e2\u05dc \u05e7\u05d5\u05d0\u05d5\u05e8\u05d3\u05d9\u05e0\u05e6\u05d9\u05d4, \u05d4\u05ea\u05de\u05d5\u05e0\u05d4 \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05d4\u05e7\u05dc\u05d0\u05e1\u05d9\u05ea \u05e9\u05dc '\u05e9\u05d9\u05db\u05e8\u05d5\u05df' \u05d3\u05d5\u05de\u05d9\u05d4 \u05d4\u05e8\u05d1\u05d4 \u05d9\u05d5\u05ea\u05e8 \u05dc\u05d6\u05d5 \u05e9\u05dc \u05d1\u05e0\u05d6\u05d5\u05d3\u05d9\u05d0\u05d6\u05e4\u05d9\u05e0\u05d9\u05dd (DSM p. 561, 582)."
        },
        {
          "text": "Attention-Deficit/Hyperactivity Disorder (ADHD).",
          "isCorrect": false,
          "rationale": "ADHD \u05de\u05ea\u05d0\u05e4\u05d9\u05d9\u05df \u05d1\u05d7\u05d5\u05e1\u05e8 \u05e7\u05e9\u05d1 \u05d5\u05d4\u05d9\u05e4\u05e8-\u05d0\u05e7\u05d8\u05d9\u05d1\u05d9\u05d5\u05ea, \u05d0\u05da \u05dc\u05d0 \u05d1\u05e1\u05d9\u05de\u05e0\u05d9 \u05d4-'Slurred speech' \u05d0\u05d5 \u05d4-'Unsteady gait' \u05d4\u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05d9\u05d9\u05dd \u05dc\u05e9\u05d9\u05db\u05e8\u05d5\u05df (DSM p. 68, 562)."
        },
        {
          "text": "Opioid Use Disorder.",
          "isCorrect": false,
          "rationale": "\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05d0\u05d5\u05e4\u05d9\u05d0\u05d8\u05d9\u05dd \u05de\u05ea\u05d0\u05e4\u05d9\u05d9\u05df \u05d1\u05e1\u05d9\u05de\u05e0\u05d9\u05dd \u05d0\u05d7\u05e8\u05d9\u05dd \u05db\u05de\u05d5 \u05db\u05d9\u05d5\u05d5\u05e5 \u05d0\u05d9\u05e9\u05d5\u05e0\u05d9\u05dd (Miosis) \u05d5\u05e0\u05de\u05e0\u05d5\u05dd (Nodding off), \u05d4\u05e9\u05d5\u05e0\u05d9\u05dd \u05de\u05d4\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d4\u05d3\u05d9\u05e1-\u05d0\u05d9\u05e0\u05d4\u05d9\u05d1\u05d9\u05d8\u05d5\u05e8\u05d9\u05ea \u05e9\u05dc \u05d0\u05dc\u05db\u05d5\u05d4\u05d5\u05dc (DSM p. 615)."
        }
      ],
      "hint": "\u05d7\u05e4\u05e9\u05d5 \u05e7\u05d1\u05d5\u05e6\u05ea \u05d7\u05d5\u05de\u05e8\u05d9\u05dd \u05e9\u05e4\u05d5\u05e2\u05dc\u05ea \u05d2\u05dd \u05d4\u05d9\u05d0 \u05e2\u05dc \u05de\u05e2\u05e8\u05db\u05ea \u05d4-GABA \u05d5\u05de\u05d3\u05db\u05d0\u05ea \u05d0\u05ea \u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05e2\u05e6\u05d1\u05d9\u05dd \u05d4\u05de\u05e8\u05db\u05d6\u05d9\u05ea.",
      "imageUrls": []
    }
