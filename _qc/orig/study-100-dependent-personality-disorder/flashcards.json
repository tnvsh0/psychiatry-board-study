{
  "title": "DPD Flashcards",
  "cards": [
    {
      "front": "\u05e2\u05dc \u05de\u05e0\u05ea \u05dc\u05d0\u05d1\u05d7\u05df Dependent Personality Disorder (DPD), \u05db\u05de\u05d4 \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05de\u05ea\u05d5\u05da \u05d4\u05e9\u05de\u05d5\u05e0\u05d4 \u05d4\u05de\u05e4\u05d5\u05e8\u05d8\u05d9\u05dd \u05d1-DSM-5-TR \u05e6\u05e8\u05d9\u05db\u05d9\u05dd \u05dc\u05d4\u05ea\u05e7\u05d9\u05d9\u05dd?",
      "back": "\u05dc\u05e4\u05d7\u05d5\u05ea 5 \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd (DSM p.768)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05e9\u05dc \u05d0\u05d3\u05dd \u05e2\u05dd DPD \u05d1\u05e0\u05d5\u05d2\u05e2 \u05dc\u05e7\u05d1\u05dc\u05ea \u05d4\u05d7\u05dc\u05d8\u05d5\u05ea \u05d9\u05d5\u05de\u05d9\u05d5\u05de\u05d9\u05d5\u05ea (everyday decisions)?",
      "back": "\u05e7\u05d5\u05e9\u05d9 \u05e8\u05d1 \u05d1\u05e7\u05d1\u05dc\u05ea \u05d4\u05d7\u05dc\u05d8\u05d5\u05ea \u05dc\u05dc\u05d0 \u05db\u05de\u05d5\u05ea \u05de\u05d5\u05d2\u05d6\u05de\u05ea \u05e9\u05dc advice \u05d5-reassurance \u05de\u05d0\u05d7\u05e8\u05d9\u05dd (DSM p.768)."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05de\u05ea\u05d1\u05d8\u05d0 \u05d4\u05e7\u05d5\u05e9\u05d9 \u05d1\u05d1\u05d9\u05d8\u05d5\u05d9 \u05d7\u05d5\u05e1\u05e8 \u05d4\u05e1\u05db\u05de\u05d4 (disagreement) \u05d1\u05e7\u05e8\u05d1 \u05d4\u05e1\u05d5\u05d1\u05dc\u05d9\u05dd \u05de-DPD?",
      "back": "\u05e7\u05d5\u05e9\u05d9 \u05dc\u05d4\u05d1\u05d9\u05e2 \u05d4\u05ea\u05e0\u05d2\u05d3\u05d5\u05ea \u05d1\u05e9\u05dc \u05e4\u05d7\u05d3 \u05de\u05d0\u05d9\u05d1\u05d5\u05d3 support \u05d0\u05d5 approval (DSM p.768)."
    },
    {
      "front": "\u05de\u05d3\u05d5\u05e2 \u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd \u05e2\u05dd DPD \u05de\u05ea\u05e7\u05e9\u05d9\u05dd \u05dc\u05d9\u05d6\u05d5\u05dd \u05e4\u05e8\u05d5\u05d9\u05e7\u05d8\u05d9\u05dd \u05d0\u05d5 \u05dc\u05e2\u05e9\u05d5\u05ea \u05d3\u05d1\u05e8\u05d9\u05dd \u05d1\u05d0\u05d5\u05e4\u05df \u05e2\u05e6\u05de\u05d0\u05d9?",
      "back": "\u05d1\u05e9\u05dc \u05d7\u05d5\u05e1\u05e8 \u05d1\u05d9\u05d8\u05d7\u05d5\u05df \u05d1\u05e9\u05d9\u05e4\u05d5\u05d8 \u05d0\u05d5 \u05d1\u05d9\u05db\u05d5\u05dc\u05d5\u05ea \u05e9\u05dc\u05d4\u05dd (lack of self-confidence), \u05d5\u05dc\u05d0 \u05d1\u05e9\u05dc \u05d7\u05d5\u05e1\u05e8 \u05de\u05d5\u05d8\u05d9\u05d1\u05e6\u05d9\u05d4 \u05d0\u05d5 \u05d0\u05e0\u05e8\u05d2\u05d9\u05d4 (DSM p.768)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05e6\u05e2\u05d3 \u05d4\u05e7\u05d9\u05e6\u05d5\u05e0\u05d9 \u05e9\u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd \u05e2\u05dd DPD \u05e2\u05e9\u05d5\u05d9\u05d9\u05dd \u05dc\u05e0\u05e7\u05d5\u05d8 \u05db\u05d3\u05d9 \u05dc\u05d4\u05e9\u05d9\u05d2 nurturance \u05d5-support?",
      "back": "\u05d4\u05ea\u05e0\u05d3\u05d1\u05d5\u05ea \u05dc\u05d1\u05d9\u05e6\u05d5\u05e2 \u05de\u05e9\u05d9\u05de\u05d5\u05ea \u05e9\u05d4\u05df unpleasant (DSM p.768)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05ea\u05d2\u05d5\u05d1\u05d4 \u05d4\u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05d9\u05ea \u05e9\u05dc \u05d0\u05d3\u05dd \u05e2\u05dd DPD \u05db\u05d0\u05e9\u05e8 \u05e7\u05e9\u05e8 \u05e7\u05e8\u05d5\u05d1 \u05de\u05e1\u05ea\u05d9\u05d9\u05dd?",
      "back": "\u05d7\u05d9\u05e4\u05d5\u05e9 \u05d3\u05d7\u05d5\u05e3 (urgently seeks) \u05d0\u05d7\u05e8 \u05e7\u05e9\u05e8 \u05d0\u05d7\u05e8 \u05db\u05de\u05e7\u05d5\u05e8 \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d5\u05ea\u05de\u05d9\u05db\u05d4 (DSM p.769)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05e9\u05db\u05d9\u05d7\u05d5\u05ea (prevalence) \u05e9\u05dc DPD \u05d1\u05d0\u05d5\u05db\u05dc\u05d5\u05e1\u05d9\u05d9\u05d4 \u05d4\u05db\u05dc\u05dc\u05d9\u05ea \u05dc\u05e4\u05d9 \u05de\u05d7\u05e7\u05e8 \u05d4-NESARC?",
      "back": "$0.5\\%$ (DSM p.770)."
    },
    {
      "front": "\u05de\u05d4\u05dd \u05e9\u05e0\u05d9 \u05d2\u05d5\u05e8\u05de\u05d9 \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05d1\u05d9\u05dc\u05d3\u05d5\u05ea \u05d4\u05e2\u05dc\u05d5\u05dc\u05d9\u05dd \u05dc\u05d4\u05d5\u05d5\u05ea \u05e4\u05e8\u05d4-\u05d3\u05d9\u05e1\u05e4\u05d5\u05d6\u05d9\u05e6\u05d9\u05d4 \u05dc\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea DPD?",
      "back": "\u05de\u05d7\u05dc\u05d4 \u05d2\u05d5\u05e4\u05e0\u05d9\u05ea \u05db\u05e8\u05d5\u05e0\u05d9\u05ea (chronic physical illness) \u05d0\u05d5 Separation Anxiety Disorder \u05d1\u05d9\u05dc\u05d3\u05d5\u05ea (DSM p.771)."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05e0\u05d1\u05d3\u05dc\u05d9\u05dd \u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd \u05e2\u05dd DPD \u05de\u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd \u05e2\u05dd Borderline Personality Disorder (BPD) \u05d1\u05ea\u05d2\u05d5\u05d1\u05d4 \u05dc-abandonment?",
      "back": "\u05d1-DPD \u05d4\u05ea\u05d2\u05d5\u05d1\u05d4 \u05d4\u05d9\u05d0 appeasement \u05d5\u05e1\u05d5\u05d1\u05de\u05d9\u05e1\u05d9\u05d1\u05d9\u05d5\u05ea, \u05d1\u05e2\u05d5\u05d3 \u05e9\u05d1-BPD \u05d4\u05ea\u05d2\u05d5\u05d1\u05d4 \u05d4\u05d9\u05d0 emptiness, \u05d6\u05e2\u05dd \u05d5\u05d3\u05e8\u05d9\u05e9\u05d5\u05ea (DSM p.770)."
    },
    {
      "front": "\u05de\u05d4 \u05de\u05d1\u05d3\u05d9\u05dc \u05d1\u05d9\u05df Histrionic Personality Disorder \u05dc\u05d1\u05d9\u05df DPD \u05de\u05d1\u05d7\u05d9\u05e0\u05ea \u05e1\u05d2\u05e0\u05d5\u05df \u05d4\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea (behavioral style)?",
      "back": "DPD \u05de\u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05ea \u05d1\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea self-effacing \u05d5-docile, \u05d1\u05e2\u05d5\u05d3 \u05e9-Histrionic \u05de\u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05ea \u05d1-gregarious flamboyance \u05d5\u05d3\u05e8\u05d9\u05e9\u05d4 \u05d0\u05e7\u05d8\u05d9\u05d1\u05d9\u05ea \u05dc\u05ea\u05e9\u05d5\u05de\u05ea \u05dc\u05d1 (DSM p.771)."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05de\u05d1\u05d7\u05d9\u05e0\u05d9\u05dd \u05d1\u05d9\u05df Avoidant Personality Disorder \u05dc\u05d1\u05d9\u05df DPD \u05de\u05d1\u05d7\u05d9\u05e0\u05ea \u05d9\u05d7\u05e1\u05d9\u05dd \u05d1\u05d9\u05e0\u05d0\u05d9\u05e9\u05d9\u05d9\u05dd?",
      "back": "\u05d1-Avoidant \u05d9\u05e9 \u05e0\u05e1\u05d9\u05d2\u05d4 \u05de\u05d9\u05d7\u05e1\u05d9\u05dd \u05d1\u05e9\u05dc \u05e4\u05d7\u05d3 \u05de\u05d1\u05d9\u05e7\u05d5\u05e8\u05ea, \u05d1\u05e2\u05d5\u05d3 \u05e9\u05d1-DPD \u05d9\u05e9 \u05d3\u05e4\u05d5\u05e1 \u05e9\u05dc \u05d7\u05d9\u05e4\u05d5\u05e9 \u05d5\u05e9\u05de\u05d9\u05e8\u05d4 \u05e2\u05dc \u05e7\u05e9\u05e8\u05d9\u05dd \u05e2\u05dd \u05d0\u05d7\u05e8\u05d9\u05dd (DSM p.771)."
    },
    {
      "front": "\u05e0\u05db\u05d5\u05df \u05d0\u05d5 \u05dc\u05d0 \u05e0\u05db\u05d5\u05df: \u05d4\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05e9\u05dc DPD \u05d1\u05de\u05d3\u05d2\u05de\u05d9\u05dd \u05e7\u05d4\u05d9\u05dc\u05ea\u05d9\u05d9\u05dd \u05d2\u05d1\u05d5\u05d4\u05d4 \u05d9\u05d5\u05ea\u05e8 \u05d1\u05e0\u05e9\u05d9\u05dd \u05d1\u05d0\u05d5\u05e4\u05df \u05de\u05d5\u05d1\u05d4\u05e7.",
      "back": "\u05dc\u05d0 \u05e0\u05db\u05d5\u05df; \u05d1\u05de\u05d3\u05d2\u05de\u05d9\u05dd \u05e7\u05d4\u05d9\u05dc\u05ea\u05d9\u05d9\u05dd \u05d4\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d3\u05d5\u05de\u05d4, \u05d0\u05da \u05d1\u05e7\u05dc\u05d9\u05e0\u05d9\u05e7\u05d4 \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05db\u05d9\u05d7\u05d4 \u05d9\u05d5\u05ea\u05e8 \u05d1\u05e0\u05e9\u05d9\u05dd (DSM p.770; Synopsis ch.19)."
    },
    {
      "front": "\u05de\u05d4\u05df \u05e9\u05d9\u05d8\u05d5\u05ea \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05e4\u05e1\u05d9\u05db\u05d5\u05ea\u05e8\u05e4\u05d9\u05d5\u05ea \u05e9\u05e0\u05d7\u05e9\u05d1\u05d5\u05ea \u05dc\u05d9\u05e2\u05d9\u05dc\u05d5\u05ea \u05d5\u05de\u05d5\u05e6\u05dc\u05d7\u05d5\u05ea \u05d1-DPD?",
      "back": "\u05d8\u05d9\u05e4\u05d5\u05dc\u05d9\u05dd \u05de\u05d1\u05d5\u05e1\u05e1\u05d9 \u05ea\u05d5\u05d1\u05e0\u05d4 (insight-oriented), \u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea\u05d9, Assertiveness training \u05d5\u05d8\u05d9\u05e4\u05d5\u05dc \u05e7\u05d1\u05d5\u05e6\u05ea\u05d9 (Synopsis ch.19 Personality Disorders)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05de\u05d8\u05e8\u05d4 \u05d4\u05e2\u05d9\u05e7\u05e8\u05d9\u05ea \u05e9\u05dc pharmacotherapy \u05d1\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-DPD?",
      "back": "\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05d9\u05dd (symptom-targeted) \u05db\u05de\u05d5 \u05d7\u05e8\u05d3\u05d4, \u05e4\u05d0\u05e0\u05d9\u05e7\u05d4 \u05d0\u05d5 \u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05d4\u05e0\u05dc\u05d5\u05d5\u05d9\u05dd \u05dc\u05d4\u05e4\u05e8\u05e2\u05d4 (Synopsis ch.19 Personality Disorders)."
    },
    {
      "front": "\u05d0\u05d9\u05dc\u05d5 \u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05e2\u05e9\u05d5\u05d9\u05d5\u05ea \u05dc\u05e1\u05d9\u05d9\u05e2 \u05dc\u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd \u05e2\u05dd DPD \u05e9\u05d7\u05d5\u05d5\u05d9\u05dd \u05d4\u05ea\u05e7\u05e4\u05d9 \u05e4\u05d0\u05e0\u05d9\u05e7\u05d4 \u05d0\u05d5 \u05e8\u05de\u05d5\u05ea \u05d2\u05d1\u05d5\u05d4\u05d5\u05ea \u05e9\u05dc Separation Anxiety?",
      "back": "\u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05e0\u05d5\u05d2\u05d3\u05d5\u05ea \u05d3\u05d9\u05db\u05d0\u05d5\u05df (antidepressants) \u05de\u05de\u05e9\u05e4\u05d7\u05ea \u05d4-SSRIs \u05d0\u05d5 \u05d4-SNRIs (Synopsis ch.19; StahlNeuro p.359)."
    },
    {
      "front": "\u05de\u05d3\u05d5\u05e2 \u05d4\u05e4\u05e8\u05d5\u05d2\u05e0\u05d5\u05d6\u05d4 \u05e9\u05dc \u05d8\u05d9\u05e4\u05d5\u05dc \u05e4\u05e1\u05d9\u05db\u05d5\u05ea\u05e8\u05e4\u05d9 \u05d1-DPD \u05e0\u05d7\u05e9\u05d1\u05ea \u05dc\u05d8\u05d5\u05d1\u05d4 \u05d9\u05d7\u05e1\u05d9\u05ea?",
      "back": "\u05d1\u05e9\u05dc \u05d4\u05de\u05d5\u05d8\u05d9\u05d1\u05e6\u05d9\u05d4 \u05d4\u05d2\u05d1\u05d5\u05d4\u05d4 \u05e9\u05dc \u05d4\u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd \u05dc\u05e9\u05ea\u05e3 \u05e4\u05e2\u05d5\u05dc\u05d4 \u05d5\u05dc\u05d7\u05e4\u05e9 \u05e2\u05d6\u05e8\u05d4 \u05d5\u05d0\u05d9\u05e9\u05d5\u05e8 \u05de\u05d4\u05de\u05d8\u05e4\u05dc (Synopsis ch.19 Personality Disorders)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05e1\u05db\u05e0\u05d4 \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc\u05d9\u05ea (pitfall) \u05d1\u05e9\u05dc\u05d1\u05d9\u05dd \u05d4\u05de\u05d5\u05e7\u05d3\u05de\u05d9\u05dd \u05e9\u05dc \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-DPD \u05db\u05d0\u05e9\u05e8 \u05d4\u05de\u05d8\u05e4\u05dc \u05de\u05e2\u05d5\u05d3\u05d3 \u05e2\u05e6\u05de\u05d0\u05d5\u05ea?",
      "back": "\u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05e2\u05dc\u05d5\u05dc \u05dc\u05d7\u05d5\u05e9 \u05d7\u05e8\u05d3\u05d4 \u05e2\u05d6\u05d4 \u05d5\u05dc\u05d4\u05d9\u05e7\u05e8\u05e2 \u05d1\u05d9\u05df \u05d4\u05e6\u05d9\u05d5\u05ea \u05dc\u05de\u05d8\u05e4\u05dc \u05dc\u05d1\u05d9\u05df \u05d4\u05e4\u05d7\u05d3 \u05dc\u05d0\u05d1\u05d3 \u05e7\u05e9\u05e8 \u05e4\u05ea\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d7\u05d9\u05e6\u05d5\u05e0\u05d9 (Synopsis ch.19 Personality Disorders)."
    }
  ]
}