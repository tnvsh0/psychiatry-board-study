    {
      "type": "multiple_select",
      "question": "\u05d0\u05d9\u05dc\u05d5 \u05de\u05d4\u05de\u05e6\u05d1\u05d9\u05dd \u05d4\u05d1\u05d0\u05d9\u05dd \u05e0\u05d7\u05e9\u05d1\u05d9\u05dd \u05dc\u05d2\u05d5\u05e8\u05de\u05d9 \u05e1\u05d9\u05db\u05d5\u05df \u05d0\u05d5 \u05d2\u05d5\u05e8\u05de\u05d9\u05dd \u05d0\u05d8\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05d9\u05dd \u05dc\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea Dependent Personality Disorder?",
      "answerOptions": [
        {
          "text": "\u05de\u05d7\u05dc\u05d4 \u05d2\u05d5\u05e4\u05e0\u05d9\u05ea \u05db\u05e8\u05d5\u05e0\u05d9\u05ea \u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05d9\u05dc\u05d3\u05d5\u05ea.",
          "isCorrect": true,
          "rationale": "\u05de\u05d7\u05dc\u05d5\u05ea \u05db\u05e8\u05d5\u05e0\u05d9\u05d5\u05ea \u05d1\u05d9\u05dc\u05d3\u05d5\u05ea \u05e2\u05dc\u05d5\u05dc\u05d5\u05ea \u05dc\u05d9\u05e6\u05d5\u05e8 \u05e6\u05d5\u05e8\u05da \u05de\u05d5\u05d2\u05d1\u05e8 \u05d1\u05d8\u05d9\u05e4\u05d5\u05dc \u05d5\u05d4\u05d2\u05e0\u05d4, \u05d4\u05de\u05e7\u05d1\u05e2\u05d9\u05dd \u05d3\u05e4\u05d5\u05e1\u05d9 \u05ea\u05dc\u05d5\u05ea (DSM p.771; Synopsis ch.19 Personality Disorders)."
        },
        {
          "text": "\u05d4\u05e4\u05e8\u05e2\u05ea \u05d7\u05e8\u05d3\u05ea \u05e4\u05e8\u05d9\u05d3\u05d4 (Separation Anxiety Disorder) \u05d1\u05d9\u05dc\u05d3\u05d5\u05ea \u05d0\u05d5 \u05d1\u05d2\u05d9\u05dc \u05d4\u05d4\u05ea\u05d1\u05d2\u05e8\u05d5\u05ea.",
          "isCorrect": true,
          "rationale": "\u05d7\u05e8\u05d3\u05ea \u05e4\u05e8\u05d9\u05d3\u05d4 \u05de\u05ea\u05de\u05e9\u05db\u05ea \u05d1\u05d9\u05dc\u05d3\u05d5\u05ea \u05de\u05d4\u05d5\u05d5\u05d4 \u05d2\u05d5\u05e8\u05dd \u05de\u05e7\u05d3\u05d9\u05dd (predisposing factor) \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9 \u05dc-DPD \u05d1\u05d1\u05d2\u05e8\u05d5\u05ea (DSM p.771)."
        },
        {
          "text": "\u05e1\u05d2\u05e0\u05d5\u05df \u05d4\u05d5\u05e8\u05d5\u05ea \u05d4\u05de\u05d0\u05d5\u05e4\u05d9\u05d9\u05df \u05d1\u05d4\u05d2\u05e0\u05ea-\u05d9\u05ea\u05e8 (Overprotectiveness) \u05d5\u05d3\u05d5\u05de\u05d9\u05e0\u05e0\u05d8\u05d9\u05d5\u05ea.",
          "isCorrect": true,
          "rationale": "\u05d4\u05d5\u05e8\u05d5\u05ea \u05e1\u05de\u05db\u05d5\u05ea\u05e0\u05d9\u05ea \u05d0\u05d5 \u05de\u05d2\u05d5\u05e0\u05e0\u05ea \u05de\u05d3\u05d9 \u05de\u05d5\u05e0\u05e2\u05ea \u05de\u05d4\u05d9\u05dc\u05d3 \u05dc\u05e4\u05ea\u05d7 \u05de\u05d9\u05d5\u05de\u05e0\u05d5\u05d9\u05d5\u05ea \u05d0\u05d5\u05d8\u05d5\u05e0\u05d5\u05de\u05d9\u05d5\u05ea \u05d5\u05d1\u05d9\u05d8\u05d7\u05d5\u05df \u05e2\u05e6\u05de\u05d9 (DSM p.770)."
        },
        {
