      "hint": "\u05d4\u05d0\u05dd \u05e7\u05d9\u05d9\u05de\u05ea \u05ea\u05e8\u05d5\u05e4\u05d4 \u05e9\u05d9\u05db\u05d5\u05dc\u05d4 \u05dc\u05e8\u05e4\u05d0 \u05d0\u05ea \u05d4'\u05ea\u05dc\u05d5\u05ea' \u05db\u05e9\u05dc\u05e2\u05e6\u05de\u05d4?",
      "imageUrls": []
