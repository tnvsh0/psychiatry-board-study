{
  "title": "Personality Quiz",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\u05de\u05d8\u05d5\u05e4\u05dc\u05ea \u05d1\u05ea 34 \u05de\u05d5\u05e4\u05e0\u05d9\u05ea \u05dc\u05d4\u05e2\u05e8\u05db\u05d4 \u05e2\u05dc \u05d9\u05d3\u05d9 \u05e8\u05d5\u05e4\u05d0 \u05d4\u05de\u05e9\u05e4\u05d7\u05d4 \u05d1\u05e9\u05dc \u05ea\u05dc\u05d5\u05e0\u05d5\u05ea \u05e2\u05dc \u05d7\u05e8\u05d3\u05d4 \u05d5\u05d3\u05d9\u05db\u05d0\u05d5\u05df. \u05d1\u05e8\u05d0\u05d9\u05d5\u05df \u05d4\u05d9\u05d0 \u05de\u05ea\u05d0\u05e8\u05ea \u05e7\u05d5\u05e9\u05d9 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9 \u05d1\u05e7\u05d1\u05dc\u05ea \u05d4\u05d7\u05dc\u05d8\u05d5\u05ea \u05d9\u05d5\u05de\u05d9\u05d5\u05de\u05d9\u05d5\u05ea (\u05db\u05d2\u05d5\u05df \u05d0\u05d9\u05d6\u05d4 \u05d1\u05d2\u05d3 \u05dc\u05dc\u05d1\u05d5\u05e9 \u05d0\u05d5 \u05d0\u05d9\u05d6\u05d4 \u05de\u05e6\u05e8\u05db\u05d9\u05dd \u05dc\u05e7\u05e0\u05d5\u05ea) \u05dc\u05dc\u05d0 \u05d0\u05d9\u05e9\u05d5\u05e8 \u05d1\u05dc\u05ea\u05d9 \u05e4\u05d5\u05e1\u05e7 \u05de\u05d1\u05e2\u05dc\u05d4. \u05d4\u05d9\u05d0 \u05de\u05d3\u05d5\u05d5\u05d7\u05ea \u05db\u05d9 \u05d4\u05d9\u05d0 \u05e0\u05e9\u05d0\u05e8\u05ea \u05d1\u05de\u05e2\u05e8\u05db\u05ea \u05d9\u05d7\u05e1\u05d9\u05dd \u05e4\u05d5\u05d2\u05e2\u05e0\u05d9\u05ea \u05d5\u05de\u05ea\u05de\u05e9\u05db\u05ea \u05de\u05ea\u05d5\u05da \u05e4\u05d7\u05d3 \u05e2\u05de\u05d5\u05e7 \u05e9\u05dc\u05d0 \u05ea\u05d5\u05db\u05dc \u05dc\u05d4\u05e1\u05ea\u05d3\u05e8 \u05dc\u05d1\u05d3 \u05d0\u05dd \u05d4\u05e7\u05e9\u05e8 \u05d9\u05e1\u05ea\u05d9\u05d9\u05dd. \u05de\u05d4\u05d5 \u05d4\u05de\u05de\u05e6\u05d0 \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9 \u05d4\u05de\u05d1\u05d3\u05d9\u05dc \u05d1\u05e6\u05d5\u05e8\u05d4 \u05d4\u05d8\u05d5\u05d1\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d1\u05d9\u05df \u05d4\u05e4\u05e8\u05e2\u05ea \u05d0\u05d9\u05e9\u05d9\u05d5\u05ea \u05ea\u05dc\u05d5\u05ea\u05d9\u05ea (DPD) \u05dc\u05d1\u05d9\u05df Borderline Personality Disorder (BPD) \u05d1\u05de\u05e7\u05e8\u05d4 \u05d6\u05d4?",
      "answerOptions": [
        {
          "text": "\u05ea\u05d2\u05d5\u05d1\u05d4 \u05dc\u05e4\u05e8\u05d9\u05d3\u05d4 \u05d0\u05d5 \u05e0\u05d8\u05d9\u05e9\u05d4 \u05d4\u05de\u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05ea \u05d1\u05e4\u05d9\u05d5\u05e1 (appeasement), \u05db\u05e0\u05d9\u05e2\u05d5\u05ea \u05d5\u05d7\u05d9\u05e4\u05d5\u05e9 \u05d3\u05d7\u05d5\u05e3 \u05d0\u05d7\u05e8 \u05e7\u05e9\u05e8 \u05d7\u05dc\u05d5\u05e4\u05d9.",
          "isCorrect": true,
          "rationale": "\u05dc\u05e4\u05d9 \u05d4-DSM-5-TR, \u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd \u05e2\u05dd DPD \u05de\u05d2\u05d9\u05d1\u05d9\u05dd \u05dc\u05e0\u05d8\u05d9\u05e9\u05d4 \u05d1\u05db\u05e0\u05d9\u05e2\u05d5\u05ea \u05d5\u05d7\u05d9\u05e4\u05d5\u05e9 \u05e7\u05e9\u05e8 \u05d7\u05dc\u05d5\u05e4\u05d9, \u05d1\u05e2\u05d5\u05d3 \u05e9\u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd \u05e2\u05dd BPD \u05de\u05d2\u05d9\u05d1\u05d9\u05dd \u05d1\u05d6\u05e2\u05dd, \u05d3\u05e8\u05d9\u05e9\u05d5\u05ea \u05d5\u05ea\u05d7\u05d5\u05e9\u05ea \u05e8\u05d9\u05e7\u05e0\u05d5\u05ea \u05e8\u05d2\u05e9\u05d9\u05ea (DSM p.770)."
        },
        {
          "text": "\u05e7\u05d9\u05d5\u05de\u05d4 \u05e9\u05dc \u05e4\u05d2\u05d9\u05e2\u05d4 \u05e2\u05e6\u05de\u05d9\u05ea \u05d5\u05d0\u05d9\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05d5\u05ea \u05d1\u05ea\u05d2\u05d5\u05d1\u05d4 \u05dc\u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd \u05d1\u05dc\u05d5\u05d7 \u05d4\u05d6\u05de\u05e0\u05d9\u05dd \u05e9\u05dc \u05d4\u05de\u05d8\u05e4\u05dc.",
          "isCorrect": false,
          "rationale": "\u05e4\u05d2\u05d9\u05e2\u05d4 \u05e2\u05e6\u05de\u05d9\u05ea \u05d5\u05d0\u05d9\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05d5\u05ea \u05d4\u05df \u05ea\u05db\u05d5\u05e0\u05d5\u05ea \u05dc\u05d9\u05d1\u05d4 \u05e9\u05dc BPD \u05d5\u05dc\u05d0 \u05e9\u05dc DPD, \u05e9\u05dd \u05d4\u05d3\u05d2\u05e9 \u05d4\u05d5\u05d0 \u05e2\u05dc \u05e4\u05e1\u05d9\u05d1\u05d9\u05d5\u05ea \u05d5\u05db\u05e0\u05d9\u05e2\u05d5\u05ea (Synopsis ch.19 Personality Disorders)."
        },
        {
          "text": "\u05d3\u05e4\u05d5\u05e1 \u05e9\u05dc \u05de\u05e2\u05e8\u05db\u05d5\u05ea \u05d9\u05d7\u05e1\u05d9\u05dd \u05d0\u05d9\u05e0\u05d8\u05e0\u05e1\u05d9\u05d1\u05d9\u05d5\u05ea \u05d5\u05dc\u05d0 \u05d9\u05e6\u05d9\u05d1\u05d5\u05ea \u05d4\u05de\u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05d5\u05ea \u05d1\u05e4\u05d9\u05e6\u05d5\u05dc (Splitting).",
          "isCorrect": false,
          "rationale": "\u05e4\u05d9\u05e6\u05d5\u05dc \u05d5\u05de\u05e2\u05e8\u05db\u05d5\u05ea \u05d9\u05d7\u05e1\u05d9\u05dd \u05e1\u05d5\u05e2\u05e8\u05d5\u05ea \u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05d9\u05d9\u05dd \u05dc-BPD; \u05d1-DPD \u05de\u05e2\u05e8\u05db\u05d5\u05ea \u05d4\u05d9\u05d7\u05e1\u05d9\u05dd \u05e0\u05d5\u05d8\u05d5\u05ea \u05dc\u05d4\u05d9\u05d5\u05ea \u05d9\u05e6\u05d9\u05d1\u05d5\u05ea \u05d0\u05da \u05e4\u05ea\u05d5\u05dc\u05d5\u05d2\u05d9\u05d5\u05ea \u05d5\u05db\u05e0\u05d5\u05e2\u05d5\u05ea (DSM p.757, 770)."
        },
        {
          "text": "\u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05e9\u05dc \u05d7\u05e8\u05d3\u05ea \u05e4\u05e8\u05d9\u05d3\u05d4 (Separation Anxiety) \u05de\u05d4\u05d3\u05de\u05d5\u05d9\u05d5\u05ea \u05d4\u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05d5\u05ea.",
          "isCorrect": false,
          "rationale": "\u05d7\u05e8\u05d3\u05ea \u05e4\u05e8\u05d9\u05d3\u05d4 \u05de\u05d5\u05e4\u05d9\u05e2\u05d4 \u05d1\u05e9\u05ea\u05d9 \u05d4\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05d5\u05d0\u05d9\u05e0\u05d4 \u05de\u05d4\u05d5\u05d5\u05d4 \u05d2\u05d5\u05e8\u05dd \u05de\u05d1\u05d3\u05d9\u05dc \u05d1\u05dc\u05e2\u05d3\u05d9, \u05d0\u05dd \u05db\u05d9 \u05d1-DPD \u05d4\u05de\u05e0\u05d9\u05e2 \u05d4\u05d5\u05d0 \u05d7\u05d5\u05e1\u05e8 \u05d9\u05db\u05d5\u05dc\u05ea \u05ea\u05e4\u05e7\u05d5\u05d3\u05d9\u05ea \u05e0\u05ea\u05e4\u05e1\u05ea \u05dc\u05dc\u05d0 \u05e2\u05d6\u05e8\u05d4 (DSM p.770)."
        }
      ],
      "hint": "\u05d4\u05ea\u05de\u05e7\u05d3\u05d5 \u05d1\u05d0\u05d5\u05e4\u05d9 \u05d4\u05ea\u05d2\u05d5\u05d1\u05d4 \u05d4\u05e8\u05d2\u05e9\u05d9\u05ea \u05d5\u05d4\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea\u05d9\u05ea \u05d4\u05de\u05d9\u05d9\u05d3\u05d9\u05ea \u05e9\u05dc \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05dc\u05de\u05e6\u05d1 \u05e9\u05dc \u05d0\u05d5\u05d1\u05d3\u05df \u05e7\u05e9\u05e8 \u05d0\u05d5 \u05e0\u05d8\u05d9\u05e9\u05d4 \u05e0\u05ea\u05e4\u05e1\u05ea.",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05de\u05d8\u05d5\u05e4\u05dc \u05d1\u05df 28 \u05de\u05e6\u05d9\u05d2 \u05d3\u05e4\u05d5\u05e1 \u05e9\u05dc \u05d4\u05d9\u05de\u05e0\u05e2\u05d5\u05ea \u05de\u05de\u05d2\u05e2 \u05d7\u05d1\u05e8\u05ea\u05d9, \u05d7\u05d5\u05e1\u05e8 \u05d1\u05d9\u05d8\u05d7\u05d5\u05df \u05e2\u05e6\u05de\u05d9 \u05d5\u05e8\u05d2\u05d9\u05e9\u05d5\u05ea \u05d2\u05d1\u05d5\u05d4\u05d4 \u05dc\u05d1\u05d9\u05e7\u05d5\u05e8\u05ea. \u05d4\u05d5\u05d0 \u05de\u05d3\u05d5\u05d5\u05d7 \u05e9\u05d4\u05d5\u05d0 \u05de\u05e2\u05d5\u05e0\u05d9\u05d9\u05df \u05de\u05d0\u05d5\u05d3 \u05d1\u05e7\u05e9\u05e8\u05d9\u05dd \u05d7\u05d1\u05e8\u05ea\u05d9\u05d9\u05dd \u05d0\u05da \u05d7\u05d5\u05e9\u05e9 \u05dc\u05d4\u05d9\u05d3\u05d7\u05d5\u05ea. \u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05de\u05d1\u05d3\u05dc\u05ea, \u05de\u05d4\u05d9 \u05d4\u05e0\u05e7\u05d5\u05d3\u05d4 \u05d4\u05e7\u05e8\u05d9\u05d8\u05d9\u05ea \u05d4\u05de\u05db\u05d5\u05d5\u05e0\u05ea \u05dc\u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc Avoidant Personality Disorder \u05e2\u05dc \u05e4\u05e0\u05d9 Dependent Personality Disorder?",
      "answerOptions": [
        {
          "text": "\u05d4\u05d9\u05de\u05e0\u05e2\u05d5\u05ea \u05d5\u05d1\u05d9\u05d3\u05d5\u05d3 \u05d7\u05d1\u05e8\u05ea\u05d9 \u05d4\u05e0\u05d5\u05d1\u05e2\u05d9\u05dd \u05de\u05e4\u05d7\u05d3 \u05de\u05d4\u05e9\u05e4\u05dc\u05d4 \u05d5\u05d7\u05d5\u05e1\u05e8 \u05d4\u05ea\u05d0\u05de\u05d4 \u05d7\u05d1\u05e8\u05ea\u05d9\u05ea.",
          "isCorrect": true,
          "rationale": "\u05d1-Avoidant PD \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05e0\u05e1\u05d5\u05d2 \u05e2\u05d3 \u05e9\u05d9\u05d4\u05d9\u05d4 \u05d1\u05d8\u05d5\u05d7 \u05e9\u05d9\u05e7\u05d1\u05dc\u05d5 \u05d0\u05d5\u05ea\u05d5 \u05d1\u05e9\u05dc \u05e4\u05d7\u05d3 \u05de\u05d4\u05e9\u05e4\u05dc\u05d4, \u05d1\u05e2\u05d5\u05d3 \u05e9\u05d1-DPD \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05de\u05d7\u05e4\u05e9 \u05d5\u05de\u05ea\u05d7\u05d6\u05e7 \u05e7\u05e9\u05e8\u05d9\u05dd \u05d1\u05d0\u05d5\u05e4\u05df \u05e4\u05e2\u05d9\u05dc \u05db\u05d3\u05d9 \u05dc\u05d4\u05d9\u05de\u05e0\u05e2 \u05de\u05dc\u05d4\u05d9\u05d5\u05ea \u05dc\u05d1\u05d3 (DSM p.771)."
        },
        {
          "text": "\u05e6\u05d5\u05e8\u05da \u05e2\u05d6 \u05d1\u05d9\u05d9\u05e2\u05d5\u05e5 \u05d5\u05d0\u05d9\u05e9\u05d5\u05e8 \u05de\u05d0\u05d7\u05e8\u05d9\u05dd \u05dc\u05e4\u05e0\u05d9 \u05e7\u05d1\u05dc\u05ea \u05d4\u05d7\u05dc\u05d8\u05d5\u05ea \u05e4\u05e9\u05d5\u05d8\u05d5\u05ea.",
          "isCorrect": false,
          "rationale": "\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df \u05d6\u05d4 \u05d4\u05d5\u05d0 \u05de\u05e8\u05db\u05d6\u05d9 \u05d1-DPD \u05d5\u05de\u05d1\u05d8\u05d0 \u05d0\u05ea \u05d7\u05d5\u05e1\u05e8 \u05d4\u05d9\u05db\u05d5\u05dc\u05ea \u05dc\u05ea\u05e4\u05e7\u05d3 \u05e2\u05e6\u05de\u05d0\u05d9\u05ea, \u05d5\u05dc\u05d0 \u05d0\u05ea \u05d4\u05e4\u05d7\u05d3 \u05de\u05d3\u05d7\u05d9\u05d9\u05d4 \u05d7\u05d1\u05e8\u05ea\u05d9\u05ea \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05d4\u05d9\u05de\u05e0\u05e2\u05d5\u05ea (Synopsis ch.19 Personality Disorders)."
        },
        {
          "text": "\u05ea\u05d7\u05d5\u05e9\u05ea \u05e8\u05d9\u05e7\u05e0\u05d5\u05ea \u05d5\u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05db\u05d0\u05e9\u05e8 \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05e0\u05de\u05e6\u05d0 \u05dc\u05d1\u05d3\u05d5.",
          "isCorrect": false,
          "rationale": "\u05ea\u05d7\u05d5\u05e9\u05ea \u05d7\u05d5\u05e1\u05e8 \u05d0\u05d5\u05e0\u05d9\u05dd \u05d1\u05d1\u05d3\u05d9\u05d3\u05d5\u05ea \u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05d9\u05ea \u05dc-DPD, \u05d1\u05e2\u05d5\u05d3 \u05e9\u05d1-Avoidant PD \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05d7\u05d5\u05d5\u05d4 \u05d0\u05ea \u05d4\u05dc\u05d1\u05d3 \u05db\u05ea\u05d5\u05e6\u05d0\u05d4 \u05db\u05d5\u05d0\u05d1\u05ea \u05e9\u05dc \u05e4\u05d7\u05d3\u05d9\u05d5 \u05d0\u05da \u05dc\u05d0 \u05d1\u05d4\u05db\u05e8\u05d7 \u05db\u05d7\u05d5\u05e1\u05e8 \u05d9\u05db\u05d5\u05dc\u05ea \u05dc\u05d8\u05e4\u05dc \u05d1\u05e2\u05e6\u05de\u05d5 (DSM p.769, 771)."
        },
        {
          "text": "\u05d7\u05d5\u05e1\u05e8 \u05e2\u05e0\u05d9\u05d9\u05df \u05de\u05d5\u05e4\u05d2\u05df \u05d1\u05e7\u05e9\u05e8\u05d9\u05dd \u05d1\u05d9\u05df-\u05d0\u05d9\u05e9\u05d9\u05d9\u05dd \u05d5\u05d4\u05e2\u05d3\u05e4\u05ea \u05e4\u05e2\u05d9\u05dc\u05d5\u05d9\u05d5\u05ea \u05e1\u05d5\u05dc\u05d9\u05d8\u05e8\u05d9\u05d5\u05ea.",
          "isCorrect": false,
          "rationale": "\u05ea\u05d9\u05d0\u05d5\u05e8 \u05d6\u05d4 \u05de\u05ea\u05d0\u05d9\u05dd \u05dc-Schizoid Personality Disorder \u05d5\u05dc\u05d0 \u05dc-Avoidant \u05d0\u05d5 DPD, \u05e9\u05d1\u05d4\u05df \u05d9\u05e9 \u05e8\u05e6\u05d5\u05df \u05e2\u05d6 \u05dc\u05e7\u05e9\u05e8 (DSM p.744, 771)."
        }
      ],
