{
  "title": "Anxiety Quiz",
  "questions": [
    {
      "question": "\u05d9\u05dc\u05d3\u05d4 \u05d1\u05ea 9 \u05de\u05d5\u05e4\u05e0\u05d9\u05ea \u05dc\u05d4\u05e2\u05e8\u05db\u05d4 \u05d1\u05e9\u05dc \u05e1\u05d9\u05e8\u05d5\u05d1 \u05dc\u05dc\u05db\u05ea \u05dc\u05d1\u05d9\u05ea \u05d4\u05e1\u05e4\u05e8. \u05d4\u05d5\u05e8\u05d9\u05d4 \u05de\u05d3\u05d5\u05d5\u05d7\u05d9\u05dd \u05db\u05d9 \u05d4\u05d9\u05d0 \u05d7\u05d5\u05d5\u05d4 \u05db\u05d0\u05d1\u05d9 \u05d1\u05d8\u05df \u05d5\u05d1\u05d7\u05d9\u05dc\u05d5\u05ea \u05db\u05de\u05e2\u05d8 \u05de\u05d3\u05d9 \u05d1\u05d5\u05e7\u05e8, \u05d0\u05da \u05d0\u05dc\u05d5 \u05d7\u05d5\u05dc\u05e4\u05d9\u05dd \u05db\u05e9\u05d4\u05d9\u05d0 \u05e0\u05e9\u05d0\u05e8\u05ea \u05d1\u05d1\u05d9\u05ea. \u05d1\u05d1\u05d3\u05d9\u05e7\u05d4, \u05d4\u05d9\u05dc\u05d3\u05d4 \u05de\u05d1\u05d9\u05e2\u05d4 \u05d7\u05e9\u05e9 \u05e9\u05de\u05d0 \u05d9\u05e7\u05e8\u05d4 \u05de\u05e9\u05d4\u05d5 \u05e8\u05e2 \u05dc\u05d0\u05de\u05d4 \u05d1\u05d6\u05de\u05df \u05e9\u05d4\u05d9\u05d0 \u05d1\u05dc\u05d9\u05de\u05d5\u05d3\u05d9\u05dd, \u05d5\u05de\u05ea\u05e2\u05e7\u05e9\u05ea \u05dc\u05d9\u05e9\u05d5\u05df \u05d1\u05de\u05d9\u05d8\u05ea \u05d4\u05d4\u05d5\u05e8\u05d9\u05dd. \u05de\u05d4\u05d5 \u05de\u05e9\u05da \u05d4\u05d6\u05de\u05df \u05d4\u05de\u05d9\u05e0\u05d9\u05de\u05dc\u05d9 \u05d4\u05e0\u05d3\u05e8\u05e9 (Duration) \u05dc\u05e6\u05d5\u05e8\u05da \u05d0\u05d1\u05d7\u05e0\u05ea Separation Anxiety Disorder \u05d1\u05de\u05e7\u05e8\u05d4 \u05d6\u05d4?",
      "answerOptions": [
        {
          "text": "\u05dc\u05e4\u05d7\u05d5\u05ea 4 \u05e9\u05d1\u05d5\u05e2\u05d5\u05ea",
          "isCorrect": true,
          "rationale": "\u05dc\u05e4\u05d9 DSM-5-TR, \u05e2\u05d1\u05d5\u05e8 \u05d9\u05dc\u05d3\u05d9\u05dd \u05d5\u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd \u05de\u05ea\u05d7\u05ea \u05dc\u05d2\u05d9\u05dc 18, \u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df \u05d4\u05db\u05e8\u05d5\u05e0\u05d5\u05dc\u05d5\u05d2\u05d9 \u05dc\u05d0\u05d1\u05d7\u05e0\u05ea Separation Anxiety Disorder \u05d4\u05d5\u05d0 \u05dc\u05e4\u05d7\u05d5\u05ea 4 \u05e9\u05d1\u05d5\u05e2\u05d5\u05ea (DSM p.217)."
        },
        {
          "text": "\u05dc\u05e4\u05d7\u05d5\u05ea 6 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd",
          "isCorrect": false,
          "rationale": "\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df \u05e9\u05dc 6 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05d0\u05d5 \u05d9\u05d5\u05ea\u05e8 \u05e0\u05d3\u05e8\u05e9 \u05d1\u05d3\u05e8\u05da \u05db\u05dc\u05dc \u05e2\u05d1\u05d5\u05e8 \u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd \u05d1\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d6\u05d5, \u05d0\u05d5 \u05e2\u05d1\u05d5\u05e8 \u05d0\u05d1\u05d7\u05e0\u05d5\u05ea \u05e9\u05dc Anxiety Disorders \u05d0\u05d7\u05e8\u05d5\u05ea \u05db\u05d2\u05d5\u05df Specific Phobia (DSM p.217)."
        },
        {
          "text": "\u05dc\u05e4\u05d7\u05d5\u05ea \u05e9\u05d1\u05d5\u05e2\u05d9\u05d9\u05dd",
          "isCorrect": false,
          "rationale": "\u05de\u05e9\u05da \u05e9\u05dc \u05e9\u05d1\u05d5\u05e2\u05d9\u05d9\u05dd \u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05d0\u05e4\u05d9\u05d6\u05d5\u05d3\u05d4 \u05e9\u05dc Major Depressive Disorder \u05d0\u05da \u05d0\u05d9\u05e0\u05d5 \u05de\u05e1\u05e4\u05e7 \u05dc\u05d0\u05d1\u05d7\u05e0\u05ea \u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05d7\u05e8\u05d3\u05d4 \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd (DSM p.183)."
        },
        {
          "text": "\u05d0\u05d9\u05df \u05d3\u05e8\u05d9\u05e9\u05ea \u05d6\u05de\u05df \u05de\u05d9\u05e0\u05d9\u05de\u05dc\u05d9\u05ea \u05d0\u05dd \u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d7\u05de\u05d5\u05e8\u05d9\u05dd",
          "isCorrect": false,
          "rationale": "\u05d4-DSM \u05de\u05d7\u05d9\u05d9\u05d1 \u05de\u05e9\u05da \u05d6\u05de\u05df \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9 \u05db\u05d3\u05d9 \u05dc\u05d4\u05d1\u05d3\u05d9\u05dc \u05d1\u05d9\u05df \u05d7\u05e8\u05d3\u05d4 \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9\u05ea \u05e0\u05d5\u05e8\u05de\u05d8\u05d9\u05d1\u05d9\u05ea \u05dc\u05d1\u05d9\u05df \u05d4\u05e4\u05e8\u05e2\u05d4 \u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9\u05ea (DSM p.217)."
        }
      ],
      "hint": "\u05d1\u05d3\u05e7\u05d5 \u05d0\u05ea \u05d4\u05d4\u05d1\u05d3\u05dc \u05d1\u05d9\u05df \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df \u05d4\u05d6\u05de\u05df \u05d4\u05e0\u05d3\u05e8\u05e9 \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05dc\u05e2\u05d5\u05de\u05ea \u05d6\u05d4 \u05d4\u05e0\u05d3\u05e8\u05e9 \u05d1\u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd \u05e2\u05d1\u05d5\u05e8 \u05d4\u05e4\u05e8\u05e2\u05d4 \u05d6\u05d5."
    },
    {
      "question": "\u05d1\u05de\u05e1\u05d2\u05e8\u05ea \u05de\u05d7\u05e7\u05e8 \u05d4-Child/Adolescent Anxiety Multimodal Study (CAMS), \u05e0\u05d1\u05d3\u05e7\u05d5 \u05d0\u05e4\u05e9\u05e8\u05d5\u05d9\u05d5\u05ea \u05d8\u05d9\u05e4\u05d5\u05dc \u05e9\u05d5\u05e0\u05d5\u05ea \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d4\u05e1\u05d5\u05d1\u05dc\u05d9\u05dd \u05de-Separation Anxiety, GAD \u05d0\u05d5 Social Anxiety. \u05de\u05d4 \u05d4\u05d9\u05d5 \u05d4\u05de\u05de\u05e6\u05d0\u05d9\u05dd \u05dc\u05d2\u05d1\u05d9 \u05e9\u05d9\u05e2\u05d5\u05e8\u05d9 \u05d4\u05e9\u05d9\u05e4\u05d5\u05e8 (Improvement) \u05dc\u05d0\u05d7\u05e8 12 \u05e9\u05d1\u05d5\u05e2\u05d5\u05ea?",
      "answerOptions": [
        {
          "text": "\u05e9\u05d9\u05dc\u05d5\u05d1 \u05e9\u05dc CBT \u05d5-Sertraline \u05d4\u05e6\u05d9\u05d2 \u05e2\u05dc\u05d9\u05d5\u05e0\u05d5\u05ea \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05e2\u05dd $80.7\\%$ \u05e9\u05d9\u05e4\u05d5\u05e8",
          "isCorrect": true,
          "rationale": "\u05de\u05d7\u05e7\u05e8 \u05d4-CAMS \u05d4\u05d3\u05d2\u05d9\u05dd \u05db\u05d9 \u05d8\u05d9\u05e4\u05d5\u05dc \u05de\u05e9\u05d5\u05dc\u05d1 (Combination) \u05d4\u05d9\u05d4 \u05d9\u05e2\u05d9\u05dc \u05d9\u05d5\u05ea\u05e8 \u05de\u05db\u05dc \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05e0\u05e4\u05e8\u05d3, \u05db\u05d0\u05e9\u05e8 $80.7\\%$ \u05de\u05d4\u05d9\u05dc\u05d3\u05d9\u05dd \u05d1\u05e7\u05d1\u05d5\u05e6\u05d4 \u05d6\u05d5 \u05d3\u05d5\u05e8\u05d2\u05d5 \u05db\u05de\u05e9\u05d5\u05e4\u05e8\u05d9\u05dd \u05de\u05d0\u05d5\u05d3 (Dulcan p.330, p.974)."
        },
        {
          "text": "\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-CBT \u05dc\u05d1\u05d3\u05d5 \u05d4\u05e6\u05d9\u05d2 \u05ea\u05d5\u05e6\u05d0\u05d5\u05ea \u05d6\u05d4\u05d5\u05ea \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05de\u05e9\u05d5\u05dc\u05d1",
          "isCorrect": false,
          "rationale": "\u05d1\u05e2\u05d5\u05d3 \u05e9-CBT \u05e0\u05de\u05e6\u05d0 \u05d9\u05e2\u05d9\u05dc ($59.7\\%$), \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05de\u05e9\u05d5\u05dc\u05d1 \u05d4\u05e6\u05d9\u05d2 \u05e9\u05d9\u05e2\u05d5\u05e8\u05d9 \u05ea\u05d2\u05d5\u05d1\u05d4 \u05d2\u05d1\u05d5\u05d4\u05d9\u05dd \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea (Dulcan p.330)."
        },
        {
          "text": "Sertraline \u05e0\u05de\u05e6\u05d0\u05d4 \u05e4\u05d7\u05d5\u05ea \u05d9\u05e2\u05d9\u05dc\u05d4 \u05de-CBT \u05d1\u05d0\u05d5\u05e4\u05df \u05de\u05d5\u05d1\u05d4\u05e7",
          "isCorrect": false,
          "rationale": "\u05d1\u05de\u05d7\u05e7\u05e8 \u05d4-CAMS, \u05d4\u05d9\u05e2\u05d9\u05dc\u05d5\u05ea \u05e9\u05dc CBT \u05d5\u05e9\u05dc Sertraline \u05db\u05de\u05d5\u05e0\u05d5-\u05ea\u05e8\u05e4\u05d9\u05d4 \u05d4\u05d9\u05d9\u05ea\u05d4 \u05d3\u05d5\u05de\u05d4 \u05de\u05d0\u05d5\u05d3 ($59.7\\%$ \u05dc\u05e2\u05d5\u05de\u05ea $59.4\\%$) (Dulcan p.330)."
        },
        {
          "text": "\u05e9\u05d9\u05e2\u05d5\u05e8 \u05d4\u05ea\u05d2\u05d5\u05d1\u05d4 \u05dc-Placebo \u05d4\u05d9\u05d4 \u05d6\u05e0\u05d9\u05d7 (\u05de\u05ea\u05d7\u05ea \u05dc-$5\\%$ )",
          "isCorrect": false,
          "rationale": "\u05e9\u05d9\u05e2\u05d5\u05e8 \u05d4\u05ea\u05d2\u05d5\u05d1\u05d4 \u05dc-Placebo \u05d1\u05de\u05d7\u05e7\u05e8 \u05e2\u05de\u05d3 \u05e2\u05dc $23.7\\%$, \u05e0\u05ea\u05d5\u05df \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9 \u05e9\u05d9\u05e9 \u05dc\u05e7\u05d7\u05ea \u05d1\u05d7\u05e9\u05d1\u05d5\u05df (Dulcan p.974)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d1\u05d5 \u05e2\u05dc \u05d4\u05d9\u05ea\u05e8\u05d5\u05df \u05e9\u05dc \u05e9\u05d9\u05dc\u05d5\u05d1 \u05d6\u05e8\u05d5\u05e2\u05d5\u05ea \u05d8\u05d9\u05e4\u05d5\u05dc\u05d9\u05d5\u05ea \u05e9\u05d5\u05e0\u05d5\u05ea \u05d1\u05de\u05d7\u05e7\u05e8 \u05d4\u05dc\u05d9\u05d1\u05d4 \u05d4\u05d2\u05d3\u05d5\u05dc \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d1\u05ea\u05d7\u05d5\u05dd."
    },
    {
      "question": "\u05e0\u05e2\u05e8 \u05d1\u05df 14 \u05d7\u05d5\u05d5\u05d4 \u05e4\u05d7\u05d3 \u05e7\u05d9\u05e6\u05d5\u05e0\u05d9 \u05de\u05d8\u05d9\u05e1\u05d5\u05ea. \u05d4\u05d5\u05d0 \u05e0\u05de\u05e0\u05e2 \u05de\u05d8\u05d9\u05d5\u05dc \u05de\u05e9\u05e4\u05d7\u05ea\u05d9 \u05dc\u05d7\u05d5\"\u05dc \u05d5\u05de\u05d3\u05d5\u05d5\u05d7 \u05db\u05d9 \u05d4\u05de\u05d7\u05e9\u05d1\u05d4 \u05e2\u05dc \u05de\u05d8\u05d5\u05e1 \u05de\u05e2\u05d5\u05e8\u05e8\u05ea \u05d1\u05d5 \u05d3\u05e4\u05d9\u05e7\u05d5\u05ea \u05dc\u05d1 \u05d5\u05e7\u05d5\u05e6\u05e8 \u05e0\u05e9\u05d9\u05de\u05d4 \u05de\u05d9\u05d9\u05d3\u05d9. \u05d1\u05d1\u05d3\u05d9\u05e7\u05d4 \u05e2\u05d5\u05dc\u05d4 \u05db\u05d9 \u05d4\u05e4\u05d7\u05d3 \u05e0\u05d5\u05d1\u05e2 \u05de\u05d4\u05d7\u05e9\u05e9 \u05e9\u05d4\u05de\u05d8\u05d5\u05e1 \u05d9\u05ea\u05e8\u05e1\u05e7, \u05d5\u05dc\u05d0 \u05de\u05d7\u05e9\u05e9 \u05e9\u05dc\u05d0 \u05d9\u05d5\u05db\u05dc \u05dc\u05d4\u05d9\u05de\u05dc\u05d8 \u05d0\u05d5 \u05dc\u05e7\u05d1\u05dc \u05e2\u05d6\u05e8\u05d4 \u05d1\u05de\u05e7\u05e8\u05d4 \u05e9\u05dc \u05d4\u05ea\u05e7\u05e3 \u05e4\u05d0\u05e0\u05d9\u05e7\u05d4. \u05de\u05d4\u05d9 \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05de\u05ea\u05d0\u05d9\u05de\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8?",
      "answerOptions": [
        {
          "text": "Specific Phobia, situational type",
          "isCorrect": true,
          "rationale": "\u05db\u05d0\u05e9\u05e8 \u05d4\u05e4\u05d7\u05d3 \u05de\u05d5\u05d2\u05d3\u05e8 \u05dc\u05de\u05e6\u05d1 \u05d0\u05d7\u05d3 (\u05d8\u05d9\u05e1\u05d4) \u05d5\u05d4\u05ea\u05d5\u05db\u05df \u05d4\u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9 \u05e0\u05d5\u05d2\u05e2 \u05dc\u05e1\u05db\u05e0\u05d4 \u05de\u05d4\u05de\u05e6\u05d1 \u05e2\u05e6\u05de\u05d5 (\u05d4\u05ea\u05e8\u05e1\u05e7\u05d5\u05ea), \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05d9\u05d0 \u05e4\u05d5\u05d1\u05d9\u05d4 \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05ea \u05d5\u05dc\u05d0 \u05d0\u05d2\u05d5\u05e8\u05e4\u05d5\u05d1\u05d9\u05d4 (DSM p.228)."
        },
        {
          "text": "Agoraphobia",
          "isCorrect": false,
          "rationale": "\u05d0\u05d2\u05d5\u05e8\u05e4\u05d5\u05d1\u05d9\u05d4 \u05d3\u05d5\u05e8\u05e9\u05ea \u05e4\u05d7\u05d3 \u05de\u05e9\u05e0\u05d9 \u05de\u05e6\u05d1\u05d9\u05dd \u05dc\u05e4\u05d7\u05d5\u05ea, \u05d5\u05d4\u05e7\u05d5\u05d2\u05e0\u05d9\u05e6\u05d9\u05d4 \u05d4\u05de\u05e8\u05db\u05d6\u05d9\u05ea \u05e0\u05d5\u05d2\u05e2\u05ea \u05dc\u05e7\u05d5\u05e9\u05d9 \u05dc\u05d4\u05d9\u05de\u05dc\u05d8 \u05d0\u05d5 \u05dc\u05e7\u05d1\u05dc \u05e2\u05d6\u05e8\u05d4 \u05d1\u05e2\u05ea \u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05de\u05d1\u05d9\u05db\u05d9\u05dd/\u05e4\u05d0\u05e0\u05d9\u05e7\u05d4 (DSM p.228)."
        },
        {
          "text": "Panic Disorder",
          "isCorrect": false,
          "rationale": "\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d6\u05d5 \u05d3\u05d5\u05e8\u05e9\u05ea \u05d4\u05ea\u05e7\u05e4\u05d9 \u05e4\u05d0\u05e0\u05d9\u05e7\u05d4 \u05d1\u05dc\u05ea\u05d9 \u05e6\u05e4\u05d5\u05d9\u05d9\u05dd (Unexpected), \u05d1\u05e2\u05d5\u05d3 \u05db\u05d0\u05df \u05d4\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05de\u05d5\u05e4\u05d9\u05e2\u05d9\u05dd \u05e8\u05e7 \u05d1\u05ea\u05d2\u05d5\u05d1\u05d4 \u05dc\u05d2\u05d9\u05e8\u05d5\u05d9 \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9 (DSM p.229)."
        },
        {
          "text": "Social Anxiety Disorder",
          "isCorrect": false,
          "rationale": "\u05d7\u05e8\u05d3\u05d4 \u05d7\u05d1\u05e8\u05ea\u05d9\u05ea \u05de\u05ea\u05de\u05e7\u05d3\u05ea \u05d1\u05e9\u05d9\u05e4\u05d5\u05d8 \u05e9\u05dc\u05d9\u05dc\u05d9 \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d0\u05d7\u05e8\u05d9\u05dd, \u05d3\u05d1\u05e8 \u05e9\u05d0\u05d9\u05e0\u05d5 \u05de\u05d5\u05e4\u05d9\u05e2 \u05d1\u05ea\u05d9\u05d0\u05d5\u05e8 \u05d4\u05de\u05e7\u05e8\u05d4 (DSM p.228)."
        }
      ],
      "hint": "\u05d4\u05ea\u05de\u05e7\u05d3\u05d5 \u05d1\u05de\u05e1\u05e4\u05e8 \u05d4\u05de\u05e6\u05d1\u05d9\u05dd \u05d4\u05de\u05e4\u05d7\u05d9\u05d3\u05d9\u05dd \u05d5\u05d1\u05ea\u05d5\u05db\u05df \u05d4\u05de\u05d7\u05e9\u05d1\u05ea\u05d9 \u05d4\u05e2\u05d5\u05de\u05d3 \u05d1\u05d1\u05e1\u05d9\u05e1 \u05d4\u05d7\u05e8\u05d3\u05d4."
    },
    {
      "question": "\u05d1\u05d1\u05d5\u05d0\u05e0\u05d5 \u05dc\u05d4\u05d1\u05d3\u05d9\u05dc \u05d1\u05d9\u05df Separation Anxiety Disorder \u05dc\u05d1\u05d9\u05df Conduct Disorder \u05d1\u05d9\u05dc\u05d3 \u05e9\u05e0\u05de\u05e0\u05e2 \u05de\u05d4\u05d2\u05e2\u05d4 \u05dc\u05d1\u05d9\u05ea \u05d4\u05e1\u05e4\u05e8, \u05de\u05d4\u05d5 \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9 \u05d4\u05de\u05d1\u05d3\u05d9\u05dc \u05d4\u05e2\u05d9\u05e7\u05e8\u05d9 \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR?",
      "answerOptions": [
        {
          "text": "\u05d1-Separation Anxiety \u05d4\u05d9\u05dc\u05d3 \u05d1\u05d3\u05e8\u05da \u05db\u05dc\u05dc \u05d7\u05d5\u05d6\u05e8 \u05d4\u05d1\u05d9\u05ea\u05d4, \u05d1\u05e2\u05d5\u05d3 \u05d1-Conduct Disorder \u05d4\u05d5\u05d0 \u05e0\u05e9\u05d0\u05e8 \u05e8\u05d7\u05d5\u05e7 \u05de\u05d4\u05d1\u05d9\u05ea",
          "isCorrect": true,
          "rationale": "\u05d1\u05d7\u05e8\u05d3\u05ea \u05e4\u05e8\u05d9\u05d3\u05d4, \u05d4\u05d4\u05d9\u05de\u05e0\u05e2\u05d5\u05ea \u05de\u05d1\u05d9\u05ea \u05d4\u05e1\u05e4\u05e8 \u05e0\u05d5\u05d1\u05e2\u05ea \u05de\u05d4\u05e6\u05d5\u05e8\u05da \u05d1\u05e7\u05e8\u05d1\u05d4 \u05dc\u05d3\u05de\u05d5\u05ea \u05d4\u05d4\u05d9\u05e7\u05e9\u05e8\u05d5\u05ea, \u05d1\u05e2\u05d5\u05d3 \u05e9\u05d1\u05d4\u05e4\u05e8\u05e2\u05ea \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea (Truancy), \u05d4\u05d9\u05dc\u05d3 \u05d1\u05d3\u05e8\u05da \u05db\u05dc\u05dc \u05de\u05e1\u05ea\u05d9\u05e8 \u05d0\u05ea \u05d4\u05d9\u05e2\u05d3\u05e8\u05d5\u05ea\u05d5 \u05d5\u05e0\u05de\u05e0\u05e2 \u05de\u05d4\u05d1\u05d9\u05ea (DSM p.221)."
        },
        {
          "text": "\u05e8\u05e7 \u05d1-Conduct Disorder \u05d9\u05e9 \u05e7\u05d5\u05de\u05d5\u05e8\u05d1\u05d9\u05d3\u05d9\u05d5\u05ea \u05e2\u05dd \u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05de\u05e6\u05d1 \u05e8\u05d5\u05d7",
          "isCorrect": false,
          "rationale": "\u05d7\u05e8\u05d3\u05ea \u05e4\u05e8\u05d9\u05d3\u05d4 \u05e7\u05e9\u05d5\u05e8\u05d4 \u05dc\u05e2\u05d9\u05ea\u05d9\u05dd \u05e7\u05e8\u05d5\u05d1\u05d5\u05ea \u05dc\u05d3\u05d9\u05db\u05d0\u05d5\u05df, \u05d1\u05de\u05d9\u05d5\u05d7\u05d3 \u05d1\u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd \u05d5\u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd (DSM p.221)."
        },
        {
          "text": "\u05d1-Separation Anxiety \u05d4\u05e4\u05d7\u05d3 \u05d4\u05d5\u05d0 \u05e8\u05e7 \u05de\u05d4\u05de\u05d5\u05e8\u05d9\u05dd, \u05d1\u05e2\u05d5\u05d3 \u05d1-Conduct Disorder \u05d9\u05e9 \u05d6\u05dc\u05d6\u05d5\u05dc \u05d1\u05e1\u05de\u05db\u05d5\u05ea",
          "isCorrect": false,
          "rationale": "\u05d1\u05d7\u05e8\u05d3\u05ea \u05e4\u05e8\u05d9\u05d3\u05d4 \u05d4\u05e4\u05d7\u05d3 \u05d4\u05d5\u05d0 \u05de\u05d4\u05e4\u05e8\u05d9\u05d3\u05d4 \u05de\u05d3\u05de\u05d5\u05d9\u05d5\u05ea \u05d4\u05d4\u05d9\u05e7\u05e9\u05e8\u05d5\u05ea \u05d5\u05dc\u05d0 \u05d1\u05d4\u05db\u05e8\u05d7 \u05de\u05d4\u05e6\u05d5\u05d5\u05ea \u05d4\u05d7\u05d9\u05e0\u05d5\u05db\u05d9 (DSM p.217)."
        },
        {
          "text": "\u05d0\u05d1\u05d7\u05e0\u05ea Conduct Disorder \u05de\u05d7\u05d9\u05d9\u05d1\u05ea \u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05e9\u05dc \u05d4\u05d6\u05d9\u05d5\u05ea",
          "isCorrect": false,
          "rationale": "\u05d4\u05e4\u05e8\u05e2\u05ea \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d4\u05d9\u05d0 \u05d4\u05e4\u05e8\u05e2\u05d4 \u05d0\u05e7\u05e1\u05d8\u05e8\u05e0\u05dc\u05d9\u05e1\u05d8\u05d9\u05ea \u05d5\u05d0\u05d9\u05e0\u05d4 \u05db\u05d5\u05dc\u05dc\u05ea \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9\u05d9\u05dd \u05db\u05d7\u05dc\u05e7 \u05de\u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd (DSM p.530)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d1\u05d5 \u05dc\u05d0\u05df \u05d4\u05d9\u05dc\u05d3 \u05d4\u05d5\u05dc\u05da \u05db\u05e9\u05d4\u05d5\u05d0 \u05dc\u05d0 \u05e0\u05de\u05e6\u05d0 \u05d1\u05d1\u05d9\u05ea \u05d4\u05e1\u05e4\u05e8."
    },
    {
      "question": "\u05dc\u05e4\u05d9 StahlKids \u05d5-Dulcan, \u05de\u05d4\u05d5 \u05d4\u05d4\u05d1\u05d3\u05dc \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05d1\u05d8\u05d9\u05e4\u05d5\u05dc \u05ea\u05e8\u05d5\u05e4\u05ea\u05d9 \u05d1-Anxiety Disorders \u05d1\u05d9\u05df \u05e7\u05d1\u05d5\u05e6\u05ea \u05d4-SSRIs \u05dc\u05d1\u05d9\u05df \u05e7\u05d1\u05d5\u05e6\u05ea \u05d4-SNRIs?",
      "answerOptions": [
        {
          "text": "SSRIs \u05de\u05e6\u05d9\u05d2\u05d9\u05dd \u05e9\u05d9\u05e4\u05d5\u05e8 \u05de\u05d4\u05d9\u05e8 \u05d5\u05d2\u05d3\u05d5\u05dc \u05d9\u05d5\u05ea\u05e8, \u05db\u05d0\u05e9\u05e8 \u05d4\u05de\u05e1\u05dc\u05d5\u05dc\u05d9\u05dd \u05e0\u05e4\u05e8\u05d3\u05d9\u05dd \u05db\u05d1\u05e8 \u05d1\u05e9\u05d1\u05d5\u05e2 \u05d4-4",
          "isCorrect": true,
          "rationale": "\u05dc\u05e4\u05d9 \u05d4\u05de\u05d8\u05d4-\u05d0\u05e0\u05dc\u05d9\u05d6\u05d4 \u05d4\u05de\u05e6\u05d5\u05d8\u05d8\u05ea, SSRIs \u05de\u05d9\u05d9\u05e6\u05e8\u05d9\u05dd \u05e9\u05d9\u05e4\u05d5\u05e8 \u05de\u05d4\u05d9\u05e8 \u05d5\u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9 \u05d9\u05d5\u05ea\u05e8 \u05de-SNRIs, \u05d5\u05d4\u05d4\u05d1\u05d3\u05dc \u05d1\u05d9\u05e0\u05d9\u05d4\u05dd \u05d4\u05d5\u05e4\u05da \u05e0\u05d9\u05db\u05e8 \u05e1\u05d1\u05d9\u05d1 \u05d4\u05e9\u05d1\u05d5\u05e2 \u05d4\u05e8\u05d1\u05d9\u05e2\u05d9 \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc (Dulcan p.331)."
        },
        {
          "text": "SNRIs \u05d4\u05dd \u05d4\u05e7\u05d5 \u05d4\u05e8\u05d0\u05e9\u05d5\u05df \u05d1\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05e9\u05dc \u05e4\u05e8\u05d5\u05e4\u05d9\u05dc \u05ea\u05d5\u05e4\u05e2\u05d5\u05ea \u05dc\u05d5\u05d5\u05d0\u05d9 \u05d1\u05d8\u05d5\u05d7 \u05d9\u05d5\u05ea\u05e8",
          "isCorrect": false,
          "rationale": "SSRIs \u05e0\u05d7\u05e9\u05d1\u05d9\u05dd \u05dc\u05e7\u05d5 \u05e8\u05d0\u05e9\u05d5\u05df (First-line) \u05d1\u05e9\u05dc \u05d9\u05e2\u05d9\u05dc\u05d5\u05ea \u05de\u05d5\u05db\u05d7\u05ea \u05d5\u05e1\u05d1\u05d9\u05dc\u05d5\u05ea \u05d8\u05d5\u05d1\u05d4 \u05d9\u05d5\u05ea\u05e8 \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd (Dulcan p.330, StahlKids p.163)."
        },
        {
          "text": "\u05e8\u05e7 SNRIs \u05d3\u05d5\u05e8\u05e9\u05d9\u05dd \u05e0\u05d9\u05d8\u05d5\u05e8 \u05e9\u05dc \u05dc\u05d7\u05e5 \u05d3\u05dd (Blood Pressure)",
          "isCorrect": false,
          "rationale": "\u05d0\u05de\u05e0\u05dd SNRIs \u05de\u05d7\u05d9\u05d9\u05d1\u05d9\u05dd \u05e0\u05d9\u05d8\u05d5\u05e8 \u05dc\u05d7\u05e5 \u05d3\u05dd, \u05d0\u05da \u05d4\u05d1\u05d3\u05dc \u05d4\u05d9\u05e2\u05d9\u05dc\u05d5\u05ea \u05dc\u05d8\u05d5\u05d1\u05ea SSRIs \u05d4\u05d5\u05d0 \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9 \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05e9\u05e6\u05d5\u05d9\u05df (Dulcan p.331, StahlKids p.487)."
        },
        {
          "text": "\u05d0\u05d9\u05df \u05d4\u05d1\u05d3\u05dc \u05de\u05d5\u05d1\u05d4\u05e7 \u05d1\u05d9\u05e2\u05d9\u05dc\u05d5\u05ea \u05d0\u05d5 \u05d1\u05de\u05d4\u05d9\u05e8\u05d5\u05ea \u05d4\u05ea\u05d2\u05d5\u05d1\u05d4 \u05d1\u05d9\u05e0\u05d9\u05d4\u05df",
          "isCorrect": false,
          "rationale": "\u05de\u05d7\u05e7\u05e8\u05d9\u05dd \u05de\u05e6\u05d1\u05d9\u05e2\u05d9\u05dd \u05e2\u05dc \u05db\u05da \u05e9-SSRIs \u05e2\u05d3\u05d9\u05e4\u05d9\u05dd \u05d1\u05de\u05d4\u05d9\u05e8\u05d5\u05ea \u05d5\u05d1\u05e2\u05d5\u05e6\u05de\u05ea \u05d4\u05ea\u05d2\u05d5\u05d1\u05d4 \u05d1\u05d7\u05e8\u05d3\u05d4 \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd (Dulcan p.331)."
        }
      ],
      "hint": "\u05e9\u05d9\u05de\u05d5 \u05dc\u05d1 \u05dc\u05e6\u05d9\u05e8 \u05d4\u05d6\u05de\u05df \u05e9\u05dc \u05d4\u05ea\u05d2\u05d5\u05d1\u05d4 \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc\u05d9\u05ea \u05d1\u05de\u05d7\u05e7\u05e8\u05d9\u05dd \u05d4\u05e9\u05d5\u05d5\u05d0\u05ea\u05d9\u05d9\u05dd."
    },
    {
      "question": "\u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05e2\u05e8\u05db\u05d4 \u05e9\u05dc \u05de\u05ea\u05d1\u05d2\u05e8 \u05e2\u05dd \u05ea\u05e1\u05de\u05d9\u05e0\u05d9 \u05d7\u05e8\u05d3\u05d4 \u05d5\u05d3\u05d5\u05e4\u05e7 \u05de\u05d4\u05d9\u05e8 (Tachycardia), \u05e2\u05d5\u05dc\u05d4 \u05e9\u05d0\u05dc\u05d4 \u05dc\u05d2\u05d1\u05d9 \u05d1\u05d9\u05e8\u05d5\u05e8 \u05d2\u05d5\u05e4\u05e0\u05d9. \u05dc\u05e4\u05d9 Dulcan, \u05de\u05d4\u05d9 \u05d4\u05d2\u05d9\u05e9\u05d4 \u05d4\u05de\u05d5\u05de\u05dc\u05e6\u05ea \u05dc\u05d2\u05d1\u05d9 \u05d1\u05d3\u05d9\u05e7\u05ea TSH \u05d1\u05de\u05e7\u05e8\u05d4 \u05d6\u05d4?",
      "answerOptions": [
        {
          "text": "\u05de\u05d5\u05de\u05dc\u05e5 \u05dc\u05d1\u05e6\u05e2 \u05d1\u05d3\u05d9\u05e7\u05d4 \u05de\u05d5\u05db\u05d5\u05d5\u05e0\u05ea (Targeted) \u05e2\u05dc \u05d1\u05e1\u05d9\u05e1 \u05d2\u05d5\u05e8\u05de\u05d9 \u05e1\u05d9\u05db\u05d5\u05df \u05d5\u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4, \u05d5\u05dc\u05d0 \u05db\u05e1\u05e7\u05e8 \u05d0\u05d5\u05e0\u05d9\u05d1\u05e8\u05e1\u05dc\u05d9",
          "isCorrect": true,
          "rationale": "\u05e0\u05ea\u05d5\u05e0\u05d9\u05dd \u05de\u05e8\u05d0\u05d9\u05dd \u05db\u05d9 \u05e8\u05e7 \u05e4\u05d7\u05d5\u05ea \u05de-$1\\%$ \u05de\u05d4\u05d9\u05dc\u05d3\u05d9\u05dd \u05d4\u05de\u05d0\u05d5\u05e9\u05e4\u05d6\u05d9\u05dd \u05e2\u05dd \u05d7\u05e8\u05d3\u05d4/\u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05e1\u05d5\u05d1\u05dc\u05d9\u05dd \u05de\u05de\u05d7\u05dc\u05ea \u062a\u05d0\u05d9\u05e8\u05d5\u05d0\u05d9\u05d3, \u05d5\u05dc\u05db\u05df \u05e1\u05e7\u05e8 \u05d0\u05d5\u05e0\u05d9\u05d1\u05e8\u05e1\u05dc\u05d9 \u05d4\u05d5\u05d0 \u05d1\u05e2\u05dc \u05ea\u05e9\u05d5\u05d0\u05d4 \u05e0\u05de\u05d5\u05db\u05d4 (Dulcan p.329)."
        },
        {
          "text": "\u05d9\u05e9 \u05dc\u05d1\u05e6\u05e2 \u05d1\u05d3\u05d9\u05e7\u05ea TSH \u05d5-T4 \u05d7\u05d5\u05e4\u05e9\u05d9 \u05d1\u05db\u05dc \u05de\u05e7\u05e8\u05d4 \u05e9\u05dc \u05d3\u05d5\u05e4\u05e7 \u05de\u05e2\u05dc 100",
          "isCorrect": false,
          "rationale": "\u05d4\u05d4\u05de\u05dc\u05e6\u05d4 \u05d4\u05d9\u05d0 \u05dc\u05d4\u05ea\u05d1\u05e1\u05e1 \u05e2\u05dc \u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4 \u05e8\u05dc\u05d5\u05d5\u05e0\u05d8\u05d9\u05ea (\u05db\u05de\u05d5 \u05e9\u05d9\u05e0\u05d5\u05d9\u05d9 \u05de\u05e9\u05e7\u05dc \u05d0\u05d5 \u05de\u05d7\u05d6\u05d5\u05e8) \u05d5\u05dc\u05d0 \u05e8\u05e7 \u05e2\u05dc \u05de\u05de\u05e6\u05d0 \u05e4\u05d9\u05d6\u05d9\u05e7\u05dc\u05d9 \u05d1\u05d5\u05d3\u05d3 (Dulcan p.329)."
        },
        {
          "text": "\u05d1\u05d3\u05d9\u05e7\u05ea TSH \u05d4\u05d9\u05d0 \u05d7\u05d5\u05d1\u05d4 \u05dc\u05e4\u05e0\u05d9 \u05d4\u05ea\u05d7\u05dc\u05ea \u05db\u05dc SSRI",
          "isCorrect": false,
          "rationale": "\u05d0\u05d9\u05df \u05d4\u05e0\u05d7\u05d9\u05d4 \u05d2\u05d5\u05e8\u05e4\u05ea \u05db\u05d6\u05d5 \u05d1-StahlKids \u05d0\u05d5 \u05d1-Dulcan \u05e2\u05d1\u05d5\u05e8 \u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd \u05d1\u05e8\u05d9\u05d0\u05d9\u05dd \u05d1\u05d3\u05e8\u05da \u05db\u05dc\u05dc (StahlKids p.433)."
        },
        {
          "text": "Tachycardia \u05d1\u05d7\u05e8\u05d3\u05d4 \u05d4\u05d9\u05d0 \u05ea\u05de\u05d9\u05d3 \u05e4\u05e1\u05d9\u05db\u05d5\u05d2\u05e0\u05d9\u05ea \u05d5\u05d0\u05d9\u05e0\u05d4 \u05de\u05e6\u05e8\u05d9\u05db\u05d4 \u05d1\u05d9\u05e8\u05d5\u05e8",
          "isCorrect": false,
          "rationale": "\u05d0\u05de\u05e0\u05dd \u05e0\u05d3\u05d9\u05e8, \u05d0\u05da \u05d9\u05e9 \u05dc\u05e9\u05dc\u05d5\u05dc \u05e1\u05d9\u05d1\u05d5\u05ea \u05e8\u05e4\u05d5\u05d0\u05d9\u05d5\u05ea \u05e2\u05dc \u05d1\u05e1\u05d9\u05e1 \u05d2\u05d5\u05e8\u05de\u05d9 \u05e1\u05d9\u05db\u05d5\u05df \u05d5\u05d1\u05d3\u05d9\u05e7\u05d4 \u05d2\u05d5\u05e4\u05e0\u05d9\u05ea (Dulcan p.329)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d1\u05d5 \u05e2\u05dc \u05d4\u05d9\u05e2\u05d9\u05dc\u05d5\u05ea \u05d5\u05d4\u05ea\u05e9\u05d5\u05d0\u05d4 (Yield) \u05e9\u05dc \u05d1\u05d3\u05d9\u05e7\u05d5\u05ea \u05de\u05e2\u05d1\u05d3\u05d4 \u05e9\u05d2\u05e8\u05ea\u05d9\u05d5\u05ea \u05d1\u05d0\u05d5\u05db\u05dc\u05d5\u05e1\u05d9\u05d9\u05d4 \u05d6\u05d5."
    },
    {
      "question": "\u05de\u05d4\u05d5 \u05d4\u05de\u05e8\u05db\u05d9\u05d1 \u05d4\u05e7\u05e8\u05d9\u05d8\u05d9 \u05d1\u05d9\u05d5\u05ea\u05e8 (Crucial ingredient) \u05d1\u05d8\u05d9\u05e4\u05d5\u05dc CBT \u05e2\u05d1\u05d5\u05e8 Anxiety Disorders \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd, \u05d0\u05e9\u05e8 \u05de\u05e0\u05d1\u05d0 \u05e9\u05d9\u05e4\u05d5\u05e8 \u05e7\u05dc\u05d9\u05e0\u05d9 \u05dc\u05e4\u05d9 \u05de\u05d7\u05e7\u05e8\u05d9\u05dd \u05e2\u05d3\u05db\u05e0\u05d9\u05d9\u05dd?",
      "answerOptions": [
        {
          "text": "\u05ea\u05e8\u05d2\u05d5\u05dc \u05d7\u05e9\u05d9\u05e4\u05d4 (Exposure practice)",
          "isCorrect": true,
          "rationale": "\u05e7\u05d9\u05d9\u05de\u05ea \u05d4\u05e1\u05db\u05de\u05d4 \u05e8\u05d7\u05d1\u05d4 \u05e9\u05d7\u05e9\u05d9\u05e4\u05d4 \u05d4\u05d9\u05d0 \u05d4\u05de\u05e8\u05db\u05d9\u05d1 \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05d5\u05d4\u05d7\u05d9\u05d5\u05e0\u05d9 \u05dc\u05d4\u05e6\u05dc\u05d7\u05ea \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc, \u05db\u05d0\u05e9\u05e8 \u05de\u05e1\u05e4\u05e8 \u05d4\u05de\u05e4\u05d2\u05e9\u05d9\u05dd \u05d5\u05de\u05e9\u05da \u05d4\u05ea\u05e8\u05d2\u05d5\u05dc \u05de\u05e0\u05d1\u05d0\u05d9\u05dd \u05d0\u05ea \u05d4\u05e9\u05d9\u05e4\u05d5\u05e8 (Dulcan p.336, p.968)."
        },
        {
          "text": "\u05e8\u05d4-\u05e1\u05d8\u05e8\u05d5\u05e7\u05d8\u05d5\u05e8\u05d9\u05d6\u05e6\u05d9\u05d4 \u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9\u05ea (Cognitive restructuring)",
          "isCorrect": false,
          "rationale": "\u05d0\u05de\u05e0\u05dd \u05d7\u05e9\u05d5\u05d1, \u05d0\u05da \u05de\u05d7\u05e7\u05e8\u05d9\u05dd \u05d4\u05e8\u05d0\u05d5 \u05e9\u05e0\u05d9\u05ea\u05df \u05dc\u05d5\u05d5\u05ea\u05e8 \u05e2\u05dc\u05d9\u05d5 \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05e6\u05e2\u05d9\u05e8\u05d9\u05dd \u05de\u05d1\u05dc\u05d9 \u05dc\u05e4\u05d2\u05d5\u05e2 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05d1\u05d9\u05e2\u05d9\u05dc\u05d5\u05ea \u05d4\u05db\u05d5\u05dc\u05dc\u05ea \u05e9\u05dc \u05d4-CBT (Dulcan p.975)."
        },
        {
          "text": "\u05d0\u05d9\u05de\u05d5\u05df \u05dc\u05d4\u05e8\u05e4\u05d9\u05d9\u05ea \u05e9\u05e8\u05d9\u05e8\u05d9\u05dd (Relaxation training)",
          "isCorrect": false,
          "rationale": "\u05d4\u05e8\u05e4\u05d9\u05d4 \u05d4\u05d9\u05d0 \u05de\u05e8\u05db\u05d9\u05d1 \u05d1\u05ea\u05d5\u05db\u05e0\u05d9\u05d5\u05ea \u05e8\u05d1\u05d5\u05ea (\u05db\u05de\u05d5 Coping Cat), \u05d0\u05da \u05d4\u05d9\u05d0 \u05d0\u05d9\u05e0\u05d4 \u05e0\u05d7\u05e9\u05d1\u05ea \u05dc\u05de\u05e8\u05db\u05d9\u05d1 \u05d4\u05dc\u05d9\u05d1\u05d4 \u05d4\u05de\u05e0\u05d1\u05d0 \u05d0\u05ea \u05d4\u05e9\u05d9\u05e0\u05d5\u05d9 \u05d1\u05d7\u05e8\u05d3\u05d4 (Dulcan p.974)."
        },
        {
          "text": "\u05de\u05e2\u05d5\u05e8\u05d1\u05d5\u05ea \u05d4\u05d5\u05e8\u05d9\u05dd \u05d1\u05dc\u05e2\u05d3\u05d9\u05ea \u05dc\u05dc\u05d0 \u05d4\u05e9\u05ea\u05ea\u05e4\u05d5\u05ea \u05d4\u05d9\u05dc\u05d3",
          "isCorrect": false,
          "rationale": "\u05de\u05e2\u05d5\u05e8\u05d1\u05d5\u05ea \u05d4\u05d5\u05e8\u05d9\u05dd \u05d7\u05e9\u05d5\u05d1\u05d4, \u05d1\u05de\u05d9\u05d5\u05d7\u05d3 \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05e6\u05e2\u05d9\u05e8\u05d9\u05dd, \u05d0\u05da \u05e2\u05d1\u05d5\u05d3\u05d4 \u05d9\u05e9\u05d9\u05e8\u05d4 \u05e2\u05dd \u05d4\u05d9\u05dc\u05d3 \u05e2\u05dc \u05d7\u05e9\u05d9\u05e4\u05d5\u05ea \u05d4\u05d9\u05d0 \u05d4\u05e1\u05d8\u05e0\u05d3\u05e8\u05d8 (Dulcan p.975)."
        }
      ],
      "hint": "\u05d7\u05e4\u05e9\u05d5 \u05d0\u05ea \u05d4\u05e4\u05e2\u05d5\u05dc\u05d4 \u05d4\u05db\u05e8\u05d5\u05db\u05d4 \u05d1\u05de\u05d2\u05e2 \u05d9\u05e9\u05d9\u05e8 \u05e2\u05dd \u05d4\u05d2\u05d9\u05e8\u05d5\u05d9 \u05d4\u05de\u05e4\u05d7\u05d9\u05d3."
    },
    {
      "question": "\u05dc\u05e4\u05d9 \u05d4-DSM-5-TR, \u05de\u05d4 \u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05d0\u05ea \u05d4\u05e9\u05db\u05d9\u05d7\u05d5\u05ea (Prevalence) \u05e9\u05dc Separation Anxiety Disorder \u05d1\u05de\u05e2\u05d1\u05e8 \u05de\u05d9\u05dc\u05d3\u05d5\u05ea \u05dc\u05d1\u05d2\u05e8\u05d5\u05ea?",
      "answerOptions": [
        {
          "text": "\u05d4\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d9\u05d5\u05e8\u05d3\u05ea \u05db\u05db\u05dc \u05e9\u05e2\u05d5\u05dc\u05d9\u05dd \u05d1\u05d2\u05d9\u05dc, \u05de- $4\\%$ \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05dc-$1.6\\%$ \u05d1\u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd \u05d5\u05e2\u05d3 \u05e4\u05d7\u05d5\u05ea \u05de-$1.9\\%$ \u05d1\u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd",
          "isCorrect": true,
          "rationale": "\u05d4\u05e0\u05ea\u05d5\u05e0\u05d9\u05dd \u05d4\u05d0\u05e4\u05d9\u05d3\u05de\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05d9\u05dd \u05de\u05e6\u05d1\u05d9\u05e2\u05d9\u05dd \u05e2\u05dc \u05d9\u05e8\u05d9\u05d3\u05d4 \u05d4\u05d3\u05e8\u05d2\u05ea\u05d9\u05ea \u05d1\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d4\u05d4\u05e4\u05e8\u05e2\u05d4 \u05e2\u05dd \u05d4\u05d2\u05d9\u05dc (DSM p.218)."
        },
        {
          "text": "\u05d4\u05e4\u05e8\u05e2\u05d4 \u05d6\u05d5 \u05e7\u05d9\u05d9\u05de\u05ea \u05d1\u05d9\u05dc\u05d3\u05d5\u05ea \u05d1\u05dc\u05d1\u05d3 \u05d5\u05d0\u05d9\u05e0\u05d4 \u05de\u05d0\u05d5\u05d1\u05d7\u05e0\u05ea \u05de\u05e2\u05dc \u05d2\u05d9\u05dc 18",
          "isCorrect": false,
          "rationale": "\u05d4-DSM-5 \u05d1\u05d9\u05d8\u05dc \u05d0\u05ea \u05d4\u05d2\u05d1\u05dc\u05ea \u05d4\u05d2\u05d9\u05dc, \u05d5\u05db\u05d9\u05d5\u05dd \u05e0\u05d9\u05ea\u05df \u05dc\u05d0\u05d1\u05d7\u05df Separation Anxiety Disorder \u05d2\u05dd \u05d1\u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd (DSM p.218)."
        },
        {
          "text": "\u05d1\u05e7\u05d4\u05d9\u05dc\u05d4, \u05d4\u05d4\u05e4\u05e8\u05e2\u05d4 \u05e9\u05db\u05d9\u05d7\u05d4 \u05d9\u05d5\u05ea\u05e8 \u05d1\u05d1\u05e0\u05d9\u05dd \u05d1\u05d2\u05d9\u05dc \u05d1\u05d9\u05ea \u05d4\u05e1\u05e4\u05e8",
          "isCorrect": false,
          "rationale": "\u05d1\u05de\u05d3\u05d2\u05de\u05d9\u05dd \u05e7\u05d4\u05d9\u05dc\u05ea\u05d9\u05d9\u05dd, \u05d1\u05e0\u05d5\u05ea \u05d1\u05d2\u05d9\u05dc \u05d1\u05d9\u05ea \u05d4\u05e1\u05e4\u05e8 \u05de\u05e6\u05d9\u05d2\u05d5\u05ea \u05e9\u05d9\u05e2\u05d5\u05e8\u05d9 \u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d2\u05d1\u05d5\u05d4\u05d9\u05dd \u05d9\u05d5\u05ea\u05e8 \u05de\u05d1\u05e0\u05d9\u05dd (DSM p.218)."
        },
        {
          "text": "\u05d4\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d1\u05de\u05d3\u05d9\u05e0\u05d5\u05ea \u05d1\u05e2\u05dc\u05d5\u05ea \u05d4\u05db\u05e0\u05e1\u05d4 \u05e0\u05de\u05d5\u05db\u05d4 \u05d2\u05d1\u05d5\u05d4\u05d4 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05de\u05de\u05d3\u05d9\u05e0\u05d5\u05ea \u05e2\u05e9\u05d9\u05e8\u05d5\u05ea",
          "isCorrect": false,
          "rationale": "\u05d4\u05e0\u05ea\u05d5\u05e0\u05d9\u05dd \u05de\u05e8\u05d0\u05d9\u05dd \u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d3\u05d5\u05de\u05d4 \u05d9\u05d7\u05e1\u05d9\u05ea \u05d1\u05d9\u05df \u05de\u05d3\u05d9\u05e0\u05d5\u05ea, \u05db\u05d0\u05e9\u05e8 \u05d4\u05de\u05de\u05d5\u05e6\u05e2 \u05d4\u05e2\u05d5\u05dc\u05de\u05d9 \u05d1\u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd \u05e2\u05d5\u05de\u05d3 \u05e2\u05dc \u05db-$1\\%$ (DSM p.219)."
        }
      ],
      "hint": "\u05d1\u05d3\u05e7\u05d5 \u05d0\u05ea \u05d4\u05de\u05d2\u05de\u05d4 \u05d4\u05db\u05dc\u05dc\u05d9\u05ea \u05e9\u05dc \u05d0\u05d7\u05d5\u05d6\u05d9 \u05d4\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05dc\u05d0\u05d5\u05e8\u05da \u05de\u05e2\u05d2\u05dc \u05d4\u05d7\u05d9\u05d9\u05dd."
    },
    {
      "question": "\u05db\u05d0\u05e9\u05e8 \u05de\u05d8\u05e4\u05dc\u05d9\u05dd \u05d1-Separation Anxiety Disorder \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d1\u05d0\u05de\u05e6\u05e2\u05d5\u05ea SSRIs, \u05de\u05d4\u05d9 \u05d4\u05d0\u05d6\u05d4\u05e8\u05d4 (Black Box Warning) \u05d4\u05de\u05e8\u05db\u05d6\u05d9\u05ea \u05e9\u05d9\u05e9 \u05dc\u05d3\u05d5\u05df \u05d1\u05d4 \u05e2\u05dd \u05d4\u05d4\u05d5\u05e8\u05d9\u05dd \u05dc\u05e4\u05d9 StahlKids \u05d5-Dulcan?",
      "answerOptions": [
        {
          "text": "\u05e2\u05dc\u05d9\u05d9\u05d4 \u05d1\u05de\u05d7\u05e9\u05d1\u05d5\u05ea \u05d0\u05d5 \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d0\u05d5\u05d1\u05d3\u05e0\u05d9\u05ea (Suicidality) \u05d1\u05ea\u05d7\u05d9\u05dc\u05ea \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc",
          "isCorrect": true,
          "rationale": "\u05d4-FDA \u05e4\u05e8\u05e1\u05dd \u05d0\u05d6\u05d4\u05e8\u05d4 \u05dc\u05d2\u05d1\u05d9 \u05e1\u05d9\u05db\u05d5\u05df \u05de\u05d5\u05d2\u05d1\u05e8 \u05dc\u05d0\u05d5\u05d1\u05d3\u05e0\u05d5\u05ea \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d5\u05e0\u05d5\u05e2\u05e8 \u05d4\u05e0\u05d5\u05d8\u05dc\u05d9\u05dd \u05e0\u05d5\u05d2\u05d3\u05d9 \u05d3\u05d9\u05db\u05d0\u05d5\u05df, \u05d1\u05de\u05d9\u05d5\u05d7\u05d3 \u05d1\u05ea\u05d7\u05d9\u05dc\u05ea \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d0\u05d5 \u05d1\u05e9\u05d9\u05e0\u05d5\u05d9\u05d9 \u05de\u05d9\u05e0\u05d5\u05df (Dulcan p.380, StahlKids p.163)."
        },
        {
          "text": "\u05e1\u05d9\u05db\u05d5\u05df \u05de\u05d5\u05d2\u05d1\u05e8 \u05dc\u05d4\u05d5\u05e4\u05e2\u05ea \u05e1\u05d5\u05db\u05e8\u05ea \u05de\u05e1\u05d5\u05d2 2",
          "isCorrect": false,
          "rationale": "\u05d0\u05d6\u05d4\u05e8\u05d4 \u05d6\u05d5 \u05e8\u05dc\u05d5\u05d5\u05e0\u05d8\u05d9\u05ea \u05d9\u05d5\u05ea\u05e8 \u05dc\u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05d0\u05e0\u05d8\u05d9-\u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9\u05d5\u05ea \u05dc\u05d0 \u05d8\u05d9\u05e4\u05d9\u05e7\u05dc\u05d9\u05d5\u05ea \u05d5\u05dc\u05d0 \u05dc-SSRIs (StahlKids p.33)."
        },
        {
          "text": "\u05e4\u05d2\u05d9\u05e2\u05d4 \u05d1\u05dc\u05ea\u05d9 \u05d4\u05e4\u05d9\u05db\u05d4 \u05d1\u05d2\u05d3\u05d9\u05dc\u05d4 \u05dc\u05d2\u05d5\u05d1\u05d4",
          "isCorrect": false,
          "rationale": "\u05d9\u05e9 \u05dc\u05e2\u05e7\u05d5\u05d1 \u05d0\u05d7\u05e8 \u05d2\u05d5\u05d1\u05d4 \u05d5\u05de\u05e9\u05e7\u05dc, \u05d0\u05da \u05d0\u05d9\u05df \u05de\u05d3\u05d5\u05d1\u05e8 \u05d1\u05d0\u05d6\u05d4\u05e8\u05ea \u05d4-Black Box \u05d4\u05de\u05e8\u05db\u05d6\u05d9\u05ea (Dulcan p.694, StahlKids p.166)."
        },
        {
          "text": "\u05e1\u05db\u05e0\u05d4 \u05dc\u05d4\u05ea\u05de\u05db\u05e8\u05d5\u05ea \u05d5\u05ea\u05dc\u05d5\u05ea \u05e4\u05d9\u05d6\u05d9\u05ea \u05e7\u05e9\u05d4",
          "isCorrect": false,
          "rationale": "SSRIs \u05d0\u05d9\u05e0\u05dd \u05e0\u05d7\u05e9\u05d1\u05d9\u05dd \u05dc\u05de\u05de\u05db\u05e8\u05d9\u05dd, \u05d0\u05dd \u05db\u05d9 \u05d4\u05e4\u05e1\u05e7\u05d4 \u05e4\u05ea\u05d0\u05d5\u05de\u05d9\u05ea \u05e2\u05dc\u05d5\u05dc\u05d4 \u05dc\u05d2\u05e8\u05d5\u05dd \u05dc\u05ea\u05e1\u05de\u05d9\u05e0\u05d9 \u05d2\u05de\u05d9\u05dc\u05d4 (Withdrawal) (Dulcan p.331)."
        }
      ],
      "hint": "\u05d4\u05ea\u05de\u05e7\u05d3\u05d5 \u05d1\u05e1\u05d9\u05db\u05d5\u05df \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9 \u05d4\u05d7\u05de\u05d5\u05e8 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d4\u05de\u05d5\u05e4\u05d9\u05e2 \u05d1\u05d0\u05d6\u05d4\u05e8\u05ea \u05d4-FDA \u05e2\u05d1\u05d5\u05e8 \u05e0\u05d5\u05d2\u05d3\u05d9 \u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd."
