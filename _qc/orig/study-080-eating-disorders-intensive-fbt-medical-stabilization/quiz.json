      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05d9\u05dc\u05d3 \u05d1\u05df 10 \u05de\u05d5\u05e4\u05e0\u05d4 \u05dc\u05d4\u05e2\u05e8\u05db\u05d4 \u05d1\u05e9\u05dc \u05e1\u05d9\u05e8\u05d5\u05d1 \u05dc\u05d0\u05db\u05d5\u05dc \u05de\u05d2\u05d5\u05d5\u05df \u05e8\u05d7\u05d1 \u05e9\u05dc \u05de\u05d0\u05db\u05dc\u05d9\u05dd, \u05de\u05d4 \u05e9\u05d4\u05d5\u05d1\u05d9\u05dc \u05dc\u05d0\u05d5\u05d1\u05d3\u05df \u05de\u05e9\u05e7\u05dc \u05d5\u05e6\u05d5\u05e8\u05da \u05d1\u05ea\u05d5\u05e1\u05e4\u05d9 \u05ea\u05d6\u05d5\u05e0\u05d4 \u05e0\u05d5\u05d6\u05dc\u05d9\u05d9\u05dd. \u05d4\u05d4\u05d5\u05e8\u05d9\u05dd \u05de\u05e6\u05d9\u05d9\u05e0\u05d9\u05dd \u05db\u05d9 \u05d4\u05d5\u05d0 \u05d7\u05d5\u05e9\u05e9 \u05de\u05d0\u05d5\u05d3 \u05de\u05d7\u05e0\u05e7 \u05d0\u05d5 \u05de\u05d4\u05e7\u05d0\u05d4 \u05de\u05d0\u05d6 \u05d0\u05d9\u05e8\u05d5\u05e2 \u05e9\u05dc \u05d4\u05e9\u05ea\u05e0\u05e7\u05d5\u05ea \u05dc\u05e4\u05e0\u05d9 \u05d7\u05e6\u05d9 \u05e9\u05e0\u05d4. \u05d4\u05d9\u05dc\u05d3 \u05d0\u05d9\u05e0\u05d5 \u05de\u05d1\u05d9\u05e2 \u05d3\u05d0\u05d2\u05d4 \u05dc\u05d2\u05d1\u05d9 \u05de\u05e9\u05e7\u05dc \u05d2\u05d5\u05e4\u05d5 \u05d0\u05d5 \u05e6\u05d5\u05e8\u05ea\u05d5. \u05de\u05d4\u05d9 \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05e1\u05d1\u05d9\u05e8\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8?",
      "answerOptions": [
        {
          "text": "Avoidant/Restrictive Food Intake Disorder (ARFID).",
          "isCorrect": true,
          "rationale": "\u05d4\u05d9\u05e2\u05d3\u05e8 \u05e2\u05d9\u05d5\u05d5\u05ea \u05d1\u05d3\u05d9\u05de\u05d5\u05d9 \u05d4\u05d2\u05d5\u05e3 \u05d0\u05d5 \u05e4\u05d7\u05d3 \u05de\u05d4\u05e9\u05de\u05e0\u05d4, \u05d9\u05d7\u05d3 \u05e2\u05dd \u05d4\u05d9\u05de\u05e0\u05e2\u05d5\u05ea \u05d4\u05de\u05d1\u05d5\u05e1\u05e1\u05ea \u05e2\u05dc \u05d4\u05e9\u05dc\u05db\u05d5\u05ea \u05e9\u05dc\u05d9\u05dc\u05d9\u05d5\u05ea \u05e9\u05dc \u05d0\u05db\u05d9\u05dc\u05d4 (\u05d7\u05e0\u05e7), \u05d4\u05dd \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9\u05dd \u05d4\u05de\u05e8\u05db\u05d6\u05d9\u05d9\u05dd \u05e9\u05dc ARFID (DSM p.376-377)."
        },
        {
          "text": "Anorexia Nervosa, Restricting Type.",
          "isCorrect": false,
          "rationale": "\u05d1\u05d0\u05e0\u05d5\u05e8\u05e7\u05e1\u05d9\u05d4 \u05e0\u05e8\u05d1\u05d5\u05d6\u05d4 \u05d7\u05d9\u05d9\u05d1 \u05dc\u05d4\u05ea\u05e7\u05d9\u05d9\u05dd \u05e4\u05d7\u05d3 \u05d0\u05d9\u05e0\u05d8\u05e0\u05e1\u05d9\u05d1\u05d9 \u05de\u05e2\u05dc\u05d9\u05d9\u05d4 \u05d1\u05de\u05e9\u05e7\u05dc \u05d0\u05d5 \u05d4\u05e4\u05e8\u05e2\u05d4 \u05d1\u05ea\u05e4\u05d9\u05e1\u05ea \u05d4\u05d2\u05d5\u05e3, \u05e9\u05d0\u05d9\u05e0\u05dd \u05e7\u05d9\u05d9\u05de\u05d9\u05dd \u05db\u05d0\u05df (DSM p.381)."
        },
        {
          "text": "Specific Phobia, Other type (Choking).",
          "isCorrect": false,
          "rationale": "\u05db\u05d0\u05e9\u05e8 \u05d4\u05e4\u05d7\u05d3 \u05de\u05d5\u05d1\u05d9\u05dc \u05dc\u05d4\u05e4\u05e8\u05e2\u05d4 \u05ea\u05d6\u05d5\u05e0\u05ea\u05d9\u05ea \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05d5\u05d9\u05e8\u05d9\u05d3\u05d4 \u05d1\u05de\u05e9\u05e7\u05dc, \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05de\u05ea\u05d0\u05d9\u05de\u05d4 \u05d5\u05d4\u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05ea \u05d9\u05d5\u05ea\u05e8 \u05d4\u05d9\u05d0 ARFID (DSM p.380)."
        },
        {
          "text": "Somatic Symptom Disorder.",
          "isCorrect": false,
          "rationale": "\u05d4\u05de\u05d9\u05e7\u05d5\u05d3 \u05db\u05d0\u05df \u05d4\u05d5\u05d0 \u05d1\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d4\u05d0\u05db\u05d9\u05dc\u05d4 \u05d5\u05d4\u05d4\u05e9\u05dc\u05db\u05d5\u05ea \u05d4\u05ea\u05d6\u05d5\u05e0\u05ea\u05d9\u05d5\u05ea \u05e9\u05dc\u05d4 \u05d1\u05e2\u05e7\u05d1\u05d5\u05ea \u05d0\u05d9\u05e8\u05d5\u05e2 \u05d8\u05e8\u05d0\u05d5\u05de\u05d8\u05d9 \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9, \u05de\u05d4 \u05e9\u05de\u05ea\u05d0\u05d9\u05dd \u05d9\u05d5\u05ea\u05e8 \u05dc\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df \u05d4-Fear of aversive consequences \u05d1-ARFID (Dulcan p.431)."
        }
      ],
      "hint": "\u05d4\u05d1\u05d7\u05df \u05d1\u05d9\u05df \u05e4\u05d7\u05d3 \u05de\u05d4\u05e9\u05de\u05e0\u05d4 \u05dc\u05d1\u05d9\u05df \u05e4\u05d7\u05d3 \u05de\u05d4\u05e9\u05dc\u05db\u05d5\u05ea \u05e4\u05d9\u05d6\u05d9\u05d5\u05ea \u05e9\u05dc \u05d0\u05db\u05d9\u05dc\u05d4 \u05db\u05de\u05d5 \u05d7\u05e0\u05e7.",
