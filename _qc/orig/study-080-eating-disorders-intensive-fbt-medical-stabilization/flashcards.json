{
  "title": "Anorexia Flashcards",
  "cards": [
    {
      "front": "\u05de\u05d4 \u05d4\u05d9\u05d4 \u05d4\u05e9\u05d9\u05e0\u05d5\u05d9 \u05d4\u05de\u05d4\u05d5\u05ea\u05d9 \u05d1\u05ea\u05e4\u05d9\u05e1\u05ea \u05d4\u05d4\u05d5\u05e8\u05d9\u05dd \u05d1\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05d0\u05db\u05d9\u05dc\u05d4 \u05d1\u05de\u05e2\u05d1\u05e8 \u05de\u05d4\u05d2\u05d9\u05e9\u05d4 \u05d4\u05e4\u05e1\u05d9\u05db\u05d5\u05d3\u05d9\u05e0\u05de\u05d9\u05ea \u05d4\u05de\u05e1\u05d5\u05e8\u05ea\u05d9\u05ea \u05dc\u05d2\u05d9\u05e9\u05ea \u05d4-FBT?",
      "back": "\u05d4\u05de\u05e2\u05d1\u05e8 \u05de\u05d2\u05d9\u05e9\u05ea Parentectomy (\u05d4\u05e8\u05d7\u05e7\u05ea \u05d4\u05d4\u05d5\u05e8\u05d9\u05dd \u05db\u05d2\u05d5\u05e8\u05dd \u05e4\u05ea\u05d5\u05d2\u05e0\u05d9) \u05dc\u05e8\u05d0\u05d9\u05d9\u05ea \u05d4\u05d4\u05d5\u05e8\u05d9\u05dd \u05db\u05de\u05e9\u05d0\u05d1 \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc\u05d9 \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05d5\u05d4\u05d7\u05d9\u05d5\u05e0\u05d9 \u05d1\u05d9\u05d5\u05ea\u05e8 (Dulcan p.425)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05de\u05e9\u05de\u05e2\u05d5\u05ea \u05e9\u05dc \u05e2\u05e7\u05e8\u05d5\u05df \u05d4-Agnosticism \u05d1\u05d2\u05d9\u05e9\u05ea \u05d4-FBT/Maudsley?",
      "back": "\u05d4\u05d9\u05de\u05e0\u05e2\u05d5\u05ea \u05de\u05d7\u05d9\u05e4\u05d5\u05e9 \u05e1\u05d9\u05d1\u05d5\u05ea \u05d0\u05d8\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05d5\u05ea \u05d0\u05d5 \u05d4\u05d0\u05e9\u05de\u05ea \u05d4\u05d4\u05d5\u05e8\u05d9\u05dd, \u05ea\u05d5\u05da \u05d4\u05ea\u05de\u05e7\u05d3\u05d5\u05ea \u05d1\u05e4\u05ea\u05e8\u05d5\u05df \u05d4\u05d1\u05e2\u05d9\u05d4 \u05d5\u05d4\u05e9\u05d1\u05ea \u05d4\u05de\u05e9\u05e7\u05dc \u05d1\u05d4\u05d5\u05d5\u05d4 (Dulcan p.426)."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05de\u05d9\u05d5\u05e9\u05dd \u05e2\u05e7\u05e8\u05d5\u05df \u05d4-Externalization \u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-FBT?",
      "back": "\u05d4\u05e4\u05e8\u05d3\u05d4 \u05de\u05dc\u05d0\u05d4 \u05d1\u05d9\u05df \u05d6\u05d4\u05d5\u05ea \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05dc\u05d1\u05d9\u05df \u05d4\u05d0\u05e0\u05d5\u05e8\u05e7\u05e1\u05d9\u05d4, \u05d4\u05de\u05d5\u05e6\u05d2\u05ea \u05db\"\u05d0\u05d5\u05d9\u05d1 \u05d7\u05d9\u05e6\u05d5\u05e0\u05d9\" \u05d0\u05d5 \u05db\u05e9\u05d5\u05ea\u05e3 \u05dc\u05d0 \u05e8\u05e6\u05d5\u05d9 (Dulcan p.426)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05de\u05d5\u05e7\u05d3 \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05e9\u05dc \u05e9\u05dc\u05d1 1 (Phase 1) \u05d1\u05d8\u05d9\u05e4\u05d5\u05dc FBT-AN?",
      "back": "\u05d4\u05e2\u05e6\u05de\u05ea \u05d4\u05d4\u05d5\u05e8\u05d9\u05dd \u05dc\u05e7\u05d7\u05ea \u05d0\u05d7\u05e8\u05d9\u05d5\u05ea \u05de\u05dc\u05d0\u05d4 \u05d5\u05d1\u05dc\u05e2\u05d3\u05d9\u05ea \u05e2\u05dc \u05d4-Refeeding \u05d5\u05d4\u05e9\u05d9\u05e7\u05d5\u05dd \u05d4\u05ea\u05d6\u05d5\u05e0\u05ea\u05d9 \u05e9\u05dc \u05d9\u05dc\u05d3\u05dd (Dulcan p.426)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05de\u05d8\u05e8\u05d4 \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05e9\u05dc \u05d4-Family Meal \u05d4\u05de\u05ea\u05e7\u05d9\u05d9\u05de\u05ea \u05d1\u05d3\u05e8\u05da \u05db\u05dc\u05dc \u05d1\u05de\u05e4\u05d2\u05e9 \u05d4\u05e9\u05e0\u05d9 \u05e9\u05dc \u05d4-FBT?",
      "back": "\u05ea\u05e6\u05e4\u05d9\u05ea \u05e2\u05dc \u05d4\u05d3\u05d9\u05e0\u05de\u05d9\u05e7\u05d4 \u05d4\u05de\u05e9\u05e4\u05d7\u05ea\u05d9\u05ea \u05e1\u05d1\u05d9\u05d1 \u05d0\u05d5\u05db\u05dc \u05d5\u05d4\u05e2\u05e6\u05de\u05ea \u05d4\u05d4\u05d5\u05e8\u05d9\u05dd \u05dc\u05d2\u05e8\u05d5\u05dd \u05dc\u05d9\u05dc\u05d3 \u05dc\u05d0\u05db\u05d5\u05dc \"\u05d1\u05d9\u05e1 \u05d0\u05d7\u05d3 \u05e0\u05d5\u05e1\u05e3\" \u05de\u05e2\u05d1\u05e8 \u05dc\u05e8\u05e6\u05d5\u05e0\u05d5 (Dulcan p.426)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05ea\u05e0\u05d0\u05d9 \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05dc\u05de\u05e2\u05d1\u05e8 \u05dc\u05e9\u05dc\u05d1 2 (Phase 2) \u05d1\u05d8\u05d9\u05e4\u05d5\u05dc FBT-AN?",
      "back": "\u05d4\u05e9\u05d2\u05ea \u05e2\u05dc\u05d9\u05d9\u05d4 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05d1\u05de\u05e9\u05e7\u05dc, \u05e7\u05d1\u05dc\u05ea \u05e1\u05de\u05db\u05d5\u05ea \u05d4\u05d4\u05d5\u05e8\u05d9\u05dd \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05d5\u05e9\u05d9\u05e4\u05d5\u05e8 \u05d1\u05de\u05e6\u05d1 \u05d4\u05e8\u05d5\u05d7 \u05d4\u05de\u05e9\u05e4\u05d7\u05ea\u05d9 (Dulcan p.426)."
    },
    {
      "front": "\u05e2\u05dc \u05e4\u05d9 \u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05d4\u05de\u05e7\u05d5\u05d1\u05dc\u05d9\u05dd, \u05d0\u05d9\u05d6\u05d4 \u05d0\u05d7\u05d5\u05d6 \u05de-IBW (\u05d0\u05d5 Expected Body Weight) \u05de\u05d4\u05d5\u05d5\u05d4 \u05d0\u05d9\u05e0\u05d3\u05d9\u05e7\u05e6\u05d9\u05d4 \u05dc\u05d0\u05e9\u05e4\u05d5\u05d6?",
      "back": "\u05de\u05e9\u05e7\u05dc \u05e0\u05de\u05d5\u05da \u05de-$75\\%$ \u05de\u05d4\u05de\u05e9\u05e7\u05dc \u05d4\u05e6\u05e4\u05d5\u05d9 \u05dc\u05d2\u05d9\u05dc \u05d5\u05dc\u05d2\u05d5\u05d1\u05d4 (\u05de\u05e7\u05d5\u05e8: \u05d4\u05e7\u05e9\u05e8 \u05e8\u05d7\u05d1)."
    },
    {
      "front": "\u05d1\u05d0\u05d9\u05dc\u05d5 \u05e2\u05e8\u05db\u05d9 \u05d3\u05d5\u05e4\u05e7 (Heart Rate) \u05e7\u05d9\u05d9\u05de\u05ea \u05d0\u05d9\u05e0\u05d3\u05d9\u05e7\u05e6\u05d9\u05d4 \u05e8\u05e4\u05d5\u05d0\u05d9\u05ea \u05dc\u05d0\u05e9\u05e4\u05d5\u05d6 \u05d1\u05e0\u05e2\u05e8\u05d4 \u05e2\u05dd Anorexia Nervosa?",
      "back": "Bradycardia \u05e7\u05d9\u05e6\u05d5\u05e0\u05d9\u05ea \u05e2\u05dd \u05d3\u05d5\u05e4\u05e7 \u05e0\u05de\u05d5\u05da \u05de-40 \u05e4\u05e2\u05d9\u05de\u05d5\u05ea \u05dc\u05d3\u05e7\u05d4 (\u05de\u05e7\u05d5\u05e8: \u05d4\u05e7\u05e9\u05e8 \u05e8\u05d7\u05d1)."
    },
    {
      "front": "\u05e2\u05d1\u05d5\u05e8 \u05d0\u05d9\u05dc\u05d5 \u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd FBT \u05e0\u05d7\u05e9\u05d1 \u05dc-First-line evidence-based intervention \u05dc\u05e4\u05d9 \u05d4\u05e0\u05d7\u05d9\u05d5\u05ea \u05d1\u05d9\u05e0\u05dc\u05d0\u05d5\u05de\u05d9\u05d5\u05ea?",
      "back": "\u05d9\u05dc\u05d3\u05d9\u05dd \u05d5\u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd \u05d4\u05e1\u05d5\u05d1\u05dc\u05d9\u05dd \u05de-Anorexia Nervosa (Dulcan p.425)."
    },
    {
      "front": "\u05de\u05d4 \u05d4\u05e8\u05d0\u05d4 \u05de\u05d7\u05e7\u05e8 \u05d4-Maudsley \u05d4\u05de\u05e7\u05d5\u05e8\u05d9 (Russell et al., 1987) \u05dc\u05d2\u05d1\u05d9 \u05d9\u05e2\u05d9\u05dc\u05d5\u05ea \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05de\u05e9\u05e4\u05d7\u05ea\u05d9 \u05d1-AN?",
      "back": "\u05e2\u05dc\u05d9\u05d5\u05e0\u05d5\u05ea \u05de\u05d5\u05d1\u05d4\u05e7\u05ea \u05e2\u05d1\u05d5\u05e8 \u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd \u05de\u05ea\u05d7\u05ea \u05dc\u05d2\u05d9\u05dc 18 \u05e2\u05dd \u05de\u05e9\u05da \u05de\u05d7\u05dc\u05d4 \u05e7\u05e6\u05e8 \u05de-3 \u05e9\u05e0\u05d9\u05dd (Dulcan p.425)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05ea\u05e4\u05e7\u05d9\u05d3 \u05d4\u05d0\u05d7\u05d9\u05dd (Siblings) \u05d1\u05ea\u05d4\u05dc\u05d9\u05da \u05d4-Refeeding \u05d1\u05d2\u05d9\u05e9\u05ea \u05d4-FBT?",
      "back": "\u05de\u05ea\u05df \u05ea\u05de\u05d9\u05db\u05d4 \u05e8\u05d2\u05e9\u05d9\u05ea \u05d5\u05d4\u05e1\u05d7\u05ea \u05d3\u05e2\u05ea, \u05ea\u05d5\u05da \u05d4\u05d2\u05d3\u05e8\u05ea\u05dd \u05db\u05e0\u05de\u05e6\u05d0\u05d9\u05dd \u05de\u05d7\u05d5\u05e5 \u05dc\u05de\u05e9\u05d9\u05de\u05ea \u05d4\u05d4\u05d0\u05db\u05dc\u05d4 \u05dc\u05de\u05e0\u05d9\u05e2\u05ea Parentification (Dulcan p.425)."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05de\u05d1\u05d5\u05e6\u05e2 \u05e0\u05d9\u05d8\u05d5\u05e8 \u05d4\u05de\u05e9\u05e7\u05dc \u05d1\u05ea\u05d7\u05d9\u05dc\u05ea \u05db\u05dc \u05e4\u05d2\u05d9\u05e9\u05ea FBT?",
      "back": "\u05d4\u05de\u05d8\u05e4\u05dc \u05e9\u05d5\u05e7\u05dc \u05d0\u05ea \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05d5\u05de\u05e6\u05d9\u05d2 \u05d0\u05ea \u05d4\u05e0\u05ea\u05d5\u05df \u05d1\u05d0\u05d5\u05e4\u05df \u05e9\u05e7\u05d5\u05e3 \u05e2\u05dc \u05d2\u05d1\u05d9 \u05d4-Weight Chart \u05dc\u05de\u05d8\u05d5\u05e4\u05dc \u05d5\u05dc\u05d4\u05d5\u05e8\u05d9\u05dd (Dulcan p.425)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05d4\u05d1\u05d3\u05dc \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05d1\u05d9\u05df \u05e9\u05dc\u05d1 1 \u05d1-FBT-BN \u05dc\u05d1\u05d9\u05df FBT-AN?",
      "back": "\u05d1-BN \u05d4\u05de\u05d5\u05e7\u05d3 \u05d0\u05d9\u05e0\u05d5 \u05e2\u05dc\u05d9\u05d9\u05d4 \u05d1\u05de\u05e9\u05e7\u05dc \u05d0\u05dc\u05d0 \u05e7\u05d8\u05d9\u05e2\u05ea \u05de\u05e2\u05d2\u05dc\u05d9 Binge/Purge \u05d5\u05d1\u05d9\u05e1\u05d5\u05e1 \u05d3\u05e4\u05d5\u05e1 \u05d0\u05db\u05d9\u05dc\u05d4 \u05e1\u05d3\u05d9\u05e8 (Dulcan p.426)."
    },
    {
      "front": "\u05d0\u05d9\u05dc\u05d5 \u05e2\u05e8\u05db\u05d9 \u05dc\u05d7\u05e5 \u05d3\u05dd (Blood Pressure) \u05de\u05d4\u05d5\u05d5\u05d9\u05dd \u05e2\u05d9\u05dc\u05d4 \u05dc\u05d0\u05e9\u05e4\u05d5\u05d6 \u05dc\u05d9\u05d9\u05e6\u05d5\u05d1 \u05e8\u05e4\u05d5\u05d0\u05d9?",
      "back": "Hypotension \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9, \u05dc\u05e8\u05d5\u05d1 \u05de\u05d5\u05d2\u05d3\u05e8 \u05db\u05e2\u05e8\u05db\u05d9\u05dd \u05d4\u05e0\u05de\u05d5\u05db\u05d9\u05dd \u05de-$80/50$ (\u05de\u05e7\u05d5\u05e8: \u05d4\u05e7\u05e9\u05e8 \u05e8\u05d7\u05d1)."
    },
    {
      "front": "\u05dc\u05e4\u05d9 \u05d4-StahlKids, \u05de\u05d4\u05d9 \u05d4\u05d4\u05de\u05dc\u05e6\u05d4 \u05d4\u05ea\u05d6\u05d5\u05e0\u05ea\u05d9\u05ea \u05d4\u05e8\u05d0\u05e9\u05d5\u05e0\u05d4 \u05dc\u05d4\u05ea\u05de\u05d5\u05d3\u05d3\u05d5\u05ea \u05e2\u05dd \u05d0\u05d5\u05d1\u05d3\u05df \u05de\u05e9\u05e7\u05dc \u05ea\u05d7\u05ea Stimulants?",
      "back": "\u05d4\u05d5\u05e1\u05e4\u05ea \"Liquid calories\" \u05db\u05d2\u05d5\u05df Smoothies \u05d0\u05d5 \u05ea\u05d5\u05e1\u05e4\u05d9 \u05ea\u05d6\u05d5\u05e0\u05d4 \u05db\u05de\u05d5 Boost \u05d5-Ensure (StahlKids p.4)."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05de\u05d5\u05d2\u05d3\u05e8\u05ea \u05d7\u05d5\u05de\u05e8\u05ea (Severity) \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc Anorexia Nervosa \u05d1\u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR?",
      "back": "\u05dc\u05e4\u05d9 \u05d4-BMI: \u05e7\u05dc ($\\ge 17$), \u05d1\u05d9\u05e0\u05d5\u05e0\u05d9 (16-16.99), \u05d7\u05de\u05d5\u05e8 (15-15.99), \u05d5\u05e7\u05d9\u05e6\u05d5\u05e0\u05d9 ($< 15$) (DSM p.370)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05d4\u05de\u05d1\u05d3\u05d9\u05dc \u05d0\u05ea ARFID \u05de-Anorexia Nervosa \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR?",
      "back": "\u05d1-ARFID \u05d0\u05d9\u05df \u05d4\u05e4\u05e8\u05e2\u05d4 \u05d1\u05d3\u05d9\u05de\u05d5\u05d9 \u05d4\u05d2\u05d5\u05e3 (Body image) \u05d0\u05d5 \u05e4\u05d7\u05d3 \u05de\u05d5\u05e4\u05e8\u05d6 \u05de\u05e2\u05dc\u05d9\u05d9\u05d4 \u05d1\u05de\u05e9\u05e7\u05dc (DSM p.370)."
    },
    {
      "front": "\u05d0\u05d9\u05dc\u05d5 \u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05d0\u05dc\u05e7\u05d8\u05e8\u05d5\u05dc\u05d9\u05d8\u05e8\u05d9\u05d5\u05ea \u05d1-Anorexia Nervosa \u05de\u05d4\u05d5\u05d5\u05ea \u05d0\u05d9\u05e0\u05d3\u05d9\u05e7\u05e6\u05d9\u05d4 \u05de\u05d9\u05d9\u05d3\u05d9\u05ea \u05dc\u05d0\u05e9\u05e4\u05d5\u05d6?",
