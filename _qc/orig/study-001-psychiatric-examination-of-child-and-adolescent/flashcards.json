{
  "title": "Psychiatry Flashcards",
  "cards": [
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05d2\u05d3\u05e8\u05ea \u05d4\u05d9\u05dc\u05d3 \u05db-Moving Target \u05d1\u05d4\u05e2\u05e8\u05db\u05d4 \u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9\u05ea?",
      "back": "\u05d4\u05d9\u05dc\u05d3\u05d9\u05dd \u05de\u05e9\u05ea\u05e0\u05d9\u05dd \u05d5\u05de\u05ea\u05e4\u05ea\u05d7\u05d9\u05dd \u05dc\u05dc\u05d0 \u05d4\u05e8\u05e3, \u05de\u05d4 \u05e9\u05de\u05e7\u05e9\u05d4 \u05e2\u05dc \u05d4\u05d2\u05d3\u05e8\u05ea \u05ea\u05e4\u05e7\u05d5\u05d3 \u05ea\u05e7\u05d9\u05df \u05dc\u05dc\u05d0 \u05d4\u05d1\u05e0\u05ea \u05e9\u05dc\u05d1\u05d9 \u05d4\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea."
    },
    {
      "front": "\u05d1\u05de\u05e1\u05d2\u05e8\u05ea \u05d4-Developmental Ladder (\u05de\u05d2\u05d3\u05dc \u05d1\u05e0\u05d0\u05d9 5 \u05e7\u05d5\u05de\u05d5\u05ea), \u05de\u05d4 \u05de\u05e1\u05de\u05dc \u05d4-Apprentice \u05d1\u05e7\u05d5\u05de\u05d4 3 \u05d4\u05e2\u05d5\u05e1\u05e7 \u05d1-Cog-wheels?",
      "back": "\u05d4\u05ea\u05d7\u05d5\u05dd \u05d4\u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9 (Cognitive domain)."
    },
    {
      "front": "Developmental Red Flag (Frame 1): \u05de\u05d4 \u05d4\u05de\u05e9\u05de\u05e2\u05d5\u05ea \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05e9\u05dc NINJA-baby \u05d1\u05ea\u05d5\u05da NIN-cradle \u05d1\u05e6\u05d5\u05e8\u05ea '9' \u05d4\u05e9\u05d5\u05de\u05e8 \u05e2\u05dc \u05e9\u05ea\u05d9\u05e7\u05d4?",
      "back": "\u05d4\u05d9\u05e2\u05d3\u05e8 \u05de\u05dc\u05de\u05d5\u05dc (No babbling) \u05d1\u05d2\u05d9\u05dc 9 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05e9\u05d9\u05d8\u05ea \u05d4-Triangulation \u05d4\u05de\u05d5\u05de\u05dc\u05e6\u05ea \u05dc\u05e7\u05d1\u05dc\u05ea \u05de\u05d9\u05d3\u05e2 \u05de\u05d4\u05d9\u05de\u05df \u05d1\u05d4\u05e2\u05e8\u05db\u05ea \u05d4\u05d9\u05dc\u05d3?",
      "back": "\u05e9\u05d9\u05dc\u05d5\u05d1 \u05d3\u05d9\u05d5\u05d5\u05d7\u05d9\u05dd \u05de\u05d4\u05d9\u05dc\u05d3 (Internalizing symptoms), \u05de\u05d4\u05d4\u05d5\u05e8\u05d9\u05dd (Externalizing/Timeline) \u05d5\u05de\u05d1\u05d9\u05ea \u05d4\u05e1\u05e4\u05e8 (Functioning)."
    },
    {
      "front": "\u05d1\u05d0\u05d9\u05d6\u05d4 \u05db\u05dc\u05d9 \u05d0\u05d1\u05d7\u05d5\u05e0\u05d9 \u05de\u05e9\u05ea\u05de\u05e9\u05d9\u05dd \u05dc\u05d4\u05e2\u05e8\u05db\u05ea \u05ea\u05d9\u05e0\u05d5\u05e7\u05d5\u05ea \u05d5\u05e4\u05e2\u05d5\u05d8\u05d5\u05ea (\u05d2\u05d9\u05dc 0-3) \u05d4\u05db\u05d5\u05dc\u05dc 5 \u05e6\u05d9\u05e8\u05d9\u05dd?",
      "back": "\u05de\u05e2\u05e8\u05db\u05ea \u05d4-DC:0-5."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05d3\u05d2\u05e9 \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05e9\u05dc \u05e6\u05d9\u05e8 2 (Relational Context) \u05d1\u05d0\u05d1\u05d7\u05d5\u05df \u05e4\u05e2\u05d5\u05d8\u05d5\u05ea \u05dc\u05e4\u05d9 \u05d4-DC:0-5?",
      "back": "\u05d1\u05d7\u05d9\u05e0\u05ea \u05d0\u05d9\u05db\u05d5\u05ea \u05d4\u05e7\u05e9\u05e8 \u05d5\u05d4\u05d3\u05d9\u05d0\u05d3\u05d4 (\u05d4\u05d5\u05e8\u05d4-\u05d9\u05dc\u05d3) \u05db\u05de\u05e8\u05db\u05d9\u05d1 \u05d4\u05d7\u05e9\u05d5\u05d1 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d1\u05d0\u05d1\u05d7\u05d5\u05df."
    },
    {
      "front": "Developmental Red Flag (Frame 5): \u05de\u05d4 \u05de\u05e1\u05de\u05dc \u05d9\u05dc\u05d3 \u05e2\u05dc Tricycle (3 \u05d2\u05dc\u05d2\u05dc\u05d9\u05dd) \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05d1\u05d0\u05e8\u05d2\u05d6 \u05e7\u05e8\u05d8\u05d5\u05df \u05db\u05e9\u05e8\u05e4\u05e8\u05e3 \u05d1\u05dc\u05d1\u05d3?",
      "back": "\u05d4\u05d9\u05e2\u05d3\u05e8 \u05de\u05e9\u05d7\u05e7 \u05e1\u05de\u05dc\u05d9 (No symbolic play) \u05d1\u05d2\u05d9\u05dc 36 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd (3 \u05e9\u05e0\u05d9\u05dd)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4-Gold Standard \u05db\u05e8\u05d0\u05d9\u05d5\u05df \u05d7\u05e6\u05d9-\u05de\u05d5\u05d1\u05e0\u05d4 \u05dc\u05d0\u05d1\u05d7\u05d5\u05df \u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05de\u05e6\u05d1 \u05e8\u05d5\u05d7 \u05d5\u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d4 \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd?",
      "back": "K-SADS-PL."
    },
    {
      "front": "\u05d1\u05e4\u05d5\u05e8\u05de\u05d5\u05dc\u05e6\u05d9\u05d4 \u05e9\u05dc \u05d4-4P, \u05de\u05d4 \u05d4\u05d4\u05d1\u05d3\u05dc \u05d1\u05d9\u05df \u05d2\u05d5\u05e8\u05dd Predisposing \u05dc\u05d2\u05d5\u05e8\u05dd Precipitating?",
      "back": "Predisposing \u05d4\u05d5\u05d0 \u05d2\u05d5\u05e8\u05dd \u05de\u05e7\u05d3\u05d9\u05dd (\u05db\u05de\u05d5 \u05d2\u05e0\u05d8\u05d9\u05e7\u05d4), \u05d1\u05e2\u05d5\u05d3 Precipitating \u05d4\u05d5\u05d0 \u05d2\u05d5\u05e8\u05dd \u05de\u05e2\u05d5\u05e8\u05e8 (\u05e1\u05d8\u05e8\u05e1\u05d5\u05e8 \u05d7\u05d9\u05e6\u05d5\u05e0\u05d9)."
    },
    {
      "front": "\u05d0\u05d9\u05dc\u05d5 \u05de\u05d3\u05d3\u05d9\u05dd \u05d2\u05d5\u05e4\u05e0\u05d9\u05d9\u05dd \u05d9\u05e9 \u05dc\u05e0\u05d8\u05e8 \u05d1\u05d0\u05d5\u05e4\u05df \u05e7\u05d1\u05d5\u05e2 \u05d1\u05d9\u05dc\u05d3 \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05d1-Methylphenidate?",
      "back": "\u05dc\u05d7\u05e5 \u05d3\u05dd, \u05d3\u05d5\u05e4\u05e7, \u05d2\u05d5\u05d1\u05d4, \u05de\u05e9\u05e7\u05dc \u05d5-BMI (\u05dc\u05de\u05e2\u05e7\u05d1 \u05d0\u05d7\u05e8 \u05d2\u05d3\u05d9\u05dc\u05d4)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05de\u05d5\u05e9\u05d2 Informed Assent \u05d1\u05d4\u05e7\u05e9\u05e8 \u05e9\u05dc \u05d8\u05d9\u05e4\u05d5\u05dc \u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9 \u05d1\u05e7\u05d8\u05d9\u05e0\u05d9\u05dd?",
      "back": "\u05e7\u05d1\u05dc\u05ea \u05d4\u05e1\u05db\u05de\u05ea \u05d4\u05d9\u05dc\u05d3 \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05d4\u05ea\u05d0\u05dd \u05dc\u05e8\u05de\u05ea\u05d5 \u05d4\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9\u05ea, \u05d1\u05e0\u05d5\u05e1\u05e3 \u05dc\u05d4\u05e1\u05db\u05de\u05d4 \u05d4\u05de\u05e9\u05e4\u05d8\u05d9\u05ea (Consent) \u05e9\u05dc \u05d4\u05d4\u05d5\u05e8\u05d9\u05dd."
    },
    {
      "front": "\u05de\u05d4 \u05de\u05e1\u05de\u05dc \u05d4-Apprentice \u05d1\u05e7\u05d5\u05de\u05d4 4 \u05e9\u05dc \u05d4-Developmental Ladder \u05d4\u05de\u05db\u05d9\u05d9\u05dc \u05de\u05db\u05e9\u05d9\u05e8 'EMO-METER'?",
      "back": "\u05d4\u05ea\u05d7\u05d5\u05dd \u05d4\u05e8\u05d2\u05e9\u05d9-\u05d7\u05d1\u05e8\u05ea\u05d9 (Social-Emotional domain)."
    },
    {
      "front": "\u05d1\u05d1\u05d3\u05d9\u05e7\u05ea \u05e1\u05d8\u05d8\u05d5\u05e1 \u05de\u05e0\u05d8\u05dc\u05d9 (Pediatric MSE), \u05de\u05d3\u05d5\u05e2 \u05d7\u05e9\u05d5\u05d1 \u05dc\u05e9\u05d9\u05dd \u05dc\u05d1 \u05dc\u05e1\u05d9\u05de\u05e0\u05d9 Dysmorphism \u05d1\u05d4\u05d5\u05e4\u05e2\u05d4 \u05d4\u05d7\u05d9\u05e6\u05d5\u05e0\u05d9\u05ea?",
      "back": "\u05db\u05d3\u05d9 \u05dc\u05d4\u05e2\u05dc\u05d5\u05ea \u05d7\u05e9\u05d3 \u05dc\u05e7\u05d9\u05d5\u05dd \u05ea\u05e1\u05de\u05d5\u05e0\u05d5\u05ea \u05d2\u05e0\u05d8\u05d9\u05d5\u05ea \u05d4\u05e2\u05d5\u05de\u05d3\u05d5\u05ea \u05d1\u05d1\u05e1\u05d9\u05e1 \u05d4\u05e4\u05e1\u05d9\u05db\u05d5\u05e4\u05ea\u05d5\u05dc\u05d5\u05d2\u05d9\u05d4."
    },
    {
      "front": "Developmental Red Flag (Frame 2): \u05de\u05d4 \u05de\u05e1\u05de\u05dc \u05d4-CLOCK-TOWER \u05d4\u05de\u05e8\u05d0\u05d4 12:00 \u05db\u05e9\u05ea\u05d9\u05e0\u05d5\u05e7 \u05d1\u05d5\u05d4\u05d4 \u05d1\u05d1\u05d4\u05d5\u05e0\u05d5\u05ea\u05d9\u05d5 \u05d1\u05de\u05e7\u05d5\u05dd \u05d1\u05e6\u05d9\u05e4\u05d5\u05e8 \u05e9\u05d4\u05d5\u05e8\u05d4 \u05de\u05e6\u05d1\u05d9\u05e2 \u05e2\u05dc\u05d9\u05d4?",
      "back": "\u05d4\u05d9\u05e2\u05d3\u05e8 \u05e7\u05e9\u05d1 \u05de\u05e9\u05d5\u05ea\u05e3 (No joint attention) \u05d1\u05d2\u05d9\u05dc 12 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05de\u05d5\u05d2\u05d3\u05e8 \u05d2\u05d5\u05e8\u05dd Perpetuating \u05d1\u05e4\u05d5\u05e8\u05de\u05d5\u05dc\u05e6\u05d9\u05d4 \u05d4\u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9\u05ea (\u05de\u05d5\u05d3\u05dc \u05d4-4P)?",
      "back": "\u05d2\u05d5\u05e8\u05dd \u05d4\u05de\u05e9\u05de\u05e8 \u05d0\u05ea \u05d4\u05e4\u05e1\u05d9\u05db\u05d5\u05e4\u05ea\u05d5\u05dc\u05d5\u05d2\u05d9\u05d4 \u05dc\u05d0\u05d5\u05e8\u05da \u05d6\u05de\u05df, \u05db\u05d2\u05d5\u05df \u05d3\u05d9\u05e0\u05de\u05d9\u05e7\u05d4 \u05de\u05e9\u05e4\u05d7\u05ea\u05d9\u05ea \u05dc\u05e7\u05d5\u05d9\u05d4."
    },
    {
      "front": "Developmental Red Flag (Frame 3): \u05de\u05d4 \u05de\u05e1\u05de\u05dc \u05e4\u05e2\u05d5\u05d8 \u05e2\u05dd \u05ea\u05dc\u05d9\u05d5\u05df \u05d7\u05d9 (18) \u05d4\u05de\u05d7\u05d6\u05d9\u05e7 \u05d1\u05d5\u05e2\u05ea \u05d3\u05d9\u05d1\u05d5\u05e8 \u05e2\u05dd \u05e1\u05de\u05dc\u05d9\u05dd \u05d1\u05dc\u05d1\u05d3 (\u05d9\u05e8\u05d7, \u05db\u05d3\u05d5\u05e8)?",
      "back": "\u05d4\u05d9\u05e2\u05d3\u05e8 \u05de\u05d9\u05dc\u05d9\u05dd (No real words) \u05d1\u05d2\u05d9\u05dc 18 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05d9\u05ea\u05e8\u05d5\u05df \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05d1\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05e9\u05d0\u05dc\u05d5\u05df \u05d4-CBCL (Child Behavior Checklist)?",
      "back": "\u05d4\u05d5\u05d0 \u05de\u05d0\u05e4\u05e9\u05e8 \u05d4\u05e9\u05d5\u05d5\u05d0\u05ea \u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05de\u05d5\u05e4\u05e0\u05de\u05d9\u05dd \u05d5\u05de\u05d5\u05d7\u05e6\u05e0\u05d9\u05dd \u05dc\u05e0\u05d5\u05e8\u05de\u05d5\u05ea \u05de\u05d1\u05d5\u05e1\u05e1\u05d5\u05ea \u05d2\u05d9\u05dc \u05d5\u05de\u05d2\u05d3\u05e8."
    },
    {
      "front": "\u05d1\u05d1\u05d3\u05d9\u05e7\u05ea \u05d2\u05d9\u05dc \u05d4\u05d2\u05df \u05dc\u05e4\u05d9 \u05d4-Washington University Model, \u05de\u05d4 \u05db\u05d5\u05dc\u05dc\u05ea \u05d4\u05ea\u05e6\u05e4\u05d9\u05ea \u05d4\u05de\u05d5\u05d1\u05e0\u05d9\u05ea?",
      "back": "\u05de\u05d8\u05dc\u05d4 \u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9\u05ea, \u05d7\u05d8\u05d9\u05e3 \u05de\u05e9\u05d5\u05ea\u05e3, \u05d5\u05e1\u05d9\u05d8\u05d5\u05d0\u05e6\u05d9\u05d9\u05ea \u05e4\u05e8\u05d9\u05d3\u05d4 \u05d5\u05d0\u05d9\u05d7\u05d5\u05d3."
    },
    {
      "front": "\u05de\u05d4 \u05de\u05e1\u05de\u05dc \u05d4-Apprentice \u05d1\u05e7\u05d5\u05de\u05d4 2 \u05e9\u05dc \u05d4-Developmental Ladder \u05d4\u05ea\u05d5\u05dc\u05d4 \u05dc\u05e9\u05d5\u05e0\u05d5\u05ea (Tongues) \u05e2\u05dc \u05de\u05db\u05d5\u05e0\u05ea \u05ea\u05e8\u05d2\u05d5\u05dd?",
      "back": "\u05d4\u05ea\u05d7\u05d5\u05dd \u05d4\u05e9\u05e4\u05ea\u05d9 (Language domain)."
    },
    {
      "front": "\u05de\u05d3\u05d5\u05e2 \u05d7\u05e9\u05d5\u05d1 \u05dc\u05e8\u05d0\u05d9\u05d9\u05df \u05d0\u05ea \u05d4\u05de\u05ea\u05d1\u05d2\u05e8 \u05d1\u05e0\u05e4\u05e8\u05d3 \u05de\u05d4\u05d5\u05e8\u05d9\u05d5 \u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05d1\u05d3\u05d9\u05e7\u05d4?",
      "back": "\u05db\u05d3\u05d9 \u05dc\u05d1\u05e0\u05d5\u05ea \u05d1\u05e8\u05d9\u05ea \u05d8\u05d9\u05e4\u05d5\u05dc\u05d9\u05ea (Alliance) \u05d5\u05dc\u05d0\u05e4\u05e9\u05e8 \u05d3\u05d9\u05d5\u05d5\u05d7 \u05d7\u05d5\u05e4\u05e9\u05d9 \u05e2\u05dc \u05d7\u05d5\u05d5\u05d9\u05d5\u05ea \u05e4\u05e0\u05d9\u05de\u05d9\u05d5\u05ea \u05d5\u05e1\u05d9\u05db\u05d5\u05df \u05e2\u05e6\u05de\u05d9."
    }
  ]
}