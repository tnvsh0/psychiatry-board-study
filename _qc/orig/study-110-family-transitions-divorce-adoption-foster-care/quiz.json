{
  "title": "Psychiatry Quiz",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\u05d1\u05df 8 \u05de\u05d5\u05e4\u05e0\u05d4 \u05dc\u05d4\u05e2\u05e8\u05db\u05d4 \u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9\u05ea \u05d1\u05e9\u05dc \u05d9\u05e8\u05d9\u05d3\u05d4 \u05d1\u05ea\u05e4\u05e7\u05d5\u05d3 \u05d4\u05dc\u05d9\u05de\u05d5\u05d3\u05d9, \u05ea\u05dc\u05d5\u05e0\u05d5\u05ea \u05e1\u05d5\u05de\u05d8\u05d9\u05d5\u05ea \u05d7\u05d5\u05d6\u05e8\u05d5\u05ea \u05d5\u05e7\u05e9\u05d9\u05d9 \u05e8\u05d9\u05db\u05d5\u05d6 \u05d1\u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05d4\u05d0\u05d7\u05e8\u05d5\u05e0\u05d9\u05dd. \u05d1\u05e8\u05d0\u05d9\u05d5\u05df, \u05d4\u05d9\u05dc\u05d3 \u05de\u05d1\u05d8\u05d0 \u05d0\u05d1\u05dc \u05e2\u05de\u05d5\u05e7 \u05d5\u05de\u05e9\u05d0\u05dc\u05d5\u05ea \u05e2\u05d6\u05d5\u05ea \u05dc\u05d0\u05d9\u05d7\u05d5\u05d3 \u05d4\u05d5\u05e8\u05d9\u05d5 \u05e9\u05d4\u05ea\u05d2\u05e8\u05e9\u05d5 \u05dc\u05d0\u05d7\u05e8\u05d5\u05e0\u05d4. \u05d4\u05d5\u05d0 \u05de\u05d3\u05d5\u05d5\u05d7 \u05db\u05d9 \u05d4\u05d5\u05d0 \u05d7\u05d5\u05e9\u05e9 \u05dc\u05d4\u05e8\u05d0\u05d5\u05ea \u05d7\u05d9\u05d1\u05d4 \u05dc\u05d0\u05d1\u05d9\u05d5 \u05d1\u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05d0\u05de\u05d5 \u05db\u05d3\u05d9 \u05dc\u05d0 \u05dc\u05e4\u05d2\u05d5\u05e2 \u05d1\u05d4. \u05de\u05d4\u05d5 \u05d4\u05de\u05e0\u05d1\u05d0 \u05d4\u05d7\u05d6\u05e7 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea \u05e4\u05ea\u05d5\u05dc\u05d5\u05d2\u05d9\u05d4 \u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9\u05ea \u05d0\u05e8\u05d5\u05db\u05ea \u05d8\u05d5\u05d5\u05d7 \u05d1\u05de\u05e7\u05e8\u05d4 \u05d6\u05d4?",
      "answerOptions": [
        {
          "text": "\u05e2\u05d5\u05e6\u05de\u05ea \u05d4-Chronic High Interparental Conflict \u05dc\u05e4\u05e0\u05d9, \u05d1\u05de\u05d4\u05dc\u05da \u05d5\u05dc\u05d0\u05d7\u05e8 \u05d4\u05d2\u05d9\u05e8\u05d5\u05e9\u05d9\u05df.",
          "isCorrect": true,
          "rationale": "\u05dc\u05e4\u05d9 \u05d4\u05e1\u05e4\u05e8\u05d5\u05ea, \u05e8\u05de\u05ea \u05d4\u05e7\u05d5\u05e0\u05e4\u05dc\u05d9\u05e7\u05d8 \u05d4\u05d4\u05d5\u05e8\u05d9 \u05d4\u05db\u05e8\u05d5\u05e0\u05d9 \u05d4\u05d9\u05d0 \u05d4\u05de\u05e0\u05d1\u05d0 \u05d4\u05d7\u05d6\u05e7 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05d4\u05e1\u05ea\u05d2\u05dc\u05d5\u05ea \u05d4\u05d9\u05dc\u05d3, \u05d9\u05d5\u05ea\u05e8 \u05de\u05e2\u05e6\u05dd \u05e9\u05d9\u05e0\u05d5\u05d9 \u05d4\u05de\u05d1\u05e0\u05d4 \u05d4\u05de\u05e9\u05e4\u05d7\u05ea\u05d9 \u05d0\u05d5 \u05d4\u05d2\u05d9\u05e8\u05d5\u05e9\u05d9\u05df \u05db\u05e9\u05dc\u05e2\u05e6\u05de\u05dd (Dulcan p.628, 631)."
        },
        {
          "text": "\u05e2\u05e6\u05dd \u05d4\u05de\u05e2\u05d1\u05e8 \u05dc\u05de\u05d1\u05e0\u05d4 \u05e9\u05dc \u05de\u05e9\u05e4\u05d7\u05d4 \u05d7\u05d3-\u05d4\u05d5\u05e8\u05d9\u05ea (Single-parent household).",
          "isCorrect": false,
          "rationale": "\u05de\u05d7\u05e7\u05e8\u05d9\u05dd \u05de\u05e8\u05d0\u05d9\u05dd \u05db\u05d9 \u05d9\u05dc\u05d3\u05d9\u05dd \u05d9\u05db\u05d5\u05dc\u05d9\u05dd \u05dc\u05d4\u05e1\u05ea\u05d2\u05dc \u05d4\u05d9\u05d8\u05d1 \u05dc\u05de\u05d1\u05e0\u05d9\u05dd \u05de\u05e9\u05e4\u05d7\u05ea\u05d9\u05d9\u05dd \u05de\u05d2\u05d5\u05d5\u05e0\u05d9\u05dd; \u05d4\u05d1\u05e2\u05d9\u05d4 \u05d4\u05de\u05e8\u05db\u05d6\u05d9\u05ea \u05d4\u05d9\u05d0 \u05d0\u05d9\u05db\u05d5\u05ea \u05d4\u05d9\u05d7\u05e1\u05d9\u05dd \u05d5\u05d4\u05e7\u05d5\u05e0\u05e4\u05dc\u05d9\u05e7\u05d8 \u05d5\u05dc\u05d0 \u05d4\u05de\u05d1\u05e0\u05d4 \u05d4\u05e4\u05d5\u05e8\u05de\u05dc\u05d9 (Dulcan p.622, 628)."
        },
        {
          "text": "\u05e7\u05d9\u05d5\u05de\u05df \u05e9\u05dc Reunification Fantasies \u05d1\u05d2\u05d9\u05dc \u05d1\u05d9\u05ea \u05d4\u05e1\u05e4\u05e8 \u05d4\u05d9\u05e1\u05d5\u05d3\u05d9.",
          "isCorrect": false,
          "rationale": "\u05e4\u05e0\u05d8\u05d6\u05d9\u05d5\u05ea \u05d0\u05d9\u05d7\u05d5\u05d3 \u05d4\u05df \u05ea\u05d2\u05d5\u05d1\u05d4 \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9\u05ea \u05e0\u05d5\u05e8\u05de\u05d8\u05d9\u05d1\u05d9\u05ea \u05d5\u05e6\u05e4\u05d5\u05d9\u05d4 \u05d1\u05d2\u05d9\u05dc\u05d0\u05d9 \u05d1\u05d9\u05ea \u05d4\u05e1\u05e4\u05e8 \u05d4\u05d9\u05e1\u05d5\u05d3\u05d9 \u05d5\u05d0\u05d9\u05e0\u05df \u05e0\u05d7\u05e9\u05d1\u05d5\u05ea \u05dc\u05de\u05e0\u05d1\u05d0 \u05d4\u05e4\u05ea\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d4\u05de\u05e8\u05db\u05d6\u05d9 (Dulcan p.628)."
        },
        {
          "text": "\u05d7\u05d5\u05e1\u05e8 \u05d9\u05e6\u05d9\u05d1\u05d5\u05ea \u05db\u05dc\u05db\u05dc\u05d9\u05ea \u05d4\u05e0\u05d5\u05d1\u05e2\u05ea \u05de\u05d7\u05dc\u05d5\u05e7\u05ea \u05de\u05e9\u05e7 \u05d4\u05d1\u05d9\u05ea \u05dc\u05e9\u05e0\u05d9\u05d9\u05dd.",
          "isCorrect": false,
          "rationale": "\u05d0\u05de\u05e0\u05dd \u05e7\u05e9\u05d9\u05d9\u05dd \u05db\u05dc\u05db\u05dc\u05d9\u05d9\u05dd \u05d4\u05dd \u05d2\u05d5\u05e8\u05dd \u05e1\u05d8\u05e8\u05e1, \u05d0\u05da \u05d4\u05e7\u05d5\u05e0\u05e4\u05dc\u05d9\u05e7\u05d8 \u05d4\u05d1\u05d9\u05df-\u05d0\u05d9\u05e9\u05d9 \u05d1\u05d9\u05df \u05d4\u05d4\u05d5\u05e8\u05d9\u05dd \u05e0\u05de\u05e6\u05d0 \u05d1\u05de\u05d7\u05e7\u05e8\u05d9\u05dd \u05db\u05d1\u05e2\u05dc \u05d4\u05e9\u05e4\u05e2\u05d4 \u05de\u05db\u05e8\u05e2\u05ea \u05d9\u05d5\u05ea\u05e8 \u05e2\u05dc \u05d1\u05e8\u05d9\u05d0\u05d5\u05ea \u05d4\u05e0\u05e4\u05e9 \u05e9\u05dc \u05d4\u05d9\u05dc\u05d3 (Dulcan p.628)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05d2\u05d5\u05e8\u05dd \u05e9\u05de\u05e9\u05e4\u05d9\u05e2 \u05e2\u05dc \u05d4\u05d9\u05dc\u05d3 \u05dc\u05d0\u05d5\u05e8\u05da \u05db\u05dc \u05e9\u05dc\u05d1\u05d9 \u05d4\u05ea\u05d4\u05dc\u05d9\u05da, \u05dc\u05dc\u05d0 \u05e7\u05e9\u05e8 \u05dc\u05de\u05e2\u05d1\u05e8 \u05d4\u05e4\u05d9\u05d6\u05d9 \u05d1\u05d9\u05df \u05d4\u05d1\u05ea\u05d9\u05dd."
    },
    {
      "type": "multiple_choice",
      "question": "\u05d1\u05ea 14 \u05d4\u05de\u05e6\u05d5\u05d9\u05d4 \u05d1\u05dc\u05d1 \u05e1\u05db\u05e1\u05d5\u05da \u05de\u05e9\u05de\u05d5\u05e8\u05ea \u05e1\u05d5\u05e2\u05e8 \u05de\u05d1\u05d9\u05e2\u05d4 \u05d3\u05d7\u05d9\u05d9\u05d4 \u05e0\u05d5\u05e7\u05e9\u05d4 \u05d5\u05de\u05d5\u05d7\u05dc\u05d8\u05ea \u05db\u05dc\u05e4\u05d9 \u05d0\u05d1\u05d9\u05d4. \u05d4\u05d9\u05d0 \u05de\u05ea\u05d0\u05e8\u05ea \u05d0\u05d5\u05ea\u05d5 \u05db'\u05d0\u05d3\u05dd \u05de\u05e1\u05d5\u05db\u05df' \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05d1\u05d1\u05d9\u05d8\u05d5\u05d9\u05d9\u05dd \u05de\u05e9\u05e4\u05d8\u05d9\u05d9\u05dd \u05de\u05d5\u05e8\u05db\u05d1\u05d9\u05dd \u05e9\u05d0\u05d9\u05e0\u05dd \u05d4\u05d5\u05dc\u05de\u05d9\u05dd \u05d0\u05ea \u05d2\u05d9\u05dc\u05d4, \u05d5\u05d8\u05d5\u05e2\u05e0\u05ea \u05db\u05d9 \u05d0\u05de\u05d4 \u05d4\u05d9\u05d0 '\u05d4\u05d5\u05e8\u05d4 \u05de\u05d5\u05e9\u05dc\u05dd'. \u05d4\u05d9\u05d0 \u05d0\u05d9\u05e0\u05d4 \u05de\u05d1\u05d9\u05e2\u05d4 \u05db\u05dc \u05d7\u05e8\u05d8\u05d4 \u05e2\u05dc \u05d4\u05d9\u05d7\u05e1 \u05d4\u05de\u05d6\u05dc\u05d6\u05dc \u05db\u05dc\u05e4\u05d9 \u05d4\u05d0\u05d1. \u05de\u05d4\u05d5 \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05e4\u05e1\u05d9\u05db\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05d4\u05d1\u05d5\u05dc\u05d8 \u05d1\u05ea\u05d9\u05d0\u05d5\u05e8 \u05d6\u05d4?",
      "answerOptions": [
        {
          "text": "Psychological Splitting (\u05e4\u05d9\u05e6\u05d5\u05dc \u05e4\u05e1\u05d9\u05db\u05d5\u05dc\u05d5\u05d2\u05d9) \u05d1\u05d9\u05df \u05d4\u05d5\u05e8\u05d4 '\u05db\u05d5\u05dc\u05d5 \u05d8\u05d5\u05d1' \u05dc\u05d4\u05d5\u05e8\u05d4 '\u05db\u05d5\u05dc\u05d5 \u05e8\u05e2'.",
          "isCorrect": true,
          "rationale": "\u05d1\u05de\u05e6\u05d1\u05d9 \u05e0\u05d9\u05db\u05d5\u05e8 \u05d4\u05d5\u05e8\u05d9 (Parental Alienation), \u05d4\u05d9\u05dc\u05d3 \u05de\u05e9\u05ea\u05de\u05e9 \u05d1\u05e4\u05d9\u05e6\u05d5\u05dc \u05db\u05d4\u05d2\u05e0\u05d4, \u05dc\u05e6\u05d3 '\u05ea\u05e1\u05e8\u05d9\u05d8\u05d9\u05dd \u05de\u05d5\u05e9\u05d0\u05dc\u05d9\u05dd' (Borrowed Scenarios) \u05d5\u05d4\u05d9\u05e2\u05d3\u05e8 \u05d0\u05de\u05e4\u05ea\u05d9\u05d4 \u05db\u05dc\u05e4\u05d9 \u05d4\u05d4\u05d5\u05e8\u05d4 \u05d4\u05de\u05e0\u05d5\u05db\u05e8 (Dulcan p.629)."
        },
        {
          "text": "Realistic Estrangement (\u05d3\u05d7\u05d9\u05d9\u05d4 \u05de\u05d5\u05e6\u05d3\u05e7\u05ea) \u05e2\u05dc \u05e8\u05e7\u05e2 \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05e4\u05d5\u05d2\u05e2\u05e0\u05d9\u05ea \u05e9\u05dc \u05d4\u05d0\u05d1.",
          "isCorrect": false,
          "rationale": "\u05d3\u05d7\u05d9\u05d9\u05d4 \u05de\u05d5\u05e6\u05d3\u05e7\u05ea \u05de\u05d1\u05d5\u05e1\u05e1\u05ea \u05d1\u05d3\u05e8\u05da \u05db\u05dc\u05dc \u05e2\u05dc \u05d0\u05d9\u05e8\u05d5\u05e2\u05d9\u05dd \u05e2\u05d5\u05d1\u05d3\u05ea\u05d9\u05d9\u05dd \u05d5\u05ea\u05d9\u05d0\u05d5\u05e8 \u05de\u05e6\u05d9\u05d0\u05d5\u05ea\u05d9 \u05d9\u05d5\u05ea\u05e8 \u05e9\u05dc \u05d4\u05d4\u05d5\u05e8\u05d4, \u05d5\u05dc\u05d0 \u05e2\u05dc \u05d0\u05d9\u05d3\u05d9\u05d0\u05dc\u05d9\u05d6\u05e6\u05d9\u05d4 \u05de\u05d5\u05d7\u05dc\u05d8\u05ea \u05e9\u05dc \u05d4\u05d4\u05d5\u05e8\u05d4 \u05d4\u05e9\u05e0\u05d9 (Dulcan p.629, 646)."
        },
        {
          "text": "Separation-Individuation \u05e0\u05d5\u05e8\u05de\u05d8\u05d9\u05d1\u05d9 \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05d0\u05ea \u05d2\u05d9\u05dc \u05d4\u05d4\u05ea\u05d1\u05d2\u05e8\u05d5\u05ea.",
          "isCorrect": false,
          "rationale": "\u05ea\u05d4\u05dc\u05d9\u05da \u05d0\u05d9\u05e0\u05d3\u05d9\u05d1\u05d9\u05d3\u05d5\u05d0\u05e6\u05d9\u05d4 \u05ea\u05e7\u05d9\u05df \u05db\u05d5\u05dc\u05dc \u05d4\u05ea\u05e8\u05d7\u05e7\u05d5\u05ea \u05d4\u05d3\u05e8\u05d2\u05ea\u05d9\u05ea \u05d0\u05da \u05dc\u05d0 \u05d3\u05d7\u05d9\u05d9\u05d4 \u05de\u05d5\u05d7\u05dc\u05d8\u05ea \u05d5\u05d3\u05d9\u05db\u05d5\u05d8\u05d5\u05de\u05d9\u05ea \u05d4\u05de\u05dc\u05d5\u05d5\u05d4 \u05d1\u05d1\u05d9\u05d8\u05d5\u05d9\u05d9\u05dd \u05de\u05d5\u05e9\u05d0\u05dc\u05d9\u05dd \u05de\u05d4\u05d4\u05d5\u05e8\u05d4 \u05d4\u05e9\u05e0\u05d9 (Dulcan p.625, 628)."
        },
        {
          "text": "Parentification (\u05d4\u05d5\u05e8\u05d5\u05ea \u05d4\u05d5\u05e8\u05d9\u05ea) \u05e9\u05d1\u05d4 \u05d4\u05e0\u05e2\u05e8\u05d4 \u05de\u05d2\u05e0\u05d4 \u05e2\u05dc \u05d0\u05de\u05d4.",
          "isCorrect": false,
          "rationale": "\u05d1\u05e2\u05d5\u05d3 \u05e9\u05d9\u05d9\u05ea\u05db\u05df \u05d5\u05d9\u05e9 \u05d0\u05dc\u05de\u05e0\u05d8 \u05db\u05d6\u05d4, \u05d4\u05ea\u05d9\u05d0\u05d5\u05e8 \u05d4\u05de\u05d3\u05d5\u05d9\u05e7 \u05e9\u05dc \u05d3\u05d7\u05d9\u05d9\u05ea \u05d4\u05d5\u05e8\u05d4 \u05d0\u05d7\u05d3 \u05d5\u05d0\u05d9\u05d3\u05d9\u05d0\u05dc\u05d9\u05d6\u05e6\u05d9\u05d4 \u05e9\u05dc \u05d4\u05e9\u05e0\u05d9 \u05dc\u05dc\u05d0 \u05d0\u05e9\u05de\u05d4 \u05de\u05e6\u05d1\u05d9\u05e2 \u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05e2\u05dc \u05d3\u05d9\u05e0\u05de\u05d9\u05e7\u05ea \u05e0\u05d9\u05db\u05d5\u05e8 (Dulcan p.628, 631)."
        }
      ],
      "hint": "\u05e9\u05d9\u05dd \u05dc\u05d1 \u05dc\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05d1\u05d9\u05d8\u05d5\u05d9\u05d9\u05dd \u05de\u05d5\u05e2\u05ea\u05e7\u05d9\u05dd \u05de\u05d4\u05d4\u05d5\u05e8\u05d4 \u05d4\u05de\u05e0\u05db\u05e8 \u05d5\u05dc\u05d4\u05d9\u05e2\u05d3\u05e8 \u05d4\u05d0\u05de\u05e4\u05ea\u05d9\u05d4 \u05d4\u05de\u05d5\u05d7\u05dc\u05d8."
    },
    {
      "type": "multiple_choice",
      "question": "\u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8 \u05d9\u05dc\u05d3\u05d9\u05dd \u05de\u05ea\u05d1\u05e7\u05e9 \u05dc\u05d4\u05de\u05dc\u05d9\u05e5 \u05e2\u05dc \u05d8\u05d9\u05e4\u05d5\u05dc \u05e2\u05d1\u05d5\u05e8 \u05d1\u05df 4 \u05e9\u05d4\u05d5\u05e8\u05d9\u05d5 \u05d4\u05ea\u05d2\u05e8\u05e9\u05d5 \u05dc\u05d0\u05d7\u05e8\u05d5\u05e0\u05d4. \u05d4\u05d9\u05dc\u05d3 \u05de\u05e4\u05d2\u05d9\u05df \u05d4\u05ea\u05e7\u05e4\u05d9 \u05d6\u05e2\u05dd, \u05e0\u05e1\u05d9\u05d2\u05d4 \u05d1\u05d2\u05de\u05d9\u05dc\u05d4 \u05d5\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05ea\u05d5\u05e7\u05e4\u05e0\u05d9\u05ea. \u05d1\u05e8\u05d0\u05d9\u05d5\u05df \u05e2\u05dd \u05d4\u05d0\u05dd, \u05de\u05ea\u05d1\u05e8\u05e8 \u05db\u05d9 \u05d4\u05d9\u05dc\u05d3 \u05de\u05e9\u05d5\u05db\u05e0\u05e2 \u05e9\u05d0\u05d1\u05d9\u05d5 \u05e2\u05d6\u05d1 \u05d0\u05ea \u05d4\u05d1\u05d9\u05ea \u05db\u05d9 \u05d4\u05d9\u05dc\u05d3 '\u05dc\u05d0 \u05e1\u05d9\u05d3\u05e8 \u05d0\u05ea \u05d4\u05e6\u05e2\u05e6\u05d5\u05e2\u05d9\u05dd'. \u05d0\u05d9\u05d6\u05d5 \u05ea\u05db\u05d5\u05e0\u05d4 \u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9\u05ea \u05de\u05e1\u05d1\u05d9\u05e8\u05d4 \u05d0\u05ea \u05ea\u05e4\u05d9\u05e1\u05ea\u05d5 \u05e9\u05dc \u05d4\u05d9\u05dc\u05d3?",
      "answerOptions": [
        {
          "text": "Egocentric Thinking (\u05d7\u05e9\u05d9\u05d1\u05d4 \u05d0\u05d2\u05d5\u05e6\u05e0\u05d8\u05e8\u05d9\u05ea) \u05d5\u05e7\u05d5\u05d2\u05e0\u05d9\u05e6\u05d9\u05d4 \u05de\u05d2\u05d9\u05d0\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea (Magical Thinking).",
          "isCorrect": true,
          "rationale": "\u05d9\u05dc\u05d3\u05d9\u05dd \u05d1\u05d2\u05d9\u05dc \u05d4\u05e8\u05da \u05e0\u05d5\u05d8\u05d9\u05dd \u05dc\u05e4\u05e8\u05e9 \u05d0\u05d9\u05e8\u05d5\u05e2\u05d9\u05dd \u05d7\u05d9\u05e6\u05d5\u05e0\u05d9\u05d9\u05dd \u05db\u05ea\u05d5\u05e6\u05d0\u05d4 \u05d9\u05e9\u05d9\u05e8\u05d4 \u05e9\u05dc \u05de\u05e2\u05e9\u05d9\u05d4\u05dd \u05d0\u05d5 \u05de\u05d7\u05e9\u05d1\u05d5\u05ea\u05d9\u05d4\u05dd, \u05de\u05d4 \u05e9\u05de\u05d5\u05d1\u05d9\u05dc \u05dc\u05d0\u05e9\u05de\u05d4 \u05e2\u05e6\u05de\u05d9\u05ea \u05d1\u05d2\u05d9\u05e8\u05d5\u05e9\u05d9\u05df (Dulcan p.628)."
        },
        {
          "text": "\u05d9\u05db\u05d5\u05dc\u05ea \u05dc\u05d1\u05d9\u05e6\u05d5\u05e2 Concrete Operations (\u05e4\u05e2\u05d5\u05dc\u05d5\u05ea \u05e7\u05d5\u05e0\u05e7\u05e8\u05d8\u05d9\u05d5\u05ea).",
          "isCorrect": false,
          "rationale": "\u05d9\u05db\u05d5\u05dc\u05ea \u05d6\u05d5 \u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05ea \u05d0\u05ea \u05d2\u05d9\u05dc \u05d1\u05d9\u05ea \u05d4\u05e1\u05e4\u05e8 \u05d4\u05d9\u05e1\u05d5\u05d3\u05d9 (6-11) \u05d5\u05dc\u05d0 \u05d0\u05ea \u05d2\u05d9\u05dc\u05d0\u05d9 2-5, \u05d5\u05d1\u05d4 \u05d4\u05d9\u05dc\u05d3 \u05db\u05d1\u05e8 \u05de\u05d1\u05d9\u05df \u05d8\u05d5\u05d1 \u05d9\u05d5\u05ea\u05e8 \u05d0\u05ea \u05e1\u05d9\u05d1\u05ea\u05d9\u05d5\u05ea \u05d4\u05d0\u05d9\u05e8\u05d5\u05e2\u05d9\u05dd (Dulcan p.66)."
        },
        {
          "text": "\u05d4\u05d9\u05e2\u05d3\u05e8 \u05d9\u05db\u05d5\u05dc\u05ea Mentalization (\u05de\u05e0\u05d8\u05dc\u05d9\u05d6\u05e6\u05d9\u05d4) \u05d1\u05e1\u05d9\u05e1\u05d9\u05ea.",
          "isCorrect": false,
          "rationale": "\u05d1\u05e2\u05d5\u05d3 \u05d4\u05de\u05e0\u05d8\u05dc\u05d9\u05d6\u05e6\u05d9\u05d4 \u05de\u05ea\u05e4\u05ea\u05d7\u05ea, \u05d4\u05d1\u05e2\u05d9\u05d4 \u05db\u05d0\u05df \u05d4\u05d9\u05d0 \u05d4\u05e4\u05e8\u05e9\u05e0\u05d5\u05ea \u05d4\u05d0\u05d2\u05d5\u05e6\u05e0\u05d8\u05e8\u05d9\u05ea \u05d4\u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05ea \u05dc\u05de\u05e2\u05d1\u05e8 \u05d4\u05de\u05e9\u05e4\u05d7\u05ea\u05d9 \u05d5\u05dc\u05d0 \u05d7\u05d5\u05e1\u05e8 \u05d9\u05db\u05d5\u05dc\u05ea \u05db\u05dc\u05dc\u05d9\u05ea \u05dc\u05d4\u05d1\u05d9\u05df \u05e8\u05d2\u05e9\u05d5\u05ea (Dulcan p.855)."
        },
        {
          "text": "\u05e4\u05d9\u05ea\u05d5\u05d7 \u05e9\u05dc Identity Disruption \u05e2\u05dc \u05e8\u05e7\u05e2 \u05d4\u05d2\u05d9\u05e8\u05d5\u05e9\u05d9\u05df.",
          "isCorrect": false,
          "rationale": "\u05e9\u05d9\u05d1\u05d5\u05e9 \u05d1\u05d6\u05d4\u05d5\u05ea \u05d4\u05d5\u05d0 \u05de\u05d5\u05e9\u05d2 \u05e9\u05e8\u05dc\u05d5\u05d5\u05e0\u05d8\u05d9 \u05d9\u05d5\u05ea\u05e8 \u05dc\u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd \u05d0\u05d5 \u05dc\u05d9\u05dc\u05d3\u05d9\u05dd \u05e9\u05d7\u05d5\u05d5 \u05d0\u05d1\u05dc \u05de\u05d5\u05e8\u05db\u05d1, \u05d5\u05dc\u05d0 \u05dc\u05e7\u05d5\u05d2\u05e0\u05d9\u05e6\u05d9\u05d4 \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05ea \u05d2\u05d9\u05dc 4 (DSM p.325)."
        }
      ],
      "hint": "\u05d4\u05de\u05d5\u05e9\u05d2 \u05de\u05ea\u05d9\u05d9\u05d7\u05e1 \u05dc\u05e0\u05d8\u05d9\u05d9\u05d4 \u05e9\u05dc \u05d4\u05d9\u05dc\u05d3 \u05dc\u05d4\u05e6\u05d9\u05d1 \u05d0\u05ea \u05e2\u05e6\u05de\u05d5 \u05db\u05de\u05e8\u05db\u05d6 \u05d4\u05e1\u05d9\u05d1\u05ea\u05d9\u05d5\u05ea \u05e9\u05dc \u05db\u05dc \u05d0\u05d9\u05e8\u05d5\u05e2 \u05d1\u05e2\u05d5\u05dc\u05dd."
