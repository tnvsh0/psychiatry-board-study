    {
      "type": "multiple_select",
      "question": "\u05d1\u05e2\u05ea \u05d4\u05e2\u05e8\u05db\u05d4 \u05e9\u05dc \u05d9\u05dc\u05d3 \u05de\u05d0\u05d5\u05de\u05e5 \u05d4\u05de\u05d5\u05e4\u05e0\u05d4 \u05d1\u05e9\u05dc \u05e7\u05e9\u05d9\u05d9 \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d5\u05e8\u05d9\u05db\u05d5\u05d6, \u05d0\u05d9\u05dc\u05d5 \u05de\u05d4\u05d2\u05d5\u05e8\u05de\u05d9\u05dd \u05d4\u05d1\u05d0\u05d9\u05dd \u05e0\u05de\u05e6\u05d0\u05d5 \u05d1\u05e1\u05e4\u05e8\u05d5\u05ea \u05db\u05e7\u05e9\u05d5\u05e8\u05d9\u05dd \u05dc\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d4\u05de\u05d5\u05d2\u05d1\u05e8\u05ea \u05e9\u05dc \u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05e0\u05e4\u05e9\u05d9\u05ea \u05d1\u05d0\u05d5\u05db\u05dc\u05d5\u05e1\u05d9\u05d9\u05d4 \u05d6\u05d5?",
      "answerOptions": [
        {
          "text": "\u05d7\u05e9\u05d9\u05e4\u05d4 \u05d8\u05e8\u05d5\u05dd-\u05dc\u05d9\u05d3\u05ea\u05d9\u05ea \u05dc-Toxins \u05d0\u05d5 \u05dc\u05d0\u05dc\u05db\u05d5\u05d4\u05d5\u05dc (Prenatal Alcohol Exposure).",
          "isCorrect": true,
          "rationale": "\u05d7\u05e9\u05d9\u05e4\u05d4 \u05d6\u05d5 \u05d4\u05d9\u05d0 \u05d2\u05d5\u05e8\u05dd \u05e1\u05d9\u05db\u05d5\u05df \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9 \u05dc\u05d1\u05e2\u05d9\u05d5\u05ea \u05e0\u05d5\u05d9\u05e8\u05d5-\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9\u05d5\u05ea \u05d5\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea\u05d9\u05d5\u05ea \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05de\u05d0\u05d5\u05de\u05e6\u05d9\u05dd (Dulcan p.542, 893)."
        },
        {
          "text": "\u05e0\u05d8\u05d9\u05d9\u05d4 \u05d2\u05e0\u05d8\u05d9\u05ea (Genetic influences) \u05d4\u05de\u05d5\u05e2\u05d1\u05e8\u05ea \u05de\u05d4\u05d4\u05d5\u05e8\u05d9\u05dd \u05d4\u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05d9\u05dd.",
          "isCorrect": true,
          "rationale": "\u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4 \u05de\u05e9\u05e4\u05d7\u05ea\u05d9\u05ea \u05e9\u05dc \u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9\u05d5\u05ea \u05d0\u05e6\u05dc \u05d4\u05d4\u05d5\u05e8\u05d9\u05dd \u05d4\u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05d9\u05dd \u05de\u05e2\u05dc\u05d4 \u05d0\u05ea \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea ADHD, ODD \u05d5-CD \u05d0\u05e6\u05dc \u05d4\u05d9\u05dc\u05d3 (Dulcan p.121, 542)."
        },
        {
          "text": "\u05d7\u05d5\u05e1\u05e8 \u05d9\u05e6\u05d9\u05d1\u05d5\u05ea \u05de\u05d5\u05e7\u05d3\u05dd \u05d1-Caregiving (\u05de\u05e2\u05d1\u05e8\u05d9\u05dd \u05de\u05e8\u05d5\u05d1\u05d9\u05dd \u05d1\u05d9\u05df \u05de\u05e1\u05d2\u05e8\u05d5\u05ea).",
          "isCorrect": true,
          "rationale": "\u05d7\u05d5\u05e1\u05e8 \u05d4\u05de\u05e9\u05db\u05d9\u05d5\u05ea \u05d1\u05d3\u05de\u05d5\u05ea \u05d4\u05de\u05d8\u05e4\u05dc \u05dc\u05e4\u05e0\u05d9 \u05d4\u05d0\u05d9\u05de\u05d5\u05e5 \u05e4\u05d5\u05d2\u05e2 \u05d1\u05de\u05e0\u05d2\u05e0\u05d5\u05e0\u05d9 \u05d4\u05d4\u05ea\u05e7\u05e9\u05e8\u05d5\u05ea \u05d5\u05de\u05e2\u05dc\u05d4 \u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05db\u05de\u05d5 RAD \u05d5-DSED (DSM p.296, 299)."
        },
        {
          "text": "\u05d2\u05d9\u05dc\u05d5\u05d9 \u05de\u05d5\u05e7\u05d3\u05dd \u05de\u05d3\u05d9 \u05e9\u05dc \u05e2\u05d5\u05d1\u05d3\u05ea \u05d4\u05d0\u05d9\u05de\u05d5\u05e5 (Disclosure) \u05dc\u05e4\u05e0\u05d9 \u05d2\u05d9\u05dc 5.",
          "isCorrect": false,
          "rationale": "\u05dc\u05d4\u05e4\u05da, \u05d2\u05d9\u05dc\u05d5\u05d9 \u05de\u05d5\u05e7\u05d3\u05dd \u05d5\u05e4\u05ea\u05d5\u05d7 \u05e9\u05dc \u05d4\u05d0\u05d9\u05de\u05d5\u05e5 \u05e0\u05d7\u05e9\u05d1 \u05dc\u05d2\u05d5\u05e8\u05dd \u05de\u05d2\u05df \u05d4\u05de\u05e4\u05d7\u05d9\u05ea \u05e4\u05e0\u05d8\u05d6\u05d9\u05d5\u05ea \u05e9\u05dc\u05d9\u05dc\u05d9\u05d5\u05ea \u05d5\u05ea\u05d5\u05e8\u05dd \u05dc\u05d4\u05e1\u05ea\u05d2\u05dc\u05d5\u05ea (Dulcan p.622, 893)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d2\u05d5\u05e8\u05de\u05d9\u05dd \u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05d9\u05dd \u05d5\u05e1\u05d1\u05d9\u05d1\u05ea\u05d9\u05d9\u05dd \u05d4\u05de\u05ea\u05e8\u05d7\u05e9\u05d9\u05dd \u05e2\u05d5\u05d3 \u05dc\u05e4\u05e0\u05d9 \u05e9\u05d4\u05d9\u05dc\u05d3 \u05d4\u05d2\u05d9\u05e2 \u05dc\u05de\u05e9\u05e4\u05d7\u05ea\u05d5 \u05d4\u05de\u05d0\u05de\u05e6\u05ea.",
      "hasAllOfTheAbove": false,
      "hasNoneOfTheAbove": false
    },
    {
      "type": "fill_in_the_blank",
      "question": "\u05dc\u05e4\u05d9 \u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05e9\u05dc \u05d4-DSM-5-TR \u05dc\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05d4\u05ea\u05e7\u05e9\u05e8\u05d5\u05ea, \u05d4\u05d5\u05db\u05d7\u05d4 \u05dc\u05e7\u05d9\u05d5\u05de\u05d5 \u05e9\u05dc \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df C, \u05d4\u05de\u05ea\u05d0\u05e8 \u05d3\u05e4\u05d5\u05e1 \u05e9\u05dc ___ (Extremes of insufficient care), \u05d4\u05d9\u05d0 \u05ea\u05e0\u05d0\u05d9 \u05d4\u05db\u05e8\u05d7\u05d9 \u05dc\u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc Reactive Attachment Disorder (RAD).",
      "bestAnswer": "social neglect",
      "acceptableAnswers": [
