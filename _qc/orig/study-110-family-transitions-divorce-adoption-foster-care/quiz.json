      ],
      "rationale": "\u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc RAD \u05de\u05d7\u05d9\u05d9\u05d1\u05ea \u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4 \u05e9\u05dc \u05d4\u05d6\u05e0\u05d7\u05d4 \u05d7\u05d1\u05e8\u05ea\u05d9\u05ea \u05d0\u05d5 \u05d7\u05e1\u05da \u05d1\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05e1\u05d9\u05e1\u05d9 \u05e9\u05d4\u05d5\u05d1\u05d9\u05dc \u05dc\u05d3\u05e4\u05d5\u05e1 \u05d4\u05d4\u05ea\u05e7\u05e9\u05e8\u05d5\u05ea \u05d4\u05e4\u05ea\u05d5\u05dc\u05d5\u05d2\u05d9 (DSM p.295-296).",
      "hint": "\u05d4\u05de\u05d5\u05e9\u05d2 \u05de\u05ea\u05d9\u05d9\u05d7\u05e1 \u05dc\u05d7\u05d5\u05e1\u05e8 \u05d1\u05de\u05ea\u05df \u05de\u05e2\u05e0\u05d4 \u05dc\u05e6\u05e8\u05db\u05d9\u05dd \u05e8\u05d2\u05e9\u05d9\u05d9\u05dd \u05d1\u05e1\u05d9\u05e1\u05d9\u05d9\u05dd \u05e9\u05dc \u05e0\u05d7\u05de\u05d4 \u05d5\u05d7\u05d9\u05d1\u05d4 \u05de\u05e6\u05d3 \u05d4\u05de\u05d8\u05e4\u05dc\u05d9\u05dd."
    },
    {
      "type": "multiple_choice",
      "question": "\u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8 \u05de\u05d8\u05e4\u05dc \u05d1\u05d9\u05dc\u05d3 \u05e9\u05d4\u05d5\u05e8\u05d9\u05d5 \u05d2\u05e8\u05d5\u05e9\u05d9\u05dd \u05d5\u05de\u05d7\u05d6\u05d9\u05e7\u05d9\u05dd \u05d1-Joint Legal Custody (\u05de\u05e9\u05de\u05d5\u05e8\u05ea \u05de\u05e9\u05e4\u05d8\u05d9\u05ea \u05de\u05e9\u05d5\u05ea\u05e4\u05ea). \u05d4\u05d0\u05d1 \u05de\u05e2\u05d5\u05e0\u05d9\u05d9\u05df \u05dc\u05d4\u05ea\u05d7\u05d9\u05dc \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Methylphenidate \u05d1\u05e9\u05dc ADHD, \u05d0\u05da \u05d4\u05d0\u05dd \u05de\u05ea\u05e0\u05d2\u05d3\u05ea \u05d1\u05ea\u05d5\u05e7\u05e3 \u05dc\u05db\u05dc \u05d8\u05d9\u05e4\u05d5\u05dc \u05ea\u05e8\u05d5\u05e4\u05ea\u05d9. \u05de\u05d4\u05d5 \u05d4\u05db\u05dc\u05dc \u05d4\u05d0\u05ea\u05d9/\u05de\u05e9\u05e4\u05d8\u05d9 \u05d4\u05de\u05d7\u05d9\u05d9\u05d1 \u05d1\u05de\u05e7\u05e8\u05d4 \u05d6\u05d4?",
      "answerOptions": [
        {
          "text": "\u05d9\u05e9 \u05dc\u05e7\u05d1\u05dc \u05d4\u05e1\u05db\u05de\u05d4 \u05de\u05d3\u05e2\u05ea (Informed Consent) \u05de\u05e9\u05e0\u05d9 \u05d4\u05d4\u05d5\u05e8\u05d9\u05dd \u05dc\u05e4\u05e0\u05d9 \u05d4\u05ea\u05d7\u05dc\u05ea \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc.",
          "isCorrect": true,
          "rationale": "\u05d1\u05de\u05e6\u05d1 \u05e9\u05dc \u05de\u05e9\u05de\u05d5\u05e8\u05ea \u05de\u05e9\u05e4\u05d8\u05d9\u05ea \u05de\u05e9\u05d5\u05ea\u05e4\u05ea, \u05d4\u05d7\u05dc\u05d8\u05d5\u05ea \u05de\u05d4\u05d5\u05ea\u05d9\u05d5\u05ea \u05dc\u05d2\u05d1\u05d9 \u05d8\u05d9\u05e4\u05d5\u05dc \u05e0\u05e4\u05e9\u05d9 \u05d5\u05ea\u05e8\u05d5\u05e4\u05ea\u05d9 \u05d3\u05d5\u05e8\u05e9\u05d5\u05ea \u05d4\u05e1\u05db\u05de\u05d4 \u05e9\u05dc \u05e9\u05e0\u05d9 \u05d4\u05d4\u05d5\u05e8\u05d9\u05dd (Dulcan p.646)."
        },
        {
          "text": "\u05e0\u05d9\u05ea\u05df \u05dc\u05d4\u05e1\u05ea\u05e4\u05e7 \u05d1\u05d4\u05e1\u05db\u05de\u05ea \u05d4\u05d4\u05d5\u05e8\u05d4 \u05d0\u05e6\u05dc\u05d5 \u05e0\u05de\u05e6\u05d0 \u05d4\u05d9\u05dc\u05d3 \u05d1\u05e8\u05d5\u05d1 \u05d9\u05de\u05d9 \u05d4\u05e9\u05d1\u05d5\u05e2 (Primary Residence).",
          "isCorrect": false,
          "rationale": "\u05de\u05e7\u05d5\u05dd \u05d4\u05de\u05d2\u05d5\u05e8\u05d9\u05dd \u05d0\u05d5 \u05d7\u05dc\u05d5\u05e7\u05ea \u05d6\u05de\u05e0\u05d9 \u05d4\u05e9\u05d4\u05d5\u05ea (Physical Custody) \u05d0\u05d9\u05e0\u05dd \u05de\u05e7\u05e0\u05d9\u05dd \u05d6\u05db\u05d5\u05ea \u05d1\u05dc\u05e2\u05d3\u05d9\u05ea \u05dc\u05e7\u05d1\u05dc\u05ea \u05d4\u05d7\u05dc\u05d8\u05d5\u05ea \u05e8\u05e4\u05d5\u05d0\u05d9\u05d5\u05ea \u05d1\u05de\u05e6\u05d1 \u05e9\u05dc \u05de\u05e9\u05de\u05d5\u05e8\u05ea \u05de\u05e9\u05e4\u05d8\u05d9\u05ea \u05de\u05e9\u05d5\u05ea\u05e4\u05ea (Dulcan p.646)."
        },
        {
          "text": "\u05d4\u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8 \u05d9\u05db\u05d5\u05dc \u05dc\u05d4\u05d7\u05dc\u05d9\u05d8 \u05e2\u05dc \u05d3\u05e2\u05ea \u05e2\u05e6\u05de\u05d5 \u05d0\u05dd \u05d8\u05d5\u05d1\u05ea \u05d4\u05d9\u05dc\u05d3 \u05de\u05d7\u05d9\u05d9\u05d1\u05ea \u05d0\u05ea \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc.",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05e9\u05d9\u05e7\u05d5\u05dc \u05d4\u05d3\u05e2\u05ea \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9, \u05d4\u05d7\u05d5\u05e7 \u05de\u05d7\u05d9\u05d9\u05d1 \u05d0\u05ea \u05d4\u05e1\u05db\u05de\u05ea \u05d4\u05d0\u05e4\u05d5\u05d8\u05e8\u05d5\u05e4\u05d5\u05e1\u05d9\u05dd \u05d4\u05de\u05e9\u05e4\u05d8\u05d9\u05d9\u05dd, \u05d5\u05d4\u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8 \u05d0\u05d9\u05e0\u05d5 \u05e8\u05e9\u05d0\u05d9 \u05dc\u05e2\u05e7\u05d5\u05e3 \u05d6\u05d0\u05ea \u05dc\u05dc\u05d0 \u05e6\u05d5 \u05d1\u05d9\u05ea \u05de\u05e9\u05e4\u05d8 (Dulcan p.644, 646)."
        },
        {
          "text": "\u05d4\u05e1\u05db\u05de\u05ea \u05d4\u05d4\u05d5\u05e8\u05d4 \u05e9\u05d4\u05d1\u05d9\u05d0 \u05d0\u05ea \u05d4\u05d9\u05dc\u05d3 \u05dc\u05d1\u05d3\u05d9\u05e7\u05d4 \u05de\u05e1\u05e4\u05d9\u05e7\u05d4 \u05de\u05e9\u05e4\u05d8\u05d9\u05ea (Presumed Consent).",
          "isCorrect": false,
          "rationale": "\u05d1\u05de\u05e7\u05e8\u05d9\u05dd \u05e9\u05dc \u05d2\u05d9\u05e8\u05d5\u05e9\u05d9\u05df \u05d5\u05e1\u05db\u05e1\u05d5\u05da \u05d9\u05d3\u05d5\u05e2, \u05d4\u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8 \u05de\u05d7\u05d5\u05d9\u05d1 \u05dc\u05d5\u05d5\u05d3\u05d0 \u05d0\u05ea \u05d4\u05e1\u05db\u05de\u05ea \u05e9\u05e0\u05d9 \u05d4\u05d4\u05d5\u05e8\u05d9\u05dd \u05d5\u05dc\u05d0 \u05dc\u05d4\u05e1\u05ea\u05de\u05da \u05e2\u05dc \u05d4\u05e0\u05d7\u05ea \u05d4\u05e1\u05db\u05de\u05d4 (Dulcan p.646)."
        }
      ],
      "hint": "\u05d4\u05d4\u05d2\u05d3\u05e8\u05d4 \u05e9\u05dc '\u05de\u05e9\u05de\u05d5\u05e8\u05ea \u05de\u05e9\u05e4\u05d8\u05d9\u05ea' \u05e0\u05d5\u05d2\u05e2\u05ea \u05dc\u05d6\u05db\u05d5\u05d9\u05d5\u05ea \u05e7\u05d1\u05dc\u05ea \u05d4\u05d7\u05dc\u05d8\u05d5\u05ea, \u05dc\u05dc\u05d0 \u05e7\u05e9\u05e8 \u05dc\u05de\u05e7\u05d5\u05dd \u05d4\u05dc\u05d9\u05e0\u05d4 \u05e9\u05dc \u05d4\u05d9\u05dc\u05d3."
    },
    {
      "type": "short_answer",
      "question": "\u05d4\u05e1\u05d1\u05e8 \u05d0\u05ea \u05d4\u05de\u05d5\u05e8\u05db\u05d1\u05d5\u05ea \u05d4\u05d9\u05d9\u05d7\u05d5\u05d3\u05d9\u05ea \u05e9\u05dc \u05d2\u05d9\u05d1\u05d5\u05e9 \u05d4\u05d6\u05d4\u05d5\u05ea (Identity formation) \u05d0\u05e6\u05dc \u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd \u05de\u05d0\u05d5\u05de\u05e6\u05d9\u05dd, \u05db\u05e4\u05d9 \u05e9\u05de\u05ea\u05d5\u05d0\u05e8 \u05d1\u05e1\u05e4\u05e8 \u05d4-Dulcan.",
      "grading": {
        "modelAnswer": "\u05d1\u05d2\u05d9\u05dc \u05d4\u05d4\u05ea\u05d1\u05d2\u05e8\u05d5\u05ea, \u05d4\u05de\u05e9\u05d9\u05de\u05d4 \u05d4\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9\u05ea \u05e9\u05dc \u05d2\u05d9\u05d1\u05d5\u05e9 \u05d6\u05d4\u05d5\u05ea \u05d4\u05d5\u05e4\u05db\u05ea \u05dc\u05de\u05d5\u05e8\u05db\u05d1\u05ea \u05d9\u05d5\u05ea\u05e8 \u05e2\u05d1\u05d5\u05e8 \u05d4\u05de\u05d0\u05d5\u05de\u05e5, \u05db\u05d9\u05d5\u05d5\u05df \u05e9\u05e2\u05dc\u05d9\u05d5 \u05dc\u05d1\u05e6\u05e2 \u05d0\u05d9\u05e0\u05d8\u05d2\u05e8\u05e6\u05d9\u05d4 \u05d1\u05d9\u05df \u05e9\u05ea\u05d9 \u05d6\u05d4\u05d5\u05d9\u05d5\u05ea: \u05d4\u05d6\u05d4\u05d5\u05ea \u05d4\u05e0\u05e8\u05db\u05e9\u05ea \u05d1\u05de\u05e9\u05e4\u05d7\u05d4 \u05d4\u05de\u05d0\u05de\u05e6\u05ea \u05d5\u05d4\u05d6\u05d4\u05d5\u05ea \u05d4\u05d2\u05e0\u05d8\u05d9\u05ea-\u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea. \u05ea\u05d4\u05dc\u05d9\u05da \u05d6\u05d4 \u05db\u05d5\u05dc\u05dc \u05dc\u05e2\u05d9\u05ea\u05d9\u05dd \u05e7\u05e8\u05d5\u05d1\u05d5\u05ea \u05d7\u05d9\u05e4\u05d5\u05e9 \u05d0\u05d7\u05e8 \u05e9\u05d5\u05e8\u05e9\u05d9\u05dd (Search for birth parents) \u05db\u05d7\u05dc\u05e7 \u05e0\u05d5\u05e8\u05de\u05d8\u05d9\u05d1\u05d9 \u05de\u05d4\u05e6\u05d5\u05e8\u05da \u05dc\u05d0\u05d7\u05d3 \u05d0\u05ea \u05d4\u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4 \u05d4\u05de\u05d5\u05e7\u05d3\u05de\u05ea \u05e2\u05dd \u05d4\u05d4\u05d5\u05d5\u05d4.",
        "rationale": "\u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd \u05de\u05d0\u05d5\u05de\u05e6\u05d9\u05dd \u05e6\u05e8\u05d9\u05db\u05d9\u05dd \u05dc\u05d2\u05e9\u05e8 \u05e2\u05dc \u05d4\u05e4\u05e2\u05e8 \u05d1\u05d9\u05df \u05d4\u05de\u05d5\u05e8\u05e9\u05ea \u05d4\u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea \u05dc\u05d1\u05d9\u05df \u05d4\u05e1\u05d1\u05d9\u05d1\u05d4 \u05d4\u05de\u05d2\u05d3\u05dc\u05ea \u05db\u05d3\u05d9 \u05dc\u05d4\u05d2\u05d9\u05e2 \u05dc\u05d6\u05d4\u05d5\u05ea \u05d0\u05d7\u05d5\u05d3\u05d4 (Dulcan p.622, 893).",
        "requiredAttributes": [
          "\u05e6\u05d9\u05d5\u05df \u05d4\u05e6\u05d5\u05e8\u05da \u05d1\u05d0\u05d9\u05e0\u05d8\u05d2\u05e8\u05e6\u05d9\u05d4 \u05d1\u05d9\u05df \u05d6\u05d4\u05d5\u05ea \u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea/\u05d2\u05e0\u05d8\u05d9\u05ea \u05dc\u05d6\u05d4\u05d5\u05ea \u05de\u05d0\u05de\u05e6\u05ea.",
          "\u05d4\u05ea\u05d9\u05d9\u05d7\u05e1\u05d5\u05ea \u05dc\u05d7\u05d9\u05e4\u05d5\u05e9 \u05e9\u05d5\u05e8\u05e9\u05d9\u05dd \u05db\u05e9\u05dc\u05d1 \u05e0\u05d5\u05e8\u05de\u05d8\u05d9\u05d1\u05d9.",
          "\u05e6\u05d9\u05d5\u05df \u05d4\u05e7\u05e9\u05e8 \u05dc\u05de\u05e9\u05d9\u05de\u05d4 \u05d4\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9\u05ea \u05e9\u05dc \u05d2\u05d9\u05dc \u05d4\u05d4\u05ea\u05d1\u05d2\u05e8\u05d5\u05ea."
        ],
        "errors": {
          "misconceptions": [
            "\u05d4\u05e0\u05d7\u05d4 \u05e9\u05d7\u05d9\u05e4\u05d5\u05e9 \u05d0\u05d7\u05e8 \u05d4\u05d5\u05e8\u05d9\u05dd \u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05d9\u05dd \u05de\u05e2\u05d9\u05d3 \u05e2\u05dc \u05d7\u05d5\u05e1\u05e8 \u05e9\u05d1\u05d9\u05e2\u05d5\u05ea \u05e8\u05e6\u05d5\u05df \u05de\u05d4\u05de\u05e9\u05e4\u05d7\u05d4 \u05d4\u05de\u05d0\u05de\u05e6\u05ea.",
            "\u05d4\u05e0\u05d7\u05d4 \u05e9\u05d1\u05e2\u05d9\u05d9\u05ea \u05d4\u05d6\u05d4\u05d5\u05ea \u05e7\u05e9\u05d5\u05e8\u05d4 \u05e8\u05e7 \u05dc\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea."
          ],
          "bluffs": [
            "\u05d0\u05de\u05d9\u05e8\u05d5\u05ea \u05db\u05dc\u05dc\u05d9\u05d5\u05ea \u05e2\u05dc \u05e7\u05e9\u05d9\u05d9 \u05d2\u05d9\u05dc \u05d4\u05d4\u05ea\u05d1\u05d2\u05e8\u05d5\u05ea \u05dc\u05dc\u05d0 \u05d4\u05ea\u05d9\u05d9\u05d7\u05e1\u05d5\u05ea \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05ea \u05dc\u05d0\u05d9\u05de\u05d5\u05e5."
          ]
        }
      },
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05de\u05d5\u05e9\u05d2 '\u05d6\u05d4\u05d5\u05ea \u05db\u05e4\u05d5\u05dc\u05d4' \u05d5\u05e2\u05dc \u05d4\u05de\u05e7\u05d5\u05e8\u05d5\u05ea \u05d4\u05e9\u05d5\u05e0\u05d9\u05dd \u05e9\u05dc \u05d4\u05de\u05d9\u05d3\u05e2 \u05d4\u05d2\u05e0\u05d8\u05d9 \u05de\u05d5\u05dc \u05d4\u05e1\u05d1\u05d9\u05d1\u05ea\u05d9."
    },
    {
      "type": "multiple_choice",
      "question": "\u05de\u05d4\u05d9 \u05d4\u05e2\u05de\u05d3\u05d4 \u05d4\u05d0\u05ea\u05d9\u05ea \u05d5\u05d4\u05de\u05e7\u05e6\u05d5\u05e2\u05d9\u05ea \u05d4\u05de\u05e7\u05d5\u05d1\u05dc\u05ea \u05dc\u05d2\u05d1\u05d9 \u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8 \u05d4\u05de\u05e9\u05de\u05e9 \u05db-Treating Clinician (\u05de\u05d8\u05e4\u05dc \u05e7\u05dc\u05d9\u05e0\u05d9) \u05d4\u05de\u05d1\u05e7\u05e9 \u05dc\u05e1\u05e4\u05e7 \u05d7\u05d5\u05d5\u05ea \u05d3\u05e2\u05ea \u05de\u05d5\u05de\u05d7\u05d4 \u05dc\u05d1\u05d9\u05ea \u05d4\u05de\u05e9\u05e4\u05d8 (Forensic Expert Witness) \u05d1\u05d0\u05d5\u05ea\u05d5 \u05de\u05e7\u05e8\u05d4?",
      "answerOptions": [
        {
          "text": "\u05de\u05d3\u05d5\u05d1\u05e8 \u05d1\u05e0\u05d9\u05d2\u05d5\u05d3 \u05e2\u05e0\u05d9\u05d9\u05e0\u05d9\u05dd \u05d5-Dual Agency \u05d4\u05d0\u05e1\u05d5\u05e8\u05d9\u05dd \u05dc\u05e4\u05d9 \u05d4\u05db\u05dc\u05dc\u05d9\u05dd \u05d4\u05d0\u05ea\u05d9\u05d9\u05dd.",
          "isCorrect": true,
          "rationale": "\u05e7\u05d9\u05d9\u05dd \u05d4\u05d1\u05d3\u05dc \u05de\u05d4\u05d5\u05ea\u05d9 \u05d1\u05d7\u05d5\u05d1\u05d5\u05ea \u05d4\u05de\u05e7\u05e6\u05d5\u05e2\u05d9\u05d5\u05ea: \u05d4\u05de\u05d8\u05e4\u05dc \u05de\u05d7\u05d5\u05d9\u05d1 \u05dc\u05d1\u05e8\u05d9\u05ea \u05d8\u05d9\u05e4\u05d5\u05dc\u05d9\u05ea \u05d5\u05dc\u05e1\u05d5\u05d3\u05d9\u05d5\u05ea, \u05d1\u05e2\u05d5\u05d3 \u05d4\u05de\u05d5\u05de\u05d7\u05d4 \u05d4\u05e4\u05d5\u05e8\u05e0\u05d6\u05d9 \u05de\u05d7\u05d5\u05d9\u05d1 \u05dc\u05d0\u05d5\u05d1\u05d9\u05d9\u05e7\u05d8\u05d9\u05d1\u05d9\u05d5\u05ea \u05db\u05dc\u05e4\u05d9 \u05d1\u05d9\u05ea \u05d4\u05de\u05e9\u05e4\u05d8 (Dulcan p.644, 648)."
        },
        {
          "text": "\u05d6\u05d4\u05d5 \u05de\u05e6\u05d1 \u05e8\u05e6\u05d5\u05d9 \u05db\u05d9\u05d5\u05d5\u05df \u05e9\u05dc\u05de\u05d8\u05e4\u05dc \u05d9\u05e9 \u05d0\u05ea \u05d4\u05d4\u05d9\u05db\u05e8\u05d5\u05ea \u05d4\u05de\u05e2\u05de\u05d9\u05e7\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05e2\u05dd \u05d4\u05de\u05d8\u05d5\u05e4\u05dc.",
          "isCorrect": false,
          "rationale": "\u05d4\u05d4\u05d9\u05db\u05e8\u05d5\u05ea \u05d4\u05de\u05e2\u05de\u05d9\u05e7\u05d4 \u05e4\u05d5\u05d2\u05e2\u05ea \u05d1\u05d0\u05d5\u05d1\u05d9\u05d9\u05e7\u05d8\u05d9\u05d1\u05d9\u05d5\u05ea \u05d4\u05e0\u05d3\u05e8\u05e9\u05ea \u05de\u05de\u05d5\u05de\u05d7\u05d4 \u05e4\u05d5\u05e8\u05e0\u05d6\u05d9, \u05d5\u05de\u05ea\u05df \u05e2\u05d3\u05d5\u05ea \u05e2\u05dc\u05d5\u05dc \u05dc\u05e4\u05d2\u05d5\u05e2 \u05d1\u05d1\u05e8\u05d9\u05ea \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc\u05d9\u05ea \u05e2\u05dd \u05d4\u05d9\u05dc\u05d3 (Dulcan p.644)."
        },
        {
          "text": "\u05e0\u05d9\u05ea\u05df \u05dc\u05d1\u05e6\u05e2 \u05d0\u05ea \u05e9\u05e0\u05d9 \u05d4\u05ea\u05e4\u05e7\u05d9\u05d3\u05d9\u05dd \u05db\u05dc \u05e2\u05d5\u05d3 \u05d4\u05d4\u05d5\u05e8\u05d9\u05dd \u05d7\u05ea\u05de\u05d5 \u05e2\u05dc \u05d5\u05d9\u05ea\u05d5\u05e8 \u05e1\u05d5\u05d3\u05d9\u05d5\u05ea (Waiver).",
          "isCorrect": false,
          "rationale": "\u05d5\u05d9\u05ea\u05d5\u05e8 \u05e1\u05d5\u05d3\u05d9\u05d5\u05ea \u05d0\u05d9\u05e0\u05d5 \u05e4\u05d5\u05ea\u05e8 \u05d0\u05ea \u05e0\u05d9\u05d2\u05d5\u05d3 \u05d4\u05d0\u05d9\u05e0\u05d8\u05e8\u05e1\u05d9\u05dd \u05d4\u05de\u05d1\u05e0\u05d9 \u05e9\u05d1\u05d9\u05df \u05ea\u05e4\u05e7\u05d9\u05d3 \u05d4\u05de\u05d8\u05e4\u05dc \u05dc\u05ea\u05e4\u05e7\u05d9\u05d3 \u05d4\u05de\u05e2\u05e8\u05d9\u05da \u05e2\u05d1\u05d5\u05e8 \u05d1\u05d9\u05ea \u05d4\u05de\u05e9\u05e4\u05d8 (Dulcan p.648)."
        },
        {
          "text": "\u05d6\u05d4 \u05de\u05d5\u05ea\u05e8 \u05e8\u05e7 \u05d1\u05de\u05e7\u05e8\u05d9\u05dd \u05e9\u05dc Child Abuse \u05d5-Neglect \u05d1\u05e9\u05dc \u05d7\u05d5\u05d1\u05ea \u05d4\u05d3\u05d9\u05d5\u05d5\u05d7.",
          "isCorrect": false,
          "rationale": "\u05d7\u05d5\u05d1\u05ea \u05d4\u05d3\u05d9\u05d5\u05d5\u05d7 \u05e7\u05d9\u05d9\u05de\u05ea, \u05d0\u05da \u05d4\u05d9\u05d0 \u05e0\u05e4\u05e8\u05d3\u05ea \u05de\u05d4\u05ea\u05e4\u05e7\u05d9\u05d3 \u05d4\u05e4\u05d5\u05e8\u05e0\u05d6\u05d9 \u05e9\u05dc \u05de\u05d5\u05de\u05d7\u05d4 \u05d4\u05de\u05d2\u05d9\u05e9 \u05d7\u05d5\u05d5\u05ea \u05d3\u05e2\u05ea \u05dc\u05d1\u05d9\u05ea \u05d4\u05de\u05e9\u05e4\u05d8 (Dulcan p.647, 648)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05de\u05ea\u05d7 \u05e9\u05d1\u05d9\u05df '\u05e0\u05d0\u05de\u05e0\u05d5\u05ea \u05dc\u05de\u05d8\u05d5\u05e4\u05dc' \u05dc\u05d1\u05d9\u05df '\u05d0\u05d5\u05d1\u05d9\u05d9\u05e7\u05d8\u05d9\u05d1\u05d9\u05d5\u05ea \u05db\u05dc\u05e4\u05d9 \u05d4\u05d7\u05d5\u05e7'."
    },
    {
      "type": "multiple_choice",
      "question": "\u05d1\u05d4\u05e2\u05e8\u05db\u05ea \u05d9\u05dc\u05d3 \u05e2\u05dd \u05d7\u05e9\u05d3 \u05dc-Disinhibited Social Engagement Disorder (DSED), \u05de\u05d4\u05d5 \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9 \u05d4\u05de\u05d1\u05d3\u05d9\u05dc \u05d4\u05e4\u05e8\u05e2\u05d4 \u05d6\u05d5 \u05de-ADHD?",
      "answerOptions": [
        {
          "text": "\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d4\u05d9\u05dc\u05d3 \u05d0\u05d9\u05e0\u05d4 \u05de\u05d5\u05d2\u05d1\u05dc\u05ea \u05dc\u05d0\u05d9\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05d5\u05ea \u05d0\u05dc\u05d0 \u05db\u05d5\u05dc\u05dc\u05ea \u05e4\u05e8\u05d9\u05e6\u05ea \u05d2\u05d1\u05d5\u05dc\u05d5\u05ea \u05d7\u05d1\u05e8\u05ea\u05d9\u05d9\u05dd (Socially disinhibited).",
          "isCorrect": true,
          "rationale": "\u05dc\u05e4\u05d9 \u05d4-DSM, \u05d1-DSED \u05d4\u05d1\u05e2\u05d9\u05d4 \u05d4\u05d9\u05d0 \u05d1\u05d7\u05d5\u05e1\u05e8 \u05e8\u05ea\u05d9\u05e2\u05d4 \u05de\u05d6\u05e8\u05d9\u05dd \u05d5\u05d7\u05e8\u05d9\u05d2\u05d4 \u05de\u05e0\u05d5\u05e8\u05de\u05d5\u05ea \u05d7\u05d1\u05e8\u05ea\u05d9\u05d5\u05ea, \u05d5\u05dc\u05d0 \u05e8\u05e7 \u05d7\u05d5\u05e1\u05e8 \u05e9\u05dc\u05d9\u05d8\u05d4 \u05d1\u05d3\u05d7\u05e3 \u05de\u05d5\u05d8\u05d5\u05e8\u05d9 (DSM p.298-299)."
        },
        {
          "text": "\u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05e9\u05dc \u05d4\u05d9\u05e4\u05e8-\u05d0\u05e7\u05d8\u05d9\u05d1\u05d9\u05d5\u05ea \u05d5\u05d0\u05d9-\u05e9\u05e7\u05d8 \u05de\u05d5\u05d8\u05d5\u05e8\u05d9 \u05d1\u05d5\u05dc\u05d8.",
          "isCorrect": false,
          "rationale": "\u05d4\u05d9\u05e4\u05e8-\u05d0\u05e7\u05d8\u05d9\u05d1\u05d9\u05d5\u05ea \u05d4\u05d9\u05d0 \u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05dc\u05d9\u05d1\u05d4 \u05e9\u05dc ADHD, \u05d0\u05da \u05d4\u05d9\u05d0 \u05e2\u05e9\u05d5\u05d9\u05d4 \u05dc\u05d4\u05d5\u05e4\u05d9\u05e2 \u05d2\u05dd \u05d1-DSED \u05d5\u05d0\u05d9\u05e0\u05d4 \u05d4\u05d2\u05d5\u05e8\u05dd \u05d4\u05de\u05d1\u05d3\u05dc (DSM p.299)."
        },
        {
          "text": "\u05ea\u05d2\u05d5\u05d1\u05d4 \u05d7\u05d9\u05d5\u05d1\u05d9\u05ea \u05de\u05d4\u05d9\u05e8\u05d4 \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Methylphenidate.",
          "isCorrect": false,
          "rationale": "\u05ea\u05d2\u05d5\u05d1\u05d4 \u05dc\u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05d0\u05d9\u05e0\u05d4 \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df \u05d0\u05d1\u05d7\u05e0\u05ea\u05d9 \u05de\u05d1\u05d3\u05dc \u05d1-DSM, \u05d5-DSED \u05dc\u05e8\u05d5\u05d1 \u05d0\u05d9\u05e0\u05d5 \u05de\u05d2\u05d9\u05d1 \u05d4\u05d9\u05d8\u05d1 \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d6\u05d4 \u05d1\u05dc\u05d1\u05d3 (Syllabus p.39)."
        },
        {
          "text": "\u05d4\u05d9\u05e2\u05d3\u05e8 \u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4 \u05e9\u05dc 'Pathogenic care' \u05d0\u05d5 \u05d4\u05d6\u05e0\u05d7\u05d4.",
          "isCorrect": false,
          "rationale": "\u05dc\u05d4\u05e4\u05da, \u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4 \u05e9\u05dc \u05d4\u05d6\u05e0\u05d7\u05d4 \u05d4\u05d9\u05d0 \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df \u05d7\u05d5\u05d1\u05d4 \u05dc-DSED, \u05d1\u05e2\u05d5\u05d3 \u05e9\u05d1-ADHD \u05d4\u05d9\u05d0 \u05d0\u05d9\u05e0\u05d4 \u05ea\u05e0\u05d0\u05d9 \u05d4\u05db\u05e8\u05d7\u05d9 (DSM p.299)."
        }
      ],
      "hint": "\u05d4\u05d4\u05d1\u05d3\u05dc \u05d8\u05de\u05d5\u05df \u05d1\u05d0\u05d5\u05e4\u05d9 \u05d4\u05d0\u05d9\u05e0\u05d8\u05e8\u05d0\u05e7\u05e6\u05d9\u05d4 \u05e2\u05dd \u05d0\u05e0\u05e9\u05d9\u05dd \u05d6\u05e8\u05d9\u05dd \u05d5\u05dc\u05d0 \u05e8\u05e7 \u05d1\u05de\u05d4\u05d9\u05e8\u05d5\u05ea \u05d4\u05ea\u05d2\u05d5\u05d1\u05d4."
    },
    {
      "type": "multiple_choice",
      "question": "\u05d9\u05dc\u05d3 \u05d1\u05df 6 \u05e9\u05d4\u05d5\u05e6\u05d0 \u05de\u05d1\u05d9\u05ea\u05d5 \u05d1\u05e9\u05dc \u05d4\u05d6\u05e0\u05d7\u05d4 \u05d7\u05de\u05d5\u05e8\u05d4 \u05d5\u05de\u05d5\u05e7\u05dd \u05d1-Foster Care (\u05d0\u05d5\u05de\u05e0\u05d4) \u05de\u05e6\u05d9\u05d2 \u05e7\u05e9\u05d9\u05d9\u05dd \u05d1\u05d5\u05d5\u05d9\u05e1\u05d5\u05ea \u05e8\u05d2\u05e9\u05d9 \u05d5\u05d7\u05e8\u05d3\u05d4 \u05e2\u05d6\u05d4 \u05d1\u05db\u05dc \u05e4\u05e2\u05dd \u05e9\u05e2\u05d5\u05dc\u05d4 \u05d4\u05d0\u05e4\u05e9\u05e8\u05d5\u05ea \u05dc\u05d1\u05d9\u05e7\u05d5\u05e8 \u05d0\u05e6\u05dc \u05d4\u05d5\u05e8\u05d9\u05d5 \u05d4\u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05d9\u05dd. \u05de\u05d4\u05d5 \u05d4\u05de\u05d5\u05e9\u05d2 \u05d4\u05de\u05ea\u05d0\u05e8 \u05d1\u05e6\u05d5\u05e8\u05d4 \u05d4\u05d8\u05d5\u05d1\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d0\u05ea \u05ea\u05d7\u05d5\u05e9\u05ea \u05d4\u05d0\u05d5\u05d1\u05d3\u05df \u05d4\u05de\u05ea\u05de\u05e9\u05db\u05ea \u05d1\u05de\u05e6\u05d1 \u05d6\u05d4, \u05e9\u05d1\u05d5 \u05d4\u05e7\u05e9\u05e8 \u05e7\u05d9\u05d9\u05dd \u05d0\u05da \u05d0\u05d9\u05e0\u05d5 \u05d9\u05e6\u05d9\u05d1?",
      "answerOptions": [
        {
          "text": "Ambiguous Loss (\u05d0\u05d1\u05dc \u05e2\u05de\u05d5\u05dd).",
          "isCorrect": true,
          "rationale": "\u05d4\u05de\u05d5\u05e9\u05d2 \u05de\u05ea\u05d0\u05e8 \u05de\u05e6\u05d1 \u05e9\u05d1\u05d5 \u05d4\u05d4\u05d5\u05e8\u05d4 \u05e0\u05d5\u05db\u05d7 \u05e4\u05d9\u05d6\u05d9\u05ea \u05d0\u05da \u05e0\u05e2\u05d3\u05e8 \u05e4\u05e1\u05d9\u05db\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea \u05d0\u05d5 \u05ea\u05e4\u05e7\u05d5\u05d3\u05d9\u05ea, \u05de\u05d4 \u05e9\u05de\u05e7\u05e9\u05d4 \u05e2\u05dc \u05ea\u05d4\u05dc\u05d9\u05da \u05d4\u05d0\u05d1\u05dc \u05d5\u05d4\u05d4\u05e1\u05ea\u05d2\u05dc\u05d5\u05ea (Dulcan p.626, 628)."
        },
        {
          "text": "Prolonged Grief Disorder (\u05d4\u05e4\u05e8\u05e2\u05ea \u05d0\u05d1\u05dc \u05de\u05de\u05d5\u05e9\u05da).",
          "isCorrect": false,
          "rationale": "\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d6\u05d5 \u05e8\u05dc\u05d5\u05d5\u05e0\u05d8\u05d9\u05ea \u05e8\u05e7 \u05dc\u05d0\u05d7\u05e8 \u05de\u05d5\u05d5\u05ea \u05de\u05de\u05e9\u05d9 \u05e9\u05dc \u05d3\u05de\u05d5\u05ea \u05e7\u05e8\u05d5\u05d1\u05d4 (\u05dc\u05e4\u05d7\u05d5\u05ea 6 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd) \u05d5\u05dc\u05d0 \u05dc\u05d0\u05d5\u05d1\u05d3\u05df \u05d4\u05e7\u05e9\u05d5\u05e8 \u05d1\u05de\u05e2\u05d1\u05e8 \u05dc\u05d0\u05d5\u05de\u05e0\u05d4 (DSM p.322)."
        },
        {
          "text": "Disorganized Attachment (\u05d4\u05ea\u05e7\u05e9\u05e8\u05d5\u05ea \u05dc\u05d0-\u05de\u05d0\u05d5\u05e8\u05d2\u05e0\u05ea).",
          "isCorrect": false,
          "rationale": "\u05d6\u05d4\u05d5 \u05e1\u05d2\u05e0\u05d5\u05df \u05d4\u05ea\u05e7\u05e9\u05e8\u05d5\u05ea \u05d5\u05dc\u05d0 \u05e1\u05d5\u05d2 \u05e9\u05dc \u05d0\u05d1\u05dc, \u05dc\u05de\u05e8\u05d5\u05ea \u05e9\u05d4\u05d5\u05d0 \u05e0\u05e4\u05d5\u05e5 \u05de\u05d0\u05d5\u05d3 \u05d1\u05d9\u05dc\u05d3\u05d9 \u05d0\u05d5\u05de\u05e0\u05d4 \u05e9\u05d7\u05d5\u05d5 \u05d8\u05e8\u05d0\u05d5\u05de\u05d4 (Dulcan p.525)."
        },
        {
          "text": "Developmental Regression (\u05e0\u05e1\u05d9\u05d2\u05d4 \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9\u05ea).",
          "isCorrect": false,
          "rationale": "\u05d6\u05d4\u05d5 \u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05dd \u05e9\u05dc \u05de\u05e6\u05d5\u05e7\u05d4 (\u05db\u05de\u05d5 \u05d4\u05e8\u05d8\u05d1\u05d4 \u05d0\u05d5 \u05d0\u05d9\u05d1\u05d5\u05d3 \u05d9\u05db\u05d5\u05dc\u05d5\u05ea) \u05d5\u05dc\u05d0 \u05d4\u05de\u05d5\u05e9\u05d2 \u05d4\u05ea\u05d9\u05d0\u05d5\u05e8\u05d8\u05d9 \u05d4\u05de\u05ea\u05d0\u05e8 \u05d0\u05ea \u05d0\u05d5\u05e4\u05d9 \u05d4\u05d0\u05d5\u05d1\u05d3\u05df \u05e2\u05e6\u05de\u05d5 (Dulcan p.628)."
