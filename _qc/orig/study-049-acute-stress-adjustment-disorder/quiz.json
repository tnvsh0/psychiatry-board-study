    {
      "type": "multiple_select",
      "question": "\u05d1\u05e2\u05ea \u05d4\u05e2\u05e8\u05db\u05ea \u05d9\u05dc\u05d3 \u05e6\u05e2\u05d9\u05e8 \u05e2\u05dd \u05d7\u05e9\u05d3 \u05dc-Posttraumatic Stress Disorder, \u05d0\u05d9\u05dc\u05d5 \u05de\u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9\u05dd \u05d4\u05d1\u05d0\u05d9\u05dd \u05e0\u05d7\u05e9\u05d1\u05d9\u05dd \u05dc\u05d1\u05d9\u05d8\u05d5\u05d9\u05d9\u05dd \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9\u05d9\u05dd \u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05d9\u05d9\u05dd \u05de\u05ea\u05d7\u05ea \u05dc\u05d2\u05d9\u05dc 6 \u05e9\u05e0\u05d9\u05dd (Children 6 years and younger)?",
      "answerOptions": [
        {
