      ],
      "rationale": "\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df E \u05d1-ASD \u05d5\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df B7 \u05de\u05e6\u05d9\u05d9\u05e0\u05d9\u05dd \u05db\u05d9 \u05d4\u05ea\u05e1\u05de\u05d9\u05df \u05dc\u05d0 \u05d9\u05d9\u05d5\u05d7\u05e1 \u05dc\u05d4\u05e9\u05e4\u05e2\u05d5\u05ea \u05e4\u05d9\u05d6\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05d5\u05ea \u05e9\u05dc \u05d7\u05d5\u05de\u05e8\u05d9\u05dd \u05d0\u05d5 \u05dc\u05de\u05e6\u05d1 \u05e8\u05e4\u05d5\u05d0\u05d9 \u05db\u05de\u05d5 \u05e4\u05d2\u05d9\u05e2\u05d4 \u05de\u05d5\u05d7\u05d9\u05ea \u05d8\u05e8\u05d0\u05d5\u05de\u05d8\u05d9\u05ea (DSM p.315, DSM p.317).",
      "hint": "\u05d6\u05d4\u05d5 \u05de\u05e6\u05d1 \u05e8\u05e4\u05d5\u05d0\u05d9 \u05d0\u05d5\u05e8\u05d2\u05e0\u05d9 \u05e9\u05e2\u05dc\u05d5\u05dc \u05dc\u05d2\u05e8\u05d5\u05dd \u05dc\u05d0\u05d5\u05d1\u05d3\u05df \u05d6\u05d9\u05db\u05e8\u05d5\u05df \u05dc\u05d0\u05d7\u05e8 \u05d0\u05d9\u05e8\u05d5\u05e2 \u05e4\u05d9\u05d6\u05d9 \u05e7\u05e9\u05d4."
    },
    {
      "type": "multiple_choice",
      "question": "\u05dc\u05e4\u05d9 \u05d4-StahlNeuro, \u05de\u05d4\u05d5 \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05e0\u05d5\u05d9\u05e8\u05d5\u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d4\u05de\u05d5\u05e6\u05e2 \u05d1\u05d1\u05e1\u05d9\u05e1 \u05d4-Hyperarousal \u05d1-PTSD?",
      "answerOptions": [
        {
          "text": "\u05d7\u05d5\u05e1\u05e8 \u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05e9\u05dc \u05d4-Dopamine \u05d1-Ventral Striatum.",
          "isCorrect": false,
          "rationale": "\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d6\u05d4 \u05e7\u05e9\u05d5\u05e8 \u05d9\u05d5\u05ea\u05e8 \u05dc\u05d0\u05e0\u05d4\u05d3\u05d5\u05e0\u05d9\u05d4 \u05d5\u05d3\u05d9\u05db\u05d0\u05d5\u05df (Dulcan p.273)."
        },
        {
          "text": "\u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05d9\u05ea\u05e8 \u05e9\u05dc \u05d4\u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05e0\u05d5\u05e8\u05d0\u05d3\u05e8\u05e0\u05e8\u05d2\u05d9\u05ea \u05d5\u05db\u05d9\u05e9\u05dc\u05d5\u05df \u05e9\u05dc \u05d4-Prefrontal Cortex \u05d1\u05e2\u05d9\u05db\u05d5\u05d1 \u05d4-Amygdala.",
          "isCorrect": true,
          "rationale": "\u05d4\u05e2\u05d3\u05e8 \u05e2\u05d9\u05db\u05d5\u05d1 (top-down inhibition) \u05de\u05d4-PFC \u05e2\u05dc \u05d4\u05d0\u05de\u05d9\u05d2\u05d3\u05dc\u05d4 \u05d5\u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05d9\u05ea\u05e8 \u05e9\u05dc \u05e0\u05d5\u05e8\u05d0\u05e4\u05d9\u05e0\u05e4\u05e8\u05d9\u05df \u05de\u05e1\u05d1\u05d9\u05e8\u05d9\u05dd \u05d0\u05ea \u05ea\u05d2\u05d5\u05d1\u05ea \u05d4-fear conditioning \u05d5\u05d4\u05e2\u05d5\u05e8\u05e8\u05d5\u05ea (StahlNeuro p.147, Dulcan p.324)."
        },
        {
          "text": "\u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05d9\u05ea\u05e8 \u05e9\u05dc \u05de\u05e2\u05e8\u05db\u05ea \u05d4-GABA-A \u05d1\u05ea\u05dc\u05de\u05d5\u05e1.",
          "isCorrect": false,
          "rationale": "\u05e4\u05e2\u05d9\u05dc\u05d5\u05ea GABA-A \u05d3\u05d5\u05d5\u05e7\u05d0 \u05de\u05e4\u05d7\u05d9\u05ea\u05d4 \u05e2\u05d5\u05e8\u05e8\u05d5\u05ea \u05d5\u05d7\u05e8\u05d3\u05d4 (StahlNeuro p.147)."
        },
        {
          "text": "\u05d9\u05e8\u05d9\u05d3\u05d4 \u05d1\u05e8\u05de\u05d5\u05ea \u05d4-Cortisol \u05d1\u05d3\u05dd \u05d1\u05d6\u05de\u05df \u05dc\u05d7\u05e5 \u05d0\u05e7\u05d5\u05d8\u05d9.",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05de\u05de\u05e6\u05d0\u05d9\u05dd \u05de\u05d5\u05e8\u05db\u05d1\u05d9\u05dd \u05d1-PTSD \u05db\u05e8\u05d5\u05e0\u05d9, \u05d4\u05de\u05d5\u05d3\u05dc \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05e9\u05dc Hyperarousal \u05de\u05ea\u05de\u05e7\u05d3 \u05d1\u05de\u05e1\u05dc\u05d5\u05dc\u05d9\u05dd \u05d4\u05de\u05d5\u05d7\u05d9\u05d9\u05dd \u05d5\u05d4\u05d0\u05d3\u05e8\u05e0\u05e8\u05d2\u05d9\u05d9\u05dd (StahlNeuro p.147)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d1\u05d5 \u05e2\u05dc \u05d7\u05d5\u05e1\u05e8 \u05d4\u05d0\u05d9\u05d6\u05d5\u05df \u05e9\u05d1\u05d9\u05df \u05d4-Amydala \u05dc\u05d1\u05d9\u05df \u05d4\u05de\u05e2\u05e8\u05db\u05d5\u05ea \u05d4\u05de\u05e2\u05db\u05d1\u05d5\u05ea \u05e9\u05dc\u05d4.",
