    {
      "type": "multiple_choice",
      "question": "\u05d9\u05dc\u05d3\u05d4 \u05d1\u05ea 8 \u05de\u05d5\u05d1\u05d0\u05ea \u05dc\u05d4\u05e2\u05e8\u05db\u05d4 \u05e2\u05e7\u05d1 \u05e7\u05e9\u05d9\u05d9 \u05e8\u05d9\u05db\u05d5\u05d6 \u05d1\u05d1\u05d9\u05ea \u05d4\u05e1\u05e4\u05e8, \u05d0\u05d9-\u05e9\u05e7\u05d8 \u05de\u05d5\u05d8\u05d5\u05e8\u05d9 \u05d5\u05e0\u05d8\u05d9\u05d9\u05d4 \u05dc\u05d4\u05ea\u05e4\u05e8\u05e6\u05d5\u05d9\u05d5\u05ea \u05db\u05e2\u05e1. \u05d4\u05d5\u05e8\u05d9\u05d4 \u05de\u05e6\u05d9\u05d9\u05e0\u05d9\u05dd \u05db\u05d9 \u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d4\u05d7\u05dc\u05d5 \u05db\u05d7\u05d5\u05d3\u05e9\u05d9\u05d9\u05dd \u05dc\u05d0\u05d7\u05e8 \u05e9\u05e2\u05d1\u05e8\u05d5 \u05dc\u05d2\u05d5\u05e8 \u05d1\u05de\u05e7\u05dc\u05d8 \u05e2\u05e7\u05d1 \u05d4\u05e4\u05d2\u05d6\u05d5\u05ea. \u05d1\u05d1\u05d3\u05d9\u05e7\u05d4 \u05d2\u05d5\u05e4\u05e0\u05d9\u05ea \u05e0\u05e6\u05e4\u05d4 tremor \u05e7\u05dc \u05d5\u05d3\u05d5\u05e4\u05e7 \u05e9\u05dc 110 \u05e4\u05e2\u05d9\u05de\u05d5\u05ea \u05dc\u05d3\u05e7\u05d4 \u05d1\u05de\u05e0\u05d5\u05d7\u05d4. \u05de\u05d4\u05d5 \u05d4\u05e6\u05e2\u05d3 \u05d4\u05e8\u05d0\u05e9\u05d5\u05df \u05d5\u05d4\u05d7\u05e9\u05d5\u05d1 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d1-Differential Diagnosis?",
      "answerOptions": [
        {
          "text": "\u05d4\u05ea\u05d7\u05dc\u05ea \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Methylphenidate \u05d1\u05d7\u05e9\u05d3 \u05dc-ADHD.",
          "isCorrect": false,
          "rationale": "\u05de\u05ea\u05df \u05e1\u05d8\u05d9\u05de\u05d5\u05dc\u05e0\u05d8\u05d9\u05dd \u05dc\u05e4\u05e0\u05d9 \u05e9\u05dc\u05d9\u05dc\u05ea \u05e1\u05d9\u05d1\u05d5\u05ea \u05e8\u05e4\u05d5\u05d0\u05d9\u05d5\u05ea \u05e2\u05e9\u05d5\u05d9 \u05dc\u05d4\u05d7\u05de\u05d9\u05e8 \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e9\u05dc \u05d7\u05e8\u05d3\u05d4 \u05d0\u05d5 hyperthyroidism (Dulcan p.326, StahlKids p.301)."
        },
        {
          "text": "\u05d1\u05d9\u05e6\u05d5\u05e2 \u05d1\u05d3\u05d9\u05e7\u05d5\u05ea \u05de\u05e2\u05d1\u05d3\u05d4 \u05d4\u05db\u05d5\u05dc\u05dc\u05d5\u05ea TSH \u05d5\u05e8\u05de\u05d5\u05ea Glucose.",
          "isCorrect": true,
          "rationale": "\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e9\u05dc \u05d8\u05db\u05d9\u05e7\u05e8\u05d3\u05d9\u05d4, \u05e8\u05e2\u05d3 \u05d5\u05d0\u05d9-\u05e9\u05e7\u05d8 \u05de\u05d7\u05d9\u05d9\u05d1\u05d9\u05dd \u05e9\u05dc\u05d9\u05dc\u05ea medical mimics \u05db\u05de\u05d5 Hyperthyroidism \u05d0\u05d5 hypoglycemia \u05dc\u05e4\u05e0\u05d9 \u05e7\u05d1\u05d9\u05e2\u05ea \u05d0\u05d1\u05d7\u05e0\u05d4 \u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9\u05ea (Dulcan p.325, Dulcan p.326)."
        },
        {
          "text": "\u05d0\u05d1\u05d7\u05d5\u05df PTSD \u05e2\u05dc \u05e1\u05de\u05da \u05d4\u05d7\u05e9\u05d9\u05e4\u05d4 \u05dc\u05d0\u05d9\u05e8\u05d5\u05e2 \u05d4\u05d8\u05e8\u05d0\u05d5\u05de\u05d8\u05d9 \u05d5\u05d4-arousal symptoms.",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05e7\u05d9\u05d5\u05dd \u05d4\u05d8\u05e8\u05d0\u05d5\u05de\u05d4, \u05d4\u05e1\u05d9\u05de\u05e0\u05d9\u05dd \u05d4\u05e4\u05d9\u05d6\u05d9\u05e7\u05dc\u05d9\u05d9\u05dd (\u05d8\u05db\u05d9\u05e7\u05e8\u05d3\u05d9\u05d4 \u05d5\u05e8\u05e2\u05d3) \u05d3\u05d5\u05e8\u05e9\u05d9\u05dd \u05d1\u05d9\u05e8\u05d5\u05e8 \u05e8\u05e4\u05d5\u05d0\u05d9 \u05dc\u05e9\u05dc\u05d9\u05dc\u05ea \u05d0\u05d1\u05d7\u05e0\u05d4 \u05d0\u05d5\u05e8\u05d2\u05e0\u05d9\u05ea (Dulcan p.325, DSM p.317)."
        },
        {
          "text": "\u05de\u05ea\u05df Lorazepam \u05dc\u05d4\u05e7\u05dc\u05d4 \u05de\u05d9\u05d9\u05d3\u05d9\u05ea \u05e2\u05dc \u05ea\u05e1\u05de\u05d9\u05e0\u05d9 \u05d4\u05d7\u05e8\u05d3\u05d4.",
          "isCorrect": false,
          "rationale": "\u05d1\u05e0\u05d6\u05d5\u05d3\u05d9\u05d0\u05d6\u05e4\u05d9\u05e0\u05d9\u05dd \u05d0\u05d9\u05e0\u05dd \u05de\u05d5\u05de\u05dc\u05e6\u05d9\u05dd \u05db\u05e7\u05d5 \u05e8\u05d0\u05e9\u05d5\u05df \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d5\u05d9\u05e9 \u05dc\u05d4\u05d9\u05de\u05e0\u05e2 \u05de\u05d4\u05dd \u05dc\u05e4\u05e0\u05d9 \u05e1\u05d9\u05d5\u05dd \u05d4\u05d1\u05d9\u05e8\u05d5\u05e8 \u05d4\u05d0\u05d1\u05d7\u05e0\u05ea\u05d9 (Dulcan p.341)."
        }
      ],
      "hint": "\u05e9\u05d9\u05de\u05d5 \u05dc\u05d1 \u05dc\u05de\u05de\u05e6\u05d0\u05d9\u05dd \u05d4\u05d0\u05d5\u05d1\u05d9\u05d9\u05e7\u05d8\u05d9\u05d1\u05d9\u05d9\u05dd \u05d1\u05d1\u05d3\u05d9\u05e7\u05d4 \u05d4\u05d2\u05d5\u05e4\u05e0\u05d9\u05ea \u05de\u05e2\u05d1\u05e8 \u05dc\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05d4\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea\u05d9\u05d9\u05dd.",
      "imageUrls": []
    },
    {
      "type": "short_answer",
      "question": "\u05ea\u05d0\u05e8 \u05d0\u05ea \u05de\u05d5\u05d3\u05dc \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05e4\u05e1\u05d9\u05db\u05d5\u05ea\u05e8\u05e4\u05d9 TF-CBT \u05d1\u05d0\u05de\u05e6\u05e2\u05d5\u05ea \u05e8\u05d0\u05e9\u05d9 \u05d4\u05ea\u05d9\u05d1\u05d5\u05ea PRACTICE \u05d5\u05e6\u05d9\u05d9\u05df \u05de\u05d4\u05d5 \u05d4\u05d9\u05ea\u05e8\u05d5\u05df \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05e9\u05dc\u05d5 \u05e2\u05dc \u05e4\u05e0\u05d9 \u05d8\u05d9\u05e4\u05d5\u05dc \u05ea\u05e8\u05d5\u05e4\u05ea\u05d9 \u05d1-PTSD \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd.",
      "grading": {
        "modelAnswer": "\u05de\u05d5\u05d3\u05dc \u05d4-PRACTICE \u05db\u05d5\u05dc\u05dc: Psychoeducation/Parenting, Relaxation, Affective modulation, Cognitive processing, Trauma narration, In vivo mastery, Conjoint sessions, \u05d5-Enhancing safety. \u05d4\u05d9\u05ea\u05e8\u05d5\u05df \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05d4\u05d5\u05d0 \u05e9\u05dc-TF-CBT \u05d9\u05e9 \u05d1\u05e1\u05d9\u05e1 \u05e8\u05d0\u05d9\u05d5\u05ea (evidence base) \u05d7\u05d6\u05e7 \u05d1\u05d4\u05e8\u05d1\u05d4 \u05de\u05d6\u05d4 \u05e9\u05dc \u05d8\u05d9\u05e4\u05d5\u05dc \u05ea\u05e8\u05d5\u05e4\u05ea\u05d9 \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd, \u05d5\u05dc\u05db\u05df \u05d4\u05d5\u05d0 \u05e0\u05d7\u05e9\u05d1 \u05dc\u05e7\u05d5 \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05e8\u05d0\u05e9\u05d5\u05df (first-line) (Dulcan p.357).",
        "rationale": "\u05d4-TF-CBT \u05de\u05d1\u05d5\u05e1\u05e1 \u05e2\u05dc \u05e1\u05d3\u05e8\u05d4 \u05e9\u05dc \u05e8\u05db\u05d9\u05d1\u05d9\u05dd \u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9\u05d9\u05dd \u05d5\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea\u05d9\u05d9\u05dd \u05de\u05d5\u05d1\u05e0\u05d9\u05dd \u05e9\u05d4\u05d5\u05db\u05d7\u05d5 \u05db\u05d9\u05e2\u05d9\u05dc\u05d9\u05dd \u05d9\u05d5\u05ea\u05e8 \u05de\u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05d1\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05d8\u05e8\u05d0\u05d5\u05de\u05d4 \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd (Dulcan p.357).",
        "requiredAttributes": [
          "\u05d4\u05ea\u05d9\u05d9\u05d7\u05e1\u05d5\u05ea \u05dc\u05e8\u05d0\u05e9\u05d9 \u05d4\u05ea\u05d9\u05d1\u05d5\u05ea PRACTICE (\u05dc\u05e4\u05d7\u05d5\u05ea 3-4 \u05e8\u05db\u05d9\u05d1\u05d9\u05dd).",
          "\u05e6\u05d9\u05d5\u05df \u05d4\u05e2\u05d5\u05d1\u05d3\u05d4 \u05e9-TF-CBT \u05d4\u05d5\u05d0 \u05d4-first-line treatment.",
          "\u05e6\u05d9\u05d5\u05df \u05d4\u05e2\u05d5\u05d1\u05d3\u05d4 \u05e9\u05d1\u05e1\u05d9\u05e1 \u05d4\u05e8\u05d0\u05d9\u05d5\u05ea \u05dc\u05e4\u05e1\u05d9\u05db\u05d5\u05ea\u05e8\u05e4\u05d9\u05d4 \u05d7\u05d6\u05e7 \u05d9\u05d5\u05ea\u05e8 \u05de\u05d6\u05d4 \u05e9\u05dc \u05d8\u05d9\u05e4\u05d5\u05dc \u05ea\u05e8\u05d5\u05e4\u05ea\u05d9 \u05d1-PTSD \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd."
