{
  "title": "Trauma Quiz",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\u05de\u05ea\u05d1\u05d2\u05e8 \u05d1\u05df 16 \u05e4\u05d5\u05e0\u05d4 \u05dc\u05d4\u05e2\u05e8\u05db\u05d4 \u05d3\u05d7\u05d5\u05e4\u05d4 \u05d1-ED \u05db-10 \u05d9\u05de\u05d9\u05dd \u05dc\u05d0\u05d7\u05e8 \u05e9\u05d4\u05d9\u05d4 \u05e2\u05d3 \u05dc\u05d0\u05d9\u05e8\u05d5\u05e2 \u05d9\u05e8\u05d9 \u05d1\u05d1\u05d9\u05ea \u05e1\u05e4\u05e8\u05d5. \u05d4\u05d5\u05d0 \u05de\u05ea\u05d0\u05e8 intrusive memories \u05d4\u05de\u05dc\u05d5\u05d5\u05d9\u05dd \u05d1-hypervigilance, \u05e7\u05e9\u05d9\u05d9 \u05e9\u05d9\u05e0\u05d4 \u05d5\u05d4\u05d9\u05de\u05e0\u05e2\u05d5\u05ea \u05de\u05de\u05e2\u05d1\u05e8 \u05dc\u05d9\u05d3 \u05d6\u05d9\u05e8\u05ea \u05d4\u05d0\u05d9\u05e8\u05d5\u05e2. \u05d1\u05e0\u05d5\u05e1\u05e3, \u05d4\u05d5\u05d0 \u05de\u05d3\u05d5\u05d5\u05d7 \u05e2\u05dc \u05ea\u05d7\u05d5\u05e9\u05ea derealization \u05d5\u05e2\u05dc \u05db\u05da \u05e9\u05d4\u05d5\u05d0 \u05de\u05e8\u05d2\u05d9\u05e9 \"\u05d1\u05ea\u05d5\u05da \u05e2\u05e8\u05e4\u05dc\". \u05de\u05d4\u05d9 \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05e1\u05d1\u05d9\u05e8\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d1\u05e0\u05e7\u05d5\u05d3\u05ea \u05d6\u05de\u05df \u05d6\u05d5?",
      "answerOptions": [
        {
          "text": "Posttraumatic Stress Disorder (PTSD)",
          "isCorrect": false,
          "rationale": "\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d6\u05d5 \u05d3\u05d5\u05e8\u05e9\u05ea \u05de\u05e9\u05da \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e9\u05dc \u05de\u05e2\u05dc \u05d7\u05d5\u05d3\u05e9 \u05d0\u05d7\u05d3, \u05d1\u05e2\u05d5\u05d3 \u05e9\u05d1\u05de\u05e7\u05e8\u05d4 \u05d6\u05d4 \u05e2\u05d1\u05e8\u05d5 10 \u05d9\u05de\u05d9\u05dd \u05d1\u05dc\u05d1\u05d3 (DSM p.301, Synopsis ch.10)."
        },
        {
          "text": "Acute Stress Disorder (ASD)",
          "isCorrect": true,
          "rationale": "\u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05de\u05ea\u05d0\u05d9\u05de\u05d4 \u05dc\u05d7\u05e9\u05d9\u05e4\u05d4 \u05dc\u05d0\u05d9\u05e8\u05d5\u05e2 \u05d8\u05e8\u05d0\u05d5\u05de\u05d8\u05d9 \u05e2\u05dd \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d7\u05d5\u05d3\u05e8\u05e0\u05d9\u05d9\u05dd, \u05d4\u05d9\u05de\u05e0\u05e2\u05d5\u05ea\u05d9\u05d9\u05dd, \u05e2\u05d5\u05e8\u05e8\u05d5\u05ea \u05d5\u05d3\u05d9\u05e1\u05d5\u05e6\u05d9\u05d0\u05e6\u05d9\u05d4, \u05d4\u05e0\u05de\u05e9\u05db\u05d9\u05dd \u05d1\u05d9\u05df 3 \u05d9\u05de\u05d9\u05dd \u05dc\u05d7\u05d5\u05d3\u05e9 \u05d0\u05d7\u05d3 (DSM p.314, Synopsis ch.10)."
        },
        {
          "text": "Adjustment Disorder with Anxiety",
          "isCorrect": false,
          "rationale": "\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d6\u05d5 \u05e0\u05d9\u05ea\u05e0\u05ea \u05db\u05d0\u05e9\u05e8 \u05d4\u05ea\u05d2\u05d5\u05d1\u05d4 \u05dc-stressor \u05d0\u05d9\u05e0\u05d4 \u05e2\u05d5\u05de\u05d3\u05ea \u05d1\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05e9\u05dc \u05d4\u05e4\u05e8\u05e2\u05d4 \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05ea \u05d0\u05d7\u05e8\u05ea, \u05d0\u05d5 \u05db\u05d0\u05e9\u05e8 \u05d4-stressor \u05d0\u05d9\u05e0\u05d5 \u05e2\u05d5\u05de\u05d3 \u05d1-Criterion A \u05e9\u05dc \u05d8\u05e8\u05d0\u05d5\u05de\u05d4 (DSM p.321, Synopsis ch.10)."
        },
        {
          "text": "Brief Psychotic Disorder",
