          "isCorrect": true,
          "rationale": "\u05d9\u05dc\u05d3\u05d9\u05dd \u05e6\u05e2\u05d9\u05e8\u05d9\u05dd \u05e0\u05d5\u05d8\u05d9\u05dd \u05dc\u05d1\u05d8\u05d0 \u05d7\u05d5\u05d5\u05d9\u05d5\u05ea \u05d8\u05e8\u05d0\u05d5\u05de\u05d8\u05d9\u05d5\u05ea \u05d3\u05e8\u05da \u05de\u05e9\u05d7\u05e7 \u05d7\u05d6\u05e8\u05ea\u05d9 \u05d4\u05de\u05d3\u05de\u05d4 \u05d0\u05dc\u05de\u05e0\u05d8\u05d9\u05dd \u05de\u05d4\u05d8\u05e8\u05d0\u05d5\u05de\u05d4 (DSM p.303, Dulcan p.350)."
        },
        {
          "text": "\u05d7\u05dc\u05d5\u05de\u05d5\u05ea \u05de\u05e4\u05d7\u05d9\u05d3\u05d9\u05dd \u05dc\u05dc\u05d0 \u05ea\u05d5\u05db\u05df \u05de\u05d6\u05d5\u05d4\u05d4 \u05e9\u05dc \u05d4\u05d0\u05d9\u05e8\u05d5\u05e2 \u05d4\u05d8\u05e8\u05d0\u05d5\u05de\u05d8\u05d9.",
          "isCorrect": true,
          "rationale": "\u05d1\u05e0\u05d9\u05d2\u05d5\u05d3 \u05dc\u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd, \u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05e9\u05d5\u05d9\u05d9\u05dd \u05dc\u05d7\u05d5\u05d5\u05ea \u05e1\u05d9\u05d5\u05d8\u05d9\u05dd \u05db\u05dc\u05dc\u05d9\u05d9\u05dd \u05e9\u05dc\u05d0 \u05e0\u05d9\u05ea\u05df \u05dc\u05e7\u05e9\u05e8 \u05d9\u05e9\u05d9\u05e8\u05d5\u05ea \u05dc\u05ea\u05d5\u05db\u05df \u05d4\u05d8\u05e8\u05d0\u05d5\u05de\u05d4 (DSM p.303, Synopsis ch.10)."
        },
        {
          "text": "\u05e0\u05e1\u05d9\u05d2\u05d4 (regression) \u05d1\u05de\u05d9\u05d5\u05de\u05e0\u05d5\u05d9\u05d5\u05ea \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9\u05d5\u05ea \u05db\u05de\u05d5 \u05d2\u05de\u05d9\u05dc\u05d4 \u05de\u05d7\u05d9\u05ea\u05d5\u05dc\u05d9\u05dd.",
          "isCorrect": true,
          "rationale": "\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd nonspecific \u05db\u05de\u05d5 \u05e0\u05e1\u05d9\u05d2\u05d4 \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9\u05ea \u05d0\u05d5 \u05d4\u05d9\u05e6\u05de\u05d3\u05d5\u05ea \u05d9\u05ea\u05e8 (clinginess) \u05e0\u05e4\u05d5\u05e6\u05d9\u05dd \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d1\u05d2\u05d9\u05dc \u05d4\u05e8\u05da \u05dc\u05d0\u05d7\u05e8 \u05d8\u05e8\u05d0\u05d5\u05de\u05d4 (Dulcan p.350)."
        },
        {
          "text": "\u05ea\u05d7\u05d5\u05e9\u05ea \u05d0\u05e9\u05de\u05d4 \u05de\u05d5\u05d2\u05d6\u05de\u05ea \u05e2\u05dc \u05db\u05da \u05e9\u05dc\u05d0 \u05d4\u05e6\u05dc\u05d9\u05d7\u05d5 \u05dc\u05de\u05e0\u05d5\u05e2 \u05d0\u05ea \u05d4\u05d0\u05d9\u05e8\u05d5\u05e2.",
          "isCorrect": false,
          "rationale": "\u05ea\u05d5\u05d1\u05e0\u05d5\u05ea \u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9\u05d5\u05ea \u05de\u05d5\u05e8\u05db\u05d1\u05d5\u05ea \u05e9\u05dc \u05d0\u05e9\u05de\u05d4 \u05e2\u05e6\u05de\u05d9\u05ea \u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05d9\u05d5\u05ea \u05d9\u05d5\u05ea\u05e8 \u05dc\u05d9\u05dc\u05d3\u05d9\u05dd \u05d1\u05d5\u05d2\u05e8\u05d9\u05dd \u05d5\u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd \u05de\u05d0\u05e9\u05e8 \u05dc\u05d9\u05dc\u05d3\u05d9\u05dd \u05de\u05ea\u05d7\u05ea \u05dc\u05d2\u05d9\u05dc 6 (Synopsis ch.10, DSM p.301)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d1\u05d5 \u05e2\u05dc \u05d4\u05d0\u05d5\u05e4\u05df \u05e9\u05d1\u05d5 \u05d9\u05dc\u05d3\u05d9\u05dd \u05e9\u05d8\u05e8\u05dd \u05e4\u05d9\u05ea\u05d7\u05d5 \u05d9\u05db\u05d5\u05dc\u05d5\u05ea \u05d5\u05e8\u05d1\u05dc\u05d9\u05d6\u05e6\u05d9\u05d4 \u05de\u05d5\u05e8\u05db\u05d1\u05d5\u05ea \u05de\u05d1\u05d8\u05d0\u05d9\u05dd \u05de\u05e6\u05d5\u05e7\u05d4 \u05e4\u05e0\u05d9\u05de\u05d9\u05ea.",
      "hasAllOfTheAbove": false,
      "hasNoneOfTheAbove": false
