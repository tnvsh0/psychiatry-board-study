    {
      "type": "multiple_choice",
      "question": "\u05de\u05ea\u05d1\u05d2\u05e8\u05ea \u05d1\u05ea 15 \u05de\u05d3\u05d5\u05d5\u05d7\u05ea \u05e2\u05dc \u05d9\u05e8\u05d9\u05d3\u05d4 \u05d1\u05de\u05e6\u05d1 \u05d4\u05e8\u05d5\u05d7, \u05d7\u05d5\u05e1\u05e8 \u05e2\u05e0\u05d9\u05d9\u05df \u05d5\u05e7\u05e9\u05d9\u05d9 \u05e8\u05d9\u05db\u05d5\u05d6 \u05e9\u05d4\u05d7\u05dc\u05d5 \u05db\u05d7\u05d5\u05d3\u05e9\u05d9\u05d9\u05dd \u05dc\u05d0\u05d7\u05e8 \u05d2\u05d9\u05e8\u05d5\u05e9\u05d9 \u05d4\u05d5\u05e8\u05d9\u05d4. \u05d4\u05d9\u05d0 \u05d0\u05d9\u05e0\u05d4 \u05e2\u05d5\u05de\u05d3\u05ea \u05d1\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05d4\u05de\u05dc\u05d0\u05d9\u05dd \u05e9\u05dc Major Depressive Disorder. \u05de\u05d4\u05d5 \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9 \u05d4\u05de\u05d1\u05d7\u05d9\u05df \u05d1\u05d9\u05df Adjustment Disorder with Depressed Mood \u05dc\u05d1\u05d9\u05df \u05d0\u05d1\u05dc \u05e0\u05d5\u05e8\u05de\u05dc\u05d9 (Normal Bereavement)?",
      "answerOptions": [
        {
          "text": "\u05e7\u05d9\u05d5\u05dd \u05de\u05d7\u05e9\u05d1\u05d5\u05ea \u05d0\u05d5\u05d1\u05d3\u05e0\u05d9\u05d5\u05ea \u05d1\u05d0\u05d5\u05e4\u05df \u05e4\u05e2\u05d9\u05dc.",
          "isCorrect": false,
          "rationale": "\u05de\u05d7\u05e9\u05d1\u05d5\u05ea \u05d0\u05d5\u05d1\u05d3\u05e0\u05d9\u05d5\u05ea \u05d9\u05db\u05d5\u05dc\u05d5\u05ea \u05dc\u05d4\u05d5\u05e4\u05d9\u05e2 \u05d1\u05e9\u05e0\u05d9 \u05d4\u05de\u05e6\u05d1\u05d9\u05dd \u05d5\u05d0\u05d9\u05e0\u05df \u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df \u05d4\u05de\u05d1\u05d7\u05d9\u05df \u05d4\u05de\u05e8\u05db\u05d6\u05d9 (Synopsis ch.10)."
        },
        {
          "text": "\u05de\u05e6\u05d5\u05e7\u05d4 \u05e9\u05d4\u05d9\u05d0 out of proportion \u05dc\u05d7\u05d5\u05de\u05e8\u05ea \u05d4-stressor \u05d1\u05d4\u05ea\u05d7\u05e9\u05d1 \u05d1\u05d4\u05e7\u05e9\u05e8 \u05d4\u05ea\u05e8\u05d1\u05d5\u05ea\u05d9.",
          "isCorrect": true,
          "rationale": "\u05d6\u05d4\u05d5 \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df \u05de\u05e8\u05db\u05d6\u05d9 \u05d1-Adjustment Disorder (\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df B1) \u05d4\u05de\u05d1\u05d7\u05d9\u05df \u05d1\u05d9\u05e0\u05d4 \u05dc\u05d1\u05d9\u05df \u05ea\u05d2\u05d5\u05d1\u05d4 \u05e0\u05d5\u05e8\u05de\u05d8\u05d9\u05d1\u05d9\u05ea (DSM p.319, Synopsis Table 10-3)."
        },
        {
          "text": "\u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d7\u05d5\u05dc\u05e4\u05d9\u05dd \u05ea\u05d5\u05da \u05e4\u05d7\u05d5\u05ea \u05de-3 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd.",
          "isCorrect": false,
          "rationale": "\u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d1-Adjustment Disorder \u05d9\u05db\u05d5\u05dc\u05d9\u05dd \u05dc\u05d4\u05d9\u05de\u05e9\u05da \u05e2\u05d3 6 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05dc\u05d0\u05d7\u05e8 \u05e1\u05d9\u05d5\u05dd \u05d4-stressor (DSM p.319)."
        },
        {
          "text": "\u05e7\u05d9\u05d5\u05dd \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9\u05d9\u05dd \u05d7\u05d5\u05dc\u05e4\u05d9\u05dd.",
          "isCorrect": false,
          "rationale": "\u05e7\u05d9\u05d5\u05dd \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9\u05d9\u05dd \u05de\u05db\u05d5\u05d5\u05df \u05dc\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d0\u05d7\u05e8\u05ea \u05d5\u05d0\u05d9\u05e0\u05d5 \u05d7\u05dc\u05e7 \u05de\u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05e9\u05dc \u05d4\u05e4\u05e8\u05e2\u05ea \u05d4\u05e1\u05ea\u05d2\u05dc\u05d5\u05ea (Synopsis Table 10-3)."
        }
      ],
      "hint": "\u05d4\u05ea\u05de\u05e7\u05d3\u05d5 \u05d1\u05e2\u05d5\u05e6\u05de\u05ea \u05d4\u05de\u05e6\u05d5\u05e7\u05d4 \u05dc\u05e2\u05d5\u05de\u05ea \u05d4\u05d0\u05d9\u05e8\u05d5\u05e2 \u05d4\u05de\u05e2\u05d5\u05e8\u05e8 (trigger).",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05e2\u05e8\u05db\u05d4 \u05e9\u05dc \u05d9\u05dc\u05d3 \u05e9\u05e2\u05d1\u05e8 \u05d4\u05ea\u05e2\u05dc\u05dc\u05d5\u05ea \u05de\u05ea\u05de\u05e9\u05db\u05ea \u05de\u05e6\u05d3 \u05d3\u05de\u05d5\u05ea \u05de\u05d8\u05e4\u05dc\u05ea, \u05d4\u05e7\u05dc\u05d9\u05e0\u05d0\u05d9 \u05e9\u05d5\u05e7\u05dc \u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc Complex PTSD (\u05dc\u05e4\u05d9 \u05d4-ICD-11 \u05d4\u05de\u05ea\u05d5\u05db\u05e0\u05df). \u05d0\u05d9\u05dc\u05d5 \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e0\u05d5\u05e1\u05e4\u05d9\u05dd \u05e2\u05dc \u05d0\u05dc\u05d5 \u05e9\u05dc PTSD \u05e7\u05dc\u05d0\u05e1\u05d9 \u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9\u05dd \u05d0\u05d1\u05d7\u05e0\u05d4 \u05d6\u05d5 \u05dc\u05e4\u05d9 \u05d4-Dulcan?",
      "answerOptions": [
        {
          "text": "Hallucinations \u05d5-Delusions.",
          "isCorrect": false,
          "rationale": "\u05d0\u05dc\u05d5 \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e9\u05dc \u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d4 \u05d5\u05dc\u05d0 \u05d7\u05dc\u05e7 \u05de\u05d4\u05d4\u05d2\u05d3\u05e8\u05d4 \u05e9\u05dc Complex PTSD (Dulcan p.355)."
        },
        {
          "text": "Severe affective dysregulation, interpersonal disruption, \u05d5-negative self-image.",
          "isCorrect": true,
          "rationale": "\u05d0\u05dc\u05d5 \u05d4\u05dd \u05e9\u05dc\u05d5\u05e9\u05ea \u05d4\u05e6\u05d1\u05d9\u05e8\u05d9\u05dd (clusters) \u05d4\u05e0\u05d5\u05e1\u05e4\u05d9\u05dd \u05d4\u05de\u05d2\u05d3\u05d9\u05e8\u05d9\u05dd Complex PTSD \u05d1-ICD-11 \u05de\u05e2\u05d1\u05e8 \u05dc\u05ea\u05e1\u05de\u05d9\u05e0\u05d9 \u05d4-PTSD \u05d4\u05e8\u05d2\u05d9\u05dc\u05d9\u05dd (Dulcan p.352)."
        },
        {
          "text": "Tics \u05d5-Stereotypic movements.",
          "isCorrect": false,
          "rationale": "\u05d0\u05dc\u05d5 \u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05e0\u05d5\u05d9\u05e8\u05d5-\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9\u05d5\u05ea \u05e9\u05e2\u05e9\u05d5\u05d9\u05d5\u05ea \u05dc\u05d4\u05d5\u05e4\u05d9\u05e2 \u05db-comorbidity \u05d0\u05da \u05d0\u05d9\u05e0\u05df \u05d7\u05dc\u05e7 \u05de\u05d4\u05d2\u05d3\u05e8\u05ea \u05d4-Complex PTSD (Dulcan p.324)."
        },
        {
          "text": "Hyperactivity \u05d5-Impulsivity \u05d1\u05dc\u05d1\u05d3.",
          "isCorrect": false,
          "rationale": "\u05d0\u05dc\u05d5 \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e9\u05dc ADHD \u05e9\u05e2\u05dc\u05d5\u05dc\u05d9\u05dd \u05dc\u05d7\u05e7\u05d5\u05ea PTSD \u05d0\u05da \u05d0\u05d9\u05e0\u05dd \u05de\u05d2\u05d3\u05d9\u05e8\u05d9\u05dd \u05d0\u05ea \u05d4-Complex PTSD (Dulcan p.354)."
        }
      ],
      "hint": "\u05d7\u05e4\u05e9\u05d5 \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d4\u05e7\u05e9\u05d5\u05e8\u05d9\u05dd \u05dc\u05d5\u05d5\u05d9\u05e1\u05d5\u05ea \u05e8\u05d2\u05e9\u05d9 \u05d5\u05d3\u05d9\u05de\u05d5\u05d9 \u05e2\u05e6\u05de\u05d9 \u05e9\u05e0\u05e4\u05d2\u05e2\u05d5 \u05db\u05ea\u05d5\u05e6\u05d0\u05d4 \u05de\u05d8\u05e8\u05d0\u05d5\u05de\u05d4 \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9\u05ea.",
      "imageUrls": []
    },
    {
      "type": "fill_in_the_blank",
      "question": "\u05d1-Acute Stress Disorder, \u05d0\u05d7\u05d3 \u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d4\u05d0\u05e4\u05e9\u05e8\u05d9\u05d9\u05dd \u05d4\u05d5\u05d0 \u05d0\u05d9-\u05d9\u05db\u05d5\u05dc\u05ea \u05dc\u05d6\u05db\u05d5\u05e8 \u05d4\u05d9\u05d1\u05d8 \u05d7\u05e9\u05d5\u05d1 \u05e9\u05dc \u05d4\u05d0\u05d9\u05e8\u05d5\u05e2 \u05d4\u05d8\u05e8\u05d0\u05d5\u05de\u05d8\u05d9 (Dissociative Amnesia). \u05ea\u05e1\u05de\u05d9\u05df \u05d6\u05d4 \u05d0\u05d9\u05e0\u05d5 \u05de\u05d0\u05d5\u05d1\u05d7\u05df \u05d0\u05dd \u05d4\u05d5\u05d0 \u05e0\u05d5\u05d1\u05e2 \u05de-___ (\u05dc\u05de\u05e9\u05dc \u05db\u05ea\u05d5\u05e6\u05d0\u05d4 \u05de\u05d7\u05d1\u05dc\u05ea \u05e8\u05d0\u05e9).",
      "bestAnswer": "Traumatic Brain Injury",
      "acceptableAnswers": [
        "TBI",
        "mild traumatic brain injury",
        "\u05d7\u05d1\u05dc\u05ea \u05e8\u05d0\u05e9",
