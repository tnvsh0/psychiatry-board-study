{
  "title": "Communication Quiz",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\u05d9\u05dc\u05d3 \u05d1\u05df 5 \u05de\u05d5\u05e4\u05e0\u05d4 \u05dc\u05d4\u05e2\u05e8\u05db\u05d4 \u05d1\u05e9\u05dc \u05e7\u05e9\u05d9\u05d9\u05dd \u05d7\u05d1\u05e8\u05ea\u05d9\u05d9\u05dd. \u05d4\u05d2\u05e0\u05e0\u05ea \u05de\u05d3\u05d5\u05d5\u05d7\u05ea \u05db\u05d9 \u05d4\u05d5\u05d0 \u05de\u05ea\u05e7\u05e9\u05d4 \u05dc\u05d4\u05e9\u05ea\u05dc\u05d1 \u05d1\u05de\u05e9\u05d7\u05e7\u05d9 \u05e7\u05d1\u05d5\u05e6\u05d4, \u05d0\u05d9\u05e0\u05d5 \u05de\u05d1\u05d9\u05df \u05d1\u05d3\u05d9\u05d7\u05d5\u05ea \u05d0\u05d5 \u05e8\u05de\u05d6\u05d9\u05dd \u05d7\u05d1\u05e8\u05ea\u05d9\u05d9\u05dd, \u05d5\u05e0\u05d5\u05d8\u05d4 \u05dc\u05d3\u05d1\u05e8 \u05d1\u05d0\u05d5\u05e4\u05df \u05e4\u05d5\u05e8\u05de\u05dc\u05d9 \u05de\u05d3\u05d9 \u05dc\u05d2\u05d9\u05dc\u05d5. \u05d1\u05e8\u05d0\u05d9\u05d5\u05df \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9 \u05d5\u05d1\u05ea\u05e6\u05e4\u05d9\u05ea, \u05d4\u05d9\u05dc\u05d3 \u05de\u05e4\u05d2\u05d9\u05df \u05e7\u05d5\u05e9\u05d9 \u05d1\u05e0\u05d9\u05d4\u05d5\u05dc \u05e9\u05d9\u05d7\u05d4 \u05d3\u05d5-\u05db\u05d9\u05d5\u05d5\u05e0\u05d9\u05ea \u05d5\u05d1\u05d4\u05d1\u05e0\u05ea \u05e1\u05e8\u05e7\u05d6\u05dd. \u05d1\u05d1\u05d7\u05d9\u05e0\u05ea \u05d4\u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4 \u05d4\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9\u05ea, \u05d4\u05d4\u05d5\u05e8\u05d9\u05dd \u05e9\u05d5\u05dc\u05dc\u05d9\u05dd \u05e7\u05d9\u05d5\u05dd \u05e9\u05dc \u05ea\u05d7\u05d5\u05de\u05d9 \u05e2\u05e0\u05d9\u05d9\u05df \u05de\u05e6\u05d5\u05de\u05e6\u05de\u05d9\u05dd, \u05d8\u05e7\u05e1\u05d9\u05dd \u05e7\u05d1\u05d5\u05e2\u05d9\u05dd \u05d0\u05d5 \u05ea\u05e0\u05d5\u05e2\u05d5\u05ea \u05e1\u05d8\u05e8\u05d9\u05d0\u05d5\u05d8\u05d9\u05e4\u05d9\u05d5\u05ea \u05d1\u05e2\u05d1\u05e8 \u05d0\u05d5 \u05d1\u05d4\u05d5\u05d5\u05d4. \u05de\u05d4\u05d9 \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05e1\u05d1\u05d9\u05e8\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8?",
      "answerOptions": [
        {
          "text": "Social (Pragmatic) Communication Disorder (SPCD)",
          "isCorrect": true,
          "rationale": "\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d6\u05d5 \u05de\u05ea\u05d0\u05d9\u05de\u05d4 \u05db\u05d0\u05e9\u05e8 \u05e7\u05d9\u05d9\u05de\u05d9\u05dd \u05dc\u05d9\u05e7\u05d5\u05d9\u05d9\u05dd \u05d1\u05e9\u05d9\u05de\u05d5\u05e9 \u05d4\u05d7\u05d1\u05e8\u05ea\u05d9 \u05d1\u05ea\u05e7\u05e9\u05d5\u05e8\u05ea (Pragmatics) \u05d0\u05da \u05d0\u05d9\u05df \u05e2\u05d3\u05d5\u05ea \u05dc\u05d3\u05e4\u05d5\u05e1\u05d9 \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d0\u05d5 \u05ea\u05d7\u05d5\u05de\u05d9 \u05e2\u05e0\u05d9\u05d9\u05df \u05d7\u05d5\u05d6\u05e8\u05d9\u05dd \u05d5\u05de\u05e6\u05d5\u05de\u05e6\u05de\u05d9\u05dd (RRBs), \u05d4\u05de\u05d4\u05d5\u05d5\u05d9\u05dd \u05ea\u05e0\u05d0\u05d9 \u05d4\u05db\u05e8\u05d7\u05d9 \u05dc\u05d0\u05d1\u05d7\u05e0\u05ea ASD (DSM p.55, Dulcan p.163)."
        },
        {
          "text": "Autism Spectrum Disorder (ASD)",
          "isCorrect": false,
          "rationale": "\u05e2\u05dc \u05d0\u05e3 \u05d4\u05dc\u05d9\u05e7\u05d5\u05d9 \u05d1\u05ea\u05e7\u05e9\u05d5\u05e8\u05ea \u05d4\u05d7\u05d1\u05e8\u05ea\u05d9\u05ea, \u05d0\u05d1\u05d7\u05e0\u05ea ASD \u05d3\u05d5\u05e8\u05e9\u05ea \u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05e9\u05dc Criterion B (\u05d3\u05e4\u05d5\u05e1\u05d9\u05dd \u05de\u05e6\u05d5\u05de\u05e6\u05de\u05d9\u05dd \u05d5\u05d7\u05d5\u05d6\u05e8\u05d9\u05dd \u05e9\u05dc \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea, \u05e2\u05e0\u05d9\u05d9\u05df \u05d0\u05d5 \u05e4\u05e2\u05d9\u05dc\u05d5\u05ea), \u05d0\u05e9\u05e8 \u05e0\u05e9\u05dc\u05dc\u05d5 \u05d1\u05de\u05e7\u05e8\u05d4 \u05d6\u05d4 (DSM p.66, Dulcan p.145)."
        },
        {
          "text": "Social Anxiety Disorder",
          "isCorrect": false,
          "rationale": "\u05d1\u05d4\u05e4\u05e8\u05e2\u05ea \u05d7\u05e8\u05d3\u05d4 \u05d7\u05d1\u05e8\u05ea\u05d9\u05ea, \u05db\u05d9\u05e9\u05d5\u05e8\u05d9 \u05d4\u05ea\u05e7\u05e9\u05d5\u05e8\u05ea \u05d4\u05d7\u05d1\u05e8\u05ea\u05d9\u05ea \u05de\u05ea\u05e4\u05ea\u05d7\u05d9\u05dd \u05d1\u05d0\u05d5\u05e4\u05df \u05ea\u05e7\u05d9\u05df \u05d0\u05da \u05d0\u05d9\u05e0\u05dd \u05de\u05d9\u05d5\u05e9\u05de\u05d9\u05dd \u05d1\u05e9\u05dc \u05e4\u05d7\u05d3 \u05d0\u05d5 \u05d7\u05e8\u05d3\u05d4, \u05d1\u05e2\u05d5\u05d3 \u05e9\u05d1-SPCD \u05d4\u05dc\u05d9\u05e7\u05d5\u05d9 \u05d4\u05d5\u05d0 \u05e8\u05d0\u05e9\u05d5\u05e0\u05d9 \u05d1\u05db\u05d9\u05e9\u05d5\u05e8\u05d9 \u05d4\u05e4\u05e8\u05d2\u05de\u05d8\u05d9\u05e7\u05d4 \u05e2\u05e6\u05de\u05dd (DSM p.55)."
        },
        {
          "text": "Attention-Deficit/Hyperactivity Disorder (ADHD)",
          "isCorrect": false,
          "rationale": "\u05d1\u05e2\u05d5\u05d3 \u05e9-ADHD \u05d9\u05db\u05d5\u05dc \u05dc\u05d4\u05d5\u05d1\u05d9\u05dc \u05dc\u05e7\u05e9\u05d9\u05d9\u05dd \u05d7\u05d1\u05e8\u05ea\u05d9\u05d9\u05dd \u05d1\u05e9\u05dc \u05d0\u05d9\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05d5\u05ea \u05d0\u05d5 \u05d7\u05d5\u05e1\u05e8 \u05e7\u05e9\u05d1, \u05d4\u05e4\u05e8\u05d5\u05e4\u05d9\u05dc \u05e9\u05dc \u05e7\u05d5\u05e9\u05d9 \u05d1\u05d4\u05d1\u05e0\u05ea \u05e9\u05e4\u05d4 \u05dc\u05d0-\u05de\u05d9\u05dc\u05d5\u05dc\u05d9\u05ea \u05d5\u05e4\u05d5\u05e8\u05de\u05dc\u05d9\u05d5\u05ea \u05d9\u05ea\u05e8 \u05de\u05db\u05d5\u05d5\u05df \u05dc\u05dc\u05d9\u05e7\u05d5\u05d9 \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9 \u05d1\u05e4\u05e8\u05d2\u05de\u05d8\u05d9\u05e7\u05d4 (DSM p.55)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc '\u05db\u05dc\u05dc \u05d4\u05e7\u05d3\u05d9\u05de\u05d5\u05ea' \u05d5\u05d4\u05d4\u05d1\u05d3\u05dc \u05d4\u05e7\u05e8\u05d9\u05d8\u05d9 \u05d1\u05d9\u05df \u05d4\u05e4\u05e8\u05e2\u05d4 \u05d6\u05d5 \u05dc\u05d1\u05d9\u05df \u05e8\u05e6\u05e3 \u05d4\u05d0\u05d5\u05d8\u05d9\u05d6\u05dd \u05d1\u05e0\u05d5\u05d2\u05e2 \u05dc\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df B.",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05d9\u05dc\u05d3\u05d4 \u05d1\u05ea 4 \u05de\u05e6\u05d9\u05d2\u05d4 \u05d0\u05d9\u05d7\u05d5\u05e8 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9 \u05d1\u05e8\u05db\u05d9\u05e9\u05ea \u05e9\u05e4\u05d4. \u05d0\u05d5\u05e6\u05e8 \u05d4\u05de\u05d9\u05dc\u05d9\u05dd \u05e9\u05dc\u05d4 \u05de\u05e6\u05d5\u05de\u05e6\u05dd \u05de\u05d0\u05d5\u05d3, \u05d5\u05d4\u05d9\u05d0 \u05d1\u05d5\u05e0\u05d4 \u05de\u05e9\u05e4\u05d8\u05d9\u05dd \u05e7\u05e6\u05e8\u05d9\u05dd \u05d5\u05e4\u05e9\u05d5\u05d8\u05d9\u05dd \u05e9\u05d0\u05d9\u05e0\u05dd \u05ea\u05d5\u05d0\u05de\u05d9\u05dd \u05d0\u05ea \u05d2\u05d9\u05dc\u05d4. \u05d1\u05d4\u05e2\u05e8\u05db\u05d4 \u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05de\u05e7\u05d9\u05e4\u05d4, \u05e0\u05de\u05e6\u05d0 \u05db\u05d9 \u05d4\u05e7\u05d5\u05e9\u05d9 \u05e9\u05dc\u05d4 \u05d0\u05d9\u05e0\u05d5 \u05de\u05d5\u05d2\u05d1\u05dc \u05e8\u05e7 \u05dc\u05d4\u05e4\u05e7\u05d4 (Production) \u05d0\u05dc\u05d0 \u05d2\u05dd \u05dc\u05d4\u05d1\u05e0\u05d4 (Comprehension) \u05e9\u05dc \u05de\u05e1\u05e8\u05d9\u05dd \u05de\u05d5\u05e8\u05db\u05d1\u05d9\u05dd. \u05de\u05d4 \u05e0\u05d9\u05ea\u05df \u05dc\u05d5\u05de\u05e8 \u05e2\u05dc \u05d4\u05e4\u05e8\u05d5\u05d2\u05e0\u05d5\u05d6\u05d4 \u05e9\u05dc\u05d4 \u05d1\u05d4\u05e9\u05d5\u05d5\u05d0\u05d4 \u05dc\u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd \u05dc\u05d9\u05e7\u05d5\u05d9 \u05d1\u05d4\u05e4\u05e7\u05d4 \u05d1\u05dc\u05d1\u05d3?",
      "answerOptions": [
        {
          "text": "\u05d4\u05e4\u05e8\u05d5\u05d2\u05e0\u05d5\u05d6\u05d4 \u05e9\u05dc\u05d4 \u05e4\u05d7\u05d5\u05ea \u05d8\u05d5\u05d1\u05d4, \u05e9\u05db\u05df \u05dc\u05d9\u05e7\u05d5\u05d9\u05d9 \u05d4\u05d1\u05e0\u05d4 (Receptive language) \u05e2\u05de\u05d9\u05d3\u05d9\u05dd \u05d9\u05d5\u05ea\u05e8 \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d5\u05e7\u05e9\u05d5\u05e8\u05d9\u05dd \u05dc\u05e1\u05d9\u05db\u05d5\u05df \u05d2\u05d1\u05d5\u05d4 \u05dc\u05dc\u05d9\u05e7\u05d5\u05d9\u05d9 \u05e7\u05e8\u05d9\u05d0\u05d4.",
          "isCorrect": true,
          "rationale": "\u05dc\u05d9\u05e7\u05d5\u05d9\u05d9\u05dd \u05d1\u05e8\u05db\u05d9\u05d1 \u05d4\u05d4\u05d1\u05e0\u05d4 (Receptive language impairments) \u05e0\u05d7\u05e9\u05d1\u05d9\u05dd \u05dc\u05e2\u05de\u05d9\u05d3\u05d9\u05dd \u05d9\u05d5\u05ea\u05e8 \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d5\u05e7\u05e9\u05d5\u05e8\u05d9\u05dd \u05dc\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d2\u05d1\u05d5\u05d4\u05d4 \u05e9\u05dc \u05e7\u05e9\u05d9\u05d9\u05dd \u05d1\u05d4\u05d1\u05e0\u05ea \u05d4\u05e0\u05e7\u05e8\u05d0 \u05d1\u05d4\u05de\u05e9\u05da (DSM p.48)."
        },
        {
          "text": "\u05d4\u05e4\u05e8\u05d5\u05d2\u05e0\u05d5\u05d6\u05d4 \u05e9\u05dc\u05d4 \u05d8\u05d5\u05d1\u05d4 \u05d9\u05d5\u05ea\u05e8, \u05db\u05d9\u05d5\u05d5\u05df \u05e9\u05dc\u05d9\u05e7\u05d5\u05d9\u05d9 \u05d4\u05d1\u05e0\u05d4 \u05e0\u05d5\u05d8\u05d9\u05dd \u05dc\u05d4\u05e9\u05ea\u05e4\u05e8 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05e2\u05dd \u05d4\u05db\u05e0\u05d9\u05e1\u05d4 \u05dc\u05d1\u05d9\u05ea \u05d4\u05e1\u05e4\u05e8.",
          "isCorrect": false,
          "rationale": "\u05d4\u05d4\u05e4\u05da \u05d4\u05d5\u05d0 \u05d4\u05e0\u05db\u05d5\u05df; \u05dc\u05d9\u05e7\u05d5\u05d9\u05d9 \u05d4\u05d1\u05e0\u05d4 \u05d4\u05dd \u05e1\u05d9\u05de\u05df \u05e4\u05e8\u05d5\u05d2\u05e0\u05d5\u05e1\u05d8\u05d9 \u05e9\u05dc\u05d9\u05dc\u05d9 \u05d9\u05d5\u05ea\u05e8 \u05de\u05d0\u05e9\u05e8 \u05dc\u05d9\u05e7\u05d5\u05d9\u05d9 \u05d4\u05d1\u05e2\u05d4 \u05d1\u05dc\u05d1\u05d3 (DSM p.48)."
        },
        {
          "text": "\u05d0\u05d9\u05df \u05d4\u05d1\u05d3\u05dc \u05e4\u05e8\u05d5\u05d2\u05e0\u05d5\u05e1\u05d8\u05d9 \u05d1\u05d9\u05df \u05dc\u05d9\u05e7\u05d5\u05d9\u05d9 \u05d4\u05d1\u05e0\u05d4 \u05dc\u05dc\u05d9\u05e7\u05d5\u05d9\u05d9 \u05d4\u05e4\u05e7\u05d4 \u05d1\u05d9\u05dc\u05d3\u05d5\u05ea \u05d4\u05de\u05d5\u05e7\u05d3\u05de\u05ea.",
          "isCorrect": false,
          "rationale": "\u05e7\u05d9\u05d9\u05de\u05ea \u05d4\u05d1\u05d7\u05e0\u05d4 \u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05d1\u05e8\u05d5\u05e8\u05d4, \u05db\u05d0\u05e9\u05e8 \u05de\u05e2\u05d5\u05e8\u05d1\u05d5\u05ea \u05e9\u05dc \u05d4\u05d1\u05e0\u05ea \u05e9\u05e4\u05d4 \u05de\u05e0\u05d1\u05d0\u05ea \u05e7\u05e9\u05d9\u05d9\u05dd \u05d0\u05e7\u05d3\u05de\u05d9\u05d9\u05dd \u05d5\u05ea\u05e4\u05e7\u05d5\u05d3\u05d9\u05d9\u05dd \u05d0\u05e8\u05d5\u05db\u05d9 \u05d8\u05d5\u05d5\u05d7 (DSM p.48)."
        },
        {
          "text": "\u05d4\u05e4\u05e8\u05d5\u05d2\u05e0\u05d5\u05d6\u05d4 \u05ea\u05dc\u05d5\u05d9\u05d4 \u05d0\u05da \u05d5\u05e8\u05e7 \u05d1\u05e8\u05de\u05ea \u05d4-IQ \u05d4\u05d1\u05dc\u05ea\u05d9 \u05de\u05d9\u05dc\u05d5\u05dc\u05d9 \u05d5\u05dc\u05d0 \u05d1\u05e1\u05d5\u05d2 \u05d4\u05dc\u05d9\u05e7\u05d5\u05d9 \u05d4\u05e9\u05e4\u05ea\u05d9.",
          "isCorrect": false,
          "rationale": "\u05d0\u05de\u05e0\u05dd IQ \u05d1\u05dc\u05ea\u05d9 \u05de\u05d9\u05dc\u05d5\u05dc\u05d9 \u05d7\u05e9\u05d5\u05d1, \u05d0\u05da \u05dc\u05e1\u05d5\u05d2 \u05d4\u05dc\u05d9\u05e7\u05d5\u05d9 \u05d4\u05e9\u05e4\u05ea\u05d9 (\u05d4\u05d1\u05e0\u05d4 \u05dc\u05e2\u05d5\u05de\u05ea \u05d4\u05d1\u05e2\u05d4) \u05d9\u05e9 \u05e2\u05e8\u05da \u05e4\u05e8\u05d5\u05d2\u05e0\u05d5\u05e1\u05d8\u05d9 \u05e2\u05e6\u05de\u05d0\u05d9 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9 (DSM p.49)."
        }
      ],
