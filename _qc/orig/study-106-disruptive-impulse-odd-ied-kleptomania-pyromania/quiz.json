    {
      "type": "multiple_choice",
      "question": "\u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05e2\u05e8\u05db\u05d4 \u05e9\u05dc \u05e0\u05e2\u05e8 \u05d1\u05df 14 \u05e9\u05e0\u05ea\u05e4\u05e1 \u05de\u05e6\u05d9\u05ea \u05d0\u05e9 \u05d1\u05de\u05d2\u05e8\u05e9 \u05e0\u05d8\u05d5\u05e9, \u05d4\u05e7\u05dc\u05d9\u05e0\u05d0\u05d9 \u05e9\u05d5\u05e7\u05dc \u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc Pyromania. \u05d0\u05d9\u05d6\u05d4 \u05de\u05d4\u05de\u05de\u05e6\u05d0\u05d9\u05dd \u05d4\u05d1\u05d0\u05d9\u05dd \u05d9\u05ea\u05de\u05d5\u05da \u05d1\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d6\u05d5 \u05e2\u05dc \u05e4\u05e0\u05d9 Conduct Disorder (CD) \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR?",
      "answerOptions": [
        {
          "text": "\u05d4\u05d4\u05e6\u05ea\u05d4 \u05e0\u05e2\u05e9\u05ea\u05d4 \u05dc\u05d4\u05e7\u05dc\u05ea \u05de\u05ea\u05d7 \u05e4\u05e0\u05d9\u05de\u05d9 (Arousal) \u05d5\u05dc\u05dc\u05d0 \u05e8\u05d5\u05d5\u05d7 \u05db\u05e1\u05e4\u05d9 \u05d0\u05d5 \u05e0\u05e7\u05de\u05d4.",
          "isCorrect": true,
          "rationale": "\u05d1-Pyromania \u05d4\u05d4\u05e6\u05ea\u05d4 \u05e0\u05d5\u05d1\u05e2\u05ea \u05de\u05d3\u05d7\u05e3 \u05e4\u05e0\u05d9\u05de\u05d9 \u05d5\u05d4\u05e0\u05d0\u05d4 \u05de\u05d4\u05d0\u05e9 \u05e2\u05e6\u05de\u05d4, \u05d1\u05e2\u05d5\u05d3 \u05e9\u05d1-CD \u05d4\u05e6\u05ea\u05d5\u05ea \u05d4\u05df \u05dc\u05e8\u05d5\u05d1 \u05d7\u05dc\u05e7 \u05de\u05d3\u05e4\u05d5\u05e1 \u05e9\u05dc \u05d4\u05e4\u05e8\u05ea \u05d6\u05db\u05d5\u05d9\u05d5\u05ea \u05d0\u05d5 \u05e0\u05e7\u05de\u05d4 (DSM p.538)."
        },
        {
          "text": "\u05d4\u05e0\u05e2\u05e8 \u05de\u05e8\u05d0\u05d4 \u05d7\u05d5\u05e1\u05e8 \u05d7\u05e8\u05d8\u05d4 (Lack of remorse) \u05d5\u05e4\u05d5\u05d2\u05e2 \u05d1\u05d1\u05e2\u05dc\u05d9 \u05d7\u05d9\u05d9\u05dd.",
          "isCorrect": false,
          "rationale": "\u05d0\u05dc\u05d5 \u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9\u05dd \u05de\u05d5\u05d1\u05d4\u05e7\u05d9\u05dd \u05e9\u05dc Conduct Disorder (CD), \u05d4\u05de\u05d5\u05e6\u05d9\u05d0\u05d4 \u05dc\u05e8\u05d5\u05d1 \u05d0\u05ea \u05d0\u05d1\u05d7\u05e0\u05ea \u05d4-Pyromania (DSM p.530)."
        },
        {
          "text": "\u05d4\u05d4\u05e6\u05ea\u05d4 \u05d4\u05ea\u05e8\u05d7\u05e9\u05d4 \u05d1\u05de\u05d4\u05dc\u05da \u05e4\u05e8\u05e7 \u05de\u05d0\u05e0\u05d9 (Manic Episode).",
          "isCorrect": false,
          "rationale": "\u05d0\u05dd \u05d4\u05d4\u05e6\u05ea\u05d4 \u05de\u05d5\u05e1\u05d1\u05e8\u05ea \u05d8\u05d5\u05d1 \u05d9\u05d5\u05ea\u05e8 \u05e2\u05dc \u05d9\u05d3\u05d9 \u05de\u05d0\u05e0\u05d9\u05d4, \u05dc\u05d0 \u05e0\u05d9\u05ea\u05df \u05dc\u05d0\u05d1\u05d7\u05df Pyromania \u05dc\u05e4\u05d9 \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df F (DSM p.538)."
        },
        {
          "text": "\u05d4\u05e0\u05e2\u05e8 \u05d4\u05e6\u05d9\u05ea \u05d0\u05ea \u05d4\u05d0\u05e9 \u05db\u05d3\u05d9 \u05dc\u05d4\u05e1\u05ea\u05d9\u05e8 \u05e8\u05d0\u05d9\u05d5\u05ea \u05dc\u05e4\u05e8\u05d9\u05e6\u05d4 \u05e9\u05d1\u05d9\u05e6\u05e2.",
          "isCorrect": false,
