        },
        {
          "text": "\u05e8\u05de\u05d5\u05ea \u05d5\u05d9\u05d8\u05de\u05d9\u05df B12 \u05d5\u05d7\u05d5\u05de\u05e6\u05d4 \u05e4\u05d5\u05dc\u05d9\u05ea.",
          "isCorrect": false,
