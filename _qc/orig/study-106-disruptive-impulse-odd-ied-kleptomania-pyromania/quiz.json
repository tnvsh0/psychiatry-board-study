{
  "title": "Psychiatry Quiz",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\u05d9\u05dc\u05d3 \u05d1\u05df 9 \u05de\u05d5\u05e4\u05e0\u05d4 \u05dc\u05d4\u05e2\u05e8\u05db\u05d4 \u05d1\u05e9\u05dc \u05d4\u05ea\u05e4\u05e8\u05e6\u05d5\u05d9\u05d5\u05ea \u05d6\u05e2\u05dd \u05e7\u05e9\u05d5\u05ea \u05d4\u05de\u05ea\u05e8\u05d7\u05e9\u05d5\u05ea \u05dc\u05e4\u05d7\u05d5\u05ea 3 \u05e4\u05e2\u05de\u05d9\u05dd \u05d1\u05e9\u05d1\u05d5\u05e2 \u05d1\u05e9\u05e0\u05d9 \u05d4\u05e7\u05e9\u05e8\u05d9\u05dd \u05e9\u05d5\u05e0\u05d9\u05dd. \u05d4\u05d5\u05e8\u05d9\u05d5 \u05de\u05d3\u05d5\u05d5\u05d7\u05d9\u05dd \u05db\u05d9 \u05d1\u05d9\u05df \u05d4\u05d4\u05ea\u05e4\u05e8\u05e6\u05d5\u05d9\u05d5\u05ea, \u05de\u05e6\u05d1 \u05e8\u05d5\u05d7\u05d5 \u05e8\u05d2\u05d6\u05e0\u05d9 \u05d5\u05db\u05d5\u05e2\u05e1 \u05d1\u05d0\u05d5\u05e4\u05df \u05db\u05e8\u05d5\u05e0\u05d9 \u05db\u05de\u05e2\u05d8 \u05de\u05d3\u05d9 \u05d9\u05d5\u05dd. \u05d4\u05d9\u05dc\u05d3 \u05e2\u05d5\u05de\u05d3 \u05d1\u05db\u05dc \u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05e9\u05dc Oppositional Defiant Disorder (ODD). \u05de\u05d4\u05d9 \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05e0\u05db\u05d5\u05e0\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR?",
      "answerOptions": [
        {
          "text": "Disruptive Mood Dysregulation Disorder (DMDD) \u05d1\u05dc\u05d1\u05d3.",
          "isCorrect": true,
          "rationale": "\u05dc\u05e4\u05d9 \u05d4-DSM-5-TR, \u05d0\u05dd \u05de\u05ea\u05de\u05dc\u05d0\u05d9\u05dd \u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05d4\u05df \u05dc-DMDD \u05d5\u05d4\u05df \u05dc-ODD, \u05d9\u05e9 \u05dc\u05ea\u05ea \u05d0\u05ea \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc DMDD \u05d1\u05dc\u05d1\u05d3, \u05db\u05d9\u05d5\u05d5\u05df \u05e9\u05d4\u05d9\u05d0 '\u05d1\u05d5\u05dc\u05de\u05ea' \u05d0\u05ea \u05d0\u05d1\u05d7\u05e0\u05ea \u05d4-ODD (DSM p.178, p.526)."
        },
        {
          "text": "\u05de\u05ea\u05df \u05e9\u05ea\u05d9 \u05d4\u05d0\u05d1\u05d7\u05e0\u05d5\u05ea \u05d1\u05de\u05e7\u05d1\u05d9\u05dc: ODD \u05d5-DMDD.",
          "isCorrect": false,
          "rationale": "\u05d4\u05d0\u05d1\u05d7\u05e0\u05d5\u05ea \u05d4\u05dc\u05dc\u05d5 \u05de\u05d5\u05e6\u05d9\u05d0\u05d5\u05ea \u05d6\u05d5 \u05d0\u05ea \u05d6\u05d5; \u05d1\u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05e8\u05d2\u05d6\u05e0\u05d5\u05ea \u05db\u05e8\u05d5\u05e0\u05d9\u05ea \u05d4\u05e2\u05d5\u05e0\u05d4 \u05dc\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05e9\u05dc DMDD, \u05dc\u05d0 \u05e0\u05d1\u05e6\u05e2 \u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc ODD (DSM p.526)."
        },
        {
          "text": "Oppositional Defiant Disorder (ODD) \u05e2\u05dd \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05d9\u05e8 \u05e9\u05dc \u05e8\u05d2\u05d6\u05e0\u05d5\u05ea \u05db\u05e8\u05d5\u05e0\u05d9\u05ea.",
          "isCorrect": false,
          "rationale": "\u05d0\u05d9\u05df \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05d9\u05e8 \u05db\u05d6\u05d4 \u05d1-DSM-5-TR \u05e2\u05d1\u05d5\u05e8 ODD; \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d0\u05dc\u05d5 \u05de\u05db\u05d5\u05d5\u05e0\u05d9\u05dd \u05d9\u05e9\u05d9\u05e8\u05d5\u05ea \u05dc\u05d0\u05d1\u05d7\u05e0\u05d4 \u05e0\u05e4\u05e8\u05d3\u05ea \u05e9\u05dc DMDD (\u05de\u05e7\u05d5\u05e8: \u05d4\u05e7\u05e9\u05e8 \u05e8\u05d7\u05d1)."
        },
        {
          "text": "Intermittent Explosive Disorder (IED) \u05d1\u05e9\u05dc \u05ea\u05d3\u05d9\u05e8\u05d5\u05ea \u05d4\u05d4\u05ea\u05e4\u05e8\u05e6\u05d5\u05d9\u05d5\u05ea.",
          "isCorrect": false,
          "rationale": "\u05d1-IED \u05de\u05e6\u05d1 \u05d4\u05e8\u05d5\u05d7 \u05d1\u05d9\u05df \u05d4\u05d4\u05ea\u05e4\u05e8\u05e6\u05d5\u05d9\u05d5\u05ea \u05d0\u05d9\u05e0\u05d5 \u05e8\u05d2\u05d6\u05e0\u05d9 \u05d0\u05d5 \u05db\u05d5\u05e2\u05e1 \u05d1\u05d0\u05d5\u05e4\u05df \u05e2\u05e7\u05d1\u05d9, \u05d1\u05e0\u05d9\u05d2\u05d5\u05d3 \u05dc\u05de\u05ea\u05d5\u05d0\u05e8 \u05d1\u05de\u05e7\u05e8\u05d4 \u05d6\u05d4 (DSM p.530)."
        }
      ],
      "hint": "\u05d1\u05d3\u05d5\u05e7 \u05d0\u05ea \u05db\u05dc\u05dc\u05d9 \u05d4\u05e7\u05d3\u05d9\u05de\u05d5\u05ea \u05d4\u05d0\u05d1\u05d7\u05e0\u05ea\u05d9\u05ea \u05d1\u05d9\u05df \u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05de\u05e6\u05d1 \u05e8\u05d5\u05d7 \u05dc\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d1-DSM-5-TR.",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05e0\u05e2\u05e8 \u05d1\u05df 16 \u05de\u05d0\u05d5\u05d1\u05d7\u05df \u05e2\u05dd Intermittent Explosive Disorder (IED) \u05dc\u05d0\u05d7\u05e8 \u05e1\u05d3\u05e8\u05d4 \u05e9\u05dc \u05d4\u05ea\u05e4\u05e8\u05e6\u05d5\u05d9\u05d5\u05ea \u05d0\u05dc\u05d9\u05de\u05d5\u05ea \u05e4\u05d9\u05d6\u05d9\u05ea \u05db\u05dc\u05e4\u05d9 \u05e8\u05db\u05d5\u05e9. \u05d1\u05d1\u05d3\u05d9\u05e7\u05ea\u05d5 \u05d0\u05d9\u05df \u05e2\u05d3\u05d5\u05ea \u05dc\u05d4\u05e4\u05e8\u05e2\u05d4 \u05d1\u05d9\u05e4\u05d5\u05dc\u05e8\u05d9\u05ea \u05d0\u05d5 \u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d4. \u05de\u05d4\u05d5 \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05ea\u05e8\u05d5\u05e4\u05ea\u05d9 \u05d4\u05de\u05d5\u05d2\u05d3\u05e8 \u05db\u05e7\u05d5 \u05e8\u05d0\u05e9\u05d5\u05df \u05dc\u05d4\u05e4\u05d7\u05ea\u05ea \u05d4\u05ea\u05d5\u05e7\u05e4\u05e0\u05d5\u05ea \u05d4\u05d0\u05d9\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05ea \u05d1\u05de\u05e7\u05e8\u05d4 \u05d6\u05d4?",
      "answerOptions": [
        {
          "text": "\u05de\u05e2\u05db\u05d1\u05d9 \u05e1\u05e4\u05d9\u05d2\u05d4 \u05d7\u05d5\u05d6\u05e8\u05ea \u05e9\u05dc \u05e1\u05e8\u05d5\u05d8\u05d5\u05e0\u05d9\u05df (SSRIs) \u05db\u05d2\u05d5\u05df Fluoxetine.",
          "isCorrect": true,
          "rationale": "\u05d4\u05d2\u05d1\u05e8\u05ea \u05d4\u05d8\u05d5\u05df \u05d4\u05e1\u05e8\u05d5\u05d8\u05d5\u05e0\u05e8\u05d2\u05d9 \u05d1\u05de\u05e2\u05e8\u05db\u05ea \u05d4-Limbic \u05d5\u05d1-OFC \u05d4\u05d5\u05db\u05d7\u05d4 \u05db\u05de\u05e4\u05d7\u05d9\u05ea\u05d4 \u05ea\u05d5\u05e7\u05e4\u05e0\u05d5\u05ea \u05d0\u05d9\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05ea \u05d1-IED (DSM p.528, StahlKids p.208)."
        },
        {
          "text": "\u05e1\u05d8\u05d9\u05de\u05d5\u05dc\u05e0\u05d8\u05d9\u05dd \u05db\u05d2\u05d5\u05df Methylphenidate.",
          "isCorrect": false,
          "rationale": "\u05e1\u05d8\u05d9\u05de\u05d5\u05dc\u05e0\u05d8\u05d9\u05dd \u05de\u05d9\u05d5\u05e2\u05d3\u05d9\u05dd \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-ADHD \u05e0\u05dc\u05d5\u05d5\u05d4, \u05d0\u05da \u05d0\u05d9\u05e0\u05dd \u05e0\u05d7\u05e9\u05d1\u05d9\u05dd \u05dc\u05e7\u05d5 \u05e8\u05d0\u05e9\u05d5\u05df \u05e2\u05d1\u05d5\u05e8 \u05d4\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05d4\u05dc\u05d9\u05d1\u05ea\u05d9\u05d9\u05dd \u05e9\u05dc IED (Dulcan p.597)."
        },
        {
          "text": "\u05d1\u05e0\u05d6\u05d5\u05d3\u05d9\u05d0\u05d6\u05e4\u05d9\u05e0\u05d9\u05dd \u05d1\u05de\u05d9\u05e0\u05d5\u05df \u05e0\u05de\u05d5\u05da \u05db\u05d2\u05d5\u05df Lorazepam.",
          "isCorrect": false,
          "rationale": "\u05d1\u05e0\u05d6\u05d5\u05d3\u05d9\u05d0\u05d6\u05e4\u05d9\u05e0\u05d9\u05dd \u05e2\u05dc\u05d5\u05dc\u05d9\u05dd \u05dc\u05d2\u05e8\u05d5\u05dd \u05dc\u05d3\u05d9\u05e1\u05d9\u05e0\u05d4\u05d9\u05d1\u05d9\u05e6\u05d9\u05d4 \u05d5\u05dc\u05d4\u05d7\u05de\u05d9\u05e8 \u05d4\u05ea\u05e4\u05e8\u05e6\u05d5\u05d9\u05d5\u05ea \u05d0\u05dc\u05d9\u05de\u05d5\u05ea \u05d1\u05e7\u05e8\u05d1 \u05d4\u05e1\u05d5\u05d1\u05dc\u05d9\u05dd \u05de\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05e9\u05dc\u05d9\u05d8\u05d4 \u05d1\u05d3\u05d7\u05e4\u05d9\u05dd (StahlNeuro p.577)."
        },
        {
          "text": "\u05d0\u05e0\u05d8\u05d9-\u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9\u05d9\u05dd \u05d8\u05d9\u05e4\u05d5\u05e1\u05d9\u05d9\u05dd \u05db\u05d2\u05d5\u05df Haloperidol.",
          "isCorrect": false,
          "rationale": "\u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05d0\u05dc\u05d5 \u05e0\u05d5\u05e9\u05d0\u05d5\u05ea \u05e1\u05d9\u05db\u05d5\u05df \u05d2\u05d1\u05d5\u05d4 \u05dc-EPS \u05d5\u05d0\u05d9\u05e0\u05df \u05de\u05d5\u05de\u05dc\u05e6\u05d5\u05ea \u05db\u05e7\u05d5 \u05e8\u05d0\u05e9\u05d5\u05df \u05dc\u05e0\u05d9\u05d4\u05d5\u05dc \u05d0\u05e8\u05d5\u05da \u05d8\u05d5\u05d5\u05d7 \u05e9\u05dc IED (StahlKids p.465)."
        }
      ],
      "hint": "\u05d4\u05ea\u05de\u05e7\u05d3 \u05d1\u05de\u05d5\u05dc\u05d9\u05da \u05d4\u05e2\u05e6\u05d1\u05d9 \u05e9\u05e0\u05de\u05e6\u05d0 \u05d1\u05de\u05ea\u05d0\u05dd \u05d4\u05e4\u05d5\u05da \u05e2\u05dd \u05e8\u05de\u05d5\u05ea \u05d4\u05ea\u05d5\u05e7\u05e4\u05e0\u05d5\u05ea \u05d4\u05d0\u05d9\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05ea.",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05de\u05d8\u05d5\u05e4\u05dc \u05d1\u05df 10 \u05de\u05d0\u05d5\u05d1\u05d7\u05df \u05e2\u05dd ODD \u05d5-ADHD \u05de\u05e9\u05d5\u05dc\u05d1. \u05d4\u05e7\u05dc\u05d9\u05e0\u05d0\u05d9 \u05de\u05d7\u05dc\u05d9\u05d8 \u05dc\u05d4\u05ea\u05d7\u05d9\u05dc \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Guanfacine ER. \u05de\u05d4\u05d5 \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d3\u05e8\u05db\u05d5 \u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 \u05de\u05e9\u05e4\u05e8\u05ea \u05d0\u05ea \u05d4\u05e9\u05dc\u05d9\u05d8\u05d4 \u05d4\u05e2\u05e6\u05de\u05d9\u05ea \u05d5\u05de\u05e4\u05d7\u05d9\u05ea\u05d4 \u05d0\u05ea \u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e9\u05dc ODD \u05d1\u05de\u05e7\u05e8\u05d4 \u05d6\u05d4?",
      "answerOptions": [
        {
          "text": "\u05d0\u05d2\u05d5\u05e0\u05d9\u05d6\u05dd \u05e1\u05dc\u05e7\u05d8\u05d9\u05d1\u05d9 \u05dc\u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 $\\alpha_{2A}$ \u05d1-VMPFC \u05d4\u05de\u05e9\u05e4\u05e8 \u05d0\u05ea \u05d9\u05d7\u05e1 \u05d4-Signal-to-Noise.",
          "isCorrect": true,
          "rationale": "Guanfacine \u05e4\u05d5\u05e2\u05dc \u05db\u05d0\u05d2\u05d5\u05e0\u05d9\u05e1\u05d8 \u05e4\u05d5\u05e1\u05d8-\u05e1\u05d9\u05e0\u05e4\u05d8\u05d9 \u05dc\u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 $\\alpha_{2A}$ \u05d1-Prefrontal Cortex, \u05de\u05d4 \u05e9\u05de\u05d7\u05d6\u05e7 \u05d0\u05ea \u05d4-Top-down control (StahlNeuro p.453, 483)."
        },
        {
          "text": "\u05d7\u05e1\u05d9\u05de\u05d4 \u05e9\u05dc \u05d4\u05d8\u05e8\u05e0\u05e1\u05e4\u05d5\u05e8\u05d8\u05e8 DAT \u05d1-Striatum.",
          "isCorrect": false,
          "rationale": "\u05d6\u05d4\u05d5 \u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05e4\u05e2\u05d5\u05dc\u05d4 \u05e9\u05dc \u05e1\u05d8\u05d9\u05de\u05d5\u05dc\u05e0\u05d8\u05d9\u05dd \u05db\u05d2\u05d5\u05df Methylphenidate, \u05d5\u05dc\u05d0 \u05e9\u05dc Guanfacine (StahlNeuro p.33)."
        },
        {
          "text": "\u05d0\u05e0\u05d8\u05d2\u05d5\u05e0\u05d9\u05d6\u05dd \u05dc\u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 D2 \u05d1\u05de\u05e1\u05dc\u05d5\u05dc \u05d4\u05de\u05d6\u05d5\u05dc\u05d9\u05de\u05d1\u05d9.",
          "isCorrect": false,
          "rationale": "\u05d6\u05d4\u05d5 \u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05e4\u05e2\u05d5\u05dc\u05d4 \u05e9\u05dc \u05d0\u05e0\u05d8\u05d9-\u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9\u05d9\u05dd, \u05d4\u05de\u05e9\u05de\u05e9\u05d9\u05dd \u05d1\u05de\u05e7\u05e8\u05d9\u05dd \u05d7\u05de\u05d5\u05e8\u05d9\u05dd \u05d9\u05d5\u05ea\u05e8 \u05e9\u05dc \u05ea\u05d5\u05e7\u05e4\u05e0\u05d5\u05ea (Dulcan p.126)."
        },
        {
