{
  "title": "Psychiatry Flashcards",
  "cards": [
    {
      "front": "\u05de\u05d4\u05d5 \u05de\u05e9\u05da \u05d4\u05d6\u05de\u05df \u05d4\u05de\u05d9\u05e0\u05d9\u05de\u05dc\u05d9 \u05d4\u05e0\u05d3\u05e8\u05e9 \u05dc\u05d4\u05d5\u05e4\u05e2\u05ea \u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05dc\u05e6\u05d5\u05e8\u05da \u05d0\u05d1\u05d7\u05e0\u05ea Oppositional Defiant Disorder (ODD)?",
      "back": "\u05dc\u05e4\u05d7\u05d5\u05ea 6 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd (DSM p.522)."
    },
    {
      "front": "\u05db\u05de\u05d4 \u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05de\u05ea\u05d5\u05da \u05e8\u05e9\u05d9\u05de\u05ea \u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05e0\u05d3\u05e8\u05e9\u05d9\u05dd \u05dc\u05e6\u05d5\u05e8\u05da \u05d0\u05d1\u05d7\u05e0\u05ea ODD \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR?",
      "back": "\u05dc\u05e4\u05d7\u05d5\u05ea 4 \u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd (DSM p.522)."
    },
    {
      "front": "\u05db\u05d0\u05e9\u05e8 \u05de\u05d8\u05d5\u05e4\u05dc \u05e2\u05d5\u05e0\u05d4 \u05dc\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05e9\u05dc ODD \u05d5\u05d2\u05dd \u05dc\u05d0\u05dc\u05d5 \u05e9\u05dc Disruptive Mood Dysregulation Disorder (DMDD), \u05d0\u05d9\u05d6\u05d5 \u05d0\u05d1\u05d7\u05e0\u05d4 \u05ea\u05d9\u05e0\u05ea\u05df?",
      "back": "\u05ea\u05d9\u05e0\u05ea\u05df \u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc DMDD \u05d1\u05dc\u05d1\u05d3 (DSM p.523)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d9\u05d7\u05e1 \u05d4\u05e9\u05db\u05d9\u05d7\u05d5\u05ea (Prevalence) \u05d1\u05d9\u05df \u05d1\u05e0\u05d9\u05dd \u05dc\u05d1\u05e0\u05d5\u05ea \u05d1-ODD \u05dc\u05e4\u05e0\u05d9 \u05d2\u05d9\u05dc \u05d4\u05d4\u05ea\u05d1\u05d2\u05e8\u05d5\u05ea?",
      "back": "\u05d9\u05d7\u05e1 \u05e9\u05dc \u05db-$1.59:1$ \u05dc\u05d8\u05d5\u05d1\u05ea \u05d1\u05e0\u05d9\u05dd (DSM p.523)."
    },
    {
      "front": "\u05dc\u05e4\u05d9 \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df A1 \u05e9\u05dc Intermittent Explosive Disorder (IED), \u05de\u05d4\u05d9 \u05d4\u05ea\u05d3\u05d9\u05e8\u05d5\u05ea \u05d4\u05e0\u05d3\u05e8\u05e9\u05ea \u05dc\u05ea\u05d5\u05e7\u05e4\u05e0\u05d5\u05ea \u05de\u05d9\u05dc\u05d5\u05dc\u05d9\u05ea \u05d0\u05d5 \u05e4\u05d9\u05d6\u05d9\u05ea \u05de\u05ea\u05d5\u05e0\u05d4 \u05e9\u05d0\u05d9\u05e0\u05d4 \u05d2\u05d5\u05e8\u05de\u05ea \u05e0\u05d6\u05e7?",
      "back": "\u05d1\u05de\u05de\u05d5\u05e6\u05e2 \u05e4\u05e2\u05de\u05d9\u05d9\u05dd \u05d1\u05e9\u05d1\u05d5\u05e2 \u05d1\u05de\u05e9\u05da \u05ea\u05e7\u05d5\u05e4\u05d4 \u05e9\u05dc 3 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd (DSM p.527)."
    },
    {
      "front": "\u05dc\u05e4\u05d9 \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df A2 \u05e9\u05dc IED, \u05db\u05de\u05d4 \u05d4\u05ea\u05e4\u05e8\u05e6\u05d5\u05d9\u05d5\u05ea \u05d4\u05de\u05e2\u05e8\u05d1\u05d5\u05ea \u05e0\u05d6\u05e7 \u05dc\u05e8\u05db\u05d5\u05e9 \u05d0\u05d5 \u05e4\u05e6\u05d9\u05e2\u05d4 \u05e4\u05d9\u05d6\u05d9\u05ea \u05e0\u05d3\u05e8\u05e9\u05d5\u05ea \u05d1\u05ea\u05d5\u05da \u05ea\u05e7\u05d5\u05e4\u05d4 \u05e9\u05dc 12 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd?",
      "back": "\u05dc\u05e4\u05d7\u05d5\u05ea 3 \u05d4\u05ea\u05e4\u05e8\u05e6\u05d5\u05d9\u05d5\u05ea (DSM p.527)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05d2\u05d9\u05dc \u05d4\u05db\u05e8\u05d5\u05e0\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d4\u05de\u05d9\u05e0\u05d9\u05de\u05dc\u05d9 \u05d4\u05e0\u05d3\u05e8\u05e9 \u05dc\u05de\u05ea\u05df \u05d0\u05d1\u05d7\u05e0\u05ea IED?",
      "back": "\u05dc\u05e4\u05d7\u05d5\u05ea \u05d2\u05d9\u05dc 6 \u05e9\u05e0\u05d9\u05dd, \u05d0\u05d5 \u05e8\u05de\u05d4 \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9\u05ea \u05de\u05e7\u05d1\u05d9\u05dc\u05d4 (DSM p.527)."
    },
    {
      "front": "\u05d0\u05d9\u05dc\u05d5 \u05dc\u05d9\u05e7\u05d5\u05d9\u05d9\u05dd \u05d1\u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05e0\u05d5\u05d9\u05e8\u05d5\u05d8\u05e8\u05e0\u05e1\u05de\u05d9\u05d8\u05d5\u05e8\u05d9\u05dd \u05e0\u05de\u05e6\u05d0\u05d5 \u05db\u05e7\u05e9\u05d5\u05e8\u05d9\u05dd \u05dc-IED \u05d1\u05de\u05d7\u05e7\u05e8\u05d9\u05dd \u05e0\u05d5\u05d9\u05e8\u05d5\u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05d9\u05dd?",
      "back": "serotonergic abnormalities (\u05d7\u05e8\u05d9\u05d2\u05d5\u05ea \u05e1\u05e8\u05d5\u05d8\u05d5\u05e0\u05e8\u05d2\u05d9\u05d5\u05ea) \u05d2\u05dc\u05d5\u05d1\u05dc\u05d9\u05d5\u05ea \u05d5\u05d1\u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05dc\u05d9\u05de\u05d1\u05d9\u05ea (DSM p.528)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05de\u05e6\u05d1 \u05d4\u05e8\u05d2\u05e9\u05d9 \u05d4\u05e0\u05d3\u05e8\u05e9 \u05d4\u05de\u05e7\u05d3\u05d9\u05dd \u05d0\u05ea \u05d0\u05e7\u05d8 \u05d4\u05e6\u05ea\u05ea \u05d4\u05d0\u05e9 \u05d1-Pyromania?",
      "back": "Tension (\u05de\u05ea\u05d7) \u05d0\u05d5 \u05e2\u05d5\u05e8\u05e8\u05d5\u05ea \u05e8\u05d2\u05e9\u05d9\u05ea (affective arousal) \u05dc\u05e4\u05e0\u05d9 \u05d4\u05de\u05e2\u05e9\u05d4 (DSM p.537)."
    },
    {
      "front": "\u05d0\u05d9\u05dc\u05d5 \u05d0\u05d1\u05d7\u05e0\u05d5\u05ea \u05de\u05d4\u05d5\u05d5\u05ea Exclusion Criteria \u05e9\u05de\u05d5\u05e0\u05e2\u05d5\u05ea \u05d0\u05d1\u05d7\u05e0\u05ea Pyromania \u05d0\u05dd \u05d4\u05df \u05de\u05e1\u05d1\u05d9\u05e8\u05d5\u05ea \u05d8\u05d5\u05d1 \u05d9\u05d5\u05ea\u05e8 \u05d0\u05ea \u05d4\u05e6\u05ea\u05ea \u05d4\u05d0\u05e9?",
      "back": "Conduct Disorder, manic episode, \u05d0\u05d5 antisocial personality disorder (DSM p.537)."
    },
    {
      "front": "\u05de\u05d4 \u05de\u05d9\u05d9\u05d7\u05d3 \u05d0\u05ea \u05d4\u05d7\u05e4\u05e6\u05d9\u05dd \u05d4\u05e0\u05d2\u05e0\u05d1\u05d9\u05dd \u05d1-Kleptomania \u05dc\u05e2\u05d5\u05de\u05ea \u05d2\u05e0\u05d9\u05d1\u05d4 \u05e8\u05d2\u05d9\u05dc\u05d4 (Ordinary theft)?",
      "back": "\u05d4\u05d7\u05e4\u05e6\u05d9\u05dd \u05d0\u05d9\u05e0\u05dd \u05d3\u05e8\u05d5\u05e9\u05d9\u05dd \u05dc\u05e9\u05d9\u05de\u05d5\u05e9 \u05d0\u05d9\u05e9\u05d9 \u05d5\u05d0\u05d9\u05e0\u05dd \u05e0\u05d2\u05e0\u05d1\u05d9\u05dd \u05d1\u05e9\u05dc \u05e2\u05e8\u05db\u05dd \u05d4\u05de\u05d5\u05e0\u05d9\u05d8\u05e8\u05d9 (DSM p.539)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d9\u05d7\u05e1 \u05d4\u05de\u05d2\u05d3\u05e8 \u05d4\u05de\u05e7\u05d5\u05d1\u05dc \u05d1\u05d0\u05d1\u05d7\u05e0\u05ea Kleptomania \u05d1\u05d0\u05d5\u05db\u05dc\u05d5\u05e1\u05d9\u05d9\u05d4 \u05d4\u05db\u05dc\u05dc\u05d9\u05ea?",
      "back": "\u05e0\u05e9\u05d9\u05dd \u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d9\u05d5\u05ea\u05e8 \u05de\u05d2\u05d1\u05e8\u05d9\u05dd \u05d1\u05d9\u05d7\u05e1 \u05e9\u05dc $3:1$ (DSM p.540)."
    },
    {
      "front": "\u05dc\u05e4\u05d9 StahlNeuro, \u05d0\u05d9\u05dc\u05d5 \u05d0\u05d6\u05d5\u05e8\u05d9\u05dd \u05de\u05d5\u05d7\u05d9\u05d9\u05dd \u05de\u05e2\u05d5\u05e8\u05d1\u05d9\u05dd \u05d1-Impulsivity \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05ea \u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05db\u05de\u05d5 IED \u05d5-ADHD?",
      "back": "\u05de\u05e2\u05d2\u05dc\u05d9\u05dd \u05d4\u05db\u05d5\u05dc\u05dc\u05d9\u05dd \u05d0\u05ea \u05d4-ACC, \u05d4-VMPFC \u05d5\u05d4-ventral striatum (StahlNeuro p.540)."
    },
    {
      "front": "\u05dc\u05e4\u05d9 Dulcan, \u05de\u05d4\u05d5 \u05e1\u05d5\u05d2 \u05d4\u05d4\u05ea\u05e2\u05e8\u05d1\u05d5\u05ea \u05d4\u05de\u05e0\u05d9\u05e2\u05ea\u05d9\u05ea \u05d1\u05e2\u05dc\u05ea \u05d4\u05e8\u05d0\u05d9\u05d5\u05ea \u05d4\u05d7\u05d6\u05e7\u05d5\u05ea \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05de\u05e0\u05d9\u05e2\u05ea \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d4\u05ea\u05e0\u05d2\u05d3\u05d5\u05ea\u05d9\u05ea \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d1\u05e1\u05d9\u05db\u05d5\u05df?",
      "back": "parent group training (\u05d4\u05d3\u05e8\u05db\u05ea \u05d4\u05d5\u05e8\u05d9\u05dd \u05e7\u05d1\u05d5\u05e6\u05ea\u05d9\u05ea) (Dulcan p.202)."
    },
    {
      "front": "\u05d0\u05d9\u05d6\u05d4 \u05d4\u05d5\u05e8\u05de\u05d5\u05df \u05d0\u05d3\u05e8\u05e0\u05dc\u05d9 \u05e0\u05de\u05e6\u05d0 \u05d1\u05e8\u05de\u05d4 \u05d2\u05d1\u05d5\u05d4\u05d4 \u05d9\u05d5\u05ea\u05e8 \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd ODD \u05d1\u05d4\u05e9\u05d5\u05d5\u05d0\u05d4 \u05dc\u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd ADHD?",
      "back": "dehydroepiandrosterone sulfate (DHEAS) (Dulcan p.201)."
    },
    {
      "front": "\u05d1\u05e7\u05e8\u05d1 \u05d9\u05dc\u05d3\u05d9\u05dd \u05d5\u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd \u05d1\u05d2\u05d9\u05dc\u05d0\u05d9 6-18, \u05d1\u05d0\u05d9\u05dc\u05d5 \u05e0\u05e1\u05d9\u05d1\u05d5\u05ea \u05d0\u05d9\u05df \u05dc\u05ea\u05ea \u05d0\u05d1\u05d7\u05e0\u05ea IED \u05d2\u05dd \u05d0\u05dd \u05e7\u05d9\u05d9\u05de\u05d5\u05ea \u05d4\u05ea\u05e4\u05e8\u05e6\u05d5\u05d9\u05d5\u05ea \u05d0\u05d2\u05e8\u05e1\u05d9\u05d1\u05d9\u05d5\u05ea?",
      "back": "\u05db\u05d0\u05e9\u05e8 \u05d4\u05d4\u05ea\u05e4\u05e8\u05e6\u05d5\u05d9\u05d5\u05ea \u05de\u05ea\u05e8\u05d7\u05e9\u05d5\u05ea \u05d1\u05d4\u05e7\u05e9\u05e8 \u05e9\u05dc adjustment disorder (DSM p.528)."
    },
    {
      "front": "\u05d0\u05d9\u05dc\u05d5 \u05e9\u05dc\u05d5\u05e9\u05d4 \u05d0\u05e9\u05db\u05d5\u05dc\u05d5\u05ea \u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05de\u05e8\u05db\u05d9\u05d1\u05d9\u05dd \u05d0\u05ea \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df A \u05d1\u05d0\u05d1\u05d7\u05e0\u05ea ODD?",
      "back": "Angry/Irritable Mood, Argumentative/Defiant Behavior, \u05d5-Vindictiveness (DSM p.522)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05dc\u05d0\u05d5\u05e8\u05da \u05d4\u05d7\u05d9\u05d9\u05dd (Lifetime prevalence) \u05e9\u05dc IED \u05d1\u05d0\u05d5\u05db\u05dc\u05d5\u05e1\u05d9\u05d9\u05ea \u05d0\u05e8\u05d4\"\u05d1?",
      "back": "\u05db-4.0% (DSM p.528)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05db\u05dc\u05dc \u05d4\u05d4\u05d9\u05e8\u05e8\u05db\u05d9 \u05d1\u05d0\u05d1\u05d7\u05e0\u05d4 \u05de\u05d1\u05d3\u05dc\u05ea \u05d1\u05d9\u05df IED \u05dc\u05d1\u05d9\u05df DMDD?",
      "back": "\u05d0\u05dd \u05e7\u05d9\u05d9\u05de\u05ea \u05e8\u05d2\u05d6\u05e0\u05d5\u05ea \u05de\u05ea\u05de\u05e9\u05db\u05ea \u05d1\u05d9\u05df \u05d4\u05d4\u05ea\u05e4\u05e8\u05e6\u05d5\u05d9\u05d5\u05ea, \u05ea\u05d9\u05e0\u05ea\u05df \u05d0\u05d1\u05d7\u05e0\u05ea DMDD \u05d1\u05dc\u05d1\u05d3 (DSM p.529)."
    },
    {
      "front": "\u05dc\u05e4\u05d9 Dulcan, \u05d0\u05d9\u05d6\u05d4 \u05d0\u05e0\u05d6\u05d9\u05dd \u05d4\u05de\u05e2\u05d5\u05e8\u05d1 \u05d1\u05de\u05d8\u05d1\u05d5\u05dc\u05d9\u05d6\u05dd \u05e9\u05dc \u05e0\u05d5\u05d9\u05e8\u05d5\u05d8\u05e8\u05e0\u05e1\u05de\u05d9\u05d8\u05d5\u05e8\u05d9\u05dd \u05e7\u05e9\u05d5\u05e8 \u05dc\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea CD \u05d1\u05e7\u05e8\u05d1 \u05d1\u05e0\u05d9\u05dd \u05e9\u05e2\u05d1\u05e8\u05d5 \u05d4\u05ea\u05e2\u05dc\u05dc\u05d5\u05ea?",
      "back": "monoamine oxidase A (MAOA) (Dulcan p.208)."
    }
  ]
}