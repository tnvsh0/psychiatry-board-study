{
  "title": "Attachment Flashcards",
  "cards": [
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05d9\u05ea\u05e8\u05d5\u05df \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05d1\u05e9\u05de\u05d9\u05e8\u05d4 \u05e2\u05dc secure attachment \u05d1\u05e9\u05e0\u05d4 \u05d4\u05e8\u05d0\u05e9\u05d5\u05e0\u05d4 \u05dc\u05d7\u05d9\u05d9\u05dd \u05de\u05d1\u05d7\u05d9\u05e0\u05ea \u05d5\u05d9\u05e1\u05d5\u05ea \u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9?",
      "back": "\u05ea\u05d9\u05e0\u05d5\u05e7\u05d5\u05ea \u05d0\u05dc\u05d5 \u05e0\u05d5\u05d8\u05d9\u05dd \u05dc\u05d4\u05e8\u05d0\u05d5\u05ea \u05d3\u05e4\u05d5\u05e1\u05d9 \u05d5\u05d9\u05e1\u05d5\u05ea \u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05de\u05d0\u05d5\u05d6\u05e0\u05d9\u05dd \u05d9\u05d5\u05ea\u05e8 \u05e9\u05dc \u05ea\u05d2\u05d5\u05d1\u05ea\u05d9\u05d5\u05ea \u05dc\u05d3\u05d7\u05e7 (biological stress reactivity patterns) (Dulcan p. 18)."
    },
    {
      "front": "\u05d1\u05de\u05e1\u05d2\u05e8\u05ea \u05d4-Strange Situation, \u05d0\u05d9\u05d6\u05d4 \u05de\u05d9\u05d3\u05e2 \u05e0\u05d7\u05e9\u05d1 \u05dc\u05de\u05e9\u05e7\u05e3 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d0\u05ea \u05d0\u05d9\u05db\u05d5\u05ea \u05d4-attachment?",
      "back": "\u05d4\u05d9\u05db\u05d5\u05dc\u05ea \u05e9\u05dc \u05d4\u05d3\u05d9\u05d0\u05d3\u05d4 (\u05d4\u05d5\u05e8\u05d4-\u05d9\u05dc\u05d3) \u05dc\u05e4\u05ea\u05d5\u05e8 \u05d0\u05ea \u05de\u05e6\u05d5\u05e7\u05ea \u05d4\u05e4\u05e8\u05d9\u05d3\u05d4 \u05d9\u05d7\u05d3 \u05d1\u05de\u05d4\u05dc\u05da \u05d4-reunion (Dulcan p. 30)."
    },
    {
      "front": "\u05d4\u05d2\u05d3\u05e8 \u05d0\u05ea \u05d4\u05de\u05d5\u05e9\u05d2 Mentalization \u05dc\u05e4\u05d9 \u05d4\u05de\u05d9\u05dc\u05d5\u05df \u05e9\u05dc Dulcan.",
      "back": "\u05d4\u05d9\u05db\u05d5\u05dc\u05ea \u05dc\u05d1\u05e6\u05e2 \u05e8\u05e4\u05dc\u05e7\u05e6\u05d9\u05d4 \u05d5\u05dc\u05d4\u05d7\u05d6\u05d9\u05e7 \u05d1\u05de\u05d5\u05d3\u05e2\u05d5\u05ea \u05dc\u05de\u05e6\u05d1\u05d9\u05dd \u05d4\u05de\u05e0\u05d8\u05dc\u05d9\u05d9\u05dd (\u05e8\u05d2\u05e9\u05d5\u05ea, \u05de\u05d7\u05e9\u05d1\u05d5\u05ea, \u05d0\u05de\u05d5\u05e0\u05d5\u05ea) \u05e9\u05dc \u05d4\u05e2\u05e6\u05de\u05d9 \u05d5\u05e9\u05dc \u05d0\u05d7\u05e8\u05d9\u05dd (Dulcan p. 848)."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05de\u05d1\u05d7\u05d9\u05df \u05d4-DSM-5-TR \u05d1\u05d9\u05df Reactive Attachment Disorder (RAD) \u05dc\u05d1\u05d9\u05df ASD \u05d1\u05e0\u05d5\u05d2\u05e2 \u05dc\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d4\u05ea\u05e7\u05e9\u05e8\u05d5\u05ea?",
      "back": "\u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd ASD \u05dc\u05e8\u05d5\u05d1 \u05de\u05e8\u05d0\u05d9\u05dd \u05d4\u05ea\u05e7\u05e9\u05e8\u05d5\u05ea \u05d8\u05d9\u05e4\u05d5\u05e1\u05d9\u05ea \u05dc\u05e8\u05de\u05ea\u05dd, \u05d1\u05e2\u05d5\u05d3 \u05e9\u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd RAD \u05de\u05e8\u05d0\u05d9\u05dd \u05d4\u05ea\u05e7\u05e9\u05e8\u05d5\u05ea \u05e1\u05dc\u05e7\u05d8\u05d9\u05d1\u05d9\u05ea \u05e8\u05e7 \u05dc\u05e2\u05d9\u05ea\u05d9\u05dd \u05e0\u05d3\u05d9\u05e8\u05d5\u05ea \u05d0\u05d5 \u05d1\u05d0\u05d5\u05e4\u05df \u05dc\u05d0 \u05e2\u05e7\u05d1\u05d9 (DSM-5-TR p. 298)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4-essential feature \u05e9\u05dc Borderline Personality Disorder (BPD) \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR?",
      "back": "\u05d3\u05e4\u05d5\u05e1 \u05e0\u05e8\u05d7\u05d1 \u05e9\u05dc \u05d7\u05d5\u05e1\u05e8 \u05d9\u05e6\u05d9\u05d1\u05d5\u05ea \u05d1\u05d9\u05d7\u05e1\u05d9\u05dd \u05d1\u05d9\u05df-\u05d0\u05d9\u05e9\u05d9\u05d9\u05dd, \u05d1\u05d3\u05d9\u05de\u05d5\u05d9 \u05d4\u05e2\u05e6\u05de\u05d9 \u05d5\u05d1\u05d0\u05e4\u05e7\u05d8, \u05d9\u05d7\u05d3 \u05e2\u05dd \u05d0\u05d9\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05d5\u05ea \u05e0\u05d9\u05db\u05e8\u05ea (DSM-5-TR p. 738)."
    },
    {
      "front": "\u05d0\u05d9\u05dc\u05d5 \u05e9\u05dc\u05d5\u05e9\u05d4 \u05e1\u05d5\u05d2\u05d9 insecure attachment \u05de\u05d6\u05d5\u05d4\u05d9\u05dd \u05e2\u05dd \u05d4\u05d5\u05e8\u05d5\u05ea \u05dc\u05d0 \u05e8\u05d2\u05d9\u05e9\u05d4 \u05d0\u05d5 \u05dc\u05d0 \u05de\u05d2\u05d9\u05d1\u05d4?",
      "back": "Anxious/avoidant, anxious/ambivalent \u05d5-disorganized attachment (Dulcan p. 525)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05d4\u05d1\u05d3\u05dc \u05d4\u05de\u05d4\u05d5\u05ea\u05d9 \u05d1\u05d9\u05df \u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05e9\u05dc DSED \u05dc\u05d1\u05d9\u05df \u05d0\u05d9\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05d5\u05ea \u05e9\u05dc ADHD?",
      "back": "\u05d4\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05d9\u05d5\u05ea \u05d1-DSED \u05db\u05d5\u05dc\u05dc\u05d5\u05ea \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d7\u05d1\u05e8\u05ea\u05d9\u05ea \u05d7\u05e1\u05e8\u05ea \u05e2\u05db\u05d1\u05d5\u05ea (socially disinhibited behavior) \u05d5\u05d0\u05d9\u05e0\u05df \u05de\u05d5\u05d2\u05d1\u05dc\u05d5\u05ea \u05e8\u05e7 \u05dc\u05d0\u05d9\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05d5\u05ea (DSM-5-TR p. 300)."
    },
    {
      "front": "\u05dc\u05e4\u05d9 \u05de\u05d7\u05e7\u05e8\u05d9\u05dd \u05d4\u05de\u05d5\u05d6\u05db\u05e8\u05d9\u05dd \u05d1-Dulcan, \u05db\u05d9\u05e6\u05d3 secure attachment \u05de\u05e9\u05e4\u05d9\u05e2\u05d4 \u05e2\u05dc \u05e8\u05de\u05ea \u05d4\u05e7\u05d5\u05e8\u05d8\u05d9\u05d6\u05d5\u05dc \u05e9\u05dc \u05e4\u05e2\u05d5\u05d8\u05d5\u05ea \u05d1\u05de\u05e6\u05d1\u05d9 \u05e4\u05d7\u05d3?",
      "back": "\u05d4\u05d9\u05d0 \u05de\u05e9\u05de\u05e9\u05ea \u05db\u05d7\u05d9\u05e5 (buffer) \u05d4\u05de\u05d5\u05e8\u05d9\u05d3 \u05d0\u05ea \u05e8\u05de\u05d5\u05ea \u05d4\u05e7\u05d5\u05e8\u05d8\u05d9\u05d6\u05d5\u05dc \u05d3\u05e8\u05da down-regulation \u05e9\u05dc \u05e6\u05d9\u05e8 \u05d4-HPA (Dulcan p. 525)."
    },
    {
      "front": "\u05ea\u05d7\u05ea '\u05de\u05d5\u05d3\u05dc \u05d4\u05d0\u05d9\u05e9\u05d9\u05d5\u05ea \u05d4\u05d0\u05dc\u05d8\u05e8\u05e0\u05d8\u05d9\u05d1\u05d9', \u05db\u05d9\u05e6\u05d3 \u05de\u05ea\u05d1\u05d8\u05d0 \u05dc\u05d9\u05e7\u05d5\u05d9 \u05d1-mentalization \u05d1\u05e7\u05e8\u05d1 \u05d4\u05e1\u05d5\u05d1\u05dc\u05d9\u05dd \u05de-BPD (\u05e8\u05de\u05ea \u05ea\u05e4\u05e7\u05d5\u05d3 3)?",
      "back": "\u05e7\u05d9\u05d9\u05de\u05ea \u05d9\u05db\u05d5\u05dc\u05ea \u05de\u05d5\u05d2\u05d1\u05dc\u05ea \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05dc\u05d4\u05d1\u05d9\u05df \u05e8\u05d2\u05e9\u05d5\u05ea \u05d5\u05db\u05d5\u05d5\u05e0\u05d5\u05ea \u05e9\u05dc \u05d0\u05d7\u05e8\u05d9\u05dd, \u05e2\u05dd \u05e0\u05d8\u05d9\u05d9\u05d4 \u05dc\u05d9\u05d9\u05d7\u05e1 \u05dc\u05d0\u05d7\u05e8\u05d9\u05dd \u05de\u05d5\u05d8\u05d9\u05d1\u05e6\u05d9\u05d5\u05ea \u05d4\u05e8\u05e1\u05e0\u05d9\u05d5\u05ea (DSM-5-TR p. 898)."
    },
    {
      "front": "\u05de\u05d4 \u05d1\u05d5\u05d3\u05e7\u05ea \u05e4\u05e8\u05d5\u05e6\u05d3\u05d5\u05e8\u05ea \u05d4-still-face paradigm \u05d1\u05d0\u05d9\u05e0\u05d8\u05e8\u05d0\u05e7\u05e6\u05d9\u05d4 \u05d1\u05d9\u05df \u05d4\u05d5\u05e8\u05d4 \u05dc\u05ea\u05d9\u05e0\u05d5\u05e7?",
      "back": "\u05d4\u05d9\u05d0 \u05d1\u05d5\u05d3\u05e7\u05ea \u05d0\u05ea \u05d9\u05db\u05d5\u05dc\u05d5\u05ea \u05d4\u05d5\u05d5\u05d9\u05e1\u05d5\u05ea \u05d4\u05d4\u05d3\u05d3\u05d9\u05d5\u05ea (mutual regulatory capacities) \u05e9\u05dc \u05d4\u05d3\u05d9\u05d0\u05d3\u05d4 (Dulcan p. 30)."
    },
    {
      "front": "\u05de\u05d4\u05dd \u05e9\u05dc\u05d5\u05e9\u05ea \u05e1\u05d5\u05d2\u05d9 \u05d4-core sensitivity \u05e9\u05e0\u05d9\u05ea\u05df \u05dc\u05d6\u05d4\u05d5\u05ea \u05d1\u05d0\u05de\u05e6\u05e2\u05d5\u05ea \u05d4-Circle of Security Interview?",
      "back": "Esteem sensitive, safety sensitive \u05d5-separation sensitive (Dulcan p. 30)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05d2\u05d9\u05dc \u05d4\u05de\u05d9\u05e0\u05d9\u05de\u05dc\u05d9 (\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9) \u05d4\u05e0\u05d3\u05e8\u05e9 \u05dc\u05d0\u05d1\u05d7\u05d5\u05df RAD \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR?",
      "back": "9 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd (DSM-5-TR p. 296)."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05e0\u05e8\u05d0\u05d9\u05dd frantic efforts \u05dc\u05de\u05e0\u05d9\u05e2\u05ea \u05e0\u05d8\u05d9\u05e9\u05d4 \u05d1-BPD \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR?",
      "back": "\u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd \u05e2\u05de\u05d5\u05e7\u05d9\u05dd \u05d1\u05d3\u05d9\u05de\u05d5\u05d9 \u05d4\u05e2\u05e6\u05de\u05d9, \u05d1\u05d0\u05e4\u05e7\u05d8 \u05d5\u05d1\u05e7\u05d5\u05d2\u05e0\u05d9\u05e6\u05d9\u05d4, \u05d4\u05db\u05d5\u05dc\u05dc\u05d9\u05dd \u05dc\u05e2\u05d9\u05ea\u05d9\u05dd \u05db\u05e2\u05e1 \u05dc\u05d0 \u05d4\u05d5\u05dc\u05dd \u05d0\u05d5 \u05e4\u05e2\u05d5\u05dc\u05d5\u05ea \u05d0\u05d9\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05d5\u05ea \u05db\u05de\u05d5 \u05e4\u05d2\u05d9\u05e2\u05d4 \u05e2\u05e6\u05de\u05d9\u05ea (DSM-5-TR p. 738)."
    },
    {
      "front": "\u05d4\u05e2\u05e8\u05db\u05d4 \u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05de\u05e1\u05d5\u05d2 Insightfulness Assessment (IA) \u05de\u05d5\u05d3\u05d3\u05ea \u05d0\u05ea \u05d9\u05db\u05d5\u05dc\u05ea \u05d4\u05d4\u05d5\u05e8\u05d4 \u05dc\u05d1\u05e6\u05e2 _____.",
      "back": "\u05d0\u05d9\u05de\u05d5\u05e5 \u05e0\u05e7\u05d5\u05d3\u05ea \u05d4\u05de\u05d1\u05d8 \u05e9\u05dc \u05d4\u05ea\u05d9\u05e0\u05d5\u05e7 (taking the infant's perspective) (Dulcan p. 30)."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05de\u05d5\u05d2\u05d3\u05e8 \u05d4-holding environment \u05dc\u05e4\u05d9 \u05ea\u05d9\u05d0\u05d5\u05e8\u05d9\u05d9\u05ea \u05d4\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea \u05d5\u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05e9\u05dc Winnicott?",
      "back": "\u05de\u05ea\u05df \u05d4\u05e7\u05e9\u05e8 \u05d7\u05d1\u05e8\u05ea\u05d9 \u05d1\u05d8\u05d5\u05d7 \u05d5\u05de\u05e1\u05e4\u05e7 \u05e6\u05e8\u05db\u05d9\u05dd \u05d4\u05de\u05d0\u05e4\u05e9\u05e8 \u05dc\u05ea\u05d9\u05e0\u05d5\u05e7 \u05d5\u05dc\u05d9\u05dc\u05d3 \u05dc\u05d4\u05ea\u05e4\u05ea\u05d7 (Dulcan p. 937)."
    },
    {
      "front": "\u05d1\u05d0\u05d1\u05d7\u05e0\u05d4 \u05de\u05d1\u05d3\u05dc\u05ea, \u05de\u05d4 \u05de\u05d1\u05d7\u05d9\u05df \u05d1\u05d9\u05df Separation Anxiety Disorder \u05dc\u05d1\u05d9\u05df BPD?",
      "back": "\u05d1-BPD \u05d4\u05e4\u05d7\u05d3 \u05de\u05e0\u05d8\u05d9\u05e9\u05d4 \u05de\u05dc\u05d5\u05d5\u05d4 \u05d1\u05d1\u05e2\u05d9\u05d5\u05ea \u05de\u05e8\u05db\u05d6\u05d9\u05d5\u05ea \u05d1\u05d6\u05d4\u05d5\u05ea, \u05d1\u05ea\u05e4\u05e7\u05d5\u05d3 \u05d1\u05d9\u05df-\u05d0\u05d9\u05e9\u05d9 \u05d5\u05d1\u05d0\u05d9\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05d5\u05ea (DSM-5-TR p. 217)."
    },
    {
      "front": "\u05de\u05d3\u05d5\u05e2 \u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd \u05e2\u05dd ASD \u05d0\u05d5 \u05dc\u05d9\u05e7\u05d5\u05d9\u05d9\u05dd \u05e7\u05e9\u05d9\u05dd \u05d1\u05db\u05d9\u05e9\u05d5\u05e8\u05d9\u05dd \u05d7\u05d1\u05e8\u05ea\u05d9\u05d9\u05dd \u05d0\u05d9\u05e0\u05dd \u05de\u05ea\u05d0\u05d9\u05de\u05d9\u05dd \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc IPT-A?",
      "back": "\u05db\u05d9 \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05de\u05e0\u05d9\u05d7 \u05e7\u05d9\u05d5\u05dd \u05db\u05d9\u05e9\u05d5\u05e8\u05d9\u05dd \u05d1\u05e1\u05d9\u05e1\u05d9\u05d9\u05dd \u05d5\u05e9\u05d5\u05d0\u05e3 \u05dc\u05d1\u05e0\u05d5\u05ea \u05e2\u05dc\u05d9\u05d4\u05dd \u05d1\u05e4\u05e8\u05e7 \u05d6\u05de\u05df \u05e7\u05e6\u05e8 (12 \u05e9\u05d1\u05d5\u05e2\u05d5\u05ea) (Dulcan p. 966)."
    },
    {
