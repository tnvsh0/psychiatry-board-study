      "rationale": "\u05d4\u05ea\u05e8\u05e1\u05d9\u05e1 \u05d4\u05d0\u05e4\u05d9 \u05e0\u05d0\u05e1\u05e8 \u05dc\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05d4\u05ea\u05d5\u05d5\u05d9\u05d4 \u05d6\u05d5 \u05e2\u05e7\u05d1 \u05d6\u05de\u05d9\u05e0\u05d5\u05ea \u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea \u05de\u05e9\u05ea\u05e0\u05d4 \u05d5\u05d6\u05de\u05df \u05de\u05d7\u05e6\u05d9\u05ea \u05d7\u05d9\u05d9\u05dd \u05de\u05de\u05d5\u05e9\u05da \u05e9\u05d4\u05d5\u05d1\u05d9\u05dc\u05d5 \u05dc\u05de\u05e7\u05e8\u05d9 \u05de\u05d5\u05d5\u05ea \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd (Dulcan p.463, 470).",
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05e6\u05d5\u05e8\u05ea \u05d4\u05de\u05ea\u05df \u05e9\u05d4\u05d5\u05d7\u05dc\u05e4\u05d4 \u05d1\u05d8\u05d1\u05dc\u05d9\u05d5\u05ea \u05d1\u05dc\u05d9\u05e2\u05d4 \u05d0\u05d5 \u05d1\u05e4\u05d5\u05e8\u05de\u05d5\u05dc\u05e6\u05d9\u05d9\u05ea MELT."
    },
    {
      "type": "multiple_select",
      "question": "\u05e4\u05e8\u05d5\u05d8\u05d5\u05e7\u05d5\u05dc Levine & Bakow \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Retentive Encopresis \u05db\u05d5\u05dc\u05dc \u05de\u05e1\u05e4\u05e8 \u05e9\u05dc\u05d1\u05d9\u05dd \u05e7\u05e8\u05d9\u05d8\u05d9\u05d9\u05dd. \u05d0\u05d9\u05dc\u05d5 \u05de\u05d4\u05e8\u05db\u05d9\u05d1\u05d9\u05dd \u05d4\u05d1\u05d0\u05d9\u05dd \u05d4\u05dd \u05d7\u05dc\u05e7 \u05d4\u05db\u05e8\u05d7\u05d9 \u05de\u05d4\u05e4\u05e8\u05d5\u05d8\u05d5\u05e7\u05d5\u05dc \u05d4\u05de\u05e9\u05d5\u05dc\u05d1?",
      "answerOptions": [
        {
          "text": "\u05e9\u05dc\u05d1 \u05e4\u05d9\u05e0\u05d5\u05d9 (Cleanout) \u05d0\u05d2\u05e8\u05e1\u05d9\u05d1\u05d9 \u05e9\u05dc \u05d2\u05d5\u05e9 \u05d4\u05e6\u05d5\u05d0\u05d4 (Fecal impaction).",
          "isCorrect": true,
          "rationale": "\u05d6\u05d4\u05d5 \u05d4\u05e6\u05e2\u05d3 \u05d4\u05e8\u05d0\u05e9\u05d5\u05df \u05d4\u05d4\u05db\u05e8\u05d7\u05d9 \u05dc\u05d4\u05e7\u05dc\u05d4 \u05e2\u05dc \u05d4-Rectal Distension \u05d5\u05dc\u05d0\u05e4\u05e9\u05e8 \u05dc\u05de\u05e2\u05d9 \u05dc\u05d7\u05d6\u05d5\u05e8 \u05dc\u05ea\u05e4\u05e7\u05d5\u05d3 (Dulcan p.468, 470)."
        },
        {
          "text": "\u05d8\u05d9\u05e4\u05d5\u05dc \u05d0\u05d7\u05d6\u05e7\u05ea\u05d9 \u05de\u05de\u05d5\u05e9\u05da \u05d1\u05de\u05e8\u05db\u05db\u05d9 \u05e6\u05d5\u05d0\u05d4 \u05d0\u05d5 \u05de\u05e9\u05dc\u05e9\u05dc\u05d9\u05dd \u05d0\u05d5\u05e1\u05de\u05d5\u05d8\u05d9\u05d9\u05dd (PEG).",
          "isCorrect": true,
          "rationale": "\u05d8\u05d9\u05e4\u05d5\u05dc \u05d6\u05d4 \u05e0\u05d3\u05e8\u05e9 \u05dc\u05de\u05e9\u05da \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05db\u05d3\u05d9 \u05dc\u05de\u05e0\u05d5\u05e2 \u05d4\u05e6\u05d8\u05d1\u05e8\u05d5\u05ea \u05d7\u05d5\u05d6\u05e8\u05ea \u05d5\u05dc\u05d0\u05e4\u05e9\u05e8 \u05dc\u05d3\u05d5\u05e4\u05df \u05d4\u05e8\u05e7\u05d8\u05d5\u05dd \u05dc\u05d4\u05e9\u05d9\u05d1 \u05d0\u05ea \u05d4\u05ea\u05d7\u05d5\u05e9\u05ea\u05d9\u05d5\u05ea (Dulcan p.468)."
        },
        {
          "text": "\u05d9\u05e9\u05d9\u05d1\u05d4 \u05de\u05ea\u05d5\u05d6\u05de\u05e0\u05ea \u05d1\u05e9\u05d9\u05e8\u05d5\u05ea\u05d9\u05dd (Timed Toilet Sitting) \u05dc\u05d0\u05d7\u05e8 \u05d0\u05e8\u05d5\u05d7\u05d5\u05ea.",
          "isCorrect": true,
          "rationale": "\u05e0\u05d9\u05e6\u05d5\u05dc \u05d4-Gastrocolic reflex \u05d4\u05d5\u05d0 \u05e8\u05db\u05d9\u05d1 \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea\u05d9 \u05de\u05e8\u05db\u05d6\u05d9 \u05dc\u05d1\u05d9\u05e1\u05d5\u05e1 \u05d4\u05e8\u05d2\u05dc\u05d9 \u05d4\u05ea\u05e8\u05d5\u05e7\u05e0\u05d5\u05ea \u05ea\u05e7\u05d9\u05e0\u05d9\u05dd (Dulcan p.468)."
        },
        {
          "text": "\u05de\u05ea\u05df \u05d7\u05d9\u05d6\u05d5\u05e7\u05d9\u05dd \u05d7\u05d9\u05d5\u05d1\u05d9\u05d9\u05dd (Rewards) \u05e2\u05dc \u05e2\u05e6\u05dd \u05d4\u05e6\u05dc\u05d7\u05ea \u05d4\u05d4\u05ea\u05e8\u05d5\u05e7\u05e0\u05d5\u05ea \u05d1\u05e9\u05d9\u05e8\u05d5\u05ea\u05d9\u05dd.",
          "isCorrect": false,
          "rationale": "\u05d4\u05d7\u05d9\u05d6\u05d5\u05e7\u05d9\u05dd \u05e6\u05e8\u05d9\u05db\u05d9\u05dd \u05dc\u05d4\u05d9\u05e0\u05ea\u05df \u05e2\u05dc \u05d4\u05e9\u05d9\u05ea\u05d5\u05e3 \u05e4\u05e2\u05d5\u05dc\u05d4 \u05d5\u05d4\u05d9\u05e9\u05d9\u05d1\u05d4 \u05e2\u05e6\u05de\u05d4, \u05d5\u05dc\u05d0 \u05e2\u05dc \u05d4\u05ea\u05d5\u05e6\u05d0\u05d4, \u05db\u05d3\u05d9 \u05dc\u05de\u05e0\u05d5\u05e2 \u05de\u05d0\u05d1\u05e7\u05d9 \u05db\u05d5\u05d7 (Dulcan p.468)."
        }
      ],
      "hint": "\u05d4\u05e4\u05e8\u05d5\u05d8\u05d5\u05e7\u05d5\u05dc \u05de\u05e9\u05dc\u05d1 \u05d2\u05d9\u05e9\u05d4 \u05e4\u05d9\u05d6\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea (\u05e0\u05d9\u05e7\u05d5\u05d9 \u05d5\u05d0\u05d7\u05d6\u05e7\u05d4) \u05e2\u05dd \u05d2\u05d9\u05e9\u05d4 \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea\u05d9\u05ea \u05de\u05d5\u05d1\u05e0\u05d9\u05ea.",
      "hasAllOfTheAbove": false,
