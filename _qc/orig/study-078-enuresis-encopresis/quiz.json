        },
        {
          "text": "\u05d0\u05d9\u05e1\u05d5\u05e3 \u05e9\u05ea\u05df \u05dc-24 \u05e9\u05e2\u05d5\u05ea \u05dc\u05e8\u05de\u05ea Creatinine.",
