{
  "title": "Elimination Quiz",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\u05d9\u05dc\u05d3 \u05d1\u05df 6 \u05de\u05d5\u05d1\u05d0 \u05dc\u05d4\u05e2\u05e8\u05db\u05d4 \u05e2\u05e7\u05d1 \u05d4\u05d8\u05dc\u05ea \u05e9\u05ea\u05df \u05dc\u05d9\u05dc\u05d9\u05ea \u05db-3 \u05e4\u05e2\u05de\u05d9\u05dd \u05d1\u05e9\u05d1\u05d5\u05e2 \u05de\u05d0\u05d6 \u05d5\u05de\u05ea\u05de\u05d9\u05d3. \u05d4\u05d4\u05d5\u05e8\u05d9\u05dd \u05de\u05d3\u05d5\u05d5\u05d7\u05d9\u05dd \u05db\u05d9 \u05d4\u05d9\u05dc\u05d3 \u05d1\u05e8\u05d9\u05d0 \u05d1\u05d3\u05e8\u05da \u05db\u05dc\u05dc, \u05dc\u05dc\u05d0 \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d1\u05d9\u05d5\u05dd, \u05d0\u05da \u05d4\u05dd \u05d7\u05d5\u05e9\u05e9\u05d9\u05dd \u05de\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea \u05e8\u05d2\u05e9\u05d9\u05ea \u05dc\u05e7\u05d5\u05d9\u05d4. \u05d1\u05d1\u05d3\u05d9\u05e7\u05ea \u05e9\u05ea\u05df \u05db\u05dc\u05dc\u05d9\u05ea (Urinalysis) \u05dc\u05d0 \u05e0\u05de\u05e6\u05d0\u05d5 \u05de\u05de\u05e6\u05d0\u05d9\u05dd \u05d7\u05e8\u05d9\u05d2\u05d9\u05dd. \u05de\u05d4\u05d5 \u05d4\u05e6\u05e2\u05d3 \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc\u05d9 (First-line treatment) \u05d4\u05de\u05d5\u05de\u05dc\u05e5 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05e2\u05d1\u05d5\u05e8\u05d5?",
      "answerOptions": [
        {
          "text": "\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05d0\u05de\u05e6\u05e2\u05d5\u05ea \u05d6\u05de\u05d6\u05dd \u05d4\u05e8\u05d8\u05d1\u05d4 (Enuresis Alarm/Bell-and-pad).",
          "isCorrect": true,
          "rationale": "\u05d6\u05d4\u05d5 \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05de\u05d5\u05e2\u05d3\u05e3 (First choice) \u05d1\u05e9\u05dc \u05e9\u05d9\u05e2\u05d5\u05e8\u05d9 \u05d4\u05e6\u05dc\u05d7\u05d4 \u05d2\u05d1\u05d5\u05d4\u05d9\u05dd (~66%) \u05d5\u05e9\u05d9\u05e2\u05d5\u05e8 \u05d4-Relapse \u05d4\u05e0\u05de\u05d5\u05da \u05d1\u05d9\u05d5\u05ea\u05e8 \u05de\u05d1\u05d9\u05df \u05db\u05dc\u05dc \u05d4\u05d4\u05ea\u05e2\u05e8\u05d1\u05d5\u05d9\u05d5\u05ea (Dulcan p.464, 465, 470)."
        },
        {
          "text": "\u05de\u05ea\u05df Desmopressin \u05d1\u05de\u05d9\u05e0\u05d5\u05df \u05e9\u05dc $200\\,mcg$ \u05dc\u05e4\u05e0\u05d9 \u05d4\u05e9\u05d9\u05e0\u05d4.",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05d9\u05e2\u05d9\u05dc\u05d5\u05ea\u05d4 \u05d4\u05de\u05d4\u05d9\u05e8\u05d4, \u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 \u05e7\u05e9\u05d5\u05e8\u05d4 \u05d1\u05e9\u05d9\u05e2\u05d5\u05e8\u05d9 \u05d7\u05d6\u05e8\u05d4 (Relapse) \u05d2\u05d1\u05d5\u05d4\u05d9\u05dd \u05de\u05d0\u05d5\u05d3 \u05e9\u05dc \u05de\u05e2\u05dc 90% \u05e2\u05dd \u05d4\u05e4\u05e1\u05e7\u05ea\u05d4 (Dulcan p.463, 465)."
        },
        {
          "text": "\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Imipramine \u05ea\u05d5\u05da \u05e0\u05d9\u05d8\u05d5\u05e8 \u05e8\u05de\u05d5\u05ea \u05d1\u05d3\u05dd.",
          "isCorrect": false,
          "rationale": "\u05ea\u05e8\u05d5\u05e4\u05d4 \u05d6\u05d5 \u05e0\u05d7\u05e9\u05d1\u05ea \u05dc\u05e7\u05d5 \u05e9\u05dc\u05d9\u05e9\u05d9 \u05d1\u05e9\u05dc \u05e4\u05d5\u05d8\u05e0\u05e6\u05d9\u05d0\u05dc \u05dc\u05e8\u05e2\u05d9\u05dc\u05d5\u05ea \u05dc\u05d1\u05d1\u05d9\u05ea \u05d5\u05e1\u05db\u05e0\u05ea Overdose \u05e7\u05d8\u05dc\u05e0\u05d9 (Dulcan p.462)."
        },
        {
          "text": "\u05e4\u05e1\u05d9\u05db\u05d5\u05ea\u05e8\u05e4\u05d9\u05d4 \u05d3\u05d9\u05e0\u05de\u05d9\u05ea \u05de\u05de\u05d5\u05e7\u05d3\u05ea \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05d1\u05d9\u05d8\u05d5\u05d9 \u05dc\u05d0 \u05de\u05d5\u05d3\u05e2 \u05e9\u05dc \u05db\u05e2\u05e1.",
          "isCorrect": false,
          "rationale": "\u05ea\u05d9\u05d0\u05d5\u05e8\u05d9\u05d5\u05ea \u05e4\u05e1\u05d9\u05db\u05d5\u05d3\u05d9\u05e0\u05de\u05d9\u05d5\u05ea \u05d4\u05e8\u05d5\u05d0\u05d5\u05ea \u05d1\u05d4\u05e8\u05d8\u05d1\u05d4 \u05d1\u05d9\u05d8\u05d5\u05d9 \u05dc\u05db\u05e2\u05e1 \u05e0\u05e0\u05d8\u05e9\u05d5 \u05d1\u05e8\u05d5\u05d1\u05df, \u05d5\u05d0\u05d9\u05df \u05e2\u05d3\u05d5\u05ea \u05dc\u05db\u05da \u05e9\u05d8\u05d9\u05e4\u05d5\u05dc \u05d6\u05d4 \u05de\u05e1\u05d9\u05d9\u05e2 \u05dc-Primary Enuresis (Dulcan p.459, 464)."
        }
      ],
      "hint": "\u05e9\u05e7\u05d5\u05dc \u05d0\u05d9\u05d6\u05d4 \u05d8\u05d9\u05e4\u05d5\u05dc \u05de\u05e6\u05d9\u05e2 \u05d0\u05ea \u05d4\u05e1\u05d9\u05db\u05d5\u05d9 \u05d4\u05d8\u05d5\u05d1 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05d4\u05e4\u05d5\u05d2\u05d4 \u05d0\u05e8\u05d5\u05db\u05ea \u05d8\u05d5\u05d5\u05d7 \u05dc\u05dc\u05d0 \u05d7\u05d6\u05e8\u05d4 \u05e9\u05dc \u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd.",
      "imageUrls": []
    },
    {
      "type": "fill_in_the_blank",
      "question": "\u05e2\u05dc \u05e4\u05d9 \u05d0\u05d6\u05d4\u05e8\u05ea \u05d4-FDA (Black-Box Warning), \u05d7\u05dc \u05d0\u05d9\u05e1\u05d5\u05e8 \u05de\u05d5\u05d7\u05dc\u05d8 \u05e2\u05dc \u05e9\u05d9\u05de\u05d5\u05e9 \u05d1-___ \u05e9\u05dc Desmopressin \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Enuresis, \u05d1\u05e9\u05dc \u05e1\u05d9\u05db\u05d5\u05df \u05de\u05d5\u05d2\u05d1\u05e8 \u05dc\u05e4\u05ea\u05d7 Hyponatremia, \u05e4\u05e8\u05db\u05d5\u05e1\u05d9\u05dd \u05d5\u05d1\u05e6\u05e7\u05ea \u05de\u05d5\u05d7\u05d9\u05ea (Dulcan p.463-464, 470).",
      "bestAnswer": "Nasal Spray",
      "acceptableAnswers": [
