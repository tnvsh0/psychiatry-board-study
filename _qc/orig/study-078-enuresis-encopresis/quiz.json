    {
      "type": "short_answer",
      "question": "\u05d4\u05e1\u05d1\u05e8 \u05d0\u05ea \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05e4\u05d9\u05d6\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d4\u05de\u05d5\u05d1\u05d9\u05dc \u05dc-Overflow Incontinence \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d4\u05e1\u05d5\u05d1\u05dc\u05d9\u05dd \u05de-Retentive Encopresis.",
      "grading": {
        "modelAnswer": "\u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05de\u05ea\u05d7\u05d9\u05dc \u05dc\u05e8\u05d5\u05d1 \u05d1-Painful defecation \u05d4\u05de\u05d5\u05d1\u05d9\u05dc\u05d4 \u05dc\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d0\u05d9\u05e4\u05d5\u05e7 (Withholding behavior). \u05d0\u05d2\u05d9\u05e8\u05ea \u05e6\u05d5\u05d0\u05d4 \u05db\u05e8\u05d5\u05e0\u05d9\u05ea \u05d2\u05d5\u05e8\u05de\u05ea \u05dc-Rectal Distension (\u05d4\u05ea\u05e8\u05d7\u05d1\u05d5\u05ea \u05d4\u05e8\u05e7\u05d8\u05d5\u05dd) \u05d5\u05d0\u05d5\u05d1\u05d3\u05df \u05ea\u05d7\u05d5\u05e9\u05ea\u05d9\u05d5\u05ea (Sensory awareness). \u05db\u05ea\u05d5\u05e6\u05d0\u05d4 \u05de\u05d4\u05d4\u05e8\u05d7\u05d1\u05d4, \u05e0\u05d5\u05e6\u05e8\u05ea \u05d4\u05e8\u05e4\u05d9\u05d4 \u05e8\u05e4\u05dc\u05e7\u05e1\u05d9\u05d1\u05d9\u05ea \u05e9\u05dc \u05d4-Internal Anal Sphincter, \u05d5\u05e6\u05d5\u05d0\u05d4 \u05e0\u05d5\u05d6\u05dc\u05d9\u05ea \u05de\u05d7\u05dc\u05d7\u05dc\u05ea \u05e1\u05d1\u05d9\u05d1 \u05d2\u05d5\u05e9 \u05d4\u05e6\u05d5\u05d0\u05d4 \u05d4\u05db\u05dc\u05d5\u05d0 \u05d5\u05d3\u05d5\u05dc\u05e4\u05ea \u05d4\u05d7\u05d5\u05e6\u05d4 \u05dc\u05dc\u05d0 \u05de\u05d5\u05d3\u05e2\u05d5\u05ea \u05d4\u05d9\u05dc\u05d3 (Dulcan p.466-467, DSM p.403).",
        "rationale": "\u05d4\u05d1\u05e0\u05ea \u05de\u05e2\u05d2\u05dc \u05d4\u05e2\u05e6\u05d9\u05e8\u05d5\u05ea \u05d4\u05db\u05e8\u05d5\u05e0\u05d9\u05ea \u05d5\u05d4\u05e9\u05e4\u05e2\u05ea\u05d4 \u05e2\u05dc \u05d4\u05e8\u05e4\u05dc\u05e7\u05e1\u05d9\u05dd \u05e9\u05dc \u05e4\u05d9 \u05d4\u05d8\u05d1\u05e2\u05ea \u05d4\u05d9\u05d0 \u05e7\u05e8\u05d9\u05d8\u05d9\u05ea \u05dc\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d5\u05d8\u05d9\u05e4\u05d5\u05dc (Dulcan p.466).",
        "requiredAttributes": [
          "\u05e6\u05d9\u05d5\u05df \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d0\u05d9\u05e4\u05d5\u05e7 (Withholding behavior) \u05d0\u05d5 \u05e2\u05e6\u05d9\u05e8\u05d5\u05ea \u05db\u05e8\u05d5\u05e0\u05d9\u05ea.",
          "\u05e6\u05d9\u05d5\u05df \u05d4\u05ea\u05e8\u05d7\u05d1\u05d5\u05ea \u05d4\u05e8\u05e7\u05d8\u05d5\u05dd (Rectal Distension) \u05d0\u05d5 \u05d0\u05d5\u05d1\u05d3\u05df \u05ea\u05d7\u05d5\u05e9\u05d4.",
          "\u05d4\u05e1\u05d1\u05e8 \u05e2\u05dc \u05d3\u05dc\u05d9\u05e4\u05ea \u05e6\u05d5\u05d0\u05d4 \u05e0\u05d5\u05d6\u05dc\u05d9\u05ea \u05e1\u05d1\u05d9\u05d1 \u05d2\u05d5\u05e9 \u05e6\u05d5\u05d0\u05d4 \u05db\u05dc\u05d5\u05d0 (Fecal impaction)."
        ],
        "errors": {
          "misconceptions": [
            "\u05d4\u05e0\u05d7\u05d4 \u05e9\u05d4\u05d9\u05dc\u05d3 \u05de\u05dc\u05db\u05dc\u05da \u05d1\u05db\u05d5\u05d5\u05e0\u05d4 \u05db\u05d3\u05d9 \u05dc\u05d4\u05db\u05e2\u05d9\u05e1 \u05d0\u05ea \u05d4\u05d4\u05d5\u05e8\u05d9\u05dd.",
            "\u05d4\u05e0\u05d7\u05d4 \u05e9\u05de\u05d3\u05d5\u05d1\u05e8 \u05d1\u05e9\u05dc\u05e9\u05d5\u05dc \u05d6\u05d9\u05d4\u05d5\u05de\u05d9 \u05d7\u05e8\u05d9\u05e3."
          ],
          "bluffs": [
