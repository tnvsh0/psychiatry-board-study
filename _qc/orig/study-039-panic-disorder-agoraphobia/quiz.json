{
  "title": "Anxiety Quiz",
  "questions": [
    {
      "question": "\u05de\u05ea\u05d1\u05d2\u05e8\u05ea \u05d1\u05ea 16 \u05de\u05d2\u05d9\u05e2\u05d4 \u05dc\u05de\u05e8\u05e4\u05d0\u05d4 \u05dc\u05d0\u05d7\u05e8 \u05e9\u05dc\u05d5\u05e9\u05d4 \u05d0\u05d9\u05e8\u05d5\u05e2\u05d9\u05dd \u05e4\u05ea\u05d0\u05d5\u05de\u05d9\u05d9\u05dd \u05d1\u05d7\u05d5\u05d3\u05e9 \u05d4\u05d0\u05d7\u05e8\u05d5\u05df \u05d4\u05db\u05d5\u05dc\u05dc\u05d9\u05dd palpitations, Sweating, \u05d5\u05e8\u05e2\u05d3 \u05e2\u05d6, \u05d4\u05de\u05d2\u05d9\u05e2\u05d9\u05dd \u05dc\u05e9\u05d9\u05d0 \u05ea\u05d5\u05da 5 \u05d3\u05e7\u05d5\u05ea. \u05d4\u05d9\u05d0 \u05de\u05d3\u05d5\u05d5\u05d7\u05ea \u05e2\u05dc \u05e4\u05d7\u05d3 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9 \u05de\u05d0\u05d9\u05d1\u05d5\u05d3 \u05e9\u05dc\u05d9\u05d8\u05d4 \u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05d0\u05d9\u05e8\u05d5\u05e2\u05d9\u05dd \u05d5\u05de\u05d0\u05d6 \u05d4\u05d0\u05d9\u05e8\u05d5\u05e2 \u05d4\u05d0\u05d7\u05e8\u05d5\u05df \u05d4\u05d9\u05d0 \u05e2\u05e1\u05d5\u05e7\u05d4 \u05de\u05d0\u05d5\u05d3 \u05d1\u05e9\u05d0\u05dc\u05d4 \u05de\u05ea\u05d9 \u05d9\u05ea\u05e8\u05d7\u05e9 \u05d4\u05d0\u05d9\u05e8\u05d5\u05e2 \u05d4\u05d1\u05d0 \u05d5\u05d0\u05e3 \u05e0\u05de\u05e0\u05e2\u05ea \u05de\u05e9\u05d9\u05e2\u05d5\u05e8\u05d9 \u05e1\u05e4\u05d5\u05e8\u05d8 \u05d1\u05d1\u05d9\u05ea \u05d4\u05e1\u05e4\u05e8. \u05de\u05d4\u05d9 \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05e1\u05d1\u05d9\u05e8\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR?",
      "answerOptions": [
        {
          "text": "Panic Disorder",
          "isCorrect": true,
          "rationale": "\u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05d3\u05d5\u05e8\u05e9\u05d9\u05dd panic attacks \u05d7\u05d5\u05d6\u05e8\u05d5\u05ea \u05d5\u05d1\u05dc\u05ea\u05d9 \u05e6\u05e4\u05d5\u05d9\u05d5\u05ea, \u05d4\u05de\u05dc\u05d5\u05d5\u05ea \u05d1\u05dc\u05e4\u05d7\u05d5\u05ea \u05d7\u05d5\u05d3\u05e9 \u05d0\u05d7\u05d3 \u05e9\u05dc \u05d3\u05d0\u05d2\u05d4 \u05de\u05ea\u05de\u05d3\u05ea \u05de\u05d4\u05ea\u05e7\u05e4\u05d9\u05dd \u05e0\u05d5\u05e1\u05e4\u05d9\u05dd \u05d0\u05d5 \u05e9\u05d9\u05e0\u05d5\u05d9 \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea\u05d9 \u05de\u05dc\u05d0\u05d3\u05e4\u05d8\u05d9\u05d1\u05d9 (DSM p.235)."
        },
        {
          "text": "Specific Phobia, situational type",
          "isCorrect": false,
          "rationale": "\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d6\u05d5 \u05d0\u05d9\u05e0\u05d4 \u05de\u05ea\u05d0\u05d9\u05de\u05d4 \u05e9\u05db\u05df \u05d4\u05d4\u05ea\u05e7\u05e4\u05d9\u05dd \u05de\u05ea\u05d5\u05d0\u05e8\u05d9\u05dd \u05db\u05d1\u05dc\u05ea\u05d9 \u05e6\u05e4\u05d5\u05d9\u05d9\u05dd \u05d5\u05d0\u05d9\u05e0\u05dd \u05de\u05d5\u05d2\u05d1\u05dc\u05d9\u05dd \u05dc\u05d2\u05d9\u05e8\u05d5\u05d9 \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9 \u05d7\u05d9\u05e6\u05d5\u05e0\u05d9, \u05d5\u05e7\u05d9\u05d9\u05de\u05ea \u05d3\u05d0\u05d2\u05d4 \u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9\u05ea \u05de\u05d4\u05e9\u05dc\u05db\u05d5\u05ea \u05d4\u05d4\u05ea\u05e7\u05e3 \u05e2\u05e6\u05de\u05d5 (DSM p.235)."
        },
        {
          "text": "Social Anxiety Disorder",
          "isCorrect": false,
          "rationale": "\u05d1\u05e2\u05d5\u05d3 \u05e9\u05e7\u05d9\u05d9\u05de\u05ea \u05d4\u05d9\u05de\u05e0\u05e2\u05d5\u05ea, \u05d4\u05de\u05d5\u05e7\u05d3 \u05d0\u05d9\u05e0\u05d5 \u05e4\u05d7\u05d3 \u05de\u05d4\u05e2\u05e8\u05db\u05d4 \u05e9\u05dc\u05d9\u05dc\u05d9\u05ea \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d0\u05d7\u05e8\u05d9\u05dd \u05d1\u05de\u05e6\u05d1\u05d9\u05dd \u05d7\u05d1\u05e8\u05ea\u05d9\u05d9\u05dd \u05d0\u05dc\u05d0 \u05e4\u05d7\u05d3 \u05de\u05d4\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05d4\u05e4\u05d9\u05d6\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05d9\u05dd \u05e9\u05dc \u05d4\u05d4\u05ea\u05e7\u05e3 (DSM p.229)."
        },
        {
          "text": "Generalized Anxiety Disorder",
          "isCorrect": false,
          "rationale": "\u05d4\u05e4\u05e8\u05e2\u05d4 \u05d6\u05d5 \u05de\u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05ea \u05d1\u05d3\u05d0\u05d2\u05d4 \u05de\u05e4\u05d5\u05e9\u05d8\u05ea \u05d1\u05e0\u05d5\u05e9\u05d0\u05d9\u05dd \u05e8\u05d1\u05d9\u05dd \u05dc\u05d0\u05d5\u05e8\u05da \u05e8\u05d5\u05d1 \u05d4\u05d9\u05d5\u05dd, \u05d5\u05dc\u05d0 \u05d1\u05d4\u05ea\u05e7\u05e4\u05d9\u05dd \u05d0\u05e4\u05d9\u05d6\u05d5\u05d3\u05d9\u05d9\u05dd \u05d7\u05e8\u05d9\u05e4\u05d9\u05dd \u05e2\u05dd \u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05d0\u05d5\u05d8\u05d5\u05e0\u05d5\u05de\u05d9\u05d9\u05dd \u05d1\u05d5\u05dc\u05d8\u05d9\u05dd \u05db\u05e4\u05d9 \u05e9\u05de\u05ea\u05d5\u05d0\u05e8 \u05db\u05d0\u05df (DSM p.250)."
        }
      ],
      "hint": "\u05e9\u05d9\u05dd \u05dc\u05d1 \u05dc\u05e9\u05d9\u05dc\u05d5\u05d1 \u05d1\u05d9\u05df \u05d0\u05d5\u05e4\u05d9 \u05d4\u05d4\u05ea\u05e7\u05e4\u05d9\u05dd \u05dc\u05d1\u05d9\u05df \u05de\u05e9\u05da \u05d5\u05e1\u05d5\u05d2 \u05d4\u05d7\u05e8\u05d3\u05d4 \u05d4\u05de\u05e7\u05d3\u05d9\u05de\u05d4 (Anticipatory anxiety)."
    },
    {
      "question": "\u05d9\u05dc\u05d3 \u05d1\u05df 12 \u05de\u05e1\u05e8\u05d1 \u05dc\u05e0\u05e1\u05d5\u05e2 \u05d1\u05d0\u05d5\u05d8\u05d5\u05d1\u05d5\u05e1\u05d9\u05dd \u05d5\u05dc\u05dc\u05db\u05ea \u05dc\u05e7\u05d5\u05dc\u05e0\u05d5\u05e2. \u05d4\u05d5\u05d0 \u05de\u05e1\u05d1\u05d9\u05e8 \u05d6\u05d0\u05ea \u05d1\u05db\u05da \u05e9\u05d4\u05d5\u05d0 \u05d7\u05d5\u05e9\u05e9 \u05e9\u05d9\u05ea\u05e4\u05ea\u05d7 \u05d0\u05e6\u05dc\u05d5 '\u05d4\u05e8\u05d2\u05e9\u05d4 \u05e8\u05e2\u05d4' \u05d0\u05d5 \u05d1\u05d7\u05d9\u05dc\u05d4 \u05d5\u05d4\u05d5\u05d0 \u05dc\u05d0 \u05d9\u05d5\u05db\u05dc \u05dc\u05e6\u05d0\u05ea \u05de\u05d4\u05de\u05e7\u05d5\u05dd \u05d1\u05de\u05d4\u05d9\u05e8\u05d5\u05ea \u05d0\u05d5 \u05dc\u05e7\u05d1\u05dc \u05e2\u05d6\u05e8\u05d4. \u05d4\u05d5\u05d0 \u05de\u05e6\u05d9\u05d9\u05df \u05e9\u05d0\u05d9\u05e0\u05d5 \u05d7\u05d5\u05e9\u05e9 \u05de\u05d4\u05d0\u05d5\u05d8\u05d5\u05d1\u05d5\u05e1 \u05e2\u05e6\u05de\u05d5, \u05d0\u05dc\u05d0 \u05de\u05d4\u05e7\u05d5\u05e9\u05d9 \u05dc\u05d4\u05d9\u05d7\u05dc\u05e5 \u05d1\u05de\u05d9\u05d3\u05d4 \u05d5\u05d9\u05d7\u05d5\u05e9 \u05d1\u05e8\u05e2. \u05de\u05d4\u05d9 \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05de\u05d3\u05d5\u05d9\u05e7\u05ea \u05d1\u05d9\u05d5\u05ea\u05e8?",
      "answerOptions": [
        {
          "text": "Agoraphobia",
          "isCorrect": true,
          "rationale": "\u05d0\u05d2\u05d5\u05e8\u05d5\u05e4\u05d5\u05d1\u05d9\u05d4 \u05de\u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05ea \u05d1\u05e4\u05d7\u05d3 \u05d1-2 \u05de\u05ea\u05d5\u05da 5 \u05de\u05e6\u05d1\u05d9\u05dd (\u05db\u05d0\u05df: \u05ea\u05d7\u05d1\u05d5\u05e8\u05d4 \u05e6\u05d9\u05d1\u05d5\u05e8\u05d9\u05ea \u05d5\u05de\u05e7\u05d5\u05de\u05d5\u05ea \u05e1\u05d2\u05d5\u05e8\u05d9\u05dd) \u05d4\u05de\u05d1\u05d5\u05e1\u05e1 \u05e2\u05dc \u05d4\u05de\u05d7\u05e9\u05d1\u05d4 \u05e9\u05d1\u05e8\u05d9\u05d7\u05d4 \u05ea\u05d4\u05d9\u05d4 \u05e7\u05e9\u05d4 \u05d0\u05d5 \u05e9\u05e2\u05d6\u05e8\u05d4 \u05dc\u05d0 \u05ea\u05d4\u05d9\u05d4 \u05d6\u05de\u05d9\u05e0\u05d4 (DSM p.246)."
        },
        {
          "text": "Panic Disorder",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05e9\u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05d7\u05d5\u05e9\u05e9 \u05de\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05d3\u05de\u05d5\u05d9\u05d9 \u05e4\u05d0\u05e0\u05d9\u05e7\u05d4, \u05d0\u05d9\u05df \u05d3\u05d9\u05d5\u05d5\u05d7 \u05e2\u05dc \u05d4\u05ea\u05e7\u05e4\u05d9 \u05e4\u05d0\u05e0\u05d9\u05e7\u05d4 \u05d1\u05dc\u05ea\u05d9 \u05e6\u05e4\u05d5\u05d9\u05d9\u05dd (unexpected) \u05e9\u05d4\u05dd \u05ea\u05e0\u05d0\u05d9 \u05d4\u05db\u05e8\u05d7\u05d9 \u05dc\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d6\u05d5 (DSM p.235)."
        },
        {
          "text": "Specific Phobia",
          "isCorrect": false,
          "rationale": "\u05d1\u05e4\u05d5\u05d1\u05d9\u05d4 \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05ea \u05d4\u05e4\u05d7\u05d3 \u05d4\u05d5\u05d0 \u05de\u05d4\u05d0\u05d5\u05d1\u05d9\u05d9\u05e7\u05d8 \u05e2\u05e6\u05de\u05d5, \u05d1\u05e2\u05d5\u05d3 \u05e9\u05db\u05d0\u05df \u05d4\u05e4\u05d7\u05d3 \u05d4\u05d5\u05d0 \u05de\u05d4\u05e9\u05dc\u05db\u05d5\u05ea \u05e9\u05dc \u05d7\u05d5\u05e1\u05e8 \u05d9\u05db\u05d5\u05dc\u05ea \u05dc\u05d4\u05d9\u05d7\u05dc\u05e5 \u05d0\u05d5 \u05dc\u05e7\u05d1\u05dc \u05e2\u05d6\u05e8\u05d4 \u05d1\u05de\u05e6\u05d1\u05d9\u05dd \u05de\u05e8\u05d5\u05d1\u05d9\u05dd (DSM p.247)."
        },
        {
          "text": "Separation Anxiety Disorder",
          "isCorrect": false,
          "rationale": "\u05d4\u05d4\u05d9\u05de\u05e0\u05e2\u05d5\u05ea \u05db\u05d0\u05df \u05d0\u05d9\u05e0\u05d4 \u05e0\u05d5\u05d1\u05e2\u05ea \u05de\u05d7\u05e9\u05e9 \u05de\u05e4\u05e8\u05d9\u05d3\u05d4 \u05de\u05d3\u05de\u05d5\u05ea \u05d4\u05d9\u05e7\u05e9\u05e8\u05d5\u05ea \u05d0\u05dc\u05d0 \u05de\u05d7\u05e9\u05e9 \u05de\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05d2\u05d5\u05e4\u05e0\u05d9\u05d9\u05dd \u05d1\u05de\u05e7\u05d5\u05de\u05d5\u05ea \u05e9\u05e7\u05e9\u05d4 \u05dc\u05e6\u05d0\u05ea \u05de\u05d4\u05dd (DSM p.217)."
        }
      ],
      "hint": "\u05d4\u05ea\u05de\u05e7\u05d3 \u05d1\u05e1\u05d9\u05d1\u05d4 \u05e9\u05d1\u05d2\u05dc\u05dc\u05d4 \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05e0\u05de\u05e0\u05e2 \u05de\u05d4\u05e1\u05d9\u05d8\u05d5\u05d0\u05e6\u05d9\u05d5\u05ea \u05d5\u05d1\u05de\u05e1\u05e4\u05e8 \u05d4\u05e1\u05d9\u05d8\u05d5\u05d0\u05e6\u05d9\u05d5\u05ea \u05d4\u05de\u05e2\u05d5\u05e8\u05d1\u05d5\u05ea."
    },
    {
      "question": "\u05dc\u05e4\u05d9 \u05d4\u05de\u05d5\u05d3\u05dc \u05d4\u05e0\u05d5\u05d9\u05e8\u05d5\u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d4\u05de\u05d5\u05e6\u05d2 \u05d1-StahlNeuro, \u05d0\u05d9\u05d6\u05d4 \u05de\u05e2\u05d2\u05dc \u05de\u05d5\u05d7\u05d9 \u05d0\u05d7\u05e8\u05d0\u05d9 \u05e2\u05dc \u05d4\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05dd \u05e9\u05dc Worry (\u05d3\u05d0\u05d2\u05d4), \u05d4\u05db\u05d5\u05dc\u05dc \u05de\u05d7\u05e9\u05d1\u05d5\u05ea \u05e7\u05d8\u05e1\u05d8\u05e8\u05d5\u05e4\u05dc\u05d9\u05d5\u05ea \u05d5\u05d0\u05d5\u05d1\u05e1\u05e1\u05d9\u05d5\u05ea?",
      "answerOptions": [
        {
          "text": "Cortico-striato-thalamo-cortical (CSTC) loops",
          "isCorrect": true,
          "rationale": "\u05de\u05e2\u05d2\u05dc\u05d9 \u05d4-CSTC, \u05d5\u05d1\u05de\u05d9\u05d5\u05d7\u05d3 \u05d0\u05dc\u05d5 \u05d4\u05de\u05ea\u05d7\u05d9\u05dc\u05d9\u05dd \u05d5\u05de\u05e1\u05ea\u05d9\u05d9\u05de\u05d9\u05dd \u05d1-DLPFC, \u05de\u05e7\u05d5\u05e9\u05e8\u05d9\u05dd \u05dc\u05e0\u05d9\u05d4\u05d5\u05dc \u05d3\u05d0\u05d2\u05d5\u05ea \u05d5\u05de\u05d7\u05e9\u05d1\u05d5\u05ea \u05d7\u05d5\u05d6\u05e8\u05d5\u05ea (StahlNeuro p.367)."
        },
        {
          "text": "Amygdala-centered circuits",
          "isCorrect": false,
          "rationale": "\u05de\u05e2\u05d2\u05dc\u05d9\u05dd \u05d0\u05dc\u05d5 \u05de\u05d5\u05d5\u05e1\u05ea\u05d9\u05dd \u05d1\u05e2\u05d9\u05e7\u05e8 \u05d0\u05ea \u05e8\u05d2\u05e9 \u05d4\u05e4\u05d7\u05d3 (Fear), \u05e4\u05d0\u05e0\u05d9\u05e7\u05d4 \u05d5\u05e4\u05d5\u05d1\u05d9\u05d5\u05ea, \u05d0\u05da \u05e4\u05d7\u05d5\u05ea \u05d0\u05ea \u05d4\u05de\u05e8\u05db\u05d9\u05d1 \u05d4\u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9 \u05e9\u05dc \u05d3\u05d0\u05d2\u05d4 \u05de\u05ea\u05de\u05e9\u05db\u05ea (StahlNeuro p.366)."
        },
        {
          "text": "Hypothalamic-pituitary-adrenal (HPA) axis",
          "isCorrect": false,
          "rationale": "\u05e6\u05d9\u05e8 \u05d6\u05d4 \u05de\u05e2\u05d5\u05e8\u05d1 \u05d1\u05ea\u05d2\u05d5\u05d1\u05ea \u05d4\u05e1\u05d8\u05e8\u05e1 \u05d4\u05e4\u05d9\u05d6\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea \u05d5\u05d1\u05e9\u05d7\u05e8\u05d5\u05e8 \u05e7\u05d5\u05e8\u05d8\u05d9\u05d6\u05d5\u05dc, \u05d0\u05da \u05d0\u05d9\u05e0\u05d5 \u05de\u05d4\u05d5\u05d5\u05d4 \u05d0\u05ea \u05d4\u05de\u05e2\u05d2\u05dc \u05d4\u05e2\u05d9\u05e7\u05e8\u05d9 \u05d4\u05d0\u05d7\u05e8\u05d0\u05d9 \u05e2\u05dc \u05e2\u05d9\u05d1\u05d5\u05d3 \u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9 \u05e9\u05dc \u05d3\u05d0\u05d2\u05d4 (StahlNeuro p.367)."
