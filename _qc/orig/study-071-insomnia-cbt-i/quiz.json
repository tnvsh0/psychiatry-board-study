          "text": "\u05ea\u05e1\u05de\u05d9\u05e0\u05d9 \u05d4-ADHD \u05e2\u05e9\u05d5\u05d9\u05d9\u05dd \u05dc\u05d4\u05e9\u05ea\u05e4\u05e8 \u05d0\u05d5 \u05dc\u05d4\u05d9\u05e2\u05dc\u05dd \u05dc\u05d0\u05d7\u05e8 Adenotonsillectomy",
          "isCorrect": true,
          "rationale": "\u05e7\u05d9\u05d9\u05de\u05d5\u05ea \u05e2\u05d3\u05d5\u05d9\u05d5\u05ea \u05dc\u05db\u05da \u05e9\u05d8\u05d9\u05e4\u05d5\u05dc \u05db\u05d9\u05e8\u05d5\u05e8\u05d2\u05d9 \u05d1-SDB (\u05db\u05de\u05d5 \u05db\u05e8\u05d9\u05ea\u05ea \u05e9\u05e7\u05d3\u05d9\u05dd \u05d5\u05d0\u05d3\u05e0\u05d5\u05d0\u05d9\u05d3\u05d9\u05dd) \u05d9\u05db\u05d5\u05dc \u05dc\u05e9\u05e4\u05e8 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05ea\u05e1\u05de\u05d9\u05e0\u05d9 \u05d7\u05d5\u05e1\u05e8 \u05e7\u05e9\u05d1 \u05d5\u05d4\u05d9\u05e4\u05e8\u05d0\u05e7\u05d8\u05d9\u05d1\u05d9\u05d5\u05ea (Dulcan p.491)."
        },
        {
          "text": "\u05d4\u05d9\u05dc\u05d3 \u05d7\u05d9\u05d9\u05d1 \u05dc\u05d4\u05ea\u05d7\u05d9\u05dc \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Stimulants \u05dc\u05e4\u05e0\u05d9 \u05d1\u05d9\u05e8\u05d5\u05e8 \u05d4\u05e9\u05d9\u05e0\u05d4",
          "isCorrect": false,
          "rationale": "\u05d9\u05e9 \u05dc\u05d1\u05e6\u05e2 \u05d1\u05d9\u05e8\u05d5\u05e8 \u05e9\u05d9\u05e0\u05d4 \u05dc\u05e4\u05e0\u05d9 \u05de\u05ea\u05df \u05e1\u05d8\u05d9\u05de\u05d5\u05dc\u05e0\u05d8\u05d9\u05dd, \u05e9\u05db\u05df \u05d4\u05e4\u05e8\u05e2\u05ea \u05e0\u05e9\u05d9\u05de\u05d4 \u05d1\u05e9\u05d9\u05e0\u05d4 \u05d9\u05db\u05d5\u05dc\u05d4 \u05dc\u05d7\u05e7\u05d5\u05ea \u05d0\u05d5 \u05dc\u05d4\u05d7\u05de\u05d9\u05e8 \u05ea\u05e1\u05de\u05d9\u05e0\u05d9 ADHD (Dulcan p.491-492)."
        },
        {
          "text": "\u05e0\u05d7\u05d9\u05e8\u05d5\u05ea \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d4\u05df \u05ea\u05d5\u05e4\u05e2\u05d4 \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9\u05ea \u05e9\u05e4\u05d9\u05e8\u05d4 \u05e9\u05d0\u05d9\u05e0\u05d4 \u05d3\u05d5\u05e8\u05e9\u05ea \u05d8\u05d9\u05e4\u05d5\u05dc",
          "isCorrect": false,
          "rationale": "\u05e0\u05d7\u05d9\u05e8\u05d5\u05ea (Snoring) \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dc\u05d5\u05dc\u05d5\u05ea \u05dc\u05d4\u05d9\u05d5\u05ea \u05e7\u05e9\u05d5\u05e8\u05d5\u05ea \u05dc\u05dc\u05d9\u05e7\u05d5\u05d9\u05d9\u05dd \u05e0\u05d5\u05d9\u05e8\u05d5-\u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9\u05d9\u05dd \u05d5\u05d3\u05d5\u05e8\u05e9\u05d5\u05ea \u05d1\u05d9\u05e8\u05d5\u05e8 (Dulcan p.487)."
        },
        {
          "text": "\u05d0\u05d9\u05df \u05e7\u05e9\u05e8 \u05de\u05d5\u05db\u05d7 \u05d1\u05d9\u05df \u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05e0\u05e9\u05d9\u05de\u05d4 \u05d1\u05e9\u05d9\u05e0\u05d4 \u05dc\u05d1\u05d9\u05df \u05ea\u05e4\u05e7\u05d5\u05d3 \u05d0\u05e7\u05d3\u05de\u05d9",
          "isCorrect": false,
          "rationale": "\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05e0\u05e9\u05d9\u05de\u05d4 \u05d1\u05e9\u05d9\u05e0\u05d4 \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05e7\u05e9\u05d5\u05e8\u05d5\u05ea \u05d1\u05d0\u05d5\u05e4\u05df \u05de\u05d5\u05d1\u05d4\u05e7 \u05dc\u05d9\u05e8\u05d9\u05d3\u05d4 \u05d1\u05ea\u05e4\u05e7\u05d5\u05d3 \u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9 \u05d5\u05d0\u05e7\u05d3\u05de\u05d9 (Dulcan p.487)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d1\u05d5 \u05e2\u05dc \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05de\u05d1\u05d3\u05dc\u05ea \u05d5\u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05d0\u05d5\u05e4\u05d8\u05d9\u05de\u05dc\u05d9 \u05d1\u05e7\u05e9\u05e8 \u05e9\u05d1\u05d9\u05df \u05e0\u05e9\u05d9\u05de\u05d4 \u05dc\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea.",
      "imageUrls": []
    },
    {
      "type": "fill_in_the_blank",
      "question": "\u05dc\u05e4\u05d9 \u05d4\u05de\u05d5\u05d3\u05dc \u05d4\u05e0\u05d5\u05d9\u05e8\u05d5\u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d4\u05de\u05d5\u05e6\u05d2 \u05d1-StahlNeuro, \u05e0\u05d3\u05d5\u05d3\u05d9\u05d9 \u05e9\u05d9\u05e0\u05d4 (Insomnia) \u05e0\u05ea\u05e4\u05e1\u05d9\u05dd \u05db\u05d9\u05d5\u05dd \u05dc\u05d0 \u05e8\u05e7 \u05db\u05d7\u05d5\u05e1\u05e8 \u05d9\u05db\u05d5\u05dc\u05ea \u05dc\u05d4\u05e4\u05e2\u05d9\u05dc \u05d0\u05ea \u05de\u05e2\u05d2\u05dc\u05d9 \u05d4\u05e9\u05d9\u05e0\u05d4 (\u05db\u05de\u05d5 \u05d4-VLPO), \u05d0\u05dc\u05d0 \u05d1\u05e2\u05d9\u05e7\u05e8 \u05db\u05d7\u05d5\u05e1\u05e8 \u05d9\u05db\u05d5\u05dc\u05ea '\u05dc\u05db\u05d1\u05d5\u05ea' (Switch off) \u05d0\u05ea \u05de\u05e2\u05d2\u05dc\u05d9 \u05d4-___ \u05d1\u05dc\u05d9\u05dc\u05d4.",
      "bestAnswer": "arousal",
      "acceptableAnswers": [
        "hyperarousal",
        "\u05e2\u05e8\u05e0\u05d5\u05ea",
        "\u05e2\u05d5\u05e8\u05e8\u05d5\u05ea"
      ],
      "rationale": "\u05d4\u05ea\u05d9\u05d0\u05d5\u05e8\u05d9\u05d4 \u05d4\u05de\u05e8\u05db\u05d6\u05d9\u05ea \u05d1-StahlNeuro \u05d2\u05d5\u05e8\u05e1\u05ea \u05db\u05d9 \u05d0\u05d9\u05e0\u05e1\u05d5\u05de\u05e0\u05d9\u05d4 \u05d4\u05d9\u05d0 \u05de\u05e6\u05d1 \u05e9\u05dc hyperarousal \u05dc\u05d9\u05dc\u05d9, \u05d4\u05e0\u05d5\u05d1\u05e2 \u05de\u05db\u05e9\u05dc \u05d1\u05d3\u05d9\u05db\u05d5\u05d9 \u05de\u05e2\u05e8\u05db\u05d5\u05ea \u05d4\u05e2\u05d5\u05e8\u05e8\u05d5\u05ea \u05d5\u05dc\u05d0 \u05e8\u05e7 \u05de\u05db\u05e9\u05dc \u05d1\u05d4\u05e4\u05e2\u05dc\u05ea \u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05e9\u05d9\u05e0\u05d4 (\u05e2\u05de' 417-418).",
      "hint": "\u05d4\u05de\u05d5\u05e9\u05d2 \u05de\u05ea\u05d9\u05d9\u05d7\u05e1 \u05dc\u05de\u05e6\u05d1 \u05e9\u05dc \u05e2\u05d5\u05e8\u05e8\u05d5\u05ea \u05d9\u05ea\u05e8 \u05de\u05d5\u05d7\u05d9\u05ea."
    },
    {
      "type": "short_answer",
      "question": "\u05d4\u05e1\u05d1\u05e8 \u05d0\u05ea \u05e2\u05e7\u05e8\u05d5\u05e0\u05d5\u05ea \u05d4-Sleep Hygiene (\u05d4\u05d9\u05d2\u05d9\u05d9\u05e0\u05ea \u05e9\u05d9\u05e0\u05d4) \u05d5\u05de\u05d4\u05d5 \u05de\u05e7\u05d5\u05de\u05dd \u05d1\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Insomnia Disorder \u05db\u05e8\u05d5\u05e0\u05d9\u05ea \u05dc\u05e4\u05d9 StahlNeuro \u05d5-Dulcan.",
      "grading": {
        "modelAnswer": "\u05d4\u05d9\u05d2\u05d9\u05d9\u05e0\u05ea \u05e9\u05d9\u05e0\u05d4 \u05db\u05d5\u05dc\u05dc\u05ea \u05d4\u05e8\u05d2\u05dc\u05d9\u05dd \u05db\u05de\u05d5 \u05e9\u05de\u05d9\u05e8\u05d4 \u05e2\u05dc \u05e9\u05e2\u05d5\u05ea \u05e7\u05d1\u05d5\u05e2\u05d5\u05ea, \u05e1\u05d1\u05d9\u05d1\u05d4 \u05d7\u05e9\u05d5\u05db\u05d4 \u05d5\u05e7\u05e8\u05d9\u05e8\u05d4, \u05d5\u05d4\u05d9\u05de\u05e0\u05e2\u05d5\u05ea \u05de\u05e1\u05d8\u05d9\u05de\u05d5\u05dc\u05e0\u05d8\u05d9\u05dd (\u05db\u05de\u05d5 \u05e7\u05e4\u05d0\u05d9\u05df) \u05dc\u05e4\u05e0\u05d9 \u05d4\u05e9\u05d9\u05e0\u05d4. \u05dc\u05de\u05e8\u05d5\u05ea \u05d7\u05e9\u05d9\u05d1\u05d5\u05ea\u05dd, \u05d1\u05e0\u05d3\u05d5\u05d3\u05d9 \u05e9\u05d9\u05e0\u05d4 \u05db\u05e8\u05d5\u05e0\u05d9\u05d9\u05dd \u05d4\u05d9\u05d2\u05d9\u05d9\u05e0\u05ea \u05e9\u05d9\u05e0\u05d4 \u05dc\u05d1\u05d3\u05d4 \u05dc\u05e8\u05d5\u05d1 \u05d0\u05d9\u05e0\u05d4 \u05de\u05e1\u05e4\u05d9\u05e7\u05d4, \u05d5\u05d4\u05d9\u05d0 \u05de\u05d4\u05d5\u05d5\u05d4 \u05de\u05e8\u05db\u05d9\u05d1 \u05ea\u05d5\u05de\u05da \u05d1\u05dc\u05d1\u05d3 \u05d1\u05ea\u05d5\u05da \u05e4\u05e8\u05d5\u05d8\u05d5\u05e7\u05d5\u05dc CBT-I \u05de\u05e7\u05d9\u05e3 \u05d4\u05db\u05d5\u05dc\u05dc SRT \u05d5-Stimulus Control.",
        "rationale": "\u05d4\u05d9\u05d2\u05d9\u05d9\u05e0\u05ea \u05e9\u05d9\u05e0\u05d4 \u05d4\u05d9\u05d0 \u05d1\u05e1\u05d9\u05e1 \u05d7\u05d9\u05d5\u05e0\u05d9 \u05d0\u05da \u05d0\u05d9\u05e0\u05d4 \u05e0\u05d7\u05e9\u05d1\u05ea \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05de\u05e1\u05e4\u05e7 \u05db\u05e9\u05dc\u05e2\u05e6\u05de\u05d5 \u05e2\u05d1\u05d5\u05e8 \u05de\u05e7\u05e8\u05d9\u05dd \u05db\u05e8\u05d5\u05e0\u05d9\u05d9\u05dd \u05d5\u05de\u05d5\u05e8\u05db\u05d1\u05d9\u05dd (StahlNeuro p.430, Dulcan p.478).",
        "requiredAttributes": [
          "\u05e6\u05d9\u05d5\u05df \u05d3\u05d5\u05d2\u05de\u05d0\u05d5\u05ea \u05dc\u05d4\u05e8\u05d2\u05dc\u05d9 \u05d4\u05d9\u05d2\u05d9\u05d9\u05e0\u05ea \u05e9\u05d9\u05e0\u05d4 (\u05e9\u05e2\u05d5\u05ea \u05e7\u05d1\u05d5\u05e2\u05d5\u05ea, \u05d4\u05d9\u05de\u05e0\u05e2\u05d5\u05ea \u05de\u05e1\u05d8\u05d9\u05de\u05d5\u05dc\u05e0\u05d8\u05d9\u05dd, \u05e1\u05d1\u05d9\u05d1\u05d4 \u05de\u05ea\u05d0\u05d9\u05de\u05d4).",
          "\u05d4\u05e1\u05d1\u05e8 \u05e9\u05d4\u05d9\u05d2\u05d9\u05d9\u05e0\u05ea \u05e9\u05d9\u05e0\u05d4 \u05dc\u05d1\u05d3\u05d4 \u05d0\u05d9\u05e0\u05d4 \u05de\u05e1\u05e4\u05d9\u05e7\u05d4 \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Insomnia \u05db\u05e8\u05d5\u05e0\u05d9\u05ea.",
          "\u05e6\u05d9\u05d5\u05df \u05d4\u05e7\u05e9\u05e8 \u05dc-CBT-I \u05db\u05e7\u05d5 \u05e8\u05d0\u05e9\u05d5\u05df."
        ],
        "errors": {
          "misconceptions": [
            "\u05d4\u05e6\u05d2\u05ea \u05d4\u05d9\u05d2\u05d9\u05d9\u05e0\u05ea \u05e9\u05d9\u05e0\u05d4 \u05db\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05d1\u05dc\u05e2\u05d3\u05d9 \u05d5\u05d4\u05de\u05d5\u05e2\u05d3\u05e3 \u05dc\u05d0\u05d9\u05e0\u05e1\u05d5\u05de\u05e0\u05d9\u05d4 \u05db\u05e8\u05d5\u05e0\u05d9\u05ea.",
            "\u05d1\u05dc\u05d1\u05d5\u05dc \u05d1\u05d9\u05df \u05d4\u05d9\u05d2\u05d9\u05d9\u05e0\u05ea \u05e9\u05d9\u05e0\u05d4 \u05dc\u05d1\u05d9\u05df Stimulus Control (\u05d4\u05d4\u05e0\u05d7\u05d9\u05d4 \u05dc\u05e6\u05d0\u05ea \u05de\u05d4\u05de\u05d9\u05d8\u05d4)."
          ],
          "bluffs": []
        }
      },
      "hint": "\u05d4\u05ea\u05d9\u05d9\u05d7\u05e1\u05d5 \u05dc\u05d4\u05e8\u05d2\u05dc\u05d9\u05dd \u05e1\u05d1\u05d9\u05d1\u05ea\u05d9\u05d9\u05dd \u05d5\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea\u05d9\u05d9\u05dd \u05d5\u05dc\u05de\u05e2\u05de\u05d3\u05dd \u05de\u05d5\u05dc CBT-I.",
      "imageUrls": []
    }
  ]
}