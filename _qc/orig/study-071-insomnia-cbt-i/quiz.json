{
  "title": "Sleep Quiz",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\u05de\u05ea\u05d1\u05d2\u05e8 \u05d1\u05df 16 \u05e4\u05d5\u05e0\u05d4 \u05dc\u05de\u05e8\u05e4\u05d0\u05d4 \u05e2\u05dd \u05ea\u05dc\u05d5\u05e0\u05d4 \u05e2\u05dc \u05e7\u05d5\u05e9\u05d9 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9 \u05dc\u05d4\u05d9\u05e8\u05d3\u05dd. \u05d4\u05d5\u05d0 \u05de\u05d3\u05d5\u05d5\u05d7 \u05db\u05d9 \u05d4\u05d5\u05d0 \u05e9\u05d5\u05db\u05d1 \u05d1\u05de\u05d9\u05d8\u05d4 \u05db-45 \u05d3\u05e7\u05d5\u05ea \u05dc\u05e4\u05e0\u05d9 \u05e9\u05d4\u05d5\u05d0 \u05e0\u05e8\u05d3\u05dd, \u05d4\u05de\u05e6\u05d1 \u05e7\u05d5\u05e8\u05d4 4 \u05dc\u05d9\u05dc\u05d5\u05ea \u05d1\u05e9\u05d1\u05d5\u05e2, \u05d5\u05e0\u05de\u05e9\u05da \u05d1-5 \u05d4\u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05d4\u05d0\u05d7\u05e8\u05d5\u05e0\u05d9\u05dd. \u05d4\u05d5\u05d0 \u05de\u05e6\u05d9\u05d9\u05df \u05db\u05d9 \u05d4\u05de\u05e6\u05d1 \u05e4\u05d5\u05d2\u05e2 \u05d1\u05e8\u05d9\u05db\u05d5\u05d6 \u05e9\u05dc\u05d5 \u05d1\u05dc\u05d9\u05de\u05d5\u05d3\u05d9\u05dd \u05d5\u05d2\u05d5\u05e8\u05dd \u05dc\u05d5 \u05dc\u05de\u05e6\u05d5\u05e7\u05d4. \u05de\u05d4\u05d9 \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05de\u05d3\u05d5\u05d9\u05e7\u05ea \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR?",
      "answerOptions": [
        {
          "text": "Insomnia Disorder, Persistent",
          "isCorrect": true,
          "rationale": "\u05dc\u05e4\u05d9 \u05d4-DSM-5-TR, \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d3\u05d5\u05e8\u05e9\u05ea \u05ea\u05d3\u05d9\u05e8\u05d5\u05ea \u05e9\u05dc \u05dc\u05e4\u05d7\u05d5\u05ea 3 \u05dc\u05d9\u05dc\u05d5\u05ea \u05d1\u05e9\u05d1\u05d5\u05e2 \u05dc\u05de\u05e9\u05da 3 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05dc\u05e4\u05d7\u05d5\u05ea, \u05db\u05d0\u05e9\u05e8 \u05de\u05e9\u05da \u05e9\u05dc \u05de\u05e2\u05dc 3 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05de\u05d5\u05d2\u05d3\u05e8 \u05db-Persistent (\u05e2\u05de' 410-411)."
        },
        {
          "text": "Insomnia Disorder, Episodic",
          "isCorrect": false,
          "rationale": "\u05de\u05e4\u05e8\u05d8 Episodic \u05de\u05ea\u05d9\u05d9\u05d7\u05e1 \u05dc\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e9\u05e0\u05de\u05e9\u05db\u05d9\u05dd \u05dc\u05e4\u05d7\u05d5\u05ea \u05d7\u05d5\u05d3\u05e9 \u05d0\u05d7\u05d3 \u05d0\u05da \u05e4\u05d7\u05d5\u05ea \u05de-3 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd (DSM p.411)."
        },
        {
          "text": "Other Specified Insomnia Disorder",
          "isCorrect": false,
          "rationale": "\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d6\u05d5 \u05e0\u05d9\u05ea\u05e0\u05ea \u05db\u05d0\u05e9\u05e8 \u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d0\u05d9\u05e0\u05dd \u05e2\u05d5\u05de\u05d3\u05d9\u05dd \u05d1\u05de\u05dc\u05d5\u05d0 \u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05e9\u05dc Insomnia Disorder, \u05d0\u05da \u05d1\u05de\u05e7\u05e8\u05d4 \u05d6\u05d4 \u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05e9\u05dc \u05ea\u05d3\u05d9\u05e8\u05d5\u05ea \u05d5\u05de\u05e9\u05da \u05d4\u05ea\u05de\u05dc\u05d0\u05d5 (DSM p.475)."
        },
        {
          "text": "Delayed Sleep Phase Disorder",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05e9\u05d9\u05e9 \u05d0\u05d9\u05d7\u05d5\u05e8 \u05d1\u05d4\u05d9\u05e8\u05d3\u05de\u05d5\u05ea, \u05d4\u05ea\u05dc\u05d5\u05e0\u05d4 \u05d4\u05e2\u05d9\u05e7\u05e8\u05d9\u05ea \u05d4\u05d9\u05d0 \u05d7\u05d5\u05e1\u05e8 \u05e9\u05d1\u05d9\u05e2\u05d5\u05ea \u05e8\u05e6\u05d5\u05df \u05de\u05d0\u05d9\u05db\u05d5\u05ea/\u05db\u05de\u05d5\u05ea \u05d4\u05e9\u05d9\u05e0\u05d4 (Dissatisfaction) \u05d5\u05d4\u05e4\u05e8\u05e2\u05d4 \u05d1\u05ea\u05e4\u05e7\u05d5\u05d3 \u05ea\u05d7\u05ea \u05dc\u05d5\u05d7 \u05d6\u05de\u05e0\u05d9\u05dd \u05e8\u05d2\u05d9\u05dc, \u05d4\u05de\u05db\u05d5\u05d5\u05e0\u05d9\u05dd \u05dc\u05e0\u05d3\u05d5\u05d3\u05d9 \u05e9\u05d9\u05e0\u05d4 (DSM p.409)."
        }
      ],
      "hint": "\u05e9\u05d9\u05de\u05d5 \u05dc\u05d1 \u05dc\u05de\u05e9\u05da \u05d4\u05d6\u05de\u05df (5 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd) \u05d5\u05dc\u05ea\u05d3\u05d9\u05e8\u05d5\u05ea \u05d4\u05e9\u05d1\u05d5\u05e2\u05d9\u05ea \u05d4\u05e0\u05d3\u05e8\u05e9\u05ea \u05d1\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05db\u05e8\u05d5\u05e0\u05d9\u05ea.",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05e0\u05e2\u05e8\u05d4 \u05d1\u05ea 15 \u05d4\u05de\u05d0\u05d5\u05d1\u05d7\u05e0\u05ea \u05e2\u05dd Major Depressive Disorder (MDD) \u05de\u05d3\u05d5\u05d5\u05d7\u05ea \u05e2\u05dc \u05e0\u05d3\u05d5\u05d3\u05d9 \u05e9\u05d9\u05e0\u05d4 \u05e7\u05e9\u05d9\u05dd. \u05dc\u05e4\u05d9 \u05d4\u05d2\u05d9\u05e9\u05d4 \u05d4\u05de\u05e2\u05d5\u05d3\u05db\u05e0\u05ea \u05d1-DSM-5-TR \u05d5\u05d1-StahlNeuro, \u05db\u05d9\u05e6\u05d3 \u05d9\u05e9 \u05dc\u05d4\u05ea\u05d9\u05d9\u05d7\u05e1 \u05dc\u05e7\u05e9\u05e8 \u05d1\u05d9\u05df \u05e9\u05ea\u05d9 \u05d4\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea?",
      "answerOptions": [
        {
          "text": "\u05db\u05e7\u05d5\u05de\u05d5\u05e8\u05d1\u05d9\u05d3\u05d9\u05d5\u05ea (Comorbidity) \u05d4\u05d3\u05d5\u05e8\u05e9\u05ea \u05d4\u05ea\u05d9\u05d9\u05d7\u05e1\u05d5\u05ea \u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05e2\u05e6\u05de\u05d0\u05d9\u05ea",
          "isCorrect": true,
          "rationale": "\u05d4-DSM-5-TR \u05d6\u05e0\u05d7 \u05d0\u05ea \u05d4\u05de\u05d5\u05e9\u05d2 'Secondary Insomnia' \u05d5\u05de\u05db\u05d9\u05e8 \u05d1\u05db\u05da \u05e9\u05e0\u05d3\u05d5\u05d3\u05d9 \u05e9\u05d9\u05e0\u05d4 \u05d4\u05dd \u05dc\u05e8\u05d5\u05d1 \u05d4\u05e4\u05e8\u05e2\u05d4 \u05e0\u05dc\u05d5\u05d5\u05d9\u05ea (Comorbid) \u05d4\u05de\u05e7\u05d9\u05d9\u05de\u05ea \u05e7\u05e9\u05e8 \u05d3\u05d5-\u05db\u05d9\u05d5\u05d5\u05e0\u05d9 \u05e2\u05dd \u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05e0\u05e4\u05e9\u05d9\u05d5\u05ea (StahlNeuro p.420, DSM p.410)."
        },
        {
          "text": "\u05db\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05dd \u05de\u05e9\u05e0\u05d9 (Secondary) \u05e9\u05d9\u05d7\u05dc\u05d5\u05e3 \u05d1\u05d4\u05db\u05e8\u05d7 \u05e2\u05dd \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Depression",
          "isCorrect": false,
          "rationale": "\u05e0\u05d3\u05d5\u05d3\u05d9 \u05e9\u05d9\u05e0\u05d4 \u05e2\u05e9\u05d5\u05d9\u05d9\u05dd \u05dc\u05d4\u05d9\u05de\u05e9\u05da \u05d2\u05dd \u05dc\u05d0\u05d7\u05e8 \u05e0\u05e1\u05d9\u05d2\u05ea \u05d4\u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05d1-40%\u201350% \u05de\u05d4\u05de\u05e7\u05e8\u05d9\u05dd \u05d5\u05dc\u05d4\u05d5\u05d5\u05ea \u05d2\u05d5\u05e8\u05dd \u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05d4\u05d9\u05e9\u05e0\u05d5\u05ea (DSM p.414)."
        },
        {
          "text": "\u05db\u05ea\u05d5\u05e4\u05e2\u05ea \u05dc\u05d5\u05d5\u05d0\u05d9 \u05d1\u05dc\u05e2\u05d3\u05d9\u05ea \u05e9\u05dc \u05d8\u05d9\u05e4\u05d5\u05dc \u05ea\u05e8\u05d5\u05e4\u05ea\u05d9 \u05d1-SSRIs",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05e9\u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05d9\u05db\u05d5\u05dc\u05d5\u05ea \u05dc\u05d4\u05e9\u05e4\u05d9\u05e2, \u05d4\u05e7\u05e9\u05e8 \u05d1\u05d9\u05df \u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05dc\u05e9\u05d9\u05e0\u05d4 \u05d4\u05d5\u05d0 \u05d0\u05d5\u05e8\u05d2\u05e0\u05d9 \u05d5\u05e7\u05d3\u05d9\u05dd \u05dc\u05e8\u05d5\u05d1 \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05ea\u05e8\u05d5\u05e4\u05ea\u05d9 (Dulcan p.492)."
        },
        {
          "text": "\u05db\u05de\u05e8\u05db\u05d9\u05d1 \u05d0\u05d1\u05d7\u05e0\u05ea\u05d9 \u05d4\u05de\u05d5\u05e0\u05e2 \u05de\u05ea\u05df \u05d0\u05d1\u05d7\u05e0\u05d4 \u05e0\u05e4\u05e8\u05d3\u05ea \u05e9\u05dc Insomnia Disorder",
          "isCorrect": false,
          "rationale": "\u05e0\u05d9\u05ea\u05df \u05d5\u05d0\u05e3 \u05de\u05d5\u05de\u05dc\u05e5 \u05dc\u05ea\u05ea \u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc Insomnia Disorder \u05dc\u05e6\u05d3 \u05d4\u05e4\u05e8\u05e2\u05d4 \u05e0\u05e4\u05e9\u05d9\u05ea \u05d0\u05dd \u05d4\u05d9\u05d0 \u05d7\u05de\u05d5\u05e8\u05d4 \u05de\u05e1\u05e4\u05d9\u05e7 \u05db\u05d3\u05d9 \u05dc\u05d4\u05e6\u05d3\u05d9\u05e7 \u05ea\u05e9\u05d5\u05de\u05ea \u05dc\u05d1 \u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05e2\u05e6\u05de\u05d0\u05d9\u05ea (DSM p.410)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d1\u05d5 \u05e2\u05dc \u05d4\u05e9\u05d9\u05e0\u05d5\u05d9 \u05d4\u05de\u05d5\u05e9\u05d2\u05d9 \u05de-'\u05e0\u05d3\u05d5\u05d3\u05d9 \u05e9\u05d9\u05e0\u05d4 \u05de\u05e9\u05e0\u05d9\u05d9\u05dd' \u05dc\u05de\u05d7\u05dc\u05d4 \u05e0\u05dc\u05d5\u05d5\u05d9\u05ea.",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05d1\u05de\u05e1\u05d2\u05e8\u05ea \u05d8\u05d9\u05e4\u05d5\u05dc CBT-I \u05d1\u05de\u05ea\u05d1\u05d2\u05e8, \u05e0\u05de\u05e6\u05d0 \u05d1\u05d9\u05d5\u05de\u05df \u05d4\u05e9\u05d9\u05e0\u05d4 \u05db\u05d9 \u05d4\u05d5\u05d0 \u05e9\u05d5\u05d4\u05d4 \u05d1\u05de\u05d9\u05d8\u05d4 (Time in Bed - TIB) \u05db-9 \u05e9\u05e2\u05d5\u05ea \u05d1\u05de\u05de\u05d5\u05e6\u05e2, \u05d0\u05da \u05d9\u05e9\u05df \u05d1\u05e4\u05d5\u05e2\u05dc (Total Sleep Time - TST) \u05e8\u05e7 6 \u05e9\u05e2\u05d5\u05ea. \u05de\u05d4 \u05d9\u05d4\u05d9\u05d4 \u05d4\u05e6\u05e2\u05d3 \u05d4\u05e8\u05d0\u05e9\u05d5\u05df \u05d1\u05d1\u05d9\u05e6\u05d5\u05e2 Sleep Restriction Therapy (SRT)?",
      "answerOptions": [
        {
          "text": "\u05e6\u05de\u05e6\u05d5\u05dd \u05d6\u05de\u05df \u05d4\u05e9\u05d4\u05d9\u05d9\u05d4 \u05d1\u05de\u05d9\u05d8\u05d4 \u05dc-6 \u05e9\u05e2\u05d5\u05ea",
          "isCorrect": true,
          "rationale": "\u05de\u05d8\u05e8\u05ea SRT \u05d4\u05d9\u05d0 \u05dc\u05d4\u05e9\u05d5\u05d5\u05ea \u05d0\u05ea \u05d4-TIB \u05dc-TST \u05d4\u05de\u05de\u05d5\u05e6\u05e2 \u05db\u05d3\u05d9 \u05dc\u05d4\u05e2\u05dc\u05d5\u05ea \u05d0\u05ea \u05d4\u05d3\u05d7\u05e3 \u05d4\u05d4\u05d5\u05de\u05d0\u05d5\u05e1\u05d8\u05d8\u05d9 \u05dc\u05e9\u05d9\u05e0\u05d4 \u05d5\u05dc\u05e9\u05e4\u05e8 \u05d0\u05ea \u05d4-Sleep Efficiency (StahlNeuro p.430)."
        },
        {
          "text": "\u05d4\u05d0\u05e8\u05db\u05ea \u05d6\u05de\u05df \u05d4\u05e9\u05d4\u05d9\u05d9\u05d4 \u05d1\u05de\u05d9\u05d8\u05d4 \u05dc-10 \u05e9\u05e2\u05d5\u05ea \u05db\u05d3\u05d9 '\u05dc\u05e4\u05e6\u05d5\u05ea' \u05e2\u05dc \u05d7\u05d5\u05e1\u05e8 \u05d4\u05e9\u05d9\u05e0\u05d4",
          "isCorrect": false,
          "rationale": "\u05e4\u05d9\u05e6\u05d5\u05d9 \u05db\u05d6\u05d4 \u05e8\u05e7 \u05de\u05d7\u05de\u05d9\u05e8 \u05d0\u05ea \u05d4\u05e4\u05d9\u05e6\u05d5\u05dc \u05d1\u05e9\u05d9\u05e0\u05d4 \u05d5\u05de\u05d5\u05e8\u05d9\u05d3 \u05d0\u05ea \u05d4-Sleep Efficiency (StahlNeuro p.430)."
        },
        {
          "text": "\u05d4\u05e7\u05d3\u05de\u05ea \u05e9\u05e2\u05ea \u05d4\u05e9\u05d9\u05e0\u05d4 \u05d1-3 \u05e9\u05e2\u05d5\u05ea",
          "isCorrect": false,
          "rationale": "\u05d4\u05e7\u05d3\u05de\u05d4 \u05dc\u05dc\u05d0 \u05d3\u05d7\u05e3 \u05e9\u05d9\u05e0\u05d4 \u05de\u05e1\u05e4\u05d9\u05e7 \u05ea\u05d5\u05d1\u05d9\u05dc \u05dc\u05e2\u05e8\u05d5\u05ea \u05de\u05de\u05d5\u05e9\u05db\u05ea \u05d1\u05de\u05d9\u05d8\u05d4 \u05d5\u05ea\u05d7\u05d6\u05e7 Conditioned arousal (Syllabus p.26)."
        },
        {
          "text": "\u05e6\u05de\u05e6\u05d5\u05dd \u05d6\u05de\u05df \u05d4\u05e9\u05d4\u05d9\u05d9\u05d4 \u05d1\u05de\u05d9\u05d8\u05d4 \u05dc-4 \u05e9\u05e2\u05d5\u05ea \u05dc\u05d4\u05e9\u05d2\u05ea \u05d0\u05e4\u05e7\u05d8 \u05de\u05e7\u05e1\u05d9\u05de\u05dc\u05d9",
          "isCorrect": false,
          "rationale": "\u05de\u05d8\u05e2\u05de\u05d9 \u05d1\u05d8\u05d9\u05d7\u05d5\u05ea, \u05d0\u05d9\u05df \u05dc\u05d4\u05d2\u05d1\u05d9\u05dc \u05d0\u05ea \u05d4\u05d6\u05de\u05df \u05d1\u05de\u05d9\u05d8\u05d4 \u05dc\u05e4\u05d7\u05d5\u05ea \u05de-5 \u05e9\u05e2\u05d5\u05ea \u05d1\u05dc\u05d9\u05dc\u05d4 (StahlNeuro p.430)."
        }
      ],
