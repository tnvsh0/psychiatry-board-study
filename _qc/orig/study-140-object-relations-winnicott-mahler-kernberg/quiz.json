{
  "title": "Psychology Quiz",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\u05d0\u05d9\u05de\u05d0 \u05dc\u05ea\u05d9\u05e0\u05d5\u05e7 \u05d1\u05df 7 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05de\u05d2\u05d9\u05e2\u05d4 \u05dc\u05de\u05e8\u05e4\u05d0\u05d4 \u05de\u05d5\u05d3\u05d0\u05d2\u05ea. \u05d4\u05d9\u05d0 \u05de\u05e1\u05e4\u05e8\u05ea \u05db\u05d9 \u05d1\u05e0\u05d4 \u05d0\u05d9\u05de\u05e5 \u05d7\u05d9\u05ea\u05d5\u05dc \u05d1\u05d3 \u05d9\u05e9\u05df \u05e9\u05d4\u05d5\u05d0 \u05de\u05ea\u05e2\u05e7\u05e9 \u05dc\u05d4\u05d7\u05d6\u05d9\u05e7 \u05d1\u05db\u05dc \u05e4\u05e2\u05dd \u05e9\u05d4\u05d5\u05d0 \u05e2\u05d9\u05d9\u05e3 \u05d0\u05d5 \u05e0\u05e1\u05e2\u05e8. \u05d4\u05d9\u05d0 \u05de\u05d1\u05e7\u05e9\u05ea \u05dc\u05d3\u05e2\u05ea \u05d4\u05d0\u05dd \u05e2\u05dc\u05d9\u05d4 \u05dc\u05db\u05d1\u05e1 \u05d0\u05ea \u05d4\u05d7\u05d9\u05ea\u05d5\u05dc \u05dc\u05e2\u05d9\u05ea\u05d9\u05dd \u05e7\u05e8\u05d5\u05d1\u05d5\u05ea \u05d0\u05d5 \u05dc\u05d4\u05d7\u05dc\u05d9\u05e4\u05d5 \u05d1\u05e6\u05e2\u05e6\u05d5\u05e2 \u05d7\u05d3\u05e9 \u05d5\u05e0\u05e7\u05d9 \u05d9\u05d5\u05ea\u05e8. \u05dc\u05e4\u05d9 \u05d5\u05d9\u05e0\u05d9\u05e7\u05d5\u05d8, \u05de\u05d4\u05d9 \u05d4\u05ea\u05d2\u05d5\u05d1\u05d4 \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05d4\u05e0\u05db\u05d5\u05e0\u05d4?",
      "answerOptions": [
        {
          "text": "\u05d9\u05e9 \u05dc\u05d0\u05e4\u05e9\u05e8 \u05dc\u05d9\u05dc\u05d3 \u05dc\u05e9\u05de\u05d5\u05e8 \u05e2\u05dc \u05d4\u05d0\u05d5\u05d1\u05d9\u05d9\u05e7\u05d8 \u05d5\u05dc\u05d0 \u05dc\u05db\u05d1\u05e1\u05d5 \u05dc\u05dc\u05d0 \u05d4\u05e1\u05db\u05de\u05ea\u05d5, \u05db\u05d3\u05d9 \u05dc\u05e9\u05de\u05e8 \u05d0\u05ea \u05d4\u05de\u05e8\u05e7\u05dd \u05d5\u05d4\u05e8\u05d9\u05d7 \u05d4\u05d9\u05d9\u05d7\u05d5\u05d3\u05d9\u05d9\u05dd \u05d4\u05de\u05e2\u05e0\u05d9\u05e7\u05d9\u05dd \u05dc\u05d5 \u05d1\u05d9\u05d8\u05d7\u05d5\u05df.",
          "isCorrect": true,
          "rationale": "\u05d5\u05d9\u05e0\u05d9\u05e7\u05d5\u05d8 \u05d4\u05d3\u05d2\u05d9\u05e9 \u05db\u05d9 \u05d0\u05d5\u05d1\u05d9\u05d9\u05e7\u05d8 \u05d4\u05de\u05e2\u05d1\u05e8 (Transitional Object) \u05d0\u05d9\u05e0\u05d5 \u05de\u05d5\u05d7\u05dc\u05e3 \u05d1\u05e7\u05dc\u05d5\u05ea \u05d5\u05d0\u05d9\u05df \u05dc\u05e9\u05d8\u05d5\u05e3 \u05d0\u05d5\u05ea\u05d5, \u05e9\u05db\u05df \u05d4\u05e8\u05d9\u05d7 \u05d5\u05d4\u05d0\u05d9\u05db\u05d5\u05ea \u05d4\u05e4\u05d9\u05d6\u05d9\u05ea \u05e9\u05dc\u05d5 \u05d7\u05d9\u05d5\u05e0\u05d9\u05d9\u05dd \u05dc\u05d9\u05db\u05d5\u05dc\u05ea \u05d4\u05d4\u05e8\u05d2\u05e2\u05d4 \u05d4\u05e2\u05e6\u05de\u05d9\u05ea \u05e9\u05dc \u05d4\u05d9\u05dc\u05d3 (Synopsis ch.34.4)."
        },
        {
          "text": "\u05de\u05d5\u05de\u05dc\u05e5 \u05dc\u05d4\u05d7\u05dc\u05d9\u05e3 \u05d0\u05ea \u05d4\u05d7\u05d9\u05ea\u05d5\u05dc \u05d1\u05d3\u05d5\u05d1\u05d9 \u05e4\u05e8\u05d5\u05d5\u05ea\u05d9, \u05e9\u05db\u05df \u05d1\u05d2\u05d9\u05dc \u05d6\u05d4 \u05d4\u05ea\u05d9\u05e0\u05d5\u05e7 \u05d6\u05e7\u05d5\u05e7 \u05dc\u05d2\u05d9\u05e8\u05d5\u05d9 \u05e1\u05e0\u05e1\u05d5\u05e8\u05d9 \u05e2\u05e9\u05d9\u05e8 \u05d9\u05d5\u05ea\u05e8 \u05dc\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea \u05ea\u05e7\u05d9\u05e0\u05d4 \u05e9\u05dc \u05d4\u05d0\u05d2\u05d5.",
          "isCorrect": false,
          "rationale": "\u05d4\u05ea\u05d9\u05e0\u05d5\u05e7 \u05d4\u05d5\u05d0 \u05d6\u05d4 \u05e9\u05d1\u05d5\u05d7\u05e8 \u05d1\u05d0\u05d5\u05e4\u05df \u05e4\u05e2\u05d9\u05dc \u05d0\u05ea \u05d0\u05d5\u05d1\u05d9\u05d9\u05e7\u05d8 \u05d4\u05de\u05e2\u05d1\u05e8; \u05db\u05e4\u05d9\u05d9\u05d4 \u05e9\u05dc \u05d7\u05e4\u05e5 \u05d0\u05d7\u05e8 \u05e2\u05dc\u05d5\u05dc\u05d4 \u05dc\u05e4\u05d2\u05d5\u05e2 \u05d1\u05ea\u05e4\u05e7\u05d9\u05d3 \u05d4\u05e4\u05e1\u05d9\u05db\u05d5\u05dc\u05d5\u05d2\u05d9 \u05e9\u05dc \u05d4\u05d7\u05e4\u05e5 \u05db\u05de\u05ea\u05d5\u05d5\u05da \u05e0\u05e4\u05e8\u05d3\u05d5\u05ea (Synopsis ch.34.4)."
        },
        {
          "text": "\u05d4\u05d9\u05e6\u05de\u05d3\u05d5\u05ea \u05dc\u05d7\u05e4\u05e5 \u05d3\u05d5\u05de\u05dd \u05d1\u05d2\u05d9\u05dc \u05d6\u05d4 \u05de\u05e2\u05d9\u05d3\u05d4 \u05e2\u05dc \u05db\u05e9\u05dc \u05d1-Holding Environment \u05e9\u05dc \u05d4\u05d0\u05dd, \u05d5\u05d9\u05e9 \u05dc\u05d4\u05d3\u05e8\u05d9\u05da \u05d0\u05d5\u05ea\u05d4 \u05dc\u05d4\u05d9\u05d5\u05ea \u05d6\u05de\u05d9\u05e0\u05d4 \u05d9\u05d5\u05ea\u05e8 \u05e8\u05d2\u05e9\u05d9\u05ea.",
          "isCorrect": false,
          "rationale": "\u05d0\u05d5\u05d1\u05d9\u05d9\u05e7\u05d8 \u05d4\u05de\u05e2\u05d1\u05e8 \u05d4\u05d5\u05d0 \u05ea\u05d5\u05e4\u05e2\u05d4 \u05e0\u05d5\u05e8\u05de\u05d8\u05d9\u05d1\u05d9\u05ea \u05d5\u05d1\u05e8\u05d9\u05d0\u05d4 \u05d4\u05de\u05d5\u05e4\u05d9\u05e2\u05d4 \u05d1\u05d9\u05df \u05d2\u05d9\u05dc 4 \u05dc-12 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05d5\u05de\u05d9\u05d9\u05e6\u05d2\u05ea \u05d0\u05ea \u05d0\u05d9\u05db\u05d5\u05ea \u05e1\u05d1\u05d9\u05d1\u05ea \u05d4\u05d4\u05d7\u05d6\u05e7\u05d4, \u05d5\u05dc\u05d0 \u05d0\u05ea \u05db\u05e9\u05dc\u05d4 (Synopsis ch.34.1)."
        },
        {
          "text": "\u05d9\u05e9 \u05dc\u05d4\u05d2\u05d1\u05d9\u05dc \u05d0\u05ea \u05d4\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05d7\u05d9\u05ea\u05d5\u05dc \u05dc\u05e9\u05e2\u05d5\u05ea \u05d4\u05e9\u05d9\u05e0\u05d4 \u05d1\u05dc\u05d1\u05d3 \u05db\u05d3\u05d9 \u05dc\u05de\u05e0\u05d5\u05e2 \u05e0\u05e1\u05d9\u05d2\u05d4 \u05dc\u05e9\u05dc\u05d1 \u05d4-Primary Maternal Preoccupation.",
          "isCorrect": false,
          "rationale": "Primary Maternal Preoccupation \u05d4\u05d5\u05d0 \u05de\u05e6\u05d1 \u05e0\u05e4\u05e9\u05d9 \u05e9\u05dc \u05d4\u05d0\u05dd \u05d1\u05e9\u05d1\u05d5\u05e2\u05d5\u05ea \u05d4\u05e1\u05d5\u05d1\u05d1\u05d9\u05dd \u05d0\u05ea \u05d4\u05dc\u05d9\u05d3\u05d4, \u05d5\u05dc\u05d0 \u05e9\u05dc \u05d4\u05ea\u05d9\u05e0\u05d5\u05e7; \u05d4\u05d2\u05d1\u05dc\u05ea \u05d4\u05d0\u05d5\u05d1\u05d9\u05d9\u05e7\u05d8 \u05e2\u05dc\u05d5\u05dc\u05d4 \u05dc\u05e2\u05d5\u05e8\u05e8 \u05d7\u05e8\u05d3\u05d4 \u05de\u05d9\u05d5\u05ea\u05e8\u05ea (Syllabus p.53)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9\u05dd \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9\u05d9\u05dd \u05e9\u05dc \u05d0\u05d5\u05d1\u05d9\u05d9\u05e7\u05d8 \u05d4\u05de\u05e2\u05d1\u05e8 \u05d5\u05e2\u05dc \u05d4\u05e9\u05dc\u05d9\u05d8\u05d4 \u05d4\u05de\u05d5\u05d7\u05dc\u05d8\u05ea \u05e9\u05d4\u05d9\u05dc\u05d3 \u05d3\u05d5\u05e8\u05e9 \u05d1\u05d5."
    },
    {
      "type": "multiple_choice",
      "question": "\u05e4\u05e2\u05d5\u05d8 \u05d1\u05df 20 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05de\u05e6\u05d9\u05d2 \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05de\u05d5\u05e8\u05db\u05d1\u05ea \u05d1\u05de\u05e8\u05e4\u05d0\u05d4: \u05d4\u05d5\u05d0 \u05e2\u05d5\u05e7\u05d1 \u05d0\u05d7\u05e8\u05d9 \u05d0\u05de\u05d5 \u05dc\u05db\u05dc \u05de\u05e7\u05d5\u05dd (Shadowing), \u05d0\u05da \u05db\u05d0\u05e9\u05e8 \u05d4\u05d9\u05d0 \u05de\u05e0\u05e1\u05d4 \u05dc\u05d7\u05d1\u05e7\u05d5 \u05d4\u05d5\u05d0 \u05d3\u05d5\u05d7\u05e3 \u05d0\u05d5\u05ea\u05d4 \u05d5\u05de\u05ea\u05e8\u05d7\u05e7 \u05d1\u05db\u05e2\u05e1. \u05dc\u05d0\u05d7\u05e8 \u05de\u05db\u05df \u05d4\u05d5\u05d0 \u05e4\u05d5\u05e8\u05e5 \u05d1\u05d1\u05db\u05d9 \u05d7\u05e1\u05e8 \u05e0\u05d7\u05de\u05d4. \u05dc\u05e4\u05d9 \u05de\u05e8\u05d2\u05e8\u05d8 \u05de\u05d0\u05d4\u05dc\u05e8, \u05d1\u05d0\u05d9\u05d6\u05d4 \u05e9\u05dc\u05d1 \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9 \u05e0\u05de\u05e6\u05d0 \u05d4\u05d9\u05dc\u05d3?",
      "answerOptions": [
        {
          "text": "\u05ea\u05ea-\u05e9\u05dc\u05d1 \u05d4\u05d4\u05ea\u05e7\u05e8\u05d1\u05d5\u05ea (Rapprochement), \u05d4\u05de\u05d0\u05d5\u05e4\u05d9\u05d9\u05df \u05d1\u05de\u05e9\u05d1\u05e8 \u05d0\u05de\u05d1\u05d9\u05d5\u05d5\u05dc\u05e0\u05d8\u05d9 \u05d1\u05d9\u05df \u05d4\u05e8\u05e6\u05d5\u05df \u05dc\u05d0\u05d5\u05d8\u05d5\u05e0\u05d5\u05de\u05d9\u05d4 \u05dc\u05e4\u05d7\u05d3 \u05de\u05d0\u05d5\u05d1\u05d3\u05df \u05d0\u05d4\u05d1\u05ea \u05d4\u05d0\u05dd.",
          "isCorrect": true,
          "rationale": "\u05d1\u05d2\u05d9\u05dc\u05d0\u05d9 16\u201324 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05d4\u05d9\u05dc\u05d3 \u05de\u05d1\u05d9\u05df \u05d0\u05ea \u05e0\u05e4\u05e8\u05d3\u05d5\u05ea\u05d5 \u05d5\u05d7\u05d5\u05d5\u05d4 \u05d0\u05ea \u05d4-Rapprochement Crisis, \u05d4\u05de\u05ea\u05d1\u05d8\u05d0 \u05d1\u05ea\u05e0\u05d5\u05d3\u05d4 \u05d1\u05d9\u05df \u05e6\u05de\u05d9\u05d3\u05d5\u05ea \u05dc\u05d0\u05dd \u05dc\u05d1\u05d9\u05df \u05d3\u05d7\u05d9\u05d9\u05ea\u05d4 (Syllabus p.52, Synopsis ch.34.4 Table 34-11)."
        },
        {
          "text": "\u05ea\u05ea-\u05e9\u05dc\u05d1 \u05d4\u05ea\u05e8\u05d2\u05d5\u05dc (Practicing), \u05e9\u05d1\u05d5 \u05d4\u05d9\u05dc\u05d3 \u05d7\u05d5\u05d5\u05d4 '\u05e8\u05d5\u05de\u05df \u05e2\u05dd \u05d4\u05e2\u05d5\u05dc\u05dd' \u05d5\u05e2\u05e1\u05d5\u05e7 \u05d1\u05d7\u05e7\u05e8 \u05d4\u05e1\u05d1\u05d9\u05d1\u05d4 \u05d1\u05d0\u05d5\u05e4\u05d5\u05e8\u05d9\u05d4.",
          "isCorrect": false,
          "rationale": "\u05e9\u05dc\u05d1 \u05d4-Practicing (10\u201316 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd) \u05de\u05ea\u05d0\u05e4\u05d9\u05d9\u05df \u05d3\u05d5\u05d5\u05e7\u05d0 \u05d1\u05d0\u05d5\u05de\u05e0\u05d9\u05e4\u05d5\u05d8\u05e0\u05e6\u05d9\u05d4 \u05d5\u05d9\u05e8\u05d9\u05d3\u05d4 \u05d1\u05e8\u05d2\u05d9\u05e9\u05d5\u05ea \u05dc\u05ea\u05e1\u05db\u05d5\u05dc, \u05d5\u05dc\u05d0 \u05d1\u05d0\u05de\u05d1\u05d9\u05d5\u05d5\u05dc\u05e0\u05d8\u05d9\u05d5\u05ea \u05d4\u05e2\u05d6\u05d4 \u05d5\u05d1\u05d7\u05e8\u05d3\u05ea \u05d4\u05e0\u05e4\u05e8\u05d3\u05d5\u05ea \u05e9\u05dc \u05d2\u05d9\u05dc 20 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd (Synopsis ch.34.4 Table 34-11)."
        },
        {
          "text": "\u05e9\u05dc\u05d1 \u05d4\u05e1\u05d9\u05de\u05d1\u05d9\u05d5\u05d6\u05d4 \u05d4\u05e0\u05d5\u05e8\u05de\u05dc\u05d9\u05ea, \u05e9\u05d1\u05d5 \u05d0\u05d9\u05df \u05d4\u05d1\u05d7\u05e0\u05d4 \u05d1\u05d9\u05df \u05d2\u05d1\u05d5\u05dc\u05d5\u05ea \u05d4\u05d2\u05d5\u05e3 \u05e9\u05dc \u05d4\u05d9\u05dc\u05d3 \u05dc\u05d0\u05dd.",
          "isCorrect": false,
          "rationale": "\u05d4\u05e1\u05d9\u05de\u05d1\u05d9\u05d5\u05d6\u05d4 \u05de\u05ea\u05e8\u05d7\u05e9\u05ea \u05d1\u05d2\u05d9\u05dc\u05d0\u05d9 1\u20135 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd; \u05d1\u05d2\u05d9\u05dc 20 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05d4\u05d9\u05dc\u05d3 \u05db\u05d1\u05e8 \u05e0\u05de\u05e6\u05d0 \u05e2\u05de\u05d5\u05e7 \u05d1\u05ea\u05d5\u05da \u05ea\u05d4\u05dc\u05d9\u05da \u05d4\u05e1\u05e4\u05e8\u05e6\u05d9\u05d4-\u05d0\u05d9\u05e0\u05d3\u05d9\u05d1\u05d9\u05d3\u05d5\u05d0\u05e6\u05d9\u05d4 (Syllabus p.17)."
        },
        {
          "text": "\u05ea\u05ea-\u05e9\u05dc\u05d1 \u05d4\u05d1\u05e7\u05d9\u05e2\u05d4 (Differentiation), \u05e9\u05d1\u05d5 \u05de\u05d5\u05e4\u05d9\u05e2\u05d4 \u05dc\u05e8\u05d0\u05e9\u05d5\u05e0\u05d4 \u05d7\u05e8\u05d3\u05ea \u05d6\u05e8\u05d9\u05dd \u05d5\u05e1\u05e8\u05d9\u05e7\u05d4 \u05dc\u05d0\u05d7\u05d5\u05e8 \u05dc\u05e2\u05d1\u05e8 \u05d4\u05d0\u05dd.",
          "isCorrect": false,
          "rationale": "\u05d1\u05e7\u05d9\u05e2\u05d4 \u05de\u05ea\u05e8\u05d7\u05e9\u05ea \u05d1\u05d2\u05d9\u05dc\u05d0\u05d9 5\u201310 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05d5\u05de\u05d4\u05d5\u05d5\u05d4 \u05d0\u05ea \u05e0\u05d9\u05e6\u05e0\u05d9 \u05d4\u05d4\u05d1\u05d7\u05e0\u05d4 \u05d1\u05d9\u05df \u05e2\u05e6\u05de\u05d9 \u05dc\u05d0\u05d5\u05d1\u05d9\u05d9\u05e7\u05d8, \u05dc\u05e4\u05e0\u05d9 \u05e4\u05d9\u05ea\u05d5\u05d7 \u05d9\u05db\u05d5\u05dc\u05d5\u05ea \u05de\u05d5\u05d8\u05d5\u05e8\u05d9\u05d5\u05ea \u05de\u05d5\u05e8\u05db\u05d1\u05d5\u05ea (Synopsis ch.34.4 Table 34-11)."
        }
      ],
      "hint": "\u05d4\u05ea\u05de\u05e7\u05d3 \u05d1\u05d2\u05d9\u05dc \u05d4\u05d9\u05dc\u05d3 \u05d5\u05d1\u05e1\u05ea\u05d9\u05e8\u05d4 \u05d1\u05d9\u05df \u05d4\u05e8\u05e6\u05d5\u05df \u05dc\u05e2\u05e6\u05de\u05d0\u05d5\u05ea \u05dc\u05d1\u05d9\u05df \u05d4\u05e6\u05d5\u05e8\u05da \u05d1\u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05d4\u05d0\u05dd."
    },
    {
      "type": "multiple_choice",
      "question": "\u05de\u05d8\u05d5\u05e4\u05dc\u05ea \u05d1\u05ea 19 \u05de\u05ea\u05d0\u05e8\u05ea \u05d0\u05ea \u05d4\u05de\u05d8\u05e4\u05dc \u05e9\u05dc\u05d4 \u05d1\u05e9\u05d9\u05d7\u05d4 \u05d0\u05d7\u05ea \u05db'\u05de\u05d5\u05e9\u05d9\u05e2 \u05d4\u05d2\u05d3\u05d5\u05dc \u05d1\u05d9\u05d5\u05ea\u05e8 \u05e9\u05e4\u05d2\u05e9\u05d4', \u05d0\u05da \u05dc\u05d0\u05d7\u05e8 \u05e9\u05d4\u05de\u05d8\u05e4\u05dc \u05d0\u05d9\u05d7\u05e8 \u05d1-2 \u05d3\u05e7\u05d5\u05ea \u05dc\u05e4\u05d2\u05d9\u05e9\u05d4 \u05d4\u05d1\u05d0\u05d4, \u05d4\u05d9\u05d0 \u05d4\u05d2\u05d3\u05d9\u05e8\u05d4 \u05d0\u05d5\u05ea\u05d5 \u05db'\u05d0\u05d3\u05dd \u05d0\u05db\u05d6\u05e8 \u05d5\u05d7\u05e1\u05e8 \u05dc\u05d1' \u05d5\u05d1\u05d9\u05d8\u05d0\u05d4 \u05d6\u05e2\u05dd \u05e2\u05d6. \u05dc\u05e4\u05d9 \u05d0\u05d5\u05d8\u05d5 \u05e7\u05e8\u05e0\u05d1\u05e8\u05d2, \u05de\u05d4\u05d5 \u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05d4\u05d2\u05e0\u05d4 \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05e9\u05de\u05d5\u05e4\u05e2\u05dc \u05db\u05d0\u05df?",
      "answerOptions": [
        {
          "text": "\u05e4\u05d9\u05e6\u05d5\u05dc (Splitting), \u05d4\u05de\u05e9\u05de\u05e9 \u05dc\u05d4\u05e4\u05e8\u05d3\u05d4 \u05de\u05d5\u05d7\u05dc\u05d8\u05ea \u05d1\u05d9\u05df \u05d9\u05d9\u05e6\u05d5\u05d2\u05d9 \u05d0\u05d5\u05d1\u05d9\u05d9\u05e7\u05d8 '\u05d8\u05d5\u05d1\u05d9\u05dd' \u05dc\u05d1\u05d9\u05df \u05d9\u05d9\u05e6\u05d5\u05d2\u05d9\u05dd '\u05e8\u05e2\u05d9\u05dd' \u05db\u05d3\u05d9 \u05dc\u05d4\u05d2\u05df \u05e2\u05dc \u05d4\u05dc\u05d9\u05d1\u05d9\u05d3\u05d5 \u05de\u05e4\u05e0\u05d9 \u05ea\u05d5\u05e7\u05e4\u05e0\u05d5\u05ea.",
          "isCorrect": true,
          "rationale": "\u05d4\u05e4\u05d9\u05e6\u05d5\u05dc \u05d4\u05d5\u05d0 \u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05dc\u05d9\u05d1\u05d4 \u05d1-Borderline Personality Organization (BPO), \u05d4\u05de\u05d5\u05e0\u05e2 \u05d0\u05d9\u05e0\u05d8\u05d2\u05e8\u05e6\u05d9\u05d4 \u05e9\u05dc \u05d0\u05de\u05d1\u05d9\u05d5\u05d5\u05dc\u05e0\u05d8\u05d9\u05d5\u05ea \u05d5\u05e9\u05d5\u05de\u05e8 \u05e2\u05dc \u05d4\u05e7\u05d5\u05d8\u05d1 \u05d4'\u05d8\u05d5\u05d1' \u05de\u05e4\u05e0\u05d9 \u05d4\u05e8\u05e1 \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d4'\u05e8\u05e2' (DSM p.60, Synopsis ch.34.4)."
        },
        {
          "text": "\u05d4\u05d3\u05d7\u05e7\u05d4 (Repression), \u05d4\u05de\u05d5\u05e0\u05e2\u05ea \u05de\u05d3\u05d7\u05e4\u05d9\u05dd \u05dc\u05d0 \u05de\u05e7\u05d5\u05d1\u05dc\u05d9\u05dd \u05dc\u05e2\u05dc\u05d5\u05ea \u05dc\u05de\u05d5\u05d3\u05e2 \u05d5\u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05ea \u05d0\u05e8\u05d2\u05d5\u05df \u05d0\u05d9\u05e9\u05d9\u05d5\u05ea \u05e0\u05d5\u05d9\u05e8\u05d5\u05d8\u05d9.",
          "isCorrect": false,
          "rationale": "\u05d4\u05d3\u05d7\u05e7\u05d4 \u05d4\u05d9\u05d0 \u05d4\u05d2\u05e0\u05d4 \u05de\u05ea\u05e7\u05d3\u05de\u05ea \u05d4\u05de\u05e0\u05d9\u05d7\u05d4 \u05d6\u05d4\u05d5\u05ea \u05de\u05d2\u05d5\u05d1\u05e9\u05ea; \u05d4\u05ea\u05d9\u05d0\u05d5\u05e8\u05d9\u05dd \u05d4\u05e7\u05d9\u05e6\u05d5\u05e0\u05d9\u05d9\u05dd \u05d5\u05d4\u05e1\u05d5\u05ea\u05e8\u05d9\u05dd \u05d1\u05de\u05e7\u05e8\u05d4 \u05d6\u05d4 \u05de\u05e2\u05d9\u05d3\u05d9\u05dd \u05e2\u05dc \u05e4\u05d9\u05e6\u05d5\u05dc \u05e4\u05e8\u05d9\u05de\u05d9\u05d8\u05d9\u05d1\u05d9 (Synopsis ch.34.4)."
        },
        {
          "text": "\u05d1\u05d9\u05d8\u05d5\u05dc (Undoing), \u05e0\u05d9\u05e1\u05d9\u05d5\u05df \u05e1\u05de\u05dc\u05d9 \u05dc\u05db\u05e4\u05e8 \u05e2\u05dc \u05d3\u05d7\u05e3 \u05d0\u05d5 \u05e4\u05e2\u05d5\u05dc\u05d4 \u05ea\u05d5\u05e7\u05e4\u05e0\u05d9\u05ea \u05d1\u05d0\u05de\u05e6\u05e2\u05d5\u05ea \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d4\u05e4\u05d5\u05db\u05d4.",
          "isCorrect": false,
          "rationale": "Undoing \u05d4\u05d5\u05d0 \u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05d2\u05e0\u05d4 \u05e0\u05d5\u05d9\u05e8\u05d5\u05d8\u05d9 \u05d9\u05d5\u05ea\u05e8 (\u05dc\u05de\u05e9\u05dc \u05d1-OCD), \u05e9\u05d0\u05d9\u05e0\u05d5 \u05de\u05e1\u05d1\u05d9\u05e8 \u05d0\u05ea \u05d4\u05e4\u05d9\u05e8\u05d5\u05e7 \u05d4\u05d8\u05d5\u05d8\u05d0\u05dc\u05d9 \u05e9\u05dc \u05ea\u05e4\u05d9\u05e1\u05ea \u05d4\u05d0\u05d5\u05d1\u05d9\u05d9\u05e7\u05d8 \u05dc\u05e9\u05e0\u05d9\u05d9\u05dd (Dulcan p.848)."
        },
        {
          "text": "\u05d4\u05ea\u05e7\u05d4 (Displacement), \u05d4\u05e2\u05d1\u05e8\u05ea \u05e8\u05d2\u05e9\u05d5\u05ea \u05de\u05d0\u05d5\u05d1\u05d9\u05d9\u05e7\u05d8 \u05de\u05d0\u05d9\u05d9\u05dd \u05d0\u05d7\u05d3 \u05dc\u05d0\u05d5\u05d1\u05d9\u05d9\u05e7\u05d8 \u05d1\u05d8\u05d5\u05d7 \u05d9\u05d5\u05ea\u05e8.",
          "isCorrect": false,
          "rationale": "\u05d1\u05d4\u05ea\u05e7\u05d4 \u05d4\u05e8\u05d2\u05e9 \u05e0\u05e9\u05d0\u05e8 \u05d9\u05e6\u05d9\u05d1 \u05d0\u05da \u05d4\u05d0\u05d5\u05d1\u05d9\u05d9\u05e7\u05d8 \u05de\u05e9\u05ea\u05e0\u05d4; \u05db\u05d0\u05df \u05d4\u05d0\u05d5\u05d1\u05d9\u05d9\u05e7\u05d8 \u05e0\u05e9\u05d0\u05e8 \u05d0\u05d5\u05ea\u05d5 \u05d0\u05d3\u05dd \u05d0\u05da \u05d4\u05d9\u05d9\u05e6\u05d5\u05d2 \u05d4\u05e8\u05d2\u05e9\u05d9 \u05e9\u05dc\u05d5 \u05de\u05ea\u05d4\u05e4\u05da \u05dc\u05d7\u05dc\u05d5\u05d8\u05d9\u05df (Dulcan p.848)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d7\u05d5\u05e1\u05e8 \u05d4\u05d9\u05db\u05d5\u05dc\u05ea \u05dc\u05e9\u05d0\u05ea \u05d0\u05de\u05d1\u05d9\u05d5\u05d5\u05dc\u05e0\u05d8\u05d9\u05d5\u05ea \u05d5\u05e2\u05dc \u05d4\u05d4\u05e4\u05e8\u05d3\u05d4 \u05d4\u05d3\u05d9\u05db\u05d5\u05d8\u05d5\u05de\u05d9\u05ea \u05d1\u05d9\u05df '\u05d8\u05d5\u05d1 \u05de\u05d5\u05d7\u05dc\u05d8' \u05dc'\u05e8\u05e2 \u05de\u05d5\u05d7\u05dc\u05d8'."
    },
    {
      "type": "multiple_select",
      "question": "\u05de\u05d8\u05d5\u05e4\u05dc \u05de\u05d1\u05d5\u05d2\u05e8 \u05e4\u05d5\u05e0\u05d4 \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05ea\u05d7\u05d5\u05e9\u05ea '\u05e8\u05d9\u05e7\u05e0\u05d5\u05ea' \u05d5\u05d6\u05e8\u05d5\u05ea \u05dc\u05e2\u05e6\u05de\u05d5. \u05d4\u05d5\u05d0 \u05de\u05e1\u05e4\u05e8 \u05e9\u05de\u05d0\u05d6 \u05d5\u05de\u05e2\u05d5\u05dc\u05dd \u05d4\u05d9\u05d4 '\u05d9\u05dc\u05d3 \u05de\u05d5\u05e9\u05dc\u05dd' \u05e9\u05e2\u05e9\u05d4 \u05d1\u05d3\u05d9\u05d5\u05e7 \u05de\u05d4 \u05e9\u05d1\u05d9\u05e7\u05e9\u05d5 \u05de\u05de\u05e0\u05d5, \u05d0\u05da \u05d4\u05d5\u05d0 \u05de\u05e8\u05d2\u05d9\u05e9 \u05e9\u05d4\u05d5\u05d0 \u05d7\u05d9 \u05d7\u05d9\u05d9\u05dd \u05e9\u05dc \u05de\u05d9\u05e9\u05d4\u05d5 \u05d0\u05d7\u05e8. \u05d0\u05d9\u05dc\u05d5 \u05de\u05d4\u05de\u05d5\u05e9\u05d2\u05d9\u05dd \u05d4\u05d1\u05d0\u05d9\u05dd \u05e9\u05dc \u05d5\u05d9\u05e0\u05d9\u05e7\u05d5\u05d8 \u05e8\u05dc\u05d5\u05d5\u05e0\u05d8\u05d9\u05d9\u05dd \u05dc\u05d4\u05d1\u05e0\u05ea \u05d4\u05de\u05e7\u05e8\u05d4?",
      "answerOptions": [
        {
          "text": "\u05e2\u05e6\u05de\u05d9 \u05db\u05d5\u05d6\u05d1 \u05e4\u05ea\u05d5\u05dc\u05d5\u05d2\u05d9 (Extreme False Self), \u05e9\u05d4\u05ea\u05e4\u05ea\u05d7 \u05db\u05ea\u05d5\u05e6\u05d0\u05d4 \u05de\u05d4\u05e6\u05d5\u05e8\u05da \u05dc\u05d4\u05ea\u05d0\u05d9\u05dd \u05d0\u05ea \u05e2\u05e6\u05de\u05d5 \u05dc\u05e6\u05d9\u05e4\u05d9\u05d5\u05ea \u05d4\u05d0\u05dd \u05e2\u05dc \u05d7\u05e9\u05d1\u05d5\u05df \u05d4\u05e1\u05e4\u05d5\u05e0\u05d8\u05e0\u05d9\u05d5\u05ea \u05e9\u05dc\u05d5.",
          "isCorrect": true,
          "rationale": "\u05d4\u05e2\u05e6\u05de\u05d9 \u05d4\u05db\u05d5\u05d6\u05d1 \u05de\u05d7\u05dc\u05d9\u05e3 \u05d0\u05ea \u05d4\u05e2\u05e6\u05de\u05d9 \u05d4\u05d0\u05de\u05d9\u05ea\u05d9 \u05db\u05d0\u05e9\u05e8 \u05d4\u05d0\u05dd \u05d3\u05d5\u05e8\u05e9\u05ea \u05d4\u05ea\u05d0\u05de\u05d4 \u05dc\u05e6\u05e8\u05db\u05d9\u05d4, \u05de\u05d4 \u05e9\u05de\u05d5\u05d1\u05d9\u05dc \u05dc\u05ea\u05d7\u05d5\u05e9\u05ea \u05e8\u05d9\u05e7\u05e0\u05d5\u05ea \u05d5\u05d7\u05d5\u05e1\u05e8 \u05d7\u05d9\u05d5\u05e0\u05d9\u05d5\u05ea (Syllabus p.52)."
        },
        {
          "text": "\u05d4\u05e2\u05e6\u05de\u05d9 \u05d4\u05d0\u05de\u05d9\u05ea\u05d9 (True Self), \u05d4\u05d2\u05e8\u05e2\u05d9\u05df \u05d4\u05d0\u05d5\u05ea\u05e0\u05d8\u05d9 \u05d5\u05d4\u05e1\u05e4\u05d5\u05e0\u05d8\u05e0\u05d9 \u05e9\u05e0\u05e9\u05d0\u05e8 \u05de\u05d5\u05e1\u05ea\u05e8 \u05d5\u05de\u05d5\u05d2\u05df \u05de\u05d0\u05d7\u05d5\u05e8\u05d9 \u05d4\u05de\u05e6\u05d2 \u05d4\u05d7\u05d9\u05e6\u05d5\u05e0\u05d9.",
          "isCorrect": true,
          "rationale": "\u05d4\u05e2\u05e6\u05de\u05d9 \u05d4\u05d0\u05de\u05d9\u05ea\u05d9 \u05e0\u05d5\u05d1\u05e2 \u05de\u05ea\u05d7\u05d5\u05e9\u05ea \u05d4\u05e7\u05d9\u05d5\u05dd \u05d4\u05d1\u05dc\u05ea\u05d9 \u05de\u05d5\u05e4\u05e8\u05e2\u05ea; \u05d1\u05de\u05e6\u05d1\u05d9\u05dd \u05e4\u05ea\u05d5\u05dc\u05d5\u05d2\u05d9\u05d9\u05dd \u05d4\u05d5\u05d0 \u05e0\u05d3\u05d7\u05e7 \u05e4\u05e0\u05d9\u05de\u05d4 \u05db\u05d3\u05d9 \u05dc\u05d4\u05d9\u05de\u05e0\u05e2 \u05de\u05e4\u05d2\u05d9\u05e2\u05d4 (Syllabus p.52, Synopsis ch.34.4)."
        },
        {
          "text": "\u05db\u05d9\u05e9\u05dc\u05d5\u05df \u05de\u05d5\u05ea\u05d0\u05dd (Disillusionment) \u05de\u05d5\u05e7\u05d3\u05dd \u05de\u05d3\u05d9 \u05d0\u05d5 \u05e7\u05d9\u05e6\u05d5\u05e0\u05d9 \u05de\u05e6\u05d3 \u05d4\u05d0\u05dd.",
          "isCorrect": true,
          "rationale": "\u05d0\u05dd \u05e9\u05d4\u05d9\u05d0 '\u05d8\u05d5\u05d1\u05d4 \u05d3\u05d9\u05d4' \u05de\u05d0\u05e4\u05e9\u05e8\u05ea \u05d0\u05e9\u05dc\u05d9\u05d4 \u05d5\u05d0\u05d6 \u05ea\u05e1\u05db\u05d5\u05dc \u05de\u05d1\u05d5\u05e7\u05e8; \u05db\u05e9\u05dc \u05d1\u05ea\u05d9\u05e7\u05d5\u05e3 \u05d4\u05e1\u05e4\u05d5\u05e0\u05d8\u05e0\u05d9\u05d5\u05ea \u05e9\u05dc \u05d4\u05ea\u05d9\u05e0\u05d5\u05e7 \u05de\u05d0\u05dc\u05e5 \u05d0\u05d5\u05ea\u05d5 \u05dc\u05e4\u05ea\u05d7 \u05e2\u05e6\u05de\u05d9 \u05db\u05d5\u05d6\u05d1 (Synopsis ch.34.4)."
        },
        {
          "text": "\u05e7\u05d1\u05d9\u05e2\u05d5\u05ea \u05d0\u05d5\u05d1\u05d9\u05d9\u05e7\u05d8 \u05e8\u05d2\u05e9\u05d9\u05ea (Emotional Object Constancy) \u05dc\u05e7\u05d5\u05d9\u05d4.",
          "isCorrect": false,
          "rationale": "\u05de\u05d5\u05e9\u05d2 \u05d6\u05d4 \u05e9\u05d9\u05d9\u05da \u05dc\u05de\u05d5\u05d3\u05dc \u05e9\u05dc \u05de\u05d0\u05d4\u05dc\u05e8 \u05d5\u05e2\u05d5\u05e1\u05e7 \u05d1\u05d9\u05db\u05d5\u05dc\u05ea \u05dc\u05d4\u05d7\u05d6\u05d9\u05e7 \u05d9\u05d9\u05e6\u05d5\u05d2 \u05e4\u05e0\u05d9\u05de\u05d9 \u05de\u05d0\u05d5\u05d7\u05d3 \u05e9\u05dc \u05d4\u05d0\u05dd, \u05d5\u05dc\u05d0\u05d5 \u05d3\u05d5\u05d5\u05e7\u05d0 \u05d1\u05de\u05ea\u05d7 \u05d1\u05d9\u05df \u05d0\u05d5\u05ea\u05e0\u05d8\u05d9\u05d5\u05ea \u05dc\u05e6\u05d9\u05e4\u05d9\u05d5\u05ea \u05d4\u05e1\u05d1\u05d9\u05d1\u05d4 (Syllabus p.17)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05de\u05d5\u05e9\u05d2\u05d9\u05dd \u05e9\u05dc \u05d5\u05d9\u05e0\u05d9\u05e7\u05d5\u05d8 \u05d4\u05e2\u05d5\u05e1\u05e7\u05d9\u05dd \u05d1\u05de\u05ea\u05d7 \u05e9\u05d1\u05d9\u05df \u05e6\u05d9\u05d5\u05ea (Compliance) \u05dc\u05d1\u05d9\u05df \u05d7\u05d9\u05d5\u05e0\u05d9\u05d5\u05ea \u05d0\u05d5\u05ea\u05e0\u05d8\u05d9\u05ea.",
      "hasAllOfTheAbove": false,
      "hasNoneOfTheAbove": false
    },
    {
      "type": "fill_in_the_blank",
      "question": "\u05dc\u05e4\u05d9 \u05d4\u05de\u05d5\u05d3\u05dc \u05e9\u05dc \u05de\u05e8\u05d2\u05e8\u05d8 \u05de\u05d0\u05d4\u05dc\u05e8, \u05d4\u05d4\u05d9\u05e9\u05d2 \u05e9\u05dc ___ \u05de\u05ea\u05e8\u05d7\u05e9 \u05e1\u05d1\u05d9\u05d1 \u05d2\u05d9\u05dc 24\u201336 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05d5\u05de\u05d0\u05e4\u05e9\u05e8 \u05dc\u05d9\u05dc\u05d3 \u05dc\u05e9\u05de\u05d5\u05e8 \u05e2\u05dc \u05d9\u05d9\u05e6\u05d5\u05d2 \u05e4\u05e0\u05d9\u05de\u05d9 \u05d9\u05e6\u05d9\u05d1 \u05d5\u05de\u05d0\u05d5\u05d7\u05d3 \u05e9\u05dc \u05d4\u05d0\u05dd \u05d2\u05dd \u05d1\u05d4\u05d9\u05e2\u05d3\u05e8\u05d4 \u05d4\u05e4\u05d9\u05d6\u05d9 \u05d0\u05d5 \u05d1\u05e2\u05ea \u05db\u05e2\u05e1 \u05db\u05dc\u05e4\u05d9\u05d4.",
      "bestAnswer": "\u05e7\u05d1\u05d9\u05e2\u05d5\u05ea \u05d0\u05d5\u05d1\u05d9\u05d9\u05e7\u05d8 \u05e8\u05d2\u05e9\u05d9\u05ea",
      "acceptableAnswers": [
        "emotional object constancy",
        "Object Constancy"
      ],
      "rationale": "\u05e7\u05d1\u05d9\u05e2\u05d5\u05ea \u05d0\u05d5\u05d1\u05d9\u05d9\u05e7\u05d8 \u05e8\u05d2\u05e9\u05d9\u05ea \u05d4\u05d9\u05d0 \u05d4\u05d9\u05db\u05d5\u05dc\u05ea \u05dc\u05d1\u05e6\u05e2 \u05d0\u05d9\u05e0\u05d8\u05d2\u05e8\u05e6\u05d9\u05d4 \u05d1\u05d9\u05df \u05d9\u05d9\u05e6\u05d5\u05d2\u05d9 \u05d0\u05d5\u05d1\u05d9\u05d9\u05e7\u05d8 \u05d8\u05d5\u05d1\u05d9\u05dd \u05d5\u05e8\u05e2\u05d9\u05dd, \u05de\u05d4 \u05e9\u05de\u05d0\u05e4\u05e9\u05e8 \u05e9\u05d4\u05d9\u05d9\u05d4 \u05d1\u05e0\u05e4\u05e8\u05d3 \u05dc\u05dc\u05d0 \u05d7\u05e8\u05d3\u05ea \u05e4\u05d9\u05e8\u05d5\u05e7 (Syllabus p.17, Synopsis ch.34.4).",
      "hint": "\u05d6\u05d4\u05d5 \u05ea\u05ea-\u05d4\u05e9\u05dc\u05d1 \u05d4\u05e8\u05d1\u05d9\u05e2\u05d9 \u05d5\u05d4\u05d0\u05d7\u05e8\u05d5\u05df \u05d1\u05ea\u05d4\u05dc\u05d9\u05da \u05d4\u05d4\u05d9\u05e4\u05e8\u05d3\u05d5\u05ea-\u05d0\u05d9\u05e0\u05d3\u05d9\u05d1\u05d9\u05d3\u05d5\u05d0\u05e6\u05d9\u05d4, \u05d4\u05e9\u05d5\u05e0\u05d4 \u05de\u05d4\u05de\u05d5\u05e9\u05d2 \u05d4\u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9 \u05e9\u05dc \u05e4\u05d9\u05d0\u05d6'\u05d4."
    },
    {
      "type": "short_answer",
      "question": "\u05d4\u05e1\u05d1\u05e8 \u05d1\u05e7\u05e6\u05e8\u05d4 \u05d0\u05ea \u05ea\u05e4\u05e7\u05d9\u05d3\u05d5 \u05e9\u05dc \u05d4-Treatment Contract (\u05d7\u05d5\u05d6\u05d4 \u05d8\u05d9\u05e4\u05d5\u05dc\u05d9) \u05d1\u05e9\u05d9\u05d8\u05ea \u05d4-Transference-Focused Psychotherapy (TFP) \u05e9\u05e4\u05d9\u05ea\u05d7 \u05e7\u05e8\u05e0\u05d1\u05e8\u05d2.",
      "grading": {
        "modelAnswer": "\u05d4\u05d7\u05d5\u05d6\u05d4 \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc\u05d9 \u05d1-TFP \u05e0\u05d5\u05e2\u05d3 \u05dc\u05d4\u05d2\u05d3\u05d9\u05e8 \u05d2\u05d1\u05d5\u05dc\u05d5\u05ea \u05e0\u05d5\u05e7\u05e9\u05d9\u05dd \u05d5\u05d1\u05e8\u05d5\u05e8\u05d9\u05dd \u05d1\u05ea\u05d7\u05d9\u05dc\u05ea \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05dc\u05d2\u05d1\u05d9 \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05d9\u05d5\u05ea \u05d4\u05e8\u05e1\u05e0\u05d9\u05d5\u05ea, \u05d0\u05d5\u05d1\u05d3\u05e0\u05d9\u05d5\u05ea \u05d0\u05d5 acting out. \u05de\u05d8\u05e8\u05ea\u05d5 \u05d4\u05d9\u05d0 \u05dc\u05d9\u05d9\u05e6\u05e8 \u05e1\u05d1\u05d9\u05d1\u05d4 \u05d4\u05de\u05d0\u05e4\u05e9\u05e8\u05ea \u05d0\u05ea '\u05d4\u05d7\u05d6\u05e7\u05ea' \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05dc\u05de\u05e8\u05d5\u05ea \u05d4\u05d0\u05d2\u05e8\u05e1\u05d9\u05d4 \u05d5\u05d4\u05ea\u05e0\u05d5\u05d3\u05d5\u05ea \u05d4\u05e8\u05d2\u05e9\u05d9\u05d5\u05ea \u05d4\u05e2\u05d6\u05d5\u05ea \u05e9\u05dc \u05de\u05d8\u05d5\u05e4\u05dc\u05d9 BPO, \u05d5\u05dc\u05d4\u05d1\u05d8\u05d9\u05d7 \u05d0\u05ea \u05d1\u05d9\u05d8\u05d7\u05d5\u05df \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05d5\u05d4\u05de\u05d8\u05e4\u05dc.",
        "rationale": "\u05d4\u05d7\u05d5\u05d6\u05d4 \u05de\u05e9\u05de\u05e9 \u05db\u05e2\u05d5\u05d2\u05df \u05de\u05d1\u05e0\u05d9 \u05d4\u05de\u05d0\u05e4\u05e9\u05e8 \u05dc\u05de\u05d8\u05e4\u05dc \u05dc\u05e2\u05d1\u05d5\u05d3 \u05e2\u05dd \u05d4\u05e2\u05d1\u05e8\u05d4 \u05e9\u05dc\u05d9\u05dc\u05d9\u05ea \u05e2\u05d6\u05d4 \u05de\u05d1\u05dc\u05d9 \u05e9\u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d9\u05ea\u05e4\u05e8\u05e7 \u05e2\u05e7\u05d1 \u05e4\u05e2\u05d5\u05dc\u05d5\u05ea \u05d4\u05e8\u05e1\u05e0\u05d9\u05d5\u05ea \u05de\u05d7\u05d5\u05e5 \u05dc\u05d7\u05d3\u05e8 (Synopsis ch.23).",
        "requiredAttributes": [
          "\u05e6\u05d9\u05d5\u05df \u05d4\u05d2\u05d3\u05e8\u05ea \u05d2\u05d1\u05d5\u05dc\u05d5\u05ea \u05d1\u05e8\u05d5\u05e8\u05d9\u05dd \u05dc\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05d9\u05d5\u05ea \u05d4\u05e8\u05e1\u05e0\u05d9\u05d5\u05ea/\u05d0\u05d5\u05d1\u05d3\u05e0\u05d9\u05d5\u05ea/acting out.",
          "\u05d4\u05e1\u05d1\u05e8 \u05e9\u05d4\u05d7\u05d5\u05d6\u05d4 \u05de\u05d0\u05e4\u05e9\u05e8 \u05d0\u05ea \u05d4\u05d7\u05d6\u05e7\u05ea \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc (Holding) \u05de\u05d5\u05dc \u05d4\u05d0\u05d2\u05e8\u05e1\u05d9\u05d4.",
          "\u05d4\u05ea\u05d9\u05d9\u05d7\u05e1\u05d5\u05ea \u05dc\u05db\u05da \u05e9\u05d6\u05d4\u05d5 \u05ea\u05e0\u05d0\u05d9 \u05e1\u05e3 \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-BPO."
        ],
        "errors": {
          "misconceptions": [
            "\u05d4\u05d7\u05d5\u05d6\u05d4 \u05e0\u05d5\u05e2\u05d3 \u05e8\u05e7 \u05dc\u05d4\u05e1\u05d3\u05e8\u05ea \u05ea\u05e9\u05dc\u05d5\u05de\u05d9\u05dd \u05d5\u05e9\u05e2\u05d5\u05ea.",
            "\u05d4\u05d7\u05d5\u05d6\u05d4 \u05d4\u05d5\u05d0 \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05dc\u05e9\u05d9\u05e0\u05d5\u05d9 \u05d4\u05d0\u05d9\u05e9\u05d9\u05d5\u05ea (\u05d6\u05d4\u05d5 \u05d4\u05e4\u05d9\u05e8\u05d5\u05e9)."
          ],
          "bluffs": [
            "\u05d0\u05de\u05d9\u05e8\u05d5\u05ea \u05db\u05dc\u05dc\u05d9\u05d5\u05ea \u05e2\u05dc '\u05d1\u05e8\u05d9\u05ea \u05d8\u05d9\u05e4\u05d5\u05dc\u05d9\u05ea' \u05dc\u05dc\u05d0 \u05d4\u05ea\u05d9\u05d9\u05d7\u05e1\u05d5\u05ea \u05dc\u05de\u05d1\u05e0\u05d4 \u05d4\u05e0\u05d5\u05e7\u05e9\u05d4 \u05e9\u05dc TFP."
          ]
        }
      },
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05e6\u05d5\u05e8\u05da \u05d1\u05e9\u05dc\u05d9\u05d8\u05d4 \u05d1-Acting Out \u05dc\u05e4\u05e0\u05d9 \u05e9\u05e0\u05d9\u05ea\u05df \u05dc\u05d2\u05e9\u05ea \u05dc\u05e4\u05d9\u05e8\u05d5\u05e9 \u05d4\u05d4\u05e2\u05d1\u05e8\u05d4."
    },
    {
      "type": "multiple_choice",
      "question": "\u05de\u05ea\u05d1\u05d2\u05e8 \u05d1\u05df 17 \u05de\u05d5\u05e4\u05e0\u05d4 \u05dc\u05d4\u05e2\u05e8\u05db\u05d4 \u05d1\u05e9\u05dc \u05d3\u05e4\u05d5\u05e1\u05d9 \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d4\u05de\u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05d9\u05dd \u05d1\u05d0\u05d9-\u05d9\u05e6\u05d9\u05d1\u05d5\u05ea \u05d1\u05d9\u05d7\u05e1\u05d9\u05dd, \u05e4\u05d2\u05d9\u05e2\u05d4 \u05e2\u05e6\u05de\u05d9\u05ea \u05d5\u05d6\u05d4\u05d5\u05ea \u05dc\u05d0 \u05de\u05d2\u05d5\u05d1\u05e9\u05ea \u05e9\u05e0\u05de\u05e9\u05db\u05d9\u05dd \u05db\u05d1\u05e8 \u05e9\u05e0\u05ea\u05d9\u05d9\u05dd. \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR, \u05de\u05d4\u05d9 \u05d4\u05d4\u05e0\u05d7\u05d9\u05d4 \u05dc\u05d2\u05d1\u05d9 \u05d0\u05d1\u05d7\u05d5\u05df \u05d4\u05e4\u05e8\u05e2\u05ea \u05d0\u05d9\u05e9\u05d9\u05d5\u05ea \u05d1\u05de\u05e7\u05e8\u05d4 \u05d6\u05d4?",
      "answerOptions": [
        {
          "text": "\u05e0\u05d9\u05ea\u05df \u05dc\u05d0\u05d1\u05d7\u05df \u05d4\u05e4\u05e8\u05e2\u05ea \u05d0\u05d9\u05e9\u05d9\u05d5\u05ea (\u05d7\u05d5\u05e5 \u05de\u05d0\u05e0\u05d8\u05d9-\u05e1\u05d5\u05e6\u05d9\u05d0\u05dc\u05d9\u05ea) \u05d0\u05dd \u05d4\u05ea\u05db\u05d5\u05e0\u05d5\u05ea \u05e4\u05ea\u05d5\u05dc\u05d5\u05d2\u05d9\u05d5\u05ea, \u05e0\u05e8\u05d7\u05d1\u05d5\u05ea \u05d5\u05e0\u05de\u05e9\u05db\u05d5\u05ea \u05dc\u05e4\u05d7\u05d5\u05ea \u05e9\u05e0\u05d4 \u05d0\u05d7\u05ea \u05d1\u05e8\u05e6\u05d9\u05e4\u05d5\u05ea.",
          "isCorrect": true,
          "rationale": "\u05d4-DSM-5-TR \u05de\u05d0\u05e4\u05e9\u05e8 \u05d0\u05d1\u05d7\u05d5\u05df \u05d4\u05e4\u05e8\u05e2\u05ea \u05d0\u05d9\u05e9\u05d9\u05d5\u05ea \u05de\u05ea\u05d7\u05ea \u05dc\u05d2\u05d9\u05dc 18 \u05d1\u05de\u05e7\u05e8\u05d9\u05dd \u05d9\u05d5\u05e6\u05d0\u05d9 \u05d3\u05d5\u05e4\u05df, \u05d1\u05ea\u05e0\u05d0\u05d9 \u05e9\u05d4\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05e7\u05d9\u05d9\u05de\u05d9\u05dd \u05dc\u05e4\u05d7\u05d5\u05ea \u05e9\u05e0\u05d4 (DSM p.736)."
        },
        {
          "text": "\u05d0\u05d9\u05df \u05dc\u05d0\u05d1\u05d7\u05df \u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05d0\u05d9\u05e9\u05d9\u05d5\u05ea \u05db\u05dc\u05dc \u05de\u05ea\u05d7\u05ea \u05dc\u05d2\u05d9\u05dc 18, \u05e9\u05db\u05df \u05d4\u05d0\u05d9\u05e9\u05d9\u05d5\u05ea \u05e2\u05d3\u05d9\u05d9\u05df \u05d1\u05ea\u05d4\u05dc\u05d9\u05da \u05d2\u05d9\u05d1\u05d5\u05e9.",
          "isCorrect": false,
          "rationale": "\u05d6\u05d5\u05d4\u05d9 \u05ea\u05e4\u05d9\u05e1\u05d4 \u05de\u05d5\u05d8\u05e2\u05d9\u05ea; \u05d4-DSM \u05de\u05d0\u05e4\u05e9\u05e8 \u05d0\u05d1\u05d7\u05e0\u05d4 \u05d1\u05ea\u05e0\u05d0\u05d9\u05dd \u05de\u05e1\u05d5\u05d9\u05de\u05d9\u05dd, \u05dc\u05de\u05e2\u05d8 \u05d4\u05e4\u05e8\u05e2\u05ea \u05d0\u05d9\u05e9\u05d9\u05d5\u05ea \u05d0\u05e0\u05d8\u05d9-\u05e1\u05d5\u05e6\u05d9\u05d0\u05dc\u05d9\u05ea (DSM p.736)."
        },
        {
          "text": "\u05e0\u05d9\u05ea\u05df \u05dc\u05d0\u05d1\u05d7\u05df \u05d4\u05e4\u05e8\u05e2\u05ea \u05d0\u05d9\u05e9\u05d9\u05d5\u05ea \u05d0\u05e0\u05d8\u05d9-\u05e1\u05d5\u05e6\u05d9\u05d0\u05dc\u05d9\u05ea \u05d1\u05dc\u05d1\u05d3, \u05d1\u05ea\u05e0\u05d0\u05d9 \u05e9\u05d4\u05d9\u05d4 Conduct Disorder \u05dc\u05e4\u05e0\u05d9 \u05d2\u05d9\u05dc 15.",
          "isCorrect": false,
          "rationale": "\u05d4\u05e4\u05e8\u05e2\u05ea \u05d0\u05d9\u05e9\u05d9\u05d5\u05ea \u05d0\u05e0\u05d8\u05d9-\u05e1\u05d5\u05e6\u05d9\u05d0\u05dc\u05d9\u05ea \u05d4\u05d9\u05d0 \u05d4\u05d4\u05d7\u05e8\u05d2\u05d4 \u05d4\u05d9\u05d7\u05d9\u05d3\u05d4 \u05e9*\u05d0\u05e1\u05d5\u05e8* \u05dc\u05d0\u05d1\u05d7\u05df \u05de\u05ea\u05d7\u05ea \u05dc\u05d2\u05d9\u05dc 18 (DSM p.736, p.749)."
        },
        {
          "text": "\u05d0\u05d1\u05d7\u05e0\u05ea \u05d4\u05e4\u05e8\u05e2\u05ea \u05d0\u05d9\u05e9\u05d9\u05d5\u05ea \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d3\u05d5\u05e8\u05e9\u05ea \u05de\u05e9\u05da \u05d6\u05de\u05df \u05e9\u05dc \u05e9\u05e0\u05ea\u05d9\u05d9\u05dd \u05dc\u05e4\u05d7\u05d5\u05ea \u05db\u05d3\u05d9 \u05dc\u05e9\u05dc\u05d5\u05dc \u05de\u05e9\u05d1\u05e8 \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9 \u05d7\u05d5\u05dc\u05e3.",
          "isCorrect": false,
          "rationale": "\u05d4\u05d3\u05e8\u05d9\u05e9\u05d4 \u05d1-DSM-5-TR \u05d4\u05d9\u05d0 \u05dc\u05de\u05e9\u05da \u05e9\u05dc \u05e9\u05e0\u05d4 \u05d0\u05d7\u05ea \u05dc\u05e4\u05d7\u05d5\u05ea, \u05dc\u05d0 \u05e9\u05e0\u05ea\u05d9\u05d9\u05dd (DSM p.736)."
        }
      ],
      "hint": "\u05d1\u05d3\u05d5\u05e7 \u05d0\u05ea \u05ea\u05e0\u05d0\u05d9 \u05d4\u05d2\u05d9\u05dc \u05d5\u05d4\u05d6\u05de\u05df \u05d4\u05de\u05e4\u05d5\u05e8\u05e9\u05d9\u05dd \u05d1-DSM \u05dc\u05d0\u05d1\u05d7\u05d5\u05df \u05d0\u05d9\u05e9\u05d9\u05d5\u05ea \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d5\u05e0\u05d5\u05e2\u05e8."
    },
    {
      "type": "multiple_choice",
      "question": "\u05de\u05d4\u05d9 \u05d4\u05d1\u05d9\u05e7\u05d5\u05e8\u05ea \u05d4\u05de\u05e8\u05db\u05d6\u05d9\u05ea \u05e9\u05dc \u05d7\u05d5\u05e7\u05e8\u05d9\u05dd \u05de\u05d5\u05d3\u05e8\u05e0\u05d9\u05d9\u05dd (\u05db\u05de\u05d5 \u05d3\u05e0\u05d9\u05d0\u05dc \u05e9\u05d8\u05e8\u05df) \u05e2\u05dc \u05d4\u05de\u05d5\u05d3\u05dc \u05d4\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9 \u05d4\u05de\u05d5\u05e7\u05d3\u05dd \u05e9\u05dc \u05de\u05d0\u05d4\u05dc\u05e8?",
      "answerOptions": [
        {
          "text": "\u05d4\u05ea\u05e4\u05d9\u05e1\u05d4 \u05e9\u05dc '\u05e9\u05dc\u05d1 \u05d0\u05d5\u05d8\u05d9\u05e1\u05d8\u05d9 \u05e0\u05d5\u05e8\u05de\u05dc\u05d9' \u05d0\u05d9\u05e0\u05d4 \u05e0\u05ea\u05de\u05db\u05ea, \u05e9\u05db\u05df \u05ea\u05d9\u05e0\u05d5\u05e7\u05d5\u05ea \u05e0\u05d5\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd \u05d9\u05db\u05d5\u05dc\u05d5\u05ea \u05d7\u05d1\u05e8\u05ea\u05d9\u05d5\u05ea \u05d5\u05ea\u05e7\u05e9\u05d5\u05e8\u05ea\u05d9\u05d5\u05ea \u05de\u05d5\u05d1\u05d7\u05e0\u05d5\u05ea \u05db\u05d1\u05e8 \u05de\u05d4\u05d9\u05de\u05d9\u05dd \u05d4\u05e8\u05d0\u05e9\u05d5\u05e0\u05d9\u05dd.",
          "isCorrect": true,
          "rationale": "\u05de\u05d7\u05e7\u05e8\u05d9 \u05ea\u05d9\u05e0\u05d5\u05e7\u05d5\u05ea \u05de\u05d5\u05d3\u05e8\u05e0\u05d9\u05d9\u05dd \u05d4\u05e8\u05d0\u05d5 \u05e9\u05ea\u05d9\u05e0\u05d5\u05e7\u05d5\u05ea \u05de\u05e1\u05d5\u05d2\u05dc\u05d9\u05dd \u05dc\u05d9\u05e6\u05d5\u05e8 \u05e7\u05e9\u05e8 \u05e2\u05d9\u05df \u05d5\u05dc\u05d4\u05e2\u05d3\u05d9\u05e3 \u05d0\u05ea \u05e7\u05d5\u05dc \u05d4\u05d0\u05dd \u05de\u05d9\u05d3 \u05dc\u05d0\u05d7\u05e8 \u05d4\u05dc\u05d9\u05d3\u05d4, \u05de\u05d4 \u05e9\u05e1\u05d5\u05ea\u05e8 \u05d0\u05ea \u05e8\u05e2\u05d9\u05d5\u05df '\u05de\u05d7\u05e1\u05d5\u05dd \u05d4\u05d2\u05d9\u05e8\u05d5\u05d9\u05d9\u05dd' (Dulcan p.29, Synopsis ch.34.4)."
        },
        {
          "text": "\u05de\u05d0\u05d4\u05dc\u05e8 \u05d8\u05e2\u05ea\u05d4 \u05d1\u05db\u05da \u05e9\u05d7\u05e9\u05d1\u05d4 \u05e9\u05e7\u05d1\u05d9\u05e2\u05d5\u05ea \u05d0\u05d5\u05d1\u05d9\u05d9\u05e7\u05d8 \u05e8\u05d2\u05e9\u05d9\u05ea \u05de\u05d5\u05e9\u05d2\u05ea \u05e8\u05e7 \u05d1\u05d2\u05d9\u05dc 3; \u05db\u05d9\u05d5\u05dd \u05d9\u05d5\u05d3\u05e2\u05d9\u05dd \u05e9\u05d4\u05d9\u05d0 \u05de\u05d5\u05e9\u05d2\u05ea \u05d1\u05d2\u05d9\u05dc \u05e9\u05e0\u05d4.",
          "isCorrect": false,
          "rationale": "\u05d3\u05d5\u05d5\u05e7\u05d0 \u05e7\u05d1\u05d9\u05e2\u05d5\u05ea \u05d4\u05d0\u05d5\u05d1\u05d9\u05d9\u05e7\u05d8 \u05d4\u05e8\u05d2\u05e9\u05d9\u05ea \u05e0\u05d5\u05ea\u05e8\u05d4 \u05e2\u05e7\u05e8\u05d5\u05df \u05d9\u05e1\u05d5\u05d3 \u05d3\u05d9\u05e0\u05de\u05d9 \u05de\u05e7\u05d5\u05d1\u05dc, \u05d5\u05d4\u05d4\u05d1\u05d7\u05e0\u05d4 \u05d1\u05d9\u05e0\u05d4 \u05dc\u05d1\u05d9\u05df \u05e7\u05d1\u05d9\u05e2\u05d5\u05ea \u05d7\u05e4\u05e5 \u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9\u05ea (\u05d1\u05d2\u05d9\u05dc \u05e9\u05e0\u05d4) \u05e7\u05d9\u05d1\u05dc\u05d4 \u05ea\u05d9\u05e7\u05d5\u05e3 (Synopsis ch.34.4)."
        },
        {
          "text": "\u05d4\u05de\u05d5\u05e9\u05d2 '\u05ea\u05d3\u05dc\u05d5\u05e7 \u05e8\u05d2\u05e9\u05d9' (Emotional Refueling) \u05d4\u05d5\u05db\u05d7 \u05db\u05dc\u05d0 \u05e8\u05dc\u05d5\u05d5\u05e0\u05d8\u05d9 \u05d1\u05de\u05d7\u05e7\u05e8\u05d9\u05dd \u05ea\u05e6\u05e4\u05d9\u05ea\u05d9\u05d9\u05dd \u05de\u05d5\u05d3\u05e8\u05e0\u05d9\u05d9\u05dd.",
          "isCorrect": false,
          "rationale": "\u05ea\u05d5\u05e4\u05e2\u05ea \u05d4-Refueling \u05d1\u05e9\u05dc\u05d1 \u05d4-Practicing \u05d6\u05db\u05ea\u05d4 \u05d3\u05d5\u05d5\u05e7\u05d0 \u05dc\u05d0\u05d9\u05e9\u05d5\u05e9 \u05d0\u05de\u05e4\u05d9\u05e8\u05d9 \u05e0\u05e8\u05d7\u05d1 \u05d1\u05ea\u05e6\u05e4\u05d9\u05d5\u05ea \u05e7\u05dc\u05d9\u05e0\u05d9\u05d5\u05ea (Dulcan p.50, Synopsis ch.34.4)."
        },
        {
          "text": "\u05d4\u05d1\u05d9\u05e7\u05d5\u05e8\u05ea \u05d4\u05d9\u05d0 \u05e9\u05de\u05d0\u05d4\u05dc\u05e8 \u05d4\u05ea\u05de\u05e7\u05d3\u05d4 \u05d9\u05d5\u05ea\u05e8 \u05de\u05d3\u05d9 \u05d1\u05d0\u05d1 \u05d5\u05d6\u05e0\u05d7\u05d4 \u05d0\u05ea \u05ea\u05e4\u05e7\u05d9\u05d3 \u05d4\u05d0\u05dd \u05d1\u05ea\u05d4\u05dc\u05d9\u05da \u05d4\u05e1\u05e4\u05e8\u05e6\u05d9\u05d4.",
          "isCorrect": false,
          "rationale": "\u05d4\u05d1\u05d9\u05e7\u05d5\u05e8\u05ea \u05d4\u05d9\u05d0 \u05d4\u05e4\u05d5\u05db\u05d4 \u2013 \u05d4\u05de\u05d5\u05d3\u05dc \u05e9\u05dc \u05de\u05d0\u05d4\u05dc\u05e8 \u05d4\u05d5\u05d0 \u05d0\u05d9\u05de\u05d5-\u05e6\u05e0\u05d8\u05e8\u05d9 (Mother-centered) \u05de\u05d0\u05d5\u05d3, \u05d5\u05d4\u05de\u05d7\u05e7\u05e8 \u05d4\u05de\u05d5\u05d3\u05e8\u05e0\u05d9 \u05de\u05d3\u05d2\u05d9\u05e9 \u05d9\u05d5\u05ea\u05e8 \u05d0\u05ea \u05d4\u05d4\u05d3\u05d3\u05d9\u05d5\u05ea \u05d5\u05d4\u05d9\u05db\u05d5\u05dc\u05d5\u05ea \u05d4\u05de\u05d5\u05dc\u05d3\u05d5\u05ea \u05e9\u05dc \u05d4\u05ea\u05d9\u05e0\u05d5\u05e7 (Dulcan p.29)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05d9\u05db\u05d5\u05dc\u05d5\u05ea \u05d4\u05e1\u05e0\u05e1\u05d5\u05e8\u05d9\u05d5\u05ea \u05e9\u05dc \u05ea\u05d9\u05e0\u05d5\u05e7 \u05d1\u05d9\u05d5\u05de\u05d5 \u05d4\u05e8\u05d0\u05e9\u05d5\u05df \u05d1\u05d4\u05e9\u05d5\u05d5\u05d0\u05d4 \u05dc\u05de\u05d5\u05e9\u05d2 '\u05d4\u05d1\u05d5\u05e2\u05d4 \u05d4\u05d0\u05d5\u05d8\u05d9\u05e1\u05d8\u05d9\u05ea'."
    }
  ]
}