{
  "title": "Psychiatry Flashcards",
  "cards": [
    {
      "front": "\u05de\u05d0\u05d9\u05d6\u05d4 \u05d2\u05d9\u05dc \u05e0\u05d9\u05ea\u05df \u05dc\u05e7\u05d1\u05dc \u05d4\u05e1\u05db\u05de\u05d4 \u05d1\u05dc\u05ea\u05d9-\u05e4\u05d5\u05e8\u05de\u05dc\u05d9\u05ea (Informed Assent) \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05ea\u05e8\u05d5\u05e4\u05ea\u05d9 \u05dc\u05e4\u05d9 \u05d4-StahlKids?",
      "back": "\u05e7\u05d1\u05dc\u05ea Assent \u05e0\u05d7\u05e9\u05d1\u05ea \u05dc\u05d0\u05e4\u05e9\u05e8\u05d9\u05ea \u05d5\u05d9\u05e9\u05d9\u05de\u05d4 \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d4\u05d7\u05dc \u05de\u05d2\u05d9\u05dc 7 \u05d5\u05de\u05e2\u05dc\u05d4 (StahlKids p. 16, 51, 66)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d7\u05d5\u05d1\u05ea \u05d4\u05d3\u05d9\u05d5\u05d5\u05d7 \u05dc\u05e4\u05d9 \"\u05ea\u05d9\u05e7\u05d5\u05df 26\" \u05dc\u05d7\u05d5\u05e7 \u05d4\u05e2\u05d5\u05e0\u05e9\u05d9\u05df \u05d1\u05de\u05e7\u05e8\u05d4 \u05e9\u05dc \u05d7\u05e9\u05d3 \u05dc\u05d4\u05ea\u05e2\u05dc\u05dc\u05d5\u05ea \u05d0\u05d5 \u05d4\u05d6\u05e0\u05d7\u05ea \u05e7\u05d8\u05d9\u05df \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d4\u05d0\u05d7\u05e8\u05d0\u05d9 \u05e2\u05dc\u05d9\u05d5?",
      "back": "\u05d7\u05d5\u05d1\u05d4 \u05de\u05d5\u05d7\u05dc\u05d8\u05ea \u05d4\u05de\u05d1\u05d8\u05dc\u05ea \u05d0\u05ea \u05d4\u05e1\u05d5\u05d3\u05d9\u05d5\u05ea \u05d4\u05e8\u05e4\u05d5\u05d0\u05d9\u05ea \u05d5\u05de\u05d7\u05d9\u05d9\u05d1\u05ea \u05e4\u05e0\u05d9\u05d9\u05d4 \u05de\u05d9\u05d9\u05d3\u05d9\u05ea \u05dc\u05de\u05e9\u05d8\u05e8\u05d4 \u05d0\u05d5 \u05dc\u05e2\u05d5\u05d1\u05d3 \u05e1\u05d5\u05e6\u05d9\u05d0\u05dc\u05d9 (Syllabus p. 41, Dulcan p. 533)."
    },
    {
      "front": "\u05d1\u05de\u05e6\u05d1 \u05e9\u05dc \u05e1\u05db\u05e1\u05d5\u05da \u05d2\u05d9\u05e8\u05d5\u05e9\u05d9\u05df \u05d0\u05d5 \u05de\u05d7\u05dc\u05d5\u05e7\u05ea \u05e2\u05dc \u05de\u05e9\u05de\u05d5\u05e8\u05ea (Custody disputes), \u05de\u05d4\u05d9 \u05d4\u05d4\u05de\u05dc\u05e6\u05d4 \u05dc\u05e7\u05d1\u05dc\u05ea Informed Consent \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05e4\u05e1\u05d9\u05db\u05d5\u05e4\u05e8\u05de\u05e7\u05d5\u05dc\u05d5\u05d2\u05d9?",
      "back": "\u05de\u05d5\u05de\u05dc\u05e5 \u05dc\u05e7\u05d1\u05dc \u05d4\u05e1\u05db\u05de\u05d4 \u05de\u05d3\u05e2\u05ea \u05de\u05e4\u05d5\u05e8\u05e9\u05ea \u05de\u05e9\u05e0\u05d9 \u05d4\u05d4\u05d5\u05e8\u05d9\u05dd/\u05d4\u05d0\u05e4\u05d5\u05d8\u05e8\u05d5\u05e4\u05d5\u05e1\u05d9\u05dd \u05d4\u05d7\u05d5\u05e7\u05d9\u05d9\u05dd, \u05dc\u05dc\u05d0 \u05e7\u05e9\u05e8 \u05dc\u05d7\u05dc\u05d5\u05e7\u05ea \u05d0\u05d7\u05d5\u05d6\u05d9 \u05d4\u05de\u05e9\u05de\u05d5\u05e8\u05ea \u05d4\u05e4\u05d9\u05d6\u05d9\u05ea \u05d1\u05d9\u05e0\u05d9\u05d4\u05dd (StahlKids p. 16, 51, 66)."
    },
    {
      "front": "\u05de\u05d4\u05dd \u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05d4\u05de\u05e8\u05db\u05d6\u05d9\u05d9\u05dd \u05dc\u05d0\u05e9\u05e4\u05d5\u05d6 \u05d0\u05d6\u05e8\u05d7\u05d9 \u05db\u05e4\u05d5\u05d9 \u05e9\u05dc \u05e7\u05d8\u05d9\u05df (Civil Commitment) \u05dc\u05e4\u05d9 \u05d4-AACAP?",
      "back": "\u05d4\u05e2\u05e8\u05db\u05ea \u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8, \u05d0\u05d1\u05d7\u05e0\u05d4 \u05dc\u05e4\u05d9 DSM, \u05e4\u05d2\u05d9\u05e2\u05d4 \u05d7\u05de\u05d5\u05e8\u05d4 \u05d1\u05ea\u05e4\u05e7\u05d5\u05d3, \u05d4\u05d9\u05e2\u05d3\u05e8 \u05d7\u05dc\u05d5\u05e4\u05d4 \u05e4\u05d7\u05d5\u05ea \u05de\u05d2\u05d1\u05d9\u05dc\u05d4 \u05d5\u05e9\u05d9\u05ea\u05d5\u05e3 \u05d4\u05d4\u05d5\u05e8\u05d9\u05dd \u05d5\u05d4\u05e7\u05d8\u05d9\u05df \u05d1\u05ea\u05d4\u05dc\u05d9\u05da (Dulcan p. 641-642)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05d4\u05d1\u05d3\u05dc \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05d1\u05de\u05d5\u05e7\u05d3 \u05d4\u05d7\u05d5\u05e7\u05d9 \u05dc\u05d0\u05e9\u05e4\u05d5\u05d6 \u05db\u05e4\u05d5\u05d9 \u05d1\u05d9\u05df **\u05d7\u05d5\u05e7 \u05d4\u05e0\u05d5\u05e2\u05e8 (\u05d8\u05d9\u05e4\u05d5\u05dc \u05d5\u05d4\u05e9\u05d2\u05d7\u05d4)** \u05dc\u05d1\u05d9\u05df **\u05d4\u05d7\u05d5\u05e7 \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05d7\u05d5\u05dc\u05d9 \u05e0\u05e4\u05e9**?",
      "back": "\u05d7\u05d5\u05e7 \u05d4\u05e0\u05d5\u05e2\u05e8 \u05de\u05ea\u05de\u05e7\u05d3 \u05d1\u05d4\u05d2\u05e0\u05d4 \u05e2\u05dc \"\u05e7\u05d8\u05d9\u05df \u05e0\u05d6\u05e7\u05e7\", \u05d1\u05e2\u05d5\u05d3 \u05d4\u05d7\u05d5\u05e7 \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05d7\u05d5\u05dc\u05d9 \u05e0\u05e4\u05e9 \u05de\u05ea\u05de\u05e7\u05d3 \u05d1\u05e7\u05d9\u05d5\u05dd \u05de\u05d7\u05dc\u05ea \u05e0\u05e4\u05e9 \u05e4\u05e2\u05d9\u05dc\u05d4 \u05d4\u05de\u05d4\u05d5\u05d5\u05d4 \u05e1\u05db\u05e0\u05d4 (Syllabus p. 41)."
    },
    {
      "front": "\u05d4\u05d2\u05d3\u05e8 \u05d0\u05ea \u05d4\u05de\u05d5\u05e9\u05d2 \"\u05e7\u05d8\u05d9\u05df \u05de\u05e9\u05d5\u05d7\u05e8\u05e8\" (Emancipated Minor) \u05d1\u05d4\u05e7\u05e9\u05e8 \u05e9\u05dc \u05db\u05e9\u05e8\u05d5\u05ea \u05de\u05e9\u05e4\u05d8\u05d9\u05ea \u05dc\u05de\u05ea\u05df Informed Consent.",
      "back": "\u05e7\u05d8\u05d9\u05df \u05de\u05e2\u05dc \u05d2\u05d9\u05dc 15, \u05d4\u05d7\u05d9 \u05d1\u05e0\u05e4\u05e8\u05d3 \u05de\u05d4\u05d5\u05e8\u05d9\u05d5 \u05d5\u05de\u05e7\u05d9\u05d9\u05dd \u05d0\u05ea \u05e2\u05e6\u05de\u05d5 \u05db\u05dc\u05db\u05dc\u05d9\u05ea, \u05d0\u05d5 \u05e7\u05d8\u05d9\u05df \u05e0\u05e9\u05d5\u05d9/\u05de\u05e9\u05e8\u05ea \u05d1\u05e6\u05d4\"\u05dc (Dulcan p. 641)."
    },
    {
      "front": "\u05d1\u05d0\u05d9\u05dc\u05d5 \u05de\u05e6\u05d1\u05d9\u05dd \u05e7\u05dc\u05d9\u05e0\u05d9\u05d9\u05dd \u05de\u05d5\u05d8\u05dc\u05ea \u05e2\u05dc \u05d4\u05de\u05d8\u05e4\u05dc \u05d7\u05d5\u05d1\u05d4 \u05d7\u05d5\u05e7\u05d9\u05ea **\u05dc\u05d0 \u05dc\u05d0\u05e4\u05e9\u05e8** \u05dc\u05d4\u05d5\u05e8\u05d9\u05dd \u05dc\u05e2\u05d9\u05d9\u05df \u05d1\u05e8\u05e9\u05d5\u05de\u05d4 \u05d4\u05e8\u05e4\u05d5\u05d0\u05d9\u05ea \u05e9\u05dc \u05d9\u05dc\u05d3\u05dd?",
      "back": "\u05db\u05d0\u05e9\u05e8 \u05d4\u05e2\u05d9\u05d5\u05df \u05e2\u05dc\u05d5\u05dc \u05dc\u05d2\u05e8\u05d5\u05dd \u05e0\u05d6\u05e7 \u05d7\u05de\u05d5\u05e8 \u05dc\u05d1\u05e8\u05d9\u05d0\u05d5\u05ea\u05d5 \u05d4\u05d2\u05d5\u05e4\u05e0\u05d9\u05ea \u05d0\u05d5 \u05d4\u05e0\u05e4\u05e9\u05d9\u05ea \u05e9\u05dc \u05d4\u05e7\u05d8\u05d9\u05df \u05d0\u05d5 \u05dc\u05e1\u05db\u05df \u05d0\u05ea \u05d7\u05d9\u05d9\u05d5 (Syllabus p. 41)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05e1\u05e3 \u05d4\u05d2\u05d9\u05dc \u05dc\u05d4\u05d5\u05e4\u05e2\u05ea \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e9\u05dc \"\u05d4\u05e4\u05e8\u05ea \u05db\u05dc\u05dc\u05d9\u05dd \u05d7\u05de\u05d5\u05e8\u05d4\" (Serious Violations of Rules) \u05d1\u05d0\u05d1\u05d7\u05e0\u05ea Conduct Disorder?",
      "back": "\u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd, \u05db\u05d2\u05d5\u05df \u05d4\u05d9\u05e9\u05d0\u05e8\u05d5\u05ea \u05de\u05d7\u05d5\u05e5 \u05dc\u05d1\u05d9\u05ea \u05d1\u05dc\u05d9\u05dc\u05d4 \u05d0\u05d5 \u05d4\u05d1\u05e8\u05d6\u05d4 \u05de\u05d1\u05d9\u05d4\"\u05e1, \u05d7\u05d9\u05d9\u05d1\u05d9\u05dd \u05dc\u05d4\u05ea\u05d7\u05d9\u05dc \u05dc\u05e4\u05e0\u05d9 \u05d2\u05d9\u05dc 13 (DSM-5-TR p. 530, Dulcan p. 78)."
    },
    {
      "front": "\u05de\u05ea\u05d9 \u05de\u05d5\u05e1\u05e8\u05ea \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9\u05ea \u05d7\u05d5\u05d1\u05ea \u05d4\u05e1\u05d5\u05d3\u05d9\u05d5\u05ea \u05d4\u05e8\u05e4\u05d5\u05d0\u05d9\u05ea (Confidentiality) \u05d2\u05dd \u05dc\u05dc\u05d0 \u05d4\u05e1\u05db\u05de\u05ea \u05d4\u05e7\u05d8\u05d9\u05df \u05d0\u05d5 \u05d4\u05d0\u05e4\u05d5\u05d8\u05e8\u05d5\u05e4\u05d5\u05e1?",
      "back": "\u05db\u05d0\u05e9\u05e8 \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05de\u05d4\u05d5\u05d5\u05d4 \u05e1\u05db\u05e0\u05d4 \u05de\u05d9\u05d9\u05d3\u05d9\u05ea \u05d5\u05d1\u05e8\u05d5\u05e8\u05d4 \u05dc\u05e2\u05e6\u05de\u05d5 (Self-harm) \u05d0\u05d5 \u05dc\u05d6\u05d5\u05dc\u05ea\u05d5 (Danger to others) (Dulcan p. 78, 640)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05d4\u05d2\u05d3\u05e8\u05d4 \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05e9\u05dc Child Neglect \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR?",
      "back": "\u05de\u05d7\u05d3\u05dc (Omission) \u05e9\u05dc \u05de\u05d8\u05e4\u05dc \u05d4\u05e9\u05d5\u05dc\u05dc \u05de\u05d4\u05d9\u05dc\u05d3 \u05e6\u05e8\u05db\u05d9\u05dd \u05d1\u05e1\u05d9\u05e1\u05d9\u05d9\u05dd (\u05de\u05d6\u05d5\u05df, \u05de\u05d7\u05e1\u05d4, \u05d4\u05e9\u05d2\u05d7\u05d4, \u05d8\u05d9\u05e4\u05d5\u05dc \u05e8\u05e4\u05d5\u05d0\u05d9) \u05d5\u05d2\u05d5\u05e8\u05dd \u05dc\u05e0\u05d6\u05e7 \u05d2\u05d5\u05e4\u05e0\u05d9 \u05d0\u05d5 \u05e0\u05e4\u05e9\u05d9 (DSM-5-TR p. 824)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05e2\u05d9\u05e7\u05e8\u05d5\u05df \u05d4\u05de\u05e9\u05e4\u05d8\u05d9 \u05d4\u05de\u05e0\u05d7\u05d4 (Prevailing Legal Doctrine) \u05d1\u05d1\u05ea\u05d9 \u05d4\u05de\u05e9\u05e4\u05d8 \u05dc\u05d4\u05db\u05e8\u05e2\u05ea \u05e1\u05db\u05e1\u05d5\u05db\u05d9 \u05de\u05e9\u05de\u05d5\u05e8\u05ea (Custody disputes)?",
      "back": "\u05d8\u05d5\u05d1\u05ea \u05d4\u05d9\u05dc\u05d3 (The Best Interests of the Child) (Dulcan p. 637, 646)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05ea\u05e0\u05d0\u05d9 \u05d4\u05e1\u05e3 \u05d4\u05db\u05e8\u05d5\u05e0\u05d5\u05dc\u05d5\u05d2\u05d9 \u05dc\u05d0\u05d1\u05d7\u05e0\u05ea Antisocial Personality Disorder \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR?",
      "back": "\u05e2\u05dc \u05d4\u05e4\u05e8\u05d8 \u05dc\u05d4\u05d9\u05d5\u05ea \u05d1\u05df 18 \u05e9\u05e0\u05d9\u05dd \u05dc\u05e4\u05d7\u05d5\u05ea, \u05e2\u05dd \u05e2\u05d3\u05d5\u05ea \u05dc-Conduct Disorder \u05dc\u05e4\u05e0\u05d9 \u05d2\u05d9\u05dc 15 (DSM-5-TR p. 537)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d6\u05db\u05d5\u05ea\u05d5 \u05e9\u05dc \u05d4\u05d5\u05e8\u05d4 \u05dc\u05d0-\u05de\u05e9\u05de\u05d5\u05e8\u05df (Noncustodial parent) \u05dc\u05d2\u05d1\u05d9 \u05d4\u05e2\u05e8\u05db\u05d4 \u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9\u05ea \u05e9\u05dc \u05d9\u05dc\u05d3\u05d5?",
      "back": "\u05d6\u05db\u05d5\u05ea\u05d5 \u05dc\u05d4\u05e9\u05ea\u05ea\u05e3 \u05d1\u05d4\u05e2\u05e8\u05db\u05d4 \u05d5\u05d1\u05d8\u05d9\u05e4\u05d5\u05dc, \u05d0\u05da \u05dc\u05e8\u05d5\u05d1 \u05d0\u05d9\u05e0\u05d5 \u05d9\u05db\u05d5\u05dc \u05dc\u05d4\u05ea\u05d7\u05d9\u05dc \u05ea\u05d4\u05dc\u05d9\u05da \u05d8\u05d9\u05e4\u05d5\u05dc\u05d9 \u05e9\u05d0\u05d9\u05e0\u05d5 \u05d3\u05d7\u05d5\u05e3 (Emergent) \u05dc\u05dc\u05d0 \u05d4\u05e1\u05db\u05de\u05ea \u05d4\u05d4\u05d5\u05e8\u05d4 \u05d4\u05de\u05e9\u05de\u05d5\u05e8\u05df (Dulcan p. 78)."
    },
    {
      "front": "\u05de\u05d4\u05dd \u05d0\u05e8\u05d1\u05e2\u05ea \u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05dc\u05e7\u05d1\u05d9\u05e2\u05ea \u05db\u05e9\u05d9\u05e8\u05d5\u05ea \u05e7\u05d8\u05d9\u05df \u05dc\u05d4\u05e2\u05d9\u05d3 \u05db\u05e2\u05d3 (Competency to act as a witness)?",
      "back": "\u05d9\u05db\u05d5\u05dc\u05ea \u05e7\u05dc\u05d9\u05d8\u05ea \u05d0\u05d9\u05e8\u05d5\u05e2, \u05d9\u05db\u05d5\u05dc\u05ea \u05d6\u05d9\u05db\u05e8\u05d5\u05df \u05d5\u05e9\u05d7\u05d6\u05d5\u05e8, \u05d4\u05d1\u05d7\u05e0\u05d4 \u05d1\u05d9\u05df \u05d0\u05de\u05ea \u05dc\u05e9\u05e7\u05e8, \u05d5\u05d9\u05db\u05d5\u05dc\u05ea \u05ea\u05e7\u05e9\u05d5\u05e8\u05ea \u05d4\u05de\u05d1\u05d5\u05e1\u05e1\u05ea \u05e2\u05dc \u05d9\u05d3\u05e2 \u05d0\u05d9\u05e9\u05d9 (Dulcan p. 647)."
    },
    {
      "front": "\u05de\u05d4 \u05db\u05d5\u05dc\u05dc \"\u05d9\u05d3\u05e2 \u05d4\u05d5\u05dc\u05dd\" (Adequate knowledge) \u05d4\u05e0\u05d3\u05e8\u05e9 \u05de\u05d4\u05d5\u05e8\u05d4 \u05dc\u05e6\u05d5\u05e8\u05da \u05de\u05ea\u05df Informed Consent \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05e4\u05e1\u05d9\u05db\u05d5\u05e4\u05e8\u05de\u05e7\u05d5\u05dc\u05d5\u05d2\u05d9?",
      "back": "\u05d4\u05d1\u05e0\u05ea \u05d4\u05d4\u05e4\u05e8\u05e2\u05d4, \u05d4\u05e1\u05d9\u05db\u05d5\u05e0\u05d9\u05dd, \u05d4\u05d9\u05ea\u05e8\u05d5\u05e0\u05d5\u05ea, \u05ea\u05d5\u05e4\u05e2\u05d5\u05ea \u05d4\u05dc\u05d5\u05d5\u05d0\u05d9, \u05d7\u05dc\u05d5\u05e4\u05d5\u05ea \u05d8\u05d9\u05e4\u05d5\u05dc\u05d9\u05d5\u05ea \u05d5\u05d4\u05e4\u05e8\u05d5\u05d2\u05e0\u05d5\u05d6\u05d4 \u05e2\u05dd \u05d5\u05d1\u05dc\u05d9 \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc (Dulcan p. 689-690)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05d4\u05d1\u05d7\u05e0\u05d4 \u05d4\u05de\u05e9\u05e4\u05d8\u05d9\u05ea \u05d1\u05d9\u05df \u05d0\u05e4\u05d5\u05d8\u05e8\u05d5\u05e4\u05e1\u05d5\u05ea (Guardianship) \u05dc\u05d1\u05d9\u05df \u05de\u05e9\u05de\u05d5\u05e8\u05ea (Custody) \u05dc\u05e4\u05d9 \u05d4\u05e1\u05d9\u05dc\u05d1\u05d5\u05e1?",
      "back": "\u05d0\u05e4\u05d5\u05d8\u05e8\u05d5\u05e4\u05e1\u05d5\u05ea \u05e0\u05d5\u05d2\u05e2\u05ea \u05dc\u05e1\u05de\u05db\u05d5\u05ea \u05dc\u05e7\u05d1\u05dc \u05d4\u05d7\u05dc\u05d8\u05d5\u05ea \u05de\u05e9\u05e4\u05d8\u05d9\u05d5\u05ea/\u05e8\u05e4\u05d5\u05d0\u05d9\u05d5\u05ea \u05e2\u05d1\u05d5\u05e8 \u05d4\u05e7\u05d8\u05d9\u05df, \u05d1\u05e2\u05d5\u05d3 \u05de\u05e9\u05de\u05d5\u05e8\u05ea \u05e7\u05d5\u05d1\u05e2\u05ea \u05d0\u05ea \u05d4\u05d0\u05d7\u05e8\u05d9\u05d5\u05ea \u05e2\u05dc \u05d0\u05d7\u05d6\u05e7\u05ea \u05d4\u05d9\u05dc\u05d3 \u05d1\u05d9\u05d5\u05de\u05d9\u05d5\u05dd (Syllabus p. 39)."
    },
    {
      "front": "\u05de\u05d4\u05dd \u05e9\u05dc\u05d5\u05e9\u05ea \u05d4\u05ea\u05e0\u05d0\u05d9\u05dd \u05d4\u05de\u05e8\u05db\u05d6\u05d9\u05d9\u05dd \u05dc\u05ea\u05e7\u05d9\u05e0\u05d5\u05ea\u05d5 \u05e9\u05dc \u05d4\u05dc\u05d9\u05da Informed Consent?",
      "back": "\u05db\u05e9\u05e8\u05d5\u05ea \u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9\u05ea (Capacity), \u05d9\u05d3\u05e2 \u05d4\u05d5\u05dc\u05dd \u05e2\u05dc \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc (Informed choice), \u05d5\u05d4\u05d9\u05e2\u05d3\u05e8 \u05db\u05e4\u05d9\u05d9\u05d4 (Voluntary choice) (Dulcan p. 641, 689)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05d4\u05d2\u05d3\u05e8\u05d4 \u05e9\u05dc \"\u05e7\u05d8\u05d9\u05df \u05e0\u05d6\u05e7\u05e7\" \u05dc\u05e4\u05d9 \u05d7\u05d5\u05e7 \u05d4\u05e0\u05d5\u05e2\u05e8 (\u05d8\u05d9\u05e4\u05d5\u05dc \u05d5\u05d4\u05e9\u05d2\u05d7\u05d4)?",
      "back": "\u05e7\u05d8\u05d9\u05df \u05e9\u05d0\u05d9\u05df \u05e2\u05dc\u05d9\u05d5 \u05d4\u05e9\u05d2\u05d7\u05d4 \u05e0\u05d0\u05d5\u05ea\u05d4, \u05e9\u05dc\u05d5\u05de\u05d5 \u05d4\u05d2\u05d5\u05e4\u05e0\u05d9 \u05d0\u05d5 \u05d4\u05e0\u05e4\u05e9\u05d9 \u05e0\u05e4\u05d2\u05e2, \u05d0\u05d5 \u05e9\u05d4\u05d5\u05d0 \u05de\u05d1\u05e6\u05e2 \u05e2\u05d1\u05d9\u05e8\u05d5\u05ea \u05e4\u05dc\u05d9\u05dc\u05d9\u05d5\u05ea \u05d5\u05d6\u05e7\u05d5\u05e7 \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d5\u05e9\u05d9\u05e7\u05d5\u05dd (Syllabus p. 41)."
    }
  ]
}