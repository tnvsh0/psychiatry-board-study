{
  "title": "Paranoid Flashcards",
  "cards": [
    {
      "front": "\u05de\u05d4\u05d5 \u05d4-Essential feature \u05e9\u05dc Paranoid Personality Disorder (PPD)?",
      "back": "\u05d3\u05e4\u05d5\u05e1 \u05e0\u05e8\u05d7\u05d1 \u05e9\u05dc distrust \u05d5-suspiciousness \u05db\u05dc\u05e4\u05d9 \u05d0\u05d7\u05e8\u05d9\u05dd \u05db\u05da \u05e9\u05de\u05e0\u05d9\u05e2\u05d9\u05d4\u05dd \u05de\u05e4\u05d5\u05e8\u05e9\u05d9\u05dd \u05db\u05d6\u05d3\u05d5\u05e0\u05d9\u05d9\u05dd (DSM p.738)."
    },
    {
      "front": "\u05db\u05de\u05d4 \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05de\u05ea\u05d5\u05da \u05d4-7 \u05e0\u05d3\u05e8\u05e9\u05d9\u05dd \u05dc\u05d0\u05d1\u05d7\u05e0\u05ea PPD \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR?",
      "back": "\u05dc\u05e4\u05d7\u05d5\u05ea 4 \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd (DSM p.738)."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05de\u05d5\u05d2\u05d3\u05e8 \u05d7\u05e9\u05d3 \u05d1\u05e0\u05d9\u05e6\u05d5\u05dc \u05d1-PPD \u05dc\u05dc\u05d0 \u05d1\u05e1\u05d9\u05e1 \u05de\u05e1\u05e4\u05d9\u05e7 (Criterion A1)?",
      "back": "\u05d4\u05e4\u05e8\u05d8 \u05d7\u05d5\u05e9\u05d3 \u05dc\u05dc\u05d0 \u05d1\u05e1\u05d9\u05e1 \u05de\u05e1\u05e4\u05d9\u05e7 \u05e9\u05d0\u05d7\u05e8\u05d9\u05dd \u05de\u05e0\u05e6\u05dc\u05d9\u05dd, \u05e4\u05d5\u05d2\u05e2\u05d9\u05dd \u05d0\u05d5 \u05de\u05e8\u05de\u05d9\u05dd \u05d0\u05d5\u05ea\u05d5 (DSM p.739)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05e9\u05dc \u05d7\u05e9\u05d3 \u05d1\u05d1\u05d2\u05d9\u05d3\u05d4 \u05d6\u05d5\u05d2\u05d9\u05ea \u05d1-PPD (Criterion A7)?",
      "back": "\u05d7\u05e9\u05d3 \u05d7\u05d5\u05d6\u05e8 \u05dc\u05dc\u05d0 \u05d4\u05e6\u05d3\u05e7\u05d4 \u05dc\u05d2\u05d1\u05d9 \u05e0\u05d0\u05de\u05e0\u05d5\u05ea (fidelity) \u05e9\u05dc \u05d1\u05df/\u05d1\u05ea \u05d4\u05d6\u05d5\u05d2 \u05d0\u05d5 \u05d4\u05e4\u05e8\u05d8\u05e0\u05e8 \u05d4\u05de\u05d9\u05e0\u05d9 (DSM p.739)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d4\u05d7\u05e6\u05d9\u05d5\u05e0\u05d9\u05ea \u05e9\u05dc PPD \u05d1\u05d0\u05d5\u05db\u05dc\u05d5\u05e1\u05d9\u05d9\u05d4 \u05d4\u05db\u05dc\u05dc\u05d9\u05ea \u05dc\u05e4\u05d9 \u05e1\u05e7\u05d9\u05e8\u05ea \u05de\u05d7\u05e7\u05e8\u05d9 \u05d0\u05e4\u05d9\u05d3\u05de\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05d4?",
      "back": "\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d7\u05e6\u05d9\u05d5\u05e0\u05d9\u05ea \u05e9\u05dc 3.2% (DSM p.739)."
    },
    {
      "front": "\u05de\u05d4\u05dd \u05de\u05de\u05e6\u05d0\u05d9 \u05d4-NESARC \u05dc\u05d2\u05d1\u05d9 \u05d4\u05d1\u05d3\u05dc\u05d9 \u05de\u05d2\u05d3\u05e8 (Sex differences) \u05d1-PPD \u05dc\u05e2\u05d5\u05de\u05ea \u05de\u05d8\u05d0-\u05d0\u05e0\u05dc\u05d9\u05d6\u05d5\u05ea \u05d0\u05d7\u05e8\u05d5\u05ea?",
      "back": "\u05de\u05d7\u05e7\u05e8 \u05d4-NESARC \u05de\u05e6\u05d0 \u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d2\u05d1\u05d5\u05d4\u05d4 \u05d9\u05d5\u05ea\u05e8 \u05d1\u05e0\u05e9\u05d9\u05dd, \u05d1\u05e2\u05d5\u05d3 \u05e9\u05de\u05d8\u05d0-\u05d0\u05e0\u05dc\u05d9\u05d6\u05d5\u05ea \u05d0\u05d7\u05e8\u05d5\u05ea \u05d4\u05e6\u05d1\u05d9\u05e2\u05d5 \u05e2\u05dc \u05d2\u05d1\u05e8\u05d9\u05dd (DSM p.740)."
    },
    {
      "front": "\u05d0\u05d9\u05dc\u05d5 \u05d2\u05d5\u05e8\u05de\u05d9\u05dd \u05e1\u05d1\u05d9\u05d1\u05ea\u05d9\u05d9\u05dd (Environmental factors) \u05e7\u05e9\u05d5\u05e8\u05d9\u05dd \u05dc\u05e2\u05dc\u05d9\u05d9\u05d4 \u05d1\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05e4\u05e8\u05e0\u05d5\u05d0\u05d9\u05d3\u05d9\u05d9\u05dd?",
      "back": "\u05e1\u05d8\u05e8\u05e1 \u05d7\u05d1\u05e8\u05ea\u05d9 (\u05db\u05d2\u05d5\u05df \u05d0\u05e4\u05dc\u05d9\u05d4 \u05d5\u05d3\u05d9\u05db\u05d5\u05d9) \u05d1\u05e9\u05d9\u05dc\u05d5\u05d1 \u05e2\u05dd \u05d8\u05e8\u05d0\u05d5\u05de\u05d4 \u05d5\u05d4\u05ea\u05e2\u05dc\u05dc\u05d5\u05ea \u05d1\u05d9\u05dc\u05d3\u05d5\u05ea (DSM p.740)."
    },
    {
      "front": "\u05e2\u05dd \u05d0\u05d9\u05dc\u05d5 \u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9\u05d5\u05ea \u05d9\u05e9 \u05dc-PPD \u05e7\u05e9\u05e8 \u05d2\u05e0\u05d8\u05d9 (Genetic relationship) \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9?",
      "back": "\u05e1\u05db\u05d9\u05d6\u05d5\u05e4\u05e8\u05e0\u05d9\u05d4 \u05d5-Delusional Disorder, persecutory type (DSM p.740)."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05e0\u05d9\u05ea\u05df \u05dc\u05d4\u05d1\u05d3\u05d9\u05dc \u05d1\u05d9\u05df PPD \u05dc\u05d1\u05d9\u05df Delusional Disorder, persecutory type?",
      "back": "\u05d1-PPD \u05d0\u05d9\u05df delusions \u05e7\u05d1\u05d5\u05e2\u05d9\u05dd (fixed) \u05d0\u05d5 \u05ea\u05e7\u05d5\u05e4\u05d5\u05ea \u05e9\u05dc \u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9\u05d9\u05dd \u05de\u05ea\u05de\u05e9\u05db\u05d9\u05dd (DSM p.741)."
    },
    {
      "front": "\u05de\u05d4 \u05de\u05d1\u05d3\u05d9\u05dc PPD \u05de\u05d4\u05e4\u05e8\u05e2\u05ea \u05d0\u05d9\u05e9\u05d9\u05d5\u05ea \u05e1\u05db\u05d9\u05d6\u05d5\u05d8\u05d9\u05e4\u05dc\u05d9\u05ea (Schizotypal PD)?",
      "back": "\u05d1-PPD \u05d7\u05e1\u05e8\u05d9\u05dd \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9\u05dd \u05e9\u05dc magical thinking, \u05de\u05d5\u05d6\u05e8\u05d5\u05ea \u05d1\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea (oddness) \u05d0\u05d5 \u05d7\u05d5\u05d5\u05d9\u05d5\u05ea \u05ea\u05e4\u05d9\u05e1\u05ea\u05d9\u05d5\u05ea \u05d7\u05e8\u05d9\u05d2\u05d5\u05ea (DSM p.741)."
    },
    {
      "front": "\u05d0\u05d9\u05dc\u05d5 \u05d1\u05d9\u05d8\u05d5\u05d9\u05d9\u05dd \u05e8\u05d0\u05e9\u05d5\u05e0\u05d9\u05dd \u05e9\u05dc PPD \u05e2\u05e9\u05d5\u05d9\u05d9\u05dd \u05dc\u05d4\u05d5\u05e4\u05d9\u05e2 \u05d1\u05d9\u05dc\u05d3\u05d5\u05ea \u05d5\u05d1\u05d2\u05d9\u05dc \u05d4\u05d4\u05ea\u05d1\u05d2\u05e8\u05d5\u05ea?",
      "back": "\u05d1\u05d3\u05d9\u05d3\u05d5\u05ea (solitariness), \u05d9\u05d7\u05e1\u05d9\u05dd \u05d3\u05dc\u05d9\u05dd \u05e2\u05dd peers, \u05d7\u05e8\u05d3\u05d4 \u05d7\u05d1\u05e8\u05ea\u05d9\u05ea \u05d5\u05e8\u05d2\u05d9\u05e9\u05d5\u05ea \u05d9\u05ea\u05e8 (DSM p.740)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05e7\u05d5\u05e9\u05d9 \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05d1\u05d9\u05e6\u05d9\u05e8\u05ea \u05d1\u05e8\u05d9\u05ea \u05d8\u05d9\u05e4\u05d5\u05dc\u05d9\u05ea (therapeutic alliance) \u05e2\u05dd \u05de\u05d8\u05d5\u05e4\u05dc\u05d9 PPD?",
      "back": "\u05d7\u05d5\u05e1\u05e8 \u05d4\u05d0\u05de\u05d5\u05df \u05d4\u05d1\u05e1\u05d9\u05e1\u05d9 \u05de\u05e7\u05e9\u05d4 \u05e2\u05dc \u05d9\u05e6\u05d9\u05e8\u05ea \u05e7\u05e9\u05e8; \u05e0\u05d3\u05e8\u05e9\u05ea \u05e9\u05e7\u05d9\u05e4\u05d5\u05ea \u05d5\u05d2\u05d1\u05d5\u05dc\u05d5\u05ea \u05d1\u05e8\u05d5\u05e8\u05d9\u05dd (\u05de\u05e7\u05d5\u05e8: \u05d4\u05e7\u05e9\u05e8 \u05e8\u05d7\u05d1)."
    },
    {
      "front": "\u05de\u05ea\u05d9 \u05d9\u05e9 \u05dc\u05e9\u05e7\u05d5\u05dc \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-low-dose antipsychotics \u05d1-PPD?",
      "back": "\u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05e4\u05e8\u05e0\u05d5\u05d0\u05d9\u05d3\u05d9\u05d9\u05dd \u05d7\u05de\u05d5\u05e8\u05d9\u05dd \u05d0\u05d5 \u05d1\u05e4\u05e8\u05e6\u05d9 \u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d4 \u05e7\u05e6\u05e8\u05d9\u05dd \u05ea\u05d7\u05ea \u05e1\u05d8\u05e8\u05e1 (\u05de\u05e7\u05d5\u05e8: \u05d4\u05e7\u05e9\u05e8 \u05e8\u05d7\u05d1)."
    },
    {
      "front": "\u05d0\u05d9\u05dc\u05d5 \u05e8\u05d2\u05e9\u05d5\u05ea \u05e0\u05d5\u05d8\u05d9\u05dd \u05dc\u05d4\u05d5\u05e4\u05d9\u05e2 \u05d1\u05d8\u05d5\u05d5\u05d7 \u05d4-affect \u05e9\u05dc \u05d0\u05d3\u05dd \u05e2\u05dd PPD?",
      "back": "\u05d8\u05d5\u05d5\u05d7 \u05e8\u05d2\u05e9\u05d9 \u05dc\u05d0 \u05d9\u05e6\u05d9\u05d1 (labile) \u05e9\u05d1\u05d5 \u05e2\u05d5\u05d9\u05e0\u05d5\u05ea, \u05e2\u05e7\u05e9\u05e0\u05d5\u05ea \u05d5\u05e1\u05e8\u05e7\u05d6\u05dd \u05d4\u05dd \u05d4\u05d3\u05d5\u05de\u05d9\u05e0\u05e0\u05d8\u05d9\u05d9\u05dd (DSM p.739)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d4\u05de\u05d5\u05e2\u05e8\u05db\u05ea \u05e9\u05dc PPD \u05d1\u05de\u05e1\u05d2\u05e8\u05d5\u05ea \u05e4\u05d5\u05e8\u05e0\u05d6\u05d9\u05d5\u05ea (forensic settings)?",
      "back": "\u05d4\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05e2\u05e9\u05d5\u05d9\u05d4 \u05dc\u05d4\u05d2\u05d9\u05e2 \u05e2\u05d3 23% (DSM p.739)."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05de\u05e9\u05e4\u05d9\u05e2\u05d9\u05dd \u05d2\u05d5\u05e8\u05de\u05d9 \u05d0\u05e4\u05dc\u05d9\u05d4 \u05d5\u05d2\u05d6\u05e2\u05e0\u05d5\u05ea \u05e2\u05dc \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc PPD \u05d1\u05e7\u05d1\u05d5\u05e6\u05d5\u05ea \u05de\u05d9\u05e2\u05d5\u05d8?",
      "back": "\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05d9\u05d5\u05ea \u05e9\u05dc guardedness \u05e2\u05e9\u05d5\u05d9\u05d5\u05ea \u05dc\u05d4\u05d9\u05d5\u05ea adaptive \u05d5\u05d0\u05d9\u05df \u05dc\u05d8\u05e2\u05d5\u05ea \u05d1\u05d9\u05e0\u05df \u05dc\u05d1\u05d9\u05df PPD (DSM p.740)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05de\u05ea\u05d0\u05d9\u05de\u05d4 \u05db\u05d0\u05e9\u05e8 \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9 PPD \u05d4\u05ea\u05e7\u05d9\u05d9\u05de\u05d5 \u05dc\u05e4\u05e0\u05d9 \u05d4\u05d5\u05e4\u05e2\u05ea \u05e1\u05db\u05d9\u05d6\u05d5\u05e4\u05e8\u05e0\u05d9\u05d4?",
      "back": "\u05d9\u05e9 \u05dc\u05d4\u05d5\u05e1\u05d9\u05e3 \u05d0\u05ea \u05d4\u05e6\u05d9\u05d5\u05df (premorbid) \u05dc\u05d0\u05d1\u05d7\u05e0\u05ea \u05d4-Paranoid Personality Disorder (DSM p.741)."
    },
    {
      "front": "\u05de\u05d4 \u05de\u05d1\u05d3\u05d9\u05dc PPD \u05de\u05d4\u05e4\u05e8\u05e2\u05ea \u05d0\u05d9\u05e9\u05d9\u05d5\u05ea \u05e0\u05de\u05e0\u05e2\u05ea (Avoidant PD) \u05d1\u05d4\u05e7\u05e9\u05e8 \u05e9\u05dc \u05d4\u05d9\u05de\u05e0\u05e2\u05d5\u05ea \u05de\u05d7\u05e9\u05d9\u05e4\u05d4?",
      "back": "\u05d1-PPD \u05d4\u05d4\u05d9\u05de\u05e0\u05e2\u05d5\u05ea \u05e0\u05d5\u05d1\u05e2\u05ea \u05de\u05e4\u05d7\u05d3 \u05de\u05db\u05d5\u05d5\u05e0\u05d5\u05ea \u05d6\u05d3\u05d5\u05e0\u05d9\u05d5\u05ea, \u05d1\u05e2\u05d5\u05d3 \u05e9\u05d1-Avoidant PD \u05d4\u05e4\u05d7\u05d3 \u05d4\u05d5\u05d0 \u05de\u05de\u05d1\u05d5\u05db\u05d4 \u05d0\u05d5 \u05d0\u05d9-\u05db\u05e9\u05d9\u05e8\u05d5\u05ea (DSM p.741)."
    },
    {
      "front": "\u05d0\u05d9\u05d6\u05d5 \u05d4\u05e4\u05e8\u05e2\u05d4 \u05d3\u05db\u05d0\u05d5\u05e0\u05d9\u05ea \u05e0\u05de\u05e6\u05d0\u05ea \u05d1\u05e1\u05d9\u05db\u05d5\u05df \u05de\u05d5\u05d2\u05d1\u05e8 \u05d1\u05e7\u05e8\u05d1 \u05d0\u05e0\u05e9\u05d9\u05dd \u05e2\u05dd PPD?",
      "back": "Major Depressive Disorder (DSM p.741)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4-Exclusion \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05d4\u05de\u05d5\u05e4\u05d9\u05e2 \u05d1\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df B \u05e9\u05dc PPD?",
