    {
      "type": "multiple_choice",
      "question": "\u05de\u05d4\u05d5 \u05d4\u05d4\u05d1\u05d3\u05dc \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05d1\u05d9\u05df Paranoid Personality Disorder \u05dc\u05d1\u05d9\u05df Schizotypal Personality Disorder \u05d1\u05d4\u05e7\u05e9\u05e8 \u05e9\u05dc \u05d9\u05d7\u05e1\u05d9\u05dd \u05d1\u05d9\u05e0\u05d0\u05d9\u05e9\u05d9\u05d9\u05dd \u05d5\u05d7\u05e9\u05d9\u05d1\u05d4?",
      "answerOptions": [
