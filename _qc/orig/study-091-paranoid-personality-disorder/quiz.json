        },
        {
          "text": "\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-SSRI \u05d1\u05de\u05d9\u05e0\u05d5\u05df \u05d2\u05d1\u05d5\u05d4 \u05dc\u05d4\u05e4\u05d7\u05ea\u05ea \u05d4\u05d7\u05e8\u05d3\u05d4.",
          "isCorrect": false,
          "rationale": "\u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05e0\u05d5\u05d2\u05d3\u05d5\u05ea \u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05d9\u05db\u05d5\u05dc\u05d5\u05ea \u05dc\u05e1\u05d9\u05d9\u05e2 \u05d0\u05dd \u05d9\u05e9 \u05e7\u05d5\u05de\u05d5\u05e8\u05d1\u05d9\u05d3\u05d9\u05d5\u05ea, \u05d0\u05da \u05d0\u05d9\u05e0\u05df \u05e7\u05d5 \u05e8\u05d0\u05e9\u05d5\u05df \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05d7\u05e9\u05d3\u05e0\u05d5\u05ea \u05d5\u05d1\u05d0\u05d9\u05e8\u05d9\u05d8\u05d1\u05d9\u05dc\u05d9\u05d5\u05ea \u05d1-PPD (Synopsis ch.19 Personality Disorders)."
        },
        {
          "text": "\u05e9\u05d9\u05de\u05d5\u05e9 \u05e7\u05d1\u05d5\u05e2 \u05d1-Benzodiazepines \u05dc\u05d4\u05e4\u05d7\u05ea\u05ea \u05de\u05ea\u05d7 \u05e9\u05e8\u05d9\u05e8\u05d9.",
          "isCorrect": false,
