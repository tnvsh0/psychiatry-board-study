          "text": "\u05d1-PPD \u05d9\u05e9\u05e0\u05d4 \u05e0\u05d8\u05d9\u05d9\u05d4 \u05d7\u05d6\u05e7\u05d4 \u05d9\u05d5\u05ea\u05e8 \u05dc\u05d4\u05d6\u05d9\u05d5\u05ea \u05e8\u05d0\u05d9\u05d9\u05d4 \u05de\u05d0\u05e9\u05e8 \u05d1-Schizotypal.",
          "isCorrect": false,
          "rationale": "\u05d4\u05d6\u05d9\u05d5\u05ea \u05d0\u05d9\u05e0\u05df \u05d7\u05dc\u05e7 \u05de\u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05dc\u05d0\u05e3 \u05d0\u05d7\u05ea \u05de\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05d4\u05d0\u05d9\u05e9\u05d9\u05d5\u05ea \u05d4\u05dc\u05dc\u05d5 (DSM p.740, p.744)."
        },
        {
          "text": "\u05d1-Schizotypal \u05d4\u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd \u05db\u05de\u05d4\u05d9\u05dd \u05dc\u05e7\u05e9\u05e8\u05d9\u05dd \u05d7\u05d1\u05e8\u05ea\u05d9\u05d9\u05dd \u05d0\u05da \u05d7\u05d5\u05e9\u05e9\u05d9\u05dd \u05de\u05d3\u05d7\u05d9\u05d9\u05d4, \u05d1\u05e0\u05d9\u05d2\u05d5\u05d3 \u05dc-PPD.",
          "isCorrect": false,
          "rationale": "\u05ea\u05d9\u05d0\u05d5\u05e8 \u05d6\u05d4 \u05de\u05ea\u05d0\u05d9\u05dd \u05d9\u05d5\u05ea\u05e8 \u05dc-Avoidant Personality Disorder; \u05d1\u05e9\u05ea\u05d9 \u05d4\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea (PPD \u05d5-Schizotypal) \u05d9\u05e9 \u05e7\u05d5\u05e9\u05d9 \u05d0\u05d5 \u05d7\u05d5\u05e1\u05e8 \u05e2\u05e0\u05d9\u05d9\u05df \u05d1\u05e7\u05e9\u05e8\u05d9\u05dd \u05e7\u05e8\u05d5\u05d1\u05d9\u05dd (DSM p.744, p.741)."
        },
        {
          "text": "PPD \u05de\u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05ea \u05d1\u05d3\u05dc\u05d5\u05d6\u05d9\u05d5\u05ea \u05e7\u05d1\u05d5\u05e2\u05d5\u05ea, \u05d1\u05e2\u05d5\u05d3 \u05e9-Schizotypal \u05de\u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05ea \u05e8\u05e7 \u05d1\u05d7\u05e9\u05d3\u05e0\u05d5\u05ea.",
          "isCorrect": false,
          "rationale": "\u05d0\u05e3 \u05d0\u05d7\u05ea \u05de\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05d4\u05d0\u05d9\u05e9\u05d9\u05d5\u05ea \u05d0\u05d9\u05e0\u05d4 \u05db\u05d5\u05dc\u05dc\u05ea \u05d3\u05dc\u05d5\u05d6\u05d9\u05d5\u05ea \u05e7\u05d1\u05d5\u05e2\u05d5\u05ea (psychotic-level) \u05db\u05d7\u05dc\u05e7 \u05de\u05d4\u05d2\u05d3\u05e8\u05ea\u05d4 (Synopsis ch.19 Personality Disorders)."
        }
      ],
      "hint": "\u05d7\u05e4\u05e9\u05d5 \u05d0\u05ea \u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d4'\u05de\u05d5\u05d6\u05e8\u05d9\u05dd' (odd/eccentric) \u05e9\u05de\u05d5\u05e4\u05d9\u05e2\u05d9\u05dd \u05e8\u05e7 \u05d1\u05d0\u05d7\u05ea \u05de\u05d4\u05e9\u05ea\u05d9\u05d9\u05dd.",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05de\u05d8\u05d5\u05e4\u05dc\u05ea \u05e2\u05dd Paranoid Personality Disorder \u05de\u05d5\u05e4\u05e0\u05d9\u05ea \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05e7\u05d1\u05d5\u05e6\u05ea\u05d9 \u05dc\u05e9\u05d9\u05e4\u05d5\u05e8 \u05de\u05d9\u05d5\u05de\u05e0\u05d5\u05d9\u05d5\u05ea \u05d7\u05d1\u05e8\u05ea\u05d9\u05d5\u05ea. \u05de\u05d4\u05d9 \u05d4\u05de\u05db\u05e9\u05dc\u05d4 \u05d4\u05e2\u05d9\u05e7\u05e8\u05d9\u05ea \u05d4\u05e6\u05e4\u05d5\u05d9\u05d4 \u05d1\u05e4\u05d5\u05e8\u05de\u05d8 \u05d6\u05d4 \u05dc\u05e4\u05d9 \u05d4-Synopsis?",
      "answerOptions": [
        {
          "text": "\u05d4\u05de\u05d8\u05d5\u05e4\u05dc\u05ea \u05ea\u05ea\u05e7\u05e9\u05d4 \u05dc\u05e1\u05d1\u05d5\u05dc \u05d0\u05ea \u05d4\u05d7\u05d5\u05d3\u05e8\u05e0\u05d5\u05ea (intrusiveness) \u05e9\u05dc \u05d4\u05e7\u05d1\u05d5\u05e6\u05d4 \u05d5\u05ea\u05e4\u05e8\u05e9 \u05d0\u05ea \u05ea\u05d2\u05d5\u05d1\u05d5\u05ea \u05d4\u05de\u05e9\u05ea\u05ea\u05e4\u05d9\u05dd \u05db\u05e2\u05d5\u05d9\u05e0\u05d5\u05ea.",
          "isCorrect": true,
          "rationale": "\u05d1\u05e9\u05dc \u05d4\u05d7\u05e9\u05d3\u05e0\u05d5\u05ea \u05d4\u05e8\u05d1\u05d4, \u05e1\u05d9\u05d8\u05d5\u05d0\u05e6\u05d9\u05d4 \u05e7\u05d1\u05d5\u05e6\u05ea\u05d9\u05ea \u05e0\u05ea\u05e4\u05e1\u05ea \u05db\u05de\u05d0\u05d9\u05d9\u05de\u05ea \u05d5\u05d7\u05d5\u05d3\u05e8\u05e0\u05d9\u05ea \u05de\u05d3\u05d9 \u05e2\u05d1\u05d5\u05e8 \u05de\u05d8\u05d5\u05e4\u05dc\u05d9 PPD (Synopsis ch.19 Personality Disorders)."
        },
        {
          "text": "\u05d4\u05de\u05d8\u05d5\u05e4\u05dc\u05ea \u05ea\u05e9\u05ea\u05dc\u05d8 \u05e2\u05dc \u05d4\u05e9\u05d9\u05d7\u05d4 \u05d5\u05ea\u05e4\u05d2\u05d9\u05df \u05d2\u05e8\u05e0\u05d3\u05d9\u05d5\u05d6\u05d9\u05d5\u05ea \u05e9\u05ea\u05e4\u05e8\u05d9\u05e2 \u05dc\u05e9\u05d0\u05e8 \u05d4\u05de\u05e9\u05ea\u05ea\u05e4\u05d9\u05dd.",
          "isCorrect": false,
          "rationale": "\u05ea\u05d9\u05d0\u05d5\u05e8 \u05d6\u05d4 \u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05d9\u05d5\u05ea\u05e8 Narcissistic Personality Disorder \u05d0\u05d5 \u05d0\u05e4\u05d9\u05d6\u05d5\u05d3\u05d4 \u05de\u05d0\u05e0\u05d9\u05ea (DSM p.739)."
        },
        {
          "text": "\u05d4\u05de\u05d8\u05d5\u05e4\u05dc\u05ea \u05ea\u05e4\u05ea\u05d7 \u05ea\u05dc\u05d5\u05ea \u05e2\u05d6\u05d4 \u05d1\u05de\u05e0\u05d7\u05d4 \u05d4\u05e7\u05d1\u05d5\u05e6\u05d4 \u05d5\u05ea\u05e1\u05e8\u05d1 \u05dc\u05d4\u05d9\u05e4\u05e8\u05d3 \u05de\u05de\u05e0\u05d5.",
          "isCorrect": false,
          "rationale": "\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d6\u05d5 \u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05ea Borderline \u05d0\u05d5 Dependent Personality Disorder, \u05d1\u05e2\u05d5\u05d3 \u05e9-PPD \u05de\u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05ea \u05d1\u05d7\u05d5\u05e1\u05e8 \u05d0\u05de\u05d5\u05df \u05d5\u05d1\u05e8\u05d9\u05d7\u05d5\u05e7 (DSM p.741)."
        },
        {
          "text": "\u05d4\u05de\u05d8\u05d5\u05e4\u05dc\u05ea \u05ea\u05e1\u05d1\u05d5\u05dc \u05de\u05d4\u05d6\u05d9\u05d5\u05ea \u05e9\u05de\u05d9\u05e2\u05d4 \u05db\u05ea\u05d5\u05e6\u05d0\u05d4 \u05de\u05d4\u05dc\u05d7\u05e5 \u05d4\u05d7\u05d1\u05e8\u05ea\u05d9 \u05d1\u05e7\u05d1\u05d5\u05e6\u05d4.",
          "isCorrect": false,
          "rationale": "\u05dc\u05d7\u05e5 \u05d7\u05d1\u05e8\u05ea\u05d9 \u05e2\u05e9\u05d5\u05d9 \u05dc\u05d4\u05d5\u05d1\u05d9\u05dc \u05dc\u05d0\u05e4\u05d9\u05d6\u05d5\u05d3\u05d5\u05ea \u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9\u05d5\u05ea \u05e7\u05e6\u05e8\u05d5\u05ea \u05de\u05d0\u05d5\u05d3, \u05d0\u05da \u05d4\u05d6\u05d9\u05d5\u05ea \u05d0\u05d9\u05e0\u05df \u05ea\u05d2\u05d5\u05d1\u05d4 \u05e1\u05d8\u05e0\u05d3\u05e8\u05d8\u05d9\u05ea \u05d0\u05d5 \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df \u05dc-PPD (DSM p.741)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d1\u05d5 \u05e2\u05dc \u05d4\u05e0\u05d8\u05d9\u05d9\u05d4 \u05e9\u05dc \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05d4\u05e4\u05e8\u05e0\u05d5\u05d0\u05d9\u05d3\u05d9 \u05dc\u05d4\u05e9\u05dc\u05d9\u05da \u05de\u05e0\u05d9\u05e2\u05d9\u05dd \u05e9\u05dc\u05d9\u05dc\u05d9\u05d9\u05dd \u05e2\u05dc \u05d0\u05d9\u05e0\u05d8\u05e8\u05d0\u05e7\u05e6\u05d9\u05d5\u05ea \u05d7\u05d1\u05e8\u05ea\u05d9\u05d5\u05ea \u05de\u05e8\u05d5\u05d1\u05d5\u05ea.",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05de\u05d4\u05d5 \u05d4\u05de\u05d4\u05dc\u05da (Course) \u05d5\u05d4\u05e4\u05e8\u05d5\u05d2\u05e0\u05d5\u05d6\u05d4 \u05d4\u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05d9\u05d9\u05dd \u05dc-Paranoid Personality Disorder \u05dc\u05d0\u05d5\u05e8\u05da \u05d4\u05d7\u05d9\u05d9\u05dd?",
      "answerOptions": [
        {
          "text": "\u05d4\u05e4\u05e8\u05e2\u05d4 \u05db\u05e8\u05d5\u05e0\u05d9\u05ea \u05d4\u05de\u05d5\u05d1\u05d9\u05dc\u05d4 \u05dc\u05d1\u05e2\u05d9\u05d5\u05ea \u05de\u05ea\u05de\u05e9\u05db\u05d5\u05ea \u05d1\u05ea\u05e4\u05e7\u05d5\u05d3 \u05d4\u05ea\u05e2\u05e1\u05d5\u05e7\u05ea\u05d9 \u05d5\u05d4\u05d6\u05d5\u05d2\u05d9.",
          "isCorrect": true,
          "rationale": "\u05d4\u05e4\u05e8\u05e2\u05ea \u05d0\u05d9\u05e9\u05d9\u05d5\u05ea \u05d6\u05d5 \u05d4\u05d9\u05d0 \u05dc\u05e8\u05d5\u05d1 lifelong \u05d5\u05de\u05dc\u05d5\u05d5\u05d4 \u05d1\u05e7\u05e9\u05d9\u05d9\u05dd \u05db\u05e8\u05d5\u05e0\u05d9\u05d9\u05dd \u05d1\u05e2\u05d1\u05d5\u05d3\u05d4 \u05d5\u05d1\u05d7\u05d9\u05d9\u05dd \u05d4\u05de\u05e9\u05d5\u05ea\u05e4\u05d9\u05dd \u05e2\u05dd \u05d0\u05d7\u05e8\u05d9\u05dd (Synopsis ch.19 Personality Disorders)."
        },
        {
          "text": "\u05e9\u05d9\u05e4\u05d5\u05e8 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9 \u05d5\u05d4\u05d9\u05e2\u05dc\u05de\u05d5\u05ea \u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e2\u05dd \u05d4\u05db\u05e0\u05d9\u05e1\u05d4 \u05dc\u05d2\u05d9\u05dc \u05d4\u05e2\u05de\u05d9\u05d3\u05d4.",
          "isCorrect": false,
          "rationale": "\u05d1\u05e0\u05d9\u05d2\u05d5\u05d3 \u05dc\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05de\u05e1\u05d5\u05d9\u05de\u05d5\u05ea \u05d1\u05e7\u05dc\u05e1\u05d8\u05e8 B, \u05ea\u05db\u05d5\u05e0\u05d5\u05ea \u05e4\u05e8\u05e0\u05d5\u05d0\u05d9\u05d3\u05d9\u05d5\u05ea \u05e0\u05d5\u05d8\u05d5\u05ea \u05dc\u05d4\u05d9\u05e9\u05d0\u05e8 \u05d9\u05e6\u05d9\u05d1\u05d5\u05ea \u05dc\u05d0\u05d5\u05e8\u05da \u05d6\u05de\u05df (Synopsis ch.19 Personality Disorders)."
        },
        {
          "text": "\u05d4\u05d7\u05dc\u05de\u05d4 \u05de\u05dc\u05d0\u05d4 \u05dc\u05d0\u05d7\u05e8 \u05e7\u05d5\u05e8\u05e1 \u05e7\u05e6\u05e8 \u05e9\u05dc \u05e4\u05e1\u05d9\u05db\u05d5\u05ea\u05e8\u05e4\u05d9\u05d4 \u05d3\u05d9\u05e0\u05de\u05d9\u05ea.",
          "isCorrect": false,
          "rationale": "\u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-PPD \u05d4\u05d5\u05d0 \u05de\u05de\u05d5\u05e9\u05da \u05d5\u05de\u05d0\u05ea\u05d2\u05e8 \u05de\u05d0\u05d5\u05d3 \u05d1\u05e9\u05dc \u05d4\u05e7\u05d5\u05e9\u05d9 \u05d1\u05d9\u05e6\u05d9\u05e8\u05ea \u05d1\u05e8\u05d9\u05ea \u05d8\u05d9\u05e4\u05d5\u05dc\u05d9\u05ea (Synopsis ch.19 Personality Disorders)."
        },
        {
          "text": "\u05de\u05d4\u05dc\u05da \u05d0\u05e4\u05d9\u05d6\u05d5\u05d3\u05d9 \u05d4\u05de\u05d0\u05d5\u05e4\u05d9\u05d9\u05df \u05d1\u05ea\u05e7\u05d5\u05e4\u05d5\u05ea \u05e9\u05dc \u05e8\u05de\u05d9\u05e1\u05d9\u05d4 \u05de\u05dc\u05d0\u05d4.",
          "isCorrect": false,
          "rationale": "\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05d0\u05d9\u05e9\u05d9\u05d5\u05ea \u05de\u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05d5\u05ea \u05d1\u05d3\u05e4\u05d5\u05e1 \u05e7\u05e9\u05d9\u05d7 \u05d5\u05d9\u05e6\u05d9\u05d1, \u05d5\u05dc\u05d0 \u05d1\u05de\u05d4\u05dc\u05da \u05d0\u05e4\u05d9\u05d6\u05d5\u05d3\u05d9 (DSM p.735)."
        }
      ],
      "hint": "\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05d0\u05d9\u05e9\u05d9\u05d5\u05ea \u05de\u05d5\u05d2\u05d3\u05e8\u05d5\u05ea \u05db\u05d3\u05e4\u05d5\u05e1\u05d9\u05dd \u05de\u05ea\u05de\u05e9\u05db\u05d9\u05dd \u05d5\u05e7\u05e9\u05d9\u05d7\u05d9\u05dd \u05d4\u05d7\u05dc \u05de\u05d4\u05d1\u05d2\u05e8\u05d5\u05ea \u05d4\u05de\u05d5\u05e7\u05d3\u05de\u05ea.",
