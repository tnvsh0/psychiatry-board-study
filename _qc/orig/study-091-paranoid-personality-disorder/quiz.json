{
  "title": "Paranoia Quiz",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\u05de\u05ea\u05d1\u05d2\u05e8 \u05d1\u05df 17 \u05de\u05d5\u05e4\u05e0\u05d4 \u05dc\u05d4\u05e2\u05e8\u05db\u05d4 \u05dc\u05d0\u05d7\u05e8 \u05e9\u05d4\u05e1\u05ea\u05d2\u05e8 \u05d1\u05d7\u05d3\u05e8\u05d5 \u05d5\u05d8\u05e2\u05df \u05db\u05d9 \u05d4\u05de\u05d5\u05e8\u05d9\u05dd \u05d1\u05d1\u05d9\u05ea \u05d4\u05e1\u05e4\u05e8 '\u05e1\u05d9\u05de\u05e0\u05d5 \u05d0\u05d5\u05ea\u05d5' \u05d5\u05de\u05d7\u05dc\u05d9\u05e4\u05d9\u05dd \u05d1\u05d9\u05e0\u05d9\u05d4\u05dd \u05de\u05d9\u05d3\u05e2 \u05db\u05d3\u05d9 \u05dc\u05d4\u05db\u05e9\u05d9\u05dc\u05d5 \u05d1\u05de\u05d1\u05d7\u05e0\u05d9\u05dd. \u05d1\u05d1\u05d3\u05d9\u05e7\u05d4, \u05d4\u05d5\u05d0 \u05de\u05e4\u05d2\u05d9\u05df \u05d7\u05e9\u05d3\u05e0\u05d5\u05ea \u05e8\u05d1\u05d4 \u05db\u05dc\u05e4\u05d9 \u05d4\u05de\u05e8\u05d0\u05d9\u05d9\u05df, \u05de\u05e1\u05e8\u05d1 \u05dc\u05e2\u05e0\u05d5\u05ea \u05e2\u05dc \u05e9\u05d0\u05dc\u05d5\u05ea \u05d0\u05d9\u05e9\u05d9\u05d5\u05ea \u05de\u05d7\u05e9\u05e9 \u05e9\u05d9\u05d9\u05e2\u05e9\u05d4 \u05d1\u05d4\u05df \u05e9\u05d9\u05de\u05d5\u05e9 \u05e0\u05d2\u05d3\u05d5, \u05d5\u05de\u05e4\u05e8\u05e9 \u05d4\u05e2\u05e8\u05d5\u05ea \u05e0\u05d9\u05d8\u05e8\u05dc\u05d9\u05d5\u05ea \u05e9\u05dc \u05d4\u05d5\u05e8\u05d9\u05d5 \u05db\u05d0\u05d9\u05d5\u05de\u05d9\u05dd \u05de\u05d5\u05e1\u05d5\u05d5\u05d9\u05dd. \u05d4\u05d5\u05d0 \u05d0\u05d9\u05e0\u05d5 \u05de\u05d3\u05d5\u05d5\u05d7 \u05e2\u05dc \u05d4\u05d6\u05d9\u05d5\u05ea \u05e9\u05de\u05d9\u05e2\u05d4 \u05d5\u05d0\u05d9\u05df \u05e2\u05d3\u05d5\u05ea \u05dc\u05de\u05d7\u05e9\u05d1\u05d5\u05ea \u05e9\u05d5\u05d5\u05d0 \u05d1\u05d9\u05d6\u05d0\u05e8\u05d9\u05d5\u05ea \u05d0\u05d5 \u05e7\u05d1\u05d5\u05e2\u05d5\u05ea. \u05de\u05d4\u05d9 \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05e1\u05d1\u05d9\u05e8\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR?",
      "answerOptions": [
        {
          "text": "Paranoid Personality Disorder",
          "isCorrect": true,
          "rationale": "\u05d4\u05e7\u05dc\u05d9\u05e0\u05d9\u05e7\u05d4 \u05de\u05e6\u05d9\u05d2\u05d4 \u05d3\u05e4\u05d5\u05e1 \u05d7\u05d3\u05d9\u05e8 \u05e9\u05dc \u05d7\u05e9\u05d3\u05e0\u05d5\u05ea \u05d5\u05d7\u05d5\u05e1\u05e8 \u05d0\u05de\u05d5\u05df \u05d1\u05d0\u05d7\u05e8\u05d9\u05dd (\u05dc\u05e4\u05d7\u05d5\u05ea 4 \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd), \u05dc\u05dc\u05d0 \u05e2\u05d3\u05d5\u05ea \u05dc\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9\u05d9\u05dd \u05e7\u05d1\u05d5\u05e2\u05d9\u05dd \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9\u05dd \u05e1\u05db\u05d9\u05d6\u05d5\u05e4\u05e8\u05e0\u05d9\u05d4 \u05d0\u05d5 \u05d4\u05e4\u05e8\u05e2\u05d4 \u05d3\u05dc\u05d5\u05d6\u05d9\u05d5\u05e0\u05dc\u05d9\u05ea (DSM p.738)."
        },
        {
          "text": "Schizophrenia",
          "isCorrect": false,
          "rationale": "\u05dc\u05d0\u05d5\u05d1\u05d7\u05df \u05d1\u05e1\u05db\u05d9\u05d6\u05d5\u05e4\u05e8\u05e0\u05d9\u05d4 \u05e0\u05d3\u05e8\u05e9\u05d9\u05dd \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d7\u05d9\u05d5\u05d1\u05d9\u05d9\u05dd \u05d1\u05d5\u05dc\u05d8\u05d9\u05dd \u05db\u05de\u05d5 \u05d4\u05d6\u05d9\u05d5\u05ea \u05d0\u05d5 \u05d3\u05dc\u05d5\u05d6\u05d9\u05d5\u05ea \u05de\u05d0\u05d5\u05e8\u05d2\u05e0\u05d5\u05ea \u05dc\u05d0\u05d5\u05e8\u05da \u05d6\u05de\u05df, \u05e9\u05d0\u05d9\u05e0\u05dd \u05de\u05d5\u05e4\u05d9\u05e2\u05d9\u05dd \u05d1\u05de\u05e7\u05e8\u05d4 \u05d6\u05d4 (DSM p.113)."
        },
        {
          "text": "Delusional Disorder, Persecutory type",
          "isCorrect": false,
          "rationale": "\u05d4\u05e4\u05e8\u05e2\u05d4 \u05d3\u05dc\u05d5\u05d6\u05d9\u05d5\u05e0\u05dc\u05d9\u05ea \u05de\u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05ea \u05d1\u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05e9\u05dc \u05d3\u05dc\u05d5\u05d6\u05d9\u05d4 \u05d0\u05d7\u05ea \u05e7\u05d1\u05d5\u05e2\u05d4 \u05d5\u05e0\u05d5\u05e7\u05e9\u05d4 \u05dc\u05e4\u05d7\u05d5\u05ea, \u05d1\u05e2\u05d5\u05d3 \u05e9\u05d1-PPD \u05d4\u05d7\u05e9\u05d3\u05e0\u05d5\u05ea \u05d4\u05d9\u05d0 \u05e0\u05e8\u05d7\u05d1\u05ea \u05d5\u05d7\u05d3\u05d9\u05e8\u05d4 \u05dc\u05dc\u05d0 \u05d3\u05dc\u05d5\u05d6\u05d9\u05d4 \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05ea \u05d5\u05de\u05d2\u05d5\u05d1\u05e9\u05ea (Synopsis ch.19 Personality Disorders)."
        },
        {
          "text": "Schizotypal Personality Disorder",
          "isCorrect": false,
          "rationale": "\u05d0\u05e3 \u05e2\u05dc \u05e4\u05d9 \u05e9\u05e7\u05d9\u05d9\u05de\u05ea \u05d7\u05e9\u05d3\u05e0\u05d5\u05ea, \u05d7\u05e1\u05e8\u05d9\u05dd \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9\u05dd \u05e9\u05dc \u05e2\u05d9\u05d5\u05d5\u05ea\u05d9\u05dd \u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9\u05d9\u05dd \u05d0\u05d5 \u05e4\u05e8\u05e1\u05e4\u05d8\u05d5\u05d0\u05dc\u05d9\u05d9\u05dd (\u05db\u05de\u05d5 \u05d7\u05e9\u05d9\u05d1\u05d4 \u05de\u05d0\u05d2\u05d9\u05ea \u05d0\u05d5 \u05d0\u05d9\u05dc\u05d5\u05d6\u05d9\u05d5\u05ea \u05d2\u05d5\u05e4\u05e0\u05d9\u05d5\u05ea) \u05d5\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d0\u05e7\u05e1\u05e6\u05e0\u05d8\u05e8\u05d9\u05ea \u05de\u05d5\u05d1\u05d4\u05e7\u05ea (DSM p.744)."
        }
      ],
      "hint": "\u05d4\u05ea\u05de\u05e7\u05d3\u05d5 \u05d1\u05d4\u05d1\u05d7\u05e0\u05d4 \u05d1\u05d9\u05df \u05d7\u05e9\u05d3\u05e0\u05d5\u05ea \u05d7\u05d3\u05d9\u05e8\u05d4 \u05dc\u05d1\u05d9\u05df \u05de\u05d7\u05e9\u05d1\u05d5\u05ea \u05e9\u05d5\u05d5\u05d0 \u05e7\u05d1\u05d5\u05e2\u05d5\u05ea \u05d0\u05d5 \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9\u05d9\u05dd \u05d7\u05d9\u05d5\u05d1\u05d9\u05d9\u05dd.",
      "imageUrls": []
    },
    {
      "type": "short_answer",
      "question": "\u05d1\u05de\u05d4\u05dc\u05da \u05d8\u05d9\u05e4\u05d5\u05dc \u05e4\u05e1\u05d9\u05db\u05d5\u05ea\u05e8\u05e4\u05d9 \u05d1\u05de\u05d8\u05d5\u05e4\u05dc \u05e2\u05dd Paranoid Personality Disorder, \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05de\u05d0\u05e9\u05d9\u05dd \u05d0\u05ea \u05d4\u05de\u05d8\u05e4\u05dc \u05d1\u05db\u05da \u05e9\u05d0\u05d9\u05d7\u05e8 \u05d1-3 \u05d3\u05e7\u05d5\u05ea \u05dc\u05e4\u05d2\u05d9\u05e9\u05d4 \u05d1\u05db\u05d5\u05d5\u05e0\u05d4 \u05db\u05d3\u05d9 '\u05dc\u05d1\u05d7\u05d5\u05df \u05d0\u05ea \u05e1\u05d1\u05dc\u05e0\u05d5\u05ea\u05d5' \u05d5\u05db\u05d7\u05dc\u05e7 \u05de\u05e0\u05d9\u05e1\u05d9\u05d5\u05df \u05dc\u05e9\u05dc\u05d5\u05d8 \u05d1\u05d5. \u05de\u05d4\u05d9 \u05d4\u05d2\u05d9\u05e9\u05d4 \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc\u05d9\u05ea \u05d4\u05de\u05d5\u05de\u05dc\u05e6\u05ea \u05dc\u05d4\u05ea\u05de\u05d5\u05d3\u05d3\u05d5\u05ea \u05e2\u05dd \u05d4\u05d0\u05e9\u05de\u05d4 \u05d6\u05d5 \u05dc\u05e4\u05d9 \u05d4-Synopsis?",
      "grading": {
        "modelAnswer": "\u05e2\u05dc \u05d4\u05de\u05d8\u05e4\u05dc \u05dc\u05e0\u05d4\u05d5\u05d2 \u05d1\u05e9\u05e7\u05d9\u05e4\u05d5\u05ea \u05d5\u05d1\u05d9\u05d5\u05e9\u05e8, \u05dc\u05d4\u05d5\u05d3\u05d5\u05ea \u05d1\u05d8\u05e2\u05d5\u05ea (\u05d4\u05d0\u05d9\u05d7\u05d5\u05e8) \u05d5\u05dc\u05d4\u05ea\u05e0\u05e6\u05dc \u05d1\u05d0\u05d5\u05e4\u05df \u05db\u05df \u05d5\u05e2\u05e0\u05d9\u05d9\u05e0\u05d9. \u05d9\u05e9 \u05dc\u05d4\u05d9\u05de\u05e0\u05e2 \u05de\u05d4\u05e1\u05d1\u05e8\u05d9\u05dd \u05d4\u05d2\u05e0\u05ea\u05d9\u05d9\u05dd \u05d0\u05d5 \u05de\u05d0\u05d9\u05e0\u05d8\u05e8\u05e4\u05e8\u05d8\u05e6\u05d9\u05d5\u05ea \u05de\u05e2\u05de\u05d9\u05e7\u05d5\u05ea \u05dc\u05d2\u05d1\u05d9 \u05e8\u05d2\u05e9\u05d5\u05ea \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05d1\u05e9\u05dc\u05d1 \u05d6\u05d4, \u05e9\u05db\u05df \u05d0\u05dc\u05d5 \u05e2\u05dc\u05d5\u05dc\u05d9\u05dd \u05dc\u05d4\u05d2\u05d1\u05d9\u05e8 \u05d0\u05ea \u05d4\u05d7\u05e9\u05d3\u05e0\u05d5\u05ea \u05d5\u05dc\u05e4\u05d2\u05d5\u05e2 \u05d1\u05d1\u05e8\u05d9\u05ea \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc\u05d9\u05ea.",
        "rationale": "\u05d1\u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd \u05e2\u05dd PPD, \u05d9\u05d5\u05e9\u05e8 \u05d5\u05e9\u05e7\u05d9\u05e4\u05d5\u05ea \u05e9\u05dc \u05d4\u05de\u05d8\u05e4\u05dc \u05d4\u05dd \u05e7\u05e8\u05d9\u05d8\u05d9\u05d9\u05dd \u05dc\u05d1\u05e0\u05d9\u05d9\u05ea \u05d0\u05de\u05d5\u05df \u05de\u05d9\u05e0\u05d9\u05de\u05dc\u05d9, \u05d1\u05e2\u05d5\u05d3 \u05e9\u05d4\u05e1\u05d1\u05e8\u05d9\u05dd \u05d4\u05d2\u05e0\u05ea\u05d9\u05d9\u05dd \u05e0\u05ea\u05e4\u05e1\u05d9\u05dd \u05db\u05e0\u05d9\u05e1\u05d9\u05d5\u05df \u05dc\u05d4\u05e1\u05ea\u05d9\u05e8 \u05d0\u05ea '\u05d4\u05d0\u05de\u05ea' (Synopsis ch.19 Personality Disorders).",
        "requiredAttributes": [
          "\u05e6\u05d9\u05d5\u05df \u05d4\u05e6\u05d5\u05e8\u05da \u05d1\u05d4\u05d5\u05d3\u05d0\u05d4 \u05d1\u05d8\u05e2\u05d5\u05ea \u05d5\u05d4\u05ea\u05e0\u05e6\u05dc\u05d5\u05ea \u05db\u05e0\u05d4.",
          "\u05d4\u05d9\u05de\u05e0\u05e2\u05d5\u05ea \u05de\u05d4\u05e1\u05d1\u05e8\u05d9\u05dd \u05d4\u05d2\u05e0\u05ea\u05d9\u05d9\u05dd.",
          "\u05d4\u05d9\u05de\u05e0\u05e2\u05d5\u05ea \u05de\u05d0\u05d9\u05e0\u05d8\u05e8\u05e4\u05e8\u05d8\u05e6\u05d9\u05d5\u05ea \u05de\u05e2\u05de\u05d9\u05e7\u05d5\u05ea (interpretations)."
        ],
        "errors": {
