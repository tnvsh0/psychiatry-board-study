    {
      "type": "multiple_choice",
      "question": "\u05d1\u05d8\u05d9\u05e4\u05d5\u05dc \u05de\u05e9\u05e4\u05d7\u05ea\u05d9 \u05dc\u05e4\u05d9 \u05d2\u05d9\u05e9\u05ea \u05d4\u05de\u05e2\u05e8\u05db\u05d5\u05ea \u05e9\u05dc Murray Bowen, \u05de\u05d4\u05d9 \u05d4\u05de\u05e9\u05de\u05e2\u05d5\u05ea \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05e9\u05dc \u05de\u05d5\u05e9\u05d2 \u05d4-'Triangulation' (\u05de\u05e9\u05d5\u05dc\u05e9)?",
      "answerOptions": [
