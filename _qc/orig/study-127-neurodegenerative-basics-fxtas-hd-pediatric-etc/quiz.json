{
  "title": "Neuropsychiatry Quiz",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\u05e0\u05e2\u05e8 \u05d1\u05df 14 \u05de\u05d5\u05e4\u05e0\u05d4 \u05dc\u05d4\u05e2\u05e8\u05db\u05d4 \u05d1\u05e9\u05dc \u05d9\u05e8\u05d9\u05d3\u05d4 \u05d3\u05e8\u05e1\u05d8\u05d9\u05ea \u05d1\u05dc\u05d9\u05de\u05d5\u05d3\u05d9\u05dd \u05d1\u05e9\u05e0\u05d4 \u05d4\u05d0\u05d7\u05e8\u05d5\u05e0\u05d4, \u05d0\u05d9\u05e8\u05d9\u05d8\u05d1\u05d9\u05dc\u05d9\u05d5\u05ea \u05e7\u05e9\u05d4 \u05d5\u05d4\u05ea\u05e4\u05e8\u05e6\u05d5\u05d9\u05d5\u05ea \u05d6\u05e2\u05dd. \u05d1\u05d1\u05d3\u05d9\u05e7\u05d4 \u05e4\u05d9\u05d6\u05d9\u05e7\u05dc\u05d9\u05ea \u05e0\u05e6\u05e4\u05d9\u05ea Bradykinesia, \u05e0\u05d5\u05e7\u05e9\u05d5\u05ea \u05e9\u05e8\u05d9\u05e8\u05d9\u05dd \u05d4\u05d9\u05e4\u05e8\u05d8\u05d5\u05e0\u05d9\u05ea (Rigidity) \u05d5\u05d3\u05d9\u05e1\u05d8\u05d5\u05e0\u05d9\u05d4 \u05e7\u05dc\u05d4, \u05dc\u05dc\u05d0 \u05e2\u05d3\u05d5\u05ea \u05dc\u05ea\u05e0\u05d5\u05e2\u05d5\u05ea \u05db\u05d5\u05e8\u05d9\u05d0\u05d8\u05d9\u05d5\u05ea. \u05d0\u05d1\u05d9\u05d5 \u05e9\u05dc \u05d4\u05e0\u05e2\u05e8 \u05d4\u05d7\u05dc \u05dc\u05e1\u05d1\u05d5\u05dc \u05de\u05ea\u05e0\u05d5\u05e2\u05d5\u05ea \u05dc\u05d0 \u05e8\u05e6\u05d5\u05e0\u05d9\u05d5\u05ea \u05d5\u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05d1\u05d2\u05d9\u05dc 45. \u05de\u05d4\u05d5 \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05d2\u05e0\u05d8\u05d9 \u05d4\u05e1\u05d1\u05d9\u05e8 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05de\u05e6\u05d1\u05d5 \u05e9\u05dc \u05d4\u05e0\u05e2\u05e8?",
      "answerOptions": [
        {
          "text": "\u05d4\u05ea\u05e8\u05d7\u05d1\u05d5\u05ea \u05de\u05e1\u05d9\u05d1\u05d9\u05ea \u05e9\u05dc \u05d7\u05d6\u05e8\u05d5\u05ea $CAG$ (\u05de\u05e2\u05dc 50-80) \u05d1\u05d4\u05d5\u05e8\u05e9\u05d4 \u05d0\u05d1\u05d4\u05d9\u05ea.",
          "isCorrect": true,
          "rationale": "\u05d1-Juvenile Huntington's Disease (JHD) \u05e7\u05d9\u05d9\u05dd \u05e1\u05d7\u05e3 \u05d0\u05d1\u05d4\u05d9\u05ea (Paternal transmission bias) \u05d4\u05d2\u05d5\u05e8\u05dd \u05dc\u05d4\u05ea\u05e8\u05d7\u05d1\u05d5\u05ea \u05de\u05e1\u05d9\u05d1\u05d9\u05ea \u05e9\u05dc \u05d7\u05d6\u05e8\u05d5\u05ea $CAG$, \u05de\u05d4 \u05e9\u05de\u05d5\u05d1\u05d9\u05dc \u05dc\u05e4\u05e0\u05d5\u05d8\u05d9\u05e4 \u05e9\u05dc Westphal Variant \u05d4\u05de\u05ea\u05d1\u05d8\u05d0 \u05d1\u05d1\u05e8\u05d3\u05d9\u05e7\u05d9\u05e0\u05d6\u05d9\u05d4 \u05d5\u05e0\u05d5\u05e7\u05e9\u05d5\u05ea \u05d1\u05de\u05e7\u05d5\u05dd \u05db\u05d5\u05e8\u05d9\u05d0\u05d4 (DSM p.727-728)."
        },
        {
          "text": "\u05de\u05d5\u05d8\u05e6\u05d9\u05d9\u05ea $HTT$ \u05e2\u05dd \u05d7\u05d3\u05d9\u05e8\u05d5\u05ea \u05d7\u05dc\u05e7\u05d9\u05ea (Partially penetrant) \u05e9\u05dc 36-39 \u05d7\u05d6\u05e8\u05d5\u05ea.",
          "isCorrect": false,
          "rationale": "\u05d7\u05d3\u05d9\u05e8\u05d5\u05ea \u05d7\u05dc\u05e7\u05d9\u05ea \u05de\u05e7\u05d5\u05e9\u05e8\u05ea \u05dc\u05e8\u05d5\u05d1 \u05dc\u05d4\u05ea\u05e4\u05e8\u05e6\u05d5\u05ea \u05de\u05d0\u05d5\u05d7\u05e8\u05ea \u05de\u05d0\u05d5\u05d3 (\u05de\u05e2\u05dc \u05d2\u05d9\u05dc 70) \u05d5\u05dc\u05d0 \u05dc\u05de\u05e6\u05d2 \u05d7\u05e8\u05d9\u05e3 \u05d5\u05de\u05d5\u05e7\u05d3\u05dd \u05d1\u05d2\u05d9\u05dc \u05d4\u05d4\u05ea\u05d1\u05d2\u05e8\u05d5\u05ea (DSM p.728)."
        },
        {
          "text": "\u05d4\u05d5\u05e8\u05e9\u05d4 \u05d0\u05d5\u05d8\u05d5\u05d6\u05d5\u05de\u05dc\u05d9\u05ea-\u05e8\u05e6\u05e1\u05d9\u05d1\u05d9\u05ea \u05e9\u05dc \u05d4\u05d2\u05df $ATP7B$ \u05d4\u05de\u05de\u05d5\u05e7\u05dd \u05e2\u05dc \u05db\u05e8\u05d5\u05de\u05d5\u05d6\u05d5\u05dd 13.",
          "isCorrect": false,
          "rationale": "\u05d6\u05d4\u05d5 \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05e9\u05dc Wilson's disease; \u05dc\u05de\u05e8\u05d5\u05ea \u05e9\u05d4\u05d9\u05d0 \u05de\u05ea\u05d9\u05d9\u05e6\u05d2\u05ea \u05e2\u05dd \u05e0\u05d5\u05e7\u05e9\u05d5\u05ea \u05d5\u05d3\u05d9\u05e1\u05d0\u05e8\u05ea\u05e8\u05d9\u05d4, \u05e1\u05d9\u05e4\u05d5\u05e8 \u05de\u05e9\u05e4\u05d7\u05ea\u05d9 \u05e9\u05dc HD \u05d0\u05e6\u05dc \u05d4\u05d0\u05d1 \u05de\u05db\u05d5\u05d5\u05df \u05de\u05d5\u05d1\u05d4\u05e7\u05ea \u05dc-JHD (Syllabus p.56)."
        },
        {
          "text": "\u05d4\u05e9\u05ea\u05e7\u05d4 (Silencing) \u05e9\u05dc \u05d4\u05d2\u05df $FMR1$ \u05e2\u05e7\u05d1 \u05de\u05ea\u05d9\u05dc\u05e6\u05d9\u05d9\u05ea \u05d9\u05ea\u05e8 \u05e9\u05dc \u05de\u05e2\u05dc 200 \u05d7\u05d6\u05e8\u05d5\u05ea $CGG$.",
          "isCorrect": false,
          "rationale": "\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d6\u05d4 \u05d2\u05d5\u05e8\u05dd \u05dc-Fragile X Syndrome \u05d4\u05e7\u05dc\u05d0\u05e1\u05d9 \u05d4\u05de\u05ea\u05d1\u05d8\u05d0 \u05d1\u05de\u05d5\u05d2\u05d1\u05dc\u05d5\u05ea \u05e9\u05db\u05dc\u05d9\u05ea \u05d5\u05d0\u05d5\u05d8\u05d9\u05d6\u05dd \u05de\u05d5\u05e7\u05d3\u05dd, \u05d5\u05dc\u05d0 \u05d1\u05d4\u05d9\u05d3\u05e8\u05d3\u05e8\u05d5\u05ea \u05e0\u05d9\u05d5\u05d5\u05e0\u05d9\u05ea \u05de\u05d5\u05d8\u05d5\u05e8\u05d9\u05ea \u05d1\u05d2\u05d9\u05dc \u05d4\u05d4\u05ea\u05d1\u05d2\u05e8\u05d5\u05ea (Dulcan p.120)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05e7\u05e9\u05e8 \u05d1\u05d9\u05df \u05d0\u05d5\u05e8\u05da \u05d4\u05d7\u05d6\u05e8\u05d5\u05ea \u05dc\u05d2\u05d9\u05dc \u05d4\u05e4\u05e8\u05d5\u05e5 \u05d5\u05e2\u05dc \u05d4\u05e4\u05e0\u05d5\u05d8\u05d9\u05e4 \u05d4\u05de\u05d5\u05d8\u05d5\u05e8\u05d9 \u05d4\u05d9\u05d9\u05d7\u05d5\u05d3\u05d9 \u05dc\u05d9\u05dc\u05d3\u05d9\u05dd (Westphal Variant).",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05e0\u05e2\u05e8\u05d4 \u05d1\u05ea 16 \u05de\u05d5\u05d1\u05d0\u05ea \u05dc\u05de\u05d9\u05d5\u05df \u05d1\u05e9\u05dc \u05d4\u05d5\u05e4\u05e2\u05d4 \u05e4\u05ea\u05d0\u05d5\u05de\u05d9\u05ea \u05e9\u05dc \u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d4 \u05e2\u05e9\u05d9\u05e8\u05d4 \u05d1\u05d4\u05d6\u05d9\u05d5\u05ea \u05d7\u05d6\u05d5\u05ea\u05d9\u05d5\u05ea \u05d5\u05de\u05d7\u05e9\u05d1\u05d5\u05ea \u05e9\u05d5\u05d5\u05d0 \u05e8\u05d3\u05d9\u05e4\u05ea\u05d9\u05d5\u05ea. \u05d4\u05d5\u05e8\u05d9\u05d4 \u05de\u05d3\u05d5\u05d5\u05d7\u05d9\u05dd \u05db\u05d9 \u05d1\u05e9\u05e0\u05d4 \u05d4\u05d0\u05d7\u05e8\u05d5\u05e0\u05d4 \u05d4\u05e4\u05db\u05d4 \u05dc'\u05de\u05e8\u05d3\u05e0\u05d9\u05ea', \u05e1\u05d5\u05d1\u05dc\u05ea \u05de\u05e9\u05d9\u05e0\u05d5\u05d9\u05d9 \u05de\u05e6\u05d1 \u05e8\u05d5\u05d7 \u05d5\u05e8\u05e2\u05d3 \u05e7\u05dc \u05d1\u05d9\u05d3\u05d9\u05d9\u05dd \u05d1\u05e2\u05ea \u05db\u05ea\u05d9\u05d1\u05d4. \u05d1\u05d1\u05d3\u05d9\u05e7\u05ea Slit-lamp \u05e0\u05e6\u05e4\u05d9\u05ea \u05d8\u05d1\u05e2\u05ea \u05d1\u05d2\u05d5\u05d5\u05df \u05d7\u05d5\u05dd-\u05d9\u05e8\u05d5\u05e7 \u05d1\u05d4\u05d9\u05e7\u05e3 \u05d4\u05e7\u05e8\u05e0\u05d9\u05ea. \u05de\u05d4\u05d9 \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05e1\u05d1\u05d9\u05e8\u05d4 \u05d5\u05de\u05d4\u05d5 \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05de\u05d5\u05e2\u05d3\u05e3?",
      "answerOptions": [
        {
          "text": "\u05de\u05d7\u05dc\u05ea \u05d5\u05d9\u05dc\u05e1\u05d5\u05df; \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Copper chelators (\u05db\u05d2\u05d5\u05df Penicillamine) \u05d5\u05d0\u05d1\u05e5 \u05d0\u05e6\u05d8\u05d8.",
          "isCorrect": true,
          "rationale": "\u05d1-20%-30% \u05de\u05d7\u05d5\u05dc\u05d9 \u05d5\u05d9\u05dc\u05e1\u05d5\u05df \u05d4\u05de\u05e6\u05d2 \u05d4\u05e8\u05d0\u05e9\u05d5\u05e0\u05d9 \u05d4\u05d5\u05d0 \u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9 \u05d1\u05dc\u05d1\u05d3; \u05d6\u05d9\u05d4\u05d5\u05d9 \u05d8\u05d1\u05e2\u05ea Kayser-Fleischer \u05de\u05d0\u05e9\u05e8 \u05d0\u05ea \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d5\u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05e4\u05d9\u05e0\u05d5\u05d9 \u05e0\u05d7\u05d5\u05e9\u05ea \u05d4\u05d5\u05d0 \u05e7\u05e8\u05d9\u05d8\u05d9 \u05dc\u05de\u05e0\u05d9\u05e2\u05ea \u05e0\u05d6\u05e7 \u05d1\u05dc\u05ea\u05d9 \u05d4\u05e4\u05d9\u05da (Syllabus p.56, DSM p.817)."
        },
        {
          "text": "Childhood-Onset Schizophrenia; \u05d4\u05ea\u05d7\u05dc\u05ea \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Clozapine \u05d1\u05de\u05d9\u05e0\u05d5\u05df \u05e0\u05de\u05d5\u05da.",
          "isCorrect": false,
          "rationale": "\u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05e9\u05dc \u05d8\u05d1\u05e2\u05ea Kayser-Fleischer \u05d5\u05e8\u05e2\u05d3 \u05de\u05d5\u05d8\u05d5\u05e8\u05d9 \u05e9\u05d5\u05dc\u05dc\u05ea \u05e1\u05db\u05d9\u05d6\u05d5\u05e4\u05e8\u05e0\u05d9\u05d4 \u05e8\u05d0\u05e9\u05d5\u05e0\u05d9\u05ea \u05d5\u05de\u05d7\u05d9\u05d9\u05d1\u05ea \u05d1\u05d9\u05e8\u05d5\u05e8 \u05e8\u05e4\u05d5\u05d0\u05d9 \u05d3\u05d7\u05d5\u05e3 \u05dc\u05de\u05d7\u05dc\u05ea \u05d5\u05d9\u05dc\u05e1\u05d5\u05df (Syllabus p.56)."
        },
        {
          "text": "Niemann-Pick Type C; \u05d4\u05ea\u05d7\u05dc\u05ea \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Miglustat \u05dc\u05d4\u05e4\u05d7\u05ea\u05ea \u05d0\u05d2\u05d9\u05e8\u05d4 \u05dc\u05d9\u05d6\u05d5\u05d6\u05d5\u05de\u05dc\u05d9\u05ea.",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05e9-NPC \u05d2\u05d5\u05e8\u05de\u05ea \u05dc\u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d4 \u05d5\u05d3\u05de\u05e0\u05e6\u05d9\u05d4, \u05d8\u05d1\u05e2\u05ea \u05d1\u05e7\u05e8\u05e0\u05d9\u05ea (KF ring) \u05d4\u05d9\u05d0 \u05e1\u05de\u05df \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9 \u05dc\u05de\u05d8\u05d1\u05d5\u05dc\u05d9\u05d6\u05dd \u05e9\u05dc \u05e0\u05d7\u05d5\u05e9\u05ea \u05d1\u05de\u05d7\u05dc\u05ea \u05d5\u05d9\u05dc\u05e1\u05d5\u05df (DSM p.424, Syllabus p.56)."
        },
        {
          "text": "Metachromatic Leukodystrophy; \u05d4\u05e4\u05e0\u05d9\u05d4 \u05d3\u05d7\u05d5\u05e4\u05d4 \u05dc\u05d4\u05e9\u05ea\u05dc\u05ea \u05ea\u05d0\u05d9 \u05d2\u05d6\u05e2 (HSCT).",
          "isCorrect": false,
          "rationale": "MLD \u05de\u05ea\u05d9\u05d9\u05e6\u05d2\u05ea \u05e2\u05dd \u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d4 \u05d5\u05e8\u05d2\u05e8\u05e1\u05d9\u05d4, \u05d0\u05da \u05d4\u05de\u05de\u05e6\u05d0 \u05d4\u05e2\u05d9\u05e0\u05d9 \u05d4\u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05d9 \u05d1-MLD \u05d4\u05d5\u05d0 Optic Atrophy \u05d5\u05dc\u05d0 \u05e9\u05e7\u05d9\u05e2\u05ea \u05e0\u05d7\u05d5\u05e9\u05ea \u05d1\u05e7\u05e8\u05e0\u05d9\u05ea (Syllabus p.55)."
        }
      ],
      "hint": "\u05d4\u05e1\u05d9\u05de\u05df \u05d4\u05e2\u05d9\u05e0\u05d9 \u05d4\u05de\u05ea\u05d5\u05d0\u05e8 \u05d4\u05d5\u05d0 \u05e4\u05ea\u05d5\u05d2\u05e0\u05d5\u05de\u05d5\u05e0\u05d9 \u05dc\u05de\u05d7\u05dc\u05d4 \u05e0\u05d9\u05d5\u05d5\u05e0\u05d9\u05ea \u05d4\u05e0\u05d9\u05ea\u05e0\u05ea \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d5\u05e8\u05d9\u05e4\u05d5\u05d9.",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05d9\u05dc\u05d3 \u05d1\u05df 12 \u05e1\u05d5\u05d1\u05dc \u05de\u05d4\u05ea\u05e7\u05e4\u05d9 \u05e6\u05d7\u05d5\u05e7 \u05d1\u05dc\u05ea\u05d9 \u05e0\u05e9\u05dc\u05d8\u05d9\u05dd \u05e9\u05d1\u05e2\u05e7\u05d1\u05d5\u05ea\u05d9\u05d4\u05dd \u05d4\u05d5\u05d0 \u05d7\u05d5\u05d5\u05d4 \u05e0\u05e4\u05d9\u05dc\u05d5\u05ea \u05e4\u05ea\u05d0\u05d5\u05de\u05d9\u05d5\u05ea \u05dc\u05dc\u05d0 \u05d0\u05d5\u05d1\u05d3\u05df \u05d4\u05db\u05e8\u05d4. \u05d1\u05d1\u05d3\u05d9\u05e7\u05d4 \u05e0\u05d5\u05d9\u05e8\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea \u05e0\u05e6\u05e4\u05d4 \u05e7\u05d5\u05e9\u05d9 \u05e0\u05d9\u05db\u05e8 \u05d1\u05de\u05d1\u05d8 \u05db\u05dc\u05e4\u05d9 \u05de\u05d8\u05d4 (Vertical gaze palsy) \u05d5\u05d0\u05d8\u05e7\u05e1\u05d9\u05d4 \u05e6\u05e8\u05d1\u05dc\u05e8\u05d9\u05ea. \u05de\u05d4\u05d5 \u05d4\u05d1\u05e1\u05d9\u05e1 \u05d4\u05e0\u05d5\u05d9\u05e8\u05d5\u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05dc\u05ea\u05d5\u05e4\u05e2\u05ea \u05d4\u05e0\u05e4\u05d9\u05dc\u05d5\u05ea \u05d1\u05e2\u05ea \u05e6\u05d7\u05d5\u05e7 \u05d1\u05de\u05e7\u05e8\u05d4 \u05d6\u05d4?",
      "answerOptions": [
        {
          "text": "\u05d4\u05e8\u05e1 \u05e0\u05d5\u05d9\u05e8\u05d5\u05e0\u05d9\u05dd \u05d4\u05d9\u05e4\u05d5\u05ea\u05dc\u05de\u05d9\u05d9\u05dd \u05d4\u05de\u05e4\u05e8\u05d9\u05e9\u05d9\u05dd Hypocretin (Orexin).",
          "isCorrect": true,
          "rationale": "\u05d1\u05de\u05d7\u05dc\u05ea Niemann-Pick Type C (NPC) \u05d9\u05e9 \u05d0\u05d5\u05d1\u05d3\u05df \u05e1\u05dc\u05e7\u05d8\u05d9\u05d1\u05d9 \u05e9\u05dc \u05e0\u05d5\u05d9\u05e8\u05d5\u05e0\u05d9\u05dd \u05d0\u05d5\u05e8\u05e7\u05e1\u05d9\u05e0\u05e8\u05d2\u05d9\u05d9\u05dd \u05d1\u05d4\u05d9\u05e4\u05d5\u05ea\u05dc\u05de\u05d5\u05e1, \u05de\u05d4 \u05e9\u05de\u05d5\u05d1\u05d9\u05dc \u05dc-Secondary Narcolepsy \u05d5-Gelastic Cataplexy (\u05d0\u05d5\u05d1\u05d3\u05df \u05d8\u05d5\u05e0\u05d5\u05e1 \u05de\u05d5\u05e4\u05e2\u05dc \u05e6\u05d7\u05d5\u05e7) (DSM p.423-424, StahlNeuro p.433)."
        },
        {
          "text": "\u05e4\u05e8\u05db\u05d5\u05e1\u05d9\u05dd \u05d0\u05e4\u05d9\u05dc\u05e4\u05d8\u05d9\u05d9\u05dd \u05de\u05e1\u05d5\u05d2 Gelastic Seizures \u05e2\u05e7\u05d1 \u05d4\u05de\u05e8\u05d8\u05d5\u05de\u05d4 \u05d1\u05d4\u05d9\u05e4\u05d5\u05ea\u05dc\u05de\u05d5\u05e1.",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05e9\u05e6\u05d7\u05d5\u05e7 \u05d9\u05db\u05d5\u05dc \u05dc\u05d4\u05d9\u05d5\u05ea \u05d1\u05d9\u05d8\u05d5\u05d9 \u05dc\u05d0\u05e4\u05d9\u05dc\u05e4\u05e1\u05d9\u05d4, \u05d4\u05e9\u05d9\u05dc\u05d5\u05d1 \u05e2\u05dd Vertical Gaze Palsy \u05d5\u05d0\u05d8\u05e7\u05e1\u05d9\u05d4 \u05de\u05db\u05d5\u05d5\u05df \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05ea \u05dc\u05de\u05d7\u05dc\u05ea \u05d0\u05d2\u05d9\u05e8\u05d4 \u05db\u05d2\u05d5\u05df NPC (DSM p.424)."
        },
        {
          "text": "\u05d3\u05d4-\u05de\u05d9\u05d0\u05dc\u05d9\u05e0\u05d9\u05d6\u05e6\u05d9\u05d4 \u05e0\u05e8\u05d7\u05d1\u05ea \u05e9\u05dc \u05d4\u05de\u05e1\u05dc\u05d5\u05dc\u05d9\u05dd \u05d4\u05e4\u05d9\u05e8\u05de\u05d9\u05d3\u05dc\u05d9\u05d9\u05dd (UMN signs).",
          "isCorrect": false,
          "rationale": "\u05e4\u05d2\u05d9\u05e2\u05d4 \u05e4\u05d9\u05e8\u05de\u05d9\u05d3\u05dc\u05d9\u05ea \u05d2\u05d5\u05e8\u05de\u05ea \u05dc\u05e1\u05e4\u05e1\u05d8\u05d9\u05d5\u05ea \u05d5\u05d4\u05d9\u05e4\u05e8\u05d8\u05d5\u05e0\u05d9\u05d4, \u05d5\u05dc\u05d0 \u05dc\u05d0\u05d5\u05d1\u05d3\u05df \u05d8\u05d5\u05e0\u05d5\u05e1 \u05e4\u05ea\u05d0\u05d5\u05de\u05d9 (Cataplexy) \u05d4\u05de\u05d5\u05e4\u05e2\u05dc \u05e2\u05dc \u05d9\u05d3\u05d9 \u05e8\u05d2\u05e9 (Dulcan p.93, DSM p.423)."
        },
        {
          "text": "\u05e0\u05d9\u05d5\u05d5\u05df \u05e9\u05dc \u05d4-Medium Spiny Neurons \u05d1-Striatum.",
          "isCorrect": false,
          "rationale": "\u05d6\u05d4\u05d5 \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05e9\u05dc \u05de\u05d7\u05dc\u05ea \u05d4\u05e0\u05d8\u05d9\u05e0\u05d2\u05d8\u05d5\u05df, \u05d4\u05de\u05ea\u05d1\u05d8\u05d0\u05ea \u05d1\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05ea\u05e0\u05d5\u05e2\u05d4 \u05d5\u05e7\u05d5\u05d2\u05e0\u05d9\u05e6\u05d9\u05d4 \u05d0\u05da \u05dc\u05d0 \u05d1-Gelastic Cataplexy \u05d8\u05d9\u05e4\u05d5\u05e1\u05d9\u05ea (StahlNeuro p.87)."
        }
      ],
      "hint": "\u05d4\u05ea\u05e1\u05de\u05d9\u05df \u05d4\u05de\u05ea\u05d5\u05d0\u05e8 (\u05e0\u05e4\u05d9\u05dc\u05d4 \u05d1\u05e2\u05ea \u05e6\u05d7\u05d5\u05e7) \u05e0\u05e7\u05e8\u05d0 Gelastic Cataplexy \u05d5\u05e7\u05e9\u05d5\u05e8 \u05dc\u05de\u05e2\u05e8\u05db\u05ea \u05d5\u05d9\u05e1\u05d5\u05ea \u05d4\u05e2\u05e8\u05d5\u05ea.",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05e2\u05e8\u05db\u05ea \u05d9\u05dc\u05d3 \u05d1\u05df 6 \u05e2\u05dd ADHD \u05d5\u05e2\u05d9\u05db\u05d5\u05d1 \u05e9\u05e4\u05ea\u05d9, \u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8 \u05d4\u05d9\u05dc\u05d3\u05d9\u05dd \u05de\u05d1\u05d7\u05d9\u05df \u05db\u05d9 \u05dc\u05e1\u05d1 \u05d4\u05de\u05dc\u05d5\u05d5\u05d4 \u05d9\u05e9 \u05e8\u05e2\u05d3 \u05d1\u05d5\u05dc\u05d8 \u05d1\u05e2\u05ea \u05d4\u05d5\u05e9\u05d8\u05ea \u05d9\u05d3 \u05dc\u05db\u05d5\u05e1 \u05de\u05d9\u05dd (Intention tremor) \u05d5\u05d4\u05dc\u05d9\u05db\u05d4 \u05dc\u05d0 \u05d9\u05e6\u05d9\u05d1\u05d4 (Ataxia). \u05d4\u05d0\u05dd \u05e1\u05d5\u05d1\u05dc\u05ea \u05de\u05d7\u05e8\u05d3\u05d4 \u05d7\u05d1\u05e8\u05ea\u05d9\u05ea \u05d5\u05db\u05e9\u05dc \u05e9\u05d7\u05dc\u05ea\u05d9 \u05de\u05d5\u05e7\u05d3\u05dd (POI). \u05de\u05d4\u05d5 \u05d4\u05d1\u05d9\u05e8\u05d5\u05e8 \u05d4\u05d2\u05e0\u05d8\u05d9 \u05d4\u05de\u05d5\u05de\u05dc\u05e5 \u05dc\u05e1\u05d1 \u05d5\u05de\u05d4 \u05d4\u05e7\u05e9\u05e8 \u05dc\u05d9\u05dc\u05d3?",
      "answerOptions": [
        {
          "text": "\u05d1\u05d3\u05d9\u05e7\u05ea \u05d7\u05d6\u05e8\u05d5\u05ea $CGG$ \u05d1\u05d2\u05df $FMR1$; \u05dc\u05e1\u05d1 \u05d9\u05e9 \u05db\u05e0\u05e8\u05d0\u05d4 FXTAS \u05d4\u05de\u05e2\u05d9\u05d3 \u05e2\u05dc \u05e0\u05e9\u05d0\u05d5\u05ea \u05e4\u05e8\u05de\u05d5\u05d8\u05e6\u05d9\u05d4 \u05d1\u05de\u05e9\u05e4\u05d7\u05d4.",
          "isCorrect": true,
          "rationale": "FXTAS \u05de\u05d5\u05e4\u05d9\u05e2\u05d4 \u05d1\u05e0\u05e9\u05d0\u05d9 \u05e4\u05e8\u05de\u05d5\u05d8\u05e6\u05d9\u05d4 (55-200 \u05d7\u05d6\u05e8\u05d5\u05ea); \u05d6\u05d9\u05d4\u05d5\u05d9 \u05d4\u05ea\u05e1\u05de\u05d5\u05e0\u05ea \u05d1\u05e1\u05d1 \u05de\u05d7\u05e9\u05d9\u05d3 \u05db\u05d9 \u05d4\u05d9\u05dc\u05d3 \u05e1\u05d5\u05d1\u05dc \u05de-Fragile X Syndrome \u05e2\u05e7\u05d1 \u05d4\u05ea\u05e8\u05d7\u05d1\u05d5\u05ea \u05dc\u05de\u05d5\u05d8\u05e6\u05d9\u05d4 \u05de\u05dc\u05d0\u05d4 (Dulcan p.120, p.142)."
        },
        {
          "text": "\u05d1\u05d3\u05d9\u05e7\u05ea \u05d7\u05d6\u05e8\u05d5\u05ea $CAG$ \u05d1\u05d2\u05df $HTT$; \u05d4\u05e1\u05d1 \u05e1\u05d5\u05d1\u05dc \u05db\u05e0\u05e8\u05d0\u05d4 \u05de-Huntington's Disease \u05d1\u05e4\u05d5\u05e8\u05de\u05d4 \u05dc\u05d8\u05e8\u05dc\u05d9\u05ea.",
          "isCorrect": false,
          "rationale": "\u05de\u05d7\u05dc\u05ea \u05d4\u05e0\u05d8\u05d9\u05e0\u05d2\u05d8\u05d5\u05df \u05dc\u05d0 \u05de\u05e1\u05d1\u05d9\u05e8\u05d4 \u05db\u05e9\u05dc \u05e9\u05d7\u05dc\u05ea\u05d9 \u05de\u05d5\u05e7\u05d3\u05dd (POI) \u05d1\u05d0\u05dd \u05d0\u05d5 \u05d0\u05d8\u05e7\u05e1\u05d9\u05d4 \u05e6\u05e8\u05d1\u05dc\u05e8\u05d9\u05ea \u05de\u05d1\u05d5\u05d3\u05d3\u05ea \u05e2\u05dd \u05e8\u05e2\u05d3 \u05db\u05d5\u05d5\u05e0\u05ea\u05d9 (DSM p.727, Dulcan p.120)."
        },
        {
          "text": "\u05e8\u05d9\u05e6\u05d5\u05e3 \u05d4\u05d2\u05df $NPC1$; \u05d4\u05e1\u05d1 \u05d4\u05d5\u05d0 \u05e0\u05e9\u05d0 \u05e9\u05dc Niemann-Pick C \u05d4\u05de\u05ea\u05d1\u05d8\u05d0\u05ea \u05d1\u05d2\u05d9\u05dc \u05d4\u05de\u05d1\u05d5\u05d2\u05e8.",
          "isCorrect": false,
          "rationale": "NPC \u05d4\u05d9\u05d0 \u05d0\u05d5\u05d8\u05d5\u05d6\u05d5\u05de\u05dc\u05d9\u05ea-\u05e8\u05e6\u05e1\u05d9\u05d1\u05d9\u05ea \u05d5\u05d0\u05d9\u05e0\u05d4 \u05e7\u05e9\u05d5\u05e8\u05d4 \u05dc\u05db\u05e9\u05dc \u05e9\u05d7\u05dc\u05ea\u05d9 \u05de\u05d5\u05e7\u05d3\u05dd \u05d0\u05d5 \u05dc\u05de\u05e6\u05d2 \u05e9\u05dc FXTAS \u05d1\u05e1\u05d1\u05d9\u05dd (DSM p.424)."
        },
        {
          "text": "\u05de\u05d3\u05d9\u05d3\u05ea \u05d7\u05d5\u05de\u05e6\u05d5\u05ea \u05e9\u05d5\u05de\u05df \u05d0\u05e8\u05d5\u05db\u05d5\u05ea \u05e9\u05e8\u05e9\u05e8\u05ea ($VLCFA$); \u05d4\u05e1\u05d1 \u05e1\u05d5\u05d1\u05dc \u05de-Adrenomyeloneuropathy.",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05e9-X-ALD \u05d9\u05db\u05d5\u05dc\u05d4 \u05dc\u05d4\u05ea\u05d1\u05d8\u05d0 \u05d1\u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd, \u05d4\u05e7\u05e9\u05e8 \u05dc-POI \u05d1\u05d0\u05dd \u05d5\u05e2\u05d9\u05db\u05d5\u05d1 \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9 \u05d1\u05d9\u05dc\u05d3 \u05de\u05db\u05d5\u05d5\u05df \u05de\u05d5\u05d1\u05d4\u05e7\u05ea \u05dc\u05de\u05e1\u05dc\u05d5\u05dc \u05d4-FMR1 (Dulcan p.120, Syllabus p.55)."
        }
      ],
      "hint": "\u05d4\u05e9\u05d9\u05dc\u05d5\u05d1 \u05e9\u05dc \u05e8\u05e2\u05d3 \u05d0\u05e6\u05dc \u05d4\u05e1\u05d1, \u05d1\u05e2\u05d9\u05d5\u05ea \u05e4\u05d5\u05e8\u05d9\u05d5\u05ea \u05d1\u05d0\u05dd \u05d5\u05e2\u05d9\u05db\u05d5\u05d1 \u05d1\u05d9\u05dc\u05d3 \u05d4\u05d5\u05d0 \u05e7\u05dc\u05d0\u05e1\u05d9 \u05dc\u05d4\u05d5\u05e8\u05e9\u05d4 \u05d0\u05d7\u05d5\u05d6\u05d4 \u05d1-X \u05de\u05e1\u05d5\u05d9\u05de\u05ea.",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05d9\u05dc\u05d3 \u05d1\u05df 10 \u05e9\u05d4\u05d9\u05d4 \u05ea\u05dc\u05de\u05d9\u05d3 \u05de\u05e6\u05d8\u05d9\u05d9\u05df \u05de\u05e8\u05d0\u05d4 \u05d1\u05e9\u05e0\u05d4 \u05d4\u05d0\u05d7\u05e8\u05d5\u05e0\u05d4 \u05d9\u05e8\u05d9\u05d3\u05d4 \u05d3\u05e8\u05e1\u05d8\u05d9\u05ea \u05d1\u05e6\u05d9\u05d5\u05e0\u05d9\u05dd, \u05e7\u05e9\u05d9\u05d9 \u05e7\u05e9\u05d1 \u05d5\u05d0\u05d9\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05d5\u05ea. \u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8 \u05d0\u05d1\u05d7\u05df \u05d0\u05d5\u05ea\u05d5 \u05d1\u05d8\u05e2\u05d5\u05ea \u05db-Late-onset ADHD. \u05db\u05e2\u05d1\u05d5\u05e8 \u05de\u05e1\u05e4\u05e8 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05d4\u05d9\u05dc\u05d3 \u05e4\u05d9\u05ea\u05d7 \u05e1\u05e4\u05e1\u05d8\u05d9\u05d5\u05ea \u05d1\u05e8\u05d2\u05dc\u05d9\u05d9\u05dd (Spastic diplegia) \u05d5\u05d4\u05d9\u05e4\u05e8-\u05e4\u05d9\u05d2\u05de\u05e0\u05d8\u05e6\u05d9\u05d4 \u05e9\u05dc \u05d4\u05e2\u05d5\u05e8. \u05de\u05d4\u05d5 \u05d4\u05de\u05de\u05e6\u05d0 \u05d4\u05e6\u05e4\u05d5\u05d9 \u05d1-MRI \u05d5\u05de\u05d4\u05d9 \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4?",
      "answerOptions": [
        {
          "text": "\u05d0\u05d5\u05ea \u05d9\u05ea\u05e8 \u05d1-T2 \u05d1\u05d7\u05d5\u05de\u05e8 \u05d4\u05dc\u05d1\u05df \u05d4\u05e4\u05e8\u05d9\u05d0\u05d8\u05d5-\u05d0\u05d5\u05e7\u05e1\u05d9\u05e4\u05d9\u05d8\u05dc\u05d9; X-linked Adrenoleukodystrophy (ALD).",
          "isCorrect": true,
          "rationale": "\u05d1-ALD \u05d4\u05e4\u05d2\u05d9\u05e2\u05d4 \u05d4\u05de\u05d5\u05e7\u05d3\u05de\u05ea \u05d4\u05d9\u05d0 \u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9\u05ea (\u05d3\u05de\u05d5\u05d9 ADHD) \u05e2\u05dd \u05d3\u05d4-\u05de\u05d9\u05d0\u05dc\u05d9\u05e0\u05d9\u05d6\u05e6\u05d9\u05d4 \u05d0\u05d7\u05d5\u05e8\u05d9\u05ea \u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05d9\u05ea \u05d1-MRI \u05d5\u05d0\u05d9-\u05e1\u05e4\u05d9\u05e7\u05ea \u05d0\u05d3\u05e8\u05e0\u05dc (Addison) \u05d4\u05de\u05ea\u05d1\u05d8\u05d0\u05ea \u05d1\u05e4\u05d9\u05d2\u05de\u05e0\u05d8\u05e6\u05d9\u05d4 (Syllabus p.55, DSM p.730)."
        },
        {
          "text": "\u05d0\u05d8\u05e8\u05d5\u05e4\u05d9\u05d4 \u05e9\u05dc \u05d4-Caudate nucleus; \u05de\u05d7\u05dc\u05ea \u05d4\u05e0\u05d8\u05d9\u05e0\u05d2\u05d8\u05d5\u05df \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd.",
          "isCorrect": false,
          "rationale": "\u05d4\u05e0\u05d8\u05d9\u05e0\u05d2\u05d8\u05d5\u05df \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05de\u05ea\u05d1\u05d8\u05d0\u05ea \u05d1\u05e0\u05d5\u05e7\u05e9\u05d5\u05ea (Rigidity) \u05d5\u05d1\u05e8\u05d3\u05d9\u05e7\u05d9\u05e0\u05d6\u05d9\u05d4, \u05d0\u05da \u05dc\u05d0 \u05d1\u05e1\u05e4\u05e1\u05d8\u05d9\u05d5\u05ea \u05e9\u05dc \u05e0\u05d5\u05d9\u05e8\u05d5\u05df \u05de\u05d5\u05d8\u05d5\u05e8\u05d9 \u05e2\u05dc\u05d9\u05d5\u05df (UMN) \u05d0\u05d5 \u05d1\u05e9\u05d9\u05e0\u05d5\u05d9\u05d9 \u05e4\u05d9\u05d2\u05de\u05e0\u05d8\u05e6\u05d9\u05d4 \u05d1\u05e2\u05d5\u05e8 (DSM p.727-728)."
        },
        {
          "text": "\u05d3\u05e4\u05d5\u05e1 '\u05db\u05e0\u05e4\u05d9 \u05e4\u05e8\u05e4\u05e8' (Tigroid pattern) \u05d1\u05d7\u05d5\u05de\u05e8 \u05d4\u05dc\u05d1\u05df \u05d4\u05de\u05e8\u05db\u05d6\u05d9; Metachromatic Leukodystrophy (MLD).",
          "isCorrect": false,
          "rationale": "MLD \u05d0\u05db\u05df \u05d2\u05d5\u05e8\u05de\u05ea \u05dc\u05e8\u05d2\u05e8\u05e1\u05d9\u05d4 \u05d5\u05e1\u05e4\u05e1\u05d8\u05d9\u05d5\u05ea, \u05d0\u05da \u05d0\u05d9\u05e0\u05d4 \u05e7\u05e9\u05d5\u05e8\u05d4 \u05dc\u05d0\u05d9-\u05e1\u05e4\u05d9\u05e7\u05ea \u05d0\u05d3\u05e8\u05e0\u05dc \u05d5\u05dc\u05d4\u05d9\u05e4\u05e8-\u05e4\u05d9\u05d2\u05de\u05e0\u05d8\u05e6\u05d9\u05d4 (Syllabus p.55)."
        },
        {
          "text": "\u05d0\u05d5\u05ea\u05d5\u05ea \u05d9\u05ea\u05e8 \u05d1-Lenticular nucleus; \u05de\u05d7\u05dc\u05ea \u05d5\u05d9\u05dc\u05e1\u05d5\u05df.",
          "isCorrect": false,
          "rationale": "\u05d5\u05d9\u05dc\u05e1\u05d5\u05df \u05de\u05ea\u05d9\u05d9\u05e6\u05d2\u05ea \u05e2\u05dd \u05e8\u05e2\u05d3 \u05d5\u05d3\u05d9\u05e1\u05d8\u05d5\u05e0\u05d9\u05d4, \u05d5\u05d4\u05d9\u05e4\u05e8-\u05e4\u05d9\u05d2\u05de\u05e0\u05d8\u05e6\u05d9\u05d4 \u05d0\u05d9\u05e0\u05d4 \u05d7\u05dc\u05e7 \u05de\u05d4\u05de\u05e6\u05d2 \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9 \u05e9\u05dc\u05d4 (Syllabus p.56)."
        }
      ],
      "hint": "\u05d4\u05d9\u05e4\u05e8-\u05e4\u05d9\u05d2\u05de\u05e0\u05d8\u05e6\u05d9\u05d4 \u05e9\u05dc \u05d4\u05e2\u05d5\u05e8 \u05de\u05e2\u05d9\u05d3\u05d4 \u05e2\u05dc \u05de\u05e2\u05d5\u05e8\u05d1\u05d5\u05ea \u05e9\u05dc \u05d1\u05dc\u05d5\u05d8\u05ea \u05d4\u05d0\u05d3\u05e8\u05e0\u05dc (Adrenal cortex).",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05d1\u05e2\u05ea \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05e0\u05e2\u05e8 \u05e2\u05dd \u05de\u05d7\u05dc\u05ea \u05d5\u05d9\u05dc\u05e1\u05d5\u05df \u05d4\u05e1\u05d5\u05d1\u05dc \u05de\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9\u05d9\u05dd \u05e1\u05d5\u05e2\u05e8\u05d9\u05dd, \u05de\u05d3\u05d5\u05e2 \u05de\u05d5\u05de\u05dc\u05e5 \u05dc\u05d4\u05d9\u05de\u05e0\u05e2 \u05db\u05db\u05dc \u05d4\u05d0\u05e4\u05e9\u05e8 \u05de\u05de\u05ea\u05df \u05e0\u05d5\u05d2\u05d3\u05d9 \u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d4 (Antipsychotics) \u05d5\u05dc\u05d4\u05ea\u05de\u05e7\u05d3 \u05d1\u05d8\u05d9\u05e4\u05d5\u05dc \u05e6\u05dc\u05d8\u05d5\u05e8\u05d9 (Chelators)?",
      "answerOptions": [
        {
          "text": "\u05e7\u05d9\u05d9\u05dd \u05e1\u05d9\u05db\u05d5\u05df \u05de\u05d5\u05d2\u05d1\u05e8 \u05de\u05d0\u05d5\u05d3 \u05dc\u05e4\u05ea\u05d7 EPS \u05d7\u05de\u05d5\u05e8, \u05d3\u05d9\u05e1\u05e7\u05d9\u05e0\u05d6\u05d9\u05d4 \u05d5-NMS \u05e2\u05e7\u05d1 \u05d4\u05e4\u05d2\u05d9\u05e2\u05d4 \u05d4\u05d1\u05e1\u05d9\u05e1\u05d9\u05ea \u05d1\u05d2\u05e8\u05e2\u05d9\u05e0\u05d9 \u05d4\u05d1\u05e1\u05d9\u05e1 \u05d5\u05d4\u05db\u05d1\u05d3.",
          "isCorrect": true,
          "rationale": "\u05d7\u05d5\u05dc\u05d9 \u05d5\u05d9\u05dc\u05e1\u05d5\u05df \u05e8\u05d2\u05d9\u05e9\u05d9\u05dd \u05d1\u05de\u05d9\u05d5\u05d7\u05d3 \u05dc\u05ea\u05d5\u05e4\u05e2\u05d5\u05ea \u05dc\u05d5\u05d5\u05d0\u05d9 \u05d0\u05e7\u05e1\u05d8\u05e8\u05d4-\u05e4\u05d9\u05e8\u05de\u05d9\u05d3\u05dc\u05d9\u05d5\u05ea \u05e2\u05e7\u05d1 \u05e9\u05e7\u05d9\u05e2\u05ea \u05d4\u05e0\u05d7\u05d5\u05e9\u05ea \u05d1\u05e1\u05d8\u05e8\u05d9\u05d0\u05d8\u05d5\u05dd, \u05d5\u05de\u05ea\u05df \u05e6\u05dc\u05d8\u05d5\u05e8\u05d9\u05dd \u05dc\u05e8\u05d5\u05d1 \u05de\u05d5\u05d1\u05d9\u05dc \u05dc\u05e8\u05d9\u05e1\u05d9\u05d5\u05df \u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d4\u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9\u05d9\u05dd \u05dc\u05dc\u05d0 \u05e6\u05d5\u05e8\u05da \u05d1\u05e0\u05d5\u05d2\u05d3\u05d9 \u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d4 (Syllabus p.56, DSM p.817)."
        },
        {
          "text": "\u05e0\u05d5\u05d2\u05d3\u05d9 \u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d4 \u05d7\u05d5\u05e1\u05de\u05d9\u05dd \u05d0\u05ea \u05e1\u05e4\u05d9\u05d2\u05ea \u05d4-Zinc Acetate \u05d1\u05de\u05e2\u05d9.",
          "isCorrect": false,
          "rationale": "\u05d0\u05d9\u05df \u05d0\u05d9\u05e0\u05d8\u05e8\u05d0\u05e7\u05e6\u05d9\u05d4 \u05d9\u05d3\u05d5\u05e2\u05d4 \u05e9\u05dc \u05d7\u05e1\u05d9\u05de\u05ea \u05e1\u05e4\u05d9\u05d2\u05ea \u05d0\u05d1\u05e5 \u05e2\u05dc \u05d9\u05d3\u05d9 \u05e0\u05d5\u05d2\u05d3\u05d9 \u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d4; \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05d4\u05d5\u05d0 \u05e0\u05d5\u05d9\u05e8\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d5\u05de\u05d8\u05d1\u05d5\u05dc\u05d9 (Syllabus p.56)."
        },
        {
          "text": "\u05d4\u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05d4\u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9\u05d5\u05ea \u05d2\u05d5\u05e8\u05de\u05d5\u05ea \u05dc\u05e9\u05d7\u05e8\u05d5\u05e8 \u05de\u05d4\u05d9\u05e8 \u05e9\u05dc \u05e0\u05d7\u05d5\u05e9\u05ea \u05d7\u05d5\u05e4\u05e9\u05d9\u05ea \u05de\u05d4\u05db\u05d1\u05d3 \u05dc\u05de\u05d5\u05d7.",
          "isCorrect": false,
          "rationale": "\u05e0\u05d5\u05d2\u05d3\u05d9 \u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d4 \u05d0\u05d9\u05e0\u05dd \u05de\u05e9\u05e4\u05d9\u05e2\u05d9\u05dd \u05e2\u05dc \u05e9\u05d7\u05e8\u05d5\u05e8 \u05e0\u05d7\u05d5\u05e9\u05ea; \u05d6\u05d4\u05d5 \u05ea\u05e4\u05e7\u05d9\u05d3\u05dd \u05e9\u05dc \u05d4\u05e6\u05dc\u05d8\u05d5\u05e8\u05d9\u05dd \u05d1\u05ea\u05d7\u05d9\u05dc\u05ea \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc (Syllabus p.56)."
        },
        {
          "text": "\u05e7\u05d9\u05d9\u05dd \u05e1\u05d9\u05db\u05d5\u05df \u05d2\u05d1\u05d5\u05d4 \u05dc-Agranulocytosis \u05d1\u05e9\u05d9\u05dc\u05d5\u05d1 \u05e2\u05dd Penicillamine.",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05e9-Penicillamine \u05d9\u05db\u05d5\u05dc\u05d4 \u05dc\u05d2\u05e8\u05d5\u05dd \u05dc\u05d3\u05d9\u05db\u05d5\u05d9 \u05de\u05d7 \u05e2\u05e6\u05dd, \u05d6\u05d5 \u05d0\u05d9\u05e0\u05d4 \u05d4\u05e1\u05d9\u05d1\u05d4 \u05d4\u05de\u05e8\u05db\u05d6\u05d9\u05ea \u05dc\u05d4\u05d9\u05de\u05e0\u05e2\u05d5\u05ea \u05de\u05e0\u05d5\u05d2\u05d3\u05d9 \u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d4 \u05d1\u05d7\u05d5\u05dc\u05d9 \u05d5\u05d9\u05dc\u05e1\u05d5\u05df (Syllabus p.56)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05e8\u05d2\u05d9\u05e9\u05d5\u05ea \u05e9\u05dc \u05d2\u05e8\u05e2\u05d9\u05e0\u05d9 \u05d4\u05d1\u05e1\u05d9\u05e1 (Basal Ganglia) \u05d4\u05e4\u05d2\u05d5\u05e2\u05d9\u05dd \u05dc\u05d7\u05e1\u05d9\u05de\u05ea \u05d3\u05d5\u05e4\u05de\u05d9\u05df.",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05de\u05d4\u05d5 \u05d4\u05d4\u05d1\u05d3\u05dc \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05d1\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d4\u05e4\u05e8\u05db\u05d5\u05e1\u05d9\u05dd (Seizures) \u05d1\u05d9\u05df \u05de\u05d7\u05dc\u05ea \u05d4\u05e0\u05d8\u05d9\u05e0\u05d2\u05d8\u05d5\u05df \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd (JHD) \u05dc\u05d1\u05d9\u05df \u05d4\u05e6\u05d5\u05e8\u05d4 \u05d4\u05d1\u05d5\u05d2\u05e8\u05ea \u05e9\u05dc \u05d4\u05de\u05d7\u05dc\u05d4?",
      "answerOptions": [
        {
          "text": "\u05d1-JHD \u05e4\u05e8\u05db\u05d5\u05e1\u05d9\u05dd \u05de\u05d5\u05e4\u05d9\u05e2\u05d9\u05dd \u05d1\u05dc\u05de\u05e2\u05dc\u05d4 \u05de\u05e9\u05dc\u05d9\u05e9 \u05de\u05d4\u05d7\u05d5\u05dc\u05d9\u05dd, \u05d1\u05e2\u05d5\u05d3 \u05e9\u05d1\u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd \u05d4\u05dd \u05e0\u05d3\u05d9\u05e8\u05d9\u05dd \u05d1\u05d9\u05d5\u05ea\u05e8.",
          "isCorrect": true,
          "rationale": "\u05e4\u05e8\u05db\u05d5\u05e1\u05d9\u05dd \u05d4\u05dd \u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05e7\u05dc\u05d9\u05e0\u05d9 \u05de\u05d5\u05d1\u05d4\u05e7 \u05d5\u05e9\u05db\u05d9\u05d7 \u05e9\u05dc JHD, \u05de\u05d4 \u05e9\u05de\u05d7\u05d9\u05d9\u05d1 \u05e0\u05d9\u05d8\u05d5\u05e8 EEG \u05d5\u05d8\u05d9\u05e4\u05d5\u05dc \u05e0\u05d5\u05d2\u05d3 \u05d0\u05e4\u05d9\u05dc\u05e4\u05e1\u05d9\u05d4, \u05d1\u05e9\u05d5\u05e0\u05d4 \u05de\u05d4\u05de\u05e6\u05d2 \u05d1\u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd (DSM p.727)."
        },
        {
          "text": "\u05d1\u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd \u05e4\u05e8\u05db\u05d5\u05e1\u05d9\u05dd \u05d4\u05dd \u05d4\u05e1\u05d9\u05de\u05df \u05d4\u05e4\u05e8\u05d5\u05d3\u05e8\u05d5\u05de\u05dc\u05d9 \u05d4\u05e8\u05d0\u05e9\u05d5\u05df, \u05d1\u05e2\u05d5\u05d3 \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d4\u05dd \u05de\u05d5\u05e4\u05d9\u05e2\u05d9\u05dd \u05e8\u05e7 \u05d1\u05e9\u05dc\u05d1 \u05d4\u05e1\u05d5\u05e4\u05e0\u05d9.",
          "isCorrect": false,
          "rationale": "\u05d4\u05d4\u05e4\u05da \u05d4\u05d5\u05d0 \u05d4\u05e0\u05db\u05d5\u05df; \u05d1\u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd \u05e4\u05e8\u05db\u05d5\u05e1\u05d9\u05dd \u05db\u05de\u05e2\u05d8 \u05d5\u05dc\u05d0 \u05de\u05d5\u05e4\u05d9\u05e2\u05d9\u05dd, \u05d5\u05d0\u05d9\u05dc\u05d5 \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d4\u05dd \u05d7\u05dc\u05e7 \u05de\u05d4\u05de\u05e6\u05d2 \u05d4\u05de\u05d5\u05e7\u05d3\u05dd \u05d0\u05d5 \u05d4\u05d1\u05d9\u05e0\u05d5\u05e0\u05d9 (DSM p.727)."
        },
        {
          "text": "\u05d0\u05d9\u05df \u05d4\u05d1\u05d3\u05dc \u05d1\u05e9\u05db\u05d9\u05d7\u05d5\u05ea; \u05d1\u05e9\u05e0\u05d9 \u05d4\u05de\u05e7\u05e8\u05d9\u05dd \u05db-5% \u05de\u05d4\u05d7\u05d5\u05dc\u05d9\u05dd \u05d9\u05e4\u05ea\u05d7\u05d5 \u05d0\u05e4\u05d9\u05dc\u05e4\u05e1\u05d9\u05d4.",
          "isCorrect": false,
          "rationale": "\u05e7\u05d9\u05d9\u05dd \u05d4\u05d1\u05d3\u05dc \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9; \u05d4\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d2\u05d1\u05d5\u05d4\u05d4 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea (\u05de\u05e2\u05dc 33%) (DSM p.727)."
        },
        {
          "text": "\u05e4\u05e8\u05db\u05d5\u05e1\u05d9\u05dd \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05de\u05d5\u05e4\u05d9\u05e2\u05d9\u05dd \u05e8\u05e7 \u05d1\u05de\u05e7\u05e8\u05d9\u05dd \u05e9\u05dc \u05d4\u05d5\u05e8\u05e9\u05d4 \u05d0\u05d9\u05de\u05d4\u05d9\u05ea (Maternal inheritance).",
          "isCorrect": false,
          "rationale": "\u05e8\u05d5\u05d1 \u05de\u05e7\u05e8\u05d9 \u05d4-JHD \u05d4\u05dd \u05d1\u05d4\u05d5\u05e8\u05e9\u05d4 \u05d0\u05d1\u05d4\u05d9\u05ea \u05e2\u05e7\u05d1 \u05d4\u05ea\u05e8\u05d7\u05d1\u05d5\u05ea \u05d4\u05d7\u05d6\u05e8\u05d5\u05ea, \u05d5\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d4\u05e4\u05e8\u05db\u05d5\u05e1\u05d9\u05dd \u05e7\u05e9\u05d5\u05e8\u05d4 \u05dc\u05d2\u05d9\u05dc \u05d4\u05e4\u05e8\u05d5\u05e5 \u05d4\u05e6\u05e2\u05d9\u05e8 \u05d5\u05dc\u05d0 \u05dc\u05de\u05e7\u05d5\u05e8 \u05d4\u05d4\u05d5\u05e8\u05e9\u05d4 \u05d1\u05dc\u05d1\u05d3 (DSM p.727-728)."
        }
