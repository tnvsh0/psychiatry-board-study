    {
      "type": "multiple_choice",
      "question": "\u05de\u05d4\u05d5 \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9 \u05d4\u05e2\u05d9\u05e7\u05e8\u05d9 \u05d4\u05de\u05d0\u05e4\u05e9\u05e8 \u05dc\u05d4\u05d1\u05d3\u05d9\u05dc \u05d1\u05d9\u05df \u05d4\u05e8\u05e2\u05dc\u05ea Benzodiazepines \u05dc\u05d1\u05d9\u05df \u05d4\u05e8\u05e2\u05dc\u05ea Alcohol \u05d1\u05de\u05e7\u05e8\u05d4 \u05e9\u05dc \u05d7\u05d5\u05e1\u05e8 \u05d4\u05db\u05e8\u05d4 \u05d0\u05d5 \u05d1\u05dc\u05d1\u05d5\u05dc?",
      "answerOptions": [
        {
          "text": "\u05e8\u05d9\u05d7 \u05e9\u05dc \u05d0\u05dc\u05db\u05d5\u05d4\u05d5\u05dc \u05de\u05d4\u05d1\u05dc \u05e4\u05d4.",
          "isCorrect": true,
          "rationale": "\u05dc\u05e4\u05d9 \u05d4-DSM-5-TR, \u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9\u05d9\u05dd \u05e9\u05dc \u05e9\u05ea\u05d9 \u05d4\u05d4\u05e8\u05e2\u05dc\u05d5\u05ea \u05d9\u05db\u05d5\u05dc\u05d9\u05dd \u05dc\u05d4\u05d9\u05d5\u05ea \u05d6\u05d4\u05d9\u05dd \u05db\u05de\u05e2\u05d8 \u05dc\u05d7\u05dc\u05d5\u05d8\u05d9\u05df, \u05d5\u05d4\u05d4\u05d1\u05d3\u05dc \u05d4\u05e2\u05d9\u05e7\u05e8\u05d9 \u05d1\u05d1\u05d3\u05d9\u05e7\u05d4 \u05e4\u05d9\u05d6\u05d9\u05e7\u05dc\u05d9\u05ea \u05d4\u05d5\u05d0 \u05d4\u05e8\u05d9\u05d7 (DSM p. 627, 628)."
        },
        {
          "text": "\u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05e9\u05dc Nystagmus (\u05e8\u05d9\u05e6\u05d5\u05d3 \u05e2\u05d9\u05e0\u05d9\u05d9\u05dd) \u05d4\u05de\u05d5\u05e4\u05d9\u05e2 \u05e8\u05e7 \u05d1-BZDs.",
          "isCorrect": false,
          "rationale": "\u05e0\u05d9\u05e1\u05d8\u05d2\u05de\u05d5\u05e1 \u05d9\u05db\u05d5\u05dc \u05dc\u05d4\u05d5\u05e4\u05d9\u05e2 \u05d1\u05e9\u05ea\u05d9 \u05d4\u05d4\u05e8\u05e2\u05dc\u05d5\u05ea, \u05db\u05de\u05d5 \u05d2\u05dd \u05d1\u05d4\u05e8\u05e2\u05dc\u05ea Phencyclidine (DSM p. 595, 627)."
        },
        {
          "text": "\u05de\u05d9\u05d3\u05ea \u05d4\u05d3\u05d9\u05db\u05d5\u05d9 \u05d4\u05e0\u05e9\u05d9\u05de\u05ea\u05d9, \u05e9\u05d4\u05d9\u05d0 \u05d7\u05de\u05d5\u05e8\u05d4 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05d1-BZDs \u05db\u05d7\u05d5\u05de\u05e8 \u05d1\u05d5\u05d3\u05d3.",
          "isCorrect": false,
          "rationale": "BZDs \u05db\u05d7\u05d5\u05de\u05e8 \u05d1\u05d5\u05d3\u05d3 \u05d2\u05d5\u05e8\u05de\u05d9\u05dd \u05dc\u05d3\u05d9\u05db\u05d5\u05d9 \u05e0\u05e9\u05d9\u05de\u05ea\u05d9 \u05e7\u05dc \u05d9\u05d7\u05e1\u05d9\u05ea; \u05e9\u05d9\u05dc\u05d5\u05d1 \u05e9\u05dc BZDs \u05e2\u05dd \u05d0\u05dc\u05db\u05d5\u05d4\u05d5\u05dc \u05d4\u05d5\u05d0 \u05d4\u05de\u05e1\u05d5\u05db\u05df \u05d1\u05d9\u05d5\u05ea\u05e8 (DSM p. 628)."
        },
        {
          "text": "\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05d6\u05d9\u05db\u05e8\u05d5\u05df (Anterograde Amnesia) \u05d4\u05de\u05d5\u05e4\u05d9\u05e2\u05d5\u05ea \u05e8\u05e7 \u05d1\u05d0\u05dc\u05db\u05d5\u05d4\u05d5\u05dc.",
          "isCorrect": false,
          "rationale": "\u05d0\u05de\u05e0\u05d6\u05d9\u05d4 \u05d0\u05e0\u05d8\u05e8\u05d5\u05d2\u05e8\u05d3\u05d9\u05ea (Blackouts) \u05d4\u05d9\u05d0 \u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05d1\u05d5\u05dc\u05d8 \u05e9\u05dc \u05d4\u05e8\u05e2\u05dc\u05ea \u05e1\u05d3\u05d0\u05d8\u05d9\u05d1\u05d9\u05d9\u05dd, \u05d1\u05d3\u05d5\u05de\u05d4 \u05dc\u05d0\u05dc\u05db\u05d5\u05d4\u05d5\u05dc (DSM p. 627)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05e1\u05d9\u05de\u05df \u05d4\u05e4\u05e9\u05d5\u05d8 \u05d5\u05d4\u05d9\u05e9\u05d9\u05e8 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05e9\u05e0\u05d9\u05ea\u05df \u05dc\u05d6\u05d4\u05d5\u05ea \u05d1\u05d7\u05d3\u05e8 \u05d4\u05de\u05d9\u05d5\u05df \u05dc\u05dc\u05d0 \u05d1\u05d3\u05d9\u05e7\u05d5\u05ea \u05de\u05e2\u05d1\u05d3\u05d4.",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05de\u05d8\u05d5\u05e4\u05dc \u05d4\u05e1\u05d5\u05d1\u05dc \u05de\u05e9\u05d9\u05de\u05d5\u05e9 \u05db\u05e8\u05d5\u05e0\u05d9 \u05d1-Barbiturates \u05de\u05e4\u05e1\u05d9\u05e7 \u05d0\u05ea \u05d4\u05e9\u05d9\u05de\u05d5\u05e9 \u05d5\u05de\u05e4\u05ea\u05d7 \u05de\u05e6\u05d1 \u05d1\u05dc\u05d1\u05d5\u05dc\u05d9, \u05d4\u05e4\u05e8\u05e2\u05d4 \u05d1\u05e8\u05d9\u05db\u05d5\u05d6, \u05d5\u05d4\u05d6\u05d9\u05d5\u05ea \u05d5\u05d9\u05d6\u05d5\u05d0\u05dc\u05d9\u05d5\u05ea \u05d5\u05ea\u05d7\u05d5\u05e9\u05ea\u05d9\u05d5\u05ea. \u05de\u05d4\u05d9 \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05de\u05d3\u05d5\u05d9\u05e7\u05ea \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR?",
      "answerOptions": [
        {
          "text": "Sedative, Hypnotic, or Anxiolytic Withdrawal Delirium.",
          "isCorrect": true,
          "rationale": "\u05db\u05d0\u05e9\u05e8 \u05de\u05d5\u05e4\u05d9\u05e2\u05d9\u05dd \u05dc\u05d9\u05e7\u05d5\u05d9\u05d9\u05dd \u05d1\u05d4\u05db\u05e8\u05d4 \u05d5\u05d1\u05e7\u05d5\u05d2\u05e0\u05d9\u05e6\u05d9\u05d4 (Delirium) \u05d9\u05d7\u05d3 \u05e2\u05dd \u05d4\u05d6\u05d9\u05d5\u05ea \u05d1\u05de\u05d4\u05dc\u05da \u05d2\u05de\u05d9\u05dc\u05d4 \u05de\u05e1\u05d3\u05d0\u05d8\u05d9\u05d1\u05d9\u05d9\u05dd, \u05d9\u05e9 \u05dc\u05d0\u05d1\u05d7\u05df \u05d6\u05d0\u05ea \u05db-Withdrawal Delirium \u05d5\u05dc\u05d0 \u05db\u05d2\u05de\u05d9\u05dc\u05d4 \u05e4\u05e9\u05d5\u05d8\u05d4 (DSM p. 630, 673)."
        },
        {
          "text": "Substance-Induced Psychotic Disorder, \u05e2\u05dd \u05d4\u05d5\u05e4\u05e2\u05d4 \u05d1\u05de\u05d4\u05dc\u05da \u05d2\u05de\u05d9\u05dc\u05d4.",
          "isCorrect": false,
          "rationale": "\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d6\u05d5 \u05e0\u05d9\u05ea\u05e0\u05ea \u05e8\u05e7 \u05d0\u05dd \u05d4\u05d4\u05d6\u05d9\u05d5\u05ea \u05de\u05d5\u05e4\u05d9\u05e2\u05d5\u05ea \u05dc\u05dc\u05d0 \u05d3\u05dc\u05d9\u05e8\u05d9\u05d5\u05dd (\u05d4\u05db\u05e8\u05d4 \u05e6\u05dc\u05d5\u05dc\u05d4) \u05d0\u05d5 \u05d0\u05dd \u05d4\u05df \u05d7\u05de\u05d5\u05e8\u05d5\u05ea \u05d1\u05de\u05d9\u05d5\u05d7\u05d3 \u05d5\u05de\u05e6\u05d3\u05d9\u05e7\u05d5\u05ea \u05d4\u05ea\u05d9\u05d9\u05d7\u05e1\u05d5\u05ea \u05e0\u05e4\u05e8\u05d3\u05ea, \u05d0\u05da \u05d3\u05dc\u05d9\u05e8\u05d9\u05d5\u05dd \u05d4\u05d5\u05d0 \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05de\u05d5\u05d1\u05d9\u05dc\u05d4 \u05db\u05d0\u05df (DSM p. 630)."
        },
        {
          "text": "Sedative, Hypnotic, or Anxiolytic Withdrawal \u05e2\u05dd Perceptual Disturbances.",
          "isCorrect": false,
          "rationale": "\u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05d9\u05e8 \u05d6\u05d4 \u05e0\u05d9\u05ea\u05df \u05db\u05d0\u05e9\u05e8 \u05d1\u05d5\u05d7\u05df \u05d4\u05de\u05e6\u05d9\u05d0\u05d5\u05ea \u05ea\u05e7\u05d9\u05df (\u05d4\u05d7\u05d5\u05dc\u05d4 \u05d9\u05d5\u05d3\u05e2 \u05e9\u05d4\u05d4\u05d6\u05d9\u05d5\u05ea \u05e0\u05d2\u05e8\u05de\u05d5\u05ea \u05de\u05d4\u05d2\u05de\u05d9\u05dc\u05d4) \u05d5\u05d4\u05d4\u05db\u05e8\u05d4 \u05e6\u05dc\u05d5\u05dc\u05d4, \u05de\u05d4 \u05e9\u05dc\u05d0 \u05de\u05ea\u05d0\u05d9\u05dd \u05dc\u05de\u05e6\u05d1 \u05d1\u05dc\u05d1\u05d5\u05dc\u05d9 (DSM p. 629, 630)."
        },
        {
          "text": "Acute Stress Disorder \u05e2\u05e7\u05d1 \u05d4\u05e4\u05e1\u05e7\u05ea \u05d4\u05e1\u05dd.",
          "isCorrect": false,
          "rationale": "\u05d0\u05d9\u05df \u05e7\u05e9\u05e8 \u05d1\u05d9\u05df \u05d4\u05de\u05e6\u05d1 \u05d4\u05e4\u05d9\u05d6\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05e9\u05dc \u05d2\u05de\u05d9\u05dc\u05d4 \u05dc\u05d1\u05d9\u05df \u05d0\u05d1\u05d7\u05e0\u05ea PTSD \u05d0\u05d5 Acute Stress Disorder \u05d4\u05d3\u05d5\u05e8\u05e9\u05d5\u05ea \u05d0\u05d9\u05e8\u05d5\u05e2 \u05d8\u05e8\u05d0\u05d5\u05de\u05d8\u05d9 (DSM p. 313)."
        }
      ],
      "hint": "\u05e9\u05d9\u05dd \u05dc\u05d1 \u05dc\u05e9\u05d9\u05dc\u05d5\u05d1 \u05d1\u05d9\u05df \u05d4\u05de\u05e6\u05d1 \u05d4\u05d1\u05dc\u05d1\u05d5\u05dc\u05d9 (\u05e7\u05d5\u05d2\u05e0\u05d9\u05e6\u05d9\u05d4 \u05d5\u05d4\u05db\u05e8\u05d4) \u05dc\u05d1\u05d9\u05df \u05d4\u05d4\u05d6\u05d9\u05d5\u05ea.",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05de\u05ea\u05d1\u05d2\u05e8 \u05e2\u05dd \u05e8\u05e7\u05e2 \u05e9\u05dc \u05d4\u05e4\u05e8\u05e2\u05ea \u05d7\u05e8\u05d3\u05d4 \u05de\u05d5\u05db\u05dc\u05dc\u05ea (GAD) \u05de\u05e6\u05d9\u05d2 \u05d4\u05d7\u05de\u05e8\u05d4 \u05d1\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d5\u05de\u05d1\u05e7\u05e9 '\u05db\u05d3\u05d5\u05e8 \u05dc\u05d4\u05e8\u05d2\u05e2\u05d4'. \u05d1\u05d1\u05d5\u05d0\u05da \u05dc\u05e9\u05e7\u05d5\u05dc \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Benzodiazepines, \u05d0\u05d9\u05d6\u05d4 \u05d2\u05d5\u05e8\u05dd \u05d1\u05de\u05e7\u05d5\u05e8\u05d5\u05ea \u05d4\u05dc\u05d9\u05de\u05d5\u05d3 \u05e6\u05e8\u05d9\u05da \u05dc\u05d4\u05d8\u05d5\u05ea \u05d0\u05ea \u05d4\u05db\u05e3 \u05dc\u05d8\u05d5\u05d1\u05ea \u05d7\u05dc\u05d5\u05e4\u05d5\u05ea \u05db\u05de\u05d5 SSRI \u05d0\u05d5 \u05d8\u05d9\u05e4\u05d5\u05dc \u05e4\u05e1\u05d9\u05db\u05d5\u05ea\u05e8\u05e4\u05d9?",
      "answerOptions": [
        {
          "text": "\u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05d4\u05d2\u05d1\u05d5\u05d4 \u05dc-Diversion (\u05d4\u05e2\u05d1\u05e8\u05ea \u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 \u05dc\u05d0\u05d7\u05e8\u05d9\u05dd) \u05d5\u05e4\u05d5\u05d8\u05e0\u05e6\u05d9\u05d0\u05dc \u05d4\u05e9\u05d9\u05de\u05d5\u05e9 \u05dc\u05e8\u05e2\u05d4 \u05d1\u05d2\u05d9\u05dc \u05d4\u05d4\u05ea\u05d1\u05d2\u05e8\u05d5\u05ea.",
          "isCorrect": true,
          "rationale": "\u05dc\u05e4\u05d9 \u05d4-Dulcan, \u05d1\u05e0\u05d6\u05d5\u05d3\u05d9\u05d0\u05d6\u05e4\u05d9\u05e0\u05d9\u05dd \u05d4\u05dd \u05d1\u05e2\u05dc\u05d9 \u05e4\u05d5\u05d8\u05e0\u05e6\u05d9\u05d0\u05dc \u05e9\u05d9\u05de\u05d5\u05e9 \u05dc\u05e8\u05e2\u05d4 \u05d2\u05d1\u05d5\u05d4, \u05d5\u05d9\u05e9 \u05dc\u05d4\u05e2\u05d3\u05d9\u05e3 SSRI/SNRI \u05d0\u05d5 CBT \u05db\u05e7\u05d5 \u05e8\u05d0\u05e9\u05d5\u05df \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d5\u05e0\u05d5\u05e2\u05e8 \u05e2\u05dd \u05d7\u05e8\u05d3\u05d4 (Dulcan p. 280, 480)."
        },
        {
          "text": "\u05d4\u05e2\u05d5\u05d1\u05d3\u05d4 \u05e9-BZDs \u05d0\u05d9\u05e0\u05dd \u05d9\u05e2\u05d9\u05dc\u05d9\u05dd \u05db\u05dc\u05dc \u05d1\u05d4\u05e4\u05d7\u05ea\u05ea \u05d7\u05e8\u05d3\u05d4 \u05d0\u05e6\u05dc \u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd.",
          "isCorrect": false,
          "rationale": "BZDs \u05d9\u05e2\u05d9\u05dc\u05d9\u05dd \u05dc\u05d4\u05e7\u05dc\u05d4 \u05de\u05d4\u05d9\u05e8\u05d4 \u05e2\u05dc \u05d7\u05e8\u05d3\u05d4, \u05d0\u05da \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05d8\u05d5\u05d5\u05d7 \u05d0\u05e8\u05d5\u05da (\u05ea\u05dc\u05d5\u05ea, \u05d4\u05ea\u05de\u05db\u05e8\u05d5\u05ea) \u05d4\u05d5\u05e4\u05da \u05d0\u05d5\u05ea\u05dd \u05dc\u05e7\u05d5 \u05d8\u05d9\u05e4\u05d5\u05dc \u05dc\u05d0 \u05de\u05d5\u05e2\u05d3\u05e3 (Dulcan p. 280, StahlNeuro p. 377)."
        },
        {
          "text": "\u05d7\u05d5\u05e1\u05e8 \u05d0\u05d9\u05e9\u05d5\u05e8 \u05d4-FDA \u05dc\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1-BZDs \u05d1\u05db\u05dc \u05d2\u05d9\u05dc \u05de\u05ea\u05d7\u05ea \u05dc-18.",
          "isCorrect": false,
          "rationale": "\u05e7\u05d9\u05d9\u05de\u05d9\u05dd \u05d0\u05d9\u05e9\u05d5\u05e8\u05d9 FDA \u05dc-BZDs \u05de\u05e1\u05d5\u05d9\u05de\u05d9\u05dd \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd (\u05dc\u05de\u05e9\u05dc \u05dc\u05e4\u05e8\u05db\u05d5\u05e1\u05d9\u05dd), \u05d5\u05d4\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05d7\u05e8\u05d3\u05d4 \u05e7\u05d9\u05d9\u05dd 'Off-label' \u05d0\u05da \u05d3\u05d5\u05e8\u05e9 \u05d6\u05d4\u05d9\u05e8\u05d5\u05ea (StahlKids p. 28)."
