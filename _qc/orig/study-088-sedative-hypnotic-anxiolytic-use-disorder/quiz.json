{
  "title": "Sedative Quiz",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\u05de\u05ea\u05d1\u05d2\u05e8 \u05d1\u05df 16 \u05de\u05d8\u05d5\u05e4\u05dc \u05d1-Lorazepam \u05d1\u05de\u05d9\u05e0\u05d5\u05df \u05e7\u05d1\u05d5\u05e2 \u05dc\u05de\u05e9\u05da \u05d7\u05e6\u05d9 \u05e9\u05e0\u05d4 \u05d1\u05e9\u05dc \u05d4\u05e4\u05e8\u05e2\u05ea \u05e4\u05d0\u05e0\u05d9\u05e7\u05d4, \u05ea\u05d7\u05ea \u05e4\u05d9\u05e7\u05d5\u05d7 \u05e8\u05e4\u05d5\u05d0\u05d9 \u05d4\u05d3\u05d5\u05e7. \u05dc\u05d0\u05d7\u05e8 \u05e9\u05d4\u05e4\u05e1\u05d9\u05e7 \u05d0\u05ea \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05e4\u05ea\u05d0\u05d5\u05de\u05d9\u05d5\u05ea, \u05d4\u05d5\u05d0 \u05e4\u05d9\u05ea\u05d7 \u05e8\u05e2\u05d3 \u05d1\u05d9\u05d3\u05d9\u05d9\u05dd, \u05d4\u05d6\u05e2\u05d4 \u05d5-Insomnia. \u05d4\u05d5\u05d0 \u05d0\u05d9\u05e0\u05d5 \u05de\u05e6\u05d9\u05d2 \u05d3\u05e4\u05d5\u05e1\u05d9 \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05e9\u05dc \u05d7\u05d9\u05e4\u05d5\u05e9 \u05e1\u05de\u05d9\u05dd \u05d0\u05d5 \u05e4\u05d2\u05d9\u05e2\u05d4 \u05d1\u05ea\u05e4\u05e7\u05d5\u05d3 \u05d4\u05d7\u05d1\u05e8\u05ea\u05d9. \u05de\u05d4\u05d9 \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05e0\u05db\u05d5\u05e0\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR?",
      "answerOptions": [
        {
          "text": "Sedative, Hypnotic, or Anxiolytic Withdrawal \u05d1\u05dc\u05d1\u05d3.",
          "isCorrect": true,
          "rationale": "\u05dc\u05e4\u05d9 \u05d4-DSM-5-TR, \u05ea\u05e1\u05de\u05d9\u05e0\u05d9 \u05e1\u05d1\u05d9\u05dc\u05d5\u05ea (Tolerance) \u05d5\u05d2\u05de\u05d9\u05dc\u05d4 (Withdrawal) \u05d4\u05de\u05ea\u05e8\u05d7\u05e9\u05d9\u05dd \u05d1\u05de\u05d4\u05dc\u05da \u05d8\u05d9\u05e4\u05d5\u05dc \u05e8\u05e4\u05d5\u05d0\u05d9 \u05ea\u05e7\u05d9\u05df \u05d1\u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05de\u05e8\u05e9\u05dd \u05d0\u05d9\u05e0\u05dd \u05e0\u05e1\u05e4\u05e8\u05d9\u05dd \u05dc\u05e6\u05d5\u05e8\u05da \u05d0\u05d1\u05d7\u05e0\u05ea Use Disorder, \u05d0\u05dc\u05d0 \u05d0\u05dd \u05e7\u05d9\u05d9\u05de\u05d9\u05dd \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e0\u05d5\u05e1\u05e4\u05d9\u05dd \u05e9\u05dc \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05db\u05e4\u05d9\u05d9\u05ea\u05d9\u05ea \u05dc\u05d7\u05d9\u05e4\u05d5\u05e9 \u05e1\u05dd (DSM p. 621)."
        },
        {
          "text": "Mild Sedative, Hypnotic, or Anxiolytic Use Disorder.",
          "isCorrect": false,
          "rationale": "\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d6\u05d5 \u05e9\u05d2\u05d5\u05d9\u05d4 \u05db\u05d9\u05d5\u05d5\u05df \u05e9\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05e9\u05dc \u05e1\u05d1\u05d9\u05dc\u05d5\u05ea \u05d5\u05d2\u05de\u05d9\u05dc\u05d4 \u05ea\u05d7\u05ea \u05d4\u05e9\u05d2\u05d7\u05d4 \u05e8\u05e4\u05d5\u05d0\u05d9\u05ea \u05de\u05d5\u05d7\u05e8\u05d2\u05d9\u05dd \u05de\u05d4\u05e1\u05e4\u05d9\u05e8\u05d4 \u05dc\u05d0\u05d1\u05d7\u05e0\u05ea Use Disorder \u05d1\u05de\u05d9\u05d3\u05d4 \u05d5\u05d0\u05d9\u05df \u05e1\u05d9\u05de\u05e0\u05d9\u05dd \u05e0\u05d5\u05e1\u05e4\u05d9\u05dd \u05e9\u05dc \u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05e2\u05d9\u05d9\u05ea\u05d9 (DSM p. 621)."
        },
        {
          "text": "Sedative-Induced Anxiety Disorder.",
          "isCorrect": false,
          "rationale": "\u05d4\u05e4\u05e8\u05e2\u05d4 \u05d6\u05d5 \u05de\u05d0\u05d5\u05d1\u05d7\u05e0\u05ea \u05db\u05d0\u05e9\u05e8 \u05ea\u05e1\u05de\u05d9\u05e0\u05d9 \u05d4\u05d7\u05e8\u05d3\u05d4 \u05d4\u05dd \u05d4\u05d3\u05d5\u05de\u05d9\u05e0\u05e0\u05d8\u05d9\u05d9\u05dd \u05d1\u05ea\u05de\u05d5\u05e0\u05d4 \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05d5\u05d7\u05d5\u05e8\u05d2\u05d9\u05dd \u05de\u05e2\u05d1\u05e8 \u05dc\u05de\u05d4 \u05e9\u05e6\u05e4\u05d5\u05d9 \u05d1\u05e1\u05d9\u05e0\u05d3\u05e8\u05d5\u05dd \u05d2\u05de\u05d9\u05dc\u05d4 \u05e8\u05d2\u05d9\u05dc, \u05de\u05d4 \u05e9\u05dc\u05d0 \u05ea\u05d5\u05d0\u05e8 \u05d1\u05de\u05e7\u05e8\u05d4 \u05d6\u05d4 (DSM p. 631)."
        },
        {
          "text": "Physical Dependence \u05d1\u05dc\u05d1\u05d3, \u05dc\u05dc\u05d0 \u05e7\u05d5\u05d3 \u05d0\u05d1\u05d7\u05e0\u05ea\u05d9 \u05d1-DSM.",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05e9\u05de\u05d3\u05d5\u05d1\u05e8 \u05d1\u05ea\u05dc\u05d5\u05ea \u05e4\u05d9\u05d6\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea \u05e6\u05e4\u05d5\u05d9\u05d4, \u05d4-DSM \u05db\u05d5\u05dc\u05dc \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05d5\u05e7\u05d5\u05d3 \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9 \u05dc\u05e1\u05d9\u05e0\u05d3\u05e8\u05d5\u05dd \u05d4\u05d2\u05de\u05d9\u05dc\u05d4 \u05e2\u05e6\u05de\u05d5 (Withdrawal) \u05d2\u05dd \u05dc\u05dc\u05d0 \u05e7\u05d9\u05d5\u05dd Use Disorder (DSM p. 629)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05dc\u05d6\u05db\u05d5\u05e8 \u05d0\u05ea \u05d4\u05d4\u05d7\u05e8\u05d2\u05d4 \u05d4\u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05ea \u05d1-DSM \u05d1\u05e0\u05d5\u05d2\u05e2 \u05dc\u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd \u05d4\u05e0\u05d5\u05d8\u05dc\u05d9\u05dd \u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05de\u05e8\u05e9\u05dd \u05ea\u05d7\u05ea \u05e4\u05d9\u05e7\u05d5\u05d7 \u05e8\u05e4\u05d5\u05d0\u05d9.",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05d1\u05de\u05d4\u05dc\u05da \u05e0\u05d9\u05d4\u05d5\u05dc \u05de\u05e7\u05e8\u05d4 \u05e9\u05dc \u05d2\u05de\u05d9\u05dc\u05d4 \u05de-Alcohol, \u05de\u05d4\u05d5 \u05d4\u05d1\u05e1\u05d9\u05e1 \u05d4\u05e4\u05e8\u05de\u05e7\u05d5\u05dc\u05d5\u05d2\u05d9 \u05dc\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1-Benzodiazepines \u05d0\u05e8\u05d5\u05db\u05d9 \u05d8\u05d5\u05d5\u05d7 \u05db\u05e7\u05d5 \u05e8\u05d0\u05e9\u05d5\u05df \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc?",
      "answerOptions": [
        {
          "text": "\u05e7\u05d9\u05d5\u05dd \u05e1\u05d1\u05d9\u05dc\u05d5\u05ea \u05de\u05e6\u05dc\u05d9\u05d1\u05d4 (Cross-Tolerance) \u05e2\u05e7\u05d1 \u05d4\u05e9\u05e4\u05e2\u05d4 \u05d7\u05d5\u05e4\u05e4\u05ea \u05e2\u05dc \u05de\u05e2\u05e8\u05db\u05d5\u05ea \u05d4-GABA \u05d5\u05d4\u05d2\u05dc\u05d5\u05d8\u05de\u05d8.",
          "isCorrect": true,
          "rationale": "\u05e7\u05d9\u05d9\u05de\u05ea \u05e1\u05d1\u05d9\u05dc\u05d5\u05ea \u05de\u05e6\u05dc\u05d9\u05d1\u05d4 \u05de\u05dc\u05d0\u05d4 \u05d0\u05d5 \u05d7\u05dc\u05e7\u05d9\u05ea \u05d1\u05d9\u05df BZDs \u05dc\u05d0\u05dc\u05db\u05d5\u05d4\u05d5\u05dc \u05d1\u05e9\u05dc \u05d4\u05d2\u05d1\u05e8\u05ea \u05d4\u05e2\u05d9\u05db\u05d5\u05d1 \u05d4-GABAergic \u05d5\u05d3\u05d9\u05db\u05d5\u05d9 \u05d4\u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05d2\u05dc\u05d5\u05d8\u05de\u05d8\u05e8\u05d2\u05d9\u05ea, \u05de\u05d4 \u05e9\u05de\u05d0\u05e4\u05e9\u05e8 \u05dc-BZDs \u05dc\u05d4\u05d7\u05dc\u05d9\u05e3 \u05d0\u05ea \u05d4\u05d0\u05dc\u05db\u05d5\u05d4\u05d5\u05dc \u05d5\u05dc\u05de\u05e0\u05d5\u05e2 \u05e1\u05d9\u05de\u05e0\u05d9 \u05d2\u05de\u05d9\u05dc\u05d4 (\u05de\u05e7\u05d5\u05e8: \u05d7\u05dc\u05e7 1 dsm_criteria, StahlNeuro p. 553)."
        },
        {
          "text": "\u05d7\u05e1\u05d9\u05de\u05d4 \u05e1\u05dc\u05e7\u05d8\u05d9\u05d1\u05d9\u05ea \u05e9\u05dc \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 NMDA \u05d4\u05de\u05d5\u05e0\u05e2\u05ea Excitotoxicity \u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05d2\u05de\u05d9\u05dc\u05d4.",
          "isCorrect": false,
          "rationale": "\u05d1\u05e2\u05d5\u05d3 \u05e9\u05d0\u05dc\u05db\u05d5\u05d4\u05d5\u05dc \u05de\u05e9\u05e4\u05d9\u05e2 \u05e2\u05dc NMDA, \u05d4-Benzodiazepines \u05e4\u05d5\u05e2\u05dc\u05d9\u05dd \u05db-PAMs \u05e2\u05dc \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 $GABA_A$ \u05d5\u05d0\u05d9\u05e0\u05dd \u05d7\u05d5\u05e1\u05de\u05d9\u05dd \u05d9\u05e9\u05d9\u05e8\u05d5\u05ea \u05d0\u05ea \u05e7\u05d5\u05dc\u05d8\u05df \u05d4-NMDA (StahlNeuro p. 553, 555)."
        },
        {
          "text": "\u05d9\u05db\u05d5\u05dc\u05ea\u05dd \u05dc\u05d4\u05e4\u05d7\u05d9\u05ea \u05d0\u05ea \u05e9\u05d7\u05e8\u05d5\u05e8 \u05d4-Dopamine \u05d1\u05de\u05e1\u05dc\u05d5\u05dc \u05d4\u05de\u05d6\u05d5\u05dc\u05d9\u05de\u05d1\u05d9.",
          "isCorrect": false,
          "rationale": "\u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05d2\u05de\u05d9\u05dc\u05d4 \u05e0\u05d5\u05e2\u05d3 \u05dc\u05de\u05e0\u05d5\u05e2 \u05d0\u05ea \u05d4-Hyperexcitability \u05e9\u05dc \u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05e2\u05e6\u05d1\u05d9\u05dd \u05d4\u05de\u05e8\u05db\u05d6\u05d9\u05ea \u05d5\u05dc\u05d0 \u05de\u05ea\u05de\u05e7\u05d3 \u05d1\u05d4\u05e4\u05d7\u05ea\u05ea \u05d3\u05d5\u05e4\u05de\u05d9\u05df \u05d0\u05e7\u05d5\u05d8\u05d9 (StahlNeuro p. 555)."
        },
        {
          "text": "\u05d4\u05e9\u05e4\u05e2\u05d4 \u05d0\u05d2\u05d5\u05e0\u05d9\u05e1\u05d8\u05d9\u05ea \u05d9\u05e9\u05d9\u05e8\u05d4 \u05e2\u05dc \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 $GABA_B$.",
          "isCorrect": false,
          "rationale": "Benzodiazepines \u05e4\u05d5\u05e2\u05dc\u05d9\u05dd \u05e2\u05dc \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 $GABA_A$ (\u05de\u05e0\u05d2\u05e0\u05d5\u05df Ionotropic) \u05d5\u05dc\u05d0 \u05e2\u05dc $GABA_B$ (\u05de\u05e0\u05d2\u05e0\u05d5\u05df Metabotropic), \u05d1\u05e0\u05d9\u05d2\u05d5\u05d3 \u05dc\u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05db\u05de\u05d5 Baclofen \u05d0\u05d5 Sodium Oxybate (StahlNeuro p. 257, 445)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05de\u05d5\u05e9\u05d2 \u05d4\u05de\u05ea\u05d0\u05e8 \u05de\u05e6\u05d1 \u05d1\u05d5 \u05d7\u05d5\u05de\u05e8 \u05d0\u05d7\u05d3 \u05d9\u05db\u05d5\u05dc \u05dc\u05d4\u05d7\u05dc\u05d9\u05e3 \u05d7\u05d5\u05de\u05e8 \u05d0\u05d7\u05e8 \u05d1\u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05e2\u05e6\u05d1\u05d9\u05dd \u05d4\u05de\u05e8\u05db\u05d6\u05d9\u05ea \u05d1\u05e9\u05dc \u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d3\u05d5\u05de\u05d4.",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05d0\u05d9\u05d6\u05d4 \u05de\u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9\u05dd \u05d4\u05d1\u05d0\u05d9\u05dd \u05de\u05d1\u05d3\u05d9\u05dc \u05d1\u05d9\u05df \u05d4-Z-drugs (\u05db\u05d2\u05d5\u05df Zolpidem) \u05dc\u05d1\u05d9\u05df Benzodiazepines \u05e7\u05dc\u05d0\u05e1\u05d9\u05d9\u05dd \u05de\u05d1\u05d7\u05d9\u05e0\u05ea \u05d4\u05e7\u05d9\u05e9\u05d5\u05e8 \u05dc\u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 \u05d4-GABA?",
      "answerOptions": [
        {
          "text": "\u05d4-Z-drugs \u05e0\u05e7\u05e9\u05e8\u05d9\u05dd \u05d1\u05d0\u05d5\u05e4\u05df \u05e1\u05dc\u05e7\u05d8\u05d9\u05d1\u05d9 \u05dc\u05ea\u05ea-\u05d9\u05d7\u05d9\u05d3\u05d5\u05ea \u05de\u05e1\u05d5\u05d2 $\\alpha_1$.",
          "isCorrect": true,
          "rationale": "Zolpidem \u05d5-Zaleplon \u05d4\u05dd \u05e1\u05dc\u05e7\u05d8\u05d9\u05d1\u05d9\u05d9\u05dd \u05dc\u05ea\u05ea-\u05d9\u05d7\u05d9\u05d3\u05d5\u05ea $\\alpha_1$, \u05d4\u05d0\u05d7\u05e8\u05d0\u05d9\u05d5\u05ea \u05d1\u05e2\u05d9\u05e7\u05e8 \u05e2\u05dc \u05e1\u05d3\u05e6\u05d9\u05d4, \u05d1\u05e2\u05d5\u05d3 \u05e9-BZDs \u05d0\u05d9\u05e0\u05dd \u05e1\u05dc\u05e7\u05d8\u05d9\u05d1\u05d9\u05d9\u05dd \u05d5\u05e0\u05e7\u05e9\u05e8\u05d9\u05dd \u05d2\u05dd \u05dc-$\\alpha_2$, $\\alpha_3$ \u05d5-$\\alpha_5$ (StahlNeuro p. 423)."
        },
        {
          "text": "\u05d4-Z-drugs \u05e4\u05d5\u05e2\u05dc\u05d9\u05dd \u05db-Antagonists \u05d1\u05d0\u05ea\u05e8 \u05d4\u05e7\u05d9\u05e9\u05d5\u05e8 \u05d4\u05d1\u05e0\u05d6\u05d5\u05d3\u05d9\u05d0\u05d6\u05e4\u05d9\u05e0\u05d9.",
          "isCorrect": false,
          "rationale": "\u05d4-Z-drugs \u05d4\u05dd \u05d0\u05d2\u05d5\u05e0\u05d9\u05e1\u05d8\u05d9\u05dd (PAMs) \u05d1\u05d0\u05ea\u05e8 \u05d4\u05e7\u05d9\u05e9\u05d5\u05e8, \u05d1\u05d3\u05d9\u05d5\u05e7 \u05db\u05de\u05d5 \u05d1\u05e0\u05d6\u05d5\u05d3\u05d9\u05d0\u05d6\u05e4\u05d9\u05e0\u05d9\u05dd, \u05d5\u05dc\u05d0 \u05d0\u05e0\u05d8\u05d2\u05d5\u05e0\u05d9\u05e1\u05d8\u05d9\u05dd \u05db\u05de\u05d5 Flumazenil (StahlNeuro p. 262, 423)."
        },
        {
