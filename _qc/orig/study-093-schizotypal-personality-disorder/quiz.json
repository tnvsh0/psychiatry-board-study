{
  "title": "Schizotypal Quiz",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\u05de\u05ea\u05d1\u05d2\u05e8 \u05d1\u05df 16 \u05de\u05d5\u05e4\u05e0\u05d4 \u05dc\u05d4\u05e2\u05e8\u05db\u05d4 \u05d1\u05e9\u05dc \u05e0\u05e1\u05d9\u05d2\u05d4 \u05d7\u05d1\u05e8\u05ea\u05d9\u05ea \u05d5\u05e7\u05e9\u05d9\u05d9\u05dd \u05d0\u05e7\u05d3\u05de\u05d9\u05d9\u05dd. \u05d1\u05d1\u05d3\u05d9\u05e7\u05d4 \u05d4\u05d5\u05d0 \u05de\u05ea\u05d0\u05e8 \u05d0\u05de\u05d5\u05e0\u05d4 \u05db\u05d9 \u05d4\u05d5\u05d0 \u05de\u05e1\u05d5\u05d2\u05dc '\u05dc\u05d7\u05d5\u05e9 \u05d0\u05e0\u05e8\u05d2\u05d9\u05d5\u05ea' \u05de\u05d0\u05e0\u05e9\u05d9\u05dd \u05d0\u05d7\u05e8\u05d9\u05dd \u05dc\u05e4\u05e0\u05d9 \u05e9\u05d4\u05dd \u05de\u05d3\u05d1\u05e8\u05d9\u05dd, \u05d5\u05d3\u05d9\u05d1\u05d5\u05e8\u05d5 \u05e0\u05e9\u05de\u05e2 \u05de\u05e2\u05d5\u05e8\u05e4\u05dc \u05d5\u05de\u05dc\u05d0 \u05d1\u05de\u05d8\u05d0\u05e4\u05d5\u05e8\u05d5\u05ea \u05dc\u05d0 \u05e9\u05d2\u05e8\u05ea\u05d9\u05d5\u05ea. \u05d4\u05d5\u05d0 \u05de\u05d3\u05d5\u05d5\u05d7 \u05e2\u05dc \u05d7\u05e8\u05d3\u05d4 \u05d7\u05d1\u05e8\u05ea\u05d9\u05ea \u05e2\u05d6\u05d4 \u05d4\u05e0\u05d5\u05d1\u05e2\u05ea \u05de\u05d7\u05e9\u05e9 \u05e9\u05d0\u05d7\u05e8\u05d9\u05dd \u05d9\u05e0\u05e1\u05d5 '\u05dc\u05d2\u05e0\u05d5\u05d1 \u05d0\u05ea \u05d4\u05de\u05d6\u05dc \u05e9\u05dc\u05d5'. \u05dc\u05de\u05e8\u05d5\u05ea \u05d4\u05de\u05d5\u05d6\u05e8\u05d5\u05ea, \u05d0\u05d9\u05df \u05e2\u05d3\u05d5\u05ea \u05dc\u05d4\u05d6\u05d9\u05d5\u05ea \u05d0\u05d5 \u05d3\u05dc\u05d5\u05d6\u05d9\u05d5\u05ea \u05de\u05d5\u05d1\u05e0\u05d5\u05ea. \u05de\u05d4\u05d9 \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05e1\u05d1\u05d9\u05e8\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8?",
      "answerOptions": [
        {
          "text": "Schizotypal Personality Disorder",
          "isCorrect": true,
          "rationale": "\u05d4\u05ea\u05d9\u05d0\u05d5\u05e8 \u05db\u05d5\u05dc\u05dc \u05d0\u05de\u05d5\u05e0\u05d5\u05ea \u05de\u05d0\u05d2\u05d9\u05d5\u05ea, \u05d7\u05e9\u05d9\u05d1\u05d4 \u05de\u05e2\u05d5\u05e8\u05e4\u05dc\u05ea, \u05d5\u05d7\u05e8\u05d3\u05d4 \u05d7\u05d1\u05e8\u05ea\u05d9\u05ea \u05d1\u05e2\u05dc\u05ea \u05d2\u05d5\u05d5\u05df \u05e4\u05e8\u05e0\u05d5\u05d0\u05d9\u05d3\u05d9, \u05d4\u05ea\u05d5\u05d0\u05de\u05d9\u05dd \u05d0\u05ea \u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05e9\u05dc DSM-5-TR \u05dc-STPD \u05dc\u05dc\u05d0 \u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d4 \u05d2\u05dc\u05d5\u05d9\u05d4 (DSM p.746)."
        },
        {
          "text": "Schizoid Personality Disorder",
          "isCorrect": false,
          "rationale": "\u05d4\u05e4\u05e8\u05e2\u05ea \u05d0\u05d9\u05e9\u05d9\u05d5\u05ea \u05e1\u05db\u05d9\u05d6\u05d5\u05d0\u05d9\u05d3\u05d9\u05ea \u05de\u05ea\u05d0\u05e4\u05d9\u05d9\u05e0\u05ea \u05d1\u05e0\u05d9\u05ea\u05d5\u05e7 \u05d7\u05d1\u05e8\u05ea\u05d9 \u05d5\u05e6\u05de\u05e6\u05d5\u05dd \u05e8\u05d2\u05e9\u05d9, \u05d0\u05da \u05d0\u05d9\u05e0\u05d4 \u05db\u05d5\u05dc\u05dc\u05ea \u05d0\u05ea \u05d4\u05e2\u05d9\u05d5\u05d5\u05ea\u05d9\u05dd \u05d4\u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9\u05d9\u05dd \u05d0\u05d5 \u05d4\u05ea\u05e4\u05d9\u05e1\u05ea\u05d9\u05d9\u05dd \u05d5\u05d4\u05d0\u05de\u05d5\u05e0\u05d5\u05ea \u05d4\u05de\u05d0\u05d2\u05d9\u05d5\u05ea \u05d4\u05e0\u05e8\u05d0\u05d5\u05ea \u05db\u05d0\u05df (DSM p.743)."
        },
        {
          "text": "Early-Onset Schizophrenia",
          "isCorrect": false,
          "rationale": "\u05dc\u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc Schizophrenia \u05e0\u05d3\u05e8\u05e9\u05d9\u05dd \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9\u05d9\u05dd \u05d1\u05e8\u05d5\u05e8\u05d9\u05dd (Positive Symptoms) \u05db\u05de\u05d5 \u05d3\u05dc\u05d5\u05d6\u05d9\u05d5\u05ea \u05d0\u05d5 \u05d4\u05d6\u05d9\u05d5\u05ea, \u05d1\u05e2\u05d5\u05d3 \u05e9\u05db\u05d0\u05df \u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d4\u05dd \u05e1\u05d5\u05d1-\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05d9\u05dd \u05d1\u05dc\u05d1\u05d3 (DSM p.114)."
        },
        {
          "text": "Social Anxiety Disorder",
          "isCorrect": false,
          "rationale": "\u05d1\u05d7\u05e8\u05d3\u05d4 \u05d7\u05d1\u05e8\u05ea\u05d9\u05ea \u05e1\u05d8\u05e0\u05d3\u05e8\u05d8\u05d9\u05ea, \u05d4\u05d7\u05e8\u05d3\u05d4 \u05e0\u05d5\u05d1\u05e2\u05ea \u05de\u05e4\u05d7\u05d3 \u05de\u05d4\u05e2\u05e8\u05db\u05d4 \u05e9\u05dc\u05d9\u05dc\u05d9\u05ea \u05d0\u05d5 \u05de\u05d1\u05d5\u05db\u05d4, \u05d5\u05dc\u05d0 \u05de\u05d7\u05e9\u05d9\u05d1\u05d4 \u05e4\u05e8\u05e0\u05d5\u05d0\u05d9\u05d3\u05d9\u05ea \u05d0\u05d5 \u05d0\u05de\u05d5\u05e0\u05d5\u05ea \u05e2\u05dc '\u05d2\u05e0\u05d9\u05d1\u05ea \u05de\u05d6\u05dc' (DSM p.229)."
        }
      ],
      "hint": "\u05d7\u05e4\u05e9\u05d5 \u05d0\u05ea \u05d4\u05e9\u05d9\u05dc\u05d5\u05d1 \u05d1\u05d9\u05df \u05de\u05d5\u05d6\u05e8\u05d5\u05ea \u05de\u05d7\u05e9\u05d1\u05ea\u05d9\u05ea (Odd Beliefs) \u05dc\u05d1\u05d9\u05df \u05d7\u05e8\u05d3\u05d4 \u05d7\u05d1\u05e8\u05ea\u05d9\u05ea \u05e9\u05d0\u05d9\u05e0\u05d4 \u05e4\u05d5\u05d7\u05ea\u05ea \u05e2\u05dd \u05d4\u05d9\u05db\u05e8\u05d5\u05ea.",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05d1\u05d1\u05d5\u05d0\u05e0\u05d5 \u05dc\u05d1\u05e6\u05e2 \u05d0\u05d1\u05d7\u05e0\u05d4 \u05de\u05d1\u05d3\u05dc\u05ea \u05d1\u05d9\u05df Schizotypal Personality Disorder \u05dc\u05d1\u05d9\u05df Autism Spectrum Disorder (ASD) \u05d1\u05d9\u05dc\u05d3\u05d5\u05ea, \u05d0\u05d9\u05d6\u05d4 \u05de\u05d4\u05de\u05de\u05e6\u05d0\u05d9\u05dd \u05d4\u05d1\u05d0\u05d9\u05dd \u05ea\u05d5\u05de\u05da \u05d9\u05d5\u05ea\u05e8 \u05d1\u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc ASD?",
      "answerOptions": [
        {
          "text": "\u05d7\u05d5\u05e1\u05e8 \u05d1\u05d5\u05dc\u05d8 \u05d1\u05e1\u05d9\u05e0\u05db\u05e8\u05d5\u05df \u05e8\u05d2\u05e9\u05d9 (Emotional Reciprocity) \u05d5\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05d9\u05d5\u05ea \u05e1\u05d8\u05e8\u05d9\u05d0\u05d5\u05d8\u05d9\u05e4\u05d9\u05d5\u05ea",
          "isCorrect": true,
          "rationale": "ASD \u05de\u05ea\u05d0\u05e4\u05d9\u05d9\u05df \u05d1\u05dc\u05d9\u05e7\u05d5\u05d9 \u05e8\u05d0\u05e9\u05d5\u05e0\u05d9 \u05d5\u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9 \u05d9\u05d5\u05ea\u05e8 \u05d1\u05d0\u05d9\u05e0\u05d8\u05e8\u05d0\u05e7\u05e6\u05d9\u05d4 \u05d7\u05d1\u05e8\u05ea\u05d9\u05ea \u05d4\u05d3\u05d3\u05d9\u05ea \u05d5\u05d1\u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05e9\u05dc \u05ea\u05d7\u05d5\u05de\u05d9 \u05e2\u05e0\u05d9\u05d9\u05df \u05de\u05e6\u05d5\u05de\u05e6\u05de\u05d9\u05dd \u05d5\u05e1\u05d8\u05e8\u05d9\u05d0\u05d5\u05d8\u05d9\u05e4\u05d9\u05d9\u05dd \u05d1\u05d4\u05e9\u05d5\u05d5\u05d0\u05d4 \u05dc-STPD (DSM p.747)."
        },
        {
          "text": "\u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05e9\u05dc Ideas of Reference \u05d5\u05d3\u05d9\u05d1\u05d5\u05e8 \u05de\u05e2\u05d5\u05e8\u05e4\u05dc",
          "isCorrect": false,
          "rationale": "\u05d0\u05dc\u05d5 \u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9\u05dd \u05e7\u05dc\u05d0\u05e1\u05d9\u05d9\u05dd \u05e9\u05dc Schizotypal PD, \u05d4\u05de\u05d9\u05d9\u05e6\u05d2\u05d9\u05dd \u05e2\u05d9\u05d5\u05d5\u05ea\u05d9\u05dd \u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9\u05d9\u05dd \u05e9\u05d0\u05d9\u05e0\u05dd \u05dc\u05d9\u05d1\u05ea \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc ASD (DSM p.746)."
        },
        {
          "text": "\u05d7\u05e8\u05d3\u05d4 \u05d7\u05d1\u05e8\u05ea\u05d9\u05ea \u05d4\u05de\u05d1\u05d5\u05e1\u05e1\u05ea \u05e2\u05dc \u05d7\u05e9\u05d3\u05e0\u05d5\u05ea \u05e4\u05e8\u05e0\u05d5\u05d0\u05d9\u05d3\u05d9\u05ea",
          "isCorrect": false,
          "rationale": "\u05d7\u05e8\u05d3\u05d4 \u05e4\u05e8\u05e0\u05d5\u05d0\u05d9\u05d3\u05d9\u05ea \u05d1\u05e1\u05d9\u05d8\u05d5\u05d0\u05e6\u05d9\u05d5\u05ea \u05d7\u05d1\u05e8\u05ea\u05d9\u05d5\u05ea \u05d4\u05d9\u05d0 \u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05de\u05e8\u05db\u05d6\u05d9 \u05e9\u05dc STPD, \u05d1\u05e2\u05d5\u05d3 \u05e9\u05d1-ASD \u05d4\u05e7\u05d5\u05e9\u05d9 \u05d4\u05d5\u05d0 \u05dc\u05e8\u05d5\u05d1 \u05d1\u05d4\u05d1\u05e0\u05ea \u05e7\u05d5\u05d3\u05d9\u05dd \u05d7\u05d1\u05e8\u05ea\u05d9\u05d9\u05dd (DSM p.746)."
        },
        {
          "text": "\u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4 \u05de\u05e9\u05e4\u05d7\u05ea\u05d9\u05ea \u05e9\u05dc Schizophrenia \u05d1\u05d3\u05e8\u05d2\u05d4 \u05e8\u05d0\u05e9\u05d5\u05e0\u05d4",
          "isCorrect": false,
          "rationale": "\u05de\u05de\u05e6\u05d0 \u05d6\u05d4 \u05de\u05d7\u05e9\u05d9\u05d3 \u05d9\u05d5\u05ea\u05e8 \u05dc\u05db\u05d9\u05d5\u05d5\u05df \u05d4\u05e1\u05e4\u05e7\u05d8\u05e8\u05d5\u05dd \u05d4\u05e1\u05db\u05d9\u05d6\u05d5\u05e4\u05e8\u05e0\u05d9 (\u05db\u05d5\u05dc\u05dc STPD) \u05de\u05d0\u05e9\u05e8 \u05dc-ASD, \u05dc\u05d0\u05d5\u05e8 \u05d4\u05e7\u05e9\u05e8 \u05d4\u05d2\u05e0\u05d8\u05d9 \u05d4\u05d4\u05d3\u05d5\u05e7 (StahlNeuro p.141)."
        }
      ],
      "hint": "\u05d4\u05ea\u05de\u05e7\u05d3\u05d5 \u05d1\u05dc\u05e7\u05d5\u05ea \u05d1\u05d9\u05db\u05d5\u05dc\u05ea \u05dc\u05d9\u05e6\u05d5\u05e8 \u05e7\u05e9\u05e8 \u05d4\u05d3\u05d3\u05d9 \u05dc\u05e2\u05d5\u05de\u05ea \u05ea\u05d5\u05db\u05df \u05de\u05d7\u05e9\u05d1\u05ea\u05d9 \u05d1\u05d9\u05d6\u05d0\u05e8\u05d9.",
      "imageUrls": []
    },
    {
      "type": "fill_in_the_blank",
      "question": "\u05e2\u05dc \u05e4\u05d9 \u05d4\u05de\u05d5\u05d3\u05dc \u05d4\u05e0\u05d5\u05d9\u05e8\u05d5\u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d4\u05de\u05d5\u05e6\u05d2 \u05d1-StahlNeuro, \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05e4\u05ea\u05d7 Schizophrenia \u05d0\u05d5 \u05d4\u05e4\u05e8\u05e2\u05d4 \u05d1\u05e1\u05e4\u05e7\u05d8\u05e8\u05d5\u05dd \u05d4\u05e1\u05db\u05d9\u05d6\u05d5\u05e4\u05e8\u05e0\u05d9 \u05d0\u05d9\u05e0\u05d5 \u05e0\u05d5\u05d1\u05e2 \u05de\u05d2\u05d5\u05e8\u05dd \u05d9\u05d7\u05d9\u05d3, \u05d0\u05dc\u05d0 \u05de\u05e9\u05d9\u05dc\u05d5\u05d1 \u05e9\u05dc ___ (\u05db\u05d2\u05d5\u05df \u05e7\u05e0\u05d0\u05d1\u05d9\u05e1 \u05d0\u05d5 \u05d8\u05e8\u05d0\u05d5\u05de\u05d4 \u05d1\u05d9\u05dc\u05d3\u05d5\u05ea) \u05d4\u05e4\u05d5\u05e2\u05dc\u05d9\u05dd \u05e2\u05dc \u05e8\u05e7\u05e2 \u05d2\u05e0\u05d8\u05d9 \u05e4\u05d2\u05d9\u05e2 (StahlNeuro p.149).",
      "bestAnswer": "environmental stressors",
      "acceptableAnswers": [
        "stressors",
        "environmental factors",
        "stress"
      ],
      "rationale": "\u05d4\u05de\u05d5\u05d3\u05dc \u05de\u05d3\u05d2\u05d9\u05e9 \u05d0\u05ea \u05d4\u05d0\u05d9\u05e0\u05d8\u05e8\u05d0\u05e7\u05e6\u05d9\u05d4 \u05d1\u05d9\u05df Nature (\u05d2\u05e0\u05d8\u05d9\u05e7\u05d4) \u05dc-Nurture (\u05e1\u05d1\u05d9\u05d1\u05d4), \u05db\u05d0\u05e9\u05e8 \u05e1\u05d8\u05e8\u05e1\u05d5\u05e8\u05d9\u05dd \u05e1\u05d1\u05d9\u05d1\u05ea\u05d9\u05d9\u05dd '\u05e4\u05d5\u05e8\u05e7\u05d9\u05dd' \u05d0\u05ea \u05d4\u05de\u05d8\u05e2\u05df \u05d4\u05d2\u05e0\u05d8\u05d9 (StahlNeuro p.149).",
      "hint": "\u05d7\u05e9\u05d1\u05d5 \u05e2\u05dc \u05d2\u05d5\u05e8\u05de\u05d9\u05dd \u05d7\u05d9\u05e6\u05d5\u05e0\u05d9\u05d9\u05dd \u05d4\u05de\u05e9\u05e4\u05d9\u05e2\u05d9\u05dd \u05e2\u05dc \u05d4\u05d0\u05e4\u05d9\u05d2\u05e0\u05d8\u05d9\u05e7\u05d4."
    },
    {
      "type": "multiple_select",
      "question": "\u05d0\u05d9\u05dc\u05d5 \u05de\u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d4\u05d1\u05d0\u05d9\u05dd \u05e0\u05db\u05dc\u05dc\u05d9\u05dd \u05ea\u05d7\u05ea \u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05d4\u05d0\u05d1\u05d7\u05e0\u05ea\u05d9\u05d9\u05dd (Criterion A) \u05dc-Schizotypal Personality Disorder \u05d1-DSM-5-TR?",
      "answerOptions": [
        {
          "text": "Odd beliefs or magical thinking influencing behavior",
          "isCorrect": true,
          "rationale": "\u05d0\u05de\u05d5\u05e0\u05d5\u05ea \u05de\u05d0\u05d2\u05d9\u05d5\u05ea \u05db\u05de\u05d5 \u05d8\u05dc\u05e4\u05ea\u05d9\u05d4 \u05d0\u05d5 '\u05d7\u05d5\u05e9 \u05e9\u05d9\u05e9\u05d9' \u05d4\u05df \u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05dc\u05d9\u05d1\u05d4 \u05e9\u05dc \u05d4\u05d4\u05e4\u05e8\u05e2\u05d4 (DSM p.746)."
        },
        {
          "text": "Ideas of reference (excluding delusions of reference)",
          "isCorrect": true,
          "rationale": "\u05d9\u05d9\u05d7\u05d5\u05e1 \u05de\u05e9\u05de\u05e2\u05d5\u05ea \u05de\u05d9\u05d5\u05d7\u05d3\u05ea \u05dc\u05d0\u05d9\u05e8\u05d5\u05e2\u05d9\u05dd \u05de\u05e7\u05e8\u05d9\u05d9\u05dd (\u05dc\u05dc\u05d0 \u05e2\u05d5\u05e6\u05de\u05d4 \u05d3\u05dc\u05d5\u05d6\u05d9\u05d5\u05e0\u05dc\u05d9\u05ea) \u05d4\u05d5\u05d0 \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df \u05de\u05e8\u05db\u05d6\u05d9 (DSM p.746)."
        },
        {
          "text": "Lack of close friends or confidants other than first-degree relatives",
          "isCorrect": true,
          "rationale": "\u05d1\u05d9\u05d3\u05d5\u05d3 \u05d7\u05d1\u05e8\u05ea\u05d9 \u05d4\u05d5\u05d0 \u05ea\u05d5\u05e6\u05d0\u05d4 \u05e9\u05dc \u05d7\u05d5\u05e1\u05e8 \u05e0\u05d5\u05d7\u05d5\u05ea \u05d1\u05d9\u05e0\u05d0\u05d9\u05e9\u05d9\u05ea \u05d5\u05e2\u05d9\u05d5\u05d5\u05ea\u05d9\u05dd \u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9\u05d9\u05dd (DSM p.746)."
        },
        {
          "text": "Prolonged episodes of full-blown auditory hallucinations",
          "isCorrect": false,
          "rationale": "\u05d4\u05d6\u05d9\u05d5\u05ea \u05de\u05de\u05d5\u05e9\u05db\u05d5\u05ea \u05d4\u05df \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df \u05dc-Schizophrenia; \u05d1-STPD \u05d4\u05d7\u05d5\u05d5\u05d9\u05d5\u05ea \u05d4\u05df \u05ea\u05e4\u05d9\u05e1\u05ea\u05d9\u05d5\u05ea \u05d7\u05d5\u05dc\u05e4\u05d5\u05ea \u05d0\u05d5 \u05d0\u05e9\u05dc\u05d9\u05d5\u05ea (DSM p.747)."
        }
      ],
      "hint": "\u05d4\u05ea\u05de\u05e7\u05d3\u05d5 \u05d1\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e9\u05d4\u05dd '\u05e1\u05d5\u05d1-\u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9\u05d9\u05dd' \u05d0\u05da \u05de\u05e2\u05d9\u05d3\u05d9\u05dd \u05e2\u05dc \u05de\u05d5\u05d6\u05e8\u05d5\u05ea.",
      "hasAllOfTheAbove": false,
      "hasNoneOfTheAbove": false
    },
    {
      "type": "multiple_choice",
      "question": "\u05de\u05d8\u05d5\u05e4\u05dc \u05e2\u05dd Schizotypal Personality Disorder \u05e1\u05d5\u05d1\u05dc \u05de\u05d7\u05e9\u05d3\u05e0\u05d5\u05ea \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05d5-Ideas of Reference \u05d4\u05d2\u05d5\u05e8\u05de\u05d9\u05dd \u05dc\u05de\u05e6\u05d5\u05e7\u05d4 \u05ea\u05e4\u05e7\u05d5\u05d3\u05d9\u05ea. \u05de\u05d4\u05d9 \u05d4\u05d0\u05e1\u05d8\u05e8\u05d8\u05d2\u05d9\u05d4 \u05d4\u05e4\u05e8\u05de\u05e7\u05dc\u05d5\u05d2\u05d9\u05ea \u05d4\u05de\u05d5\u05de\u05dc\u05e6\u05ea \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05ea\u05e1\u05de\u05d9\u05e0\u05d9 \u05de\u05d8\u05e8\u05d4 \u05d0\u05dc\u05d5 \u05e2\u05dc \u05e4\u05d9 \u05d4-Synopsis?",
      "answerOptions": [
        {
          "text": "Low-dose atypical antipsychotics (SGAs)",
          "isCorrect": true,
          "rationale": "\u05d0\u05e0\u05d8\u05d9\u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9\u05d9\u05dd \u05d1\u05de\u05d9\u05e0\u05d5\u05df \u05e0\u05de\u05d5\u05da (\u05db\u05de\u05d5 Risperidone \u05d0\u05d5 Aripiprazole) \u05d9\u05e2\u05d9\u05dc\u05d9\u05dd \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05e2\u05d9\u05d5\u05d5\u05ea\u05d9\u05dd \u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9\u05d9\u05dd \u05d5\u05d7\u05e9\u05d3\u05e0\u05d5\u05ea \u05d1-STPD (Synopsis ch.19)."
        },
        {
          "text": "High-dose SSRIs for OCD symptoms",
          "isCorrect": false,
          "rationale": "\u05de\u05d9\u05e0\u05d5\u05df \u05d2\u05d1\u05d5\u05d4 \u05e9\u05dc SSRI \u05de\u05d9\u05d5\u05e2\u05d3 \u05dc-OCD, \u05d0\u05da \u05db\u05d0\u05df \u05de\u05d3\u05d5\u05d1\u05e8 \u05d1\u05ea\u05d5\u05db\u05df \u05de\u05d7\u05e9\u05d1\u05ea\u05d9 \u05e1\u05db\u05d9\u05d6\u05d5\u05d8\u05d9\u05e4\u05dc\u05d9 \u05d4\u05d3\u05d5\u05e8\u05e9 \u05d4\u05ea\u05e2\u05e8\u05d1\u05d5\u05ea \u05d3\u05d5\u05e4\u05de\u05d9\u05e0\u05e8\u05d2\u05d9\u05ea (StahlNeuro p.234)."
        },
        {
          "text": "Benzodiazepines for social anxiety",
          "isCorrect": false,
          "rationale": "\u05d9\u05e9 \u05dc\u05d4\u05d9\u05de\u05e0\u05e2 \u05de-Benzodiazepines \u05d1\u05e9\u05dc \u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05d3\u05d9\u05e1\u05d0\u05d9\u05e0\u05d4\u05d9\u05d1\u05d9\u05e6\u05d9\u05d4 \u05d5\u05e9\u05d9\u05de\u05d5\u05e9 \u05dc\u05e8\u05e2\u05d4, \u05d1\u05de\u05d9\u05d5\u05d7\u05d3 \u05d1\u05e7\u05d5-\u05de\u05d5\u05e8\u05d1\u05d9\u05d3\u05d9\u05d5\u05ea \u05e2\u05dd \u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05d0\u05d9\u05e9\u05d9\u05d5\u05ea (Synopsis ch.19)."
        },
        {
          "text": "Lithium for mood stabilization",
          "isCorrect": false,
          "rationale": "Lithium \u05d0\u05d9\u05e0\u05d5 \u05d8\u05d9\u05e4\u05d5\u05dc \u05e7\u05d5 \u05e8\u05d0\u05e9\u05d5\u05df \u05dc-STPD \u05d0\u05dc\u05d0 \u05d0\u05dd \u05e7\u05d9\u05d9\u05de\u05ea \u05d4\u05e4\u05e8\u05e2\u05d4 \u05d1\u05d9\u05e4\u05d5\u05dc\u05e8\u05d9\u05ea \u05e0\u05dc\u05d5\u05d5\u05d9\u05ea \u05d1\u05e8\u05d5\u05e8\u05d4 (StahlKids p.805)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d1\u05d5 \u05e2\u05dc \u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05d4\u05de\u05db\u05d5\u05d5\u05e0\u05d5\u05ea \u05dc\u05de\u05e1\u05dc\u05d5\u05dc\u05d9\u05dd \u05de\u05d6\u05d5\u05dc\u05d9\u05de\u05d1\u05d9\u05d9\u05dd \u05d1\u05de\u05d9\u05e0\u05d5\u05df \u05de\u05ea\u05d5\u05df.",
      "imageUrls": []
    },
    {
      "type": "short_answer",
      "question": "\u05d4\u05e1\u05d1\u05d9\u05e8\u05d5 \u05d0\u05ea \u05d4\u05e7\u05e9\u05e8 \u05d4\u05d0\u05d8\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d5\u05d4\u05d2\u05e0\u05d8\u05d9 \u05d1\u05d9\u05df Schizotypal Personality Disorder \u05dc\u05d1\u05d9\u05df Schizophrenia \u05db\u05e4\u05d9 \u05e9\u05de\u05ea\u05d5\u05d0\u05e8 \u05d1\u05de\u05e7\u05d5\u05e8\u05d5\u05ea.",
      "grading": {
        "modelAnswer": "STPD \u05e0\u05d7\u05e9\u05d1\u05ea \u05dc\u05d7\u05dc\u05e7 \u05de\u05d4\u05e1\u05e4\u05e7\u05d8\u05e8\u05d5\u05dd \u05d4\u05e1\u05db\u05d9\u05d6\u05d5\u05e4\u05e8\u05e0\u05d9 (Schizophrenia Spectrum). \u05d4\u05d9\u05d0 \u05de\u05d5\u05e4\u05d9\u05e2\u05d4 \u05d1\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d2\u05d1\u05d5\u05d4\u05d4 \u05d9\u05d5\u05ea\u05e8 \u05d1\u05e7\u05e8\u05d1 \u05e7\u05e8\u05d5\u05d1\u05d9 \u05de\u05e9\u05e4\u05d7\u05d4 \u05de\u05d3\u05e8\u05d2\u05d4 \u05e8\u05d0\u05e9\u05d5\u05e0\u05d4 \u05e9\u05dc \u05d7\u05d5\u05dc\u05d9 \u05e1\u05db\u05d9\u05d6\u05d5\u05e4\u05e8\u05e0\u05d9\u05d4, \u05d5\u05de\u05d7\u05e7\u05e8\u05d9\u05dd \u05d2\u05e0\u05d8\u05d9\u05d9\u05dd (\u05db\u05d5\u05dc\u05dc \u05ea\u05d0\u05d5\u05de\u05d9\u05dd) \u05de\u05e6\u05d1\u05d9\u05e2\u05d9\u05dd \u05e2\u05dc \u05d7\u05e4\u05d9\u05e4\u05d4 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05d1\u05d5\u05e8\u05d9\u05d0\u05e0\u05d8\u05d9\u05dd \u05d2\u05e0\u05d8\u05d9\u05d9\u05dd \u05d5\u05e1\u05d9\u05db\u05d5\u05df \u05e4\u05d5\u05dc\u05d9\u05d2\u05e0\u05d9 \u05de\u05e9\u05d5\u05ea\u05e3 (DSM p.746; StahlNeuro p.141).",
        "rationale": "\u05d4\u05e7\u05e9\u05e8 \u05de\u05d1\u05d5\u05e1\u05e1 \u05e2\u05dc \u05d4\u05e6\u05d8\u05d1\u05e8\u05d5\u05ea \u05de\u05e9\u05e4\u05d7\u05ea\u05d9\u05ea (Familial aggregation) \u05d5\u05d7\u05e4\u05d9\u05e4\u05d4 \u05e4\u05e0\u05d5\u05d8\u05d9\u05e4\u05d9\u05ea \u05d4\u05de\u05e6\u05d9\u05d1\u05d4 \u05d0\u05ea \u05d4-STPD \u05db\u05d5\u05e8\u05d9\u05d0\u05e0\u05d8 '\u05e7\u05dc' \u05d9\u05d5\u05ea\u05e8 \u05e9\u05dc \u05e4\u05d2\u05d9\u05e2\u05d5\u05ea \u05d2\u05e0\u05d8\u05d9\u05ea \u05d3\u05d5\u05de\u05d4.",
        "requiredAttributes": [
          "\u05e6\u05d9\u05d5\u05df \u05d4\u05de\u05d5\u05e0\u05d7 '\u05e1\u05e4\u05e7\u05d8\u05e8\u05d5\u05dd \u05e1\u05db\u05d9\u05d6\u05d5\u05e4\u05e8\u05e0\u05d9' (Schizophrenia Spectrum).",
          "\u05d4\u05ea\u05d9\u05d9\u05d7\u05e1\u05d5\u05ea \u05dc\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d2\u05d1\u05d5\u05d4\u05d4 \u05d1\u05e7\u05e8\u05d5\u05d1\u05d9 \u05de\u05e9\u05e4\u05d7\u05d4 \u05e9\u05dc \u05d7\u05d5\u05dc\u05d9 \u05e1\u05db\u05d9\u05d6\u05d5\u05e4\u05e8\u05e0\u05d9\u05d4.",
          "\u05d0\u05d6\u05db\u05d5\u05e8 \u05de\u05e8\u05db\u05d9\u05d1 \u05ea\u05d5\u05e8\u05e9\u05ea\u05d9/\u05d2\u05e0\u05d8\u05d9 \u05de\u05e9\u05d5\u05ea\u05e3."
        ],
        "errors": {
          "misconceptions": [
            "\u05d8\u05e2\u05e0\u05d4 \u05e9\u05d0\u05d9\u05df \u05e7\u05e9\u05e8 \u05d2\u05e0\u05d8\u05d9 \u05d1\u05d9\u05e0\u05d9\u05d4\u05df.",
            "\u05d8\u05e2\u05e0\u05d4 \u05e9\u05db\u05dc \u05d7\u05d5\u05dc\u05d9 STPD \u05d4\u05d5\u05e4\u05db\u05d9\u05dd \u05dc\u05d7\u05d5\u05dc\u05d9 \u05e1\u05db\u05d9\u05d6\u05d5\u05e4\u05e8\u05e0\u05d9\u05d4 (\u05e8\u05e7 \u05de\u05d9\u05e2\u05d5\u05d8 \u05e7\u05d8\u05df \u05de\u05ea\u05e7\u05d3\u05dd \u05dc\u05db\u05da)."
          ],
          "bluffs": [
            "\u05d3\u05d9\u05d1\u05d5\u05e8 \u05db\u05dc\u05dc\u05d9 \u05e2\u05dc \u05db\u05da \u05e9\u05d4\u05df \u05d3\u05d5\u05de\u05d5\u05ea \u05d1\u05dc\u05d9 \u05dc\u05d4\u05d6\u05db\u05d9\u05e8 \u05d0\u05ea \u05d4\u05e7\u05e9\u05e8 \u05d4\u05de\u05e9\u05e4\u05d7\u05ea\u05d9/\u05d2\u05e0\u05d8\u05d9."
          ]
        }
      },
      "hint": "\u05d4\u05ea\u05d9\u05d9\u05d7\u05e1\u05d5 \u05dc\u05de\u05d5\u05e9\u05d2 \u05d4'\u05e1\u05e4\u05e7\u05d8\u05e8\u05d5\u05dd' \u05d5\u05dc\u05de\u05de\u05e6\u05d0\u05d9 \u05de\u05d7\u05e7\u05e8\u05d9 \u05de\u05e9\u05e4\u05d7\u05d5\u05ea.",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05dc\u05e4\u05d9 \u05d4-DSM-5-TR, \u05de\u05d4\u05d5 \u05d4\u05de\u05d4\u05dc\u05da \u05d4\u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05d9 (Course) \u05e9\u05dc Schizotypal Personality Disorder?",
      "answerOptions": [
        {
          "text": "\u05de\u05d4\u05dc\u05da \u05d9\u05e6\u05d9\u05d1 \u05d9\u05d7\u05e1\u05d9\u05ea, \u05db\u05d0\u05e9\u05e8 \u05e8\u05e7 \u05de\u05d9\u05e2\u05d5\u05d8 \u05e7\u05d8\u05df \u05de\u05d4\u05de\u05e7\u05e8\u05d9\u05dd \u05de\u05e4\u05ea\u05d7 Schizophrenia",
          "isCorrect": true,
          "rationale": "\u05d4\u05e4\u05e8\u05e2\u05ea \u05d4\u05d0\u05d9\u05e9\u05d9\u05d5\u05ea \u05e0\u05d5\u05d8\u05d4 \u05dc\u05d4\u05d9\u05e9\u05d0\u05e8 \u05e7\u05d1\u05d5\u05e2\u05d4 \u05dc\u05d0\u05d5\u05e8\u05da \u05d6\u05de\u05df, \u05d5\u05e8\u05e7 \u05d7\u05dc\u05e7 \u05e7\u05d8\u05df \u05de\u05d4\u05d0\u05e0\u05e9\u05d9\u05dd \u05de\u05e4\u05ea\u05d7\u05d9\u05dd \u05d4\u05e4\u05e8\u05e2\u05d4 \u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9\u05ea \u05de\u05dc\u05d0\u05d4 (DSM p.746)."
        },
        {
          "text": "\u05de\u05d4\u05dc\u05da \u05e4\u05e8\u05d5\u05d2\u05e8\u05e1\u05d9\u05d1\u05d9 \u05d4\u05de\u05d5\u05d1\u05d9\u05dc \u05d1\u05d4\u05db\u05e8\u05d7 \u05dc\u05d4\u05d9\u05d3\u05e8\u05d3\u05e8\u05d5\u05ea \u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9\u05ea \u05d3\u05de\u05d5\u05d9\u05ea \u05d3\u05de\u05e0\u05e6\u05d9\u05d4",
          "isCorrect": false,
          "rationale": "\u05d6\u05d5\u05d4\u05d9 \u05ea\u05e4\u05d9\u05e1\u05d4 \u05de\u05d5\u05d8\u05e2\u05d9\u05ea; \u05d1\u05e0\u05d9\u05d2\u05d5\u05d3 \u05dc\u05e1\u05db\u05d9\u05d6\u05d5\u05e4\u05e8\u05e0\u05d9\u05d4 \u05e9\u05d9\u05db\u05d5\u05dc\u05d4 \u05dc\u05db\u05dc\u05d5\u05dc \u05d9\u05e8\u05d9\u05d3\u05d4 \u05ea\u05e4\u05e7\u05d5\u05d3\u05d9\u05ea, STPD \u05d4\u05d9\u05d0 \u05d4\u05e4\u05e8\u05e2\u05ea \u05d0\u05d9\u05e9\u05d9\u05d5\u05ea \u05d9\u05e6\u05d9\u05d1\u05d4 (DSM p.746)."
        },
        {
          "text": "\u05d4\u05d7\u05dc\u05de\u05d4 \u05de\u05dc\u05d0\u05d4 \u05d1\u05d1\u05d2\u05e8\u05d5\u05ea \u05d4\u05de\u05d5\u05e7\u05d3\u05de\u05ea \u05d1\u05e8\u05d5\u05d1 \u05d4\u05de\u05e7\u05e8\u05d9\u05dd",
          "isCorrect": false,
          "rationale": "\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05d0\u05d9\u05e9\u05d9\u05d5\u05ea, \u05de\u05e2\u05e6\u05dd \u05d4\u05d2\u05d3\u05e8\u05ea\u05df, \u05d4\u05df \u05d3\u05e4\u05d5\u05e1\u05d9\u05dd \u05de\u05ea\u05de\u05e9\u05db\u05d9\u05dd \u05d5\u05e7\u05d1\u05d5\u05e2\u05d9\u05dd (Stable) \u05d5\u05d0\u05d9\u05e0\u05df \u05e0\u05d5\u05d8\u05d5\u05ea \u05dc\u05d4\u05d9\u05e2\u05dc\u05dd \u05e1\u05e4\u05d5\u05e0\u05d8\u05e0\u05d9\u05ea (DSM p.881)."
        },
        {
          "text": "\u05ea\u05e0\u05d5\u05d3\u05d5\u05ea \u05d7\u05e8\u05d9\u05e4\u05d5\u05ea \u05d1\u05d9\u05df \u05de\u05e6\u05d1\u05d9\u05dd \u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9\u05d9\u05dd \u05dc\u05de\u05e6\u05d1\u05d9 \u05e0\u05d5\u05e8\u05de\u05d4",
          "isCorrect": false,
          "rationale": "\u05ea\u05d9\u05d0\u05d5\u05e8 \u05d6\u05d4 \u05de\u05ea\u05d0\u05d9\u05dd \u05d9\u05d5\u05ea\u05e8 \u05dc-Brief Psychotic Disorder \u05d0\u05d5 \u05dc-Schizoaffective Disorder, \u05d5\u05dc\u05d0 \u05dc\u05de\u05d4\u05dc\u05da \u05d4\u05d9\u05e6\u05d9\u05d1 \u05e9\u05dc STPD (DSM p.108)."
        }
      ],
      "hint": "\u05d4\u05d0\u05dd \u05de\u05d3\u05d5\u05d1\u05e8 \u05d1\u05de\u05e6\u05d1 \u05d3\u05d9\u05e0\u05de\u05d9 \u05d0\u05d5 \u05d1\u05d3\u05e4\u05d5\u05e1 \u05d0\u05d9\u05e9\u05d9\u05d5\u05ea \u05e7\u05d1\u05d5\u05e2?",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05d1\u05e2\u05ea \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Schizotypal Personality Disorder, \u05de\u05d4\u05d9 \u05d4\u05de\u05dc\u05e6\u05ea \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05e4\u05e1\u05d9\u05db\u05d5\u05ea\u05e8\u05e4\u05d9 \u05d4\u05e2\u05d9\u05e7\u05e8\u05d9\u05ea \u05d1\u05de\u05e4\u05d2\u05e9 \u05e2\u05dd \u05d0\u05de\u05d5\u05e0\u05d5\u05ea\u05d9\u05d5 \u05d4\u05de\u05d0\u05d2\u05d9\u05d5\u05ea \u05e9\u05dc \u05d4\u05de\u05d8\u05d5\u05e4\u05dc (\u05dc\u05e4\u05d9 \u05d4-Synopsis)?",
      "answerOptions": [
        {
