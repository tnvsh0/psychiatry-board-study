        {
          "text": "\u05e8\u05de\u05d5\u05ea Prolactin \u05d1\u05d3\u05dd \u05d1\u05dc\u05d1\u05d3, \u05db\u05d9\u05d5\u05d5\u05df \u05e9\u05d6\u05d5\u05d4\u05d9 \u05ea\u05d5\u05e4\u05e2\u05ea \u05d4\u05dc\u05d5\u05d5\u05d0\u05d9 \u05d4\u05e9\u05db\u05d9\u05d7\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05e9\u05dc Quetiapine.",
          "isCorrect": false,
          "rationale": "Quetiapine \u05d4\u05d5\u05d0 \u05d1\u05e2\u05dc \u05e1\u05d9\u05db\u05d5\u05df \u05e0\u05de\u05d5\u05da \u05d9\u05d7\u05e1\u05d9\u05ea \u05dc\u05e2\u05dc\u05d9\u05d9\u05ea \u05e4\u05e8\u05d5\u05dc\u05e7\u05d8\u05d9\u05df; \u05d1\u05d3\u05d9\u05e7\u05ea \u05e8\u05de\u05d5\u05ea \u05e4\u05e8\u05d5\u05dc\u05e7\u05d8\u05d9\u05df \u05e0\u05d3\u05e8\u05e9\u05ea \u05d1\u05d1\u05e1\u05d9\u05e1 \u05d0\u05d5 \u05d1\u05de\u05e2\u05e7\u05d1 \u05d1\u05e2\u05d9\u05e7\u05e8 \u05d0\u05dd \u05de\u05d5\u05e4\u05d9\u05e2\u05d9\u05dd \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e7\u05dc\u05d9\u05e0\u05d9\u05d9\u05dd (Dulcan p. 827; StahlKids p. 419)."
        },
        {
          "text": "\u05d0\u05d9\u05df \u05e6\u05d5\u05e8\u05da \u05d1\u05d1\u05d3\u05d9\u05e7\u05d5\u05ea \u05d3\u05dd \u05de\u05e7\u05d3\u05d9\u05de\u05d5\u05ea \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05de\u05ea\u05d7\u05ea \u05dc\u05d2\u05d9\u05dc 18 \u05d0\u05dc\u05d0 \u05d0\u05dd \u05d9\u05e9 \u05d4\u05e9\u05de\u05e0\u05ea \u05d9\u05ea\u05e8 \u05e7\u05d9\u05d9\u05de\u05ea.",
          "isCorrect": false,
          "rationale": "\u05d4\u05e0\u05d7\u05d9\u05d5\u05ea \u05d4\u05e0\u05d9\u05d8\u05d5\u05e8 \u05de\u05d7\u05d9\u05d9\u05d1\u05d5\u05ea \u05d1\u05d3\u05d9\u05e7\u05d5\u05ea \u05d1\u05e1\u05d9\u05e1 \u05dc\u05db\u05dc \u05d4\u05d9\u05dc\u05d3\u05d9\u05dd \u05d1\u05e9\u05dc \u05e8\u05d2\u05d9\u05e9\u05d5\u05ea\u05dd \u05d4\u05de\u05d5\u05d2\u05d1\u05e8\u05ea \u05dc\u05ea\u05d5\u05e4\u05e2\u05d5\u05ea \u05dc\u05d5\u05d5\u05d0\u05d9 \u05de\u05d8\u05d1\u05d5\u05dc\u05d9\u05d5\u05ea (Dulcan p. 785, p. 827)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d1\u05d5 \u05e2\u05dc \u05d4\u05e1\u05d9\u05db\u05d5\u05e0\u05d9\u05dd \u05d4\u05de\u05d8\u05d1\u05d5\u05dc\u05d9\u05d9\u05dd \u05d4\u05db\u05e8\u05d5\u05db\u05d9\u05dd \u05d1\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05d0\u05e0\u05d8\u05d9-\u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9\u05d5\u05ea \u05de\u05d4\u05d3\u05d5\u05e8 \u05d4\u05e9\u05e0\u05d9."
    },
    {
      "question": "\u05d1\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd SSRIs, \u05e0\u05e6\u05e4\u05d9\u05ea \u05dc\u05e2\u05d9\u05ea\u05d9\u05dd \u05ea\u05d5\u05e4\u05e2\u05d4 \u05e9\u05dc 'Treatment-emergent activation syndrome' (TEAS). \u05db\u05d9\u05e6\u05d3 \u05d4\u05d9\u05d0 \u05de\u05ea\u05d1\u05d8\u05d0\u05ea \u05d5\u05de\u05d4\u05d9 \u05e9\u05db\u05d9\u05d7\u05d5\u05ea\u05d4 \u05d4\u05d9\u05d7\u05e1\u05d9\u05ea \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05dc\u05e2\u05d5\u05de\u05ea \u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd?",
      "answerOptions": [
        {
          "text": "\u05d4\u05ea\u05d5\u05e4\u05e2\u05d4 \u05db\u05d5\u05dc\u05dc\u05ea \u05d0\u05d9-\u05e9\u05e7\u05d8, \u05d0\u05d9\u05e8\u05d9\u05d8\u05d1\u05d9\u05dc\u05d9\u05d5\u05ea \u05d5\u05d3\u05d9\u05e1-\u05d0\u05d9\u05e0\u05d4\u05d9\u05d1\u05d9\u05e6\u05d9\u05d4, \u05d5\u05e9\u05db\u05d9\u05d7\u05d5\u05ea\u05d4 \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d2\u05d1\u05d5\u05d4\u05d4 \u05e4\u05d9 2-3 \u05de\u05d0\u05e9\u05e8 \u05d1\u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd.",
          "isCorrect": true,
          "rationale": "Behavioral activation (\u05d4\u05db\u05d5\u05dc\u05dc\u05ea \u05d0\u05d9-\u05e9\u05e7\u05d8 \u05d5\u05d3\u05d9\u05e1-\u05d0\u05d9\u05e0\u05d4\u05d9\u05d1\u05d9\u05e6\u05d9\u05d4) \u05e9\u05db\u05d9\u05d7\u05d4 \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05e4\u05d9 2 \u05e2\u05d3 3 \u05de\u05d0\u05e9\u05e8 \u05d1\u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd \u05d0\u05d5 \u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd (StahlKids p. 93, p. 392)."
        },
        {
          "text": "\u05d4\u05ea\u05d5\u05e4\u05e2\u05d4 \u05de\u05ea\u05d1\u05d8\u05d0\u05ea \u05d1\u05d9\u05e8\u05d9\u05d3\u05d4 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05d1\u05ea\u05d9\u05d0\u05d1\u05d5\u05df \u05d5\u05d1\u05e9\u05d9\u05e0\u05d4, \u05d5\u05d4\u05d9\u05d0 \u05e0\u05d3\u05d9\u05e8\u05d4 \u05de\u05d0\u05d5\u05d3 \u05de\u05ea\u05d7\u05ea \u05dc\u05d2\u05d9\u05dc 12.",
          "isCorrect": false,
          "rationale": "\u05d0\u05e7\u05d8\u05d9\u05d1\u05e6\u05d9\u05d4 \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea\u05d9\u05ea \u05d3\u05d5\u05d5\u05e7\u05d0 \u05e9\u05db\u05d9\u05d7\u05d4 \u05d9\u05d5\u05ea\u05e8 \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05e6\u05e2\u05d9\u05e8\u05d9\u05dd \u05d5\u05e7\u05e9\u05d5\u05e8\u05d4 \u05dc\u05d4\u05d9\u05e4\u05e8-\u05d0\u05e8\u05d5\u05d6\u05dc (Dulcan p. 734)."
        },
        {
          "text": "\u05d6\u05d5\u05d4\u05d9 \u05ea\u05d5\u05e4\u05e2\u05d4 \u05e9\u05dc 'Sedation' \u05e7\u05d9\u05e6\u05d5\u05e0\u05d9\u05ea \u05d4\u05de\u05d5\u05e4\u05d9\u05e2\u05d4 \u05d1\u05e9\u05d1\u05d5\u05e2\u05d9\u05d9\u05dd \u05d4\u05e8\u05d0\u05e9\u05d5\u05e0\u05d9\u05dd \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc.",
          "isCorrect": false,
          "rationale": "\u05d4\u05de\u05d5\u05e9\u05d2 \u05d0\u05e7\u05d8\u05d9\u05d1\u05e6\u05d9\u05d4 \u05de\u05ea\u05d9\u05d9\u05d7\u05e1 \u05dc\u05de\u05e6\u05d1 \u05e9\u05dc \u05e2\u05d5\u05e8\u05e8\u05d5\u05ea \u05d9\u05ea\u05e8 (Hyperarousal) \u05d5\u05dc\u05d0 \u05dc\u05d9\u05e9\u05e0\u05d5\u05e0\u05d9\u05d5\u05ea (Dulcan p. 734)."
        },
        {
          "text": "\u05d4\u05ea\u05d5\u05e4\u05e2\u05d4 \u05e0\u05d7\u05e9\u05d1\u05ea \u05dc\u05e1\u05d9\u05de\u05df \u05de\u05e7\u05d3\u05d9\u05dd \u05d1\u05d8\u05d5\u05d7 \u05dc\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea \u05e9\u05dc Bipolar Disorder \u05d1\u05d1\u05d2\u05e8\u05d5\u05ea.",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05e9\u05d0\u05e7\u05d8\u05d9\u05d1\u05e6\u05d9\u05d4 \u05e2\u05dc\u05d5\u05dc\u05d4 \u05dc\u05d4\u05d9\u05d3\u05de\u05d5\u05ea \u05dc\u05de\u05d0\u05e0\u05d9\u05d4, \u05d4\u05d9\u05d0 \u05dc\u05e2\u05d9\u05ea\u05d9\u05dd \u05e7\u05e8\u05d5\u05d1\u05d5\u05ea \u05ea\u05d5\u05e4\u05e2\u05ea \u05dc\u05d5\u05d5\u05d0\u05d9 \u05e9\u05dc \u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 \u05d5\u05dc\u05d0 \u05d1\u05d4\u05db\u05e8\u05d7 \u05de\u05e2\u05d9\u05d3\u05d4 \u05e2\u05dc \u05d4\u05e4\u05e8\u05e2\u05d4 \u05d1\u05d9\u05e4\u05d5\u05dc\u05e8\u05d9\u05ea (Dulcan p. 264; StahlKids p. 121)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d1\u05d5 \u05e2\u05dc \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d4\u05de\u05d3\u05de\u05d9\u05dd \u05d4\u05d9\u05e4\u05d5\u05de\u05d0\u05e0\u05d9\u05d4 \u05d0\u05d5 \u05d7\u05d5\u05e1\u05e8 \u05e9\u05e7\u05d8 \u05e9\u05de\u05d5\u05e4\u05d9\u05e2\u05d9\u05dd \u05dc\u05d0\u05d7\u05e8 \u05d4\u05ea\u05d7\u05dc\u05ea SSRI."
    },
    {
      "question": "\u05de\u05d3\u05d5\u05e2 \u05d1\u05de\u05e7\u05e8\u05d9\u05dd \u05de\u05e1\u05d5\u05d9\u05de\u05d9\u05dd \u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05e9\u05e0\u05d9\u05ea\u05e0\u05d5\u05ea \u05dc\u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd \u05e4\u05e2\u05dd \u05d1\u05d9\u05d5\u05dd (Once daily) \u05d7\u05d9\u05d9\u05d1\u05d5\u05ea \u05dc\u05d4\u05d9\u05e0\u05ea\u05df \u05dc\u05d9\u05dc\u05d3\u05d9\u05dd \u05d1\u05de\u05e0\u05d5\u05ea \u05de\u05e4\u05d5\u05e6\u05dc\u05d5\u05ea (Divided doses) \u05e9\u05dc 2-3 \u05e4\u05e2\u05de\u05d9\u05dd \u05d1\u05d9\u05d5\u05dd?",
      "answerOptions": [
        {
          "text": "\u05d1\u05e9\u05dc \u05de\u05d8\u05d1\u05d5\u05dc\u05d9\u05d6\u05dd \u05d5\u05d4\u05e4\u05e8\u05e9\u05d4 (Excretion) \u05de\u05d4\u05d9\u05e8\u05d9\u05dd \u05d9\u05d5\u05ea\u05e8, \u05d6\u05de\u05df \u05de\u05d7\u05e6\u05d9\u05ea \u05d4\u05d7\u05d9\u05d9\u05dd ($T_{1/2}$) \u05e9\u05dc \u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05e7\u05e6\u05e8 \u05d9\u05d5\u05ea\u05e8.",
          "isCorrect": true,
          "rationale": "\u05dc\u05d9\u05dc\u05d3\u05d9\u05dd \u05d9\u05e9 \u05e4\u05d9\u05e0\u05d5\u05d9 (Clearance) \u05de\u05d4\u05d9\u05e8 \u05d9\u05d5\u05ea\u05e8 \u05e9\u05dc \u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05d3\u05e8\u05da \u05d4\u05db\u05d1\u05d3 \u05d5\u05d4\u05db\u05dc\u05d9\u05d5\u05ea, \u05de\u05d4 \u05e9\u05de\u05e7\u05e6\u05e8 \u05d0\u05ea \u05d6\u05de\u05df \u05de\u05d7\u05e6\u05d9\u05ea \u05d4\u05d7\u05d9\u05d9\u05dd \u05d5\u05de\u05d7\u05d9\u05d9\u05d1 \u05e4\u05d9\u05e6\u05d5\u05dc \u05de\u05e0\u05d5\u05ea \u05dc\u05e9\u05de\u05d9\u05e8\u05d4 \u05e2\u05dc \u05e8\u05de\u05d4 \u05d9\u05e6\u05d9\u05d1\u05d4 (Dulcan p. 687; StahlKids p. 14)."
        },
        {
          "text": "\u05db\u05d3\u05d9 \u05dc\u05d4\u05e4\u05d7\u05d9\u05ea \u05d0\u05ea \u05d4\u05e2\u05d5\u05de\u05e1 \u05e2\u05dc \u05d4\u05db\u05dc\u05d9\u05d5\u05ea \u05e9\u05d0\u05d9\u05e0\u05df \u05de\u05e1\u05d5\u05d2\u05dc\u05d5\u05ea \u05dc\u05d4\u05ea\u05de\u05d5\u05d3\u05d3 \u05e2\u05dd \u05db\u05de\u05d5\u05ea \u05d2\u05d3\u05d5\u05dc\u05d4 \u05e9\u05dc \u05ea\u05e8\u05d5\u05e4\u05d4 \u05d1\u05d1\u05ea \u05d0\u05d7\u05ea.",
          "isCorrect": false,
          "rationale": "\u05d4\u05e1\u05d9\u05d1\u05d4 \u05d0\u05d9\u05e0\u05d4 \u05d0\u05d9-\u05e1\u05e4\u05d9\u05e7\u05d4 \u05db\u05dc\u05d9\u05ea\u05d9\u05ea \u05d0\u05dc\u05d0 \u05d3\u05d5\u05d5\u05e7\u05d0 \u05d9\u05e2\u05d9\u05dc\u05d5\u05ea \u05d2\u05d1\u05d5\u05d4\u05d4 \u05d9\u05d5\u05ea\u05e8 \u05e9\u05dc \u05d4\u05de\u05e2\u05e8\u05db\u05d5\u05ea \u05d1\u05e4\u05d9\u05e0\u05d5\u05d9 \u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 (Dulcan p. 687)."
        },
        {
          "text": "\u05db\u05d3\u05d9 \u05dc\u05de\u05e0\u05d5\u05e2 \u05e1\u05e4\u05d9\u05d2\u05d4 \u05de\u05d4\u05d9\u05e8\u05d4 \u05de\u05d3\u05d9 \u05d1\u05de\u05e2\u05d9 \u05d4\u05d3\u05e7 \u05e9\u05e2\u05dc\u05d5\u05dc\u05d4 \u05dc\u05d2\u05e8\u05d5\u05dd \u05dc\u05e8\u05e2\u05d9\u05dc\u05d5\u05ea \u05de\u05d9\u05d9\u05d3\u05d9\u05ea.",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05e9\u05e1\u05e4\u05d9\u05d2\u05d4 \u05e2\u05e9\u05d5\u05d9\u05d4 \u05dc\u05d4\u05d9\u05d5\u05ea \u05de\u05d4\u05d9\u05e8\u05d4, \u05e4\u05d9\u05e6\u05d5\u05dc \u05d4\u05de\u05e0\u05d5\u05ea \u05e0\u05d5\u05e2\u05d3 \u05dc\u05de\u05e0\u05d5\u05e2 \u05d9\u05e8\u05d9\u05d3\u05d4 \u05d7\u05d3\u05d4 \u05de\u05d3\u05d9 \u05d1\u05e8\u05de\u05d5\u05ea \u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 (Losing efficacy) \u05d1\u05d9\u05df \u05d4\u05de\u05e0\u05d5\u05ea \u05d1\u05e9\u05dc \u05de\u05d8\u05d1\u05d5\u05dc\u05d9\u05d6\u05dd \u05de\u05d4\u05d9\u05e8 (StahlKids p. 21, p. 275)."
        },
        {
          "text": "\u05de\u05db\u05d9\u05d5\u05d5\u05df \u05e9\u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d4\u05e7\u05d9\u05e9\u05d5\u05e8 \u05dc\u05d7\u05dc\u05d1\u05d5\u05e0\u05d9 \u05e4\u05dc\u05d6\u05de\u05d4 \u05d7\u05d6\u05e7 \u05d9\u05d5\u05ea\u05e8, \u05de\u05d4 \u05e9\u05de\u05e2\u05db\u05d1 \u05d0\u05ea \u05e9\u05d7\u05e8\u05d5\u05e8 \u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 \u05dc\u05e8\u05e7\u05de\u05d5\u05ea.",
          "isCorrect": false,
          "rationale": "\u05d1\u05e4\u05d5\u05e2\u05dc, \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d9\u05e9 \u05e4\u05d7\u05d5\u05ea \u05e7\u05d9\u05e9\u05d5\u05e8 \u05dc\u05d7\u05dc\u05d1\u05d5\u05e0\u05d9\u05dd, \u05de\u05d4 \u05e9\u05de\u05d5\u05ea\u05d9\u05e8 \u05d7\u05dc\u05e7 \u05d2\u05d3\u05d5\u05dc \u05d9\u05d5\u05ea\u05e8 \u05de\u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 \u05e4\u05e2\u05d9\u05dc \u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea (StahlKids p. 14)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d1\u05d5 \u05e2\u05dc \u05d4\u05de\u05d5\u05e9\u05d2 \u05d4\u05e4\u05e8\u05de\u05e7\u05d5\u05e7\u05d9\u05e0\u05d8\u05d9 \u05d4\u05de\u05ea\u05d0\u05e8 \u05d0\u05ea \u05e7\u05e6\u05d1 \u05d4\u05d9\u05e2\u05dc\u05de\u05d5\u05ea \u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 \u05de\u05d4\u05d3\u05dd."
    },
    {
      "question": "\u05de\u05d4\u05d9 \u05d4\u05d4\u05d2\u05d3\u05e8\u05d4 \u05d4\u05e0\u05db\u05d5\u05e0\u05d4 \u05e9\u05dc \u05e9\u05d9\u05de\u05d5\u05e9 'Off-label' \u05d1\u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05e8\u05d5\u05e4\u05d9\u05d5\u05ea \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd, \u05d5\u05de\u05d4\u05d9 \u05d4\u05de\u05d3\u05d9\u05e0\u05d9\u05d5\u05ea \u05d4\u05de\u05e7\u05d5\u05d1\u05dc\u05ea \u05dc\u05d2\u05d1\u05d9\u05d5 \u05dc\u05e4\u05d9 \u05d4\u05de\u05e7\u05d5\u05e8\u05d5\u05ea?",
      "answerOptions": [
        {
          "text": "\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05ea\u05e8\u05d5\u05e4\u05d4 \u05e9\u05dc\u05d0 \u05d0\u05d5\u05e9\u05e8\u05d4 \u05e8\u05e9\u05de\u05d9\u05ea \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d4-FDA \u05dc\u05d0\u05d5\u05db\u05dc\u05d5\u05e1\u05d9\u05d9\u05ea \u05d4\u05d9\u05dc\u05d3\u05d9\u05dd; \u05d6\u05d4\u05d5 \u05de\u05e6\u05d1 \u05e0\u05e4\u05d5\u05e5 \u05d4\u05e0\u05d7\u05e9\u05d1 \u05dc-'Best practice' \u05db\u05d0\u05e9\u05e8 \u05d4\u05d5\u05d0 \u05de\u05d1\u05d5\u05e1\u05e1 \u05e2\u05dc \u05e7\u05d5\u05d5\u05d9\u05dd \u05de\u05e0\u05d7\u05d9\u05dd \u05d5\u05de\u05d5\u05de\u05d7\u05d9\u05d5\u05ea.",
          "isCorrect": true,
          "rationale": "\u05de\u05e8\u05d1\u05d9\u05ea \u05d4\u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05de\u05e9\u05de\u05e9\u05d5\u05ea \u05db-Off-label \u05de\u05d7\u05d5\u05e1\u05e8 \u05d1\u05de\u05d7\u05e7\u05e8\u05d9\u05dd \u05e8\u05e9\u05de\u05d9\u05d9\u05dd \u05dc\u05d0\u05d9\u05e9\u05d5\u05e8 FDA, \u05d0\u05da \u05e9\u05d9\u05de\u05d5\u05e9 \u05d6\u05d4 \u05d7\u05d5\u05e7\u05d9 \u05d5\u05de\u05e7\u05d5\u05d1\u05dc \u05db\u05e1\u05d8\u05e0\u05d3\u05e8\u05d8 \u05d8\u05d9\u05e4\u05d5\u05dc\u05d9 (Dulcan p. 688; StahlKids p. 121)."
        },
        {
          "text": "\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05ea\u05e8\u05d5\u05e4\u05d4 \u05e9\u05d8\u05e8\u05dd \u05e2\u05d1\u05e8\u05d4 \u05e0\u05d9\u05e1\u05d5\u05d9\u05d9\u05dd \u05e7\u05dc\u05d9\u05e0\u05d9\u05d9\u05dd \u05d1\u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd \u05d5\u05dc\u05db\u05df \u05d4\u05d9\u05d0 '\u05e0\u05d9\u05e1\u05d9\u05d5\u05e0\u05d9\u05ea'.",
          "isCorrect": false,
          "rationale": "\u05de\u05e8\u05d1\u05d9\u05ea \u05d4\u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05d4\u05dc\u05dc\u05d5 \u05de\u05d0\u05d5\u05e9\u05e8\u05d5\u05ea \u05dc\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd \u05d0\u05da \u05d7\u05e1\u05e8\u05d5\u05ea \u05d0\u05d9\u05e9\u05d5\u05e8 \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9 \u05dc\u05d9\u05dc\u05d3\u05d9\u05dd (StahlKids p. 11)."
        },
        {
          "text": "\u05e9\u05d9\u05de\u05d5\u05e9 \u05d0\u05e1\u05d5\u05e8 \u05e2\u05dc \u05e4\u05d9 \u05d7\u05d5\u05e7 \u05e9\u05e2\u05dc\u05d5\u05dc \u05dc\u05d4\u05d5\u05d1\u05d9\u05dc \u05dc\u05e9\u05dc\u05d9\u05dc\u05ea \u05e8\u05d9\u05e9\u05d9\u05d5\u05df \u05d4\u05e8\u05d5\u05e4\u05d0 \u05d0\u05dd \u05d9\u05ea\u05d2\u05dc\u05d5 \u05ea\u05d5\u05e4\u05e2\u05d5\u05ea \u05dc\u05d5\u05d5\u05d0\u05d9.",
          "isCorrect": false,
          "rationale": "\u05d4-FDA \u05d0\u05d9\u05e0\u05d5 \u05de\u05d1\u05e7\u05e8 \u05d0\u05ea \u05e4\u05e8\u05e7\u05d8\u05d9\u05e7\u05ea \u05d4\u05e8\u05d9\u05e9\u05d5\u05dd \u05e9\u05dc \u05d4\u05e8\u05d5\u05e4\u05d0 \u05d5\u05d0\u05d9\u05e0\u05d5 \u05d0\u05d5\u05e1\u05e8 \u05e2\u05dc \u05e9\u05d9\u05de\u05d5\u05e9 \u05de\u05d7\u05d5\u05e5 \u05dc\u05d4\u05ea\u05d5\u05d5\u05d9\u05d4 (Dulcan p. 689)."
        },
        {
          "text": "\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05d2\u05e0\u05e8\u05d9\u05d5\u05ea \u05d1\u05dc\u05d1\u05d3 \u05e9\u05d0\u05d9\u05e0\u05df \u05e8\u05e9\u05d5\u05de\u05d5\u05ea \u05db\u05e1\u05d9\u05de\u05df \u05de\u05e1\u05d7\u05e8\u05d9 ($Trademark$).",
          "isCorrect": false,
          "rationale": "\u05d4\u05de\u05d5\u05e9\u05d2 Off-label \u05de\u05ea\u05d9\u05d9\u05d7\u05e1 \u05dc\u05d4\u05ea\u05d5\u05d5\u05d9\u05d4 \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9\u05ea (\u05d2\u05d9\u05dc, \u05d0\u05d1\u05d7\u05e0\u05d4, \u05de\u05d9\u05e0\u05d5\u05df) \u05d5\u05dc\u05d0 \u05dc\u05de\u05e2\u05de\u05d3 \u05d4\u05d2\u05e0\u05e8\u05d9 \u05e9\u05dc \u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 (Dulcan p. 688)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d1\u05d5 \u05e2\u05dc \u05d4\u05e7\u05e9\u05e8 \u05d1\u05d9\u05df \u05d4\u05d0\u05d9\u05e9\u05d5\u05e8 \u05d4\u05e8\u05e9\u05de\u05d9 \u05e9\u05dc \u05e8\u05e9\u05d5\u05d9\u05d5\u05ea \u05d4\u05d1\u05e8\u05d9\u05d0\u05d5\u05ea \u05dc\u05d1\u05d9\u05df \u05d4\u05e4\u05e8\u05e7\u05d8\u05d9\u05e7\u05d4 \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05d4\u05d9\u05d5\u05de\u05d9\u05d5\u05de\u05d9\u05ea."
    }
  ]
}