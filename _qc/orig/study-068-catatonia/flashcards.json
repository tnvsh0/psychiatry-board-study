  "cards": [
    {
      "front": "\u05e2\u05dc \u05e4\u05d9 \u05d4-DSM-5-TR, \u05db\u05de\u05d4 \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05de\u05ea\u05d5\u05da 12 \u05e0\u05d3\u05e8\u05e9\u05d9\u05dd \u05dc\u05d0\u05d1\u05d7\u05e0\u05ea \u05e7\u05d8\u05d8\u05d5\u05e0\u05d9\u05d4?",
