    },
    {
      "front": "\u05d1\u05d0\u05d9\u05d6\u05d5 \u05de\u05d7\u05dc\u05d4 \u05d0\u05d5\u05d8\u05d5\u05d0\u05d9\u05de\u05d5\u05e0\u05d9\u05ea \u05d4\u05de\u05d5\u05e4\u05d9\u05e2\u05d4 \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d9\u05e9 \u05dc\u05d7\u05e9\u05d5\u05d3 \u05db\u05d2\u05d5\u05e8\u05dd \u05dc\u05e7\u05d8\u05d8\u05d5\u05e0\u05d9\u05d4 \u05d0\u05e7\u05d5\u05d8\u05d9\u05ea \u05d4\u05de\u05dc\u05d5\u05d5\u05d4 \u05d1\u05d3\u05d9\u05e1\u05e7\u05d9\u05e0\u05d6\u05d9\u05d4 \u05e9\u05dc \u05d4\u05e4\u05d4 \u05d5\u05d4\u05e4\u05e0\u05d9\u05dd?",
      "back": "Anti-NMDA Receptor Encephalitis. (DSM p.134, Dulcan p.96, Dulcan p.370)"
    },
    {
      "front": "\u05d1\u05d0\u05d9\u05dc\u05d5 \u05de\u05e6\u05d1\u05d9\u05dd \u05e8\u05e4\u05d5\u05d0\u05d9\u05d9\u05dd \u05d9\u05e9 \u05dc\u05d7\u05e9\u05d5\u05d3 \u05d1-IEM (Inborn Errors of Metabolism) \u05db\u05d2\u05d5\u05e8\u05dd \u05dc\u05e7\u05d8\u05d8\u05d5\u05e0\u05d9\u05d4 \u05d1\u05d9\u05dc\u05d3?",
      "back": "\u05db\u05d0\u05e9\u05e8 \u05d4\u05e7\u05d8\u05d8\u05d5\u05e0\u05d9\u05d4 \u05d7\u05d5\u05d6\u05e8\u05ea \u05d0\u05d5 \u05de\u05d7\u05de\u05d9\u05e8\u05d4 \u05d1\u05e2\u05ea \u05e2\u05d5\u05de\u05e1 \u05e4\u05d9\u05d6\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9, \u05d7\u05d5\u05dd \u05d0\u05d5 \u05d4\u05e7\u05d0\u05d5\u05ea. (Dulcan p.124)"
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05de\u05d5\u05d2\u05d3\u05e8 \u05d4\u05ea\u05e1\u05de\u05d9\u05df **Catalepsy** \u05d1\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05e9\u05dc \u05d4-DSM-5-TR?",
      "back": "\u05d0\u05d9\u05de\u05d5\u05e5 \u05e4\u05e1\u05d9\u05d1\u05d9 \u05e9\u05dc \u05ea\u05e0\u05d5\u05d7\u05d4 \u05d4\u05de\u05d5\u05d7\u05d6\u05e7\u05ea \u05db\u05e0\u05d2\u05d3 \u05db\u05d5\u05d7 \u05d4\u05db\u05d1\u05d9\u05d3\u05d4. (DSM p.135)"
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05de\u05d5\u05d2\u05d3\u05e8 \u05d4\u05ea\u05e1\u05de\u05d9\u05df **Waxy flexibility** \u05d1\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05e9\u05dc \u05d4-DSM-5-TR?",
      "back": "\u05d4\u05ea\u05e0\u05d2\u05d3\u05d5\u05ea \u05e7\u05dc\u05d4 \u05d5\u05d0\u05d7\u05d9\u05d3\u05d4 \u05dc\u05e9\u05d9\u05e0\u05d5\u05d9 \u05ea\u05e0\u05d5\u05d7\u05d4 \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d4\u05d1\u05d5\u05d3\u05e7. (DSM p.135)"
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05e8\u05e6\u05d9\u05d5\u05e0\u05dc \u05d4\u05e0\u05d5\u05d9\u05e8\u05d5\u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05dc\u05d1\u05d9\u05e6\u05d5\u05e2 **Lorazepam Challenge Test**?",
      "back": "\u05d4\u05d2\u05d1\u05e8\u05ea \u05d4\u05e2\u05d9\u05db\u05d5\u05d1 \u05d4-GABA\u05e8\u05d2\u05d9 \u05dc\u05d1\u05d9\u05d8\u05d5\u05dc \u05d4\u05d3\u05d9\u05e1-\u05d0\u05d9\u05e0\u05d4\u05d9\u05d1\u05d9\u05e6\u05d9\u05d4 \u05d4\u05d2\u05dc\u05d5\u05d8\u05de\u05d8\u05e8\u05d2\u05d9\u05ea \u05d4\u05e2\u05d5\u05de\u05d3\u05ea \u05d1\u05d1\u05e1\u05d9\u05e1 \u05d4\u05ea\u05e1\u05de\u05d5\u05e0\u05ea. (StahlNeuro p.107)"
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05de\u05d9\u05e0\u05d5\u05df \u05d5\u05d4\u05d3\u05e8\u05da \u05d4\u05de\u05e7\u05d5\u05d1\u05dc\u05ea \u05dc\u05de\u05d1\u05d7\u05df \u05d0\u05ea\u05d2\u05e8 \u05e2\u05dd Lorazepam \u05d1\u05d0\u05d1\u05d7\u05d5\u05df \u05e7\u05d8\u05d8\u05d5\u05e0\u05d9\u05d4?",
      "back": "$1-2\\text{ mg}$ \u05d1\u05de\u05ea\u05df $IV$. (\u05de\u05e7\u05d5\u05e8: \u05d4\u05e7\u05e9\u05e8 \u05e8\u05d7\u05d1 / Hebrew Source)"
    },
    {
      "front": "\u05d0\u05d9\u05dc\u05d5 \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05de\u05d5\u05d8\u05d5\u05e8\u05d9\u05d9\u05dd \u05e0\u05dc\u05d5\u05d5\u05d9\u05dd \u05e2\u05e9\u05d5\u05d9\u05d9\u05dd \u05dc\u05d4\u05d7\u05de\u05d9\u05e8 \u05e7\u05d8\u05d8\u05d5\u05e0\u05d9\u05d4 \u05d1\u05e7\u05e8\u05d1 \u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd ASD?",
      "back": "\u05e2\u05dc\u05d9\u05d9\u05d4 \u05d1\u05e1\u05d8\u05e8\u05d9\u05d0\u05d5\u05d8\u05d9\u05e4\u05d9\u05d5\u05ea (Stereotypy) \u05d5\u05d4\u05d7\u05de\u05e8\u05d4 \u05e9\u05dc \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05e9\u05dc \u05e4\u05d2\u05d9\u05e2\u05d4 \u05e2\u05e6\u05de\u05d9\u05ea (Self-injurious behavior). (DSM p.63)"
    },
    {
      "front": "\u05d0\u05d9\u05d6\u05d4 \u05d1\u05d9\u05e8\u05d5\u05e8 \u05e0\u05d5\u05d9\u05e8\u05d5\u05dc\u05d5\u05d2\u05d9 \u05de\u05d7\u05d9\u05d9\u05d1 \u05de\u05e6\u05d1 \u05e9\u05dc \u05e1\u05d8\u05d5\u05e4\u05d5\u05e8 \u05e7\u05d8\u05d8\u05d5\u05e0\u05d9 \u05db\u05d3\u05d9 \u05dc\u05e9\u05dc\u05d5\u05dc NCSE (Nonconvulsive Status Epilepticus)?",
      "back": "\u05d1\u05d9\u05e8\u05d5\u05e8 \u05d0\u05dc\u05e7\u05d8\u05e8\u05d5\u05d0\u05e0\u05e6\u05e4\u05dc\u05d5\u05d2\u05e8\u05e4\u05d9 (EEG). (Dulcan p.96)"
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05e9\u05e0\u05d7\u05e9\u05d1 \u05db\u05e7\u05d5 \u05e9\u05e0\u05d9 \u05d1\u05de\u05d9\u05d3\u05d4 \u05d5\u05d0\u05d9\u05df \u05ea\u05d2\u05d5\u05d1\u05d4 \u05dc-Lorazepam?",
      "back": "\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05e0\u05d6\u05e2\u05d9 \u05d7\u05e9\u05de\u05dc (ECT). (\u05de\u05e7\u05d5\u05e8: \u05d4\u05e7\u05e9\u05e8 \u05e8\u05d7\u05d1 / Hebrew Source)"
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05de\u05d5\u05d2\u05d3\u05e8 \u05d4\u05ea\u05e1\u05de\u05d9\u05df **Negativism** \u05d1\u05e7\u05d8\u05d8\u05d5\u05e0\u05d9\u05d4?",
      "back": "\u05d4\u05ea\u05e0\u05d2\u05d3\u05d5\u05ea \u05d0\u05d5 \u05d7\u05d5\u05e1\u05e8 \u05ea\u05d2\u05d5\u05d1\u05d4 \u05dc\u05d4\u05d5\u05e8\u05d0\u05d5\u05ea \u05d0\u05d5 \u05dc\u05d2\u05d9\u05e8\u05d5\u05d9\u05d9\u05dd \u05d7\u05d9\u05e6\u05d5\u05e0\u05d9\u05d9\u05dd. (DSM p.135)"
    },
    {
      "front": "\u05de\u05d4\u05df \u05d4\u05d0\u05d1\u05d7\u05e0\u05d5\u05ea \u05d4\u05d0\u05e4\u05e9\u05e8\u05d9\u05d5\u05ea \u05dc\u05e7\u05d8\u05d8\u05d5\u05e0\u05d9\u05d4 \u05d1-DSM-5-TR (\u05dc\u05dc\u05d0 \u05e7\u05e9\u05e8 \u05dc\u05d4\u05e4\u05e8\u05e2\u05d4 \u05d4\u05e0\u05dc\u05d5\u05d5\u05d9\u05ea)?",
      "back": "\u05e7\u05d8\u05d8\u05d5\u05e0\u05d9\u05d4 \u05d4\u05e0\u05dc\u05d5\u05d5\u05d9\u05ea \u05dc\u05d4\u05e4\u05e8\u05e2\u05d4 \u05e0\u05e4\u05e9\u05d9\u05ea \u05d0\u05d7\u05e8\u05ea, \u05d4\u05e4\u05e8\u05e2\u05d4 \u05e7\u05d8\u05d8\u05d5\u05e0\u05d9\u05ea \u05e2\u05e7\u05d1 \u05de\u05e6\u05d1 \u05e8\u05e4\u05d5\u05d0\u05d9 \u05d0\u05d7\u05e8, \u05d0\u05d5 \u05e7\u05d8\u05d8\u05d5\u05e0\u05d9\u05d4 \u05dc\u05d0 \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05ea (Unspecified). (DSM p.135)"
    },
    {
      "front": "\u05d1\u05d0\u05d9\u05d6\u05d5 \u05d0\u05d5\u05db\u05dc\u05d5\u05e1\u05d9\u05d9\u05ea \u05d9\u05dc\u05d3\u05d9\u05dd \u05e7\u05d9\u05d9\u05de\u05ea \u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d2\u05d1\u05d5\u05d4\u05d4 \u05d9\u05d5\u05ea\u05e8 \u05e9\u05dc \u05e7\u05d8\u05d8\u05d5\u05e0\u05d9\u05d4 \u05de\u05dc\u05d1\u05d3 ASD?",
      "back": "\u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd \u05de\u05d5\u05d2\u05d1\u05dc\u05d5\u05ea \u05e9\u05db\u05dc\u05d9\u05ea \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9\u05ea (ID), \u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05e0\u05d5\u05d9\u05e8\u05d5-\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9\u05d5\u05ea \u05de\u05d5\u05e8\u05db\u05d1\u05d5\u05ea, \u05d0\u05d5 \u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4 \u05e9\u05dc \u05d8\u05e8\u05d0\u05d5\u05de\u05d4 \u05e0\u05e4\u05e9\u05d9\u05ea \u05e7\u05e9\u05d4. (DSM p.96, Dulcan p.124)"
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05de\u05e9\u05de\u05e2\u05d5\u05ea \u05d4\u05e4\u05e8\u05d5\u05d2\u05e0\u05d5\u05e1\u05d8\u05d9\u05ea \u05e9\u05dc \u05d4\u05d5\u05e4\u05e2\u05ea \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e7\u05d8\u05d8\u05d5\u05e0\u05d9\u05d9\u05dd \u05d1\u05e1\u05db\u05d9\u05d6\u05d5\u05e4\u05e8\u05e0\u05d9\u05d4 \u05e9\u05dc \u05d2\u05d9\u05dc \u05d4\u05d4\u05ea\u05d1\u05d2\u05e8\u05d5\u05ea (EOS)?",
      "back": "\u05de\u05d3\u05d3 \u05dc\u05d7\u05d5\u05de\u05e8\u05d4 \u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05d5\u05dc\u05e0\u05e1\u05d9\u05d2\u05d4 \u05ea\u05e4\u05e7\u05d5\u05d3\u05d9\u05ea \u05e7\u05e9\u05d4. (DSM p.118, Dulcan p.391)"
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4-ICD-10-CM code \u05e2\u05d1\u05d5\u05e8 \u05e7\u05d8\u05d8\u05d5\u05e0\u05d9\u05d4 (\u05d1\u05db\u05dc \u05d4\u05e1\u05d9\u05d5\u05d5\u05d2\u05d9\u05dd \u05d1-DSM)?",
      "back": "F06.1. (DSM p.135)"
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05d4\u05d1\u05d3\u05dc \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05d1\u05d9\u05df \u05d0\u05d5\u05d1\u05d3\u05df \u05d6\u05d9\u05db\u05e8\u05d5\u05df \u05d1-Dissociative Amnesia \u05dc\u05d1\u05d9\u05df Mutism \u05d1\u05e1\u05d8\u05d5\u05e4\u05d5\u05e8 \u05e7\u05d8\u05d8\u05d5\u05e0\u05d9?",
      "back": "\u05d1\u05e7\u05d8\u05d8\u05d5\u05e0\u05d9\u05d4 \u05d7\u05d5\u05e1\u05e8 \u05d4\u05d6\u05d9\u05db\u05e8\u05d5\u05df \u05de\u05d5\u05d2\u05d1\u05dc \u05e8\u05e7 \u05dc\u05de\u05e9\u05da \u05d4\u05d0\u05e4\u05d9\u05d6\u05d5\u05d3\u05d4 \u05d4\u05e7\u05d8\u05d8\u05d5\u05e0\u05d9\u05ea \u05e2\u05e6\u05de\u05d4. (DSM p.337)"
