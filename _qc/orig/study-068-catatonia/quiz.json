{
  "title": "Catatonia Quiz",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\u05de\u05ea\u05d1\u05d2\u05e8 \u05d1\u05df 16 \u05e2\u05dd ASD \u05de\u05d5\u05d1\u05d0 \u05dc\u05d4\u05e2\u05e8\u05db\u05d4 \u05d3\u05d7\u05d5\u05e4\u05d4 \u05d1\u05e9\u05dc \u05d9\u05e8\u05d9\u05d3\u05d4 \u05e0\u05d9\u05db\u05e8\u05ea \u05d1\u05ea\u05e4\u05e7\u05d5\u05d3. \u05d1\u05d1\u05d3\u05d9\u05e7\u05d4 \u05e0\u05e6\u05e4\u05d5 \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9\u05dd \u05d4\u05d1\u05d0\u05d9\u05dd: \u05d0\u05d9\u05dc\u05de\u05d5\u05ea (Mutism), \u05d4\u05ea\u05e0\u05d2\u05d3\u05d5\u05ea \u05e4\u05e1\u05d9\u05d1\u05d9\u05ea \u05dc\u05d4\u05d5\u05e8\u05d0\u05d5\u05ea (Negativism), \u05d5\u05d0\u05d7\u05d6\u05e7\u05d4 \u05d0\u05e7\u05d8\u05d9\u05d1\u05d9\u05ea \u05e9\u05dc \u05ea\u05e0\u05d5\u05d7\u05d5\u05ea \u05d2\u05d5\u05e3 \u05d7\u05e8\u05d9\u05d2\u05d5\u05ea \u05db\u05e0\u05d2\u05d3 \u05db\u05d5\u05d7 \u05d4\u05db\u05d5\u05d1\u05d3 (Posturing). \u05e2\u05dc \u05e4\u05d9 \u05d4-DSM-5-TR, \u05de\u05d4\u05d5 \u05e1\u05e3 \u05d4\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05d4\u05de\u05d9\u05e0\u05d9\u05de\u05dc\u05d9 \u05d4\u05e0\u05d3\u05e8\u05e9 \u05dc\u05d4\u05d2\u05d3\u05e8\u05ea \u05d4\u05de\u05d5\u05e4\u05e2 \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9 \u05db\u05ea\u05e1\u05de\u05d5\u05e0\u05ea \u05e7\u05d8\u05d8\u05d5\u05e0\u05d9\u05ea?",
      "answerOptions": [
        {
          "text": "\u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05e9\u05dc \u05dc\u05e4\u05d7\u05d5\u05ea 3 \u05de\u05ea\u05d5\u05da 12 \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9\u05dd \u05d4\u05e4\u05e1\u05d9\u05db\u05d5\u05de\u05d5\u05d8\u05d5\u05e8\u05d9\u05d9\u05dd \u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d0\u05dc\u05d9\u05d9\u05dd.",
          "isCorrect": true,
          "rationale": "\u05dc\u05e4\u05d9 \u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05d1-DSM-5-TR, \u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc \u05e7\u05d8\u05d8\u05d5\u05e0\u05d9\u05d4 \u05de\u05d7\u05d9\u05d9\u05d1\u05ea \u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05e9\u05dc 3 \u05dc\u05e4\u05d7\u05d5\u05ea \u05de\u05ea\u05d5\u05da 12 \u05d4\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05d4\u05de\u05d5\u05d2\u05d3\u05e8\u05d9\u05dd (DSM p.135)."
        },
        {
          "text": "\u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05e9\u05dc \u05dc\u05e4\u05d7\u05d5\u05ea 5 \u05de\u05ea\u05d5\u05da 12 \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9\u05dd \u05d4\u05e4\u05e1\u05d9\u05db\u05d5\u05de\u05d5\u05d8\u05d5\u05e8\u05d9\u05d9\u05dd \u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d0\u05dc\u05d9\u05d9\u05dd.",
          "isCorrect": false,
          "rationale": "\u05e1\u05e3 \u05d6\u05d4 \u05d0\u05d9\u05e0\u05d5 \u05ea\u05d5\u05d0\u05dd \u05d0\u05ea \u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05d4\u05d0\u05d1\u05d7\u05e0\u05ea\u05d9\u05d9\u05dd \u05d4\u05e2\u05d3\u05db\u05e0\u05d9\u05d9\u05dd, \u05d4\u05d3\u05d5\u05e8\u05e9\u05d9\u05dd \u05de\u05e1\u05e4\u05e8 \u05e0\u05de\u05d5\u05da \u05d9\u05d5\u05ea\u05e8 \u05e9\u05dc \u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd (DSM p.135)."
        },
        {
          "text": "\u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05e9\u05dc \u05dc\u05e4\u05d7\u05d5\u05ea 2 \u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9\u05dd, \u05d1\u05ea\u05e0\u05d0\u05d9 \u05e9\u05d0\u05d7\u05d3 \u05de\u05d4\u05dd \u05d4\u05d5\u05d0 Stupor \u05d0\u05d5 Mutism.",
          "isCorrect": false,
          "rationale": "\u05d4-DSM \u05d0\u05d9\u05e0\u05d5 \u05de\u05d2\u05d3\u05d9\u05e8 \u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05dd '\u05dc\u05d9\u05d1\u05d4' \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9 \u05d4\u05e0\u05d3\u05e8\u05e9 \u05dc\u05d0\u05d1\u05d7\u05e0\u05d4, \u05d0\u05dc\u05d0 \u05d3\u05d5\u05e8\u05e9 \u05d4\u05e6\u05d8\u05d1\u05e8\u05d5\u05ea \u05e9\u05dc 3 \u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9\u05dd \u05db\u05dc\u05e9\u05d4\u05dd \u05de\u05d4\u05e8\u05e9\u05d9\u05de\u05d4 (DSM p.135)."
        },
        {
          "text": "\u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05e9\u05dc \u05dc\u05e4\u05d7\u05d5\u05ea 3 \u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9\u05dd, \u05d0\u05da \u05d5\u05e8\u05e7 \u05d0\u05dd \u05e0\u05e9\u05dc\u05dc\u05d4 \u05d4\u05e4\u05e8\u05e2\u05d4 \u05e0\u05d5\u05d9\u05e8\u05d5-\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9\u05ea \u05d1\u05e8\u05e7\u05e2.",
          "isCorrect": false,
          "rationale": "\u05e7\u05d8\u05d8\u05d5\u05e0\u05d9\u05d4 \u05d9\u05db\u05d5\u05dc\u05d4 \u05dc\u05d4\u05d9\u05e0\u05ea\u05df \u05db-Specifier \u05d2\u05dd \u05d1\u05e0\u05d5\u05db\u05d7\u05d5\u05ea ASD \u05d0\u05d5 \u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05e0\u05d5\u05d9\u05e8\u05d5-\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9\u05d5\u05ea \u05d0\u05d7\u05e8\u05d5\u05ea (DSM p.135)."
        }
      ],
      "hint": "\u05d1\u05d3\u05d5\u05e7 \u05d0\u05ea \u05de\u05e1\u05e4\u05e8 \u05d4\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05d4\u05de\u05d5\u05e4\u05d9\u05e2 \u05ea\u05d7\u05ea \u05d4\u05db\u05d5\u05ea\u05e8\u05ea \u05e9\u05dc 12 \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9\u05dd \u05d4\u05e4\u05e1\u05d9\u05db\u05d5\u05de\u05d5\u05d8\u05d5\u05e8\u05d9\u05d9\u05dd \u05d1-DSM.",
      "covered": [
        "DSM-5-TR Catatonia Criteria"
      ]
    },
    {
      "type": "multiple_choice",
      "question": "\u05e0\u05e2\u05e8\u05d4 \u05d1\u05ea 14 \u05de\u05e6\u05d9\u05d2\u05d4 \u05d0\u05e4\u05d9\u05d6\u05d5\u05d3\u05d4 \u05d3\u05d9\u05db\u05d0\u05d5\u05e0\u05d9\u05ea \u05e7\u05e9\u05d4 \u05d4\u05de\u05dc\u05d5\u05d5\u05d4 \u05d1\u05e1\u05d8\u05d5\u05e4\u05d5\u05e8 \u05e7\u05d8\u05d8\u05d5\u05e0\u05d9. \u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05d0\u05e9\u05e4\u05d5\u05d6 \u05de\u05d5\u05e4\u05d9\u05e2\u05d4 \u05d0\u05d9-\u05d9\u05e6\u05d9\u05d1\u05d5\u05ea \u05d0\u05d5\u05d8\u05d5\u05e0\u05d5\u05de\u05d9\u05ea \u05d1\u05d5\u05dc\u05d8\u05ea, \u05d3\u05d5\u05e4\u05e7 \u05e9\u05dc $125~bpm$, \u05d7\u05d5\u05dd \u05d2\u05d5\u05e3 \u05e9\u05dc $39.8^{\\circ}C$ \u05d5\u05e0\u05d5\u05e7\u05e9\u05d5\u05ea \u05e9\u05e8\u05d9\u05e8\u05d9\u05dd \u05e7\u05d9\u05e6\u05d5\u05e0\u05d9\u05ea. \u05de\u05d4\u05d5 \u05d4\u05e6\u05e2\u05d3 \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc\u05d9 \u05d4\u05d3\u05d7\u05d5\u05e3 \u05d5\u05d4\u05d9\u05e2\u05d9\u05dc \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d4\u05de\u05d5\u05de\u05dc\u05e5 \u05d1\u05de\u05e6\u05d1 \u05d6\u05d4 \u05e2\u05dc \u05e4\u05d9 \u05d4\u05de\u05e7\u05d5\u05e8\u05d5\u05ea \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9\u05d9\u05dd?",
      "answerOptions": [
        {
          "text": "\u05de\u05ea\u05df \u05d3\u05d7\u05d5\u05e3 \u05e9\u05dc ECT (Electroconvulsive Therapy).",
          "isCorrect": true,
          "rationale": "\u05d1\u05de\u05e6\u05d1\u05d9\u05dd \u05e9\u05dc Malignant Catatonia \u05e2\u05dd \u05d0\u05d9-\u05d9\u05e6\u05d9\u05d1\u05d5\u05ea \u05d0\u05d5\u05d8\u05d5\u05e0\u05d5\u05de\u05d9\u05ea \u05d5\u05d7\u05d5\u05dd \u05d2\u05d1\u05d5\u05d4, ECT \u05e0\u05d7\u05e9\u05d1 \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05e7\u05d5 \u05e9\u05e0\u05d9 \u05d3\u05d7\u05d5\u05e3 \u05d5\u05de\u05e6\u05d9\u05dc \u05d7\u05d9\u05d9\u05dd \u05e9\u05d9\u05e9 \u05dc\u05e9\u05e7\u05d5\u05dc \u05dc\u05dc\u05d0 \u05e9\u05d9\u05d4\u05d5\u05d9 (Dulcan p.434, Syllabus p.32)."
        },
        {
          "text": "\u05d4\u05d5\u05e1\u05e4\u05ea \u05e0\u05d5\u05d2\u05d3 \u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d4 \u05d1\u05de\u05d9\u05e0\u05d5\u05df \u05d2\u05d1\u05d5\u05d4 (\u05db\u05d2\u05d5\u05df Haloperidol) \u05dc\u05e9\u05dc\u05d9\u05d8\u05d4 \u05d1\u05d0\u05d2\u05d9\u05d8\u05e6\u05d9\u05d4.",
          "isCorrect": false,
          "rationale": "\u05d9\u05e9 \u05dc\u05d4\u05d9\u05de\u05e0\u05e2 \u05de\u05de\u05ea\u05df \u05e0\u05d5\u05d2\u05d3\u05d9 \u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d4 \u05d1\u05e9\u05dc\u05d1 \u05d4\u05d7\u05e8\u05d9\u05e3 \u05e9\u05dc \u05e7\u05d8\u05d8\u05d5\u05e0\u05d9\u05d4, \u05d1\u05de\u05d9\u05d5\u05d7\u05d3 \u05db\u05e9\u05d9\u05e9 \u05d7\u05e9\u05d3 \u05dc-Malignant Catatonia, \u05d1\u05e9\u05dc \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05d4\u05d7\u05de\u05e8\u05d4 \u05d5\u05e7\u05d9\u05e8\u05d1\u05d4 \u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05dc-NMS (DSM p.136, StahlKids p.166)."
        },
        {
          "text": "\u05d4\u05e2\u05dc\u05d0\u05ea \u05de\u05d9\u05e0\u05d5\u05df \u05d4-Lorazepam \u05dc-$2~mg$ \u05e4\u05e2\u05dd \u05d1\u05d9\u05d5\u05dd \u05d1\u05dc\u05d1\u05d3.",
          "isCorrect": false,
          "rationale": "\u05d1\u05de\u05e7\u05e8\u05d9\u05dd \u05e7\u05e9\u05d9\u05dd \u05e9\u05dc \u05e7\u05d8\u05d8\u05d5\u05e0\u05d9\u05d4 \u05e0\u05d3\u05e8\u05e9\u05d9\u05dd \u05de\u05d9\u05e0\u05d5\u05e0\u05d9\u05dd \u05d9\u05d5\u05de\u05d9\u05d9\u05dd \u05d2\u05d1\u05d5\u05d4\u05d9\u05dd \u05d1\u05d4\u05e8\u05d1\u05d4 \u05e9\u05dc $8-24~mg$ \u05dc\u05d9\u05d5\u05dd, \u05d5\u05de\u05d9\u05e0\u05d5\u05df \u05e4\u05e2\u05dd \u05d1\u05d9\u05d5\u05dd \u05d0\u05d9\u05e0\u05d5 \u05de\u05e1\u05e4\u05e7 \u05dc\u05de\u05e6\u05d1 \u05d7\u05d9\u05e8\u05d5\u05dd \u05db\u05d6\u05d4 (Dulcan p.488)."
        },
        {
          "text": "\u05de\u05ea\u05df Dantrolene \u05d1\u05dc\u05d1\u05d3 \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05e0\u05d5\u05e7\u05e9\u05d5\u05ea \u05d4\u05e9\u05e8\u05d9\u05e8\u05d9\u05dd.",
          "isCorrect": false,
          "rationale": "Dantrolene \u05e2\u05e9\u05d5\u05d9 \u05dc\u05e2\u05d6\u05d5\u05e8 \u05d1\u05e0\u05d5\u05e7\u05e9\u05d5\u05ea \u05d0\u05da \u05d0\u05d9\u05e0\u05d5 \u05de\u05d8\u05e4\u05dc \u05d1\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05d1\u05e1\u05d9\u05e1\u05d9 \u05e9\u05dc \u05d4\u05e7\u05d8\u05d8\u05d5\u05e0\u05d9\u05d4 \u05e2\u05e6\u05de\u05d4 \u05db\u05e4\u05d9 \u05e9\u05e2\u05d5\u05e9\u05d9\u05dd Lorazepam \u05d0\u05d5 ECT (StahlNeuro p.107, Dulcan p.434)."
        }
      ],
      "hint": "\u05d4\u05ea\u05d9\u05d9\u05d7\u05e1 \u05dc\u05de\u05e6\u05d1\u05d9 \u05d7\u05d9\u05e8\u05d5\u05dd \u05d4\u05de\u05e2\u05e8\u05d1\u05d9\u05dd Hyperpyrexia \u05d5\u05d0\u05d9-\u05d9\u05e6\u05d9\u05d1\u05d5\u05ea \u05d0\u05d5\u05d8\u05d5\u05e0\u05d5\u05de\u05d9\u05ea.",
      "covered": [
        "Treatment of Malignant Catatonia",
        "ECT Indications"
      ]
    },
    {
      "type": "multiple_select",
      "question": "\u05d1\u05d1\u05d9\u05e8\u05d5\u05e8 \u05d0\u05d8\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05e9\u05dc \u05e7\u05d8\u05d8\u05d5\u05e0\u05d9\u05d4 \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d5\u05e0\u05d5\u05e2\u05e8, \u05d0\u05d9\u05dc\u05d5 \u05de\u05d4\u05de\u05e6\u05d1\u05d9\u05dd \u05d4\u05e8\u05e4\u05d5\u05d0\u05d9\u05d9\u05dd \u05d4\u05d1\u05d0\u05d9\u05dd \u05de\u05d7\u05d9\u05d9\u05d1\u05d9\u05dd \u05d4\u05ea\u05d9\u05d9\u05d7\u05e1\u05d5\u05ea \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05ea \u05d5\u05d4\u05e2\u05e8\u05db\u05d4 \u05d1\u05de\u05e2\u05d1\u05d3\u05d4 \u05d0\u05d5 \u05d1\u05d0\u05de\u05e6\u05e2\u05d9 \u05d3\u05d9\u05de\u05d5\u05ea \u05e2\u05dc \u05e4\u05d9 \u05d4\u05de\u05e7\u05d5\u05e8\u05d5\u05ea?",
      "answerOptions": [
        {
          "text": "\u05d0\u05e0\u05e6\u05e4\u05dc\u05d9\u05d8\u05d9\u05e1 \u05d0\u05d5\u05d8\u05d5\u05d0\u05d9\u05de\u05d5\u05e0\u05d9\u05ea (\u05db\u05d2\u05d5\u05df Anti-NMDA Receptor Encephalitis).",
          "isCorrect": true,
          "rationale": "\u05de\u05d7\u05dc\u05d4 \u05d6\u05d5 \u05de\u05e6\u05d9\u05d2\u05d4 \u05de\u05d5\u05e4\u05e2 \u05d0\u05e7\u05d5\u05d8\u05d9 \u05e9\u05dc \u05e7\u05d8\u05d8\u05d5\u05e0\u05d9\u05d4 \u05d5\u05d3\u05d9\u05e1\u05e7\u05d9\u05e0\u05d6\u05d9\u05d5\u05ea \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d5\u05de\u05d7\u05d9\u05d9\u05d1\u05ea \u05d1\u05d9\u05e8\u05d5\u05e8 \u05e0\u05d5\u05d9\u05e8\u05d5\u05dc\u05d5\u05d2\u05d9 \u05de\u05e7\u05d9\u05e3 (DSM p.134, Dulcan p.370)."
        },
        {
          "text": "\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05de\u05d8\u05d1\u05d5\u05dc\u05d9\u05d5\u05ea \u05de\u05d5\u05dc\u05d3\u05d5\u05ea (Inborn Errors of Metabolism - IEM).",
          "isCorrect": true,
          "rationale": "\u05d9\u05e9 \u05dc\u05d7\u05e9\u05d5\u05d3 \u05d1-IEM \u05d1\u05db\u05dc \u05d9\u05dc\u05d3 \u05e2\u05dd \u05e7\u05d8\u05d8\u05d5\u05e0\u05d9\u05d4 \u05d4\u05d7\u05d5\u05d6\u05e8\u05ea \u05d0\u05d5 \u05de\u05d5\u05d7\u05de\u05e8\u05ea \u05d1\u05e2\u05ea \u05e2\u05d5\u05de\u05e1 \u05e4\u05d9\u05d6\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d0\u05d5 \u05d7\u05d5\u05dd (Dulcan p.124)."
        },
        {
          "text": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d0\u05e4\u05d9\u05dc\u05e4\u05d8\u05d9\u05e7\u05d5\u05e1 \u05dc\u05d0-\u05e4\u05e8\u05db\u05d5\u05e1\u05d9 (Nonconvulsive Status Epilepticus - NCSE).",
          "isCorrect": true,
          "rationale": "NCSE \u05e2\u05dc\u05d5\u05dc \u05dc\u05d4\u05ea\u05d9\u05d9\u05e6\u05d2 \u05db\u05e1\u05d8\u05d5\u05e4\u05d5\u05e8 \u05e7\u05d8\u05d8\u05d5\u05e0\u05d9 \u05d5\u05de\u05d7\u05d9\u05d9\u05d1 \u05d1\u05d9\u05e8\u05d5\u05e8 \u05d0\u05dc\u05e7\u05d8\u05e8\u05d5\u05d0\u05e0\u05e6\u05e4\u05dc\u05d5\u05d2\u05e8\u05e4\u05d9 (EEG) \u05dc\u05d0\u05d1\u05d7\u05e0\u05d4 \u05de\u05d1\u05d3\u05dc\u05ea (Dulcan p.96)."
        },
        {
          "text": "\u05d4\u05e4\u05e8\u05e2\u05ea \u05d7\u05e8\u05d3\u05d4 \u05d7\u05d1\u05e8\u05ea\u05d9\u05ea (Social Anxiety Disorder) \u05e4\u05e9\u05d5\u05d8\u05d4.",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05e9\u05d7\u05e8\u05d3\u05d4 \u05e7\u05d9\u05d9\u05de\u05ea, \u05d4\u05d9\u05d0 \u05d0\u05d9\u05e0\u05d4 \u05e0\u05d7\u05e9\u05d1\u05ea \u05dc\u05d2\u05d5\u05e8\u05dd \u05e8\u05e4\u05d5\u05d0\u05d9/\u05d0\u05d5\u05e8\u05d2\u05e0\u05d9 \u05d9\u05e9\u05d9\u05e8 \u05dc\u05e7\u05d8\u05d8\u05d5\u05e0\u05d9\u05d4 \u05db\u05e4\u05d9 \u05e9\u05de\u05d5\u05d2\u05d3\u05e8 \u05ea\u05d7\u05ea 'Catatonic Disorder Due to Another Medical Condition' (DSM p.136)."
        }
      ],
      "hint": "\u05d7\u05e4\u05e9 \u05de\u05e6\u05d1\u05d9\u05dd \u05e0\u05d5\u05d9\u05e8\u05d5\u05dc\u05d5\u05d2\u05d9\u05d9\u05dd \u05d5\u05de\u05d8\u05d1\u05d5\u05dc\u05d9\u05d9\u05dd \u05d4\u05de\u05d5\u05e4\u05d9\u05e2\u05d9\u05dd \u05ea\u05d7\u05ea \u05d4\u05d2\u05d5\u05e8\u05de\u05d9\u05dd \u05d4\u05d0\u05d5\u05e8\u05d2\u05e0\u05d9\u05d9\u05dd \u05d1-DSM \u05d5\u05d1-Dulcan.",
      "covered": [
        "Medical Etiologies of Catatonia",
        "Differential Diagnosis"
      ],
      "hasAllOfTheAbove": false,
      "hasNoneOfTheAbove": false
    },
    {
      "type": "fill_in_the_blank",
      "question": "\u05d1\u05de\u05d4\u05dc\u05da \u05d1\u05d9\u05e6\u05d5\u05e2 Lorazepam Challenge Test, \u05d4\u05e9\u05d9\u05e4\u05d5\u05e8 \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9 \u05d4\u05d3\u05e8\u05de\u05d8\u05d9 \u05d1\u05e1\u05d9\u05de\u05e0\u05d9\u05dd \u05d4\u05e7\u05d8\u05d8\u05d5\u05e0\u05d9\u05d9\u05dd (\u05db\u05d2\u05d5\u05df \u05d4\u05ea\u05e8\u05ea \u05d4\u05e1\u05d8\u05d5\u05e4\u05d5\u05e8 \u05d0\u05d5 \u05d9\u05e8\u05d9\u05d3\u05d4 \u05d1\u05e0\u05d5\u05e7\u05e9\u05d5\u05ea) \u05e6\u05e4\u05d5\u05d9 \u05dc\u05d4\u05d5\u05e4\u05d9\u05e2 \u05d1\u05ea\u05d5\u05da \u05d7\u05dc\u05d5\u05df \u05d6\u05de\u05df \u05e9\u05dc ___ \u05d3\u05e7\u05d5\u05ea \u05de\u05e8\u05d2\u05e2 \u05de\u05ea\u05df \u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 \u05d1\u05e2\u05d9\u05e8\u05d5\u05d9 \u05ea\u05d5\u05da-\u05d5\u05e8\u05d9\u05d3\u05d9 (IV).",
      "bestAnswer": "15-30",
      "acceptableAnswers": [
        "15 \u05e2\u05d3 30",
        "15-30 minutes"
      ],
      "rationale": "\u05e2\u05dc \u05e4\u05d9 \u05d4\u05e4\u05e8\u05d5\u05d8\u05d5\u05e7\u05d5\u05dc \u05d4\u05de\u05d5\u05e4\u05d9\u05e2 \u05d1-Dulcan, \u05ea\u05d2\u05d5\u05d1\u05d4 \u05d7\u05d9\u05d5\u05d1\u05d9\u05ea \u05dc\u05de\u05d1\u05d7\u05df \u05d4\u05d0\u05ea\u05d2\u05e8 \u05de\u05d6\u05d5\u05d4\u05d4 \u05d1\u05ea\u05d5\u05da 15 \u05e2\u05d3 30 \u05d3\u05e7\u05d5\u05ea \u05de\u05d4\u05de\u05ea\u05df \u05d4\u05d5\u05e8\u05d9\u05d3\u05d9 \u05d5\u05de\u05d0\u05e9\u05e8\u05ea \u05d0\u05ea \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 (Dulcan p.488).",
      "hint": "\u05d4\u05ea\u05d9\u05d9\u05d7\u05e1 \u05dc\u05d7\u05dc\u05d5\u05df \u05d4\u05d6\u05de\u05e0\u05d9\u05dd \u05d4\u05de\u05d4\u05d9\u05e8 \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05d0\u05ea \u05d4\u05de\u05e2\u05e0\u05d4 \u05d4\u05d5\u05e8\u05d9\u05d3\u05d9 \u05d1\u05ea\u05d1\u05d7\u05d9\u05df \u05d4\u05d0\u05ea\u05d2\u05e8."
    },
    {
      "type": "multiple_choice",
      "question": "\u05e2\u05dc \u05e4\u05d9 \u05d4\u05ea\u05d9\u05d0\u05d5\u05e8\u05d9\u05d4 \u05d4\u05e0\u05d5\u05d9\u05e8\u05d5\u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea \u05d4\u05de\u05d5\u05e6\u05d2\u05ea \u05d1-StahlNeuro, \u05de\u05d4\u05d5 \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05d4\u05de\u05d5\u05e0\u05d7 \u05d1\u05d9\u05e1\u05d5\u05d3 \u05d4\u05ea\u05e1\u05de\u05d5\u05e0\u05ea \u05d4\u05e7\u05d8\u05d8\u05d5\u05e0\u05d9\u05ea \u05d5\u05d4\u05ea\u05d2\u05d5\u05d1\u05d4 \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05d1\u05e0\u05d6\u05d5\u05d3\u05d9\u05d0\u05d6\u05e4\u05d9\u05e0\u05d9\u05dd?",
      "answerOptions": [
        {
          "text": "\u05d3\u05d9\u05e1-\u05d0\u05d9\u05e0\u05d4\u05d9\u05d1\u05d9\u05e6\u05d9\u05d4 \u05d2\u05dc\u05d5\u05d8\u05de\u05d8\u05e8\u05d2\u05d9\u05ea \u05d4\u05e0\u05d5\u05d1\u05e2\u05ea \u05de\u05d7\u05e1\u05e8 \u05d1\u05e2\u05d9\u05db\u05d5\u05d1 GABA\u05e8\u05d2\u05d9 \u05d1\u05de\u05d5\u05d7.",
          "isCorrect": true,
          "rationale": "\u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05d1\u05e0\u05d6\u05d5\u05d3\u05d9\u05d0\u05d6\u05e4\u05d9\u05e0\u05d9\u05dd \u05de\u05d2\u05d1\u05d9\u05e8 \u05d0\u05ea \u05d4\u05e2\u05d9\u05db\u05d5\u05d1 \u05d4-GABA\u05e8\u05d2\u05d9 \u05d5\u05d1\u05db\u05da \u05de\u05d1\u05d8\u05dc \u05d0\u05ea \u05d4\u05d3\u05d9\u05e1-\u05d0\u05d9\u05e0\u05d4\u05d9\u05d1\u05d9\u05e6\u05d9\u05d4 \u05d4\u05d2\u05dc\u05d5\u05d8\u05de\u05d8\u05e8\u05d2\u05d9\u05ea \u05d4\u05e2\u05d5\u05de\u05d3\u05ea \u05d1\u05d1\u05e1\u05d9\u05e1 \u05d4\u05ea\u05e1\u05de\u05d5\u05e0\u05ea (StahlNeuro p.107)."
        },
        {
          "text": "\u05e2\u05d5\u05d3\u05e3 \u05d1\u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05d3\u05d5\u05e4\u05de\u05d9\u05e0\u05e8\u05d2\u05d9\u05ea \u05d1\u05de\u05e1\u05dc\u05d5\u05dc \u05d4\u05de\u05d6\u05d5\u05dc\u05d9\u05de\u05d1\u05d9.",
          "isCorrect": false,
          "rationale": "\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d6\u05d4 \u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05d7\u05d9\u05d5\u05d1\u05d9\u05d9\u05dd \u05e9\u05dc \u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d4, \u05d0\u05da \u05e7\u05d8\u05d8\u05d5\u05e0\u05d9\u05d4 \u05e7\u05e9\u05d5\u05e8\u05d4 \u05d9\u05d5\u05ea\u05e8 \u05dc\u05de\u05d0\u05d6\u05df \u05e9\u05d1\u05d9\u05df GABA \u05dc\u05d2\u05dc\u05d5\u05d8\u05de\u05d8 (StahlNeuro p.107)."
        },
        {
          "text": "\u05d7\u05e1\u05e8 \u05de\u05d5\u05d7\u05dc\u05d8 \u05e9\u05dc \u05e1\u05e8\u05d5\u05d8\u05d5\u05e0\u05d9\u05df \u05d1\u05e7\u05d5\u05e8\u05d8\u05e7\u05e1 \u05d4\u05e4\u05e8\u05d4-\u05e4\u05e8\u05d5\u05e0\u05d8\u05dc\u05d9.",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05e9\u05e1\u05e8\u05d5\u05d8\u05d5\u05e0\u05d9\u05df \u05de\u05e2\u05d5\u05e8\u05d1 \u05d1\u05de\u05e6\u05d1\u05d9 \u05e8\u05d5\u05d7, \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05e7\u05d8\u05d8\u05d5\u05e0\u05d9 \u05d4\u05e1\u05e4\u05e6\u05d9\u05e4\u05d9 \u05d5\u05d4\u05de\u05e2\u05e0\u05d4 \u05d4\u05de\u05d4\u05d9\u05e8 \u05dc\u05dc\u05d5\u05e8\u05d6\u05e4\u05d0\u05dd \u05de\u05ea\u05d5\u05d5\u05db\u05d9\u05dd \u05d3\u05e8\u05da \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 GABA (StahlNeuro p.107)."
        },
        {
          "text": "\u05d7\u05e1\u05d9\u05de\u05d4 \u05e9\u05dc \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 NMDA \u05e2\u05dc \u05d9\u05d3\u05d9 \u05e0\u05d5\u05d2\u05d3\u05e0\u05d9\u05dd \u05e2\u05e6\u05de\u05d9\u05d9\u05dd \u05d1\u05dc\u05d1\u05d3.",
          "isCorrect": false,
          "rationale": "\u05d6\u05d4\u05d5 \u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9 \u05dc\u05d0\u05e0\u05e6\u05e4\u05dc\u05d9\u05d8\u05d9\u05e1 \u05de\u05e1\u05d5\u05d9\u05de\u05ea, \u05d0\u05da \u05dc\u05d0 \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05e0\u05d5\u05d9\u05e8\u05d5\u05db\u05d9\u05de\u05d9 \u05d4\u05db\u05dc\u05dc\u05d9 \u05d4\u05de\u05ea\u05d5\u05d0\u05e8 \u05e2\u05d1\u05d5\u05e8 \u05db\u05dc\u05dc \u05de\u05e6\u05d1\u05d9 \u05d4\u05e7\u05d8\u05d8\u05d5\u05e0\u05d9\u05d4 (StahlNeuro p.107)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05d0\u05d9\u05e0\u05d8\u05e8\u05d0\u05e7\u05e6\u05d9\u05d4 \u05e9\u05d1\u05d9\u05df \u05d4\u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05de\u05e2\u05db\u05d1\u05ea (GABA) \u05dc\u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05de\u05e2\u05d5\u05e8\u05e8\u05ea \u05d4\u05de\u05e8\u05db\u05d6\u05d9\u05ea \u05d1\u05de\u05d5\u05d7.",
      "covered": [
        "Neurobiology of Catatonia",
        "Mechanism of Benzodiazepines"
      ]
    },
    {
      "type": "multiple_choice",
      "question": "\u05de\u05d4\u05d5 \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05d4\u05d0\u05e4\u05d9\u05d3\u05de\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05d1\u05e0\u05d5\u05d2\u05e2 \u05dc\u05e7\u05d8\u05d8\u05d5\u05e0\u05d9\u05d4 \u05d1\u05e7\u05e8\u05d1 \u05d9\u05dc\u05d3\u05d9\u05dd \u05d4\u05dc\u05d5\u05e7\u05d9\u05dd \u05d1-Autism Spectrum Disorder (ASD) \u05e2\u05dc \u05e4\u05d9 \u05d4-DSM-5-TR \u05d5-Dulcan?",
      "answerOptions": [
        {
          "text": "\u05ea\u05e7\u05d5\u05e4\u05ea \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05d4\u05de\u05e8\u05db\u05d6\u05d9\u05ea (Risk period) \u05dc\u05d4\u05ea\u05e4\u05e8\u05e6\u05d5\u05ea \u05e7\u05d8\u05d8\u05d5\u05e0\u05d9\u05d4 \u05d1-ASD \u05d4\u05d9\u05d0 \u05d1\u05e9\u05e0\u05d5\u05ea \u05d4\u05d4\u05ea\u05d1\u05d2\u05e8\u05d5\u05ea (Adolescent Years).",
          "isCorrect": true,
          "rationale": "\u05d4\u05de\u05e7\u05d5\u05e8\u05d5\u05ea \u05de\u05e6\u05d9\u05d9\u05e0\u05d9\u05dd \u05db\u05d9 \u05d1\u05e2\u05d5\u05d3 \u05e9\u05e7\u05d8\u05d8\u05d5\u05e0\u05d9\u05d4 \u05e0\u05d3\u05d9\u05e8\u05d4 \u05d1\u05d2\u05d9\u05dc \u05d4\u05e8\u05da, \u05d2\u05d9\u05dc \u05d4\u05d4\u05ea\u05d1\u05d2\u05e8\u05d5\u05ea \u05d4\u05d5\u05d0 \u05d7\u05dc\u05d5\u05df \u05d4\u05d6\u05de\u05df \u05d4\u05e7\u05e8\u05d9\u05d8\u05d9 \u05dc\u05d4\u05d5\u05e4\u05e2\u05ea\u05d4 \u05d1-ASD (DSM p.57, Dulcan p.141)."
        },
        {
          "text": "\u05e7\u05d8\u05d8\u05d5\u05e0\u05d9\u05d4 \u05de\u05d5\u05e4\u05d9\u05e2\u05d4 \u05d1\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d2\u05d1\u05d5\u05d4\u05d4 \u05d9\u05d5\u05ea\u05e8 \u05d1\u05e7\u05e8\u05d1 \u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd ASD \u05d5\u05d0\u05d9\u05e0\u05d8\u05dc\u05d9\u05d2\u05e0\u05e6\u05d9\u05d4 \u05d2\u05d1\u05d5\u05d4\u05d4 \u05d1\u05de\u05d9\u05d5\u05d7\u05d3.",
          "isCorrect": false,
          "rationale": "\u05d4\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d2\u05d1\u05d5\u05d4\u05d4 \u05d9\u05d5\u05ea\u05e8 \u05d3\u05d5\u05d5\u05e7\u05d0 \u05d1\u05e7\u05e8\u05d1 \u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd \u05de\u05d5\u05d2\u05d1\u05dc\u05d5\u05ea \u05e9\u05db\u05dc\u05d9\u05ea (ID) \u05d5\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05de\u05d5\u05e8\u05db\u05d1\u05d5\u05ea (DSM p.96, Dulcan p.124)."
        },
        {
          "text": "\u05e7\u05d8\u05d8\u05d5\u05e0\u05d9\u05d4 \u05d1-ASD \u05ea\u05de\u05d9\u05d3 \u05de\u05d5\u05e4\u05d9\u05e2\u05d4 \u05db\u05ea\u05d5\u05e6\u05d0\u05d4 \u05de\u05d7\u05e9\u05d9\u05e4\u05d4 \u05de\u05d5\u05e7\u05d3\u05de\u05ea \u05dc\u05e0\u05d5\u05d2\u05d3\u05d9 \u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d4.",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05e9\u05e0\u05d5\u05d2\u05d3\u05d9 \u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d4 \u05d4\u05dd \u05d2\u05d5\u05e8\u05dd \u05e1\u05d9\u05db\u05d5\u05df \u05dc-NMS, \u05e7\u05d8\u05d8\u05d5\u05e0\u05d9\u05d4 \u05d1-ASD \u05d9\u05db\u05d5\u05dc\u05d4 \u05dc\u05d4\u05d5\u05e4\u05d9\u05e2 \u05d1\u05d0\u05d5\u05e4\u05df \u05e1\u05e4\u05d5\u05e0\u05d8\u05e0\u05d9 \u05d0\u05d5 \u05db\u05ea\u05d5\u05e6\u05d0\u05d4 \u05de\u05d2\u05d5\u05e8\u05de\u05d9\u05dd \u05d0\u05d7\u05e8\u05d9\u05dd (DSM p.57)."
        },
        {
          "text": "\u05e7\u05d8\u05d8\u05d5\u05e0\u05d9\u05d4 \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd \u05d0\u05d5\u05d8\u05d9\u05d6\u05dd \u05d7\u05d5\u05dc\u05e4\u05ea \u05ea\u05de\u05d9\u05d3 \u05dc\u05dc\u05d0 \u05e6\u05d5\u05e8\u05da \u05d1\u05d4\u05ea\u05e2\u05e8\u05d1\u05d5\u05ea \u05ea\u05e8\u05d5\u05e4\u05ea\u05d9\u05ea.",
          "isCorrect": false,
          "rationale": "\u05e7\u05d8\u05d8\u05d5\u05e0\u05d9\u05d4 \u05d1-ASD \u05d4\u05d9\u05d0 \u05de\u05e6\u05d1 \u05e7\u05dc\u05d9\u05e0\u05d9 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9 \u05d4\u05d3\u05d5\u05e8\u05e9 \u05dc\u05e8\u05d5\u05d1 \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05d1\u05e0\u05d6\u05d5\u05d3\u05d9\u05d0\u05d6\u05e4\u05d9\u05e0\u05d9\u05dd \u05d0\u05d5 ECT \u05dc\u05de\u05e0\u05d9\u05e2\u05ea \u05e0\u05e1\u05d9\u05d2\u05d4 \u05ea\u05e4\u05e7\u05d5\u05d3\u05d9\u05ea (Dulcan p.141)."
        }
      ],
      "hint": "\u05d7\u05e4\u05e9 \u05d0\u05ea '\u05ea\u05e7\u05d5\u05e4\u05ea \u05d4\u05e1\u05d9\u05db\u05d5\u05df' \u05d4\u05de\u05e6\u05d5\u05d9\u05e0\u05ea \u05d1\u05e4\u05e8\u05e7 \u05e2\u05dc ASD \u05d1-DSM.",
      "covered": [
        "Epidemiology of Catatonia in ASD"
      ]
    },
    {
      "type": "short_answer",
      "question": "\u05de\u05d3\u05d5\u05e2 \u05e7\u05d9\u05d9\u05de\u05ea \u05dc\u05e2\u05d9\u05ea\u05d9\u05dd \u05ea\u05ea-\u05d0\u05d1\u05d7\u05e0\u05d4 (Under-recognition) \u05e9\u05dc \u05e7\u05d8\u05d8\u05d5\u05e0\u05d9\u05d4 \u05d1\u05e4\u05e8\u05e7\u05d8\u05d9\u05e7\u05d4 \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9\u05ea, \u05d5\u05de\u05d4\u05df \u05d4\u05e1\u05db\u05e0\u05d5\u05ea \u05d4\u05d2\u05d5\u05e4\u05e0\u05d9\u05d5\u05ea \u05d4\u05e2\u05d9\u05e7\u05e8\u05d9\u05d5\u05ea \u05d4\u05db\u05e8\u05d5\u05db\u05d5\u05ea \u05d1\u05de\u05e6\u05d1 \u05d6\u05d4 \u05d1\u05e9\u05dc\u05d1\u05d9\u05d5 \u05d4\u05de\u05ea\u05e7\u05d3\u05de\u05d9\u05dd?",
      "grading": {
        "modelAnswer": "\u05ea\u05ea-\u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05e0\u05d5\u05d1\u05e2\u05ea \u05de\u05d4\u05ea\u05de\u05e7\u05d3\u05d5\u05ea \u05d9\u05ea\u05e8 \u05d1\u05d4\u05d5\u05e8\u05d0\u05d4 \u05e2\u05dc \u05e1\u05d9\u05de\u05e0\u05d9\u05dd \u05e0\u05d3\u05d9\u05e8\u05d9\u05dd \u05db\u05de\u05d5 Waxy Flexibility, \u05d1\u05e2\u05d5\u05d3 \u05e9\u05d4\u05de\u05d5\u05e4\u05e2 \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9 \u05de\u05d2\u05d5\u05d5\u05df \u05d5\u05e0\u05e2 \u05d1\u05d9\u05df \u05d7\u05d5\u05e1\u05e8 \u05ea\u05d2\u05d5\u05d1\u05d4 \u05dc\u05d0\u05d2\u05d9\u05d8\u05e6\u05d9\u05d4 (DSM p.135). \u05d4\u05e1\u05db\u05e0\u05d5\u05ea \u05d4\u05d2\u05d5\u05e4\u05e0\u05d9\u05d5\u05ea \u05db\u05d5\u05dc\u05dc\u05d5\u05ea \u05ea\u05ea-\u05ea\u05d6\u05d5\u05e0\u05d4, \u05d4\u05ea\u05d9\u05d9\u05d1\u05e9\u05d5\u05ea, \u05e4\u05e6\u05e2\u05d9 \u05dc\u05d7\u05e5, \u05e4\u05e7\u05e7\u05ea \u05d5\u05e8\u05d9\u05d3\u05d9\u05dd (Thromboembolism), \u05e7\u05d5\u05e0\u05d8\u05e8\u05e7\u05d8\u05d5\u05e8\u05d5\u05ea \u05e9\u05e8\u05d9\u05e8\u05d9\u05dd \u05d5\u05e1\u05d9\u05db\u05d5\u05df \u05dc-Malignant Catatonia \u05d4\u05de\u05e2\u05e8\u05d1\u05ea Hyperpyrexia (DSM p.135, Dulcan p.605).",
        "rationale": "\u05d4\u05d1\u05e0\u05ea \u05d4\u05de\u05d2\u05d5\u05d5\u05df \u05d4\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d8\u05d9 \u05e7\u05e8\u05d9\u05d8\u05d9\u05ea \u05dc\u05d0\u05d1\u05d7\u05d5\u05df, \u05d1\u05e2\u05d5\u05d3 \u05e9\u05d4\u05d4\u05e9\u05dc\u05db\u05d5\u05ea \u05d4\u05d2\u05d5\u05e4\u05e0\u05d9\u05d5\u05ea \u05e9\u05dc \u05d7\u05d5\u05e1\u05e8 \u05ea\u05e0\u05d5\u05e2\u05d4 \u05d5\u05d4\u05d6\u05e0\u05d7\u05d4 \u05e2\u05e6\u05de\u05d9\u05ea \u05d4\u05df \u05d2\u05d5\u05e8\u05dd \u05d4\u05ea\u05de\u05d5\u05ea\u05d4 \u05d4\u05de\u05e8\u05db\u05d6\u05d9.",
        "requiredAttributes": [
          "\u05e6\u05d9\u05d5\u05df \u05d4\u05d2\u05d9\u05d5\u05d5\u05df \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9 (\u05d1\u05d9\u05df \u05e1\u05d8\u05d5\u05e4\u05d5\u05e8 \u05dc\u05d0\u05d2\u05d9\u05d8\u05e6\u05d9\u05d4) \u05db\u05d2\u05d5\u05e8\u05dd \u05dc\u05d1\u05dc\u05d1\u05d5\u05dc \u05d0\u05d1\u05d7\u05e0\u05ea\u05d9.",
          "\u05d0\u05d6\u05db\u05d5\u05e8 \u05e1\u05d9\u05d1\u05d5\u05db\u05d9\u05dd \u05d2\u05d5\u05e4\u05e0\u05d9\u05d9\u05dd \u05db\u05d2\u05d5\u05df \u05d4\u05ea\u05d9\u05d9\u05d1\u05e9\u05d5\u05ea, \u05ea\u05ea-\u05ea\u05d6\u05d5\u05e0\u05d4 \u05d0\u05d5 Thromboembolism.",
          "\u05d0\u05d6\u05db\u05d5\u05e8 \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05e9\u05dc Malignant Catatonia/Hyperpyrexia."
        ],
        "errors": {
          "misconceptions": [
            "\u05e1\u05d1\u05e8\u05d4 \u05e9\u05e7\u05d8\u05d8\u05d5\u05e0\u05d9\u05d4 \u05d4\u05d9\u05d0 \u05ea\u05de\u05d9\u05d3 \u05de\u05e6\u05d1 \u05e9\u05dc \u05e0\u05d5\u05e7\u05e9\u05d5\u05ea \u05d5\u05e9\u05e7\u05d8 \u05d1\u05dc\u05d1\u05d3."
          ],
          "bluffs": [
            "\u05d0\u05de\u05d9\u05e8\u05d4 \u05db\u05dc\u05dc\u05d9\u05ea \u05e9\u05d6\u05d4 \u05de\u05e1\u05d5\u05db\u05df \u05db\u05d9 \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05dc\u05d0 \u05d0\u05d5\u05db\u05dc \u05d1\u05dc\u05d9 \u05dc\u05d4\u05e1\u05d1\u05d9\u05e8 \u05d0\u05ea \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d0\u05d5 \u05d4\u05e1\u05d9\u05d1\u05d5\u05db\u05d9\u05dd \u05d4\u05e0\u05d5\u05e1\u05e4\u05d9\u05dd."
          ]
        }
      },
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05d4'\u05e7\u05dc\u05d0\u05e1\u05d9\u05d9\u05dd' \u05d4\u05de\u05d5\u05d3\u05d2\u05e9\u05d9\u05dd \u05d1\u05dc\u05d9\u05de\u05d5\u05d3 \u05dc\u05e2\u05d5\u05de\u05ea \u05d4\u05de\u05e6\u05d9\u05d0\u05d5\u05ea \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9\u05ea, \u05d5\u05e2\u05dc \u05d4\u05d4\u05e9\u05dc\u05db\u05d5\u05ea \u05e9\u05dc \u05d7\u05d5\u05e1\u05e8 \u05ea\u05e0\u05d5\u05e2\u05d4 \u05de\u05de\u05d5\u05e9\u05da.",
      "covered": [
        "Clinical Recognition Challenges",
        "Physical Complications of Catatonia"
      ]
    },
    {
      "type": "multiple_select",
      "question": "\u05e2\u05dc \u05e4\u05d9 \u05d4-DSM-5-TR, \u05d0\u05d9\u05dc\u05d5 \u05de\u05d4\u05de\u05d5\u05e9\u05d2\u05d9\u05dd \u05d4\u05d1\u05d0\u05d9\u05dd \u05de\u05ea\u05d0\u05e8\u05d9\u05dd \u05e0\u05db\u05d5\u05e0\u05d4 \u05d0\u05ea \u05d4\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05d4\u05e4\u05e1\u05d9\u05db\u05d5\u05de\u05d5\u05d8\u05d5\u05e8\u05d9\u05d9\u05dd \u05e9\u05dc \u05e7\u05d8\u05d8\u05d5\u05e0\u05d9\u05d4?",
      "answerOptions": [
        {
          "text": "Mannerism: \u05e7\u05e8\u05d9\u05e7\u05d8\u05d5\u05e8\u05d4 \u05de\u05d5\u05d6\u05e8\u05d4 \u05d0\u05d5 \u05de\u05d5\u05d2\u05d6\u05de\u05ea \u05e9\u05dc \u05ea\u05e0\u05d5\u05e2\u05d5\u05ea \u05e8\u05d2\u05d9\u05dc\u05d5\u05ea \u05d5\u05de\u05db\u05d5\u05d5\u05e0\u05d5\u05ea \u05de\u05d8\u05e8\u05d4.",
          "isCorrect": true,
          "rationale": "\u05d6\u05d5\u05d4\u05d9 \u05d4\u05d4\u05d2\u05d3\u05e8\u05d4 \u05d4\u05de\u05d3\u05d5\u05d9\u05e7\u05ea \u05d4\u05de\u05d5\u05e4\u05d9\u05e2\u05d4 \u05d1-DSM \u05e2\u05d1\u05d5\u05e8 \u05de\u05e0\u05e8\u05d9\u05d6\u05dd (DSM p.135)."
        },
        {
          "text": "Catalepsy: \u05d4\u05e9\u05e8\u05d0\u05d4 \u05e1\u05d1\u05d9\u05dc\u05d4 (Passive induction) \u05e9\u05dc \u05ea\u05e0\u05d5\u05d7\u05ea \u05d2\u05d5\u05e3 \u05d4\u05de\u05d5\u05d7\u05d6\u05e7\u05ea \u05db\u05e0\u05d2\u05d3 \u05db\u05d5\u05d7 \u05d4\u05db\u05d5\u05d1\u05d3.",
          "isCorrect": true,
          "rationale": "\u05e7\u05d8\u05dc\u05e4\u05e1\u05d9\u05d4 \u05de\u05d5\u05d2\u05d3\u05e8\u05ea \u05db\u05d4\u05e6\u05d1\u05d4 \u05e4\u05e1\u05d9\u05d1\u05d9\u05ea \u05e9\u05dc \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05d1\u05ea\u05e0\u05d5\u05d7\u05d4 \u05d4\u05e0\u05e9\u05de\u05e8\u05ea \u05e2\u05dc \u05d9\u05d3\u05d5 (DSM p.135)."
        },
        {
          "text": "Echopraxia: \u05d7\u05d9\u05e7\u05d5\u05d9 \u05d0\u05d5 \u05d4\u05d3\u05d4\u05d5\u05d3 \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9 \u05e9\u05dc \u05ea\u05e0\u05d5\u05e2\u05d5\u05ea \u05d4\u05de\u05d1\u05d5\u05e6\u05e2\u05d5\u05ea \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d0\u05d3\u05dd \u05d0\u05d7\u05e8.",
          "isCorrect": true,
          "rationale": "\u05d6\u05d4\u05d5 \u05d4\u05de\u05d5\u05e9\u05d2 \u05d4\u05de\u05ea\u05d0\u05e8 \u05d4\u05d3\u05d4\u05d5\u05d3 \u05ea\u05e0\u05d5\u05e2\u05ea\u05d9, \u05dc\u05d4\u05d1\u05d3\u05d9\u05dc \u05de\u05d0\u05e7\u05d5\u05dc\u05dc\u05d9\u05d4 \u05e9\u05d4\u05d9\u05d0 \u05d4\u05d3\u05d4\u05d5\u05d3 \u05d3\u05d9\u05d1\u05d5\u05e8 (DSM p.135)."
        },
        {
          "text": "Stereotypy: \u05ea\u05e0\u05d5\u05e2\u05d5\u05ea \u05de\u05db\u05d5\u05d5\u05e0\u05d5\u05ea \u05de\u05d8\u05e8\u05d4 \u05d4\u05de\u05d1\u05d5\u05e6\u05e2\u05d5\u05ea \u05d1\u05ea\u05d3\u05d9\u05e8\u05d5\u05ea \u05d2\u05d1\u05d5\u05d4\u05d4 \u05de\u05d0\u05d5\u05d3.",
          "isCorrect": false,
          "rationale": "\u05d1\u05e7\u05d8\u05d8\u05d5\u05e0\u05d9\u05d4, \u05e1\u05d8\u05e8\u05d9\u05d0\u05d5\u05d8\u05d9\u05e4\u05d9\u05d5\u05ea \u05de\u05d5\u05d2\u05d3\u05e8\u05d5\u05ea \u05db\u05ea\u05e0\u05d5\u05e2\u05d5\u05ea \u05e9\u05d0\u05d9\u05e0\u05df \u05de\u05db\u05d5\u05d5\u05e0\u05d5\u05ea \u05de\u05d8\u05e8\u05d4 (Non-goal-directed) (DSM p.135)."
        }
      ],
      "hint": "\u05d4\u05ea\u05de\u05e7\u05d3 \u05d1\u05d4\u05d2\u05d3\u05e8\u05d5\u05ea \u05d4\u05de\u05d3\u05d5\u05d9\u05e7\u05d5\u05ea \u05e9\u05dc \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9\u05dd \u05d4\u05e4\u05e1\u05d9\u05db\u05d5\u05de\u05d5\u05d8\u05d5\u05e8\u05d9\u05d9\u05dd \u05d1-DSM.",
