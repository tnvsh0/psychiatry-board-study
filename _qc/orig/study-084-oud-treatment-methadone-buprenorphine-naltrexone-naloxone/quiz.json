        }
      ],
      "hint": "\u05d4\u05e9\u05d5\u05d5\u05d4 \u05d1\u05d9\u05df \u05d6\u05de\u05df \u05de\u05d7\u05e6\u05d9\u05ea \u05d4\u05d7\u05d9\u05d9\u05dd \u05e9\u05dc \u05ea\u05e8\u05d5\u05e4\u05ea \u05d4\u05d4\u05d7\u05d9\u05d9\u05d0\u05d4 \u05dc\u05d1\u05d9\u05df \u05d6\u05d4 \u05e9\u05dc \u05d4\u05d0\u05d5\u05e4\u05d9\u05d5\u05d0\u05d9\u05d3 \u05e9\u05d2\u05e8\u05dd \u05dc\u05d4\u05e8\u05e2\u05dc\u05d4.",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05de\u05d8\u05d5\u05e4\u05dc\u05ea \u05d1\u05ea 19 \u05d4\u05e1\u05d5\u05d1\u05dc\u05ea \u05de-OUD \u05d5\u05de\u05d1\u05e7\u05e9\u05ea \u05dc\u05e2\u05d1\u05d5\u05e8 \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Extended-Release Injectable Naltrexone (Vivitrol). \u05d4\u05d9\u05d0 \u05d4\u05e9\u05ea\u05de\u05e9\u05d4 \u05d1-Oxycodone \u05d1\u05de\u05d9\u05e0\u05d5\u05df \u05d2\u05d1\u05d5\u05d4 \u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05e9\u05d1\u05d5\u05e2 \u05d4\u05d0\u05d7\u05e8\u05d5\u05df. \u05de\u05d4\u05d5 \u05ea\u05e0\u05d0\u05d9 \u05d4\u05e1\u05e3 \u05d4\u05e7\u05e8\u05d9\u05d8\u05d9 \u05e9\u05d7\u05d9\u05d9\u05d1 \u05dc\u05d4\u05ea\u05e7\u05d9\u05d9\u05dd \u05dc\u05e4\u05e0\u05d9 \u05d4\u05d6\u05e8\u05e7\u05ea \u05d4\u05de\u05e0\u05d4 \u05d4\u05e8\u05d0\u05e9\u05d5\u05e0\u05d4 \u05e9\u05dc Vivitrol?",
      "answerOptions": [
        {
          "text": "\u05d4\u05d9\u05e0\u05d6\u05e8\u05d5\u05ea \u05de\u05dc\u05d0\u05d4 \u05d5\u05de\u05d5\u05db\u05d7\u05ea \u05de\u05d0\u05d5\u05e4\u05d9\u05d5\u05d0\u05d9\u05d3\u05d9\u05dd \u05dc\u05de\u05e9\u05da 7 \u05e2\u05d3 10 \u05d9\u05de\u05d9\u05dd \u05dc\u05e4\u05d7\u05d5\u05ea.",
          "isCorrect": true,
          "rationale": "\u05de\u05ea\u05df Naltrexone \u05d1\u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05e9\u05e8\u05d9\u05d3\u05d9 \u05d0\u05d5\u05e4\u05d9\u05d5\u05d0\u05d9\u05d3\u05d9\u05dd \u05d9\u05d2\u05e8\u05d5\u05dd \u05dc\u05d3\u05d7\u05d9\u05e7\u05d4 \u05de\u05d9\u05d9\u05d3\u05d9\u05ea \u05e9\u05dc \u05d4\u05d0\u05d2\u05d5\u05e0\u05d9\u05e1\u05d8\u05d9\u05dd \u05d5\u05d4\u05e9\u05e8\u05d0\u05ea \u05ea\u05e1\u05de\u05d5\u05e0\u05ea \u05d2\u05de\u05d9\u05dc\u05d4 \u05de\u05d5\u05d7\u05d9\u05e9\u05ea \u05e1\u05d5\u05e2\u05e8\u05ea \u05d5\u05de\u05e1\u05d5\u05db\u05e0\u05ea (Dulcan p.234, StahlNeuro p.560)."
        },
        {
          "text": "\u05d1\u05d9\u05e6\u05d5\u05e2 \u05d4\u05e2\u05de\u05e1\u05ea Methadone \u05dc\u05de\u05e9\u05da 3 \u05d9\u05de\u05d9\u05dd \u05dc\u05de\u05e0\u05d9\u05e2\u05ea \u05db\u05de\u05d9\u05d4\u05d4 (Craving) \u05de\u05d5\u05e7\u05d3\u05de\u05ea.",
          "isCorrect": false,
          "rationale": "\u05de\u05ea\u05df Methadone (\u05d0\u05d2\u05d5\u05e0\u05d9\u05e1\u05d8 \u05de\u05dc\u05d0) \u05dc\u05e4\u05e0\u05d9 Naltrexone \u05d4\u05d5\u05d0 \u05d4\u05ea\u05d5\u05d5\u05d9\u05ea \u05e0\u05d2\u05d3 \u05de\u05d5\u05d7\u05dc\u05d8\u05ea \u05d5\u05d9\u05d7\u05de\u05d9\u05e8 \u05d0\u05ea \u05e1\u05db\u05e0\u05ea \u05d4\u05d2\u05de\u05d9\u05dc\u05d4 \u05d4\u05de\u05d5\u05d7\u05d9\u05e9\u05ea (StahlNeuro p.560)."
        },
        {
          "text": "\u05d4\u05d2\u05e2\u05d4 \u05dc\u05de\u05e6\u05d1 \u05e9\u05dc \u05d2\u05de\u05d9\u05dc\u05d4 \u05e4\u05e2\u05d9\u05dc\u05d4 \u05e7\u05dc\u05d4 (COWS score > 8) \u05d1\u05d1\u05d5\u05e7\u05e8 \u05d4\u05d4\u05d6\u05e8\u05e7\u05d4.",
          "isCorrect": false,
          "rationale": "\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df \u05d6\u05d4 \u05e0\u05db\u05d5\u05df \u05dc\u05d4\u05e9\u05e8\u05d0\u05ea Buprenorphine, \u05d0\u05da \u05d1-Naltrexone \u05e0\u05d3\u05e8\u05e9\u05ea \u05d4\u05d9\u05e0\u05d6\u05e8\u05d5\u05ea \u05de\u05dc\u05d0\u05d4 \u05dc\u05dc\u05d0 \u05e1\u05d9\u05de\u05e0\u05d9 \u05d2\u05de\u05d9\u05dc\u05d4 \u05e4\u05e2\u05d9\u05dc\u05d9\u05dd (DSM p.618, StahlNeuro p.560)."
        },
        {
          "text": "\u05d5\u05d9\u05d3\u05d5\u05d0 \u05db\u05d9 \u05d4\u05de\u05d8\u05d5\u05e4\u05dc\u05ea \u05e0\u05d5\u05d8\u05dc\u05ea Clonidine \u05d1\u05de\u05d9\u05e0\u05d5\u05df \u05e9\u05dc $0.4\\text{ mg/day}$ \u05db\u05d4\u05db\u05e0\u05d4 \u05dc\u05d4\u05d6\u05e8\u05e7\u05d4.",
          "isCorrect": false,
          "rationale": "Clonidine \u05d9\u05db\u05d5\u05dc \u05dc\u05e1\u05d9\u05d9\u05e2 \u05d1\u05e0\u05d9\u05d4\u05d5\u05dc \u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05e9\u05dc \u05d2\u05de\u05d9\u05dc\u05d4, \u05d0\u05da \u05d4\u05d5\u05d0 \u05d0\u05d9\u05e0\u05d5 \u05de\u05d7\u05dc\u05d9\u05e3 \u05d0\u05ea \u05d4\u05d3\u05e8\u05d9\u05e9\u05d4 \u05dc\u05d4\u05d9\u05e0\u05d6\u05e8\u05d5\u05ea \u05de\u05dc\u05d0\u05d4 \u05de\u05d0\u05d5\u05e4\u05d9\u05d5\u05d0\u05d9\u05d3\u05d9\u05dd (StahlKids p.143)."
        }
      ],
      "hint": "Naltrexone \u05d4\u05d5\u05d0 \u05d0\u05e0\u05d8\u05d2\u05d5\u05e0\u05d9\u05e1\u05d8 \u05de\u05dc\u05d0, \u05d5\u05d4\u05e9\u05e4\u05e2\u05ea\u05d5 \u05e2\u05dc \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9\u05dd \u05ea\u05e4\u05d5\u05e1\u05d9\u05dd \u05d4\u05d9\u05d0 \u05d3\u05e8\u05de\u05d8\u05d9\u05ea.",
      "imageUrls": []
