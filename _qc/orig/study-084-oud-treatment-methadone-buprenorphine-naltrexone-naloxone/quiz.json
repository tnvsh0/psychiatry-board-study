{
  "title": "Opioid Quiz",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\u05de\u05d8\u05d5\u05e4\u05dc \u05d1\u05df 17 \u05d4\u05de\u05d0\u05d5\u05d1\u05d7\u05df \u05e2\u05dd Opioid Use Disorder (OUD) \u05d1\u05d3\u05e8\u05d2\u05d4 \u05d7\u05de\u05d5\u05e8\u05d4 \u05de\u05d8\u05d5\u05e4\u05dc \u05d1-Methadone \u05d1\u05de\u05d9\u05e0\u05d5\u05df \u05e9\u05dc $120\\text{ mg/day}$. \u05d1\u05de\u05d4\u05dc\u05da \u05de\u05e2\u05e7\u05d1 \u05d1\u05de\u05e8\u05e4\u05d0\u05d4, \u05d4\u05d5\u05d0 \u05de\u05d3\u05d5\u05d5\u05d7 \u05e2\u05dc \u05d0\u05d9\u05e8\u05d5\u05e2 \u05e4\u05ea\u05d0\u05d5\u05de\u05d9 \u05e9\u05dc \u05e1\u05d7\u05e8\u05d7\u05d5\u05e8\u05ea \u05e7\u05e9\u05d4 \u05d5\u05db\u05de\u05e2\u05d8 \u05e2\u05d9\u05dc\u05e4\u05d5\u05df (Near-syncope). \u05de\u05d4\u05d5 \u05d4\u05e6\u05e2\u05d3 \u05d4\u05de\u05d9\u05d9\u05d3\u05d9 \u05d5\u05d4\u05e7\u05e8\u05d9\u05d8\u05d9 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d1\u05e0\u05d9\u05d4\u05d5\u05dc \u05d4\u05de\u05e7\u05e8\u05d4 \u05d1\u05d4\u05ea\u05d1\u05e1\u05e1 \u05e2\u05dc \u05e4\u05e8\u05d5\u05d8\u05d5\u05e7\u05d5\u05dc \u05d4\u05e0\u05d9\u05d8\u05d5\u05e8 \u05e9\u05dc \u05d4\u05ea\u05e8\u05d5\u05e4\u05d4?",
      "answerOptions": [
        {
          "text": "\u05d1\u05d9\u05e6\u05d5\u05e2 ECG \u05dc\u05d4\u05e2\u05e8\u05db\u05ea \u05de\u05e8\u05d5\u05d5\u05d7 QTc \u05de\u05d7\u05e9\u05e9 \u05dc-Torsades de Pointes.",
          "isCorrect": true,
          "rationale": "Methadone \u05e2\u05dc\u05d5\u05dc \u05dc\u05d2\u05e8\u05d5\u05dd \u05dc\u05d4\u05d0\u05e8\u05db\u05ea \u05de\u05e8\u05d5\u05d5\u05d7 QTc, \u05d1\u05de\u05d9\u05d5\u05d7\u05d3 \u05d1\u05de\u05d9\u05e0\u05d5\u05e0\u05d9\u05dd \u05d2\u05d1\u05d5\u05d4\u05d9\u05dd \u05de\u05e2\u05dc $60-100\\text{ mg/day}$, \u05de\u05d4 \u05e9\u05de\u05e2\u05dc\u05d4 \u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05d0\u05e8\u05d9\u05ea\u05de\u05d9\u05d5\u05ea \u05d7\u05d3\u05e8\u05d9\u05d5\u05ea \u05e7\u05d8\u05dc\u05e0\u05d9\u05d5\u05ea (Dulcan p.234, Dulcan p.332)."
        },
        {
          "text": "\u05d4\u05e4\u05d7\u05ea\u05d4 \u05de\u05d9\u05d9\u05d3\u05d9\u05ea \u05e9\u05dc $50\\%$ \u05d1\u05de\u05d9\u05e0\u05d5\u05df \u05d4-Methadone \u05d1\u05e9\u05dc \u05d7\u05e9\u05e9 \u05de\u05e6\u05d1\u05d9\u05e8\u05d4 \u05d1\u05e8\u05e7\u05de\u05d5\u05ea.",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05e9\u05e7\u05d9\u05d9\u05de\u05ea \u05e6\u05d1\u05d9\u05e8\u05d4 \u05d1\u05e8\u05e7\u05de\u05d5\u05ea, \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e9\u05dc \u05e1\u05d7\u05e8\u05d7\u05d5\u05e8\u05ea \u05d5\u05e2\u05d9\u05dc\u05e4\u05d5\u05df \u05de\u05d7\u05d9\u05d9\u05d1\u05d9\u05dd \u05e9\u05dc\u05d9\u05dc\u05ea \u05d4\u05e4\u05e8\u05e2\u05ea \u05e7\u05e6\u05d1 \u05dc\u05d1\u05d1\u05d9\u05ea \u05dc\u05e4\u05e0\u05d9 \u05e9\u05d9\u05e0\u05d5\u05d9 \u05de\u05d9\u05e0\u05d5\u05df \u05e9\u05e8\u05d9\u05e8\u05d5\u05ea\u05d9 (StahlNeuro p.559)."
        },
        {
          "text": "\u05de\u05ea\u05df \u05de\u05e0\u05d4 \u05d3\u05d7\u05d5\u05e4\u05d4 \u05e9\u05dc Naloxone $4\\text{ mg}$ \u05d1\u05de\u05ea\u05d5\u05d5\u05d4 Intranasal.",
          "isCorrect": false,
          "rationale": "Naloxone \u05de\u05d9\u05d5\u05e2\u05d3 \u05dc\u05d4\u05d7\u05d9\u05d9\u05d0\u05ea \u05d7\u05d9\u05e8\u05d5\u05dd \u05d1\u05de\u05e6\u05d1 \u05e9\u05dc \u05d3\u05d9\u05db\u05d5\u05d9 \u05e0\u05e9\u05d9\u05de\u05ea\u05d9 \u05d5\u05ea\u05e8\u05d3\u05de\u05ea (Overdose), \u05d5\u05dc\u05d0 \u05dc\u05d1\u05d9\u05e8\u05d5\u05e8 \u05d0\u05d9\u05e8\u05d5\u05e2 \u05e9\u05dc Near-syncope \u05ea\u05d7\u05ea \u05d8\u05d9\u05e4\u05d5\u05dc \u05d0\u05d7\u05d6\u05e7\u05d4 \u05d9\u05e6\u05d9\u05d1 (StahlNeuro p.560)."
        },
        {
          "text": "\u05d1\u05d3\u05d9\u05e7\u05ea \u05e8\u05de\u05d5\u05ea \u05d0\u05dc\u05e7\u05d8\u05e8\u05d5\u05dc\u05d9\u05d8\u05d9\u05dd \u05d1\u05d3\u05dd \u05d1\u05d3\u05d2\u05e9 \u05e2\u05dc Hyperkalemia.",
          "isCorrect": false,
          "rationale": "\u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05d0\u05e8\u05d9\u05ea\u05de\u05d9\u05d4 \u05ea\u05d7\u05ea Methadone \u05e2\u05d5\u05dc\u05d4 \u05d3\u05d5\u05d5\u05e7\u05d0 \u05d1\u05e0\u05d5\u05db\u05d7\u05d5\u05ea Hypokalemia \u05d0\u05d5 Hypomagnesemia, \u05d5\u05dc\u05d0 Hyperkalemia (Dulcan p.332)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05d4\u05e7\u05e8\u05d3\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d4\u05e1\u05e4\u05e6\u05d9\u05e4\u05d9 \u05d4\u05de\u05d5\u05e4\u05d9\u05e2 \u05d1\u05de\u05d9\u05e0\u05d5\u05e0\u05d9\u05dd \u05d2\u05d1\u05d5\u05d4\u05d9\u05dd \u05e9\u05dc \u05d0\u05d2\u05d5\u05e0\u05d9\u05e1\u05d8\u05d9\u05dd \u05de\u05dc\u05d0\u05d9\u05dd \u05dc\u05d0\u05d5\u05e4\u05d9\u05d5\u05d0\u05d9\u05d3\u05d9\u05dd.",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05e0\u05e2\u05e8 \u05d1\u05df 16 \u05e2\u05dd \u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4 \u05e9\u05dc \u05e9\u05d9\u05de\u05d5\u05e9 \u05d1-Heroin \u05de\u05d2\u05d9\u05e2 \u05dc\u05de\u05e8\u05e4\u05d0\u05d4 \u05d5\u05de\u05d1\u05e7\u05e9 \u05dc\u05d4\u05ea\u05d7\u05d9\u05dc \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Suboxone (Buprenorphine/Naloxone). \u05d4\u05d5\u05d0 \u05de\u05d3\u05d5\u05d5\u05d7 \u05db\u05d9 \u05d4\u05e9\u05ea\u05de\u05e9 \u05d1-Heroin \u05d1\u05e4\u05e2\u05dd \u05d4\u05d0\u05d7\u05e8\u05d5\u05e0\u05d4 \u05dc\u05e4\u05e0\u05d9 \u05db-6 \u05e9\u05e2\u05d5\u05ea. \u05d1\u05d1\u05d3\u05d9\u05e7\u05ea\u05d5 \u05d4\u05d5\u05d0 \u05e0\u05e8\u05d0\u05d4 \u05e0\u05d9\u05e0\u05d5\u05d7, \u05dc\u05dc\u05d0 \u05e1\u05d9\u05de\u05e0\u05d9 \u05d2\u05de\u05d9\u05dc\u05d4 \u05d0\u05d5\u05d1\u05d9\u05d9\u05e7\u05d8\u05d9\u05d1\u05d9\u05d9\u05dd. \u05de\u05d4 \u05ea\u05d4\u05d9\u05d4 \u05d4\u05ea\u05d5\u05e6\u05d0\u05d4 \u05e9\u05dc \u05de\u05ea\u05df \u05de\u05e0\u05d4 \u05e8\u05d0\u05e9\u05d5\u05e0\u05d4 \u05e9\u05dc Buprenorphine \u05d1\u05e0\u05e7\u05d5\u05d3\u05ea \u05d6\u05de\u05df \u05d6\u05d5?",
      "answerOptions": [
        {
          "text": "\u05d4\u05e9\u05e8\u05d0\u05ea \u05ea\u05e1\u05de\u05d5\u05e0\u05ea \u05d2\u05de\u05d9\u05dc\u05d4 \u05de\u05d5\u05d7\u05d9\u05e9\u05ea (Precipitated Withdrawal) \u05e1\u05d5\u05e2\u05e8\u05ea.",
          "isCorrect": true,
          "rationale": "\u05d1\u05e9\u05dc \u05d4\u05d6\u05d9\u05e7\u05d4 (Affinity) \u05d4\u05d2\u05d1\u05d5\u05d4\u05d4 \u05e9\u05dc Buprenorphine \u05dc\u05e7\u05d5\u05dc\u05d8\u05df $\\mu$, \u05d4\u05d5\u05d0 \u05d9\u05d3\u05d7\u05d5\u05e7 \u05d0\u05ea \u05d4-Heroin \u05de\u05d4\u05e7\u05d5\u05dc\u05d8\u05e0\u05d9\u05dd, \u05d0\u05da \u05e4\u05e2\u05d9\u05dc\u05d5\u05ea\u05d5 \u05d4\u05d0\u05d9\u05e0\u05d8\u05e8\u05d9\u05e0\u05d6\u05d9\u05ea \u05d4\u05d7\u05dc\u05e7\u05d9\u05ea \u05ea\u05d2\u05e8\u05d5\u05dd \u05dc\u05e0\u05e4\u05d9\u05dc\u05d4 \u05e4\u05ea\u05d0\u05d5\u05de\u05d9\u05ea \u05d1\u05d0\u05d9\u05ea\u05d5\u05ea \u05d4\u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 (DSM p.618, StahlNeuro p.559)."
        },
        {
          "text": "\u05d3\u05d9\u05db\u05d5\u05d9 \u05e0\u05e9\u05d9\u05de\u05ea\u05d9 \u05de\u05d4\u05d9\u05e8 \u05d1\u05e9\u05dc \u05d0\u05e4\u05e7\u05d8 \u05e1\u05d9\u05e0\u05e8\u05d2\u05d9\u05e1\u05d8\u05d9 \u05e2\u05dd \u05d4-Heroin \u05e9\u05e0\u05d5\u05ea\u05e8 \u05d1\u05de\u05d7\u05d6\u05d5\u05e8 \u05d4\u05d3\u05dd.",
          "isCorrect": false,
          "rationale": "\u05dc-Buprenorphine \u05d9\u05e9 Ceiling Effect \u05e2\u05dc \u05d3\u05d9\u05db\u05d5\u05d9 \u05e0\u05e9\u05d9\u05de\u05ea\u05d9, \u05d5\u05d4\u05d5\u05d0 \u05e0\u05d5\u05d8\u05d4 \u05dc\u05d3\u05d7\u05d5\u05e7 \u05d0\u05d2\u05d5\u05e0\u05d9\u05e1\u05d8\u05d9\u05dd \u05de\u05dc\u05d0\u05d9\u05dd \u05d5\u05dc\u05d0 \u05dc\u05d4\u05e6\u05d8\u05d1\u05e8 \u05d0\u05d9\u05ea\u05dd (StahlNeuro p.559)."
        },
        {
          "text": "\u05d7\u05e1\u05d9\u05de\u05d4 \u05e9\u05dc \u05d4\u05e9\u05e4\u05e2\u05ea \u05d4-Heroin \u05dc\u05dc\u05d0 \u05e9\u05d9\u05e0\u05d5\u05d9 \u05d1\u05ea\u05d7\u05d5\u05e9\u05ea \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05d1\u05e9\u05dc \u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05d4-Naloxone.",
          "isCorrect": false,
          "rationale": "Naloxone \u05d0\u05d9\u05e0\u05d5 \u05e0\u05e1\u05e4\u05d2 \u05d1\u05e0\u05d8\u05d9\u05dc\u05d4 \u05ea\u05ea-\u05dc\u05e9\u05d5\u05e0\u05d9\u05ea \u05d5\u05d0\u05d9\u05e0\u05d5 \u05de\u05e9\u05e4\u05d9\u05e2 \u05d1\u05d3\u05e8\u05da \u05d6\u05d5; \u05d4\u05e9\u05d9\u05e0\u05d5\u05d9 \u05d1\u05ea\u05d7\u05d5\u05e9\u05d4 \u05e0\u05d5\u05d1\u05e2 \u05de\u05d4\u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05d4\u05d7\u05dc\u05e7\u05d9\u05ea \u05e9\u05dc Buprenorphine (Dulcan p.234)."
        },
        {
          "text": "\u05e9\u05d9\u05e4\u05d5\u05e8 \u05de\u05d9\u05d9\u05d3\u05d9 \u05d1\u05ea\u05e9\u05d5\u05e7\u05d4 (Craving) \u05dc\u05de\u05e0\u05d4 \u05d4\u05d1\u05d0\u05d4 \u05e9\u05dc Heroin.",
          "isCorrect": false,
          "rationale": "\u05de\u05ea\u05df \u05de\u05d5\u05e7\u05d3\u05dd \u05de\u05d3\u05d9, \u05dc\u05e4\u05e0\u05d9 \u05d4\u05d5\u05e4\u05e2\u05ea \u05e1\u05d9\u05de\u05e0\u05d9 \u05d2\u05de\u05d9\u05dc\u05d4 \u05e4\u05e2\u05d9\u05dc\u05d9\u05dd (COWS), \u05d9\u05d7\u05de\u05d9\u05e8 \u05d0\u05ea \u05d4\u05de\u05e6\u05d1 \u05d1\u05de\u05e7\u05d5\u05dd \u05dc\u05e9\u05e4\u05e8 \u05d0\u05ea \u05d4\u05db\u05de\u05d9\u05d4\u05d4 (DSM p.618)."
        }
      ],
      "hint": "\u05d4\u05ea\u05d9\u05d9\u05d7\u05e1 \u05dc\u05de\u05d5\u05e9\u05d2 \u05d4\u05d6\u05d9\u05e7\u05d4 \u05d4\u05d2\u05d1\u05d5\u05d4\u05d4 \u05dc\u05e7\u05d5\u05dc\u05d8\u05df \u05de\u05d5\u05dc \u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05d0\u05d9\u05e0\u05d8\u05e8\u05d9\u05e0\u05d6\u05d9\u05ea \u05d7\u05dc\u05e7\u05d9\u05ea.",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05e4\u05e2\u05d5\u05d8 \u05d1\u05df 3 \u05d4\u05d5\u05d1\u05d0 \u05dc\u05d7\u05d3\u05e8 \u05de\u05d9\u05d5\u05df \u05dc\u05d0\u05d7\u05e8 \u05e9\u05d1\u05dc\u05e2 \u05d1\u05d8\u05e2\u05d5\u05ea \u05db\u05de\u05d5\u05ea \u05dc\u05d0 \u05d9\u05d3\u05d5\u05e2\u05d4 \u05e9\u05dc \u05ea\u05de\u05d9\u05e1\u05ea Methadone \u05e9\u05dc \u05d0\u05d1\u05d9\u05d5. \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05e0\u05de\u05e6\u05d0 \u05d1\u05ea\u05e8\u05d3\u05de\u05ea \u05e2\u05dd \u05d0\u05d9\u05e9\u05d5\u05e0\u05d9 \u05e1\u05d9\u05db\u05d4 \u05d5\u05d3\u05d9\u05db\u05d5\u05d9 \u05e0\u05e9\u05d9\u05de\u05ea\u05d9 \u05e7\u05e9\u05d4. \u05d4\u05e6\u05d5\u05d5\u05ea \u05e0\u05ea\u05df Naloxone $2\\text{ mg}$ \u05d1\u05de\u05ea\u05df IV, \u05d5\u05d4\u05e4\u05e2\u05d5\u05d8 \u05d4\u05ea\u05e2\u05d5\u05e8\u05e8 \u05d5\u05d4\u05d7\u05dc \u05dc\u05e0\u05e9\u05d5\u05dd \u05d1\u05d0\u05d5\u05e4\u05df \u05e1\u05d3\u05d9\u05e8. \u05de\u05d4\u05d9 \u05d4\u05d4\u05e0\u05d7\u05d9\u05d4 \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05d4\u05de\u05d7\u05d9\u05d9\u05d1\u05ea \u05dc\u05e0\u05d9\u05d4\u05d5\u05dc \u05d4\u05d4\u05de\u05e9\u05db\u05d9 \u05d1\u05e9\u05e2\u05d5\u05ea \u05d4\u05e7\u05e8\u05d5\u05d1\u05d5\u05ea?",
      "answerOptions": [
        {
          "text": "\u05e0\u05d9\u05d8\u05d5\u05e8 \u05e8\u05e6\u05d9\u05e3 \u05d1\u05d7\u05d3\u05e8 \u05d4\u05de\u05d9\u05d5\u05df \u05dc\u05de\u05e9\u05da 4 \u05e9\u05e2\u05d5\u05ea \u05dc\u05e4\u05d7\u05d5\u05ea \u05d1\u05e9\u05dc \u05e1\u05db\u05e0\u05ea Renarcotization.",
          "isCorrect": true,
          "rationale": "\u05d6\u05de\u05df \u05de\u05d7\u05e6\u05d9\u05ea \u05d4\u05d7\u05d9\u05d9\u05dd \u05e9\u05dc Naloxone ($30-90$ \u05d3\u05e7\u05d5\u05ea) \u05e7\u05e6\u05e8 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05de\u05d6\u05d4 \u05e9\u05dc Methadone, \u05de\u05d4 \u05e9\u05e2\u05dc\u05d5\u05dc \u05dc\u05d4\u05d5\u05d1\u05d9\u05dc \u05dc\u05d7\u05d6\u05e8\u05ea \u05d4\u05d3\u05d9\u05db\u05d5\u05d9 \u05d4\u05e0\u05e9\u05d9\u05de\u05ea\u05d9 \u05d1\u05e8\u05d2\u05e2 \u05e9\u05d4\u05e0\u05dc\u05d5\u05e7\u05e1\u05d5\u05df \u05d9\u05ea\u05e4\u05e0\u05d4 (DSM p.616, StahlNeuro p.560)."
        },
        {
          "text": "\u05e9\u05d7\u05e8\u05d5\u05e8 \u05dc\u05d1\u05d9\u05ea \u05dc\u05d0\u05d7\u05e8 \u05e9\u05e2\u05d4 \u05e9\u05dc \u05d9\u05e6\u05d9\u05d1\u05d5\u05ea \u05e0\u05e9\u05d9\u05de\u05ea\u05d9\u05ea, \u05e9\u05db\u05df Naloxone \u05d4\u05d5\u05e4\u05da \u05d0\u05ea \u05d4\u05d4\u05e8\u05e2\u05dc\u05d4 \u05dc\u05e6\u05de\u05d9\u05ea\u05d5\u05ea.",
          "isCorrect": false,
          "rationale": "Naloxone \u05e4\u05d5\u05e2\u05dc \u05db\u05d0\u05e0\u05d8\u05d2\u05d5\u05e0\u05d9\u05e1\u05d8 \u05ea\u05d7\u05e8\u05d5\u05ea\u05d9 \u05d6\u05de\u05e0\u05d9 \u05d1\u05dc\u05d1\u05d3 \u05d5\u05d0\u05d9\u05e0\u05d5 \u05de\u05e4\u05e0\u05d4 \u05d0\u05ea \u05d4\u05d0\u05d5\u05e4\u05d9\u05d5\u05d0\u05d9\u05d3 \u05de\u05d4\u05d2\u05d5\u05e3 (StahlNeuro p.560)."
        },
        {
          "text": "\u05de\u05ea\u05df \u05de\u05e0\u05d4 \u05e9\u05dc \u05e4\u05d7\u05dd \u05e4\u05e2\u05d9\u05dc (Activated Charcoal) \u05db\u05e7\u05d5 \u05e8\u05d0\u05e9\u05d5\u05df \u05dc\u05de\u05e0\u05d9\u05e2\u05ea \u05e1\u05e4\u05d9\u05d2\u05d4 \u05d7\u05d5\u05d6\u05e8\u05ea.",
          "isCorrect": false,
          "rationale": "\u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05de\u05d9\u05d9\u05d3\u05d9 \u05d1\u05d4\u05e8\u05e2\u05dc\u05ea \u05d0\u05d5\u05e4\u05d9\u05d5\u05d0\u05d9\u05d3\u05d9\u05dd \u05d4\u05d5\u05d0 \u05ea\u05de\u05d9\u05db\u05d4 \u05e0\u05e9\u05d9\u05de\u05ea\u05d9\u05ea \u05d5\u05d0\u05e0\u05d8\u05d2\u05d5\u05e0\u05d9\u05d6\u05dd \u05dc\u05e7\u05d5\u05dc\u05d8\u05e0\u05d9\u05dd, \u05d5\u05dc\u05d0 \u05de\u05e0\u05d9\u05e2\u05ea \u05e1\u05e4\u05d9\u05d2\u05d4 \u05db\u05e9\u05d4\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05db\u05d1\u05e8 \u05e1\u05d5\u05e2\u05e8\u05d9\u05dd (StahlNeuro p.560)."
        },
        {
          "text": "\u05d4\u05ea\u05d7\u05dc\u05ea \u05e2\u05d9\u05e8\u05d5\u05d9 \u05e8\u05e6\u05d9\u05e3 \u05e9\u05dc Flumazenil \u05dc\u05de\u05e0\u05d9\u05e2\u05ea \u05e9\u05e7\u05d9\u05e2\u05d4 \u05d7\u05d5\u05d6\u05e8\u05ea \u05d1\u05de\u05e6\u05d1 \u05d4\u05d4\u05db\u05e8\u05d4.",
          "isCorrect": false,
