    {
      "type": "multiple_choice",
      "question": "\u05d1\u05de\u05e1\u05d2\u05e8\u05ea \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-MAT, \u05de\u05d8\u05d5\u05e4\u05dc \u05e9\u05d5\u05d0\u05dc \u05de\u05d3\u05d5\u05e2 \u05e2\u05dc\u05d9\u05d5 \u05dc\u05d4\u05e9\u05ea\u05de\u05e9 \u05d1-Suboxone (Buprenorphine/Naloxone) \u05d5\u05dc\u05d0 \u05d1-Buprenorphine \u05dc\u05d1\u05d3\u05d5 (Subutex). \u05de\u05d4\u05d5 \u05d4\u05d4\u05e1\u05d1\u05e8 \u05d4\u05de\u05d3\u05d5\u05d9\u05e7 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05d2\u05d1\u05d9 \u05ea\u05e4\u05e7\u05d9\u05d3 \u05d4-Naloxone \u05d1\u05ea\u05db\u05e9\u05d9\u05e8 \u05d4\u05de\u05e9\u05d5\u05dc\u05d1?",
      "answerOptions": [
        {
          "text": "\u05d4\u05d5\u05d0 \u05e0\u05d5\u05e2\u05d3 \u05dc\u05d4\u05e9\u05e8\u05d5\u05ea \u05d2\u05de\u05d9\u05dc\u05d4 \u05de\u05d9\u05d9\u05d3\u05d9\u05ea \u05d1\u05de\u05d9\u05d3\u05d4 \u05d5\u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05d9\u05e0\u05e1\u05d4 \u05dc\u05d4\u05d6\u05e8\u05d9\u05e7 \u05d0\u05ea \u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 IV.",
          "isCorrect": true,
          "rationale": "Naloxone \u05db\u05de\u05e2\u05d8 \u05d5\u05d0\u05d9\u05e0\u05d5 \u05e0\u05e1\u05e4\u05d2 \u05d1\u05e0\u05d8\u05d9\u05dc\u05d4 \u05ea\u05ea-\u05dc\u05e9\u05d5\u05e0\u05d9\u05ea, \u05d0\u05da \u05d1\u05d4\u05d6\u05e8\u05e7\u05d4 \u05ea\u05d5\u05da-\u05d5\u05e8\u05d9\u05d3\u05d9\u05ea \u05d4\u05d5\u05d0 \u05d4\u05d5\u05e4\u05da \u05dc\u05e4\u05e2\u05d9\u05dc \u05d5\u05d7\u05d5\u05e1\u05dd \u05d0\u05ea \u05d4\u05e9\u05e4\u05e2\u05ea \u05d4-Buprenorphine (Dulcan p.234, StahlNeuro p.559)."
        },
        {
          "text": "\u05d4\u05d5\u05d0 \u05de\u05e9\u05de\u05e9 \u05db\u05d0\u05d2\u05d5\u05e0\u05d9\u05e1\u05d8 \u05d7\u05dc\u05e7\u05d9 \u05d4\u05de\u05d2\u05d1\u05d9\u05e8 \u05d0\u05ea \u05d4\u05d0\u05e4\u05e7\u05d8 \u05d4\u05d0\u05e0\u05dc\u05d2\u05d8\u05d9 \u05e9\u05dc \u05d4-Buprenorphine.",
          "isCorrect": false,
          "rationale": "Naloxone \u05d4\u05d5\u05d0 \u05d0\u05e0\u05d8\u05d2\u05d5\u05e0\u05d9\u05e1\u05d8 \u05de\u05dc\u05d0 \u05d5\u05d8\u05d4\u05d5\u05e8, \u05d5\u05d0\u05d9\u05df \u05dc\u05d5 \u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05d0\u05d2\u05d5\u05e0\u05d9\u05e1\u05d8\u05d9\u05ea \u05db\u05dc\u05dc (StahlNeuro p.560)."
        },
        {
          "text": "\u05d4\u05d5\u05d0 \u05de\u05d5\u05e0\u05e2 \u05d0\u05ea \u05ea\u05d5\u05e4\u05e2\u05ea \u05d4\u05dc\u05d5\u05d5\u05d0\u05d9 \u05e9\u05dc \u05e2\u05e6\u05d9\u05e8\u05d5\u05ea (Constipation) \u05d4\u05e0\u05d2\u05e8\u05de\u05ea \u05de\u05d4-Buprenorphine.",
          "isCorrect": false,
          "rationale": "\u05d1\u05de\u05d9\u05e0\u05d5\u05df \u05d4\u05ea\u05ea-\u05dc\u05e9\u05d5\u05e0\u05d9 \u05e9\u05d1\u05d5 \u05d4\u05d5\u05d0 \u05e0\u05e1\u05e4\u05d2, Naloxone \u05d0\u05d9\u05e0\u05d5 \u05de\u05e9\u05e4\u05d9\u05e2 \u05e2\u05dc \u05ea\u05e4\u05e7\u05d5\u05d3 \u05d4\u05de\u05e2\u05d9\u05d9\u05dd \u05d1\u05d0\u05d5\u05e4\u05df \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9 (Dulcan p.235)."
        },
        {
          "text": "\u05d4\u05d5\u05d0 \u05de\u05d0\u05e8\u05d9\u05da \u05d0\u05ea \u05d6\u05de\u05df \u05de\u05d7\u05e6\u05d9\u05ea \u05d4\u05d7\u05d9\u05d9\u05dd \u05e9\u05dc \u05d4-Buprenorphine \u05d3\u05e8\u05da \u05e2\u05d9\u05db\u05d5\u05d1 \u05d0\u05e0\u05d6\u05d9\u05de\u05d9 CYP2D6.",
          "isCorrect": false,
          "rationale": "\u05d0\u05d9\u05df \u05d0\u05d9\u05e0\u05d8\u05e8\u05d0\u05e7\u05e6\u05d9\u05d4 \u05e4\u05e8\u05de\u05e7\u05d5\u05e7\u05d9\u05e0\u05d8\u05d9\u05ea \u05db\u05d6\u05d5 \u05d1\u05d9\u05df \u05d4\u05e9\u05e0\u05d9\u05d9\u05dd; Buprenorphine \u05e2\u05d5\u05d1\u05e8 \u05de\u05d8\u05d1\u05d5\u05dc\u05d9\u05d6\u05dd \u05d1\u05e2\u05d9\u05e7\u05e8 \u05d3\u05e8\u05da CYP3A4 (StahlKids p.301, StahlNeuro p.559)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05dc\u05de\u05e0\u05d9\u05e2\u05ea \u05e9\u05d9\u05de\u05d5\u05e9 \u05dc\u05e8\u05e2\u05d4 (Abuse deterrence) \u05d1\u05ea\u05db\u05e9\u05d9\u05e8\u05d9\u05dd \u05de\u05e9\u05d5\u05dc\u05d1\u05d9\u05dd.",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05d0\u05d9\u05e9\u05d4 \u05d1\u05ea 35 \u05d4\u05e1\u05d5\u05d1\u05dc\u05ea \u05de\u05db\u05d0\u05d1 \u05d2\u05d1 \u05db\u05e8\u05d5\u05e0\u05d9 \u05de\u05d8\u05d5\u05e4\u05dc\u05ea \u05d1-Oxycodone \u05d1\u05de\u05d9\u05e0\u05d5\u05df \u05e7\u05d1\u05d5\u05e2 \u05dc\u05e4\u05d9 \u05d4\u05d5\u05e8\u05d0\u05d5\u05ea \u05e8\u05d5\u05e4\u05d0 \u05d4\u05db\u05d0\u05d1 \u05e9\u05dc\u05d4 \u05de\u05d6\u05d4 \u05e9\u05e0\u05ea\u05d9\u05d9\u05dd. \u05d4\u05d9\u05d0 \u05de\u05d3\u05d5\u05d5\u05d7\u05ea \u05db\u05d9 \u05d0\u05dd \u05d4\u05d9\u05d0 \u05de\u05e4\u05e1\u05e4\u05e1\u05ea \u05de\u05e0\u05d4, \u05d4\u05d9\u05d0 \u05d7\u05e9\u05d4 \u05e6\u05de\u05e8\u05de\u05d5\u05e8\u05d5\u05ea, \u05db\u05d0\u05d1\u05d9 \u05e9\u05e8\u05d9\u05e8\u05d9\u05dd \u05d5\u05d7\u05e8\u05d3\u05d4. \u05d4\u05d9\u05d0 \u05de\u05e2\u05d5\u05dc\u05dd \u05dc\u05d0 \u05d4\u05e9\u05ea\u05de\u05e9\u05d4 \u05d1\u05ea\u05e8\u05d5\u05e4\u05d4 \u05de\u05e2\u05d1\u05e8 \u05dc\u05de\u05d9\u05e0\u05d5\u05df \u05e9\u05e0\u05e8\u05e9\u05dd \u05dc\u05d4 \u05d5\u05dc\u05d0 \u05d7\u05d5\u05d5\u05ea\u05d4 \u05e4\u05d2\u05d9\u05e2\u05d4 \u05d1\u05ea\u05e4\u05e7\u05d5\u05d3. \u05d4\u05d0\u05dd \u05d4\u05d9\u05d0 \u05e2\u05d5\u05e0\u05d4 \u05e2\u05dc \u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05dc\u05d0\u05d1\u05d7\u05e0\u05ea Opioid Use Disorder \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR?",
      "answerOptions": [
        {
          "text": "\u05dc\u05d0, \u05de\u05db\u05d9\u05d5\u05d5\u05df \u05e9\u05e1\u05d1\u05d9\u05dc\u05d5\u05ea (Tolerance) \u05d5\u05d2\u05de\u05d9\u05dc\u05d4 (Withdrawal) \u05d0\u05d9\u05e0\u05df \u05e0\u05e1\u05e4\u05e8\u05d5\u05ea \u05db\u05d0\u05e9\u05e8 \u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 \u05e0\u05dc\u05e7\u05d7\u05ea \u05ea\u05d7\u05ea \u05e4\u05d9\u05e7\u05d5\u05d7 \u05e8\u05e4\u05d5\u05d0\u05d9 \u05d4\u05d5\u05dc\u05dd.",
          "isCorrect": true,
          "rationale": "\u05d4\u05e2\u05e8\u05ea \u05d4-DSM \u05de\u05e6\u05d9\u05d9\u05e0\u05ea \u05de\u05e4\u05d5\u05e8\u05e9\u05d5\u05ea \u05db\u05d9 \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05e9\u05dc \u05e1\u05d1\u05d9\u05dc\u05d5\u05ea \u05d5\u05d2\u05de\u05d9\u05dc\u05d4 \u05d0\u05d9\u05e0\u05dd \u05d7\u05dc\u05d9\u05dd \u05e2\u05dc \u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd \u05d4\u05e0\u05d5\u05d8\u05dc\u05d9\u05dd \u05d0\u05d5\u05e4\u05d9\u05d5\u05d0\u05d9\u05d3\u05d9\u05dd \u05d0\u05da \u05d5\u05e8\u05e7 \u05dc\u05de\u05d8\u05e8\u05d5\u05ea \u05e8\u05e4\u05d5\u05d0\u05d9\u05d5\u05ea \u05dc\u05d2\u05d9\u05d8\u05d9\u05de\u05d9\u05d5\u05ea (DSM p.547, DSM p.610)."
        },
        {
          "text": "\u05db\u05df, \u05e2\u05e6\u05dd \u05e0\u05d5\u05db\u05d7\u05d5\u05ea\u05d4 \u05e9\u05dc \u05ea\u05e1\u05de\u05d5\u05e0\u05ea \u05d2\u05de\u05d9\u05dc\u05d4 \u05e4\u05d9\u05d6\u05d9\u05ea \u05de\u05e2\u05d9\u05d3\u05d4 \u05e2\u05dc \u05d4\u05ea\u05de\u05de\u05de\u05e9\u05d5\u05ea \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4.",
          "isCorrect": false,
          "rationale": "\u05ea\u05dc\u05d5\u05ea \u05e4\u05d9\u05d6\u05d9\u05ea \u05d4\u05d9\u05d0 \u05ea\u05d5\u05e4\u05e2\u05d4 \u05e4\u05e8\u05de\u05e7\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea \u05e6\u05e4\u05d5\u05d9\u05d4 \u05d5\u05d0\u05d9\u05e0\u05d4 \u05e9\u05d5\u05d5\u05d4 \u05dc\u05d0\u05d1\u05d7\u05e0\u05d4 \u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05e9\u05dc \u05d4\u05e4\u05e8\u05e2\u05ea \u05e9\u05d9\u05de\u05d5\u05e9 (Addiction) \u05dc\u05dc\u05d0 \u05de\u05e8\u05db\u05d9\u05d1\u05d9\u05dd \u05e9\u05dc \u05d0\u05d5\u05d1\u05d3\u05df \u05e9\u05dc\u05d9\u05d8\u05d4 (DSM p.547)."
        },
        {
          "text": "\u05db\u05df, \u05de\u05db\u05d9\u05d5\u05d5\u05df \u05e9\u05de\u05e9\u05da \u05d4\u05e9\u05d9\u05de\u05d5\u05e9 (\u05e9\u05e0\u05ea\u05d9\u05d9\u05dd) \u05e2\u05d5\u05dc\u05d4 \u05e2\u05dc \u05ea\u05e7\u05d5\u05e4\u05ea \u05d4\u05e1\u05e3 \u05d4\u05e0\u05d3\u05e8\u05e9\u05ea \u05dc\u05d0\u05d1\u05d7\u05e0\u05d4.",
          "isCorrect": false,
          "rationale": "\u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df \u05d4\u05d6\u05de\u05e0\u05d9 \u05d4\u05d5\u05d0 \u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05d1\u05ea\u05d5\u05da \u05ea\u05e7\u05d5\u05e4\u05d4 \u05e9\u05dc 12 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd, \u05d0\u05da \u05d0\u05d5\u05e8\u05da \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05dc\u05d1\u05d3\u05d5 \u05d0\u05d9\u05e0\u05d5 \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df \u05dc\u05d0\u05d1\u05d7\u05e0\u05d4 (DSM p.610)."
        },
        {
          "text": "\u05dc\u05d0, \u05de\u05db\u05d9\u05d5\u05d5\u05df \u05e9-Oxycodone \u05de\u05d5\u05d2\u05d3\u05e8 \u05db\u05d0\u05d5\u05e4\u05d9\u05d5\u05d0\u05d9\u05d3 \u05d7\u05dc\u05e9 \u05d9\u05d7\u05e1\u05d9\u05ea \u05e9\u05d0\u05d9\u05e0\u05d5 \u05d2\u05d5\u05e8\u05dd \u05dc\u05d4\u05e4\u05e8\u05e2\u05ea \u05e9\u05d9\u05de\u05d5\u05e9.",
          "isCorrect": false,
          "rationale": "Oxycodone \u05d4\u05d5\u05d0 \u05d0\u05d5\u05e4\u05d9\u05d5\u05d0\u05d9\u05d3 \u05e1\u05d9\u05e0\u05ea\u05d8\u05d9 \u05d1\u05e2\u05dc \u05e4\u05d5\u05d8\u05e0\u05e6\u05d9\u05d0\u05dc \u05d4\u05ea\u05de\u05db\u05e8\u05d5\u05ea \u05d2\u05d1\u05d5\u05d4 \u05de\u05d0\u05d5\u05d3 \u05d4\u05e0\u05db\u05dc\u05dc \u05d1\u05e7\u05d1\u05d5\u05e6\u05ea \u05d4\u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05d1-OUD (DSM p.611)."
        }
      ],
      "hint": "\u05d7\u05e4\u05e9 \u05d0\u05ea \u05d4-'Note' \u05d4\u05de\u05d9\u05d5\u05d7\u05d3 \u05d4\u05de\u05d5\u05e4\u05d9\u05e2 \u05ea\u05d7\u05ea \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd 10 \u05d5-11 \u05d1\u05d0\u05d1\u05d7\u05e0\u05ea OUD.",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05de\u05d8\u05d5\u05e4\u05dc \u05d1\u05df 17 \u05d4\u05e0\u05de\u05e6\u05d0 \u05d1\u05ea\u05d4\u05dc\u05d9\u05da \u05d3\u05d8\u05d5\u05e7\u05e1\u05d9\u05e4\u05d9\u05e7\u05e6\u05d9\u05d4 \u05de\u05d0\u05d5\u05e4\u05d9\u05d5\u05d0\u05d9\u05d3\u05d9\u05dd \u05de\u05e7\u05d1\u05dc Clonidine \u05dc\u05e0\u05d9\u05d4\u05d5\u05dc \u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05e9\u05dc \u05d2\u05de\u05d9\u05dc\u05d4. \u05d4\u05d0\u05d7\u05d5\u05ea \u05de\u05d3\u05d5\u05d5\u05d7\u05ea \u05db\u05d9 \u05dc\u05d7\u05e5 \u05d4\u05d3\u05dd \u05e9\u05dc \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05d4\u05d5\u05d0 $88/58\\text{ mmHg}$ \u05d5\u05d4\u05d3\u05d5\u05e4\u05e7 \u05d4\u05d5\u05d0 $54\\text{ bpm}$. \u05de\u05d4\u05d9 \u05d4\u05e4\u05e2\u05d5\u05dc\u05d4 \u05d4\u05e0\u05d3\u05e8\u05e9\u05ea \u05dc\u05e4\u05d9 \u05d4\u05e0\u05d7\u05d9\u05d5\u05ea \u05d4-StahlKids?",
      "answerOptions": [
        {
          "text": "\u05d9\u05e9 \u05dc\u05e2\u05db\u05d1 (Hold) \u05d0\u05ea \u05d4\u05de\u05e0\u05d4 \u05d4\u05d1\u05d0\u05d4 \u05e9\u05dc \u05d4-Clonidine \u05d5\u05dc\u05d3\u05d5\u05d5\u05d7 \u05dc\u05e8\u05d5\u05e4\u05d0.",
          "isCorrect": true,
          "rationale": "\u05d4\u05e0\u05d7\u05d9\u05d5\u05ea \u05d4\u05d8\u05d9\u05d8\u05e8\u05e6\u05d9\u05d4 \u05de\u05d7\u05d9\u05d9\u05d1\u05d5\u05ea \u05dc\u05e2\u05db\u05d1 \u05de\u05e0\u05d4 \u05d0\u05dd \u05dc\u05d7\u05e5 \u05d4\u05d3\u05dd \u05d9\u05d5\u05e8\u05d3 \u05de\u05ea\u05d7\u05ea \u05dc- $90/60\\text{ mmHg}$ \u05d0\u05d5 \u05d1\u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05d1\u05e8\u05d3\u05d9\u05e7\u05e8\u05d3\u05d9\u05d4 (StahlKids p.144)."
        },
        {
          "text": "\u05d9\u05e9 \u05dc\u05ea\u05ea \u05d0\u05ea \u05d4\u05de\u05e0\u05d4 \u05db\u05e8\u05d2\u05d9\u05dc, \u05e9\u05db\u05df \u05d0\u05dc\u05d5 \u05e2\u05e8\u05db\u05d9\u05dd \u05e6\u05e4\u05d5\u05d9\u05d9\u05dd \u05d1\u05ea\u05d4\u05dc\u05d9\u05da \u05d2\u05de\u05d9\u05dc\u05d4.",
          "isCorrect": false,
          "rationale": "\u05e2\u05e8\u05db\u05d9\u05dd \u05d0\u05dc\u05d5 \u05de\u05d4\u05d5\u05d5\u05d9\u05dd \u05ea\u05d5\u05e4\u05e2\u05ea \u05dc\u05d5\u05d5\u05d0\u05d9 \u05de\u05e1\u05d5\u05db\u05e0\u05ea \u05e9\u05dc Clonidine (\u05ea\u05ea-\u05dc\u05d7\u05e5 \u05d3\u05dd \u05d5\u05d1\u05e8\u05d3\u05d9\u05e7\u05e8\u05d3\u05d9\u05d4) \u05d5\u05de\u05d7\u05d9\u05d9\u05d1\u05d9\u05dd \u05d4\u05ea\u05e2\u05e8\u05d1\u05d5\u05ea (StahlKids p.143)."
        },
        {
          "text": "\u05d9\u05e9 \u05dc\u05d4\u05d7\u05dc\u05d9\u05e3 \u05d0\u05ea \u05d4-Clonidine \u05de\u05d9\u05d9\u05d3\u05d9\u05ea \u05d1-Methadone \u05d1\u05de\u05d9\u05e0\u05d5\u05df \u05e0\u05de\u05d5\u05da.",
          "isCorrect": false,
          "rationale": "\u05d4\u05d7\u05dc\u05e4\u05ea \u05ea\u05e8\u05d5\u05e4\u05d4 \u05dc-Methadone \u05d3\u05d5\u05e8\u05e9\u05ea \u05e4\u05e8\u05d5\u05d8\u05d5\u05e7\u05d5\u05dc OTP \u05d5\u05d0\u05d9\u05e0\u05d4 \u05ea\u05d2\u05d5\u05d1\u05d4 \u05d4\u05d5\u05dc\u05de\u05ea \u05dc\u05e9\u05d9\u05e0\u05d5\u05d9 \u05d4\u05de\u05d5\u05d3\u05d9\u05e0\u05de\u05d9 \u05d7\u05e8\u05d9\u05e3 (Dulcan p.234)."
        },
        {
          "text": "\u05d9\u05e9 \u05dc\u05d4\u05e2\u05dc\u05d5\u05ea \u05d0\u05ea \u05de\u05d9\u05e0\u05d5\u05df \u05d4-Clonidine \u05db\u05d3\u05d9 \u05dc\u05de\u05e0\u05d5\u05e2 Rebound Hypertension.",
          "isCorrect": false,
          "rationale": "\u05d9\u05ea\u05e8 \u05dc\u05d7\u05e5 \u05d3\u05dd \u05e8\u05d1\u05d0\u05d5\u05e0\u05d3 \u05de\u05ea\u05e8\u05d7\u05e9 \u05d1\u05e2\u05ea \u05d4\u05e4\u05e1\u05e7\u05d4 \u05e4\u05ea\u05d0\u05d5\u05de\u05d9\u05ea, \u05d0\u05da \u05d4\u05e2\u05dc\u05d0\u05ea \u05de\u05d9\u05e0\u05d5\u05df \u05db\u05e9\u05dc\u05d7\u05e5 \u05d4\u05d3\u05dd \u05db\u05d1\u05e8 \u05e0\u05de\u05d5\u05da \u05ea\u05d7\u05de\u05d9\u05e8 \u05d0\u05ea \u05d4\u05de\u05e6\u05d1 \u05d1\u05d0\u05d5\u05e4\u05df \u05de\u05e1\u05d5\u05db\u05df (StahlKids p.144)."
        }
      ],
      "hint": "\u05de\u05d4\u05df \u05de\u05d2\u05d1\u05dc\u05d5\u05ea \u05d4\u05d1\u05d8\u05d9\u05d7\u05d5\u05ea (Hold parameters) \u05e2\u05d1\u05d5\u05e8 \u05d0\u05d2\u05d5\u05e0\u05d9\u05e1\u05d8\u05d9\u05dd \u05e9\u05dc \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 $\\alpha_2$?",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05de\u05d4\u05d5 \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05de\u05d5\u05dc\u05e7\u05d5\u05dc\u05e8\u05d9 \u05d4\u05de\u05e1\u05d1\u05d9\u05e8 \u05de\u05d3\u05d5\u05e2 Buprenorphine \u05e0\u05d7\u05e9\u05d1 \u05dc\u05d1\u05d8\u05d5\u05d7 \u05d9\u05d5\u05ea\u05e8 \u05de-Methadone \u05de\u05d1\u05d7\u05d9\u05e0\u05ea \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05d3\u05d9\u05db\u05d5\u05d9 \u05e0\u05e9\u05d9\u05de\u05ea\u05d9 \u05e7\u05d8\u05dc\u05e0\u05d9 \u05d1\u05de\u05e0\u05ea \u05d9\u05ea\u05e8 (Overdose)?",
      "answerOptions": [
        {
          "text": "\u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05e9\u05dc \u05d0\u05e4\u05e7\u05d8 '\u05ea\u05e7\u05e8\u05d4' (Ceiling effect) \u05e2\u05dc \u05d4\u05e4\u05e2\u05dc\u05ea \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 $\\mu$.",
          "isCorrect": true,
          "rationale": "\u05db\u05d0\u05d2\u05d5\u05e0\u05d9\u05e1\u05d8 \u05d7\u05dc\u05e7\u05d9, Buprenorphine \u05d0\u05d9\u05e0\u05d5 \u05de\u05d2\u05d9\u05e2 \u05dc\u05d0\u05d5\u05ea\u05d4 \u05e8\u05de\u05ea \u05d4\u05e4\u05e2\u05dc\u05d4 \u05de\u05e7\u05e1\u05d9\u05de\u05dc\u05d9\u05ea \u05e9\u05dc \u05d4\u05e2\u05d1\u05e8\u05ea \u05d0\u05d5\u05ea\u05d5\u05ea \u05ea\u05d5\u05da-\u05ea\u05d0\u05d9\u05ea \u05db\u05de\u05d5 \u05d0\u05d2\u05d5\u05e0\u05d9\u05e1\u05d8 \u05de\u05dc\u05d0, \u05de\u05d4 \u05e9\u05de\u05d2\u05d1\u05d9\u05dc \u05d0\u05ea \u05d4\u05e9\u05e4\u05e2\u05ea\u05d5 \u05e2\u05dc \u05de\u05e8\u05db\u05d6 \u05d4\u05e0\u05e9\u05d9\u05de\u05d4 (StahlNeuro p.41, StahlNeuro p.559)."
        },
        {
          "text": "\u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05d0\u05e0\u05d8\u05d2\u05d5\u05e0\u05d9\u05e1\u05d8\u05d9\u05ea \u05d7\u05d6\u05e7\u05d4 \u05e2\u05dc \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 NMDA \u05d4\u05de\u05e2\u05d5\u05e8\u05e8\u05ea \u05e0\u05e9\u05d9\u05de\u05d4.",
          "isCorrect": false,
          "rationale": "Methadone \u05d4\u05d5\u05d0 \u05d6\u05d4 \u05e9\u05e4\u05d5\u05e2\u05dc \u05db\u05d0\u05e0\u05d8\u05d2\u05d5\u05e0\u05d9\u05e1\u05d8 \u05dc-NMDA, \u05d5\u05dc\u05d0 Buprenorphine; \u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05d6\u05d5 \u05d0\u05d9\u05e0\u05d4 \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05e2\u05d9\u05e7\u05e8\u05d9 \u05dc\u05d1\u05d8\u05d9\u05d7\u05d5\u05ea \u05e0\u05e9\u05d9\u05de\u05ea\u05d9\u05ea (StahlNeuro p.559)."
        },
        {
          "text": "\u05d6\u05de\u05df \u05de\u05d7\u05e6\u05d9\u05ea \u05d7\u05d9\u05d9\u05dd \u05e7\u05e6\u05e8 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d4\u05de\u05d5\u05e0\u05e2 \u05d4\u05e6\u05d8\u05d1\u05e8\u05d5\u05ea \u05d1\u05e8\u05e7\u05de\u05d5\u05ea.",
          "isCorrect": false,
          "rationale": "\u05dc-Buprenorphine \u05d9\u05e9 \u05d3\u05d5\u05d5\u05e7\u05d0 \u05d6\u05d9\u05e7\u05d4 \u05d2\u05d1\u05d5\u05d4\u05d4 \u05d5\u05d6\u05de\u05df \u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05d0\u05e8\u05d5\u05da; \u05d4\u05d1\u05d8\u05d9\u05d7\u05d5\u05ea \u05e0\u05d5\u05d1\u05e2\u05ea \u05de\u05d4\u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05d4\u05d0\u05d9\u05e0\u05d8\u05e8\u05d9\u05e0\u05d6\u05d9\u05ea \u05d4\u05d7\u05dc\u05e7\u05d9\u05ea (StahlNeuro p.559)."
        },
        {
          "text": "\u05d7\u05d5\u05e1\u05e8 \u05d9\u05db\u05d5\u05dc\u05ea \u05e9\u05dc \u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 \u05dc\u05d7\u05e6\u05d5\u05ea \u05d0\u05ea \u05de\u05d7\u05e1\u05d5\u05dd \u05d4\u05d3\u05dd-\u05de\u05d5\u05d7 (BBB).",
          "isCorrect": false,
          "rationale": "\u05db\u05dc \u05d4\u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-OUD \u05d7\u05d9\u05d9\u05d1\u05d5\u05ea \u05dc\u05d7\u05e6\u05d5\u05ea \u05d0\u05ea \u05d4-BBB \u05db\u05d3\u05d9 \u05dc\u05e4\u05e2\u05d5\u05dc \u05e2\u05dc \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 \u05d4\u05d0\u05d5\u05e4\u05d9\u05d5\u05d0\u05d9\u05d3\u05d9\u05dd \u05d1\u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05e2\u05e6\u05d1\u05d9\u05dd \u05d4\u05de\u05e8\u05db\u05d6\u05d9\u05ea (StahlNeuro p.559)."
        }
      ],
      "hint": "\u05d4\u05ea\u05de\u05e7\u05d3 \u05d1\u05d4\u05d1\u05d3\u05dc \u05d4\u05e7\u05d9\u05e0\u05d8\u05d9/\u05d3\u05d9\u05e0\u05de\u05d9 \u05d1\u05d9\u05df \u05d0\u05d2\u05d5\u05e0\u05d9\u05e1\u05d8 \u05de\u05dc\u05d0 \u05dc\u05d0\u05d2\u05d5\u05e0\u05d9\u05e1\u05d8 \u05d7\u05dc\u05e7\u05d9.",
