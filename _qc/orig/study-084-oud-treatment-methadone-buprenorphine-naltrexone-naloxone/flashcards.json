{
  "title": "Opioid Flashcards",
  "cards": [
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05e1\u05d9\u05d5\u05d5\u05d2 \u05d4\u05e4\u05e8\u05de\u05e7\u05d5\u05dc\u05d5\u05d2\u05d9 \u05e9\u05dc Methadone \u05d1\u05d9\u05d7\u05e1 \u05dc\u05e7\u05d5\u05dc\u05d8\u05df $\\mu$-opioid?",
      "back": "Full Agonist (\u05d0\u05d2\u05d5\u05e0\u05d9\u05e1\u05d8 \u05de\u05dc\u05d0) (StahlNeuro p.559)."
    },
    {
      "front": "\u05de\u05d3\u05d5\u05e2 Buprenorphine \u05e0\u05d7\u05e9\u05d1 \u05dc\u05d1\u05d8\u05d5\u05d7 \u05d9\u05d5\u05ea\u05e8 \u05de-Methadone \u05d1\u05de\u05e7\u05e8\u05d9\u05dd \u05e9\u05dc \u05de\u05e0\u05ea \u05d9\u05ea\u05e8?",
      "back": "\u05db\u05ea\u05e8\u05d5\u05e4\u05d4 \u05de\u05e7\u05d1\u05d5\u05e6\u05ea \u05d4-Partial Agonists, \u05e7\u05d9\u05d9\u05dd Ceiling effect (\u05d0\u05e4\u05e7\u05d8 \u05ea\u05e7\u05e8\u05d4) \u05e2\u05dc \u05d3\u05d9\u05db\u05d5\u05d9 \u05e0\u05e9\u05d9\u05de\u05ea\u05d9 (StahlNeuro p.559)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05ea\u05e0\u05d0\u05d9 \u05d4\u05de\u05e7\u05d3\u05d9\u05dd \u05d4\u05d4\u05db\u05e8\u05d7\u05d9 (Opioid-free period) \u05dc\u05e4\u05e0\u05d9 \u05d4\u05ea\u05d7\u05dc\u05ea \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Naltrexone?",
      "back": "\u05d4\u05d9\u05e0\u05d6\u05e8\u05d5\u05ea \u05de\u05dc\u05d0\u05d4 \u05de\u05d0\u05d5\u05e4\u05d9\u05d5\u05d0\u05d9\u05d3\u05d9\u05dd \u05dc\u05de\u05e9\u05da $7-10$ \u05d9\u05de\u05d9\u05dd \u05dc\u05e4\u05d7\u05d5\u05ea (Dulcan p.234)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05e8\u05e6\u05d9\u05d5\u05e0\u05dc \u05dc\u05e9\u05d9\u05dc\u05d5\u05d1 Naloxone \u05d1\u05ea\u05d5\u05da \u05d8\u05d1\u05dc\u05d9\u05d9\u05ea \u05d4-Suboxone (\u05e9\u05d9\u05dc\u05d5\u05d1 \u05e2\u05dd Buprenorphine)?",
      "back": "\u05de\u05e0\u05d9\u05e2\u05ea IV abuse; Naloxone \u05d0\u05d9\u05e0\u05d5 \u05e0\u05e1\u05e4\u05d2 \u05ea\u05ea-\u05dc\u05e9\u05d5\u05e0\u05d9\u05ea, \u05d0\u05da \u05d1\u05d4\u05d6\u05e8\u05e7\u05d4 \u05d4\u05d5\u05d0 \u05de\u05e9\u05e8\u05d4 Precipitated withdrawal (StahlNeuro p.559)."
    },
    {
      "front": "\u05d1\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Methadone, \u05d0\u05d9\u05d6\u05d4 \u05e0\u05d9\u05d8\u05d5\u05e8 \u05d0\u05dc\u05e7\u05d8\u05e8\u05d5\u05e4\u05d9\u05d6\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05e0\u05d3\u05e8\u05e9 \u05d1\u05e9\u05dc \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05e7\u05e6\u05d1 \u05e7\u05d8\u05dc\u05e0\u05d9\u05d5\u05ea?",
      "back": "\u05de\u05e2\u05e7\u05d1 ECG \u05ea\u05e7\u05d5\u05e4\u05ea\u05d9 \u05dc\u05e0\u05d9\u05d8\u05d5\u05e8 \u05d4\u05d0\u05e8\u05db\u05ea \u05de\u05e8\u05d5\u05d5\u05d7 QTc (Dulcan p.234)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d2\u05d9\u05dc \u05d4\u05de\u05d9\u05e0\u05d9\u05de\u05d5\u05dd \u05d4\u05de\u05d0\u05d5\u05e9\u05e8 \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d4-FDA \u05dc\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1-Methadone \u05d5\u05d1-Buprenorphine \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-OUD?",
      "back": "\u05d2\u05d9\u05dc $16$ \u05d5\u05de\u05e2\u05dc\u05d4 (Dulcan p.234)."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 Buprenorphine \u05de\u05e9\u05e4\u05d9\u05e2 \u05e2\u05dc \u05d4\u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05d0\u05d5\u05e4\u05d9\u05d5\u05d0\u05d9\u05d3\u05d9\u05ea \u05de\u05e2\u05d1\u05e8 \u05dc\u05d4\u05e4\u05e2\u05dc\u05ea \u05e7\u05d5\u05dc\u05d8\u05df $\\mu$?",
      "back": "\u05d4\u05d5\u05d0 \u05e4\u05d5\u05e2\u05dc \u05db-Antagonist \u05dc\u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 $\\kappa$-opioid, \u05de\u05d4 \u05e9\u05ea\u05d5\u05e8\u05dd \u05dc\u05d4\u05e4\u05d7\u05ea\u05ea \u05d3\u05d9\u05e1\u05e4\u05d5\u05e8\u05d9\u05d4 \u05d5\u05e9\u05d9\u05e4\u05d5\u05e8 \u05de\u05e6\u05d1 \u05e8\u05d5\u05d7 (StahlNeuro p.559)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05e1\u05db\u05e0\u05d4 \u05d4\u05de\u05e8\u05db\u05d6\u05d9\u05ea \u05d1\u05d8\u05d5\u05d5\u05d7 \u05e9\u05dc $30-90$ \u05d3\u05e7\u05d5\u05ea \u05dc\u05d0\u05d7\u05e8 \u05de\u05ea\u05df Naloxone \u05dc\u05d4\u05d7\u05d9\u05d9\u05d0\u05ea \u05de\u05e0\u05ea \u05d9\u05ea\u05e8?",
      "back": "\u05d1\u05e9\u05dc \u05d4-half-life \u05d4\u05e7\u05e6\u05e8 \u05e9\u05dc\u05d5, \u05ea\u05d9\u05ea\u05db\u05df Renarcotization (\u05d7\u05d6\u05e8\u05ea \u05d4\u05d3\u05d9\u05db\u05d5\u05d9 \u05d4\u05e0\u05e9\u05d9\u05de\u05ea\u05d9) \u05d4\u05de\u05d7\u05d9\u05d9\u05d1\u05ea \u05d4\u05e9\u05d2\u05d7\u05d4 \u05e8\u05e4\u05d5\u05d0\u05d9\u05ea (DSM p.616)."
    },
    {
      "front": "\u05de\u05d3\u05d5\u05e2 \u05d7\u05d5\u05d1\u05d4 \u05dc\u05d4\u05de\u05ea\u05d9\u05df \u05dc\u05d4\u05d5\u05e4\u05e2\u05ea \u05ea\u05e1\u05de\u05d9\u05e0\u05d9 \u05d2\u05de\u05d9\u05dc\u05d4 \u05e4\u05e2\u05d9\u05dc\u05d9\u05dd (\u05d2\u05de\u05d9\u05dc\u05d4 \u05e7\u05dc\u05d4-\u05d1\u05d9\u05e0\u05d5\u05e0\u05d9\u05ea) \u05dc\u05e4\u05e0\u05d9 \u05de\u05ea\u05df \u05de\u05e0\u05d4 \u05e8\u05d0\u05e9\u05d5\u05e0\u05d4 \u05e9\u05dc Buprenorphine?",
      "back": "\u05d1\u05e9\u05dc \u05d4-High affinity \u05e9\u05dc\u05d5, \u05d4\u05d5\u05d0 \u05d9\u05d3\u05d7\u05e7 \u05d0\u05d5\u05e4\u05d9\u05d5\u05d0\u05d9\u05d3\u05d9\u05dd \u05e7\u05d9\u05d9\u05de\u05d9\u05dd \u05de\u05d4\u05e7\u05d5\u05dc\u05d8\u05df \u05d5\u05d9\u05e9\u05e8\u05d4 Precipitated withdrawal (DSM p.618)."
    },
    {
      "front": "\u05d0\u05d9\u05dc\u05d5 \u05de\u05d4\u05d0\u05d9\u05d6\u05d5\u05de\u05e8\u05d9\u05dd \u05e9\u05dc Methadone \u05d0\u05d7\u05e8\u05d0\u05d9 \u05e2\u05dc \u05d4\u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05db-Antagonist \u05dc\u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 NMDA?",
      "back": "\u05d4\u05d0\u05d9\u05d6\u05d5\u05de\u05e8 Dextro-methadone (StahlNeuro p.559)."
    },
    {
      "front": "\u05d1\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1-Clonidine \u05dc\u05d4\u05e7\u05dc\u05d4 \u05e2\u05dc \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d0\u05d5\u05d8\u05d5\u05e0\u05d5\u05de\u05d9\u05d9\u05dd \u05d1\u05d2\u05de\u05d9\u05dc\u05d4, \u05de\u05d4\u05d5 \u05e2\u05e8\u05da \u05dc\u05d7\u05e5 \u05d4\u05d3\u05dd \u05e9\u05de\u05ea\u05d7\u05ea\u05d9\u05d5 \u05d9\u05e9 \u05dc\u05d1\u05e6\u05e2 Hold \u05dc\u05de\u05e0\u05d4?",
      "back": "\u05db\u05d0\u05e9\u05e8 \u05dc\u05d7\u05e5 \u05d4\u05d3\u05dd \u05e0\u05de\u05d5\u05da \u05de- $90/60$ mmHg (StahlKids p.143)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05e4\u05e2\u05d5\u05dc\u05d4 \u05e9\u05dc Naltrexone \u05d1\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Alcohol Use Disorder (AUD)?",
      "back": "\u05d7\u05e1\u05d9\u05de\u05ea \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 $\\mu$ \u05de\u05e0\u05d8\u05e8\u05dc\u05ea \u05d0\u05ea \u05e9\u05d7\u05e8\u05d5\u05e8 \u05d4\u05d3\u05d5\u05e4\u05de\u05d9\u05df \u05d4\u05de\u05d5\u05e9\u05e8\u05d4 \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d0\u05e0\u05d3\u05d5\u05e8\u05e4\u05d9\u05e0\u05d9\u05dd \u05d1\u05d6\u05de\u05df \u05e9\u05ea\u05d9\u05d9\u05ea \u05d0\u05dc\u05db\u05d5\u05d4\u05d5\u05dc (StahlNeuro p.555)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05d2\u05d3\u05e8\u05ea 'In early remission' \u05e2\u05d1\u05d5\u05e8 \u05d0\u05d1\u05d7\u05e0\u05ea OUD \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR?",
      "back": "\u05d4\u05d9\u05e2\u05d3\u05e8 \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05d0\u05d1\u05d7\u05e0\u05ea\u05d9\u05d9\u05dd (\u05dc\u05de\u05e2\u05d8 Craving) \u05dc\u05de\u05e9\u05da $3$ \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05dc\u05e4\u05d7\u05d5\u05ea \u05d0\u05da \u05e4\u05d7\u05d5\u05ea \u05de- $12$ \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd (DSM p.610)."
    },
    {
      "front": "\u05d0\u05d9\u05dc\u05d5 \u05ea\u05e8\u05d5\u05e4\u05d5\u05ea Adjuvant \u05de\u05e9\u05de\u05e9\u05d5\u05ea \u05dc\u05d4\u05e4\u05d7\u05ea\u05ea \u05e8\u05e2\u05d3, \u05d4\u05d6\u05e2\u05d4 \u05d5\u05d8\u05db\u05d9\u05e7\u05e8\u05d3\u05d9\u05d4 \u05d1\u05d6\u05de\u05df \u05d2\u05de\u05d9\u05dc\u05d4 \u05de\u05d0\u05d5\u05e4\u05d9\u05d5\u05d0\u05d9\u05d3\u05d9\u05dd?",
      "back": "\u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05de\u05e7\u05d1\u05d5\u05e6\u05ea \u05d4- $\\alpha_2$-adrenergic agonists \u05db\u05d2\u05d5\u05df Clonidine \u05d0\u05d5 Lofexidine (StahlNeuro p.561)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4-Setting \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc\u05d9 \u05d4\u05d9\u05d7\u05d9\u05d3 \u05d4\u05de\u05d5\u05e8\u05e9\u05d4 \u05dc\u05de\u05ea\u05df Methadone \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-OUD \u05d1\u05d0\u05e8\u05d4\"\u05d1?",
      "back": "\u05de\u05e8\u05e4\u05d0\u05d5\u05ea \u05e4\u05d9\u05e7\u05d5\u05d7 \u05d9\u05d9\u05e2\u05d5\u05d3\u05d9\u05d5\u05ea \u05d1\u05dc\u05d1\u05d3 (OTP - Opioid Treatment Programs) \u05ea\u05d7\u05ea \u05d4\u05e9\u05d2\u05d7\u05d4 \u05d9\u05d5\u05de\u05d9\u05ea (Dulcan p.234)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05d4\u05d1\u05d3\u05dc \u05d4\u05de\u05d5\u05e9\u05d2\u05d9 \u05d1\u05d9\u05df Opiate \u05dc-Opioid \u05dc\u05e4\u05d9 StahlNeuro?",
      "back": "Opiate \u05d4\u05d5\u05d0 \u05d7\u05d5\u05de\u05e8 \u05d8\u05d1\u05e2\u05d9 \u05d4\u05de\u05d5\u05e4\u05e7 \u05de\u05e6\u05de\u05d7 \u05d4\u05e4\u05e8\u05d2, \u05d1\u05e2\u05d5\u05d3 Opioid \u05d4\u05d5\u05d0 \u05de\u05d5\u05e0\u05d7 \u05e8\u05d7\u05d1 \u05d4\u05db\u05d5\u05dc\u05dc \u05d7\u05d5\u05de\u05e8\u05d9\u05dd \u05d8\u05d1\u05e2\u05d9\u05d9\u05dd \u05d5\u05e1\u05d9\u05e0\u05ea\u05d8\u05d9\u05d9\u05dd (StahlNeuro p.559)."
    },
    {
      "front": "\u05d0\u05d9\u05d6\u05d4 \u05e0\u05d9\u05d8\u05d5\u05e8 \u05de\u05e2\u05d1\u05d3\u05ea\u05d9 \u05ea\u05e7\u05d5\u05e4\u05ea\u05d9 \u05e0\u05d3\u05e8\u05e9 \u05d1\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Naltrexone \u05d5\u05d1-Buprenorphine?",
      "back": "\u05d1\u05d3\u05d9\u05e7\u05ea \u05ea\u05e4\u05e7\u05d5\u05d3\u05d9 \u05db\u05d1\u05d3 (LFTs) \u05d1\u05e9\u05dc \u05d7\u05e9\u05e9 \u05dc\u05e8\u05e2\u05d9\u05dc\u05d5\u05ea \u05db\u05d1\u05d3\u05d9\u05ea (StahlNeuro p.560)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4-aspect \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05d4\u05de\u05d1\u05d3\u05d9\u05dc \u05d1\u05d9\u05df Naloxone \u05dc-Naltrexone \u05de\u05d1\u05d7\u05d9\u05e0\u05ea \u05e9\u05d9\u05de\u05d5\u05e9 \u05e7\u05dc\u05d9\u05e0\u05d9?",
      "back": "Naloxone \u05de\u05e9\u05de\u05e9 \u05dc\u05d4\u05d7\u05d9\u05d9\u05d0\u05ea \u05d7\u05d9\u05e8\u05d5\u05dd (Overdose reversal), \u05d1\u05e2\u05d5\u05d3 Naltrexone \u05de\u05e9\u05de\u05e9 \u05dc\u05de\u05e0\u05d9\u05e2\u05ea \u05d4\u05d9\u05e9\u05e0\u05d5\u05ea (Relapse prevention) (StahlNeuro p.560)."
    }
  ]
}