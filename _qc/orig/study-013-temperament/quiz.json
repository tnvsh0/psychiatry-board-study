{
  "title": "Temperament Quiz",
  "questions": [
    {
      "question": "\u05d1\u05df $3$ \u05de\u05d5\u05d1\u05d0 \u05dc\u05d4\u05e2\u05e8\u05db\u05d4 \u05e2\u05e7\u05d1 \u05e7\u05e9\u05d9\u05d9\u05dd \u05d1\u05d4\u05e1\u05ea\u05d2\u05dc\u05d5\u05ea \u05dc\u05de\u05e1\u05d2\u05e8\u05ea \u05d4\u05d2\u05df. \u05d4\u05d4\u05d5\u05e8\u05d9\u05dd \u05de\u05ea\u05d0\u05e8\u05d9\u05dd \u05db\u05d9 \u05d4\u05d5\u05d0 \u05de\u05d2\u05d9\u05d1 \u05d1\u05e2\u05d5\u05e6\u05de\u05d4 \u05e8\u05d1\u05d4 \u05dc\u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd \u05e7\u05dc\u05d9\u05dd \u05d1\u05e1\u05d3\u05e8 \u05d4\u05d9\u05d5\u05dd, \u05d3\u05e4\u05d5\u05e1\u05d9 \u05d4\u05e9\u05d9\u05e0\u05d4 \u05d5\u05d4\u05d0\u05db\u05d9\u05dc\u05d4 \u05e9\u05dc\u05d5 \u05d0\u05d9\u05e0\u05dd \u05e6\u05e4\u05d5\u05d9\u05d9\u05dd, \u05d5\u05d4\u05d5\u05d0 \u05e0\u05d5\u05d8\u05d4 \u05dc\u05e0\u05e1\u05d9\u05d2\u05d4 (Withdrawal) \u05d5\u05d7\u05e9\u05e9 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9 \u05d1\u05de\u05e4\u05d2\u05e9 \u05e2\u05dd \u05d2\u05d9\u05e8\u05d5\u05d9\u05d9\u05dd \u05d7\u05d3\u05e9\u05d9\u05dd. \u05dc\u05e4\u05d9 \u05d4\u05de\u05d5\u05d3\u05dc \u05e9\u05dc Thomas & Chess, \u05dc\u05d0\u05d9\u05d6\u05d5 \u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4 \u05d8\u05de\u05e4\u05e8\u05de\u05e0\u05d8\u05dc\u05d9\u05ea \u05de\u05ea\u05d0\u05d9\u05dd \u05ea\u05d9\u05d0\u05d5\u05e8 \u05d6\u05d4?",
      "answerOptions": [
        {
          "text": "Easy child",
          "isCorrect": false,
          "rationale": "\u05d9\u05dc\u05d3\u05d9\u05dd \u05d1\u05e7\u05d1\u05d5\u05e6\u05d4 \u05d6\u05d5 \u05de\u05ea\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9\u05dd \u05d1\u05d3\u05e8\u05da \u05db\u05dc\u05dc \u05d1\u05e8\u05d9\u05ea\u05de\u05d9\u05d5\u05ea (Rhythmicity) \u05d2\u05d1\u05d5\u05d4\u05d4, \u05ea\u05d2\u05d5\u05d1\u05d5\u05ea \u05de\u05ea\u05d5\u05e0\u05d5\u05ea \u05d5\u05d4\u05e1\u05ea\u05d2\u05dc\u05d5\u05ea \u05de\u05d4\u05d9\u05e8\u05d4 \u05dc\u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd, \u05d1\u05e0\u05d9\u05d2\u05d5\u05d3 \u05dc\u05de\u05ea\u05d5\u05d0\u05e8 \u05d1\u05de\u05e7\u05e8\u05d4."
        },
        {
          "text": "Slow-to-warm-up child",
          "isCorrect": false,
          "rationale": "\u05d0\u05de\u05e0\u05dd \u05e7\u05d9\u05d9\u05de\u05ea \u05e0\u05e1\u05d9\u05d2\u05d4 \u05de\u05d2\u05d9\u05e8\u05d5\u05d9\u05d9\u05dd \u05d7\u05d3\u05e9\u05d9\u05dd, \u05d0\u05da \u05d9\u05dc\u05d3\u05d9\u05dd \u05d0\u05dc\u05d5 \u05de\u05ea\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9\u05dd \u05d1\u05e2\u05d5\u05e6\u05de\u05ea \u05ea\u05d2\u05d5\u05d1\u05d4 \u05e0\u05de\u05d5\u05db\u05d4 (Low intensity) \u05d5\u05d4\u05e1\u05ea\u05d2\u05dc\u05d5\u05ea \u05d4\u05d3\u05e8\u05d2\u05ea\u05d9\u05ea, \u05d1\u05e2\u05d5\u05d3 \u05e9\u05d4\u05d9\u05dc\u05d3 \u05d1\u05de\u05e7\u05e8\u05d4 \u05de\u05d2\u05d9\u05d1 \u05d1\u05e2\u05d5\u05e6\u05de\u05d4 \u05e8\u05d1\u05d4."
        },
        {
          "text": "Difficult child",
          "isCorrect": true,
          "rationale": "\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4 \u05d6\u05d5 \u05de\u05d5\u05d2\u05d3\u05e8\u05ea \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d0\u05d9-\u05e1\u05d3\u05d9\u05e8\u05d5\u05ea \u05d1\u05ea\u05e4\u05e7\u05d5\u05d3\u05d9\u05dd \u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05d9\u05dd, \u05ea\u05d2\u05d5\u05d1\u05d5\u05ea \u05e2\u05d5\u05e6\u05de\u05ea\u05d9\u05d5\u05ea, \u05e0\u05e1\u05d9\u05d2\u05d4 \u05de\u05d2\u05d9\u05e8\u05d5\u05d9\u05d9\u05dd \u05d7\u05d3\u05e9\u05d9\u05dd \u05d5\u05e7\u05e9\u05d9\u05d9\u05dd \u05d1\u05d4\u05e1\u05ea\u05d2\u05dc\u05d5\u05ea \u05dc\u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd (Dulcan p.198)."
        },
        {
          "text": "Overinhibited subtype",
          "isCorrect": false,
          "rationale": "\u05d6\u05d4\u05d5 \u05de\u05d5\u05e0\u05d7 \u05e9\u05d4\u05d5\u05e6\u05e2 \u05e2\u05dc \u05d9\u05d3\u05d9 Jenkins \u05d5-Hewitt \u05dc\u05ea\u05d9\u05d0\u05d5\u05e8 \u05ea\u05ea\u05d9-\u05e1\u05d5\u05d2\u05d9\u05dd \u05e9\u05dc \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05de\u05e4\u05e8\u05d9\u05e2\u05d4, \u05d5\u05dc\u05d0 \u05d0\u05d7\u05ea \u05de\u05e9\u05dc\u05d5\u05e9 \u05d4\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d5\u05ea \u05d4\u05e7\u05dc\u05d0\u05e1\u05d9\u05d5\u05ea \u05e9\u05dc Thomas & Chess."
        }
      ],
      "hint": "\u05d7\u05e9\u05d1\u05d5 \u05e2\u05dc \u05d4\u05e9\u05d9\u05dc\u05d5\u05d1 \u05d1\u05d9\u05df \u05e2\u05d5\u05e6\u05de\u05ea \u05d4\u05ea\u05d2\u05d5\u05d1\u05d4 (Intensity) \u05dc\u05d1\u05d9\u05df \u05d7\u05d5\u05e1\u05e8 \u05d4\u05e1\u05d3\u05d9\u05e8\u05d5\u05ea \u05d4\u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea."
    },
    {
      "question": "\u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05d3\u05e8\u05db\u05ea \u05d4\u05d5\u05e8\u05d9\u05dd \u05dc\u05d9\u05dc\u05d3 \u05e2\u05dd \u05d8\u05de\u05e4\u05e8\u05de\u05e0\u05d8 \u05de\u05e1\u05d5\u05d2 Difficult, \u05d4\u05e7\u05dc\u05d9\u05e0\u05d0\u05d9 \u05de\u05e1\u05d1\u05d9\u05e8 \u05db\u05d9 \u05d4\u05e7\u05d5\u05e9\u05d9 \u05d0\u05d9\u05e0\u05d5 \u05e0\u05d5\u05d1\u05e2 \u05e8\u05e7 \u05de\u05d4\u05ea\u05db\u05d5\u05e0\u05d5\u05ea \u05d4\u05de\u05d5\u05dc\u05d3\u05d5\u05ea \u05e9\u05dc \u05d4\u05d9\u05dc\u05d3, \u05d0\u05dc\u05d0 \u05de\u05d4\u05d0\u05d9\u05e0\u05d8\u05e8\u05d0\u05e7\u05e6\u05d9\u05d4 \u05d1\u05d9\u05e0\u05df \u05dc\u05d1\u05d9\u05df \u05d4\u05e1\u05d1\u05d9\u05d1\u05d4. \u05db\u05d0\u05e9\u05e8 \u05d4\u05d4\u05d5\u05e8\u05d9\u05dd \u05de\u05d2\u05d9\u05d1\u05d9\u05dd \u05d1\u05e0\u05d5\u05e7\u05e9\u05d5\u05ea \u05d5\u05d1\u05e2\u05e0\u05d9\u05e9\u05d4 \u05de\u05d7\u05de\u05d9\u05e8\u05d4 \u05dc\u05e1\u05e8\u05d1\u05e0\u05d5\u05ea \u05d4\u05d9\u05dc\u05d3, \u05d4\u05d3\u05d1\u05e8 \u05de\u05d5\u05d1\u05d9\u05dc \u05dc\u05d4\u05e1\u05dc\u05de\u05d4. \u05d0\u05d9\u05d6\u05d4 \u05de\u05d5\u05e9\u05d2 \u05e7\u05dc\u05d9\u05e0\u05d9 \u05de\u05ea\u05d0\u05e8 \u05d0\u05ea \u05d4\u05d4\u05ea\u05d0\u05de\u05d4 (\u05d0\u05d5 \u05d7\u05d5\u05e1\u05e8 \u05d4\u05d4\u05ea\u05d0\u05de\u05d4) \u05d1\u05d9\u05df \u05e1\u05d2\u05e0\u05d5\u05df \u05d4\u05d4\u05d5\u05e8\u05d5\u05ea \u05dc\u05e6\u05e8\u05db\u05d9 \u05d4\u05d9\u05dc\u05d3?",
      "answerOptions": [
        {
          "text": "Affective attunement",
          "isCorrect": false,
          "rationale": "\u05de\u05d5\u05e9\u05d2 \u05d6\u05d4 \u05de\u05ea\u05d9\u05d9\u05d7\u05e1 \u05dc\u05d9\u05db\u05d5\u05dc\u05ea \u05d4\u05d4\u05d5\u05e8\u05d4 \u05dc\u05e9\u05e7\u05e3 \u05d5\u05dc\u05ea\u05ea \u05ea\u05d5\u05e7\u05e3 \u05dc\u05de\u05e6\u05d1\u05d9\u05dd \u05d4\u05e8\u05d2\u05e9\u05d9\u05d9\u05dd \u05e9\u05dc \u05d4\u05d9\u05dc\u05d3, \u05d0\u05da \u05d4\u05d5\u05d0 \u05d0\u05d9\u05e0\u05d5 \u05d4\u05de\u05d5\u05e9\u05d2 \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05d1\u05de\u05d5\u05d3\u05dc \u05d4\u05d8\u05de\u05e4\u05e8\u05de\u05e0\u05d8 \u05e9\u05dc Thomas & Chess."
        },
        {
          "text": "Goodness of fit",
          "isCorrect": true,
          "rationale": "\u05de\u05d5\u05e9\u05d2 \u05d6\u05d4 \u05de\u05ea\u05d0\u05e8 \u05d0\u05ea \u05de\u05d9\u05d3\u05ea \u05d4\u05d4\u05ea\u05d0\u05de\u05d4 \u05d1\u05d9\u05df \u05d4\u05d3\u05e8\u05d9\u05e9\u05d5\u05ea \u05d5\u05d4\u05e6\u05d9\u05e4\u05d9\u05d5\u05ea \u05e9\u05dc \u05d4\u05e1\u05d1\u05d9\u05d1\u05d4 \u05dc\u05d1\u05d9\u05df \u05d4\u05d9\u05db\u05d5\u05dc\u05d5\u05ea \u05d5\u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9\u05dd \u05d4\u05d8\u05de\u05e4\u05e8\u05de\u05e0\u05d8\u05dc\u05d9\u05d9\u05dd \u05e9\u05dc \u05d4\u05d9\u05dc\u05d3 (Dulcan p.198)."
        },
        {
          "text": "Dimensional perspective",
          "isCorrect": false,
          "rationale": "\u05d6\u05d5\u05d4\u05d9 \u05d2\u05d9\u05e9\u05d4 \u05e8\u05d7\u05d1\u05d4 \u05d9\u05d5\u05ea\u05e8 \u05dc\u05d0\u05d1\u05d7\u05d5\u05df \u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9 \u05d4\u05de\u05ea\u05de\u05e7\u05d3\u05ea \u05d1\u05e8\u05e6\u05e3 \u05e9\u05dc \u05ea\u05db\u05d5\u05e0\u05d5\u05ea, \u05d0\u05da \u05d0\u05d9\u05e0\u05d4 \u05de\u05ea\u05d0\u05e8\u05ea \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05ea \u05d0\u05ea \u05d4\u05d3\u05d9\u05e0\u05de\u05d9\u05e7\u05d4 \u05d1\u05d9\u05df \u05d4\u05d5\u05e8\u05d4 \u05dc\u05d9\u05dc\u05d3."
        },
        {
          "text": "Holding environment",
          "isCorrect": false,
          "rationale": "\u05de\u05d5\u05e9\u05d2 \u05e9\u05dc Winnicott \u05d4\u05de\u05ea\u05d0\u05e8 \u05e1\u05d1\u05d9\u05d1\u05d4 \u05d1\u05d8\u05d5\u05d7\u05d4 \u05d4\u05de\u05d0\u05e4\u05e9\u05e8\u05ea \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea, \u05d0\u05da \u05d4\u05de\u05d5\u05e9\u05d2 \u05d4\u05e1\u05e4\u05e6\u05d9\u05e4\u05d9 \u05dc\u05de\u05d7\u05e7\u05e8 \u05d4\u05d8\u05de\u05e4\u05e8\u05de\u05e0\u05d8 \u05e9\u05dc Thomas & Chess \u05d4\u05d5\u05d0 Goodness of fit."
        }
      ],
      "hint": "\u05d4\u05de\u05d5\u05e9\u05d2 \u05de\u05ea\u05d9\u05d9\u05d7\u05e1 \u05dc\u05d0\u05d9\u05d6\u05d5\u05df \u05d4\u05d3\u05d9\u05e0\u05de\u05d9 \u05d1\u05d9\u05df \u05d4\u05d9\u05dc\u05d3 \u05dc\u05e1\u05d1\u05d9\u05d1\u05ea\u05d5."
    },
    {
      "question": "\u05dc\u05e4\u05d9 \u05d4\u05de\u05d5\u05d3\u05dc \u05e9\u05dc McHugh & Slavney (\u05db\u05e4\u05d9 \u05e9\u05de\u05d5\u05e4\u05d9\u05e2 \u05d1-Dulcan), \u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8 \u05d4\u05de\u05e2\u05e8\u05d9\u05da \u05d9\u05dc\u05d3 \u05e2\u05dd ADHD \u05d5\u05d1\u05d5\u05d7\u05df \u05d0\u05ea \u05d4\u05d0\u05d9\u05e0\u05d8\u05dc\u05d9\u05d2\u05e0\u05e6\u05d9\u05d4 \u05e9\u05dc\u05d5 \u05d5\u05d0\u05ea \u05e1\u05d2\u05e0\u05d5\u05df \u05d4\u05d0\u05d9\u05e9\u05d9\u05d5\u05ea \u05e9\u05dc\u05d5 \u05db\u05d2\u05d5\u05e8\u05de\u05d9 \u05e4\u05d2\u05d9\u05e2\u05d5\u05ea \u05d4\u05de\u05d5\u05e9\u05e4\u05e2\u05d9\u05dd \u05de\u05d4\u05e1\u05d1\u05d9\u05d1\u05d4, \u05de\u05e9\u05ea\u05de\u05e9 \u05d1\u05d0\u05d9\u05d6\u05d5 \u05e4\u05e8\u05e1\u05e4\u05e7\u05d8\u05d9\u05d1\u05d4?",
      "answerOptions": [
        {
          "text": "Disease perspective",
          "isCorrect": false,
          "rationale": "\u05e4\u05e8\u05e1\u05e4\u05e7\u05d8\u05d9\u05d1\u05d4 \u05d6\u05d5 \u05de\u05ea\u05de\u05e7\u05d3\u05ea \u05d1\u05dc\u05d9\u05e7\u05d5\u05d9\u05d9\u05dd \u05ea\u05e4\u05e7\u05d5\u05d3\u05d9\u05d9\u05dd \u05d1\u05e8\u05d5\u05e8\u05d9\u05dd \u05db\u05de\u05d5 ADHD \u05e2\u05e6\u05de\u05d5, \u05d5\u05dc\u05d0 \u05d1\u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9\u05dd \u05e8\u05e6\u05d9\u05e4\u05d9\u05dd \u05db\u05de\u05d5 IQ \u05d0\u05d5 \u05d8\u05de\u05e4\u05e8\u05de\u05e0\u05d8."
        },
        {
          "text": "Dimensional perspective",
          "isCorrect": true,
          "rationale": "\u05e4\u05e8\u05e1\u05e4\u05e7\u05d8\u05d9\u05d1\u05d4 \u05d6\u05d5 \u05de\u05ea\u05de\u05e7\u05d3\u05ea \u05d1\u05e7\u05d9\u05e6\u05d5\u05df \u05e9\u05dc \u05ea\u05db\u05d5\u05e0\u05d5\u05ea \u05d0\u05e0\u05d5\u05e9\u05d9\u05d5\u05ea \u05e8\u05d2\u05d9\u05dc\u05d5\u05ea (\u05db\u05de\u05d5 IQ \u05d0\u05d5 Temperament) \u05d4\u05de\u05d4\u05d5\u05d5\u05ea \u05e4\u05d2\u05d9\u05e2\u05d5\u05ea \u05db\u05d0\u05e9\u05e8 \u05d9\u05e9 \u05d7\u05d5\u05e1\u05e8 \u05d4\u05ea\u05d0\u05de\u05d4 \u05dc\u05e1\u05d1\u05d9\u05d1\u05d4 (Dulcan p.13)."
        },
        {
          "text": "Behavior perspective",
          "isCorrect": false,
          "rationale": "\u05d4\u05ea\u05de\u05e7\u05d3\u05d5\u05ea \u05d1\u05d1\u05e2\u05d9\u05d5\u05ea \u05d4\u05e7\u05e9\u05d5\u05e8\u05d5\u05ea \u05dc\u05d1\u05d7\u05d9\u05e8\u05d5\u05ea \u05d5\u05e4\u05e2\u05d9\u05dc\u05d5\u05d9\u05d5\u05ea \u05e9\u05dc \u05d4\u05de\u05d8\u05d5\u05e4\u05dc, \u05db\u05d2\u05d5\u05df \u05d3\u05e4\u05d5\u05e1\u05d9 \u05d0\u05db\u05d9\u05dc\u05d4 \u05d0\u05d5 \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05de\u05e8\u05d3\u05e0\u05d9\u05ea."
        },
        {
          "text": "Life story perspective",
          "isCorrect": false,
          "rationale": "\u05d4\u05ea\u05de\u05e7\u05d3\u05d5\u05ea \u05d1\u05e0\u05e8\u05d8\u05d9\u05d1 \u05d4\u05d7\u05d9\u05d9\u05dd \u05e9\u05dc \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05d5\u05d4\u05e9\u05e4\u05e2\u05ea\u05d5 \u05e2\u05dc \u05d4\u05ea\u05e4\u05e7\u05d5\u05d3, \u05db\u05d2\u05d5\u05df \u05d7\u05d5\u05d5\u05d9\u05d5\u05ea \u05d8\u05e8\u05d0\u05d5\u05de\u05d8\u05d9\u05d5\u05ea \u05d0\u05d5 \u05e0\u05d1\u05d5\u05d0\u05d5\u05ea \u05d4\u05de\u05d2\u05e9\u05d9\u05de\u05d5\u05ea \u05d0\u05ea \u05e2\u05e6\u05de\u05df."
