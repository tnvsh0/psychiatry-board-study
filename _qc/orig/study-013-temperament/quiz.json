        },
        {
          "text": "\u05d4\u05d5\u05d0 \u05e0\u05d7\u05e9\u05d1 \u05dc\u05de\u05e0\u05d1\u05d0 \u05de\u05d5\u05d1\u05d4\u05e7 \u05e9\u05dc ADHD, Predominantly Inattentive presentation",
          "isCorrect": false,
