{
  "title": "Temperament Flashcards",
  "cards": [
    {
      "front": "\u05e2\u05dc \u05e4\u05d9 Dulcan, \u05de\u05d9 \u05d4\u05dd \u05d4\u05d7\u05d5\u05e7\u05e8\u05d9\u05dd \u05e9\u05e4\u05e8\u05e1\u05de\u05d5 \u05d1\u05e9\u05e0\u05ea 1977 \u05de\u05d7\u05e7\u05e8\u05d9\u05dd \u05e4\u05d5\u05e8\u05e6\u05d9 \u05d3\u05e8\u05da \u05e9\u05e9\u05d9\u05e0\u05d5 \u05d0\u05ea \u05d4\u05de\u05d9\u05e7\u05d5\u05d3 \u05d4\u05de\u05d3\u05e2\u05d9 \u05de\u05d2\u05d5\u05e8\u05de\u05d9\u05dd \u05e1\u05d1\u05d9\u05d1\u05ea\u05d9\u05d9\u05dd \u05d1\u05dc\u05d1\u05d3 \u05dc\u05d4\u05d1\u05e0\u05ea \u05d4-temperament?",
      "back": "Thomas and Chess (Dulcan p. 198)"
    },
    {
      "front": "\u05de\u05d4\u05df \u05e9\u05dc\u05d5\u05e9 \u05d4\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d5\u05ea \u05d4\u05e2\u05d9\u05e7\u05e8\u05d9\u05d5\u05ea \u05e9\u05dc temperament \u05e2\u05dc \u05e4\u05d9 \u05d4\u05de\u05d5\u05d3\u05dc \u05e9\u05dc Thomas and Chess?",
      "back": "Easy (\u05e7\u05dc), Difficult (\u05e7\u05e9\u05d4), \u05d5-Slow-to-warm-up (\u05de\u05ea\u05d7\u05de\u05dd \u05dc\u05d0\u05d8) (\u05de\u05e7\u05d5\u05e8: \u05d4\u05e7\u05e9\u05e8 \u05e8\u05d7\u05d1)"
    },
    {
      "front": "\u05d4\u05d2\u05d3\u05e8 \u05d0\u05ea \u05d4\u05de\u05d5\u05e9\u05d2 \"Goodness of Fit\" \u05d1\u05d4\u05e7\u05e9\u05e8 \u05e9\u05dc \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea \u05d4\u05d9\u05dc\u05d3.",
      "back": "\u05d4\u05de\u05d9\u05d3\u05d4 \u05e9\u05d1\u05d4 \u05d4\u05e6\u05d9\u05e4\u05d9\u05d5\u05ea \u05d5\u05d4\u05d3\u05e8\u05d9\u05e9\u05d5\u05ea \u05e9\u05dc \u05d4\u05e1\u05d1\u05d9\u05d1\u05d4 \u05ea\u05d5\u05d0\u05de\u05d5\u05ea \u05d0\u05ea \u05d4\u05d9\u05db\u05d5\u05dc\u05d5\u05ea \u05d5\u05d4-temperament \u05e9\u05dc \u05d4\u05d9\u05dc\u05d3 (\u05de\u05e7\u05d5\u05e8: \u05d4\u05e7\u05e9\u05e8 \u05e8\u05d7\u05d1)"
    },
    {
      "front": "\u05d0\u05d9\u05dc\u05d5 \u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9 temperament \u05d1\u05d9\u05dc\u05d3\u05d5\u05ea \u05d4\u05de\u05d5\u05e7\u05d3\u05de\u05ea \u05e0\u05de\u05e6\u05d0\u05d5 \u05db\u05de\u05d9 \u05e9\u05d7\u05d5\u05d6\u05d9\u05dd \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea \u05e9\u05dc aggression \u05d1\u05e9\u05dc\u05d1 \u05de\u05d0\u05d5\u05d7\u05e8 \u05d9\u05d5\u05ea\u05e8?",
      "back": "Fearlessness (\u05d7\u05d5\u05e1\u05e8 \u05e4\u05d7\u05d3) \u05d5-stimulation seeking (\u05d7\u05d9\u05e4\u05d5\u05e9 \u05d2\u05d9\u05e8\u05d5\u05d9\u05d9\u05dd) (Dulcan p. 211)"
    },
    {
      "front": "\u05e2\u05dc \u05e4\u05d9 \u05d4-DSM-5-TR, \u05d0\u05d9\u05d6\u05d4 \u05d2\u05d5\u05e8\u05dd temperament \u05e0\u05d7\u05e9\u05d1 \u05db\u05d2\u05d5\u05e8\u05dd \u05e1\u05d9\u05db\u05d5\u05df \u05dc-Conduct Disorder \u05d1\u05ea\u05d9\u05e0\u05d5\u05e7\u05d5\u05ea?",
      "back": "Undercontrolled infant temperament (\u05d8\u05de\u05e4\u05e8\u05de\u05e0\u05d8 \u05d7\u05e1\u05e8 \u05e9\u05dc\u05d9\u05d8\u05d4) (DSM p. 535)"
    },
    {
      "front": "\u05d0\u05d9\u05dc\u05d5 \u05d2\u05d5\u05e8\u05de\u05d9 temperament \u05d4\u05de\u05e2\u05d9\u05d3\u05d9\u05dd \u05e2\u05dc \u05e7\u05d5\u05e9\u05d9 \u05d1\u05d5\u05d5\u05d9\u05e1\u05d5\u05ea \u05e8\u05d2\u05e9\u05d9 \u05e0\u05de\u05e6\u05d0\u05d5 \u05db\u05d7\u05d5\u05d6\u05d9\u05dd \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea \u05e9\u05dc Oppositional Defiant Disorder (ODD)?",
      "back": "\u05e8\u05de\u05d5\u05ea \u05d2\u05d1\u05d5\u05d4\u05d5\u05ea \u05e9\u05dc emotional reactivity \u05d5-poor frustration tolerance (DSM p. 525)"
    },
    {
      "front": "\u05d1-Oppositional Defiant Disorder, \u05d0\u05d9\u05dc\u05d5 \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e9\u05dc \u05d4-temperament \u05e0\u05d5\u05e9\u05d0\u05d9\u05dd \u05d0\u05ea \u05de\u05d9\u05e8\u05d1 \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea \u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05de\u05e6\u05d1 \u05e8\u05d5\u05d7 \u05d5\u05d7\u05e8\u05d3\u05d4 \u05d1\u05e2\u05ea\u05d9\u05d3?",
      "back": "\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e9\u05dc Angry/irritable mood (DSM p. 522)"
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05de\u05e9\u05e4\u05d9\u05e2 \u05e8\u05de\u05ea \u05d4-$5-HT$ (\u05e1\u05e8\u05d5\u05d8\u05d5\u05e0\u05d9\u05df) \u05d1-CNS \u05d1\u05d2\u05d9\u05dc\u05d0\u05d9 7\u201311 \u05e2\u05dc \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea \u05d0\u05d9\u05e9\u05d9\u05d5\u05ea\u05d9\u05ea \u05d1\u05e2\u05ea\u05d9\u05d3?",
      "back": "\u05e8\u05de\u05d5\u05ea \u05e0\u05de\u05d5\u05db\u05d5\u05ea \u05e7\u05e9\u05d5\u05e8\u05d5\u05ea \u05dc\u05e1\u05d9\u05db\u05d5\u05df \u05de\u05d5\u05d2\u05d1\u05e8 \u05dc-Antisocial Personality Disorder (ASPD) \u05d5-Borderline Personality Disorder \u05d1\u05d1\u05d2\u05e8\u05d5\u05ea (Dulcan p. 588)"
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05e0\u05d8\u05d9\u05d9\u05d4 \u05d4\u05db\u05dc\u05dc\u05d9\u05ea \u05e9\u05dc \u05ea\u05db\u05d5\u05e0\u05ea \u05d4-aggression \u05db-trait \u05dc\u05d0\u05d5\u05e8\u05da \u05d4\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea?",
      "back": "\u05d4\u05d9\u05d0 \u05e0\u05d7\u05e9\u05d1\u05ea \u05dc-relatively stable trait, \u05d0\u05dd \u05db\u05d9 \u05d9\u05dc\u05d3\u05d9\u05dd \u05d0\u05d2\u05e8\u05e1\u05d9\u05d1\u05d9\u05d9\u05dd \u05e8\u05d1\u05d9\u05dd \u05dc\u05d0 \u05d9\u05d4\u05e4\u05db\u05d5 \u05dc\u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd \u05d0\u05d2\u05e8\u05e1\u05d9\u05d1\u05d9\u05d9\u05dd (Dulcan p. 591)"
    },
    {
      "front": "\u05e6\u05d9\u05d9\u05df \u05e9\u05e0\u05d9 \u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9 temperament/disposition \u05d4\u05de\u05e7\u05d3\u05de\u05d9\u05dd Resilience (\u05d7\u05d5\u05e1\u05df) \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05e9\u05e0\u05d7\u05e9\u05e4\u05d5 \u05dc\u05d4\u05ea\u05e2\u05dc\u05dc\u05d5\u05ea.",
      "back": "\u05d0\u05d9\u05e0\u05d8\u05dc\u05d9\u05d2\u05e0\u05e6\u05d9\u05d4 \u05de\u05e2\u05dc \u05d4\u05de\u05de\u05d5\u05e6\u05e2, self-esteem \u05d2\u05d1\u05d5\u05d4, \u05d5-internal locus of control (Dulcan p. 526)"
    },
    {
      "front": "\u05d0\u05d9\u05dc\u05d5 \u05d4\u05d9\u05d1\u05d8\u05d9\u05dd \u05e9\u05dc \u05d4-temperament \u05d1-ODD \u05e7\u05e9\u05d5\u05e8\u05d9\u05dd \u05dc\u05e1\u05d9\u05db\u05d5\u05df \u05d4\u05de\u05d5\u05d2\u05d1\u05e8 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea Conduct Disorder (CD)?",
      "back": "\u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d4-defiant, argumentative, \u05d5-vindictive (DSM p. 522)"
    },
    {
      "front": "\u05e2\u05dc \u05e4\u05d9 \u05d4-DSM-5-TR, \u05de\u05d4\u05d5 \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05d4\u05d8\u05de\u05e4\u05e8\u05de\u05e0\u05d8\u05dc\u05d9 \u05d4\u05e9\u05db\u05d9\u05d7 \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d4\u05de\u05d0\u05d5\u05d1\u05d7\u05e0\u05d9\u05dd \u05e2\u05dd Disruptive Mood Dysregulation Disorder (DMDD)?",
      "back": "\u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4 \u05e9\u05dc chronic irritability (\u05d0\u05d9\u05e8\u05d8\u05d1\u05d9\u05dc\u05d9\u05d5\u05ea \u05db\u05e8\u05d5\u05e0\u05d9\u05ea) (DSM p. 180)"
    },
    {
      "front": "\u05d0\u05d9\u05d6\u05d4 \u05de\u05de\u05d3 \u05e9\u05dc \u05d4-temperament \u05de\u05e7\u05d5\u05e9\u05e8 \u05dc-Depersonalization/Derealization Disorder \u05e2\u05dc \u05e4\u05d9 \u05d4-DSM-5-TR?",
      "back": "Harm-avoidant temperament (\u05d8\u05de\u05e4\u05e8\u05de\u05e0\u05d8 \u05e0\u05de\u05e0\u05e2 \u05de\u05e0\u05d6\u05e7) (DSM p. 345)"
    },
    {
      "front": "\u05d1\u05d0\u05d9\u05d6\u05d4 \u05e9\u05dc\u05d1 \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9 \u05de\u05d5\u05e4\u05d9\u05e2\u05d9\u05dd \u05d1\u05d3\u05e8\u05da \u05db\u05dc\u05dc \u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d4\u05e8\u05d0\u05e9\u05d5\u05e0\u05d9\u05dd \u05e9\u05dc Oppositional Defiant Disorder?",
      "back": "\u05d1\u05de\u05d4\u05dc\u05da \u05e9\u05e0\u05d5\u05ea \u05d4\u05d2\u05df (preschool years) (DSM p. 522)"
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05de\u05d5\u05d2\u05d3\u05e8 \u05d4\u05e7\u05e9\u05e8 \u05d1\u05d9\u05df \u05d4\u05d5\u05e8\u05d9\u05dd \u05dc\u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd ODD \u05de\u05d1\u05d7\u05d9\u05e0\u05d4 \u05e1\u05d1\u05d9\u05d1\u05ea\u05d9\u05ea-\u05d8\u05de\u05e4\u05e8\u05de\u05e0\u05d8\u05dc\u05d9\u05ea?",
      "back": "\u05e7\u05d9\u05d9\u05dd \u05e7\u05e9\u05e8 \u05d3\u05d5-\u05db\u05d9\u05d5\u05d5\u05e0\u05d9: \u05d4-temperament \u05e9\u05dc \u05d4\u05d9\u05dc\u05d3 \u05de\u05e9\u05e4\u05d9\u05e2 \u05e2\u05dc \u05e1\u05d2\u05e0\u05d5\u05df \u05d4\u05d4\u05d5\u05e8\u05d5\u05ea (\u05dc\u05de\u05e9\u05dc \u05d4\u05d5\u05e8\u05d5\u05ea \u05e0\u05d5\u05e7\u05e9\u05d4), \u05e9\u05de\u05d7\u05de\u05d9\u05e8 \u05d0\u05ea \u05ea\u05e1\u05de\u05d9\u05e0\u05d9 \u05d4\u05d9\u05dc\u05d3 (DSM p. 525)"
    },
    {
      "front": "\u05d4\u05e9\u05dc\u05dd \u05d0\u05ea \u05d4\u05de\u05e9\u05e4\u05d8 \u05e2\u05dc \u05e4\u05d9 Dulcan: \u05d5\u05e8\u05d9\u05d0\u05e0\u05d8 \u05e9\u05dc \u05d4\u05d2\u05df _____ \u05d1\u05e9\u05d9\u05dc\u05d5\u05d1 \u05e2\u05dd \u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4 \u05e9\u05dc abuse \u05de\u05e2\u05dc\u05d4 \u05e4\u05d9 2 \u05d0\u05ea \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05dc-Conduct Disorder.",
      "back": "$MAOA$ (Monoamine oxidase A) (Dulcan p. 209)"
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05de\u05de\u05e6\u05d0 \u05d4\u05e4\u05d9\u05d6\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d1-ANS (\u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05e2\u05e6\u05d1\u05d9\u05dd \u05d4\u05d0\u05d5\u05d8\u05d5\u05e0\u05d5\u05de\u05d9\u05ea) \u05d4\u05de\u05e7\u05d5\u05e9\u05e8 \u05dc-aggression \u05d5-delinquent behavior \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd?",
      "back": "Low heart rate (\u05d3\u05d5\u05e4\u05e7 \u05e0\u05de\u05d5\u05da) \u05d5-low skin conductance response (Dulcan p. 588)"
    },
    {
      "front": "\u05d0\u05d9\u05dc\u05d5 \u05d2\u05d5\u05e8\u05de\u05d9 temperament \u05d7\u05d5\u05d6\u05d9\u05dd \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea \u05e9\u05dc impulsive aggression?",
      "back": "\u05d9\u05d7\u05e1\u05d9 \u05e2\u05de\u05d9\u05ea\u05d9\u05dd \u05d2\u05e8\u05d5\u05e2\u05d9\u05dd \u05d5\u05d3\u05e4\u05d5\u05e1\u05d9 \u05e4\u05ea\u05e8\u05d5\u05df \u05d1\u05e2\u05d9\u05d5\u05ea \u05dc\u05e7\u05d5\u05d9\u05d9\u05dd \u05d4\u05de\u05d5\u05e4\u05d9\u05e2\u05d9\u05dd \u05db\u05d1\u05e8 \u05d1\u05d2\u05d9\u05dc \u05d4\u05d2\u05df (Dulcan p. 591)"
    }
  ]
}