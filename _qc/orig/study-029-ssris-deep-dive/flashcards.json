{
  "title": "Psychopharmacology Flashcards",
  "cards": [
    {
      "front": "\u05de\u05d4\u05d5 \u05d4-drug class \u05d4\u05e0\u05d7\u05e9\u05d1 \u05dc\u05e7\u05d5 \u05e8\u05d0\u05e9\u05d5\u05df (first-line) \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-MDD \u05d5\u05d1-pediatric anxiety disorders?",
      "back": "\u05d4-SSRIs, \u05d1\u05e9\u05dc \u05e4\u05e8\u05d5\u05e4\u05d9\u05dc \u05d1\u05d8\u05d9\u05d7\u05d5\u05ea \u05d2\u05d1\u05d5\u05d4 \u05d5\u05d9\u05e2\u05d9\u05dc\u05d5\u05ea \u05e9\u05d4\u05d5\u05db\u05d7\u05d4 \u05d1\u05de\u05d7\u05e7\u05e8\u05d9\u05dd \u05e7\u05dc\u05d9\u05e0\u05d9\u05d9\u05dd (Dulcan p.733)."
    },
    {
      "front": "\u05dc\u05e4\u05d9 **StahlNeuro**, \u05de\u05d4\u05d5 \u05d4\u05e6\u05e2\u05d3 \u05d4\u05de\u05db\u05e8\u05d9\u05e2 \u05d1-drug mechanism \u05e9\u05dc SSRIs \u05d4\u05de\u05d0\u05e4\u05e9\u05e8 disinhibition \u05e9\u05dc \u05e9\u05d7\u05e8\u05d5\u05e8 5-HT \u05d1-axon terminals?",
      "back": "\u05d3\u05d4-\u05e1\u05e0\u05e1\u05d9\u05d8\u05d9\u05d6\u05e6\u05d9\u05d4 (desensitization) \u05e9\u05dc \u05d4-somatodendritic $5HT_{1A}$ autoreceptors (StahlNeuro p.291)."
    },
    {
      "front": "\u05de\u05d4 \u05de\u05d9\u05d9\u05d7\u05d3 \u05d0\u05ea Fluoxetine \u05de\u05d1\u05d7\u05d9\u05e0\u05ea FDA-approved indications \u05d1\u05e7\u05e8\u05d1 \u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd MDD?",
      "back": "\u05d6\u05d5\u05d4\u05d9 \u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 \u05d4\u05d9\u05d7\u05d9\u05d3\u05d4 \u05d4\u05de\u05d0\u05d5\u05e9\u05e8\u05ea \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-MDD \u05d2\u05dd \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd (\u05d2\u05d9\u05dc 8+) \u05d5\u05d2\u05dd \u05d1\u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd (StahlKids p.197)."
    },
    {
      "front": "\u05e6\u05d9\u05d9\u05df \u05d0\u05ea \u05d0\u05e8\u05d1\u05e2\u05ea \u05d4-SSRIs/TCAs \u05d4\u05de\u05d0\u05d5\u05e9\u05e8\u05d9\u05dd \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d4-FDA \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-pediatric OCD \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d5\u05e0\u05d5\u05e2\u05e8.",
      "back": "\u05d4\u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05d4\u05df Fluoxetine, Sertraline, Fluvoxamine, \u05d5-Clomipramine (StahlKids p.208)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05de\u05e9\u05e0\u05d9 \u05d4\u05d9\u05d9\u05d7\u05d5\u05d3\u05d9 \u05e9\u05dc Sertraline, \u05de\u05e2\u05d1\u05e8 \u05dc\u05d7\u05e1\u05d9\u05de\u05ea SERT, \u05e9\u05e2\u05e9\u05d5\u05d9 \u05dc\u05ea\u05e8\u05d5\u05dd \u05dc\u05e9\u05d9\u05e4\u05d5\u05e8 \u05d0\u05e0\u05e8\u05d2\u05d9\u05d4 \u05d5\u05e8\u05d9\u05db\u05d5\u05d6?",
      "back": "\u05e2\u05d9\u05db\u05d5\u05d1 \u05d4-DAT (dopamine transporter) \u05d5\u05e7\u05d9\u05e9\u05d5\u05e8 \u05dc\u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 $\\sigma_1$ (StahlNeuro p.294)."
    },
    {
      "front": "\u05d1\u05d6\u05db\u05d5\u05ea \u05d0\u05d9\u05d6\u05d4 \u05de\u05e0\u05d2\u05e0\u05d5\u05df receptor binding \u05d9\u05d9\u05d7\u05d5\u05d3\u05d9 \u05e0\u05d7\u05e9\u05d1\u05ea Fluvoxamine \u05dc\u05d9\u05e2\u05d9\u05dc\u05d4 \u05d1\u05de\u05d9\u05d5\u05d7\u05d3 \u05d1\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-anxiety \u05d5-insomnia?",
      "back": "\u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05db-\u05d0\u05d2\u05d5\u05e0\u05d9\u05e1\u05d8 \u05dc\u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 $\\sigma_1$ (StahlNeuro p.295)."
    },
    {
      "front": "\u05de\u05d3\u05d5\u05e2 Paroxetine \u05de\u05e7\u05d5\u05e9\u05e8\u05ea \u05dc\u05e1\u05d9\u05db\u05d5\u05df \u05d4\u05d2\u05d1\u05d5\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc-discontinuation syndrome \u05d1\u05e7\u05e8\u05d1 \u05d9\u05dc\u05d3\u05d9\u05dd?",
      "back": "\u05d1\u05e9\u05dc \u05d4-half-life \u05d4\u05e7\u05e6\u05e8 \u05e9\u05dc\u05d4 (\u05db-21 \u05e9\u05e2\u05d5\u05ea) \u05d5\u05d4\u05d9\u05e2\u05d3\u05e8 \u05de\u05d8\u05d1\u05d5\u05dc\u05d9\u05d8\u05d9\u05dd \u05e4\u05e2\u05d9\u05dc\u05d9\u05dd (Dulcan p.740)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05d0\u05d6\u05d4\u05e8\u05d4 \u05d4\u05de\u05e8\u05db\u05d6\u05d9\u05ea (QT-warning) \u05e9\u05d9\u05e9 \u05dc\u05e7\u05d7\u05ea \u05d1\u05d7\u05e9\u05d1\u05d5\u05df \u05d1\u05e2\u05ea \u05e9\u05d9\u05de\u05d5\u05e9 \u05d1-Citalopram?",
      "back": "\u05e1\u05d9\u05db\u05d5\u05df \u05dc-QTc prolongation \u05d1\u05de\u05d9\u05e0\u05d5\u05e0\u05d9\u05dd \u05d2\u05d1\u05d5\u05d4\u05d9\u05dd, \u05d4\u05de\u05d2\u05d1\u05d9\u05dc \u05d0\u05ea \u05d4\u05de\u05d9\u05e0\u05d5\u05df \u05d4\u05de\u05e7\u05e1\u05d9\u05de\u05dc\u05d9 (StahlNeuro p.296)."
    },
    {
      "front": "\u05de\u05d3\u05d5\u05e2 \u05d1\u05d3\u05e8\u05da \u05db\u05dc\u05dc \u05d0\u05d9\u05df \u05e6\u05d5\u05e8\u05da \u05d1\u05d1\u05d9\u05e6\u05d5\u05e2 taper \u05d4\u05d3\u05e8\u05d2\u05ea\u05d9 \u05d1\u05e2\u05ea \u05d4\u05e4\u05e1\u05e7\u05ea Fluoxetine?",
      "back": "\u05d1\u05e9\u05dc \u05d4-half-life \u05d4\u05d0\u05e8\u05d5\u05da \u05e9\u05dc \u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 \u05d5\u05d4\u05de\u05d8\u05d1\u05d5\u05dc\u05d9\u05d8 Norfluoxetine (\u05db-2 \u05e9\u05d1\u05d5\u05e2\u05d5\u05ea), \u05d4\u05d9\u05d0 \u05de\u05d1\u05e6\u05e2\u05ea \"self-taper\" (StahlKids p.205)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d0\u05d6\u05d4\u05e8\u05ea \u05d4-Black Box \u05e9\u05dc \u05d4-FDA \u05d1\u05e0\u05d5\u05d2\u05e2 \u05dc\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1-SSRIs \u05d1\u05e7\u05e8\u05d1 \u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd \u05de\u05ea\u05d7\u05ea \u05dc\u05d2\u05d9\u05dc 25?",
      "back": "\u05e1\u05d9\u05db\u05d5\u05df \u05de\u05d5\u05d2\u05d1\u05e8 \u05dc-suicidal ideation or attempts, \u05d1\u05de\u05d9\u05d5\u05d7\u05d3 \u05d1\u05ea\u05d7\u05d9\u05dc\u05ea \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc (Dulcan p.693)."
    },
    {
      "front": "\u05dc\u05e4\u05d9 **StahlNeuro**, \u05d0\u05d9\u05d6\u05d4 \u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05e9\u05dc Fluoxetine \u05d4\u05d5\u05e4\u05da \u05d0\u05d5\u05ea\u05d4 \u05dc\u05de\u05ea\u05d0\u05d9\u05de\u05d4 \u05dc\u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd \u05e2\u05dd hypersomnia \u05d5-fatigue?",
      "back": "\u05d0\u05e0\u05d8\u05d2\u05d5\u05e0\u05d9\u05d6\u05dd \u05dc\u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 $5HT_{2C}$, \u05d4\u05de\u05d5\u05d1\u05d9\u05dc \u05dc\u05e9\u05d7\u05e8\u05d5\u05e8 NE \u05d5-DA \u05d1-prefrontal cortex (StahlNeuro p.293)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05dc\u05d5\u05d7 \u05d4\u05d6\u05de\u05e0\u05d9\u05dd \u05d4\u05de\u05d5\u05de\u05dc\u05e5 \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d4-FDA \u05dc\u05e0\u05d9\u05d8\u05d5\u05e8 (monitoring) \u05d9\u05dc\u05d3\u05d9\u05dd \u05d1\u05ea\u05d7\u05d9\u05dc\u05ea \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-SSRIs?",
      "back": "\u05de\u05e4\u05d2\u05e9 \u05e9\u05d1\u05d5\u05e2\u05d9 \u05d1-4 \u05d4\u05e9\u05d1\u05d5\u05e2\u05d5\u05ea \u05d4\u05e8\u05d0\u05e9\u05d5\u05e0\u05d9\u05dd, \u05dc\u05d0\u05d7\u05e8 \u05de\u05db\u05df \u05db\u05dc \u05e9\u05d1\u05d5\u05e2\u05d9\u05d9\u05dd \u05dc\u05de\u05e9\u05da \u05d7\u05d5\u05d3\u05e9, \u05d5\u05d1\u05e9\u05d1\u05d5\u05e2 12 (Dulcan p.380)."
    },
    {
      "front": "\u05d0\u05d9\u05dc\u05d5 \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9\u05dd flulike discontinuation symptoms \u05d1\u05e2\u05ea \u05d4\u05e4\u05e1\u05e7\u05d4 \u05d7\u05d3\u05d4 \u05e9\u05dc SSRI \u05e2\u05dd half-life \u05e7\u05e6\u05e8?",
      "back": "\u05e1\u05d7\u05e8\u05d7\u05d5\u05e8\u05d5\u05ea, \u05db\u05d0\u05d1\u05d9 \u05e8\u05d0\u05e9, \u05d1\u05d7\u05d9\u05dc\u05d5\u05ea, \u05e2\u05d9\u05d9\u05e4\u05d5\u05ea \u05d5\u05e6\u05de\u05e8\u05de\u05d5\u05e8\u05d5\u05ea (Dulcan p.733)."
    },
    {
      "front": "\u05d0\u05d9\u05d6\u05d5 \u05ea\u05e8\u05d5\u05e4\u05d4 \u05de\u05de\u05e9\u05e4\u05d7\u05ea \u05d4-SSRIs \u05de\u05d0\u05d5\u05e9\u05e8\u05ea \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d4-FDA \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-MDD \u05d1\u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd (Adolescents) \u05d0\u05da \u05dc\u05d0 \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd?",
      "back": "\u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 Escitalopram (Dulcan p.731)."
    },
    {
      "front": "\u05d1\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-pediatric OCD, \u05de\u05d4\u05d5 \u05de\u05e8\u05d5\u05d5\u05d7 \u05d4\u05d6\u05de\u05df \u05d4\u05de\u05d9\u05e0\u05d9\u05de\u05dc\u05d9 \u05d4\u05de\u05d5\u05de\u05dc\u05e5 \u05dc\u05d4\u05de\u05ea\u05e0\u05d4 \u05d1\u05d9\u05df \u05d4\u05e2\u05dc\u05d0\u05d5\u05ea \u05de\u05d9\u05e0\u05d5\u05df (titration)?",
      "back": "\u05de\u05d5\u05de\u05dc\u05e5 \u05dc\u05d4\u05de\u05ea\u05d9\u05df \u05dc\u05e4\u05d7\u05d5\u05ea 3 \u05e9\u05d1\u05d5\u05e2\u05d5\u05ea \u05d1\u05d9\u05df \u05d4\u05e2\u05dc\u05d0\u05d5\u05ea \u05de\u05d9\u05e0\u05d5\u05df (Dulcan p.380)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05ea\u05d5\u05e4\u05e2\u05ea \u05d4\u05dc\u05d5\u05d5\u05d0\u05d9 \u05d4\u05de\u05d8\u05d1\u05d5\u05dc\u05d9\u05ea (electrolyte imbalance) \u05e9\u05e2\u05dc\u05d5\u05dc\u05d4 \u05dc\u05d4\u05d5\u05e4\u05d9\u05e2 \u05ea\u05d7\u05ea \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-SSRI, \u05d1\u05de\u05d9\u05d5\u05d7\u05d3 \u05d1\u05d0\u05d5\u05db\u05dc\u05d5\u05e1\u05d9\u05d5\u05ea \u05e1\u05d9\u05db\u05d5\u05df?",
      "back": "\u05d4\u05d9\u05e4\u05d5\u05e0\u05ea\u05e8\u05de\u05d9\u05d4 (hyponatremia) \u05de\u05e9\u05e0\u05d9\u05ea \u05dc-SIADH (\u05de\u05e7\u05d5\u05e8: \u05d4\u05e7\u05e9\u05e8 \u05e8\u05d7\u05d1)."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05de\u05e9\u05e4\u05d9\u05e2 \u05de\u05d6\u05d5\u05df \u05e2\u05dc \u05d4-pharmacokinetics \u05e9\u05dc Sertraline?",
      "back": "\u05e6\u05e8\u05d9\u05db\u05ea \u05de\u05d6\u05d5\u05df \u05de\u05e2\u05dc\u05d4 \u05d0\u05ea \u05e8\u05d9\u05db\u05d5\u05d6 \u05d4\u05e9\u05d9\u05d0 \u05d1\u05e4\u05dc\u05d6\u05de\u05d4 ($C_{max}$) \u05d1\u05db-25%, \u05d0\u05da \u05d4\u05d3\u05d1\u05e8 \u05d0\u05d9\u05e0\u05d5 \u05e0\u05d7\u05e9\u05d1 \u05dc\u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9 \u05e7\u05dc\u05d9\u05e0\u05d9\u05ea (Dulcan p.741)."
    },
    {
      "front": "\u05d0\u05d9\u05d6\u05d4 SSRI \u05e0\u05d7\u05e9\u05d1 \u05dc-most potent inhibitor \u05e9\u05dc \u05d4\u05d0\u05e0\u05d6\u05d9\u05dd CYP2D6, \u05d3\u05d1\u05e8 \u05d4\u05de\u05d7\u05d9\u05d9\u05d1 \u05d6\u05d4\u05d9\u05e8\u05d5\u05ea \u05d1\u05e9\u05d9\u05dc\u05d5\u05d1 \u05ea\u05e8\u05d5\u05e4\u05d5\u05ea?",
      "back": "\u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 Paroxetine, \u05d5\u05d2\u05dd Fluoxetine \u05d1\u05de\u05d9\u05d3\u05d4 \u05e8\u05d1\u05d4 (Dulcan p.736)."
    }
  ]
}