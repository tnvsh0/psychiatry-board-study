        }
      ],
      "hint": "\u05d7\u05e4\u05e9 \u05d0\u05ea \u05d4-SSRIs \u05e9\u05d4\u05e8\u05d0\u05d5 \u05d0\u05ea \u05d4\u05e2\u05d3\u05d5\u05d9\u05d5\u05ea \u05d4\u05de\u05d7\u05e7\u05e8\u05d9\u05d5\u05ea \u05d4\u05d7\u05d6\u05e7\u05d5\u05ea \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd."
    },
    {
      "question": "\u05d0\u05d9\u05d6\u05d4 \u05de\u05d4\u05d1\u05d0\u05d9\u05dd \u05de\u05d4\u05d5\u05d5\u05d4 \u05d0\u05ea \u05d2\u05d5\u05e8\u05dd \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05d4\u05de\u05e9\u05e4\u05d7\u05ea\u05d9 \u05d4\u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d0\u05d5\u05d1\u05d3\u05e0\u05d9\u05ea \u05d1\u05e7\u05e8\u05d1 \u05d1\u05e0\u05d9 \u05e0\u05d5\u05e2\u05e8 \u05dc\u05e4\u05d9 \u05d4-Synopsis?",
      "answerOptions": [
        {
          "text": "\u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4 \u05e9\u05dc \u05d4\u05ea\u05e2\u05dc\u05dc\u05d5\u05ea (Maltreatment), \u05d5\u05d1\u05de\u05d9\u05d5\u05d7\u05d3 \u05d4\u05ea\u05e2\u05dc\u05dc\u05d5\u05ea \u05de\u05d9\u05e0\u05d9\u05ea",
          "isCorrect": true,
          "rationale": "\u05d4\u05e7\u05e9\u05e8 \u05d4\u05d7\u05d6\u05e7 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05e9\u05e0\u05de\u05e6\u05d0 \u05d1\u05de\u05d7\u05e7\u05e8\u05d9\u05dd \u05e7\u05d4\u05d9\u05dc\u05ea\u05d9\u05d9\u05dd \u05d2\u05d3\u05d5\u05dc\u05d9\u05dd \u05d4\u05d5\u05d0 \u05d1\u05d9\u05df \u05d4\u05ea\u05e2\u05dc\u05dc\u05d5\u05ea \u05de\u05d9\u05e0\u05d9\u05ea \u05dc\u05d1\u05d9\u05df \u05e0\u05d9\u05e1\u05d9\u05d5\u05e0\u05d5\u05ea \u05d0\u05d5\u05d1\u05d3\u05e0\u05d9\u05d9\u05dd (Synopsis ch.2.9)."
        },
        {
          "text": "\u05e6\u05d9\u05d5\u05df \u05e0\u05de\u05d5\u05da \u05d1\u05de\u05d1\u05d7\u05df \u05d0\u05e7\u05d3\u05de\u05d9 \u05d1\u05d5\u05d3\u05d3",
          "isCorrect": false,
          "rationale": "\u05d6\u05d4\u05d5 \u05d2\u05d5\u05e8\u05dd \u05de\u05d3\u05e8\u05d1\u05df (Precipitant) \u05d0\u05e4\u05e9\u05e8\u05d9 \u05d1\u05e7\u05e8\u05d1 \u05d1\u05e0\u05d9 \u05e0\u05d5\u05e2\u05e8 \u05e4\u05e8\u05e4\u05e7\u05e6\u05d9\u05d5\u05e0\u05d9\u05e1\u05d8\u05d9\u05dd, \u05d0\u05da \u05dc\u05d0 \u05d2\u05d5\u05e8\u05dd \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05d4\u05de\u05e9\u05e4\u05d7\u05ea\u05d9 \u05d4\u05de\u05d1\u05e0\u05d9 \u05d4\u05d7\u05d6\u05e7 \u05d1\u05d9\u05d5\u05ea\u05e8 (Synopsis ch.2.9)."
        },
        {
          "text": "\u05de\u05e2\u05d1\u05e8 \u05d3\u05d9\u05e8\u05d4 \u05dc\u05e1\u05d1\u05d9\u05d1\u05d4 \u05d7\u05d3\u05e9\u05d4",
          "isCorrect": false,
          "rationale": "\u05d6\u05d4\u05d5 \u05d2\u05d5\u05e8\u05dd \u05d3\u05d7\u05e7 \u05e1\u05d1\u05d9\u05d1\u05ea\u05d9, \u05d0\u05da \u05d4\u05e9\u05e4\u05e2\u05ea\u05d5 \u05e4\u05d7\u05d5\u05ea\u05d4 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05d1\u05d4\u05e9\u05d5\u05d5\u05d0\u05d4 \u05dc\u05d8\u05e8\u05d0\u05d5\u05de\u05d4 \u05ea\u05d5\u05da-\u05de\u05e9\u05e4\u05d7\u05ea\u05d9\u05ea (\u05de\u05e7\u05d5\u05e8: \u05d4\u05e7\u05e9\u05e8 \u05e8\u05d7\u05d1)."
        },
        {
          "text": "\u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4 \u05de\u05e9\u05e4\u05d7\u05ea\u05d9\u05ea \u05e9\u05dc ADHD \u05d1\u05dc\u05d1\u05d3",
          "isCorrect": false,
          "rationale": "ADHD \u05e7\u05e9\u05d5\u05e8 \u05dc\u05d0\u05d9\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05d5\u05ea, \u05d0\u05da \u05d2\u05d5\u05e8\u05dd \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05dc\u05d0\u05d5\u05d1\u05d3\u05e0\u05d5\u05ea \u05d4\u05d5\u05d0 \u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05de\u05e6\u05d1 \u05e8\u05d5\u05d7 \u05d5\u05d8\u05e8\u05d0\u05d5\u05de\u05d4 (Synopsis ch.2.9)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d7\u05d5\u05d5\u05d9\u05d5\u05ea \u05d9\u05dc\u05d3\u05d5\u05ea \u05e9\u05dc\u05d9\u05dc\u05d9\u05d5\u05ea (ACEs) \u05e7\u05e9\u05d5\u05ea \u05d1\u05de\u05d9\u05d5\u05d7\u05d3."
    }
  ]
