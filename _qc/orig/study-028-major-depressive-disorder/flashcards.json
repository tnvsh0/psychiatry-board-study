{
  "title": "\u05db\u05e8\u05d8\u05d9\u05e1\u05d9\u05d5\u05ea \u05d3\u05d9\u05db\u05d0\u05d5\u05df",
  "cards": [
    {
      "front": "\u05de\u05d4\u05d5 \u05de\u05e1\u05e4\u05e8 \u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d4\u05de\u05d9\u05e0\u05d9\u05de\u05dc\u05d9 \u05d5\u05de\u05e9\u05da \u05d4\u05d6\u05de\u05df \u05d4\u05e0\u05d3\u05e8\u05e9 \u05dc\u05d0\u05d1\u05d7\u05e0\u05ea \u05d0\u05e4\u05d9\u05d6\u05d5\u05d3\u05d4 \u05d3\u05d9\u05db\u05d0\u05d5\u05e0\u05d9\u05ea \u05de\u05d6'\u05d5\u05e8\u05d9\u05ea \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR?",
      "back": "\u05dc\u05e4\u05d7\u05d5\u05ea 5 \u05de\u05ea\u05d5\u05da 9 \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05dc\u05de\u05e9\u05da \u05ea\u05e7\u05d5\u05e4\u05d4 \u05e9\u05dc \u05e9\u05d1\u05d5\u05e2\u05d9\u05d9\u05dd \u05dc\u05e4\u05d7\u05d5\u05ea, \u05d4\u05de\u05d9\u05d9\u05e6\u05d2\u05d9\u05dd \u05e9\u05d9\u05e0\u05d5\u05d9 \u05de\u05d4\u05ea\u05e4\u05e7\u05d5\u05d3 \u05d4\u05e7\u05d5\u05d3\u05dd. (DSM p. 183)"
    },
    {
      "front": "\u05d0\u05d9\u05d6\u05d4 \u05e9\u05d9\u05e0\u05d5\u05d9 \u05d9\u05d9\u05d7\u05d5\u05d3\u05d9 \u05e7\u05d9\u05d9\u05dd \u05d1\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df \u05de\u05e6\u05d1 \u05d4\u05e8\u05d5\u05d7 (Mood) \u05d1\u05d0\u05d1\u05d7\u05e0\u05ea MDD \u05d1\u05e7\u05e8\u05d1 \u05d9\u05dc\u05d3\u05d9\u05dd \u05d5\u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd \u05dc\u05e2\u05d5\u05de\u05ea \u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd?",
      "back": "\u05de\u05e6\u05d1 \u05e8\u05d5\u05d7 \u05e8\u05d2\u05d6\u05e0\u05d9 (Irritable mood) \u05d9\u05db\u05d5\u05dc \u05dc\u05d4\u05d7\u05dc\u05d9\u05e3 \u05de\u05e6\u05d1 \u05e8\u05d5\u05d7 \u05d3\u05d9\u05db\u05d0\u05d5\u05e0\u05d9. (DSM p. 183)"
    },
    {
      "front": "\u05de\u05d4\u05dd \u05de\u05e8\u05db\u05d9\u05d1\u05d9 \u05d4\u05de\u05e0\u05de\u05d5\u05e0\u05d9\u05e7\u05d4 \u05d4\u05d0\u05e0\u05d2\u05dc\u05d9\u05ea SIGECAPS \u05d4\u05de\u05e9\u05de\u05e9\u05ea \u05dc\u05d6\u05db\u05d9\u05e8\u05ea \u05ea\u05e1\u05de\u05d9\u05e0\u05d9 \u05d4\u05d3\u05d9\u05db\u05d0\u05d5\u05df?",
      "back": "Sleep, Interest, Guilt, Energy, Concentration, Appetite, Psychomotor, Suicide. (Synopsis ch. 1)"
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05e9\u05db\u05d9\u05d7\u05d5\u05ea (Prevalence) \u05d4\u05de\u05e9\u05d5\u05e2\u05e8\u05ea \u05e9\u05dc MDD \u05d1\u05e7\u05e8\u05d1 \u05d9\u05dc\u05d3\u05d9\u05dd (Prepubertal) \u05dc\u05e2\u05d5\u05de\u05ea \u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd?",
      "back": "\u05db-2% \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05dc\u05e2\u05d5\u05de\u05ea 4%-8% \u05d1\u05e7\u05e8\u05d1 \u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd. (Dulcan p. 246)"
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05de\u05e9\u05ea\u05e0\u05d4 \u05d9\u05d7\u05e1 \u05d4\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d1\u05d9\u05df \u05d4\u05de\u05d9\u05e0\u05d9\u05dd (Male to Female ratio) \u05d1\u05de\u05e2\u05d1\u05e8 \u05de\u05d9\u05dc\u05d3\u05d5\u05ea \u05dc\u05d4\u05ea\u05d1\u05d2\u05e8\u05d5\u05ea \u05d1-MDD?",
      "back": "\u05d4\u05d9\u05d7\u05e1 \u05d4\u05d5\u05d0 $1:1$ \u05d1\u05d9\u05dc\u05d3\u05d5\u05ea \u05d5\u05d4\u05d5\u05e4\u05da \u05dc-$1:2$ (\u05dc\u05d8\u05d5\u05d1\u05ea \u05e0\u05e7\u05d1\u05d5\u05ea) \u05d1\u05de\u05d4\u05dc\u05da \u05d2\u05d9\u05dc \u05d4\u05d4\u05ea\u05d1\u05d2\u05e8\u05d5\u05ea. (Dulcan p. 246)"
    },
    {
      "front": "\u05e2\u05dc \u05e4\u05d9 \u05de\u05d7\u05e7\u05e8\u05d9 \u05ea\u05d0\u05d5\u05de\u05d9\u05dd, \u05de\u05d4\u05d5 \u05d0\u05d7\u05d5\u05d6 \u05d4\u05ea\u05d5\u05e8\u05e9\u05d4 (Heritability) \u05d4\u05de\u05e9\u05d5\u05e2\u05e8 \u05e9\u05dc MDD \u05d1\u05e7\u05e8\u05d1 \u05e6\u05e2\u05d9\u05e8\u05d9\u05dd?",
      "back": "\u05db-40% \u05e2\u05d3 50%. (Synopsis ch. 2.9)"
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05db\u05dc\u05d9 \u05d4\u05d3\u05d9\u05e8\u05d5\u05d2 (Rating scale) \u05d4\u05de\u05d1\u05d5\u05e1\u05e1-\u05e7\u05dc\u05d9\u05e0\u05d0\u05d9 \u05d4\u05e0\u05e4\u05d5\u05e5 \u05d5\u05d4\u05de\u05e7\u05d5\u05d1\u05dc \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05d4\u05e2\u05e8\u05db\u05ea \u05d7\u05d5\u05de\u05e8\u05ea \u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd?",
      "back": "\u05e9\u05d0\u05dc\u05d5\u05df \u05d4-CDRS-R (Children\u2019s Depression Rating Scale, Revised). (Dulcan p. 255)"
    },
    {
      "front": "\u05d0\u05d9\u05dc\u05d5 \u05e9\u05ea\u05d9 \u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05de\u05de\u05e9\u05e4\u05d7\u05ea \u05d4-SSRI \u05d4\u05df \u05d4\u05d9\u05d7\u05d9\u05d3\u05d5\u05ea \u05d1\u05e2\u05dc\u05d5\u05ea \u05d0\u05d9\u05e9\u05d5\u05e8 FDA \u05e8\u05e9\u05de\u05d9 \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-MDD \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d5\u05e0\u05d5\u05e2\u05e8?",
      "back": "Fluoxetine (\u05de\u05d2\u05d9\u05dc 8) \u05d5-Escitalopram (\u05de\u05d2\u05d9\u05dc 12). (Dulcan p. 260)"
    },
    {
      "front": "\u05e2\u05dc \u05e4\u05d9 \u05de\u05de\u05e6\u05d0\u05d9 \u05de\u05d7\u05e7\u05e8 \u05d4-TADS, \u05de\u05d4\u05d5 \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05d9\u05e2\u05d9\u05dc \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05d4\u05e4\u05d7\u05ea\u05ea \u05ea\u05e1\u05de\u05d9\u05e0\u05d9 MDD \u05d5\u05de\u05d7\u05e9\u05d1\u05d5\u05ea \u05d0\u05d5\u05d1\u05d3\u05e0\u05d9\u05d5\u05ea \u05d1\u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd?",
      "back": "\u05e9\u05d9\u05dc\u05d5\u05d1 \u05e9\u05dc \u05d8\u05d9\u05e4\u05d5\u05dc \u05ea\u05e8\u05d5\u05e4\u05ea\u05d9 (SSRI) \u05d9\u05d7\u05d3 \u05e2\u05dd CBT. (Dulcan p. 269)"
    },
    {
      "front": "\u05e6\u05d9\u05d9\u05df \u05e9\u05dc\u05d5\u05e9\u05d4 '\u05d7\u05e7\u05d9\u05d9\u05e0\u05d9\u05dd \u05e8\u05e4\u05d5\u05d0\u05d9\u05d9\u05dd' (Medical mimics) \u05de\u05ea\u05d7\u05d5\u05dd \u05d4\u05d0\u05e0\u05d3\u05d5\u05e7\u05e8\u05d9\u05e0\u05d5\u05dc\u05d5\u05d2\u05d9\u05d4 \u05d0\u05d5 \u05d4\u05d6\u05d9\u05d4\u05d5\u05de\u05d9\u05dd \u05e9\u05d9\u05db\u05d5\u05dc\u05d9\u05dd \u05dc\u05d4\u05e6\u05d9\u05d2 \u05ea\u05de\u05d5\u05e0\u05d4 \u05d3\u05de\u05d5\u05d9\u05ea MDD.",
      "back": "Hypothyroidism, Mononucleosis (\u05de\u05d7\u05dc\u05ea \u05d4\u05e0\u05e9\u05d9\u05e7\u05d4), \u05d5\u05d7\u05e1\u05e8 \u05d1\u05d5\u05d9\u05d8\u05de\u05d9\u05df $B_{12}$. (Dulcan p. 254)"
    },
    {
      "front": "\u05db\u05de\u05d4 \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05de\u05d0\u05e0\u05d9\u05d9\u05dd/\u05d4\u05d9\u05e4\u05d5\u05de\u05d0\u05e0\u05d9\u05d9\u05dd \u05e0\u05d3\u05e8\u05e9\u05d9\u05dd \u05db\u05d3\u05d9 \u05dc\u05d4\u05d2\u05d3\u05d9\u05e8 \u05d0\u05e4\u05d9\u05d6\u05d5\u05d3\u05d4 \u05d3\u05d9\u05db\u05d0\u05d5\u05e0\u05d9\u05ea 'With mixed features'?",
      "back": "\u05dc\u05e4\u05d7\u05d5\u05ea 3 \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05de\u05d0\u05e0\u05d9\u05d9\u05dd/\u05d4\u05d9\u05e4\u05d5\u05de\u05d0\u05e0\u05d9\u05d9\u05dd \u05d4\u05de\u05d5\u05e4\u05d9\u05e2\u05d9\u05dd \u05d1\u05e8\u05d5\u05d1 \u05d9\u05de\u05d9 \u05d4\u05d0\u05e4\u05d9\u05d6\u05d5\u05d3\u05d4 \u05d4\u05d3\u05d9\u05db\u05d0\u05d5\u05e0\u05d9\u05ea. (DSM p. 211)"
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05d7\u05e9\u05d9\u05d1\u05d5\u05ea \u05d4\u05e4\u05e8\u05d5\u05d2\u05e0\u05d5\u05e1\u05d8\u05d9\u05ea \u05e9\u05dc \u05d6\u05d9\u05d4\u05d5\u05d9 Specifier \u05e9\u05dc 'Mixed features' \u05d1\u05d0\u05e4\u05d9\u05d6\u05d5\u05d3\u05d4 \u05d3\u05d9\u05db\u05d0\u05d5\u05e0\u05d9\u05ea \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd?",
      "back": "\u05e1\u05d9\u05db\u05d5\u05df \u05de\u05d5\u05d2\u05d1\u05e8 \u05dc\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea Bipolar Disorder \u05d1\u05e2\u05ea\u05d9\u05d3 \u05d5\u05ea\u05d2\u05d5\u05d1\u05d4 \u05e4\u05d7\u05d5\u05ea\u05d4 \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d0\u05e0\u05d8\u05d9-\u05d3\u05d9\u05db\u05d0\u05d5\u05e0\u05d9. (Dulcan p. 248)"
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05ea\u05e1\u05de\u05d9\u05df \u05d4\u05dc\u05d9\u05d1\u05d4 \u05d4\u05e0\u05d3\u05e8\u05e9 \u05dc\u05d0\u05d1\u05d7\u05e0\u05ea MDD \u05e2\u05dd 'Atypical features'?",
      "back": "\u05ea\u05d2\u05d5\u05d1\u05ea\u05d9\u05d5\u05ea \u05e9\u05dc \u05de\u05e6\u05d1 \u05d4\u05e8\u05d5\u05d7 (Mood reactivity) \u05dc\u05d0\u05d9\u05e8\u05d5\u05e2\u05d9\u05dd \u05d7\u05d9\u05d5\u05d1\u05d9\u05d9\u05dd. (DSM p. 212)"
    },
    {
      "front": "\u05d0\u05d9\u05dc\u05d5 \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e4\u05d9\u05d6\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05d9\u05dd \u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05d9\u05d9\u05dd \u05dc-Specifier \u05e9\u05dc 'Melancholic features'?",
      "back": "\u05d9\u05e7\u05d9\u05e6\u05ea \u05d1\u05d5\u05e7\u05e8 \u05de\u05d5\u05e7\u05d3\u05de\u05ea (\u05e9\u05e2\u05ea\u05d9\u05d9\u05dd \u05dc\u05e4\u05e0\u05d9 \u05d4\u05d6\u05de\u05df), \u05d4\u05d7\u05de\u05e8\u05d4 \u05d1\u05d1\u05d5\u05e7\u05e8, \u05d5\u05d0\u05e0\u05d5\u05e8\u05e7\u05e1\u05d9\u05d4 \u05d0\u05d5 \u05d9\u05e8\u05d9\u05d3\u05d4 \u05d1\u05de\u05e9\u05e7\u05dc. (DSM p. 211)"
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05de\u05d5\u05ea\u05d0\u05dd \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df \u05d4\u05ea\u05d9\u05d0\u05d1\u05d5\u05df \u05d5\u05d4\u05de\u05e9\u05e7\u05dc \u05e9\u05dc \u05d4-DSM-5-TR \u05dc\u05d0\u05d5\u05db\u05dc\u05d5\u05e1\u05d9\u05d9\u05ea \u05d4\u05d9\u05dc\u05d3\u05d9\u05dd?",
      "back": "\u05d9\u05e9 \u05dc\u05e7\u05d7\u05ea \u05d1\u05d7\u05e9\u05d1\u05d5\u05df \u05db\u05d9\u05e9\u05dc\u05d5\u05df \u05d1\u05d4\u05e9\u05d2\u05ea \u05d4\u05e2\u05dc\u05d9\u05d9\u05d4 \u05d4\u05de\u05e6\u05d5\u05e4\u05d4 \u05d1\u05de\u05e9\u05e7\u05dc (Failure to make expected weight gain). (DSM p. 183)"
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05d4\u05e0\u05e4\u05d5\u05e5 \u05e9\u05dc \u05d4\u05dc\u05d5\u05e6\u05d9\u05e0\u05e6\u05d9\u05d5\u05ea \u05d1\u05e7\u05e8\u05d1 \u05d9\u05dc\u05d3\u05d9\u05dd \u05e6\u05e2\u05d9\u05e8\u05d9\u05dd \u05d4\u05e1\u05d5\u05d1\u05dc\u05d9\u05dd \u05de\u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9?",
      "back": "\u05d4\u05dc\u05d5\u05e6\u05d9\u05e0\u05e6\u05d9\u05d5\u05ea \u05d0\u05d5\u05d3\u05d9\u05d8\u05d5\u05e8\u05d9\u05d5\u05ea \u05ea\u05d5\u05d0\u05de\u05d5\u05ea \u05de\u05e6\u05d1 \u05e8\u05d5\u05d7 (Mood-congruent), \u05dc\u05e8\u05d5\u05d1 \u05e7\u05d5\u05dc \u05d4\u05de\u05d8\u05d9\u05d7 \u05d1\u05d4\u05dd \u05e2\u05dc\u05d1\u05d5\u05e0\u05d5\u05ea. (Synopsis ch. 2.9)"
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05d9\u05e2\u05d9\u05dc\u05d5\u05ea \u05e9\u05dc \u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05d8\u05e8\u05d9\u05e6\u05d9\u05e7\u05dc\u05d9\u05d5\u05ea (TCAs) \u05d1\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-MDD \u05d1\u05e7\u05e8\u05d1 \u05d9\u05dc\u05d3\u05d9\u05dd \u05d5\u05e0\u05d5\u05e2\u05e8 \u05d8\u05e8\u05dd \u05d2\u05d9\u05dc \u05d4\u05d1\u05d2\u05e8\u05d5\u05ea?",
      "back": "\u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05d0\u05dc\u05d5 \u05e0\u05de\u05e6\u05d0\u05d5 \u05db\u05dc\u05d0 \u05d9\u05e2\u05d9\u05dc\u05d5\u05ea (No superior to placebo) \u05d1\u05d0\u05d5\u05db\u05dc\u05d5\u05e1\u05d9\u05d9\u05d4 \u05d6\u05d5. (Dulcan p. 265)"
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05e8\u05d0\u05d9\u05d5\u05df \u05d4\u05d0\u05d1\u05d7\u05d5\u05df \u05d4\u05d7\u05e6\u05d9-\u05de\u05d5\u05d1\u05e0\u05d4 \u05d4\u05e0\u05d7\u05e9\u05d1 \u05dc-'Gold standard' \u05dc\u05d4\u05e2\u05e8\u05db\u05ea \u05e4\u05e1\u05d9\u05db\u05d5\u05e4\u05ea\u05d5\u05dc\u05d5\u05d2\u05d9\u05d4 \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd (\u05db\u05d5\u05dc\u05dc MDD)?",
