    {
      "type": "short_answer",
      "question": "\u05d4\u05e1\u05d1\u05d9\u05e8\u05d5 \u05de\u05d3\u05d5\u05e2 Quetiapine \u05d2\u05d5\u05e8\u05de\u05ea \u05dc\u05e9\u05d9\u05e2\u05d5\u05e8 \u05e0\u05de\u05d5\u05da \u05de\u05d0\u05d5\u05d3 \u05e9\u05dc \u05ea\u05d5\u05e4\u05e2\u05d5\u05ea \u05dc\u05d5\u05d5\u05d0\u05d9 \u05d7\u05d5\u05e5-\u05e4\u05d9\u05e8\u05de\u05d9\u05d3\u05dc\u05d9\u05d5\u05ea (EPS) \u05d5\u05d4\u05d9\u05e4\u05e8-\u05e4\u05e8\u05d5\u05dc\u05e7\u05d8\u05d9\u05e0\u05de\u05d9\u05d4 \u05d1\u05d4\u05e9\u05d5\u05d5\u05d0\u05d4 \u05dc-Risperidone, \u05ea\u05d5\u05da \u05d4\u05ea\u05d9\u05d9\u05d7\u05e1\u05d5\u05ea \u05dc\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05e7\u05d9\u05e9\u05d5\u05e8 \u05dc\u05e7\u05d5\u05dc\u05d8\u05df D2.",
      "grading": {
        "modelAnswer": "\u05e7\u05d5\u05d5\u05d0\u05d8\u05d9\u05d0\u05e4\u05d9\u05df \u05de\u05ea\u05d0\u05e4\u05d9\u05d9\u05e0\u05ea \u05d1\u05d6\u05d9\u05e7\u05d4 \u05e0\u05de\u05d5\u05db\u05d4 \u05dc\u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 D2 \u05d5\u05d1\u05d4\u05ea\u05e0\u05ea\u05e7\u05d5\u05ea \u05de\u05d4\u05d9\u05e8\u05d4 \u05de\u05d0\u05d5\u05d3 \u05de\u05d4\u05e7\u05d5\u05dc\u05d8\u05df (Fast Dissociation/Fast-off rate). \u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d6\u05d4 \u05de\u05d0\u05e4\u05e9\u05e8 \u05dc\u05d4 \u05dc\u05d4\u05e9\u05d9\u05d2 \u05d0\u05e4\u05e7\u05d8 \u05d0\u05e0\u05d8\u05d9-\u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9 \u05dc\u05dc\u05d0 \u05d7\u05e1\u05d9\u05de\u05d4 \u05de\u05de\u05d5\u05e9\u05db\u05ea \u05d5\u05e8\u05e6\u05d9\u05e4\u05d4 \u05e9\u05dc \u05d4\u05de\u05e1\u05dc\u05d5\u05dc \u05d4\u05e0\u05d9\u05d2\u05e8\u05d5\u05e1\u05d8\u05e8\u05d9\u05d0\u05d8\u05dc\u05d9 (\u05dc\u05de\u05e0\u05d9\u05e2\u05ea EPS) \u05d5\u05d4\u05de\u05e1\u05dc\u05d5\u05dc \u05d4\u05d8\u05d5\u05d1\u05d9\u05e8\u05d5-\u05d0\u05d9\u05e0\u05e4\u05d5\u05e0\u05d3\u05d9\u05d1\u05d5\u05dc\u05e8\u05d9 (\u05dc\u05de\u05e0\u05d9\u05e2\u05ea \u05e2\u05dc\u05d9\u05d9\u05ea \u05e4\u05e8\u05d5\u05dc\u05e7\u05d8\u05d9\u05df), \u05d1\u05e0\u05d9\u05d2\u05d5\u05d3 \u05dc\u05e8\u05d9\u05e1\u05e4\u05e8\u05d9\u05d3\u05d5\u05df \u05e9\u05e0\u05e7\u05e9\u05e8\u05ea \u05d1\u05e2\u05d5\u05e6\u05de\u05d4 \u05e8\u05d1\u05d4 \u05d9\u05d5\u05ea\u05e8 \u05d5\u05dc\u05d6\u05de\u05df \u05de\u05de\u05d5\u05e9\u05da \u05d9\u05d5\u05ea\u05e8 (Dulcan p.825, StahlNeuro p.226).",
        "rationale": "\u05d4\u05de\u05e4\u05ea\u05d7 \u05dc\u05d4\u05d1\u05e0\u05ea \u05e4\u05e8\u05d5\u05e4\u05d9\u05dc \u05ea\u05d5\u05e4\u05e2\u05d5\u05ea \u05d4\u05dc\u05d5\u05d5\u05d0\u05d9 \u05e9\u05dc Quetiapine \u05d8\u05de\u05d5\u05df \u05d1\u05de\u05d4\u05d9\u05e8\u05d5\u05ea \u05d4\u05d4\u05ea\u05e0\u05ea\u05e7\u05d5\u05ea \u05e9\u05dc\u05d4 \u05de\u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 \u05d4\u05d3\u05d5\u05e4\u05de\u05d9\u05df.",
        "requiredAttributes": [
          "\u05e6\u05d9\u05d5\u05df \u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4-Fast Dissociation \u05d0\u05d5 Fast-off rate.",
          "\u05d4\u05e1\u05d1\u05e8 \u05e9\u05d4\u05d7\u05e1\u05d9\u05de\u05d4 \u05d0\u05d9\u05e0\u05d4 \u05de\u05de\u05d5\u05e9\u05db\u05ea \u05de\u05e1\u05e4\u05d9\u05e7 \u05db\u05d3\u05d9 \u05dc\u05d2\u05e8\u05d5\u05dd \u05dc-EPS \u05d0\u05d5 \u05dc\u05e2\u05dc\u05d9\u05d9\u05ea \u05e4\u05e8\u05d5\u05dc\u05e7\u05d8\u05d9\u05df.",
          "\u05d4\u05e9\u05d5\u05d5\u05d0\u05d4 \u05dc\u05d6\u05d9\u05e7\u05d4 \u05d4\u05d2\u05d1\u05d5\u05d4\u05d4 \u05d9\u05d5\u05ea\u05e8 \u05e9\u05dc Risperidone."
        ],
        "errors": {
          "misconceptions": [
