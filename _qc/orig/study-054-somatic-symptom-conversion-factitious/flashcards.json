{
  "title": "Somatic Flashcards",
  "cards": [
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df \u05d4\u05de\u05e8\u05db\u05d6\u05d9 (Criterion A) \u05d4\u05e0\u05d3\u05e8\u05e9 \u05dc\u05d0\u05d1\u05d7\u05e0\u05ea Somatic Symptom Disorder (SSD) \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR?",
      "back": "\u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05e9\u05dc \u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05dd \u05e1\u05d5\u05de\u05d8\u05d9 \u05d0\u05d7\u05d3 \u05d0\u05d5 \u05d9\u05d5\u05ea\u05e8 \u05d4\u05d2\u05d5\u05e8\u05dd \u05dc\u05de\u05e6\u05d5\u05e7\u05d4 \u05d0\u05d5 \u05dc\u05e9\u05d9\u05d1\u05d5\u05e9 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9 \u05d1\u05d7\u05d9\u05d9 \u05d4\u05d9\u05d5\u05dd-\u05d9\u05d5\u05dd (DSM p.351)."
    },
    {
      "front": "\u05e2\u05dc \u05de\u05e0\u05ea \u05dc\u05d0\u05d1\u05d7\u05df Somatic Symptom Disorder, \u05e2\u05dc \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05dc\u05d4\u05e6\u05d9\u05d2 \u05dc\u05e4\u05d7\u05d5\u05ea \u05d0\u05d7\u05d3 \u05de\u05d1\u05d9\u05df \u05e9\u05dc\u05d5\u05e9\u05d4 \u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9\u05dd \u05d1\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df B. \u05de\u05d4\u05dd \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9\u05dd \u05d4\u05dc\u05dc\u05d5?",
      "back": "\u05de\u05d7\u05e9\u05d1\u05d5\u05ea \u05dc\u05d0 \u05e4\u05e8\u05d5\u05e4\u05d5\u05e8\u05e6\u05d9\u05d5\u05e0\u05dc\u05d9\u05d5\u05ea \u05e2\u05dc \u05d7\u05d5\u05de\u05e8\u05ea \u05d4\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd, \u05e8\u05de\u05ea \u05d7\u05e8\u05d3\u05d4 \u05d2\u05d1\u05d5\u05d4\u05d4 \u05dc\u05d2\u05d1\u05d9 \u05d4\u05d1\u05e8\u05d9\u05d0\u05d5\u05ea, \u05d0\u05d5 \u05d4\u05e7\u05d3\u05e9\u05ea \u05d6\u05de\u05df \u05d5\u05d0\u05e0\u05e8\u05d2\u05d9\u05d4 \u05de\u05d5\u05e4\u05e8\u05d6\u05d9\u05dd \u05dc\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd (DSM p.351)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05de\u05e9\u05da \u05d4\u05d6\u05de\u05df \u05d4\u05de\u05d9\u05e0\u05d9\u05de\u05dc\u05d9 \u05d4\u05e0\u05d3\u05e8\u05e9 \u05dc\u05e7\u05d9\u05d5\u05dd \u05d4\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd (Somatic state) \u05dc\u05e6\u05d5\u05e8\u05da \u05d0\u05d1\u05d7\u05e0\u05ea SSD?",
      "back": "\u05dc\u05e4\u05d7\u05d5\u05ea $6$ \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd (DSM p.351)."
    },
    {
      "front": "\u05de\u05d4\u05dd \u05d0\u05e8\u05d1\u05e2\u05ea \u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d4\u05e1\u05d5\u05de\u05d8\u05d9\u05d9\u05dd \u05d4\u05e9\u05db\u05d9\u05d7\u05d9\u05dd \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d1\u05e7\u05e8\u05d1 \u05d9\u05dc\u05d3\u05d9\u05dd \u05d4\u05de\u05d0\u05d5\u05d1\u05d7\u05e0\u05d9\u05dd \u05d1-Somatic Symptom Disorder?",
      "back": "\u05db\u05d0\u05d1\u05d9 \u05d1\u05d8\u05df \u05d7\u05d5\u05d6\u05e8\u05d9\u05dd (Recurrent Abdominal Pain), \u05db\u05d0\u05d1\u05d9 \u05e8\u05d0\u05e9, \u05e2\u05d9\u05d9\u05e4\u05d5\u05ea (fatigue), \u05d5\u05d1\u05d7\u05d9\u05dc\u05d4 (DSM p.353; Dulcan p.235)."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05de\u05d1\u05d7\u05d9\u05e0\u05d9\u05dd \u05d1\u05d9\u05df Illness Anxiety Disorder (IAD) \u05dc\u05d1\u05d9\u05df Somatic Symptom Disorder (SSD) \u05de\u05d1\u05d7\u05d9\u05e0\u05ea \u05d4\u05e6\u05d2\u05ea \u05d4\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05d4\u05d2\u05d5\u05e4\u05e0\u05d9\u05d9\u05dd?",
      "back": "\u05d1-IAD \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e1\u05d5\u05de\u05d8\u05d9\u05d9\u05dd \u05d0\u05d9\u05e0\u05dd \u05e7\u05d9\u05d9\u05de\u05d9\u05dd \u05d0\u05d5 \u05e9\u05d4\u05dd \u05d1\u05e2\u05d5\u05e6\u05de\u05d4 \u05e7\u05dc\u05d4 \u05d1\u05dc\u05d1\u05d3, \u05d1\u05e2\u05d5\u05d3 \u05d1-SSD \u05e7\u05d9\u05d9\u05de\u05d9\u05dd \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e1\u05d5\u05de\u05d8\u05d9\u05d9\u05dd \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05d9\u05dd \u05d5\u05de\u05d8\u05e8\u05d9\u05d3\u05d9\u05dd (DSM p.357)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df \u05d4\u05dc\u05d9\u05d1\u05d4 (Criterion B) \u05d4\u05e0\u05d3\u05e8\u05e9 \u05dc\u05d0\u05d1\u05d7\u05e0\u05ea Conversion Disorder (Functional Neurological Symptom Disorder)?",
      "back": "\u05de\u05de\u05e6\u05d0\u05d9\u05dd \u05e7\u05dc\u05d9\u05e0\u05d9\u05d9\u05dd \u05d4\u05de\u05e8\u05d0\u05d9\u05dd \u05d0\u05d9-\u05ea\u05d0\u05d9\u05de\u05d5\u05ea (Incompatibility) \u05d1\u05d9\u05df \u05d4\u05ea\u05e1\u05de\u05d9\u05df \u05dc\u05d1\u05d9\u05df \u05de\u05e6\u05d1\u05d9\u05dd \u05e0\u05d5\u05d9\u05e8\u05d5\u05dc\u05d5\u05d2\u05d9\u05d9\u05dd \u05d0\u05d5 \u05e4\u05ea\u05d5\u05e4\u05d9\u05d6\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05d9\u05dd \u05de\u05d5\u05db\u05e8\u05d9\u05dd (DSM p.360)."
    },
    {
      "front": "\u05d1-Conversion Disorder, \u05d0\u05d9\u05dc\u05d5 \u05e1\u05d5\u05d2\u05d9 \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e0\u05db\u05dc\u05dc\u05d9\u05dd \u05ea\u05d7\u05ea \u05d4\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4 \u05e9\u05dc \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e1\u05e0\u05e1\u05d5\u05e8\u05d9\u05d9\u05dd?",
      "back": "\u05e9\u05d9\u05e0\u05d5\u05d9, \u05d4\u05e4\u05d7\u05ea\u05d4 \u05d0\u05d5 \u05d4\u05d9\u05e2\u05d3\u05e8 \u05ea\u05d7\u05d5\u05e9\u05d4 \u05d1\u05e2\u05d5\u05e8, \u05d1\u05e8\u05d0\u05d9\u05d9\u05d4 (\u05db\u05d2\u05d5\u05df tunnel vision) \u05d0\u05d5 \u05d1\u05e9\u05de\u05d9\u05e2\u05d4 (DSM p.360; Synopsis ch.12)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05e4\u05e8\u05d5\u05d2\u05e0\u05d5\u05d6\u05d4 \u05e9\u05dc \u05e8\u05d5\u05d1 \u05d4\u05de\u05e7\u05e8\u05d9\u05dd \u05d4\u05d0\u05e7\u05d5\u05d8\u05d9\u05d9\u05dd \u05e9\u05dc Conversion Disorder \u05d1\u05e7\u05e8\u05d1 \u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd \u05de\u05d0\u05d5\u05e9\u05e4\u05d6\u05d9\u05dd?",
      "back": "\u05db-$95\\%$ \u05de\u05d4\u05de\u05e7\u05e8\u05d9\u05dd \u05d7\u05d5\u05dc\u05e4\u05d9\u05dd \u05d1\u05d0\u05d5\u05e4\u05df \u05e1\u05e4\u05d5\u05e0\u05d8\u05e0\u05d9, \u05dc\u05e8\u05d5\u05d1 \u05ea\u05d5\u05da $2$ \u05e9\u05d1\u05d5\u05e2\u05d5\u05ea (Synopsis ch.12)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05de\u05d5\u05d8\u05d9\u05d1\u05e6\u05d9\u05d4 \u05d4\u05e2\u05d9\u05e7\u05e8\u05d9\u05ea \u05e9\u05dc \u05de\u05d8\u05d5\u05e4\u05dc \u05e2\u05dd Factitious Disorder, \u05d1\u05e9\u05d5\u05e0\u05d4 \u05de-Malingering?",
      "back": "\u05d4\u05de\u05d5\u05d8\u05d9\u05d1\u05e6\u05d9\u05d4 \u05d4\u05d9\u05d0 \u05dc\u05e7\u05d1\u05dc \u05d8\u05d9\u05e4\u05d5\u05dc \u05e8\u05e4\u05d5\u05d0\u05d9 \u05d5\u05dc\u05de\u05dc\u05d0 \u05d0\u05ea \u05ea\u05e4\u05e7\u05d9\u05d3 \u05d4\u05d7\u05d5\u05dc\u05d4 (sick role), \u05dc\u05dc\u05d0 \u05e6\u05d5\u05e8\u05da \u05d1\u05ea\u05d2\u05de\u05d5\u05dc\u05d9\u05dd \u05d7\u05d9\u05e6\u05d5\u05e0\u05d9\u05d9\u05dd \u05d2\u05dc\u05d5\u05d9\u05d9\u05dd (Synopsis ch.12; DSM p.367)."
    },
    {
      "front": "\u05de\u05d9 \u05de\u05e7\u05d1\u05dc \u05d0\u05ea \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d1\u05de\u05e7\u05e8\u05d4 \u05e9\u05dc Factitious Disorder Imposed on Another (\u05dc\u05e9\u05e2\u05d1\u05e8 By Proxy)?",
      "back": "\u05d4\u05de\u05d1\u05e6\u05e2 (Perpetrator), \u05dc\u05e8\u05d5\u05d1 \u05d4\u05d4\u05d5\u05e8\u05d4, \u05d4\u05d5\u05d0 \u05d6\u05d4 \u05e9\u05de\u05e7\u05d1\u05dc \u05d0\u05ea \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4, \u05d1\u05e2\u05d5\u05d3 \u05d4\u05e7\u05d5\u05e8\u05d1\u05df \u05de\u05e7\u05d1\u05dc \u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc \u05d4\u05ea\u05e2\u05dc\u05dc\u05d5\u05ea (Abuse) (DSM p.368)."
    },
    {
      "front": "\u05dc\u05e4\u05d9 StahlNeuro, \u05de\u05d4\u05d9 \u05d4\u05d4\u05d2\u05d3\u05e8\u05d4 \u05e9\u05dc Suprasegmental Central Sensitization?",
      "back": "\u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd \u05e4\u05dc\u05e1\u05d8\u05d9\u05d9\u05dd \u05d1\u05de\u05d1\u05e0\u05d9 \u05de\u05d5\u05d7 (\u05ea\u05dc\u05de\u05d5\u05e1 \u05d5\u05e7\u05d5\u05e8\u05d8\u05e7\u05e1) \u05d4\u05d2\u05d5\u05e8\u05de\u05d9\u05dd \u05dc\u05d4\u05d2\u05d1\u05e8\u05d4 \u05e9\u05dc \u05ea\u05d7\u05d5\u05e9\u05d5\u05ea \u05d2\u05d5\u05e3 \u05e8\u05d2\u05d9\u05dc\u05d5\u05ea \u05d5\u05e4\u05e8\u05e9\u05e0\u05d5\u05ea\u05df \u05db\u05db\u05d0\u05d1, \u05d2\u05dd \u05dc\u05dc\u05d0 \u05d2\u05d9\u05e8\u05d5\u05d9 \u05e4\u05e8\u05d9\u05e4\u05e8\u05d9\u05d0\u05dc\u05d9 (StahlNeuro p.385-386)."
    },
    {
      "front": "\u05dc\u05e4\u05d9 StahlNeuro, \u05db\u05d9\u05e6\u05d3 \u05dc\u05d9\u05e7\u05d5\u05d9\u05d9\u05dd \u05d1\u05de\u05e2\u05d2\u05dc \u05d4-DLPFC (Dorsolateral Prefrontal Cortex) \u05d5\u05d1\u05d5\u05d5\u05d9\u05e1\u05d5\u05ea \u05e9\u05dc Dopamine \u05de\u05e1\u05d1\u05d9\u05e8\u05d9\u05dd \u05d0\u05ea \u05d4\u05ea\u05d5\u05e4\u05e2\u05d4 \u05e9\u05dc \"fibro-fog\"?",
      "back": "\u05d4\u05dd \u05de\u05d5\u05d1\u05d9\u05dc\u05d9\u05dd \u05dc\u05d9\u05e8\u05d9\u05d3\u05d4 \u05d1\u05ea\u05e4\u05e7\u05d5\u05d3\u05d9\u05dd \u05e0\u05d9\u05d4\u05d5\u05dc\u05d9\u05d9\u05dd (executive functioning) \u05d5\u05e7\u05e9\u05d9\u05d9\u05dd \u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9\u05d9\u05dd \u05d4\u05de\u05dc\u05d5\u05d5\u05d9\u05dd \u05ea\u05e1\u05de\u05d5\u05e0\u05d5\u05ea \u05db\u05d0\u05d1 \u05db\u05e8\u05d5\u05e0\u05d9 (StahlNeuro p.391)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05e9\u05db\u05d9\u05d7\u05d5\u05ea (Prevalence) \u05d4\u05de\u05e9\u05d5\u05e2\u05e8\u05ea \u05e9\u05dc Somatic Symptom Disorder \u05d1\u05d0\u05d5\u05db\u05dc\u05d5\u05e1\u05d9\u05d9\u05ea \u05d4\u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd \u05d4\u05db\u05dc\u05dc\u05d9\u05ea?",
      "back": "\u05d1\u05d9\u05df $4\\%$ \u05dc-$6\\%$ (DSM p.353)."
    },
    {
      "front": "\u05d0\u05d9\u05dc\u05d5 \u05e9\u05e0\u05d9 \u05de\u05e2\u05d2\u05dc\u05d9\u05dd \u05de\u05d5\u05d7\u05d9\u05d9\u05dd \u05d7\u05d5\u05e4\u05e4\u05d9\u05dd (Compulsivity Circuitry) \u05de\u05e2\u05d5\u05e8\u05d1\u05d9\u05dd \u05d1-Illness Anxiety Disorder \u05d1\u05d3\u05d5\u05de\u05d4 \u05dc-OCD \u05dc\u05e4\u05d9 StahlNeuro?",
      "back": "\u05de\u05e1\u05dc\u05d5\u05dc\u05d9\u05dd \u05e7\u05d5\u05e8\u05d8\u05d9\u05e7\u05d5-\u05e1\u05d8\u05e8\u05d9\u05d0\u05d8\u05dc\u05d9\u05d9\u05dd (Orbitofrontal-Striatal pathways) (StahlNeuro p.540-541)."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05de\u05d1\u05d7\u05d9\u05e0\u05d9\u05dd \u05d1\u05d9\u05df Factitious Disorder \u05dc\u05d1\u05d9\u05df Conversion Disorder \u05de\u05d1\u05d7\u05d9\u05e0\u05ea \u05de\u05d5\u05d3\u05e2\u05d5\u05ea \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05dc\u05d9\u05d9\u05e6\u05d5\u05e8 \u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd?",
      "back": "\u05d1-Factitious Disorder \u05e7\u05d9\u05d9\u05de\u05ea \u05e4\u05e2\u05d5\u05dc\u05d4 \u05de\u05db\u05d5\u05d5\u05e0\u05ea \u05e9\u05dc \u05d6\u05d9\u05d5\u05e3 \u05d0\u05d5 \u05d2\u05e8\u05d9\u05de\u05ea \u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd (Identified Deception), \u05d1\u05e2\u05d5\u05d3 \u05d1-Conversion \u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d0\u05d9\u05e0\u05dd \u05de\u05d9\u05d5\u05e6\u05e8\u05d9\u05dd \u05d1\u05d0\u05d5\u05e4\u05df \u05de\u05db\u05d5\u05d5\u05df (DSM p.367; Synopsis ch.12)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05d4-Astasia-abasia \u05d1-Conversion Disorder?",
      "back": "\u05d4\u05e4\u05e8\u05e2\u05ea \u05d4\u05dc\u05d9\u05db\u05d4 \u05e4\u05e8\u05d0\u05d9\u05ea \u05d5\u05d1\u05dc\u05ea\u05d9 \u05d9\u05e6\u05d9\u05d1\u05d4 \u05d4\u05db\u05d5\u05dc\u05dc\u05ea \u05ea\u05e0\u05d5\u05e2\u05d5\u05ea \u05d2\u05d5\u05e3 \u05e7\u05d9\u05e6\u05d5\u05e0\u05d9\u05d5\u05ea, \u05d0\u05da \u05dc\u05dc\u05d0 \u05e0\u05e4\u05d9\u05dc\u05d5\u05ea \u05d0\u05d5 \u05e4\u05d2\u05d9\u05e2\u05d4 \u05e2\u05e6\u05de\u05d9\u05ea (Synopsis ch.12)."
    },
    {
      "front": "\u05d0\u05d9\u05dc\u05d5 \u05d4\u05d9\u05d1\u05d8\u05d9\u05dd \u05e1\u05d1\u05d9\u05d1\u05ea\u05d9\u05d9\u05dd \u05e0\u05d7\u05e9\u05d1\u05d9\u05dd \u05dc\u05d2\u05d5\u05e8\u05de\u05d9 \u05e1\u05d9\u05db\u05d5\u05df (Risk Factors) \u05dc\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea Somatic Symptom Disorder?",
      "back": "\u05d4\u05e9\u05db\u05dc\u05d4 \u05e0\u05de\u05d5\u05db\u05d4, \u05de\u05e2\u05de\u05d3 \u05e1\u05d5\u05e6\u05d9\u05d5-\u05d0\u05e7\u05d5\u05e0\u05d5\u05de\u05d9 \u05e0\u05de\u05d5\u05da, \u05d0\u05d9\u05e8\u05d5\u05e2\u05d9 \u05d7\u05d9\u05d9\u05dd \u05de\u05dc\u05d7\u05d9\u05e6\u05d9\u05dd \u05dc\u05d0\u05d7\u05e8\u05d5\u05e0\u05d4, \u05d5\u05d8\u05e8\u05d0\u05d5\u05de\u05d4 \u05d1\u05d9\u05dc\u05d3\u05d5\u05ea (\u05db\u05d2\u05d5\u05df \u05e0\u05d9\u05e6\u05d5\u05dc \u05de\u05d9\u05e0\u05d9) (DSM p.354)."
    },
    {
      "front": "\u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05e2\u05e8\u05db\u05ea SSD \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd, \u05de\u05d3\u05d5\u05e2 \u05ea\u05d2\u05d5\u05d1\u05ea \u05d4\u05d4\u05d5\u05e8\u05d9\u05dd (Caregivers) \u05d4\u05d9\u05d0 \u05e7\u05e8\u05d9\u05d8\u05d9\u05ea?",
      "back": "\u05d4\u05e4\u05e8\u05e9\u05e0\u05d5\u05ea \u05d5\u05d4\u05ea\u05d2\u05d5\u05d1\u05d4 \u05e9\u05dc \u05d4\u05d4\u05d5\u05e8\u05d9\u05dd \u05e7\u05d5\u05d1\u05e2\u05d5\u05ea \u05d0\u05ea \u05e8\u05de\u05ea \u05d4\u05de\u05e6\u05d5\u05e7\u05d4, \u05d0\u05ea \u05d4\u05d3\u05e8\u05d9\u05e9\u05d4 \u05dc\u05d1\u05d3\u05d9\u05e7\u05d5\u05ea \u05e4\u05d5\u05dc\u05e9\u05e0\u05d9\u05d5\u05ea \u05d5\u05d0\u05ea \u05de\u05e9\u05da \u05d4\u05d4\u05d9\u05e2\u05d3\u05e8\u05d5\u05ea \u05de\u05d1\u05d9\u05ea \u05d4\u05e1\u05e4\u05e8 (DSM p.353)."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05de\u05d5\u05d2\u05d3\u05e8\u05ea \u05d7\u05d5\u05de\u05e8\u05d4 \"Severe\" \u05d1\u05d0\u05d1\u05d7\u05e0\u05ea Somatic Symptom Disorder?",
      "back": "\u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05e9\u05dc \u05e9\u05e0\u05d9\u05d9\u05dd \u05d0\u05d5 \u05d9\u05d5\u05ea\u05e8 \u05de\u05d4\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05d1\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df B, \u05d9\u05d7\u05d3 \u05e2\u05dd \u05ea\u05dc\u05d5\u05e0\u05d5\u05ea \u05e1\u05d5\u05de\u05d8\u05d9\u05d5\u05ea \u05de\u05e8\u05d5\u05d1\u05d5\u05ea (\u05d0\u05d5 \u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05dd \u05d0\u05d7\u05d3 \u05d7\u05de\u05d5\u05e8 \u05de\u05d0\u05d5\u05d3) (DSM p.351)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05ea\u05e8\u05d5\u05e4\u05ea\u05d9 \u05d4\u05de\u05d5\u05e6\u05e2 \u05d1-StahlNeuro \u05dc\u05d4\u05e4\u05d7\u05ea\u05ea \u05d4\u05d5\u05dc\u05db\u05d4 \u05d1\u05e1\u05d9\u05e0\u05e4\u05e1\u05d5\u05ea \u05e9\u05e2\u05d1\u05e8\u05d5 Central Sensitization \u05d1\u05d0\u05de\u05e6\u05e2\u05d5\u05ea \u05d7\u05e1\u05d9\u05de\u05ea VSCCs?",
      "back": "\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05dc\u05d9\u05d2\u05e0\u05d3\u05d9\u05dd \u05dc\u05d9\u05d7\u05d9\u05d3\u05ea $\\alpha_{2}\\delta$ \u05db\u05d2\u05d5\u05df Gabapentin \u05d0\u05d5 Pregabalin (StahlNeuro p.395)."
    }
