{
  "title": "Psychiatry Quiz",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\u05de\u05ea\u05d1\u05d2\u05e8\u05ea \u05d1\u05ea 14 \u05de\u05d5\u05d1\u05d0\u05ea \u05dc\u05d4\u05e2\u05e8\u05db\u05d4 \u05e2\u05e7\u05d1 \u05db\u05d0\u05d1\u05d9 \u05d1\u05d8\u05df \u05db\u05e8\u05d5\u05e0\u05d9\u05d9\u05dd \u05de\u05d6\u05d4 8 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd. \u05d4\u05d9\u05d0 \u05e2\u05d1\u05e8\u05d4 \u05d1\u05d9\u05e8\u05d5\u05e8 \u05d2\u05e1\u05d8\u05e8\u05d5\u05d0\u05e0\u05d8\u05e8\u05d5\u05dc\u05d5\u05d2\u05d9 \u05de\u05e7\u05d9\u05e3 \u05d4\u05db\u05d5\u05dc\u05dc \u05d0\u05e0\u05d3\u05d5\u05e1\u05e7\u05d5\u05e4\u05d9\u05d4 \u05d5-CT, \u05e9\u05d4\u05d9\u05d5 \u05ea\u05e7\u05d9\u05e0\u05d9\u05dd. \u05d4\u05e0\u05e2\u05e8\u05d4 \u05e2\u05e1\u05d5\u05e7\u05d4 \u05de\u05d0\u05d5\u05d3 \u05d1\u05db\u05d0\u05d1, \u05de\u05d7\u05de\u05d9\u05e6\u05d4 \u05d9\u05de\u05d9 \u05dc\u05d9\u05de\u05d5\u05d3\u05d9\u05dd \u05e8\u05d1\u05d9\u05dd \u05d5\u05d8\u05d5\u05e2\u05e0\u05ea \u05db\u05d9 \"\u05d4\u05e8\u05d5\u05e4\u05d0\u05d9\u05dd \u05de\u05e4\u05e1\u05e4\u05e1\u05d9\u05dd \u05de\u05e9\u05d4\u05d5 \u05e0\u05d5\u05e8\u05d0\". \u05d0\u05de\u05d4 \u05de\u05d1\u05d9\u05e2\u05d4 \u05d7\u05e8\u05d3\u05d4 \u05e7\u05d9\u05e6\u05d5\u05e0\u05d9\u05ea \u05d5\u05d3\u05d5\u05e8\u05e9\u05ea \u05d1\u05d3\u05d9\u05e7\u05d5\u05ea \u05e4\u05d5\u05dc\u05e9\u05e0\u05d9\u05d5\u05ea \u05e0\u05d5\u05e1\u05e4\u05d5\u05ea. \u05de\u05d4\u05d9 \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05de\u05ea\u05d0\u05d9\u05de\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR?",
      "answerOptions": [
        {
          "text": "Somatic Symptom Disorder (SSD)",
          "isCorrect": true,
          "rationale": "\u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d3\u05d5\u05e8\u05e9\u05ea \u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05dd \u05e1\u05d5\u05de\u05d8\u05d9 \u05d0\u05d7\u05d3 \u05d0\u05d5 \u05d9\u05d5\u05ea\u05e8 \u05d4\u05d2\u05d5\u05e8\u05dd \u05dc\u05de\u05e6\u05d5\u05e7\u05d4 \u05d0\u05d5 \u05e9\u05d9\u05d1\u05d5\u05e9 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9, \u05d9\u05d7\u05d3 \u05e2\u05dd \u05de\u05d7\u05e9\u05d1\u05d5\u05ea, \u05e8\u05d2\u05e9\u05d5\u05ea \u05d0\u05d5 \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05d9\u05d5\u05ea \u05de\u05d5\u05d2\u05d6\u05de\u05d9\u05dd \u05d4\u05e7\u05e9\u05d5\u05e8\u05d9\u05dd \u05dc\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd (Criterion B). \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd, \u05ea\u05dc\u05d5\u05e0\u05d4 \u05e2\u05dc \u05db\u05d0\u05d1 \u05d1\u05d8\u05df \u05d1\u05d5\u05d3\u05d3 \u05d5\u05d1\u05d5\u05dc\u05d8 \u05e9\u05db\u05d9\u05d7\u05d4 \u05d9\u05d5\u05ea\u05e8 \u05de\u05d0\u05e9\u05e8 \u05e8\u05d9\u05d1\u05d5\u05d9 \u05ea\u05dc\u05d5\u05e0\u05d5\u05ea (DSM p.351, p.353)."
        },
        {
          "text": "Illness Anxiety Disorder",
          "isCorrect": false,
          "rationale": "\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d6\u05d5 \u05de\u05ea\u05d0\u05d9\u05de\u05d4 \u05db\u05d0\u05e9\u05e8 \u05d4\u05de\u05e6\u05d5\u05e7\u05d4 \u05e0\u05d5\u05d1\u05e2\u05ea \u05de\u05d4\u05d7\u05e8\u05d3\u05d4 \u05de\u05d4\u05de\u05d7\u05dc\u05d4 \u05e2\u05e6\u05de\u05d4, \u05d0\u05da \u05d4\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05d4\u05d2\u05d5\u05e4\u05e0\u05d9\u05d9\u05dd \u05d4\u05dd \u05de\u05d9\u05e0\u05d9\u05de\u05dc\u05d9\u05d9\u05dd \u05d0\u05d5 \u05dc\u05d0 \u05e7\u05d9\u05d9\u05de\u05d9\u05dd \u05db\u05dc\u05dc. \u05d1\u05de\u05e7\u05e8\u05d4 \u05d6\u05d4, \u05d4\u05e0\u05e2\u05e8\u05d4 \u05e1\u05d5\u05d1\u05dc\u05ea \u05de\u05db\u05d0\u05d1 \u05d1\u05d8\u05df \u05de\u05de\u05e9\u05d9 \u05d5\u05de\u05ea\u05de\u05e9\u05da (DSM p.357)."
        },
        {
          "text": "Generalized Anxiety Disorder (GAD)",
          "isCorrect": false,
          "rationale": "\u05d1-GAD \u05d4\u05d3\u05d0\u05d2\u05d5\u05ea \u05de\u05ea\u05e4\u05e8\u05e1\u05d5\u05ea \u05e2\u05dc \u05e4\u05e0\u05d9 \u05ea\u05d7\u05d5\u05de\u05d9 \u05d7\u05d9\u05d9\u05dd \u05e8\u05d1\u05d9\u05dd (\u05dc\u05d9\u05de\u05d5\u05d3\u05d9\u05dd, \u05d7\u05d1\u05e8\u05d4). \u05db\u05d0\u05e9\u05e8 \u05d4\u05de\u05d5\u05e7\u05d3 \u05d4\u05d1\u05dc\u05e2\u05d3\u05d9 \u05d4\u05d5\u05d0 \u05d4\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05dd \u05d4\u05d2\u05d5\u05e4\u05e0\u05d9 \u05d5\u05d4\u05e9\u05dc\u05db\u05d5\u05ea\u05d9\u05d5, SSD \u05d4\u05d9\u05d0 \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05de\u05d5\u05e2\u05d3\u05e4\u05ea (DSM p.250, p.356)."
        },
        {
          "text": "Conversion Disorder",
          "isCorrect": false,
          "rationale": "\u05d4\u05e4\u05e8\u05e2\u05d4 \u05d6\u05d5 \u05de\u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05ea \u05d1\u05d7\u05e1\u05e8 \u05e0\u05d5\u05d9\u05e8\u05d5\u05dc\u05d5\u05d2\u05d9 (\u05de\u05d5\u05d8\u05d5\u05e8\u05d9 \u05d0\u05d5 \u05e1\u05e0\u05e1\u05d5\u05e8\u05d9) \u05e9\u05d0\u05d9\u05e0\u05d5 \u05ea\u05d5\u05d0\u05dd \u05d0\u05ea \u05d4\u05d0\u05e0\u05d8\u05d5\u05de\u05d9\u05d4 \u05d4\u05d9\u05d3\u05d5\u05e2\u05d4. \u05db\u05d0\u05d1 \u05d1\u05d8\u05df \u05d0\u05d9\u05e0\u05d5 \u05e0\u05d7\u05e9\u05d1 \u05dc\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05dd \u05e7\u05dc\u05d0\u05e1\u05d9 \u05e9\u05dc \u05d4\u05e4\u05e8\u05e2\u05d4 \u05d1\u05ea\u05e4\u05e7\u05d5\u05d3 \u05e0\u05d5\u05d9\u05e8\u05d5\u05dc\u05d5\u05d2\u05d9 (DSM p.360)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05e9\u05d9\u05dc\u05d5\u05d1 \u05d1\u05d9\u05df \u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05db\u05d0\u05d1 \u05e4\u05d9\u05d6\u05d9 \u05dc\u05d1\u05d9\u05df \u05e8\u05de\u05ea \u05d4\u05d3\u05d0\u05d2\u05d4 \u05d5\u05d4\u05e9\u05d9\u05d1\u05d5\u05e9 \u05d1\u05ea\u05e4\u05e7\u05d5\u05d3 \u05d4\u05d9\u05d5\u05de\u05d9\u05d5\u05de\u05d9."
    },
    {
      "type": "multiple_choice",
      "question": "\u05d1\u05ea\u05d4\u05dc\u05d9\u05da \u05d4\u05e0\u05d5\u05d9\u05e8\u05d5\u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05e9\u05dc \u05db\u05d0\u05d1 \u05db\u05e8\u05d5\u05e0\u05d9 \u05d4\u05de\u05dc\u05d5\u05d5\u05d4 SSD \u05d0\u05d5 \u05e4\u05d9\u05d1\u05e8\u05d5\u05de\u05d9\u05d0\u05dc\u05d2\u05d9\u05d4, \u05d7\u05dc\u05d9\u05dd \u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd \u05e4\u05dc\u05e1\u05d8\u05d9\u05d9\u05dd \u05d1\u05de\u05d1\u05e0\u05d9\u05dd \u05de\u05d5\u05d7\u05d9\u05d9\u05dd \u05d4\u05de\u05d2\u05d1\u05d9\u05e8\u05d9\u05dd \u05d0\u05ea \u05ea\u05d7\u05d5\u05e9\u05ea \u05d4\u05db\u05d0\u05d1 \u05d2\u05dd \u05d1\u05d4\u05d9\u05e2\u05d3\u05e8 \u05d2\u05d9\u05e8\u05d5\u05d9 \u05e4\u05e8\u05d9\u05e4\u05e8\u05d9\u05d0\u05dc\u05d9. \u05db\u05d9\u05e6\u05d3 \u05de\u05db\u05e0\u05d4 StahlNeuro \u05d0\u05ea \u05d4\u05ea\u05d5\u05e4\u05e2\u05d4 \u05d4\u05de\u05e2\u05e8\u05d1\u05ea \u05d0\u05ea \u05d4-Thalamus \u05d5\u05d4-Somatosensory cortex?",
      "answerOptions": [
        {
          "text": "Suprasegmental Central Sensitization",
          "isCorrect": true,
          "rationale": "\u05ea\u05d4\u05dc\u05d9\u05da \u05d6\u05d4 \u05de\u05ea\u05d9\u05d9\u05d7\u05e1 \u05dc\u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd \u05e4\u05dc\u05e1\u05d8\u05d9\u05d9\u05dd \u05d1\u05de\u05d5\u05d7 (\u05de\u05e2\u05dc \u05e8\u05de\u05ea \u05e2\u05de\u05d5\u05d3 \u05d4\u05e9\u05d3\u05e8\u05d4) \u05d4\u05d2\u05d5\u05e8\u05de\u05d9\u05dd \u05dc\u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05e2\u05e6\u05d1\u05d9\u05dd \u05d4\u05de\u05e8\u05db\u05d6\u05d9\u05ea '\u05dc\u05dc\u05de\u05d5\u05d3' \u05d0\u05ea \u05d4\u05db\u05d0\u05d1 \u05d5\u05dc\u05d4\u05e4\u05d5\u05da \u05d0\u05d5\u05ea\u05d5 \u05dc\u05e7\u05d1\u05d5\u05e2 \u05d0\u05d5 \u05de\u05d5\u05d2\u05d1\u05e8 (StahlNeuro p.385-386)."
        },
        {
          "text": "Segmental Central Sensitization",
          "isCorrect": false,
          "rationale": "\u05de\u05d5\u05e9\u05d2 \u05d6\u05d4 \u05de\u05ea\u05d9\u05d9\u05d7\u05e1 \u05dc\u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd \u05e4\u05dc\u05e1\u05d8\u05d9\u05d9\u05dd \u05d4\u05de\u05ea\u05e8\u05d7\u05e9\u05d9\u05dd \u05d1-Dorsal horn \u05e9\u05dc \u05e2\u05de\u05d5\u05d3 \u05d4\u05e9\u05d3\u05e8\u05d4, \u05dc\u05e8\u05d5\u05d1 \u05e2\u05e7\u05d1 \u05d2\u05d9\u05e8\u05d5\u05d9 \u05db\u05d5\u05d0\u05d1 \u05de\u05ea\u05de\u05e9\u05da \u05de\u05d4\u05e4\u05e8\u05d9\u05e4\u05e8\u05d9\u05d4 (StahlNeuro p.385)."
        },
        {
          "text": "NMDA Receptor Hypoactivity",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05e9\u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 NMDA \u05de\u05e2\u05d5\u05e8\u05d1\u05d9\u05dd \u05d1\u05e4\u05dc\u05e1\u05d8\u05d9\u05d5\u05ea \u05e1\u05d9\u05e0\u05e4\u05d8\u05d9\u05ea, \u05d4\u05d9\u05e4\u05d5\u05d0\u05e7\u05d8\u05d9\u05d1\u05d9\u05d5\u05ea \u05e9\u05dc\u05d4\u05dd \u05d1-PFC \u05de\u05e7\u05d5\u05e9\u05e8\u05ea \u05d1\u05e2\u05d9\u05e7\u05e8 \u05dc\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05e9\u05dc\u05d9\u05dc\u05d9\u05d9\u05dd \u05d5\u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9\u05d9\u05dd \u05d1-Schizophrenia (StahlNeuro p.113)."
        },
        {
          "text": "D2 Receptor Hyperactivity",
          "isCorrect": false,
          "rationale": "\u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05d9\u05ea\u05e8 \u05e9\u05dc \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 D2 \u05d1\u05de\u05e1\u05dc\u05d5\u05dc \u05d4\u05de\u05d6\u05d5\u05dc\u05d9\u05de\u05d1\u05d9 \u05e7\u05e9\u05d5\u05e8\u05d4 \u05dc\u05d4\u05d6\u05d9\u05d5\u05ea \u05d5\u05de\u05d7\u05e9\u05d1\u05d5\u05ea \u05e9\u05d5\u05d5\u05d0, \u05d5\u05dc\u05d0 \u05dc\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05e9\u05dc \u05d4\u05d2\u05d1\u05e8\u05ea \u05db\u05d0\u05d1 \u05e1\u05d5\u05de\u05d8\u05d9 (StahlNeuro p.113)."
        }
      ],
      "hint": "\u05d4\u05de\u05d5\u05e9\u05d2 \u05de\u05ea\u05d0\u05e8 \u05e8\u05d2\u05d9\u05e9\u05d5\u05ea \u05de\u05d5\u05d2\u05d1\u05e8\u05ea \u05d1\u05e8\u05de\u05d4 \u05d4\u05de\u05d5\u05d7\u05d9\u05ea \u05d4\u05d2\u05d1\u05d5\u05d4\u05d4."
    },
    {
      "type": "multiple_choice",
      "question": "\u05d1\u05df 16 \u05de\u05d2\u05d9\u05e2 \u05dc\u05de\u05d9\u05d5\u05df \u05e2\u05dd \u05e9\u05d9\u05ea\u05d5\u05e7 \u05e4\u05ea\u05d0\u05d5\u05de\u05d9 \u05d1\u05e8\u05d2\u05dc \u05e9\u05de\u05d0\u05dc \u05e9\u05d4\u05d5\u05e4\u05d9\u05e2 \u05dc\u05d0\u05d7\u05e8 \u05db\u05d9\u05e9\u05dc\u05d5\u05df \u05d1\u05de\u05d1\u05d7\u05df. \u05d1\u05d1\u05d3\u05d9\u05e7\u05d4 \u05e4\u05d9\u05d6\u05d9\u05e7\u05dc\u05d9\u05ea \u05e0\u05de\u05e6\u05d0 \u05e1\u05d9\u05de\u05df Hoover \u05d7\u05d9\u05d5\u05d1\u05d9 (\u05d7\u05d5\u05dc\u05e9\u05d4 \u05e8\u05e6\u05d5\u05e0\u05d9\u05ea \u05e9\u05dc \u05e4\u05e9\u05d9\u05d8\u05ea \u05d4\u05d9\u05e8\u05da \u05e0\u05e2\u05dc\u05de\u05ea \u05d1\u05e2\u05ea \u05e4\u05e9\u05d9\u05d8\u05d4 \u05e9\u05dc \u05d4\u05e8\u05d2\u05dc \u05d4\u05e0\u05d2\u05d3\u05d9\u05ea \u05db\u05e0\u05d2\u05d3 \u05d4\u05ea\u05e0\u05d2\u05d3\u05d5\u05ea). \u05de\u05d4\u05d5 \u05d4\u05e9\u05d9\u05e0\u05d5\u05d9 \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05d1\u05d2\u05d9\u05e9\u05ea \u05d4-DSM-5-TR \u05dc\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d6\u05d5 \u05d1\u05d4\u05e9\u05d5\u05d5\u05d0\u05d4 \u05dc\u05de\u05d4\u05d3\u05d5\u05e8\u05d5\u05ea \u05e7\u05d5\u05d3\u05de\u05d5\u05ea?",
      "answerOptions": [
        {
