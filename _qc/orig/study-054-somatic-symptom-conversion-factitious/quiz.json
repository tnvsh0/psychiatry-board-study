          "bluffs": [
            "\u05d0\u05de\u05d9\u05e8\u05d4 \u05db\u05dc\u05dc\u05d9\u05ea \u05e9\u05d4\u05dd \u05d3\u05d5\u05de\u05d9\u05dd \u05db\u05d9 \u05e9\u05e0\u05d9\u05d4\u05dd \u05de\u05e9\u05e7\u05e8\u05d9\u05dd \u05d1\u05dc\u05d9 \u05dc\u05d4\u05e1\u05d1\u05d9\u05e8 \u05d0\u05ea \u05d4\u05d4\u05d1\u05d3\u05dc \u05d1\u05e8\u05d5\u05d5\u05d7."
          ]
        }
      },
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05de\u05d5\u05e9\u05d2 '\u05e8\u05d5\u05d5\u05d7 \u05de\u05e9\u05e0\u05d9' (Secondary gain) \u05d5\u05e2\u05dc \u05d4\u05de\u05d8\u05e8\u05d4 \u05e9\u05dc \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05de\u05d5\u05dc \u05d4\u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05e8\u05e4\u05d5\u05d0\u05d9\u05ea."
    },
    {
      "type": "multiple_choice",
      "question": "\u05db\u05d9\u05e6\u05d3 \u05de\u05e9\u05e4\u05d9\u05e2 \u05ea\u05e4\u05e7\u05d9\u05d3 \u05d4\u05d4\u05d5\u05e8\u05d9\u05dd (Caregivers) \u05e2\u05dc \u05d4\u05de\u05d4\u05dc\u05da \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9 \u05e9\u05dc \u05d9\u05dc\u05d3 \u05e2\u05dd \u05ea\u05dc\u05d5\u05e0\u05d5\u05ea \u05e1\u05d5\u05de\u05d8\u05d9\u05d5\u05ea \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR \u05d5\u05d4-Dulcan?",
      "answerOptions": [
        {
          "text": "\u05d4\u05ea\u05d2\u05d5\u05d1\u05d4 \u05d5\u05d4\u05e4\u05e8\u05e9\u05e0\u05d5\u05ea \u05e9\u05dc \u05d4\u05d4\u05d5\u05e8\u05d9\u05dd \u05dc\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05e7\u05d5\u05d1\u05e2\u05d9\u05dd \u05d1\u05de\u05d9\u05d3\u05d4 \u05e8\u05d1\u05d4 \u05d0\u05ea \u05e8\u05de\u05ea \u05d4\u05de\u05e6\u05d5\u05e7\u05d4 \u05e9\u05dc \u05d4\u05d9\u05dc\u05d3 \u05d5\u05d0\u05ea \u05de\u05d9\u05d3\u05ea \u05d4\u05e4\u05e0\u05d9\u05d9\u05d4 \u05dc\u05d1\u05d3\u05d9\u05e7\u05d5\u05ea \u05e4\u05d5\u05dc\u05e9\u05e0\u05d9\u05d5\u05ea.",
          "isCorrect": true,
          "rationale": "\u05de\u05e2\u05d5\u05e8\u05d1\u05d5\u05ea \u05d4\u05d4\u05d5\u05e8\u05d9\u05dd \u05e7\u05e8\u05d9\u05d8\u05d9\u05ea; \u05d7\u05e8\u05d3\u05ea\u05dd \u05d5\u05d3\u05e8\u05d9\u05e9\u05ea\u05dd \u05dc\u05d4\u05ea\u05e2\u05e8\u05d1\u05d5\u05ea \u05e8\u05e4\u05d5\u05d0\u05d9\u05ea \u05d9\u05db\u05d5\u05dc\u05d5\u05ea \u05dc\u05d4\u05e0\u05e6\u05d9\u05d7 \u05d0\u05ea \u05d4-Sick role \u05d5\u05dc\u05d4\u05d2\u05d1\u05d9\u05e8 \u05d0\u05ea \u05d4\u05d9\u05e2\u05d3\u05e8\u05d5\u05d9\u05d5\u05ea \u05de\u05d1\u05d9\u05ea \u05d4\u05e1\u05e4\u05e8 (DSM p.353, Dulcan p.235)."
        },
        {
          "text": "\u05dc\u05d4\u05d5\u05e8\u05d9\u05dd \u05d0\u05d9\u05df \u05d4\u05e9\u05e4\u05e2\u05d4 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05e2\u05dc \u05e2\u05d5\u05e6\u05de\u05ea \u05d4\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd, \u05e9\u05db\u05df \u05d4\u05de\u05e7\u05d5\u05e8 \u05d4\u05d5\u05d0 \u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9-\u05d2\u05e0\u05d8\u05d9 \u05d1\u05dc\u05d1\u05d3.",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05e9\u05d9\u05e9 \u05de\u05e8\u05db\u05d9\u05d1 \u05d2\u05e0\u05d8\u05d9, \u05d4\u05e1\u05d1\u05d9\u05d1\u05d4 \u05d5\u05d4\u05ea\u05d2\u05d5\u05d1\u05d4 \u05d4\u05d4\u05d5\u05e8\u05d9\u05ea \u05d4\u05dd \u05d2\u05d5\u05e8\u05de\u05d9\u05dd \u05de\u05e2\u05e6\u05d1\u05d9\u05dd \u05de\u05e8\u05db\u05d6\u05d9\u05d9\u05dd \u05d1-Somatic symptom disorders (DSM p.353)."
        },
        {
          "text": "\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d4\u05d4\u05d5\u05e8\u05d9\u05dd \u05e8\u05dc\u05d5\u05d5\u05e0\u05d8\u05d9\u05ea \u05e8\u05e7 \u05d1\u05de\u05e7\u05e8\u05d9\u05dd \u05e9\u05dc Factitious Disorder Imposed on Another.",
          "isCorrect": false,
          "rationale": "\u05d4\u05e9\u05e4\u05e2\u05ea \u05d4\u05d4\u05d5\u05e8\u05d9\u05dd \u05e8\u05dc\u05d5\u05d5\u05e0\u05d8\u05d9\u05ea \u05dc\u05db\u05dc \u05e7\u05e9\u05ea \u05d4\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05d4\u05e1\u05d5\u05de\u05d8\u05d9\u05d5\u05ea, \u05d1\u05de\u05d9\u05d5\u05d7\u05d3 \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05e6\u05e2\u05d9\u05e8\u05d9\u05dd \u05e9\u05ea\u05dc\u05d5\u05d9\u05d9\u05dd \u05d1\u05e4\u05e8\u05e9\u05e0\u05d5\u05ea \u05d4\u05de\u05d1\u05d5\u05d2\u05e8 (DSM p.353)."
        },
        {
          "text": "\u05d2\u05d9\u05e9\u05d4 \u05d4\u05d5\u05e8\u05d9\u05ea \u05e1\u05de\u05db\u05d5\u05ea\u05d9\u05ea (Authoritarian) \u05d4\u05d9\u05d0 \u05d4\u05d3\u05e8\u05da \u05d4\u05de\u05d5\u05de\u05dc\u05e6\u05ea \u05d4\u05d9\u05d7\u05d9\u05d3\u05d4 \u05dc\u05d4\u05e4\u05e1\u05e7\u05ea \u05d4\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd.",
          "isCorrect": false,
          "rationale": "\u05d4\u05d2\u05d9\u05e9\u05d4 \u05d4\u05de\u05d5\u05de\u05dc\u05e6\u05ea \u05d4\u05d9\u05d0 \u05d1\u05e8\u05d9\u05ea \u05d8\u05d9\u05e4\u05d5\u05dc\u05d9\u05ea (Therapeutic alliance) \u05d5\u05d4\u05d1\u05e0\u05d4 biopsychosocial, \u05d5\u05dc\u05d0 \u05d1\u05d4\u05db\u05e8\u05d7 \u05e1\u05de\u05db\u05d5\u05ea\u05e0\u05d5\u05ea (Dulcan p.686)."
        }
      ],
      "hint": "\u05d4\u05ea\u05de\u05e7\u05d3 \u05d1\u05d3\u05d9\u05e0\u05de\u05d9\u05e7\u05d4 \u05e9\u05d1\u05d9\u05df \u05d7\u05e8\u05d3\u05ea \u05d4\u05d4\u05d5\u05e8\u05d4 \u05dc\u05d1\u05d9\u05df \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d4\u05d9\u05dc\u05d3 \u05e1\u05d1\u05d9\u05d1 \u05de\u05d7\u05dc\u05d4."
    }
