{
  "title": "Anorexia Quiz",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\u05d1\u05ea 15 \u05de\u05d5\u05d1\u05d0\u05ea \u05dc\u05d4\u05e2\u05e8\u05db\u05d4 \u05e2\u05e7\u05d1 \u05d9\u05e8\u05d9\u05d3\u05d4 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05d1\u05de\u05e9\u05e7\u05dc \u05d5\u05d4\u05d9\u05de\u05e0\u05e2\u05d5\u05ea \u05de\u05d5\u05d7\u05dc\u05d8\u05ea \u05de\u05e4\u05d7\u05de\u05d9\u05de\u05d5\u05ea. \u05d1\u05e8\u05d0\u05d9\u05d5\u05df \u05d4\u05d9\u05d0 \u05de\u05db\u05d7\u05d9\u05e9\u05d4 \u05e4\u05d7\u05d3 \u05de\u05e2\u05dc\u05d9\u05d9\u05d4 \u05d1\u05de\u05e9\u05e7\u05dc (fear of weight gain) \u05d5\u05d8\u05d5\u05e2\u05e0\u05ea \u05e9\u05d4\u05d9\u05d0 \u05e8\u05e7 \u05e8\u05d5\u05e6\u05d4 '\u05dc\u05d0\u05db\u05d5\u05dc \u05d1\u05e8\u05d9\u05d0'. \u05e2\u05dd \u05d6\u05d0\u05ea, \u05d4\u05d5\u05e8\u05d9\u05d4 \u05de\u05d3\u05d5\u05d5\u05d7\u05d9\u05dd \u05db\u05d9 \u05d4\u05d9\u05d0 \u05de\u05d1\u05dc\u05d4 \u05e9\u05e2\u05d5\u05ea \u05de\u05d5\u05dc \u05d4\u05de\u05e8\u05d0\u05d4 \u05d5\u05d1\u05d5\u05d3\u05e7\u05ea \u05d0\u05ea \u05d4\u05d9\u05e7\u05e3 \u05d4\u05d9\u05e8\u05db\u05d9\u05d9\u05dd \u05e9\u05dc\u05d4. \u05db\u05d9\u05e6\u05d3 \u05e0\u05d9\u05ea\u05df \u05dc\u05d1\u05e1\u05e1 \u05d0\u05ea Criterion B \u05dc\u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc Anorexia Nervosa \u05d1\u05de\u05e7\u05e8\u05d4 \u05d6\u05d4?",
      "answerOptions": [
        {
          "text": "\u05e0\u05d9\u05ea\u05df \u05dc\u05d4\u05e1\u05d9\u05e7 \u05e2\u05dc \u05e7\u05d9\u05d5\u05dd \u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df \u05de\u05ea\u05d5\u05da \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05e2\u05e7\u05d1\u05d9\u05ea \u05d4\u05de\u05d5\u05e0\u05e2\u05ea \u05e2\u05dc\u05d9\u05d4 \u05d1\u05de\u05e9\u05e7\u05dc (persistent behavior), \u05d2\u05dd \u05dc\u05dc\u05d0 \u05d3\u05d9\u05d5\u05d5\u05d7 \u05e1\u05d5\u05d1\u05d9\u05d9\u05e7\u05d8\u05d9\u05d1\u05d9 \u05e2\u05dc \u05e4\u05d7\u05d3.",
          "isCorrect": true,
          "rationale": "\u05dc\u05e4\u05d9 \u05d4-DSM, \u05d1\u05de\u05e7\u05e8\u05d9\u05dd \u05e9\u05dc \u05d4\u05db\u05d7\u05e9\u05ea \u05e4\u05d7\u05d3, \u05e0\u05d9\u05ea\u05df \u05dc\u05d4\u05e9\u05ea\u05de\u05e9 \u05d1\u05ea\u05e6\u05e4\u05d9\u05d5\u05ea \u05e7\u05dc\u05d9\u05e0\u05d9\u05d5\u05ea \u05e2\u05dc \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05d9\u05d5\u05ea \u05d4\u05de\u05d5\u05e0\u05e2\u05d5\u05ea \u05e2\u05dc\u05d9\u05d4 \u05d1\u05de\u05e9\u05e7\u05dc \u05d0\u05d5 \u05d1\u05de\u05d9\u05d3\u05e2 \u05de\u05de\u05e7\u05d5\u05e8\u05d5\u05ea \u05e0\u05d5\u05e1\u05e4\u05d9\u05dd \u05db\u05d3\u05d9 \u05dc\u05d1\u05e1\u05e1 \u05d0\u05ea Criterion B (DSM p.383)."
        },
        {
          "text": "\u05dc\u05d0 \u05e0\u05d9\u05ea\u05df \u05dc\u05d0\u05d1\u05d7\u05df Anorexia Nervosa \u05dc\u05dc\u05d0 \u05d3\u05d9\u05d5\u05d5\u05d7 \u05de\u05e4\u05d5\u05e8\u05e9 \u05e9\u05dc \u05d4\u05de\u05d8\u05d5\u05e4\u05dc\u05ea \u05e2\u05dc \u05e4\u05d7\u05d3 \u05e2\u05d6 \u05de\u05d4\u05e9\u05de\u05e0\u05d4.",
          "isCorrect": false,
          "rationale": "\u05d2\u05d9\u05e9\u05d4 \u05d6\u05d5 \u05e9\u05d2\u05d5\u05d9\u05d4 \u05de\u05d0\u05d7\u05e8 \u05e9\u05d4-DSM \u05de\u05d0\u05e4\u05e9\u05e8 \u05d0\u05d1\u05d7\u05e0\u05d4 \u05e2\u05dc \u05e1\u05de\u05da \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05e2\u05e7\u05d1\u05d9\u05ea \u05d4\u05de\u05e4\u05e8\u05d9\u05e2\u05d4 \u05dc\u05e2\u05dc\u05d9\u05d9\u05d4 \u05d1\u05de\u05e9\u05e7\u05dc, \u05d1\u05de\u05d9\u05d5\u05d7\u05d3 \u05d1\u05e7\u05e8\u05d1 \u05e6\u05e2\u05d9\u05e8\u05d9\u05dd \u05d4\u05e0\u05d5\u05d8\u05d9\u05dd \u05dc\u05d4\u05db\u05d7\u05d9\u05e9 \u05d0\u05ea \u05d4\u05e4\u05d7\u05d3 (DSM p.382)."
        },
        {
          "text": "\u05d9\u05e9 \u05dc\u05d4\u05de\u05ea\u05d9\u05df \u05e2\u05d3 \u05e9\u05d4-BMI \u05d9\u05d9\u05e8\u05d3 \u05de\u05ea\u05d7\u05ea \u05dc-15 $kg/m^{2}$ \u05dc\u05e4\u05e0\u05d9 \u05e9\u05e7\u05d5\u05d1\u05e2\u05d9\u05dd \u05e9\u05d4\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05de\u05d4\u05d5\u05d5\u05d4 \u05ea\u05d7\u05dc\u05d9\u05e3 \u05dc\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df \u05d4\u05e4\u05d7\u05d3.",
          "isCorrect": false,
          "rationale": "\u05d7\u05d5\u05de\u05e8\u05ea \u05d4\u05de\u05e9\u05e7\u05dc \u05d4\u05d9\u05d0 \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df \u05e0\u05e4\u05e8\u05d3 (Criterion A) \u05d5\u05d0\u05d9\u05e0\u05d4 \u05ea\u05e0\u05d0\u05d9 \u05de\u05e7\u05d3\u05d9\u05dd \u05dc\u05d4\u05e2\u05e8\u05db\u05ea \u05d4\u05e4\u05d7\u05d3 \u05de\u05e2\u05dc\u05d9\u05d9\u05d4 \u05d1\u05de\u05e9\u05e7\u05dc (DSM p.381)."
        },
        {
          "text": "\u05e7\u05d9\u05d5\u05dd \u05e2\u05d9\u05e1\u05d5\u05e7 \u05d1\u05d1\u05d3\u05d9\u05e7\u05ea \u05d4\u05d2\u05d5\u05e3 (body checking) \u05de\u05d4\u05d5\u05d5\u05d4 \u05d4\u05d5\u05db\u05d7\u05d4 \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9\u05ea \u05dc\u05e7\u05d9\u05d5\u05dd Criterion C \u05d1\u05dc\u05d1\u05d3, \u05d5\u05d0\u05d9\u05e0\u05d5 \u05e8\u05dc\u05d5\u05d5\u05e0\u05d8\u05d9 \u05dc-Criterion B.",
          "isCorrect": false,
          "rationale": "\u05d1\u05d3\u05d9\u05e7\u05ea \u05d2\u05d5\u05e3 \u05d0\u05db\u05df \u05e7\u05e9\u05d5\u05e8\u05d4 \u05dc-Criterion C, \u05d0\u05da \u05d4\u05d9\u05d0 \u05d2\u05dd \u05e2\u05e9\u05d5\u05d9\u05d4 \u05dc\u05ea\u05de\u05d5\u05da \u05d1\u05d4\u05e1\u05e7\u05d4 \u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05dc\u05d2\u05d1\u05d9 \u05e7\u05d9\u05d5\u05dd \u05e4\u05d7\u05d3 \u05e1\u05de\u05d5\u05d9 \u05de\u05e2\u05dc\u05d9\u05d9\u05d4 \u05d1\u05de\u05e9\u05e7\u05dc \u05d1\u05de\u05e1\u05d2\u05e8\u05ea Criterion B (DSM p.383)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d1\u05d5 \u05e2\u05dc \u05d4\u05d3\u05e8\u05db\u05d9\u05dd \u05d1\u05d4\u05df \u05d4-DSM \u05de\u05d0\u05e4\u05e9\u05e8 \u05dc\u05d0\u05d1\u05d7\u05df \u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd \u05e6\u05e2\u05d9\u05e8\u05d9\u05dd \u05d4\u05de\u05e4\u05d2\u05d9\u05e0\u05d9\u05dd \u05d7\u05d5\u05e1\u05e8 \u05ea\u05d5\u05d1\u05e0\u05d4 \u05d0\u05d5 \u05d4\u05db\u05d7\u05e9\u05d4.",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05d0\u05d9\u05d6\u05d4 \u05de\u05d4\u05e1\u05d9\u05d1\u05d5\u05db\u05d9\u05dd \u05d4\u05e8\u05e4\u05d5\u05d0\u05d9\u05d9\u05dd \u05d4\u05d1\u05d0\u05d9\u05dd \u05e9\u05dc Anorexia Nervosa \u05d1\u05d2\u05d9\u05dc \u05d4\u05d4\u05ea\u05d1\u05d2\u05e8\u05d5\u05ea \u05e0\u05d7\u05e9\u05d1 \u05dc\u05d1\u05e2\u05dc \u05e4\u05d5\u05d8\u05e0\u05e6\u05d9\u05d0\u05dc \u05d4\u05e0\u05d6\u05e7 \u05d4\u05d1\u05dc\u05ea\u05d9-\u05d4\u05e4\u05d9\u05da \u05d4\u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9 \u05d1\u05d9\u05d5\u05ea\u05e8, \u05d2\u05dd \u05dc\u05d0\u05d7\u05e8 \u05e9\u05d9\u05e7\u05d5\u05dd \u05de\u05e9\u05e7\u05dc \u05de\u05dc\u05d0 (weight restoration)?",
      "answerOptions": [
        {
          "text": "\u05d9\u05e8\u05d9\u05d3\u05d4 \u05d1\u05e6\u05e4\u05d9\u05e4\u05d5\u05ea \u05d4\u05e2\u05e6\u05dd (Peak bone mass reduction) \u05d5\u05e1\u05d9\u05db\u05d5\u05df \u05de\u05d5\u05d2\u05d1\u05e8 \u05dc-Osteoporosis.",
          "isCorrect": true,
          "rationale": "\u05d0\u05d5\u05d1\u05d3\u05df \u05e6\u05e4\u05d9\u05e4\u05d5\u05ea \u05e2\u05e6\u05dd \u05d1\u05d2\u05d9\u05dc \u05d4\u05d4\u05ea\u05d1\u05d2\u05e8\u05d5\u05ea \u05e2\u05e7\u05d1 \u05d7\u05e1\u05e8 \u05d0\u05e1\u05d8\u05e8\u05d5\u05d2\u05e0\u05d9 \u05d5\u05ea\u05ea-\u05ea\u05d6\u05d5\u05e0\u05d4 \u05dc\u05e2\u05d9\u05ea\u05d9\u05dd \u05e7\u05e8\u05d5\u05d1\u05d5\u05ea \u05d0\u05d9\u05e0\u05d5 \u05d4\u05e4\u05d9\u05da \u05d1\u05de\u05dc\u05d5\u05d0\u05d5, \u05de\u05d4 \u05e9\u05de\u05e2\u05dc\u05d4 \u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05e9\u05d1\u05e8\u05d9\u05dd \u05d1\u05e2\u05ea\u05d9\u05d3 (Dulcan p.420, DSM p.385)."
        },
        {
          "text": "Sinus Bradycardia \u05d5\u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd \u05d1\u05de\u05d5\u05dc\u05d9\u05db\u05d5\u05ea \u05d4\u05dc\u05d1\u05d1\u05d9\u05ea.",
          "isCorrect": false,
          "rationale": "\u05d1\u05e8\u05d3\u05d9\u05e7\u05e8\u05d3\u05d9\u05d4 \u05d5\u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd \u05e4\u05d9\u05d6\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05d9\u05dd \u05d1\u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05dc\u05d1 \u05d5\u05db\u05dc\u05d9 \u05d4\u05d3\u05dd \u05dc\u05e8\u05d5\u05d1 \u05d7\u05d5\u05dc\u05e4\u05d9\u05dd \u05d5\u05de\u05ea\u05e0\u05e8\u05de\u05dc\u05d9\u05dd \u05e2\u05dd \u05d4\u05e9\u05d9\u05e7\u05d5\u05dd \u05d4\u05ea\u05d6\u05d5\u05e0\u05ea\u05d9 \u05d5\u05d4\u05e2\u05dc\u05d9\u05d9\u05d4 \u05d1\u05de\u05e9\u05e7\u05dc (DSM p.385)."
        },
        {
          "text": "Amenorrhea \u05d5\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05d1\u05de\u05d7\u05d6\u05d5\u05e8 \u05d4\u05d7\u05d5\u05d3\u05e9\u05d9.",
          "isCorrect": false,
          "rationale": "\u05d0\u05dc-\u05d5\u05d5\u05e1\u05ea \u05de\u05e9\u05e0\u05d9 \u05dc\u05ea\u05ea-\u05ea\u05d6\u05d5\u05e0\u05d4 \u05dc\u05e8\u05d5\u05d1 \u05d7\u05d5\u05dc\u05e3 \u05d1\u05e8\u05d2\u05e2 \u05e9\u05d4\u05d2\u05d5\u05e3 \u05de\u05d2\u05d9\u05e2 \u05dc\u05d0\u05d7\u05d5\u05d6 \u05e9\u05d5\u05de\u05df \u05d5\u05de\u05e9\u05e7\u05dc \u05e7\u05e8\u05d9\u05d8\u05d9 \u05d4\u05de\u05d0\u05e4\u05e9\u05e8 \u05d7\u05d6\u05e8\u05d4 \u05e9\u05dc \u05d4\u05e6\u05d9\u05e8 \u05d4\u05d4\u05d5\u05e8\u05de\u05d5\u05e0\u05dc\u05d9 (DSM p.385)."
        },
        {
          "text": "\u05e2\u05dc\u05d9\u05d9\u05d4 \u05d1\u05d0\u05e0\u05d6\u05d9\u05de\u05d9 \u05db\u05d1\u05d3 (Hepatic enzymes) \u05d5\u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd \u05d4\u05de\u05d8\u05d5\u05dc\u05d5\u05d2\u05d9\u05d9\u05dd \u05db\u05de\u05d5 Leukopenia.",
          "isCorrect": false,
          "rationale": "\u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd \u05d0\u05dc\u05d5 \u05d4\u05dd \u05ea\u05d5\u05e6\u05d0\u05d4 \u05d9\u05e9\u05d9\u05e8\u05d4 \u05e9\u05dc \u05d4\u05e8\u05e2\u05d1\u05d4 \u05d5\u05de\u05ea\u05e0\u05e8\u05de\u05dc\u05d9\u05dd \u05d1\u05de\u05d4\u05d9\u05e8\u05d5\u05ea \u05d9\u05d7\u05e1\u05d9\u05ea \u05e2\u05dd \u05ea\u05d6\u05d5\u05e0\u05d4 \u05e0\u05d0\u05d5\u05ea\u05d4 (DSM p.385)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d1\u05d5 \u05e2\u05dc \u05e8\u05e7\u05de\u05d4 \u05d1\u05d2\u05d5\u05e3 \u05d4\u05de\u05d2\u05d9\u05e2\u05d4 \u05dc\u05e9\u05d9\u05d0 \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d4 \u05d3\u05d5\u05d5\u05e7\u05d0 \u05d1\u05e9\u05e0\u05d5\u05ea \u05d4\u05d4\u05ea\u05d1\u05d2\u05e8\u05d5\u05ea \u05d5\u05de\u05d5\u05e9\u05e4\u05e2\u05ea \u05de\u05e9\u05d9\u05dc\u05d5\u05d1 \u05e9\u05dc \u05ea\u05d6\u05d5\u05e0\u05d4 \u05d5\u05d4\u05d5\u05e8\u05de\u05d5\u05e0\u05d9\u05dd.",
      "imageUrls": []
    },
    {
      "type": "fill_in_the_blank",
      "question": "\u05d1\u05de\u05d4\u05dc\u05da \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Refeeding Syndrome, \u05d4\u05d0\u05dc\u05e7\u05d8\u05e8\u05d5\u05dc\u05d9\u05d8 \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05e9\u05e8\u05de\u05ea\u05d5 \u05d1\u05d3\u05dd \u05e6\u05d5\u05e0\u05d7\u05ea \u05d1\u05de\u05d4\u05d9\u05e8\u05d5\u05ea \u05e2\u05e7\u05d1 \u05db\u05e0\u05d9\u05e1\u05ea \u05d0\u05d9\u05e0\u05e1\u05d5\u05dc\u05d9\u05df \u05d5\u05d2\u05dc\u05d5\u05e7\u05d5\u05d6 \u05dc\u05ea\u05d0\u05d9\u05dd, \u05d5\u05e2\u05dc\u05d5\u05dc\u05d4 \u05dc\u05d4\u05d5\u05d1\u05d9\u05dc \u05dc\u05db\u05e9\u05dc \u05e8\u05d1-\u05de\u05e2\u05e8\u05db\u05ea\u05d9 \u05d5\u05de\u05d5\u05d5\u05ea, \u05d4\u05d5\u05d0 ___.",
      "bestAnswer": "Phosphate",
      "acceptableAnswers": [
