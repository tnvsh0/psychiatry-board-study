          "isCorrect": false,
          "rationale": "\u05d0\u05d9\u05df \u05d0\u05e9\u05db\u05d5\u05dc \u05db\u05d6\u05d4 \u05d1-DSM-5-TR; \u05e7\u05d9\u05d9\u05de\u05d9\u05dd \u05e8\u05e7 \u05d0\u05e9\u05db\u05d5\u05dc\u05d5\u05ea A, B \u05d5-C (DSM p.734)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05d0\u05e9\u05db\u05d5\u05dc \u05d4\u05db\u05d5\u05dc\u05dc \u05d3\u05e4\u05d5\u05e1\u05d9\u05dd \u05e9\u05dc \u05e0\u05d9\u05ea\u05d5\u05e7 \u05d5\u05de\u05d5\u05d6\u05e8\u05d5\u05ea.",
      "citation": "(DSM p.734)"
    },
    {
      "question": "\u05d1\u05d1\u05d5\u05d0\u05e0\u05d5 \u05dc\u05d1\u05e6\u05e2 \u05d0\u05d1\u05d7\u05e0\u05d4 \u05de\u05d1\u05d3\u05dc\u05ea (Differential Diagnosis) \u05dc\u05d4\u05e4\u05e8\u05e2\u05ea \u05d0\u05d9\u05e9\u05d9\u05d5\u05ea, \u05de\u05d3\u05d5\u05e2 \u05d7\u05e9\u05d5\u05d1 \u05dc\u05d4\u05e2\u05e8\u05d9\u05da \u05d0\u05ea \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05dc\u05d0\u05d5\u05e8\u05da \u05d6\u05de\u05df \u05d5\u05d1\u05de\u05e1\u05e4\u05e8 \u05e4\u05d2\u05d9\u05e9\u05d5\u05ea (Longitudinal evaluation)?",
      "answerOptions": [
        {
          "text": "\u05db\u05d3\u05d9 \u05dc\u05d4\u05d1\u05d7\u05d9\u05df \u05d1\u05d9\u05df \u05ea\u05db\u05d5\u05e0\u05d5\u05ea \u05d0\u05d9\u05e9\u05d9\u05d5\u05ea \u05d9\u05e6\u05d9\u05d1\u05d5\u05ea \u05dc\u05d1\u05d9\u05df \u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9\u05dd \u05d4\u05de\u05d5\u05e4\u05d9\u05e2\u05d9\u05dd \u05db\u05ea\u05d2\u05d5\u05d1\u05d4 \u05dc\u05e1\u05d8\u0e23\u0e2a\u05d5\u05e8\u05d9\u05dd \u05d6\u05de\u05e0\u05d9\u05d9\u05dd \u05d0\u05d5 \u05dc\u05de\u05e6\u05d1\u05d9 State \u05e0\u05e4\u05e9\u05d9\u05d9\u05dd.",
          "isCorrect": true,
          "rationale": "\u05ea\u05db\u05d5\u05e0\u05d5\u05ea PD \u05d7\u05d9\u05d9\u05d1\u05d5\u05ea \u05dc\u05d4\u05d5\u05e4\u05d9\u05e2 \u05dc\u05e4\u05e0\u05d9 \u05d4\u05d1\u05d2\u05e8\u05d5\u05ea \u05d4\u05de\u05d5\u05e7\u05d3\u05de\u05ea \u05d5\u05dc\u05d4\u05d9\u05d5\u05ea \u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05d9\u05d5\u05ea \u05dc\u05ea\u05e4\u05e7\u05d5\u05d3 \u05d0\u05e8\u05d5\u05da \u05d4\u05d8\u05d5\u05d5\u05d7, \u05d5\u05dc\u05d0 \u05dc\u05d4\u05d5\u05e4\u05d9\u05e2 \u05e8\u05e7 \u05d1\u05de\u05d4\u05dc\u05da \u05d0\u05e4\u05d9\u05d6\u05d5\u05d3\u05d4 \u05e9\u05dc \u05d4\u05e4\u05e8\u05e2\u05d4 \u05d0\u05d7\u05e8\u05ea (DSM p.737)."
        },
        {
          "text": "\u05db\u05d3\u05d9 \u05dc\u05d5\u05d5\u05d3\u05d0 \u05e9\u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05dc\u05d0 \u05de\u05e9\u05e7\u05e8 \u05dc\u05d2\u05d1\u05d9 \u05d4\u05e2\u05d1\u05e8 \u05d4\u05e4\u05dc\u05d9\u05dc\u05d9 \u05e9\u05dc\u05d5.",
          "isCorrect": false,
          "rationale": "\u05d1\u05e2\u05d5\u05d3 \u05e9\u05de\u05d9\u05d3\u05e2 \u05e0\u05d5\u05e1\u05e3 \u05d7\u05e9\u05d5\u05d1, \u05d4\u05de\u05d8\u05e8\u05d4 \u05d4\u05de\u05e8\u05db\u05d6\u05d9\u05ea \u05d1-Longitudinal evaluation \u05d4\u05d9\u05d0 \u05d9\u05e6\u05d9\u05d1\u05d5\u05ea \u05d4\u05d3\u05e4\u05d5\u05e1 \u05de\u05d5\u05dc \u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05d7\u05d5\u05dc\u05e4\u05d9\u05dd (DSM p.737)."
        },
        {
          "text": "\u05de\u05db\u05d9\u05d5\u05d5\u05df \u05e9\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05d0\u05d9\u05e9\u05d9\u05d5\u05ea \u05ea\u05de\u05d9\u05d3 \u05e0\u05e2\u05dc\u05de\u05d5\u05ea \u05dc\u05d0\u05d7\u05e8 \u05d2\u05d9\u05dc 40 \u05d5\u05dc\u05db\u05df \u05d9\u05e9 \u05dc\u05e2\u05e7\u05d5\u05d1 \u05d0\u05d7\u05e8\u05d9 \u05d4\u05e9\u05d9\u05e4\u05d5\u05e8.",
          "isCorrect": false,
          "rationale": "\u05d7\u05dc\u05e7 \u05de\u05d4\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea (\u05db\u05de\u05d5 Antisocial) \u05e2\u05e9\u05d5\u05d9\u05d5\u05ea \u05dc\u05d4\u05e9\u05ea\u05e4\u05e8 \u05e2\u05dd \u05d4\u05d2\u05d9\u05dc, \u05d0\u05da \u05d6\u05d5 \u05d0\u05d9\u05e0\u05d4 \u05e1\u05d9\u05d1\u05ea \u05d4\u05d4\u05e2\u05e8\u05db\u05d4 \u05d4\u05de\u05e7\u05d5\u05e8\u05d9\u05ea (DSM p.736)."
        },
        {
          "text": "\u05db\u05d3\u05d9 \u05dc\u05de\u05d3\u05d5\u05d3 \u05d0\u05ea \u05d4\u05e9\u05d9\u05e0\u05d5\u05d9 \u05d1-Neurotransmitter levels \u05d1\u05de\u05d5\u05d7 \u05dc\u05d0\u05d5\u05e8\u05da \u05d6\u05de\u05df.",
          "isCorrect": false,
          "rationale": "\u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05d9\u05d0 \u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05d5\u05de\u05d1\u05d5\u05e1\u05e1\u05ea \u05e2\u05dc \u05ea\u05e6\u05e4\u05d9\u05ea \u05d5\u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4, \u05d5\u05dc\u05d0 \u05e2\u05dc \u05de\u05d3\u05d9\u05d3\u05ea \u05e0\u05d5\u05d9\u05e8\u05d5\u05d8\u05e8\u05e0\u05e1\u05de\u05d9\u05d8\u05d5\u05e8\u05d9\u05dd (StahlNeuro p.894)."
        }
      ],
      "hint": "\u05de\u05d4 \u05de\u05d1\u05d3\u05d9\u05dc \u05d1\u05d9\u05df \u05de\u05d9\u05e9\u05d4\u05d5 \u05e9\u05ea\u05de\u05d9\u05d3 \u05d4\u05d9\u05d4 \u05d7\u05e9\u05d3\u05df \u05dc\u05d1\u05d9\u05df \u05de\u05d9\u05e9\u05d4\u05d5 \u05e9\u05d4\u05e4\u05da \u05dc\u05d7\u05e9\u05d3\u05df \u05e8\u05e7 \u05e2\u05db\u05e9\u05d9\u05d5 \u05db\u05e9\u05d4\u05d5\u05d0 \u05d1\u05d3\u05d9\u05db\u05d0\u05d5\u05df?",
      "citation": "(DSM p.736-737)"
    },
    {
      "question": "\u05dc\u05e4\u05d9 \u05d4-DSM-5-TR, \u05de\u05d4\u05d5 \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df F \u05d1-General Criteria \u05e9\u05dc \u05d4\u05e4\u05e8\u05e2\u05ea \u05d0\u05d9\u05e9\u05d9\u05d5\u05ea?",
      "answerOptions": [
        {
          "text": "\u05d4\u05d3\u05e4\u05d5\u05e1 \u05d4\u05e2\u05e7\u05d1\u05d9 \u05d0\u05d9\u05e0\u05d5 \u05e0\u05d9\u05ea\u05df \u05dc\u05d9\u05d9\u05d7\u05d5\u05e1 \u05dc\u05d4\u05e9\u05e4\u05e2\u05d5\u05ea \u05e4\u05d9\u05d6\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05d5\u05ea \u05e9\u05dc \u05d7\u05d5\u05de\u05e8 (Substance) \u05d0\u05d5 \u05de\u05e6\u05d1 \u05e8\u05e4\u05d5\u05d0\u05d9 \u05d0\u05d7\u05e8.",
          "isCorrect": true,
          "rationale": "\u05d6\u05d4\u05d5 \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df \u05d4\u05db\u05e8\u05d7\u05d9 \u05dc\u05e9\u05dc\u05d9\u05dc\u05ea \u05d2\u05d5\u05e8\u05de\u05d9\u05dd \u05d0\u05d5\u05e8\u05d2\u05e0\u05d9\u05d9\u05dd \u05d0\u05d5 \u05e1\u05de\u05d9\u05dd \u05db\u05e1\u05d9\u05d1\u05d4 \u05dc\u05e9\u05d9\u05e0\u05d5\u05d9 \u05d4\u05d0\u05d9\u05e9\u05d9\u05d5\u05ea\u05d9 (DSM p.735)."
        },
        {
          "text": "\u05d4\u05d3\u05e4\u05d5\u05e1 \u05d7\u05d9\u05d9\u05d1 \u05dc\u05d4\u05d5\u05d1\u05d9\u05dc \u05dc\u05de\u05e2\u05e6\u05e8 \u05de\u05e9\u05d8\u05e8\u05ea\u05d9 \u05d0\u05d7\u05d3 \u05dc\u05e4\u05d7\u05d5\u05ea.",
          "isCorrect": false,
          "rationale": "\u05d6\u05d4\u05d5 \u05d0\u05d9\u05e0\u05d5 \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df \u05db\u05dc\u05dc\u05d9 (DSM p.735)."
        },
        {
          "text": "\u05d4\u05d3\u05e4\u05d5\u05e1 \u05d0\u05d9\u05e0\u05d5 \u05de\u05d5\u05e1\u05d1\u05e8 \u05d8\u05d5\u05d1 \u05d9\u05d5\u05ea\u05e8 \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d4\u05e4\u05e8\u05e2\u05d4 \u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9\u05ea \u05d0\u05d7\u05e8\u05ea.",
          "isCorrect": false,
          "rationale": "\u05d6\u05d4\u05d5 \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df E, \u05dc\u05d0 F (DSM p.735)."
        },
        {
          "text": "\u05d4\u05d3\u05e4\u05d5\u05e1 \u05d7\u05d9\u05d9\u05d1 \u05dc\u05d2\u05e8\u05d5\u05dd \u05dc\u05e1\u05d1\u05dc \u05dc\u05de\u05e9\u05e4\u05d7\u05d4 \u05e9\u05dc \u05d4\u05de\u05d8\u05d5\u05e4\u05dc.",
          "isCorrect": false,
          "rationale": "\u05e1\u05d1\u05dc \u05dc\u05de\u05e9\u05e4\u05d7\u05d4 \u05e2\u05e9\u05d5\u05d9 \u05dc\u05e7\u05e8\u05d5\u05ea \u05d0\u05da \u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df \u05de\u05d3\u05d1\u05e8 \u05e2\u05dc \u05de\u05e6\u05d5\u05e7\u05d4 \u05d0\u05d5 \u05e4\u05d2\u05d9\u05e2\u05d4 \u05d1\u05ea\u05e4\u05e7\u05d5\u05d3 \u05e9\u05dc \u05d4\u05e4\u05e8\u05d8 (Criterion C) (DSM p.735)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05e9\u05dc\u05d9\u05dc\u05ea \u05d2\u05d5\u05e8\u05de\u05d9\u05dd \u05d7\u05d9\u05e6\u05d5\u05e0\u05d9\u05d9\u05dd \u05db\u05de\u05d5 \u05e1\u05de\u05d9\u05dd \u05d0\u05d5 \u05e4\u05d2\u05d9\u05e2\u05d5\u05ea \u05e8\u05d0\u05e9.",
      "citation": "(DSM p.735)"
    }
