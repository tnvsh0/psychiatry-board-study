{
  "title": "BFRB Flashcards",
  "cards": [
    {
      "front": "\u05de\u05d4\u05d5 \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df A \u05d1\u05d0\u05d1\u05d7\u05e0\u05ea Trichotillomania \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR?",
      "back": "Recurrent pulling out of one's hair, resulting in hair loss (DSM p.281)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05d9\u05d7\u05e1 \u05d1\u05d9\u05df \u05d4\u05de\u05d9\u05e0\u05d9\u05dd (Gender ratio) \u05d1-Trichotillomania \u05d1\u05de\u05d3\u05d2\u05de\u05d9\u05dd \u05e7\u05dc\u05d9\u05e0\u05d9\u05d9\u05dd \u05e9\u05dc \u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd?",
      "back": "$10:1$ \u05dc\u05d8\u05d5\u05d1\u05ea \u05e0\u05e9\u05d9\u05dd (DSM p.283)."
    },
    {
      "front": "\u05dc\u05e4\u05d9 \u05d4-DSM-5-TR, \u05de\u05d4\u05d5 \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df E \u05d4\u05e0\u05d3\u05e8\u05e9 \u05dc\u05d4\u05d1\u05d7\u05d9\u05df \u05d1\u05d9\u05df Excoriation (Skin-Picking) Disorder \u05dc\u05d1\u05d9\u05df \u05db\u05d5\u05d5\u05e0\u05ea \u05e4\u05d2\u05d9\u05e2\u05d4 \u05e2\u05e6\u05de\u05d9\u05ea?",
      "back": "\u05d4\u05e0\u05d9\u05e7\u05d5\u05e8 \u05d0\u05d9\u05e0\u05d5 \u05de\u05d5\u05e1\u05d1\u05e8 \u05d8\u05d5\u05d1 \u05d9\u05d5\u05ea\u05e8 \u05e2\u05dc \u05d9\u05d3\u05d9 \u05db\u05d5\u05d5\u05e0\u05d4 \u05dc\u05d4\u05d6\u05d9\u05e7 \u05dc\u05e2\u05e6\u05de\u05d9 \u05d4\u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05d9\u05ea \u05dc-Nonsuicidal self-injury (DSM p.284)."
    },
    {
      "front": "\u05d0\u05d9\u05dc\u05d5 \u05e9\u05e0\u05d9 \u05de\u05e8\u05db\u05d9\u05d1\u05d9\u05dd \u05de\u05e8\u05db\u05d6\u05d9\u05d9\u05dd \u05db\u05d5\u05dc\u05dc \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea\u05d9 Habit Reversal Training (HRT)?",
      "back": "Awareness training \u05d5\u05e4\u05d9\u05ea\u05d5\u05d7 Competing response (Dulcan p.431)."
    },
    {
      "front": "\u05dc\u05e4\u05d9 \u05d4-**StahlNeuro**, \u05d0\u05d9\u05d6\u05d4 \u05e6\u05d5\u05de\u05ea \u05d1-Striatum (\u05d3\u05d5\u05d1\u05d9) \u05de\u05e2\u05d5\u05e8\u05d1 \u05d1\u05de\u05e2\u05d2\u05dc \u05d4-Compulsivity \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05df Trichotillomania?",
      "back": "\u05d4-Dorsal Striatum (StahlNeuro p.540)."
    },
    {
      "front": "\u05d1\u05de\u05e2\u05d1\u05e8 \u05de-Impulsivity \u05dc-Compulsivity, \u05dc\u05d4\u05d9\u05db\u05df \u05e0\u05d5\u05d3\u05d3\u05ea \u05d4\u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05d4\u05e2\u05e6\u05d1\u05d9\u05ea \u05d1-Striatum \u05dc\u05e4\u05d9 **StahlNeuro**?",
      "back": "\u05de\u05d4-Ventral Striatum \u05dc-Dorsal Striatum (StahlNeuro p.540)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d2\u05d9\u05dc \u05d4\u05d4\u05d5\u05e4\u05e2\u05d4 (Age at onset) \u05d4\u05e9\u05db\u05d9\u05d7 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05e2\u05d1\u05d5\u05e8 Trichotillomania \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR?",
      "back": "\u05e1\u05d1\u05d9\u05d1 \u05d2\u05d9\u05dc \u05d4\u05d4\u05ea\u05d1\u05d2\u05e8\u05d5\u05ea \u05d0\u05d5 \u05de\u05e2\u05d8 \u05d0\u05d7\u05e8\u05d9\u05d5 (DSM p.283)."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05de\u05d1\u05d3\u05d9\u05dc\u05d9\u05dd \u05d1\u05d9\u05df Trichotillomania \u05dc\u05d1\u05d9\u05df \u05d4\u05e1\u05e8\u05ea \u05e9\u05d9\u05e2\u05e8 \u05e0\u05d5\u05e8\u05de\u05d8\u05d9\u05d1\u05d9\u05ea (Normative hair removal)?",
      "back": "\u05d1-Trichotillomania \u05d4\u05e4\u05e2\u05d5\u05dc\u05d4 \u05d0\u05d9\u05e0\u05d4 \u05de\u05ea\u05d1\u05e6\u05e2\u05ea \u05de\u05e1\u05d9\u05d1\u05d5\u05ea \u05e7\u05d5\u05e1\u05de\u05d8\u05d9\u05d5\u05ea \u05dc\u05e9\u05d9\u05e4\u05d5\u05e8 \u05d4\u05de\u05e8\u05d0\u05d4 (DSM p.284)."
    },
    {
      "front": "\u05d0\u05d9\u05d6\u05d4 \u05de\u05de\u05e6\u05d0 \u05d1\u05d1\u05d3\u05d9\u05e7\u05ea Dermoscopy (\u05d0\u05d5 Trichoscopy) \u05de\u05d0\u05e4\u05d9\u05d9\u05df Trichotillomania \u05d5\u05de\u05d1\u05d3\u05d9\u05dc \u05d0\u05d5\u05ea\u05d4 \u05de-Alopecia areata?",
      "back": "\u05e9\u05e2\u05e8\u05d5\u05ea \u05e9\u05d1\u05d5\u05e8\u05d5\u05ea \u05d1\u05d0\u05d5\u05e8\u05db\u05d9\u05dd \u05e9\u05d5\u05e0\u05d9\u05dd (Broken hairs with different shaft lengths) (DSM p.283)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05e9\u05d9\u05e2\u05d5\u05e8 \u05d4\u05e9\u05db\u05d9\u05d7\u05d5\u05ea (Prevalence) \u05e9\u05dc Excoriation Disorder \u05d1\u05d0\u05d5\u05db\u05dc\u05d5\u05e1\u05d9\u05d9\u05d4 \u05d4\u05d1\u05d5\u05d2\u05e8\u05ea \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR?",
      "back": "$2.1\\%$ \u05e2\u05d3 $3.1\\%$ (DSM p.285)."
    },
    {
      "front": "\u05d1\u05d0\u05d9\u05d6\u05d4 \u05d0\u05d6\u05d5\u05e8 \u05d1\u05d2\u05d5\u05e3 \u05de\u05ea\u05e8\u05d7\u05e9 \u05e0\u05d9\u05e7\u05d5\u05e8 \u05d4\u05e2\u05d5\u05e8 (Skin picking) \u05d4\u05e9\u05db\u05d9\u05d7 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d1-Excoriation Disorder?",
      "back": "\u05d4\u05e4\u05e0\u05d9\u05dd, \u05d4\u05d6\u05e8\u05d5\u05e2\u05d5\u05ea \u05d5\u05d4\u05d9\u05d3\u05d9\u05d9\u05dd (DSM p.285)."
    },
    {
      "front": "\u05d0\u05d9\u05d6\u05d4 \u05de\u05e6\u05d1 \u05e8\u05e4\u05d5\u05d0\u05d9 (Medical mimic) \u05e9\u05dc \u05d4\u05e2\u05d5\u05e8 \u05d9\u05e9 \u05dc\u05e9\u05dc\u05d5\u05dc \u05dc\u05e4\u05e0\u05d9 \u05d0\u05d1\u05d7\u05e0\u05ea Excoriation Disorder?",
      "back": "Scabies (DSM p.287)."
    },
    {
      "front": "\u05d0\u05d9\u05d6\u05d4 \u05d0\u05d6\u05d5\u05e8 \u05d1-Prefrontal cortex (PFC) \u05d0\u05d7\u05e8\u05d0\u05d9 \u05e2\u05dc \u05e2\u05d9\u05db\u05d5\u05d1 'Top-down' \u05e9\u05dc \u05de\u05e2\u05d2\u05dc \u05d4-Compulsivity \u05dc\u05e4\u05d9 **StahlNeuro**?",
      "back": "\u05d4-Orbitofrontal cortex (OFC) (StahlNeuro p.540)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df \u05d4\u05d3\u05d9\u05d0\u05d2\u05e0\u05d5\u05e1\u05d8\u05d9 \u05d4\u05de\u05d1\u05d3\u05d9\u05dc \u05d1\u05d9\u05df Excoriation \u05dc\u05d1\u05d9\u05df Psychotic disorder?",
      "back": "\u05d1-Excoriation \u05d4\u05e0\u05d9\u05e7\u05d5\u05e8 \u05d0\u05d9\u05e0\u05d5 \u05e0\u05d5\u05d1\u05e2 \u05de\u05ea\u05d2\u05d5\u05d1\u05d4 \u05dc-Delusion (\u05db\u05d2\u05d5\u05df Parasitosis) \u05d0\u05d5 Tactile hallucination (DSM p.286)."
    },
    {
      "front": "\u05d0\u05d9\u05d6\u05d5 \u05ea\u05e8\u05d5\u05e4\u05d4 (Amino acid derivative) \u05d4\u05e8\u05d0\u05ea\u05d4 \u05e2\u05d3\u05d5\u05ea \u05de\u05d7\u05e7\u05e8\u05d9\u05ea \u05d4\u05d5\u05dc\u05db\u05ea \u05d5\u05d2\u05d3\u05dc\u05d4 \u05dc\u05e9\u05d9\u05e4\u05d5\u05e8 \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d1-Trichotillomania \u05d5-Excoriation?",
      "back": "N-acetylcysteine (\u05de\u05e7\u05d5\u05e8: \u05d4\u05e7\u05e9\u05e8 \u05e8\u05d7\u05d1/\u05de\u05d9\u05e7\u05d5\u05d3 \u05de\u05e9\u05ea\u05de\u05e9)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05de\u05d1\u05d3\u05dc\u05ea \u05d1\u05de\u05e7\u05e8\u05d4 \u05e9\u05d1\u05d5 \u05d9\u05dc\u05d3 \u05e2\u05dd Autism Spectrum Disorder \u05ea\u05d5\u05dc\u05e9 \u05e9\u05d9\u05e2\u05e8 \u05db\u05d7\u05dc\u05e7 \u05de\u05d3\u05e4\u05d5\u05e1 \u05ea\u05e0\u05d5\u05e2\u05d5\u05ea \u05d7\u05d6\u05e8\u05ea\u05d9\u05d5\u05ea?",
      "back": "Stereotypic movement disorder (DSM p.284)."
    },
    {
      "front": "\u05dc\u05e4\u05d9 \u05d4-DSM-5-TR, \u05de\u05d4\u05d5 \u05d4\u05d9\u05d7\u05e1 \u05d4\u05de\u05e9\u05e4\u05d7\u05ea\u05d9 \u05d4\u05de\u05e6\u05d1\u05d9\u05e2 \u05e2\u05dc \u05e4\u05d2\u05d9\u05e2\u05d5\u05ea \u05d2\u05e0\u05d8\u05d9\u05ea \u05dc-Trichotillomania?",
      "back": "\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d2\u05d1\u05d5\u05d4\u05d4 \u05d9\u05d5\u05ea\u05e8 \u05d1\u05e7\u05e8\u05d1 \u05e7\u05e8\u05d5\u05d1\u05d9 \u05de\u05e9\u05e4\u05d7\u05d4 \u05de\u05d3\u05e8\u05d2\u05d4 \u05e8\u05d0\u05e9\u05d5\u05e0\u05d4 \u05e9\u05dc \u05d7\u05d5\u05dc\u05d9 OCD (DSM p.283)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05d4\u05d2\u05d3\u05e8\u05d4 \u05e9\u05dc 'Other body-focused repetitive behavior disorder' \u05ea\u05d7\u05ea \u05d4\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4 \u05e9\u05dc Other Specified OCRD?",
      "back": "\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05d9\u05d5\u05ea \u05d7\u05d6\u05e8\u05ea\u05d9\u05d5\u05ea \u05db\u05de\u05d5 \u05db\u05e1\u05d9\u05e1\u05ea \u05e6\u05d9\u05e4\u05d5\u05e8\u05e0\u05d9\u05d9\u05dd \u05d0\u05d5 \u05e0\u05e9\u05d9\u05db\u05ea \u05dc\u05d7\u05d9\u05d9\u05dd \u05e2\u05dd \u05e0\u05d9\u05e1\u05d9\u05d5\u05e0\u05d5\u05ea \u05d7\u05d5\u05d6\u05e8\u05d9\u05dd \u05dc\u05d4\u05e4\u05e1\u05d9\u05e7 \u05d5\u05de\u05e6\u05d5\u05e7\u05d4 \u05e7\u05dc\u05d9\u05e0\u05d9\u05ea (DSM p.293)."
    }
  ]
}