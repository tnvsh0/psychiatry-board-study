{
  "title": "BFRB Quiz",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\u05e0\u05e2\u05e8 \u05d1\u05df 8 \u05d4\u05de\u05d0\u05d5\u05d1\u05d7\u05df \u05e2\u05dd Autism Spectrum Disorder \u05d5-Intellectual Developmental Disorder, \u05e0\u05d5\u05d4\u05d2 \u05dc\u05ea\u05dc\u05d5\u05e9 \u05e9\u05d9\u05e2\u05e8 \u05de\u05d4\u05e7\u05e8\u05e7\u05e4\u05ea \u05d1\u05ea\u05d2\u05d5\u05d1\u05d4 \u05dc\u05de\u05e6\u05d1\u05d9 \u05ea\u05e1\u05db\u05d5\u05dc (frustration), \u05d5\u05d1\u05de\u05e7\u05d1\u05d9\u05dc \u05de\u05d1\u05e6\u05e2 \u05d4\u05d8\u05d9\u05d9\u05ea \u05e8\u05d0\u05e9 \u05e7\u05e6\u05d1\u05d9\u05ea (head nodding) \u05d5\u05e0\u05d3\u05e0\u05d5\u05d3 \u05d2\u05d5\u05e3. \u05de\u05d4\u05d9 \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05de\u05d3\u05d5\u05d9\u05e7\u05ea \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05de\u05e0\u05d4\u05d2 \u05ea\u05dc\u05d9\u05e9\u05ea \u05d4\u05e9\u05d9\u05e2\u05e8 \u05d1\u05de\u05e7\u05e8\u05d4 \u05d6\u05d4?",
      "answerOptions": [
        {
          "text": "Stereotypic Movement Disorder",
          "isCorrect": true,
          "rationale": "\u05d1\u05de\u05e7\u05e8\u05d9\u05dd \u05e9\u05dc \u05de\u05d5\u05d2\u05d1\u05dc\u05d5\u05ea \u05e9\u05db\u05dc\u05d9\u05ea \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9\u05ea \u05d0\u05d5 \u05d0\u05d5\u05d8\u05d9\u05d6\u05dd, \u05ea\u05dc\u05d9\u05e9\u05ea \u05e9\u05d9\u05e2\u05e8 \u05d4\u05de\u05ea\u05e8\u05d7\u05e9\u05ea \u05db\u05d7\u05dc\u05e7 \u05de\u05ea\u05d1\u05e0\u05d9\u05ea \u05e9\u05dc stereotypies \u05e4\u05d5\u05e0\u05e7\u05e6\u05d9\u05d5\u05e0\u05dc\u05d9\u05d5\u05ea \u05d0\u05d5 Purposeless, \u05de\u05d0\u05d5\u05d1\u05d7\u05e0\u05ea \u05db-Stereotypic Movement Disorder \u05d5\u05dc\u05d0 \u05db-Trichotillomania (DSM-5-TR p. 284)."
        },
        {
          "text": "Trichotillomania",
          "isCorrect": false,
          "rationale": "\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d6\u05d5 \u05e0\u05e9\u05dc\u05dc\u05ea \u05db\u05d0\u05e9\u05e8 \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d4\u05ea\u05dc\u05d9\u05e9\u05d4 \u05de\u05d5\u05e1\u05d1\u05e8\u05ea \u05d8\u05d5\u05d1 \u05d9\u05d5\u05ea\u05e8 \u05e2\u05dc \u05d9\u05d3\u05d9 stereotypies \u05db\u05d7\u05dc\u05e7 \u05de\u05d4\u05e4\u05e8\u05e2\u05d4 \u05e0\u05d5\u05d9\u05e8\u05d5-\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9\u05ea \u05d0\u05d7\u05e8\u05ea (DSM-5-TR p. 284)."
        },
        {
          "text": "Obsessive-Compulsive Disorder (OCD)",
          "isCorrect": false,
          "rationale": "\u05d1-OCD \u05ea\u05dc\u05d9\u05e9\u05ea \u05d4\u05e9\u05d9\u05e2\u05e8 \u05de\u05d5\u05e0\u05e2\u05ea \u05dc\u05e8\u05d5\u05d1 \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d0\u05d5\u05d1\u05e1\u05e1\u05d9\u05d5\u05ea \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05d5\u05ea \u05d0\u05d5 \u05e6\u05d5\u05e8\u05da \u05d1\u05e1\u05d9\u05de\u05d8\u05e8\u05d9\u05d4, \u05de\u05d4 \u05e9\u05d0\u05d9\u05e0\u05d5 \u05de\u05ea\u05d5\u05d0\u05e8 \u05d1\u05de\u05e7\u05e8\u05d4 \u05e9\u05dc \u05ea\u05e0\u05d5\u05e2\u05d5\u05ea \u05e1\u05d8\u05e8\u05d9\u05d0\u05d5\u05d8\u05d9\u05e4\u05d9\u05d5\u05ea \u05e7\u05e6\u05d1\u05d9\u05d5\u05ea (DSM-5-TR p. 284)."
        },
        {
          "text": "Excoriation Disorder",
          "isCorrect": false,
          "rationale": "\u05d4\u05e4\u05e8\u05e2\u05d4 \u05d6\u05d5 \u05de\u05ea\u05d9\u05d9\u05d7\u05e1\u05ea \u05dc\u05d7\u05d9\u05d8\u05d5\u05d8 \u05d1\u05e2\u05d5\u05e8 (skin-picking) \u05d5\u05dc\u05d0 \u05dc\u05ea\u05dc\u05d9\u05e9\u05ea \u05e9\u05d9\u05e2\u05e8, \u05d5\u05d4\u05d9\u05d0 \u05d0\u05d9\u05e0\u05d4 \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05de\u05ea\u05d0\u05d9\u05de\u05d4 \u05dc\u05de\u05e7\u05e8\u05d4 \u05e9\u05dc stereotypies \u05d1\u05d9\u05dc\u05d3 \u05e2\u05dd \u05d0\u05d5\u05d8\u05d9\u05d6\u05dd (DSM-5-TR p. 285)."
        }
      ],
      "hint": "\u05e9\u05d9\u05de\u05d5 \u05dc\u05d1 \u05dc\u05d4\u05e7\u05e9\u05e8 \u05d4\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9 \u05d5\u05dc\u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05e9\u05dc \u05ea\u05e0\u05d5\u05e2\u05d5\u05ea \u05e7\u05e6\u05d1\u05d9\u05d5\u05ea \u05e0\u05d5\u05e1\u05e4\u05d5\u05ea.",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05de\u05d8\u05d5\u05e4\u05dc\u05ea \u05d1\u05ea 16 \u05e2\u05dd Excoriation Disorder \u05de\u05d3\u05d5\u05d5\u05d7\u05ea \u05db\u05d9 \u05d1\u05ea\u05d7\u05d9\u05dc\u05ea \u05d4\u05d3\u05e8\u05da \u05d4\u05d7\u05d9\u05d8\u05d5\u05d8 \u05d1\u05e2\u05d5\u05e8 \u05dc\u05d5\u05d5\u05d4 \u05d1\u05ea\u05d7\u05d5\u05e9\u05ea tension \u05dc\u05e4\u05e0\u05d9 \u05d4\u05e4\u05e2\u05d5\u05dc\u05d4 \u05d5-relief \u05dc\u05d0\u05d7\u05e8\u05d9\u05d4. \u05db\u05d9\u05d5\u05dd, \u05d4\u05d9\u05d0 \u05de\u05d5\u05e6\u05d0\u05ea \u05d0\u05ea \u05e2\u05e6\u05de\u05d4 \u05de\u05d7\u05d8\u05d8\u05ea \u05d1\u05e2\u05d5\u05e8 \u05d1\u05d6\u05de\u05df \u05e6\u05e4\u05d9\u05d9\u05d4 \u05d1\u05d8\u05dc\u05d5\u05d5\u05d9\u05d6\u05d9\u05d4 \u05dc\u05dc\u05d0 \u05de\u05d5\u05d3\u05e2\u05d5\u05ea \u05de\u05dc\u05d0\u05d4 (automatic behavior). \u05e2\u05dc \u05e4\u05d9 StahlNeuro, \u05d0\u05d9\u05d6\u05d4 \u05de\u05e2\u05d1\u05e8 \u05e0\u05d5\u05d9\u05e8\u05d5\u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05de\u05e1\u05d1\u05d9\u05e8 \u05d0\u05ea \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea \u05d4-compulsivity \u05d1\u05de\u05e7\u05e8\u05d4 \u05d6\u05d4?",
      "answerOptions": [
        {
          "text": "\u05de\u05e2\u05d1\u05e8 \u05e9\u05dc \u05d4-locus of control \u05de\u05d4-Ventral Striatum \u05d0\u05dc \u05d4-Dorsal Striatum.",
          "isCorrect": true,
          "rationale": "\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05d9\u05d5\u05ea \u05e9\u05de\u05ea\u05d7\u05d9\u05dc\u05d5\u05ea \u05db\u05d3\u05d7\u05e4\u05d9\u05dd (impulses) \u05d4\u05de\u05ea\u05d5\u05d5\u05db\u05d9\u05dd \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d4-ventral loop \u05e0\u05d5\u05d3\u05d3\u05d5\u05ea \u05e2\u05dd \u05d4\u05d6\u05de\u05df \u05dc-dorsal 'habit' system \u05d5\u05d4\u05d5\u05e4\u05db\u05d5\u05ea \u05dc-compulsive (StahlNeuro p. 540)."
        },
        {
          "text": "\u05d9\u05e8\u05d9\u05d3\u05d4 \u05d1\u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05d4-VMPFC \u05e2\u05dd \u05e2\u05dc\u05d9\u05d9\u05d4 \u05d1\u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05d4-Amygdala.",
          "isCorrect": false,
          "rationale": "\u05de\u05e2\u05d2\u05dc \u05d6\u05d4 \u05e7\u05e9\u05d5\u05e8 \u05d9\u05d5\u05ea\u05e8 \u05dc\u05d5\u05d5\u05d9\u05e1\u05d5\u05ea \u05e8\u05d2\u05e9\u05d9 \u05d5\u05d7\u05e8\u05d3\u05d4, \u05d1\u05e2\u05d5\u05d3 \u05d4\u05de\u05e2\u05d1\u05e8 \u05de\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d3\u05d7\u05e4\u05d9\u05ea \u05dc\u05d4\u05e8\u05d2\u05dc\u05d9\u05ea (habit) \u05de\u05e2\u05e8\u05d1 \u05d0\u05ea \u05d4\u05e1\u05d8\u05e8\u05d9\u05d0\u05d8\u05d5\u05dd (StahlNeuro p. 540)."
        },
        {
          "text": "\u05e2\u05dc\u05d9\u05d9\u05d4 \u05d1\u05e8\u05de\u05d5\u05ea \u05d4-\u05d3\u05d5\u05d1\u05d9 (Dopamine) \u05d1-Nucleus Accumbens \u05d1\u05dc\u05d1\u05d3.",
          "isCorrect": false,
          "rationale": "\u05e2\u05dc\u05d9\u05d9\u05d4 \u05d1-Dopamine \u05d1-ventral striatum (Accumbens) \u05e7\u05e9\u05d5\u05e8\u05d4 \u05dc\u05e9\u05dc\u05d1 \u05d4-impulsivity \u05d5\u05d4-reward, \u05d0\u05da \u05d4-compulsivity \u05de\u05e2\u05e8\u05d1\u05ea \u05d0\u05d6\u05d5\u05e8\u05d9\u05dd \u05d3\u05d5\u05e8\u05e1\u05dc\u05d9\u05d9\u05dd \u05d9\u05d5\u05ea\u05e8 (StahlNeuro p. 540)."
        },
        {
          "text": "\u05e9\u05d9\u05e0\u05d5\u05d9 \u05d1-Top-down inhibition \u05de\u05d4-ACC \u05d0\u05dc \u05d4-Thalamus.",
          "isCorrect": false,
          "rationale": "\u05d4-ACC \u05d5\u05d4-VMPFC \u05e7\u05e9\u05d5\u05e8\u05d9\u05dd \u05dc\u05de\u05e2\u05d2\u05dc\u05d9 impulsivity, \u05d1\u05e2\u05d5\u05d3 \u05d4\u05de\u05e2\u05d2\u05dc\u05d9\u05dd \u05d4-compulsive \u05de\u05e2\u05e8\u05d1\u05d9\u05dd \u05d0\u05ea \u05d4-OFC \u05d5\u05d4-Dorsal Striatum (StahlNeuro p. 540)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d1\u05d5 \u05e2\u05dc \u05d4\u05e0\u05d3\u05dc\"\u05df \u05d4\u05de\u05d5\u05d7\u05d9 \u05d4\u05e7\u05e9\u05d5\u05e8 \u05dc\u05d4\u05d9\u05d5\u05d5\u05e6\u05e8\u05d5\u05ea \u05d4\u05e8\u05d2\u05dc\u05d9\u05dd (habits) \u05d5\u05d4\u05de\u05e2\u05d1\u05e8 \u05de-reward \u05dc-habit.",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05de\u05d4\u05d5 \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05e4\u05e1\u05d9\u05db\u05d5\u05ea\u05e8\u05e4\u05d5\u05d9\u05d8\u05d9 \u05d4\u05de\u05d5\u05de\u05dc\u05e5 \u05db-First-line \u05e2\u05d1\u05d5\u05e8 \u05de\u05ea\u05d1\u05d2\u05e8 \u05d4\u05e1\u05d5\u05d1\u05dc \u05de-Trichotillomania, \u05d5\u05de\u05d4\u05d5 \u05d4\u05de\u05e8\u05db\u05d9\u05d1 \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05d1\u05d5?",
      "answerOptions": [
        {
          "text": "CBT \u05d4\u05db\u05d5\u05dc\u05dc Habit Reversal Training (HRT).",
          "isCorrect": true,
          "rationale": "HRT \u05d4\u05d5\u05d0 \u05de\u05e8\u05db\u05d9\u05d1 \u05d4\u05dc\u05d9\u05d1\u05d4 \u05d1\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05de\u05e1\u05d5\u05d2 BFRB, \u05d4\u05db\u05d5\u05dc\u05dc awareness training \u05d5\u05dc\u05d9\u05de\u05d5\u05d3 \u05e9\u05dc competing response (Dulcan p. 431)."
        },
        {
          "text": "Exposure and Response Prevention (ERP) \u05d0\u05d9\u05e0\u05d8\u05e0\u05e1\u05d9\u05d1\u05d9.",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05e9-ERP \u05d9\u05e2\u05d9\u05dc \u05d1-OCD, \u05d1-Trichotillomania \u05d4\u05d3\u05d2\u05e9 \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05d4\u05d5\u05d0 \u05e2\u05dc \u05e9\u05d9\u05e0\u05d5\u05d9 \u05d4\u05e8\u05d2\u05dc\u05d9\u05dd \u05d1\u05d0\u05de\u05e6\u05e2\u05d5\u05ea HRT (Dulcan p. 431)."
        },
        {
          "text": "\u05d8\u05d9\u05e4\u05d5\u05dc \u05d3\u05d9\u05e0\u05de\u05d9 \u05de\u05de\u05d5\u05e7\u05d3 \u05d1\u05d5\u05d5\u05d9\u05e1\u05d5\u05ea \u05e8\u05d2\u05e9\u05d5\u05ea.",
          "isCorrect": false,
          "rationale": "\u05d8\u05d9\u05e4\u05d5\u05dc\u05d9\u05dd \u05d0\u05dc\u05d5 \u05d0\u05d9\u05e0\u05dd \u05e0\u05d7\u05e9\u05d1\u05d9\u05dd \u05dc\u05e7\u05d5 \u05e8\u05d0\u05e9\u05d5\u05df \u05e2\u05d1\u05d5\u05e8 BFRB \u05d1\u05d4\u05e9\u05d5\u05d5\u05d0\u05d4 \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc\u05d9\u05dd \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea\u05d9\u05d9\u05dd \u05de\u05d5\u05d1\u05e0\u05d9\u05dd (Dulcan p. 431)."
        },
        {
          "text": "CBT \u05de\u05d1\u05d5\u05e1\u05e1 \u05e4\u05e8\u05d5\u05d8\u05d5\u05e7\u05d5\u05dc POTS.",
          "isCorrect": false,
          "rationale": "\u05e4\u05e8\u05d5\u05d8\u05d5\u05e7\u05d5\u05dc POTS \u05de\u05d9\u05d5\u05e2\u05d3 \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05ea \u05dc-OCD \u05d5\u05db\u05d5\u05dc\u05dc \u05d0\u05dc\u05de\u05e0\u05d8\u05d9\u05dd \u05e9\u05dc \u05de\u05d9\u05e4\u05d5\u05d9 \u05d8\u05e7\u05e1\u05d9\u05dd \u05d5-ERP \u05e9\u05d0\u05d9\u05e0\u05dd \u05d6\u05d4\u05d9\u05dd \u05dc-HRT (Dulcan p. 381)."
        }
      ],
      "hint": "\u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05de\u05ea\u05de\u05e7\u05d3 \u05d1\u05d6\u05d9\u05d4\u05d5\u05d9 \u05d4\u05d2\u05d9\u05e8\u05d5\u05d9\u05d9\u05dd \u05d4\u05de\u05e7\u05d3\u05d9\u05de\u05d9\u05dd \u05d5\u05d9\u05e6\u05d9\u05e8\u05ea \u05ea\u05d2\u05d5\u05d1\u05d4 \u05de\u05ea\u05d7\u05e8\u05d4.",
      "imageUrls": []
