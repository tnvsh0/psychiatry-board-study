          "text": "\u05d4\u05d5\u05e4\u05e2\u05d4 \u05e9\u05dc \u05d7\u05e8\u05d3\u05d4 \u05d5\u05d0\u05d9-\u05e9\u05e7\u05d8 \u05e4\u05e1\u05d9\u05db\u05d5\u05de\u05d5\u05d8\u05d5\u05e8\u05d9.",
          "isCorrect": false,
          "rationale": "\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d0\u05dc\u05d5 \u05de\u05e9\u05d5\u05ea\u05e4\u05d9\u05dd \u05dc\u05e9\u05ea\u05d9 \u05ea\u05e1\u05de\u05d5\u05e0\u05d5\u05ea \u05d4\u05d2\u05de\u05d9\u05dc\u05d4 \u05d5\u05d0\u05d9\u05e0\u05dd \u05de\u05d0\u05e4\u05e9\u05e8\u05d9\u05dd \u05d0\u05d1\u05d7\u05e0\u05d4 \u05de\u05d1\u05d3\u05dc\u05ea (DSM p.629)."
        },
        {
          "text": "\u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05e9\u05dc \u05d8\u05db\u05d9\u05e7\u05e8\u05d3\u05d9\u05d4 \u05d5\u05d4\u05d9\u05e4\u05e8\u05d0\u05e7\u05d8\u05d9\u05d1\u05d9\u05d5\u05ea \u05d0\u05d5\u05d8\u05d5\u05e0\u05d5\u05de\u05d9\u05ea.",
          "isCorrect": false,
          "rationale": "\u05e2\u05d5\u05e8\u05e8\u05d5\u05ea \u05d0\u05d5\u05d8\u05d5\u05e0\u05d5\u05de\u05d9\u05ea \u05d4\u05d9\u05d0 \u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05de\u05e8\u05db\u05d6\u05d9 \u05d1\u05e9\u05ea\u05d9 \u05d4\u05ea\u05e1\u05de\u05d5\u05e0\u05d5\u05ea \u05d5\u05e0\u05d5\u05d1\u05e2\u05ea \u05de\u05d4\u05d9\u05e2\u05d3\u05e8 \u05d4\u05d3\u05d9\u05db\u05d5\u05d9 \u05e9\u05dc \u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05e2\u05e6\u05d1\u05d9\u05dd (DSM p.617, p.629)."
        },
        {
          "text": "\u05ea\u05dc\u05d5\u05e0\u05d5\u05ea \u05e2\u05dc \u05d1\u05d7\u05d9\u05dc\u05d5\u05ea \u05d5\u05d4\u05e7\u05d0\u05d5\u05ea.",
          "isCorrect": false,
          "rationale": "\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d2\u05e1\u05d8\u05e8\u05d5\u05d0\u05d9\u05e0\u05d8\u05e1\u05d8\u05d9\u05e0\u05dc\u05d9\u05d9\u05dd \u05e0\u05e4\u05d5\u05e6\u05d9\u05dd \u05de\u05d0\u05d5\u05d3 \u05d1\u05e9\u05e0\u05d9 \u05e1\u05d5\u05d2\u05d9 \u05d4\u05d2\u05de\u05d9\u05dc\u05d4 \u05d5\u05d0\u05d9\u05e0\u05dd \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05d9\u05dd \u05dc\u05d0\u05d5\u05e4\u05d9\u05d0\u05d5\u05d0\u05d9\u05d3\u05d9\u05dd (DSM p.629)."
        }
      ],
      "hint": "\u05d7\u05e4\u05e9 \u05d0\u05ea \u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d4\u05d2\u05d5\u05e4\u05e0\u05d9\u05d9\u05dd \u05d4'\u05e8\u05d8\u05d5\u05d1\u05d9\u05dd' \u05e9\u05d0\u05d9\u05e0\u05dd \u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05d9\u05d9\u05dd \u05dc\u05de\u05e2\u05e8\u05db\u05ea \u05d4-GABA.",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05de\u05d8\u05d5\u05e4\u05dc \u05e2\u05dd OUD \u05d7\u05de\u05d5\u05e8 \u05de\u05d1\u05e7\u05e9 \u05dc\u05e2\u05d1\u05d5\u05e8 \u05ea\u05d4\u05dc\u05d9\u05da \u05e9\u05dc \u05e0\u05d9\u05e7\u05d5\u05d9 \u05d2\u05d5\u05e4\u05e0\u05d9 (Detoxification) \u05d1\u05dc\u05d1\u05d3 \u05dc\u05dc\u05d0 \u05d4\u05de\u05e9\u05da \u05d8\u05d9\u05e4\u05d5\u05dc \u05ea\u05e8\u05d5\u05e4\u05ea\u05d9 \u05d0\u05d7\u05d6\u05e7\u05ea\u05d9 (MAT). \u05de\u05d4\u05d9 \u05d4\u05d0\u05d6\u05d4\u05e8\u05d4 \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05d4\u05d7\u05e9\u05d5\u05d1\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05e9\u05d9\u05e9 \u05dc\u05d4\u05e1\u05d1\u05d9\u05e8 \u05dc\u05de\u05d8\u05d5\u05e4\u05dc \u05d1\u05d4\u05e7\u05e9\u05e8 \u05d6\u05d4?",
      "answerOptions": [
        {
          "text": "\u05d4\u05e4\u05e1\u05e7\u05ea \u05d4\u05e9\u05d9\u05de\u05d5\u05e9 \u05d2\u05d5\u05e8\u05de\u05ea \u05dc\u05d0\u05d5\u05d1\u05d3\u05df \u05d4-Tolerance, \u05de\u05d4 \u05e9\u05de\u05e2\u05dc\u05d4 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05d0\u05ea \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05dc-Fatal Overdose \u05d1\u05de\u05e7\u05e8\u05d4 \u05e9\u05dc Relapse.",
          "isCorrect": true,
          "rationale": "\u05dc\u05d0\u05d7\u05e8 \u05e0\u05d9\u05e7\u05d5\u05d9 \u05d2\u05d5\u05e4\u05e0\u05d9, \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05de\u05d0\u05d1\u05d3 \u05d0\u05ea \u05d4\u05e1\u05d1\u05d9\u05dc\u05d5\u05ea \u05d4\u05e4\u05e8\u05de\u05e7\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea; \u05d7\u05d6\u05e8\u05d4 \u05dc\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05de\u05e0\u05d4 \u05e9\u05d4\u05d9\u05d4 \u05e8\u05d2\u05d9\u05dc \u05d0\u05dc\u05d9\u05d4 \u05d1\u05e2\u05d1\u05e8 \u05e2\u05dc\u05d5\u05dc\u05d4 \u05dc\u05d2\u05e8\u05d5\u05dd \u05dc\u05d3\u05d9\u05db\u05d5\u05d9 \u05e0\u05e9\u05d9\u05de\u05ea\u05d9 \u05e7\u05d8\u05dc\u05e0\u05d9 (StahlNeuro p.560)."
        },
        {
          "text": "\u05ea\u05e1\u05de\u05d5\u05e0\u05ea \u05d4\u05d2\u05de\u05d9\u05dc\u05d4 \u05e2\u05e6\u05de\u05d4 \u05d4\u05d9\u05d0 \u05de\u05e1\u05db\u05e0\u05ea \u05d7\u05d9\u05d9\u05dd \u05d1\u05e9\u05dc \u05e4\u05e8\u05db\u05d5\u05e1\u05d9\u05dd \u05d0\u05e4\u05e9\u05e8\u05d9\u05d9\u05dd.",
          "isCorrect": false,
          "rationale": "\u05d2\u05de\u05d9\u05dc\u05d4 \u05de\u05d0\u05d5\u05e4\u05d9\u05d0\u05d5\u05d0\u05d9\u05d3\u05d9\u05dd \u05d4\u05d9\u05d0 \u05d0\u05de\u05e0\u05dd \u05e1\u05d1\u05dc \u05e8\u05d1, \u05d0\u05da \u05d1\u05e0\u05d9\u05d2\u05d5\u05d3 \u05dc\u05d0\u05dc\u05db\u05d5\u05d4\u05d5\u05dc \u05d0\u05d5 \u05d1\u05e0\u05d6\u05d5\u05d3\u05d9\u05d0\u05d6\u05e4\u05d9\u05e0\u05d9\u05dd, \u05d4\u05d9\u05d0 \u05d0\u05d9\u05e0\u05d4 \u05de\u05e1\u05db\u05e0\u05ea \u05d7\u05d9\u05d9\u05dd \u05d1\u05d0\u05d5\u05e4\u05df \u05d9\u05e9\u05d9\u05e8 (DSM p.618)."
        },
        {
          "text": "\u05dc\u05dc\u05d0 MAT, \u05ea\u05e1\u05de\u05d5\u05e0\u05ea \u05d4\u05d2\u05de\u05d9\u05dc\u05d4 \u05ea\u05d9\u05de\u05e9\u05da \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05e8\u05d1\u05d9\u05dd \u05dc\u05dc\u05d0 \u05d4\u05e4\u05e1\u05e7\u05d4.",
          "isCorrect": false,
          "rationale": "\u05d4\u05e9\u05dc\u05d1 \u05d4\u05d0\u05e7\u05d5\u05d8\u05d9 \u05e9\u05dc \u05d4\u05d2\u05de\u05d9\u05dc\u05d4 \u05d7\u05d5\u05dc\u05e3 \u05d1\u05ea\u05d5\u05da \u05db\u05e9\u05d1\u05d5\u05e2 \u05e2\u05d3 \u05e9\u05d1\u05d5\u05e2\u05d9\u05d9\u05dd, \u05d2\u05dd \u05dc\u05dc\u05d0 \u05d8\u05d9\u05e4\u05d5\u05dc \u05ea\u05e8\u05d5\u05e4\u05ea\u05d9 (DSM p.618)."
        },
        {
          "text": "\u05e0\u05d9\u05e7\u05d5\u05d9 \u05d2\u05d5\u05e4\u05e0\u05d9 \u05dc\u05dc\u05d0 MAT \u05d2\u05d5\u05e8\u05dd \u05dc\u05e0\u05d6\u05e7 \u05d1\u05dc\u05ea\u05d9 \u05d4\u05e4\u05d9\u05da \u05dc\u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 \u05d4-$\\mu$.",
          "isCorrect": false,
          "rationale": "\u05d0\u05d9\u05df \u05e2\u05d3\u05d5\u05ea \u05dc\u05e0\u05d6\u05e7 \u05de\u05d1\u05e0\u05d9 \u05dc\u05e7\u05d5\u05dc\u05d8\u05e0\u05d9\u05dd \u05e2\u05e7\u05d1 \u05d2\u05de\u05d9\u05dc\u05d4, \u05d4\u05d1\u05e2\u05d9\u05d4 \u05d4\u05d9\u05d0 \u05d1\u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd \u05d1\u05de\u05e2\u05d2\u05dc\u05d9 \u05d4\u05d4\u05e8\u05d2\u05dc \u05d5\u05d4\u05ea\u05d2\u05de\u05d5\u05dc (StahlNeuro p.560)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05de\u05d4 \u05e7\u05d5\u05e8\u05d4 \u05dc\u05d9\u05db\u05d5\u05dc\u05ea \u05d4\u05d2\u05d5\u05e3 \u05dc\u05d4\u05ea\u05de\u05d5\u05d3\u05d3 \u05e2\u05dd \u05de\u05e0\u05d5\u05ea \u05d2\u05d1\u05d5\u05d4\u05d5\u05ea \u05dc\u05d0\u05d7\u05e8 \u05ea\u05e7\u05d5\u05e4\u05ea \u05d4\u05ea\u05e0\u05d6\u05e8\u05d5\u05ea \u05e7\u05e6\u05e8\u05d4.",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05e9\u05e8\u05d0\u05ea \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Buprenorphine \u05dc\u05de\u05d8\u05d5\u05e4\u05dc \u05e2\u05dd OUD, \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05de\u05e7\u05d1\u05dc \u05d0\u05ea \u05d4\u05de\u05e0\u05d4 \u05d4\u05e8\u05d0\u05e9\u05d5\u05e0\u05d4 \u05db\u05d0\u05e9\u05e8 \u05de\u05d3\u05d3 \u05d4-COWS \u05e9\u05dc\u05d5 \u05d4\u05d5\u05d0 4. \u05d6\u05de\u05df \u05e7\u05e6\u05e8 \u05dc\u05d0\u05d7\u05e8 \u05de\u05db\u05df, \u05d4\u05d5\u05d0 \u05d7\u05d5\u05d5\u05d4 \u05d4\u05d7\u05de\u05e8\u05d4 \u05e1\u05d5\u05e2\u05e8\u05ea \u05d1\u05ea\u05e1\u05de\u05d9\u05e0\u05d9 \u05d4\u05d2\u05de\u05d9\u05dc\u05d4. \u05de\u05d4\u05d5 \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05e0\u05d5\u05d9\u05e8\u05d5\u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05dc\u05d4\u05d7\u05de\u05e8\u05d4 \u05d6\u05d5?",
      "answerOptions": [
        {
          "text": "Buprenorphine \u05d4\u05d5\u05d0 Partial Agonist \u05e2\u05dd \u05d6\u05d9\u05e7\u05d4 (Affinity) \u05d2\u05d1\u05d5\u05d4\u05d4 \u05e9\u05d3\u05d5\u05d7\u05e7 \u05d0\u05d2\u05d5\u05e0\u05d9\u05e1\u05d8\u05d9\u05dd \u05de\u05dc\u05d0\u05d9\u05dd \u05de\u05d4\u05e7\u05d5\u05dc\u05d8\u05df.",
          "isCorrect": true,
          "rationale": "\u05db\u05d0\u05e9\u05e8 \u05e0\u05d9\u05ea\u05df Buprenorphine \u05de\u05d5\u05e7\u05d3\u05dd \u05de\u05d3\u05d9 (\u05dc\u05e4\u05e0\u05d9 \u05e9\u05d4\u05d0\u05d2\u05d5\u05e0\u05d9\u05e1\u05d8 \u05d4\u05de\u05dc\u05d0 \u05e2\u05d6\u05d1 \u05d0\u05ea \u05d4\u05e7\u05d5\u05dc\u05d8\u05e0\u05d9\u05dd), \u05d4\u05d5\u05d0 \u05de\u05d7\u05dc\u05d9\u05e3 \u05d0\u05d5\u05ea\u05d5 \u05d5\u05de\u05e4\u05d7\u05d9\u05ea \u05d0\u05ea \u05e8\u05de\u05ea \u05d4\u05d4\u05e4\u05e2\u05dc\u05d4 \u05e9\u05dc \u05d4\u05e7\u05d5\u05dc\u05d8\u05df, \u05de\u05d4 \u05e9\u05d2\u05d5\u05e8\u05dd \u05dc-Precipitated Withdrawal (DSM p.618)."
        },
        {
          "text": "\u05d4\u05e0\u05dc\u05d5\u05e7\u05e1\u05d5\u05df \u05d4\u05de\u05e9\u05d5\u05dc\u05d1 \u05d1\u05ea\u05e8\u05d5\u05e4\u05d4 \u05e0\u05e1\u05e4\u05d2 \u05ea\u05ea-\u05dc\u05e9\u05d5\u05e0\u05d9\u05ea \u05d5\u05d7\u05e1\u05dd \u05d0\u05ea \u05d4\u05e7\u05d5\u05dc\u05d8\u05e0\u05d9\u05dd.",
          "isCorrect": false,
          "rationale": "\u05e0\u05dc\u05d5\u05e7\u05e1\u05d5\u05df \u05d0\u05d9\u05e0\u05d5 \u05e0\u05e1\u05e4\u05d2 \u05d1\u05d0\u05d5\u05e4\u05df \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9 \u05d1\u05de\u05ea\u05df \u05d0\u05d5\u05e8\u05d0\u05dc\u05d9 \u05d0\u05d5 \u05e1\u05d0\u05d1-\u05dc\u05d9\u05e0\u05d2\u05d5\u05d0\u05dc\u05d9, \u05d5\u05d4\u05d5\u05d0 \u05e0\u05d5\u05e2\u05d3 \u05dc\u05de\u05e0\u05d5\u05e2 \u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05d4\u05d6\u05e8\u05e7\u05d4 \u05d1\u05dc\u05d1\u05d3 (Dulcan p.235)."
        },
        {
          "text": "Buprenorphine \u05d2\u05d5\u05e8\u05dd \u05dc\u05e9\u05d7\u05e8\u05d5\u05e8 \u05de\u05d9\u05d9\u05d3\u05d9 \u05e9\u05dc \u05d3\u05d5\u05e4\u05de\u05d9\u05df \u05d1-Nucleus Accumbens.",
          "isCorrect": false,
          "rationale": "\u05e9\u05d7\u05e8\u05d5\u05e8 \u05d3\u05d5\u05e4\u05de\u05d9\u05df \u05e7\u05e9\u05d5\u05e8 \u05dc\u05d0\u05d5\u05e4\u05d5\u05e8\u05d9\u05d4 \u05d5\u05dc\u05d0 \u05dc\u05d2\u05de\u05d9\u05dc\u05d4; \u05db\u05d0\u05df \u05d4\u05ea\u05e8\u05d7\u05e9\u05d4 \u05d9\u05e8\u05d9\u05d3\u05d4 \u05d1\u05d4\u05e4\u05e2\u05dc\u05d4 \u05d4\u05d0\u05d5\u05e4\u05d9\u05d5\u05d0\u05d9\u05d3\u05d9\u05ea (StahlNeuro p.542)."
        },
        {
          "text": "\u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05e4\u05d9\u05ea\u05d7 \u05e8\u05d2\u05d9\u05e9\u05d5\u05ea \u05d9\u05ea\u05e8 (Hypersensitivity) \u05dc\u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 \u05d4-$\\kappa$.",
          "isCorrect": false,
          "rationale": "Buprenorphine \u05d4\u05d5\u05d0 \u05d0\u05db\u05df \u05d0\u05e0\u05d8\u05d2\u05d5\u05e0\u05d9\u05e1\u05d8 \u05dc-$\\kappa$, \u05d0\u05da \u05d4\u05e9\u05e4\u05e2\u05ea\u05d5 \u05d4\u05de\u05e8\u05db\u05d6\u05d9\u05ea \u05d1\u05d2\u05de\u05d9\u05dc\u05d4 \u05de\u05ea\u05d5\u05d5\u05db\u05ea \u05d3\u05e8\u05da \u05e7\u05d5\u05dc\u05d8\u05df \u05d4-$\\mu$ (StahlNeuro p.560)."
