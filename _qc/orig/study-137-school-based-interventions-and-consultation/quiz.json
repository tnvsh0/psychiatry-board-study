    {
      "type": "multiple_choice",
      "question": "\u05d1\u05ea\u05d4\u05dc\u05d9\u05da \u05e7\u05d1\u05d9\u05e2\u05ea \u05d4\u05d6\u05db\u05d0\u05d5\u05ea \u05dc\u05d7\u05d9\u05e0\u05d5\u05da \u05de\u05d9\u05d5\u05d7\u05d3 \u05d1\u05d9\u05e9\u05e8\u05d0\u05dc (\u05d5\u05e2\u05d3\u05ea \u05d6\u05db\u05d0\u05d5\u05ea \u05d5\u05d0\u05e4\u05d9\u05d5\u05df), \u05de\u05d4\u05d5 \u05ea\u05e4\u05e7\u05d9\u05d3\u05d5 \u05d4\u05e2\u05d9\u05e7\u05e8\u05d9 \u05e9\u05dc \u05d4\u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8 \u05d4\u05de\u05d0\u05d1\u05d7\u05df \u05e2\u05dc \u05e4\u05d9 \u05d4\u05e1\u05d9\u05dc\u05d1\u05d5\u05e1 \u05d5\u05d4\u05d4\u05e7\u05e9\u05e8 \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9?",
      "answerOptions": [
        {
          "text": "\u05d0\u05e1\u05e4\u05e7\u05ea \u05d0\u05d1\u05d7\u05e0\u05d4 \u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05ea \u05de\u05d1\u05d5\u05e1\u05e1\u05ea DSM-5-TR \u05d5\u05ea\u05d9\u05d0\u05d5\u05e8 \u05d4\u05e9\u05e4\u05e2\u05ea\u05d4 \u05e2\u05dc \u05d4\u05ea\u05e4\u05e7\u05d5\u05d3 \u05d4\u05dc\u05d9\u05de\u05d5\u05d3\u05d9 \u05d5\u05d4\u05d7\u05d1\u05e8\u05ea\u05d9 \u05db\u05d1\u05e1\u05d9\u05e1 \u05dc\u05e7\u05d1\u05d9\u05e2\u05ea \u05e1\u05dc \u05d4\u05e9\u05d9\u05e8\u05d5\u05ea\u05d9\u05dd.",
          "isCorrect": true,
          "rationale": "\u05d4\u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8 \u05de\u05e1\u05e4\u05e7 \u05d0\u05ea \u05d4\u05ea\u05e9\u05ea\u05d9\u05ea \u05d4\u05d0\u05d1\u05d7\u05e0\u05ea\u05d9\u05ea \u05d5\u05d4\u05ea\u05e4\u05e7\u05d5\u05d3\u05d9\u05ea, \u05d0\u05da \u05d4\u05d5\u05d5\u05e2\u05d3\u05d4 \u05d4\u05d9\u05d0 \u05d6\u05d5 \u05e9\u05e7\u05d5\u05d1\u05e2\u05ea \u05d0\u05ea \u05d4\u05d9\u05e7\u05e3 \u05d4\u05ea\u05de\u05d9\u05db\u05d4 \u05d5\u05d4\u05e9\u05d9\u05d1\u05d5\u05e5 (Syllabus p.8, Dulcan p.1055-1056)."
        },
        {
          "text": "\u05e7\u05d1\u05d9\u05e2\u05d4 \u05e1\u05d5\u05e4\u05d9\u05ea \u05d5\u05de\u05d7\u05d9\u05d9\u05d1\u05ea \u05e9\u05dc \u05de\u05e1\u05e4\u05e8 \u05e9\u05e2\u05d5\u05ea \u05d4\u05e9\u05d9\u05dc\u05d5\u05d1 \u05e9\u05d4\u05ea\u05dc\u05de\u05d9\u05d3 \u05d9\u05e7\u05d1\u05dc \u05d1\u05d1\u05d9\u05ea \u05d4\u05e1\u05e4\u05e8.",
          "isCorrect": false,
          "rationale": "\u05de\u05e1\u05e4\u05e8 \u05e9\u05e2\u05d5\u05ea \u05d4\u05e9\u05d9\u05dc\u05d5\u05d1 \u05d5\u05e1\u05dc \u05d4\u05e9\u05d9\u05e8\u05d5\u05ea\u05d9\u05dd \u05e0\u05e7\u05d1\u05e2\u05d9\u05dd \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d4\u05d5\u05d5\u05e2\u05d3\u05d4 \u05d1\u05d4\u05ea\u05d0\u05dd \u05dc\u05de\u05e9\u05d0\u05d1\u05d9 \u05d4\u05de\u05e2\u05e8\u05db\u05ea \u05d5\u05e8\u05de\u05ea \u05d4\u05d0\u05e4\u05d9\u05d5\u05df, \u05d5\u05dc\u05d0 \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d4\u05e8\u05d5\u05e4\u05d0 \u05d4\u05de\u05d8\u05e4\u05dc (Syllabus p.8)."
        },
        {
          "text": "\u05d7\u05ea\u05d9\u05de\u05d4 \u05e2\u05dc \u05d8\u05d5\u05e4\u05e1 \u05d4-IEP (\u05ea\u05d7\u05d9\"\u05d0) \u05e9\u05dc \u05d4\u05ea\u05dc\u05de\u05d9\u05d3 \u05db\u05d2\u05d5\u05e8\u05dd \u05d4\u05d0\u05d7\u05e8\u05d0\u05d9 \u05e2\u05dc \u05d9\u05d9\u05e9\u05d5\u05de\u05d5.",
          "isCorrect": false,
          "rationale": "\u05e6\u05d5\u05d5\u05ea \u05d1\u05d9\u05ea \u05d4\u05e1\u05e4\u05e8 \u05d5\u05d4\u05d4\u05d5\u05e8\u05d9\u05dd \u05d4\u05dd \u05d4\u05d0\u05d7\u05e8\u05d0\u05d9\u05dd \u05e2\u05dc \u05d1\u05e0\u05d9\u05d9\u05ea \u05d5\u05d9\u05d9\u05e9\u05d5\u05dd \u05d4-IEP; \u05d4\u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8 \u05de\u05e9\u05de\u05e9 \u05db\u05d9\u05d5\u05e2\u05e5 \u05d7\u05d9\u05e6\u05d5\u05e0\u05d9 (Dulcan p.1049)."
        },
        {
          "text": "\u05d9\u05d9\u05e6\u05d5\u05d2 \u05de\u05e9\u05e4\u05d8\u05d9 \u05e9\u05dc \u05d4\u05d5\u05e8\u05d9 \u05d4\u05ea\u05dc\u05de\u05d9\u05d3 \u05de\u05d5\u05dc \u05de\u05e9\u05e8\u05d3 \u05d4\u05d7\u05d9\u05e0\u05d5\u05da \u05dc\u05e6\u05d5\u05e8\u05da \u05e7\u05d1\u05dc\u05ea \u05e1\u05d9\u05d9\u05e2\u05ea \u05e6\u05de\u05d5\u05d3\u05d4.",
          "isCorrect": false,
          "rationale": "\u05d4\u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8 \u05de\u05e1\u05e4\u05e7 \u05d4\u05e2\u05e8\u05db\u05d4 \u05de\u05e7\u05e6\u05d5\u05e2\u05d9\u05ea \u05d0\u05d5\u05d1\u05d9\u05d9\u05e7\u05d8\u05d9\u05d1\u05d9\u05ea \u05d5\u05dc\u05d0 \u05de\u05e9\u05de\u05e9 \u05db\u05e0\u05e6\u05d9\u05d2 \u05de\u05e9\u05e4\u05d8\u05d9 (Dulcan p.1052)."
        }
