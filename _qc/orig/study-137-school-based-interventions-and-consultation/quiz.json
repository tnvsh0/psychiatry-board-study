{
  "title": "Psychiatry Quiz",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\u05ea\u05dc\u05de\u05d9\u05d3 \u05db\u05d9\u05ea\u05d4 \u05d7' \u05d4\u05de\u05d0\u05d5\u05d1\u05d7\u05df \u05e2\u05dd Major Depressive Disorder \u05d5\u05d1\u05e2\u05dc \u05ea\u05d5\u05db\u05e0\u05d9\u05ea IEP, \u05d4\u05d5\u05e9\u05e2\u05d4 \u05de\u05d1\u05d9\u05ea \u05d4\u05e1\u05e4\u05e8 \u05dc\u05de\u05e9\u05da 12 \u05d9\u05de\u05d9\u05dd \u05d1\u05de\u05e6\u05d8\u05d1\u05e8 \u05d1\u05de\u05d4\u05dc\u05da \u05e9\u05e0\u05ea \u05d4\u05dc\u05d9\u05de\u05d5\u05d3\u05d9\u05dd \u05e2\u05e7\u05d1 \u05d4\u05ea\u05e4\u05e8\u05e6\u05d5\u05d9\u05d5\u05ea \u05d6\u05e2\u05dd \u05db\u05dc\u05e4\u05d9 \u05d4\u05e6\u05d5\u05d5\u05ea. \u05de\u05d4\u05d5 \u05d4\u05e6\u05e2\u05d3 \u05d4\u05de\u05e0\u05d4\u05dc\u05d9/\u05e7\u05dc\u05d9\u05e0\u05d9 \u05d4\u05e0\u05d3\u05e8\u05e9 \u05e2\u05dc \u05e4\u05d9 \u05d7\u05d5\u05e7 IDEA \u05d1\u05de\u05e7\u05e8\u05d4 \u05d6\u05d4?",
      "answerOptions": [
        {
          "text": "\u05e7\u05d9\u05d5\u05dd \u05d3\u05d9\u05d5\u05df Manifestation Determination Review (MDR) \u05dc\u05d1\u05d3\u05d9\u05e7\u05ea \u05d4\u05d6\u05d9\u05e7\u05d4 \u05d1\u05d9\u05df \u05d4\u05de\u05d5\u05d2\u05d1\u05dc\u05d5\u05ea \u05dc\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea.",
          "isCorrect": true,
          "rationale": "\u05e2\u05dc \u05e4\u05d9 \u05d7\u05d5\u05e7 IDEA, \u05db\u05d0\u05e9\u05e8 \u05ea\u05dc\u05de\u05d9\u05d3 \u05e2\u05dd IEP \u05de\u05d5\u05e8\u05d7\u05e7 \u05dc\u05d9\u05d5\u05ea\u05e8 \u05de-10 \u05d9\u05de\u05d9\u05dd \u05de\u05e6\u05d8\u05d1\u05e8\u05d9\u05dd, \u05d7\u05d5\u05d1\u05d4 \u05dc\u05e7\u05d9\u05d9\u05dd \u05d3\u05d9\u05d5\u05df \u05e8\u05e9\u05de\u05d9 \u05dc\u05e7\u05d1\u05d9\u05e2\u05d4 \u05d4\u05d0\u05dd \u05d4\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05e0\u05d1\u05e2\u05d4 \u05d9\u05e9\u05d9\u05e8\u05d5\u05ea \u05de\u05d4\u05de\u05d5\u05d2\u05d1\u05dc\u05d5\u05ea \u05e9\u05dc\u05d5 (Dulcan p.1049-1050)."
        },
        {
          "text": "\u05e9\u05d9\u05e0\u05d5\u05d9 \u05d0\u05d5\u05d8\u05d5\u05e0\u05d5\u05de\u05d9 \u05e9\u05dc \u05d4-IEP \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d4\u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8 \u05d4\u05de\u05d8\u05e4\u05dc \u05dc\u05e6\u05d5\u05e8\u05da \u05d4\u05e2\u05d1\u05e8\u05d4 \u05dc\u05d1\u05d9\u05ea \u05e1\u05e4\u05e8 \u05dc\u05d7\u05d9\u05e0\u05d5\u05da \u05de\u05d9\u05d5\u05d7\u05d3.",
          "isCorrect": false,
          "rationale": "\u05d4\u05e1\u05de\u05db\u05d5\u05ea \u05dc\u05e7\u05d1\u05d9\u05e2\u05ea \u05d4\u05de\u05e1\u05d2\u05e8\u05ea \u05d5\u05d4\u05e9\u05d9\u05e0\u05d5\u05d9 \u05d1-IEP \u05e0\u05ea\u05d5\u05e0\u05d4 \u05dc\u05e6\u05d5\u05d5\u05ea \u05d4\u05e8\u05d1-\u05de\u05e7\u05e6\u05d5\u05e2\u05d9 \u05e9\u05dc \u05d1\u05d9\u05ea \u05d4\u05e1\u05e4\u05e8 (IEP team), \u05d5\u05dc\u05d0 \u05dc\u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8 \u05d4\u05de\u05d8\u05e4\u05dc \u05d1\u05d0\u05d5\u05e4\u05df \u05d1\u05dc\u05e2\u05d3\u05d9 (Dulcan p.1055)."
        },
        {
          "text": "\u05d4\u05e4\u05e1\u05e7\u05ea \u05e9\u05d9\u05e8\u05d5\u05ea\u05d9 \u05d4\u05d7\u05d9\u05e0\u05d5\u05da \u05d4\u05de\u05d9\u05d5\u05d7\u05d3 \u05d1\u05d0\u05d5\u05e4\u05df \u05de\u05d9\u05d9\u05d3\u05d9 \u05e2\u05e7\u05d1 \u05e2\u05d1\u05d9\u05e8\u05ea \u05de\u05e9\u05de\u05e2\u05ea \u05d7\u05de\u05d5\u05e8\u05d4.",
          "isCorrect": false,
          "rationale": "\u05d2\u05dd \u05d1\u05e2\u05ea \u05d4\u05e9\u05e2\u05d9\u05d4 \u05d0\u05d5 \u05e9\u05d9\u05e0\u05d5\u05d9 \u05de\u05d9\u05e7\u05d5\u05dd, \u05d1\u05d9\u05ea \u05d4\u05e1\u05e4\u05e8 \u05de\u05d7\u05d5\u05d9\u05d1 \u05dc\u05d4\u05de\u05e9\u05d9\u05da \u05dc\u05e1\u05e4\u05e7 \u05d0\u05ea \u05e9\u05d9\u05e8\u05d5\u05ea\u05d9 \u05d4-IEP \u05d1\u05de\u05e1\u05d2\u05e8\u05ea \u05d7\u05dc\u05d5\u05e4\u05d9\u05ea (Dulcan p.1049)."
        },
        {
          "text": "\u05d4\u05e4\u05e0\u05d9\u05d4 \u05de\u05d9\u05d9\u05d3\u05d9\u05ea \u05dc\u05d4\u05e2\u05e8\u05db\u05d4 \u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9\u05ea \u05d1\u05d7\u05d3\u05e8 \u05de\u05d9\u05d5\u05df \u05dc\u05dc\u05d0 \u05e6\u05d5\u05e8\u05da \u05d1\u05d3\u05d9\u05d5\u05df \u05d1\u05d1\u05d9\u05ea \u05d4\u05e1\u05e4\u05e8.",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05e9\u05e6\u05d5\u05e8\u05da \u05e7\u05dc\u05d9\u05e0\u05d9 \u05e2\u05e9\u05d5\u05d9 \u05dc\u05e2\u05dc\u05d5\u05ea, \u05d4\u05d7\u05d5\u05e7 \u05de\u05d7\u05d9\u05d9\u05d1 \u05d4\u05dc\u05d9\u05da \u05de\u05e0\u05d4\u05dc\u05d9 \u05e9\u05dc \u05d1\u05d3\u05d9\u05e7\u05ea \u05d6\u05d9\u05e7\u05d4 \u05d1\u05ea\u05d5\u05da \u05d4\u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05d1\u05d9\u05ea-\u05e1\u05e4\u05e8\u05d9\u05ea \u05dc\u05d0\u05d7\u05e8 10 \u05d9\u05de\u05d9 \u05d4\u05e9\u05e2\u05d9\u05d4 (Dulcan p.1049)."
        }
      ],
      "hint": "\u05d4\u05ea\u05d9\u05d9\u05d7\u05e1 \u05dc\u05de\u05d2\u05d1\u05dc\u05ea \u05d4\u05d9\u05de\u05d9\u05dd \u05d4\u05de\u05e6\u05d8\u05d1\u05e8\u05ea \u05d4\u05de\u05e4\u05e2\u05d9\u05dc\u05d4 \u05d4\u05d2\u05e0\u05d4 \u05de\u05e9\u05e4\u05d8\u05d9\u05ea \u05dc\u05ea\u05dc\u05de\u05d9\u05d3\u05d9\u05dd \u05d1\u05d7\u05d9\u05e0\u05d5\u05da \u05de\u05d9\u05d5\u05d7\u05d3.",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8 \u05d9\u05dc\u05d3\u05d9\u05dd \u05de\u05ea\u05d1\u05e7\u05e9 \u05dc\u05db\u05ea\u05d5\u05d1 \u05d4\u05de\u05dc\u05e6\u05d5\u05ea \u05dc\u05d1\u05d9\u05ea \u05e1\u05e4\u05e8 \u05e2\u05d1\u05d5\u05e8 \u05d9\u05dc\u05d3 \u05d4\u05de\u05d0\u05d5\u05d1\u05d7\u05df \u05e2\u05dd ADHD \u05d5-Specific Learning Disorder. \u05de\u05d4\u05d9 \u05d4\u05d3\u05e8\u05da \u05d4\u05e0\u05db\u05d5\u05e0\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05e0\u05d9\u05e1\u05d5\u05d7 \u05d4\u05d4\u05de\u05dc\u05e6\u05d5\u05ea \u05e2\u05dc \u05de\u05e0\u05ea \u05dc\u05d4\u05d1\u05d8\u05d9\u05d7 \u05e9\u05d9\u05ea\u05d5\u05e3 \u05e4\u05e2\u05d5\u05dc\u05d4 \u05de\u05d9\u05d8\u05d1\u05d9 \u05e2\u05dd \u05d4\u05e6\u05d5\u05d5\u05ea \u05d4\u05d7\u05d9\u05e0\u05d5\u05db\u05d9?",
      "answerOptions": [
        {
          "text": "\u05d4\u05de\u05dc\u05e6\u05d4 \u05e2\u05dc \u05e9\u05d9\u05e8\u05d5\u05ea\u05d9\u05dd \u05d5\u05ea\u05de\u05d9\u05db\u05d5\u05ea \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05d9\u05dd (\u05dc\u05de\u05e9\u05dc: \u05d0\u05d9\u05de\u05d5\u05df \u05ea\u05e4\u05e7\u05d5\u05d3\u05d9\u05dd \u05e0\u05d9\u05d4\u05d5\u05dc\u05d9\u05d9\u05dd) \u05ea\u05d5\u05da \u05d4\u05e9\u05d0\u05e8\u05ea \u05e7\u05d1\u05d9\u05e2\u05ea \u05d4\u05de\u05d9\u05e7\u05d5\u05dd \u05dc\u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05d7\u05d9\u05e0\u05d5\u05da.",
          "isCorrect": true,
          "rationale": "\u05d4\u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8 \u05e6\u05e8\u05d9\u05da \u05dc\u05d4\u05de\u05dc\u05d9\u05e5 \u05e2\u05dc \u05e1\u05d5\u05d2 \u05d4\u05e9\u05d9\u05e8\u05d5\u05ea\u05d9\u05dd \u05d4\u05e0\u05d3\u05e8\u05e9\u05d9\u05dd, \u05e9\u05db\u05df \u05d4\u05e6\u05d5\u05d5\u05ea \u05d4\u05d7\u05d9\u05e0\u05d5\u05db\u05d9 \u05d4\u05d5\u05d0 \u05d1\u05e2\u05dc \u05d4\u05e1\u05de\u05db\u05d5\u05ea \u05d4\u05de\u05e9\u05e4\u05d8\u05d9\u05ea \u05dc\u05e7\u05d1\u05d5\u05e2 \u05d0\u05ea \u05d4\u05de\u05e1\u05d2\u05e8\u05ea \u05d4\u05e4\u05d7\u05d5\u05ea \u05de\u05d2\u05d1\u05d9\u05dc\u05d4 (LRE) \u05e9\u05d1\u05d4 \u05d9\u05d9\u05e0\u05ea\u05e0\u05d5 \u05e9\u05d9\u05e8\u05d5\u05ea\u05d9\u05dd \u05d0\u05dc\u05d5 (Dulcan p.1055-1056)."
        },
        {
          "text": "\u05d3\u05e8\u05d9\u05e9\u05d4 \u05de\u05e4\u05d5\u05e8\u05e9\u05ea \u05dc\u05d4\u05e2\u05d1\u05e8\u05ea \u05d4\u05d9\u05dc\u05d3 \u05dc\u05db\u05d9\u05ea\u05d4 \u05e7\u05d8\u05e0\u05d4 (\u05db\u05d9\u05ea\u05ea \u05d7\u05d9\u05e0\u05d5\u05da \u05de\u05d9\u05d5\u05d7\u05d3) \u05db\u05d9\u05d5\u05d5\u05df \u05e9\u05d6\u05d5 \u05d4\u05de\u05e1\u05d2\u05e8\u05ea \u05d4\u05d9\u05d7\u05d9\u05d3\u05d4 \u05d4\u05de\u05ea\u05d0\u05d9\u05de\u05d4.",
          "isCorrect": false,
          "rationale": "\u05d4\u05de\u05dc\u05e6\u05d4 \u05e2\u05dc \u05de\u05d9\u05e7\u05d5\u05dd \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9 (Placement) \u05e0\u05d7\u05e9\u05d1\u05ea \u05dc\u05e2\u05ea\u05d9\u05dd \u05e7\u05e8\u05d5\u05d1\u05d5\u05ea \u05dc\u05d7\u05e8\u05d9\u05d2\u05d4 \u05de\u05e1\u05de\u05db\u05d5\u05ea\u05d5 \u05e9\u05dc \u05d4\u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8 \u05d5\u05e2\u05dc\u05d5\u05dc\u05d4 \u05dc\u05d9\u05e6\u05d5\u05e8 \u05e7\u05d5\u05e0\u05e4\u05dc\u05d9\u05e7\u05d8 \u05e2\u05dd \u05e6\u05d5\u05d5\u05ea \u05d1\u05d9\u05ea \u05d4\u05e1\u05e4\u05e8 (Dulcan p.1055)."
        },
        {
          "text": "\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05d0\u05d1\u05d7\u05e0\u05d5\u05ea \u05d6\u05de\u05e0\u05d9\u05d5\u05ea \u05db\u05d2\u05d5\u05df 'Rule-out Bipolar Disorder' \u05db\u05d3\u05d9 \u05dc\u05d4\u05e9\u05d9\u05d2 \u05d9\u05d5\u05ea\u05e8 \u05e9\u05e2\u05d5\u05ea \u05e1\u05d9\u05d5\u05e2.",
          "isCorrect": false,
          "rationale": "\u05d9\u05e9 \u05dc\u05d4\u05d9\u05de\u05e0\u05e2 \u05de\u05d0\u05d1\u05d7\u05e0\u05d5\u05ea \u05de\u05e1\u05d5\u05d2 'Rule-out'; \u05e2\u05dc \u05d4\u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8 \u05dc\u05e1\u05e4\u05e7 \u05d0\u05d1\u05d7\u05e0\u05d4 \u05d1\u05e8\u05d5\u05e8\u05d4 \u05d5\u05dc\u05e4\u05e8\u05d8 \u05d0\u05ea \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05d4 \u05d5\u05d4\u05e9\u05e4\u05e2\u05ea\u05dd \u05d4\u05ea\u05e4\u05e7\u05d5\u05d3\u05d9\u05ea (Dulcan p.1055)."
        },
        {
          "text": "\u05de\u05ea\u05df \u05e8\u05e9\u05d9\u05de\u05d4 \u05d0\u05e8\u05d5\u05db\u05d4 \u05e9\u05dc \u05db\u05dc \u05d4\u05d4\u05ea\u05d0\u05de\u05d5\u05ea \u05d4\u05d0\u05e4\u05e9\u05e8\u05d9\u05d5\u05ea \u05d4\u05de\u05d5\u05e4\u05d9\u05e2\u05d5\u05ea \u05d1-Table 47-2 \u05dc\u05dc\u05d0 \u05e7\u05e9\u05e8 \u05dc\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d4\u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05d9\u05dd.",
          "isCorrect": false,
          "rationale": "\u05d4\u05ea\u05d0\u05de\u05d5\u05ea \u05d7\u05d9\u05d9\u05d1\u05d5\u05ea \u05dc\u05d4\u05d9\u05d2\u05d6\u05e8 \u05de\u05d4\u05e4\u05e8\u05d5\u05e4\u05d9\u05dc \u05d4\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d8\u05d9 \u05d4\u05d9\u05d9\u05d7\u05d5\u05d3\u05d9 \u05e9\u05dc \u05d4\u05ea\u05dc\u05de\u05d9\u05d3 \u05d5\u05dc\u05d0 \u05dc\u05d4\u05d9\u05e0\u05ea\u05df \u05db'\u05e8\u05e9\u05d9\u05de\u05ea \u05de\u05db\u05d5\u05dc\u05ea' \u05db\u05dc\u05dc\u05d9\u05ea (Dulcan p.1056)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d7\u05dc\u05d5\u05e7\u05ea \u05d4\u05e1\u05de\u05db\u05d5\u05d9\u05d5\u05ea \u05d1\u05d9\u05df \u05d4\u05d2\u05d5\u05e8\u05dd \u05d4\u05de\u05d0\u05d1\u05d7\u05df \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9 \u05dc\u05d1\u05d9\u05df \u05d4\u05d2\u05d5\u05e3 \u05d4\u05e7\u05d5\u05d1\u05e2 \u05d0\u05ea \u05d4\u05d4\u05e9\u05de\u05d4 \u05d4\u05d7\u05d9\u05e0\u05d5\u05db\u05d9\u05ea.",
      "imageUrls": []
    },
    {
      "type": "fill_in_the_blank",
      "question": "\u05e2\u05dc \u05e4\u05d9 \u05de\u05d5\u05d3\u05dc \u05d4-MTSS (Multitiered System of Supports), \u05d4\u05ea\u05e2\u05e8\u05d1\u05d5\u05ea \u05de\u05e1\u05d5\u05d2 SOS (Signs of Suicide) \u05d0\u05d5 \u05ea\u05d5\u05db\u05e0\u05d9\u05ea SEL \u05d0\u05d5\u05e0\u05d9\u05d1\u05e8\u05e1\u05dc\u05d9\u05ea \u05d4\u05de\u05d9\u05d5\u05e2\u05d3\u05ea \u05dc\u05db\u05dc\u05dc \u05ea\u05dc\u05de\u05d9\u05d3\u05d9 \u05d1\u05d9\u05ea \u05d4\u05e1\u05e4\u05e8, \u05de\u05e1\u05d5\u05d5\u05d2\u05ea \u05db\u05e8\u05de\u05ea \u05de\u05e0\u05d9\u05e2\u05d4 ___.",
      "bestAnswer": "Tier 1",
      "acceptableAnswers": [
        "\u05d0\u05d5\u05e0\u05d9\u05d1\u05e8\u05e1\u05dc\u05d9\u05ea",
        "Universal",
        "1",
        "Tier one"
      ],
      "rationale": "Tier 1 \u05de\u05ea\u05d9\u05d9\u05d7\u05e1 \u05dc\u05e9\u05d9\u05e8\u05d5\u05ea\u05d9 \u05e7\u05d9\u05d3\u05d5\u05dd \u05d1\u05e8\u05d9\u05d0\u05d5\u05ea \u05d4\u05e0\u05e4\u05e9 \u05d5\u05ea\u05de\u05d9\u05db\u05d4 \u05d4\u05de\u05d9\u05d5\u05e2\u05d3\u05d9\u05dd \u05dc-80%-85% \u05de\u05db\u05dc\u05dc \u05d4\u05ea\u05dc\u05de\u05d9\u05d3\u05d9\u05dd, \u05dc\u05dc\u05d0 \u05e7\u05e9\u05e8 \u05dc\u05e8\u05de\u05ea \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05d4\u05d0\u05d9\u05e9\u05d9\u05ea \u05e9\u05dc\u05d4\u05dd (Dulcan p.1046).",
      "hint": "\u05d6\u05d5\u05d4\u05d9 \u05e8\u05de\u05ea \u05d4\u05de\u05e0\u05d9\u05e2\u05d4 \u05d4\u05d1\u05e1\u05d9\u05e1\u05d9\u05ea \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d1\u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05de\u05d3\u05d5\u05e8\u05d2\u05ea."
    },
    {
      "type": "multiple_select",
      "question": "\u05e2\u05dc \u05e4\u05d9 \u05d7\u05d5\u05e7 IDEA, \u05d0\u05d9\u05dc\u05d5 \u05de\u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9\u05dd \u05d4\u05d1\u05d0\u05d9\u05dd \u05e2\u05e9\u05d5\u05d9\u05d9\u05dd \u05dc\u05d4\u05d2\u05d3\u05d9\u05e8 \u05ea\u05dc\u05de\u05d9\u05d3 \u05db\u05d1\u05e2\u05dc 'Emotional Disturbance' (\u05d4\u05e4\u05e8\u05e2\u05d4 \u05e8\u05d2\u05e9\u05d9\u05ea \u05e7\u05e9\u05d4) \u05d4\u05de\u05e9\u05e4\u05d9\u05e2\u05d4 \u05dc\u05e8\u05e2\u05d4 \u05e2\u05dc \u05d4\u05d9\u05e9\u05d2\u05d9\u05d5 \u05d4\u05dc\u05d9\u05de\u05d5\u05d3\u05d9\u05d9\u05dd?",
      "answerOptions": [
        {
          "text": "\u05d0\u05d9-\u05d9\u05db\u05d5\u05dc\u05ea \u05dc\u05d1\u05e0\u05d5\u05ea \u05d0\u05d5 \u05dc\u05ea\u05d7\u05d6\u05e7 \u05de\u05e2\u05e8\u05db\u05d5\u05ea \u05d9\u05d7\u05e1\u05d9\u05dd \u05de\u05e1\u05e4\u05e7\u05d5\u05ea \u05e2\u05dd \u05e7\u05d1\u05d5\u05e6\u05ea \u05d4\u05e9\u05d5\u05d5\u05d9\u05dd \u05d5\u05de\u05d5\u05e8\u05d9\u05dd.",
          "isCorrect": true,
          "rationale": "\u05d6\u05d4\u05d5 \u05d0\u05d7\u05d3 \u05de\u05d7\u05de\u05e9\u05ea \u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05d4\u05de\u05d5\u05d2\u05d3\u05e8\u05d9\u05dd \u05d1\u05d7\u05d5\u05e7 IDEA \u05dc\u05d4\u05d2\u05d3\u05e8\u05ea \u05d4\u05e4\u05e8\u05e2\u05d4 \u05e8\u05d2\u05e9\u05d9\u05ea (Dulcan p.1048-1049)."
        },
        {
          "text": "\u05de\u05e6\u05d1 \u05e8\u05d5\u05d7 \u05db\u05dc\u05dc\u05d9 \u05e9\u05dc \u05e2\u05e6\u05d1\u05d5\u05ea \u05d0\u05d5 \u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05dc\u05d0\u05d5\u05e8\u05da \u05d6\u05de\u05df \u05d5\u05d1\u05de\u05d9\u05d3\u05d4 \u05e0\u05d9\u05db\u05e8\u05ea.",
          "isCorrect": true,
          "rationale": "\u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05de\u05ea\u05de\u05e9\u05da \u05d4\u05e4\u05d5\u05d2\u05e2 \u05d1\u05ea\u05e4\u05e7\u05d5\u05d3 \u05d4\u05dc\u05d9\u05de\u05d5\u05d3\u05d9 \u05d4\u05d5\u05d0 \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df \u05de\u05e8\u05db\u05d6\u05d9 \u05dc\u05d6\u05db\u05d0\u05d5\u05ea \u05dc\u05d7\u05d9\u05e0\u05d5\u05da \u05de\u05d9\u05d5\u05d7\u05d3 \u05ea\u05d7\u05ea \u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4 \u05d6\u05d5 (Dulcan p.1049)."
        },
        {
          "text": "\u05e0\u05d8\u05d9\u05d9\u05d4 \u05dc\u05e4\u05ea\u05d7 \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e4\u05d9\u05d6\u05d9\u05d9\u05dd \u05d0\u05d5 \u05e4\u05d7\u05d3\u05d9\u05dd \u05d4\u05e7\u05e9\u05d5\u05e8\u05d9\u05dd \u05dc\u05d1\u05e2\u05d9\u05d5\u05ea \u05d0\u05d9\u05e9\u05d9\u05d5\u05ea \u05d0\u05d5 \u05d1\u05d9\u05ea-\u05e1\u05e4\u05e8\u05d9\u05d5\u05ea.",
          "isCorrect": true,
          "rationale": "\u05d4\u05d5\u05e4\u05e2\u05ea \u05e1\u05d5\u05de\u05d8\u05d9\u05d6\u05e6\u05d9\u05d4 \u05d0\u05d5 \u05e4\u05d5\u05d1\u05d9\u05d5\u05ea \u05e1\u05d1\u05d9\u05d1 \u05d1\u05d9\u05ea \u05d4\u05e1\u05e4\u05e8 \u05e0\u05db\u05dc\u05dc\u05ea \u05d1\u05d4\u05d2\u05d3\u05e8\u05ea \u05d4\u05d7\u05d5\u05e7 \u05dc\u05d4\u05e4\u05e8\u05e2\u05d4 \u05e8\u05d2\u05e9\u05d9\u05ea (Dulcan p.1049)."
        },
        {
          "text": "\u05e7\u05e9\u05d9\u05d9\u05dd \u05d0\u05e7\u05d3\u05de\u05d9\u05d9\u05dd \u05d4\u05e0\u05d5\u05d1\u05e2\u05d9\u05dd \u05d0\u05da \u05d5\u05e8\u05e7 \u05de\u05de\u05d5\u05d2\u05d1\u05dc\u05d5\u05ea \u05e9\u05db\u05dc\u05d9\u05ea \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9\u05ea (Intellectual Disability).",
          "isCorrect": false,
          "rationale": "\u05d4\u05d2\u05d3\u05e8\u05ea Emotional Disturbance \u05de\u05d7\u05e8\u05d9\u05d2\u05d4 \u05de\u05e7\u05e8\u05d9\u05dd \u05e9\u05e0\u05d9\u05ea\u05df \u05dc\u05d4\u05e1\u05d1\u05d9\u05e8\u05dd \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d2\u05d5\u05e8\u05de\u05d9\u05dd \u05d0\u05d9\u05e0\u05d8\u05dc\u05e7\u05d8\u05d5\u05d0\u05dc\u05d9\u05d9\u05dd, \u05ea\u05d7\u05d5\u05e9\u05ea\u05d9\u05d9\u05dd \u05d0\u05d5 \u05d1\u05e8\u05d9\u05d0\u05d5\u05ea\u05d9\u05d9\u05dd \u05d0\u05d7\u05e8\u05d9\u05dd (Dulcan p.1048)."
        }
      ],
      "hint": "\u05d4\u05d4\u05d2\u05d3\u05e8\u05d4 \u05d4\u05d7\u05d5\u05e7\u05d9\u05ea \u05db\u05d5\u05dc\u05dc\u05ea \u05d4\u05d9\u05d1\u05d8\u05d9\u05dd \u05d7\u05d1\u05e8\u05ea\u05d9\u05d9\u05dd, \u05e8\u05d2\u05e9\u05d9\u05d9\u05dd \u05d5\u05e4\u05d9\u05d6\u05d9\u05d9\u05dd, \u05d0\u05da \u05de\u05d7\u05e8\u05d9\u05d2\u05d4 \u05d2\u05d5\u05e8\u05de\u05d9\u05dd \u05d0\u05d5\u05e8\u05d2\u05e0\u05d9\u05d9\u05dd \u05d8\u05d4\u05d5\u05e8\u05d9\u05dd.",
      "hasAllOfTheAbove": false,
      "hasNoneOfTheAbove": false,
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05ea\u05dc\u05de\u05d9\u05d3 \u05ea\u05d9\u05db\u05d5\u05df \u05de\u05d5\u05e4\u05e0\u05d4 \u05dc\u05d4\u05e2\u05e8\u05db\u05d4 \u05dc\u05d0\u05d7\u05e8 \u05e9\u05db\u05ea\u05d1 \u05d1\u05e8\u05e9\u05ea\u05d5\u05ea \u05d4\u05d7\u05d1\u05e8\u05ea\u05d9\u05d5\u05ea: '\u05d4\u05dc\u05d5\u05d5\u05d0\u05d9 \u05e9\u05d4\u05de\u05d5\u05e8\u05d4 \u05dc\u05de\u05ea\u05de\u05d8\u05d9\u05e7\u05d4 \u05d4\u05d9\u05d9\u05ea\u05d4 \u05e0\u05e2\u05dc\u05de\u05ea \u05d1\u05e4\u05d9\u05e6\u05d5\u05e5'. \u05d1\u05e8\u05d0\u05d9\u05d5\u05df, \u05d4\u05ea\u05dc\u05de\u05d9\u05d3 \u05de\u05d1\u05d9\u05e2 \u05d7\u05e8\u05d8\u05d4, \u05de\u05e1\u05d1\u05d9\u05e8 \u05e9\u05d4\u05d9\u05d4 \u05de\u05ea\u05d5\u05e1\u05db\u05dc \u05de\u05e6\u05d9\u05d5\u05df \u05e0\u05de\u05d5\u05da, \u05d5\u05d0\u05d9\u05df \u05dc\u05d5 \u05ea\u05d5\u05db\u05e0\u05d9\u05ea \u05d0\u05d5 \u05db\u05d5\u05d5\u05e0\u05d4 \u05dc\u05e4\u05d2\u05d5\u05e2 \u05d1\u05d4. \u05e2\u05dc \u05e4\u05d9 \u05e4\u05e8\u05d5\u05d8\u05d5\u05e7\u05d5\u05dc UVA (University of Virginia), \u05db\u05d9\u05e6\u05d3 \u05d9\u05e9 \u05dc\u05e1\u05d5\u05d5\u05d2 \u05d0\u05d9\u05d5\u05dd \u05d6\u05d4?",
      "answerOptions": [
        {
          "text": "\u05d0\u05d9\u05d5\u05dd \u05d7\u05d5\u05dc\u05e3 (Transient threat).",
          "isCorrect": true,
          "rationale": "\u05d0\u05d9\u05d5\u05dd \u05de\u05e1\u05d5\u05d5\u05d2 \u05db\u05d7\u05d5\u05dc\u05e3 \u05db\u05d0\u05e9\u05e8 \u05d4\u05d5\u05d0 \u05d1\u05d9\u05d8\u05d5\u05d9 \u05e9\u05dc \u05db\u05e2\u05e1 \u05d0\u05d5 \u05ea\u05e1\u05db\u05d5\u05dc \u05dc\u05dc\u05d0 \u05db\u05d5\u05d5\u05e0\u05d4 \u05d0\u05de\u05d9\u05ea\u05d9\u05ea \u05dc\u05e4\u05d2\u05d5\u05e2, \u05d5\u05d4\u05ea\u05dc\u05de\u05d9\u05d3 \u05de\u05e1\u05d5\u05d2\u05dc \u05dc\u05d7\u05d6\u05d5\u05e8 \u05d1\u05d5 \u05d5\u05dc\u05d4\u05e1\u05d1\u05d9\u05e8 \u05d0\u05ea \u05d4\u05de\u05e0\u05d9\u05e2 (Dulcan p.1063)."
        },
        {
          "text": "\u05d0\u05d9\u05d5\u05dd \u05de\u05d4\u05d5\u05ea\u05d9 \u05e8\u05e6\u05d9\u05e0\u05d9 (Substantive threat).",
          "isCorrect": false,
          "rationale": "\u05d0\u05d9\u05d5\u05dd \u05de\u05d4\u05d5\u05ea\u05d9 \u05d3\u05d5\u05e8\u05e9 \u05db\u05d5\u05d5\u05e0\u05d4 \u05d0\u05d5 \u05e6\u05e2\u05d3\u05d9\u05dd \u05dc\u05de\u05d9\u05de\u05d5\u05e9, \u05d1\u05e2\u05d5\u05d3 \u05db\u05d0\u05df \u05d4\u05ea\u05dc\u05de\u05d9\u05d3 \u05de\u05d1\u05d9\u05e2 \u05d7\u05e8\u05d8\u05d4 \u05d5\u05d4\u05e2\u05d3\u05e8 \u05db\u05d5\u05d5\u05e0\u05d4 (Dulcan p.1063)."
        },
        {
          "text": "\u05d0\u05d9\u05d5\u05dd \u05de\u05d4\u05d5\u05ea\u05d9 \u05d7\u05de\u05d5\u05e8 \u05de\u05d0\u05d5\u05d3 (Very serious substantive threat).",
          "isCorrect": false,
          "rationale": "\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4 \u05d6\u05d5 \u05e9\u05de\u05d5\u05e8\u05d4 \u05dc\u05d0\u05d9\u05d5\u05de\u05d9\u05dd \u05d4\u05db\u05d5\u05dc\u05dc\u05d9\u05dd \u05e0\u05e9\u05e7 \u05d0\u05d5 \u05db\u05d5\u05d5\u05e0\u05d4 \u05dc\u05e8\u05e6\u05d7/\u05e4\u05e6\u05d9\u05e2\u05d4 \u05e7\u05e9\u05d4, \u05de\u05d4 \u05e9\u05d0\u05d9\u05e0\u05d5 \u05de\u05ea\u05e7\u05d9\u05d9\u05dd \u05d1\u05de\u05e7\u05e8\u05d4 \u05d6\u05d4 (Dulcan p.1063)."
        },
        {
          "text": "\u05d0\u05d9\u05d5\u05dd \u05d4\u05d3\u05d5\u05e8\u05e9 \u05d4\u05e9\u05e2\u05d9\u05d4 \u05de\u05d9\u05d9\u05d3\u05d9\u05ea \u05d5\u05d3\u05d9\u05d5\u05d5\u05d7 \u05dc\u05de\u05e9\u05d8\u05e8\u05d4 \u05dc\u05dc\u05d0 \u05d4\u05e2\u05e8\u05db\u05d4 \u05e0\u05d5\u05e1\u05e4\u05ea.",
          "isCorrect": false,
          "rationale": "\u05d4\u05e4\u05e8\u05d5\u05d8\u05d5\u05e7\u05d5\u05dc \u05de\u05de\u05dc\u05d9\u05e5 \u05dc\u05e4\u05ea\u05d5\u05e8 \u05d0\u05d9\u05d5\u05de\u05d9\u05dd \u05d7\u05d5\u05dc\u05e4\u05d9\u05dd \u05dc\u05dc\u05d0 \u05e6\u05e2\u05d3\u05d9 \u05e2\u05e0\u05d9\u05e9\u05d4 \u05e7\u05d9\u05e6\u05d5\u05e0\u05d9\u05d9\u05dd \u05e9\u05e2\u05dc\u05d5\u05dc\u05d9\u05dd \u05dc\u05d4\u05d7\u05de\u05d9\u05e8 \u05d0\u05ea \u05d4\u05de\u05e6\u05d1 (Dulcan p.1063)."
        }
      ],
      "hint": "\u05d1\u05d7\u05df \u05d0\u05ea \u05d4\u05db\u05d5\u05d5\u05e0\u05d4 (Intent) \u05d5\u05d0\u05ea \u05d4\u05d9\u05db\u05d5\u05dc\u05ea \u05e9\u05dc \u05d4\u05ea\u05dc\u05de\u05d9\u05d3 \u05dc\u05d7\u05d6\u05d5\u05e8 \u05d1\u05d5 \u05de\u05d4\u05d0\u05de\u05d9\u05e8\u05d4.",
      "imageUrls": []
    },
    {
      "type": "short_answer",
      "question": "\u05ea\u05d0\u05e8 \u05d0\u05ea \u05d4\u05d4\u05d1\u05d3\u05dc \u05d4\u05e2\u05d9\u05e7\u05e8\u05d9 \u05d1\u05d9\u05df \u05ea\u05d5\u05db\u05e0\u05d9\u05ea '\u05e1\u05e2\u05d9\u05e3 504' (Section 504) \u05dc\u05d1\u05d9\u05df '\u05ea\u05d5\u05db\u05e0\u05d9\u05ea \u05d7\u05d9\u05e0\u05d5\u05db\u05d9\u05ea \u05d0\u05d9\u05e9\u05d9\u05ea' (IEP) \u05ea\u05d7\u05ea \u05d7\u05d5\u05e7 IDEA \u05d1\u05db\u05dc \u05d4\u05e0\u05d5\u05d2\u05e2 \u05dc\u05d4\u05ea\u05d0\u05de\u05d5\u05ea \u05d5\u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd \u05d1\u05ea\u05d5\u05db\u05e0\u05d9\u05ea \u05d4\u05dc\u05d9\u05de\u05d5\u05d3\u05d9\u05dd.",
      "grading": {
        "modelAnswer": "\u05ea\u05d5\u05db\u05e0\u05d9\u05ea 504 \u05de\u05e1\u05e4\u05e7\u05ea \u05d4\u05ea\u05d0\u05de\u05d5\u05ea \u05e0\u05d2\u05d9\u05e9\u05d5\u05ea (Accommodations) \u05d1\u05dc\u05d1\u05d3 \u05de\u05d1\u05dc\u05d9 \u05dc\u05e9\u05e0\u05d5\u05ea \u05d0\u05ea \u05d4\u05e1\u05d8\u05e0\u05d3\u05e8\u05d8\u05d9\u05dd \u05d4\u05d0\u05e7\u05d3\u05de\u05d9\u05d9\u05dd, \u05d1\u05e2\u05d5\u05d3 \u05e9-IEP \u05de\u05d0\u05e4\u05e9\u05e8\u05ea \u05d2\u05dd \u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd (Modifications) \u05d1\u05ea\u05d5\u05db\u05e0\u05d9\u05ea \u05d4\u05dc\u05d9\u05de\u05d5\u05d3\u05d9\u05dd \u05d5\u05d1\u05d3\u05e8\u05d9\u05e9\u05d5\u05ea \u05d4\u05d0\u05e7\u05d3\u05de\u05d9\u05d5\u05ea \u05e2\u05dc \u05de\u05e0\u05ea \u05dc\u05d4\u05ea\u05d0\u05d9\u05de\u05df \u05dc\u05de\u05d5\u05d2\u05d1\u05dc\u05d5\u05ea \u05d4\u05d9\u05dc\u05d3.",
        "rationale": "\u05d4\u05d4\u05d1\u05d7\u05e0\u05d4 \u05d1\u05d9\u05df \u05d4\u05e0\u05d2\u05e9\u05d4 \u05dc\u05d1\u05d9\u05df \u05e9\u05d9\u05e0\u05d5\u05d9 \u05de\u05d4\u05d5\u05ea\u05d9 \u05d1\u05d3\u05e8\u05d9\u05e9\u05d5\u05ea \u05d4\u05d9\u05d0 \u05dc\u05d1 \u05d4\u05d4\u05d1\u05d3\u05dc \u05d1\u05d9\u05df \u05d4\u05d7\u05d5\u05e7\u05d9\u05dd \u05d4\u05de\u05d2\u05e0\u05d9\u05dd \u05e2\u05dc \u05ea\u05dc\u05de\u05d9\u05d3\u05d9\u05dd \u05e2\u05dd \u05de\u05d5\u05d2\u05d1\u05dc\u05d5\u05d9\u05d5\u05ea (Dulcan p.1048-1049).",
        "requiredAttributes": [
          "\u05e6\u05d9\u05d5\u05df \u05e9\u05ea\u05d5\u05db\u05e0\u05d9\u05ea 504 \u05de\u05ea\u05de\u05e7\u05d3\u05ea \u05d1\u05d4\u05ea\u05d0\u05de\u05d5\u05ea/\u05d4\u05e0\u05d2\u05e9\u05d4 (Accommodations).",
          "\u05e6\u05d9\u05d5\u05df \u05e9-IEP \u05de\u05d0\u05e4\u05e9\u05e8\u05ea \u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd \u05d1\u05ea\u05d5\u05db\u05e0\u05d9\u05ea \u05d4\u05dc\u05d9\u05de\u05d5\u05d3\u05d9\u05dd (Modifications/Specialized Instruction).",
          "\u05d4\u05ea\u05d9\u05d9\u05d7\u05e1\u05d5\u05ea \u05dc\u05db\u05da \u05e9-504 \u05dc\u05d0 \u05de\u05d5\u05e8\u05d9\u05d3 \u05d0\u05ea \u05d4\u05e1\u05d8\u05e0\u05d3\u05e8\u05d8\u05d9\u05dd \u05d4\u05d0\u05e7\u05d3\u05de\u05d9\u05d9\u05dd."
        ],
