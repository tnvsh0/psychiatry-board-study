    {
      "type": "multiple_choice",
      "question": "\u05de\u05d3\u05d5\u05e2 \u05de\u05de\u05dc\u05d9\u05e5 Stahl (\u05d1\u05e1\u05e4\u05e8 StahlKids) \u05dc\u05d4\u05e2\u05d3\u05d9\u05e3 \u05de\u05ea\u05df \u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05e8\u05d5\u05e4\u05d9\u05d5\u05ea (\u05db\u05d2\u05d5\u05df Methylphenidate) \u05d1\u05d1\u05d9\u05ea \u05d5\u05dc\u05d0 \u05d1\u05de\u05e1\u05d2\u05e8\u05ea \u05d1\u05d9\u05ea \u05d4\u05e1\u05e4\u05e8, \u05db\u05db\u05dc \u05e9\u05d4\u05d3\u05d1\u05e8 \u05de\u05ea\u05d0\u05e4\u05e9\u05e8?",
      "answerOptions": [
        {
          "text": "\u05e2\u05dc \u05de\u05e0\u05ea \u05dc\u05de\u05e0\u05d5\u05e2 \u05e1\u05d8\u05d9\u05d2\u05de\u05d4 \u05d7\u05d1\u05e8\u05ea\u05d9\u05ea \u05d5\u05d4\u05e1\u05d8\u05d4 (Diversion) \u05e9\u05dc \u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 \u05dc\u05d9\u05d3\u05d9\u05d9\u05dd \u05d0\u05d7\u05e8\u05d5\u05ea.",
          "isCorrect": true,
          "rationale": "\u05e0\u05d8\u05d9\u05dc\u05ea \u05ea\u05e8\u05d5\u05e4\u05d4 \u05d1\u05d1\u05d9\u05ea \u05d4\u05e1\u05e4\u05e8 \u05e2\u05dc\u05d5\u05dc\u05d4 \u05dc\u05d7\u05e9\u05d5\u05e3 \u05d0\u05ea \u05d4\u05d9\u05dc\u05d3 \u05dc\u05e1\u05d8\u05d9\u05d2\u05de\u05d4, \u05d5\u05d1\u05de\u05e7\u05e8\u05d4 \u05e9\u05dc \u05de\u05de\u05e8\u05d9\u05e6\u05d9\u05dd, \u05e7\u05d9\u05d9\u05de\u05ea \u05e1\u05db\u05e0\u05d4 \u05e9\u05dc \u05d4\u05e2\u05d1\u05e8\u05ea \u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 \u05dc\u05ea\u05dc\u05de\u05d9\u05d3\u05d9\u05dd \u05d0\u05d7\u05e8\u05d9\u05dd (StahlKids p.46, p.447)."
        },
        {
          "text": "\u05de\u05e9\u05d5\u05dd \u05e9\u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05d0\u05dc\u05d5 \u05d9\u05e2\u05d9\u05dc\u05d5\u05ea \u05e8\u05e7 \u05d1\u05e1\u05d1\u05d9\u05d1\u05d4 \u05d1\u05d9\u05ea\u05d9\u05ea \u05e9\u05e7\u05d8\u05d4.",
          "isCorrect": false,
          "rationale": "\u05d9\u05e2\u05d9\u05dc\u05d5\u05ea \u05d4\u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05d0\u05d9\u05e0\u05d4 \u05ea\u05dc\u05d5\u05d9\u05d4 \u05d1\u05de\u05d9\u05e7\u05d5\u05dd \u05d4\u05e4\u05d9\u05d6\u05d9, \u05d0\u05da \u05d4\u05e0\u05d9\u05d4\u05d5\u05dc \u05d4\u05dc\u05d5\u05d2\u05d9\u05e1\u05d8\u05d9 \u05d5\u05d4\u05d7\u05d1\u05e8\u05ea\u05d9 \u05e2\u05d3\u05d9\u05e3 \u05d1\u05d1\u05d9\u05ea (StahlKids p.46)."
        },
        {
          "text": "\u05db\u05d3\u05d9 \u05dc\u05d4\u05d1\u05d8\u05d9\u05d7 \u05e9\u05d4\u05de\u05d5\u05e8\u05d4 \u05dc\u05d0 \u05d9\u05d5\u05db\u05dc \u05dc\u05e0\u05d8\u05e8 \u05d0\u05ea \u05ea\u05d5\u05e4\u05e2\u05d5\u05ea \u05d4\u05dc\u05d5\u05d5\u05d0\u05d9 \u05e9\u05dc \u05d4\u05ea\u05e8\u05d5\u05e4\u05d4.",
          "isCorrect": false,
