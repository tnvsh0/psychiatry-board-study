{
  "title": "SLD Flashcards",
  "cards": [
    {
      "front": "\u05de\u05d4\u05d5 \u05de\u05e9\u05da \u05d4\u05d6\u05de\u05df \u05d4\u05de\u05d9\u05e0\u05d9\u05de\u05dc\u05d9 \u05d4\u05e0\u05d3\u05e8\u05e9 \u05dc\u05d4\u05d5\u05e4\u05e2\u05ea \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05dc\u05e6\u05d5\u05e8\u05da \u05d0\u05d1\u05d7\u05e0\u05ea Specific Learning Disorder (SLD), \u05dc\u05de\u05e8\u05d5\u05ea \u05de\u05ea\u05df \u05d4\u05ea\u05e2\u05e8\u05d1\u05d5\u05d9\u05d5\u05ea \u05de\u05de\u05d5\u05e7\u05d3\u05d5\u05ea?",
      "back": "\u05dc\u05e4\u05d7\u05d5\u05ea 6 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd (DSM p.77)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05d4\u05d1\u05d3\u05dc \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05d1\u05d9\u05df SLD \u05dc\u05d1\u05d9\u05df Intellectual Developmental Disorder (IDD) \u05de\u05d1\u05d7\u05d9\u05e0\u05ea \u05e8\u05de\u05ea \u05d4-$IQ$?",
      "back": "\u05d1-SLD \u05e8\u05de\u05ea \u05d4\u05de\u05e9\u05db\u05dc \u05ea\u05e7\u05d9\u05e0\u05d4 (\u05dc\u05e8\u05d5\u05d1 $IQ \\ge 70 \\pm 5$), \u05d1\u05e2\u05d5\u05d3 \u05d1-IDD \u05d9\u05e9 \u05dc\u05d9\u05e7\u05d5\u05d9\u05d9\u05dd \u05d0\u05d9\u05e0\u05d8\u05dc\u05e7\u05d8\u05d5\u05d0\u05dc\u05d9\u05dd \u05d2\u05dc\u05d5\u05d1\u05dc\u05d9\u05d9\u05dd (DSM p.79)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05d9\u05d7\u05e1 \u05d4\u05e9\u05db\u05d9\u05d7 \u05d1\u05d9\u05df \u05d1\u05e0\u05d9\u05dd \u05dc\u05d1\u05e0\u05d5\u05ea \u05d1\u05d0\u05d1\u05d7\u05e0\u05ea Specific Learning Disorder?",
      "back": "\u05d9\u05d7\u05e1 \u05e9\u05dc $2:1$ \u05e2\u05d3 $3:1$ \u05dc\u05d8\u05d5\u05d1\u05ea \u05d6\u05db\u05e8\u05d9\u05dd (DSM p.83)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05d4\u05d9\u05d7\u05e1\u05d9 (Relative Risk) \u05dc\u05d4\u05d5\u05e4\u05e2\u05ea \u05dc\u05e7\u05d5\u05ea \u05e7\u05e8\u05d9\u05d0\u05d4 \u05d1\u05e7\u05e8\u05d1 \u05e7\u05e8\u05d5\u05d1\u05d9 \u05de\u05e9\u05e4\u05d7\u05d4 \u05de\u05d3\u05e8\u05d2\u05d4 \u05e8\u05d0\u05e9\u05d5\u05e0\u05d4 \u05e9\u05dc \u05d0\u05d3\u05dd \u05e2\u05dd \u05d3\u05d9\u05e1\u05dc\u05e7\u05e1\u05d9\u05d4?",
      "back": "\u05e1\u05d9\u05db\u05d5\u05df \u05d2\u05d1\u05d5\u05d4 \u05e4\u05d9 4 \u05e2\u05d3 8 (DSM p.82)."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05de\u05d5\u05d2\u05d3\u05e8\u05ea \u05e8\u05de\u05ea \u05d7\u05d5\u05de\u05e8\u05d4 Moderate \u05d1-SLD \u05de\u05d1\u05d7\u05d9\u05e0\u05ea \u05d4\u05e6\u05d5\u05e8\u05da \u05d1\u05ea\u05de\u05d9\u05db\u05d4 \u05d1\u05d1\u05d9\u05ea \u05d4\u05e1\u05e4\u05e8?",
      "back": "\u05e0\u05d3\u05e8\u05e9\u05d5\u05ea \u05d4\u05ea\u05d0\u05de\u05d5\u05ea \u05d0\u05d5 \u05e9\u05d9\u05e8\u05d5\u05ea\u05d9 \u05ea\u05de\u05d9\u05db\u05d4 \u05dc\u05e4\u05d7\u05d5\u05ea \u05d7\u05dc\u05e7 \u05de\u05d4\u05d9\u05d5\u05dd \u05db\u05d3\u05d9 \u05dc\u05d4\u05e9\u05dc\u05d9\u05dd \u05de\u05e9\u05d9\u05de\u05d5\u05ea \u05d1\u05d9\u05e2\u05d9\u05dc\u05d5\u05ea (DSM p.78)."
    },
    {
      "front": "\u05de\u05d4\u05dd \u05e9\u05dc\u05d5\u05e9\u05ea \u05ea\u05d7\u05d5\u05de\u05d9 \u05d4\u05dc\u05d9\u05e7\u05d5\u05d9 \u05d4\u05d0\u05e7\u05d3\u05de\u05d9\u05d9\u05dd \u05e9\u05e0\u05d9\u05ea\u05df \u05dc\u05e6\u05d9\u05d9\u05df \u05db\u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05d9\u05e8\u05e1 (Specifiers) \u05ea\u05d7\u05ea \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc SLD?",
      "back": "\u05dc\u05d9\u05e7\u05d5\u05d9 \u05d1\u05e7\u05e8\u05d9\u05d0\u05d4 (Reading), \u05dc\u05d9\u05e7\u05d5\u05d9 \u05d1\u05d1\u05d9\u05d8\u05d5\u05d9 \u05d1\u05db\u05ea\u05d1 (Written expression), \u05d5\u05dc\u05d9\u05e7\u05d5\u05d9 \u05d1\u05de\u05ea\u05de\u05d8\u05d9\u05e7\u05d4 (Mathematics) (DSM p.78)."
    },
    {
      "front": "\u05dc\u05e4\u05d9 Criterion C \u05e9\u05dc \u05d4-DSM-5-TR, \u05de\u05ea\u05d9 \u05d7\u05d9\u05d9\u05d1\u05d9\u05dd \u05dc\u05d4\u05d5\u05e4\u05d9\u05e2 \u05dc\u05e8\u05d0\u05e9\u05d5\u05e0\u05d4 \u05e7\u05e9\u05d9\u05d9 \u05d4\u05dc\u05de\u05d9\u05d3\u05d4 \u05d1-SLD?",
      "back": "\u05d1\u05de\u05d4\u05dc\u05da \u05e9\u05e0\u05d5\u05ea \u05d1\u05d9\u05ea \u05d4\u05e1\u05e4\u05e8 (Developmental period), \u05d2\u05dd \u05d0\u05dd \u05d4\u05d1\u05d9\u05d8\u05d5\u05d9 \u05d4\u05de\u05dc\u05d0 \u05de\u05d5\u05e4\u05d9\u05e2 \u05e8\u05e7 \u05db\u05e9\u05d4\u05d3\u05e8\u05d9\u05e9\u05d5\u05ea \u05e2\u05d5\u05dc\u05d5\u05ea \u05e2\u05dc \u05d4\u05d9\u05db\u05d5\u05dc\u05d5\u05ea (DSM p.77)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d4\u05de\u05d5\u05e2\u05e8\u05db\u05ea \u05e9\u05dc SLD \u05d1\u05e7\u05e8\u05d1 \u05d9\u05dc\u05d3\u05d9\u05dd \u05d1\u05d2\u05d9\u05dc \u05d1\u05d9\u05ea \u05d4\u05e1\u05e4\u05e8 \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR?",
      "back": "\u05d1\u05d9\u05df 5% \u05dc-15% (DSM p.81)."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05e0\u05d9\u05ea\u05df \u05dc\u05d4\u05d1\u05d3\u05d9\u05dc \u05d1\u05d9\u05df \u05d7\u05d5\u05e1\u05e8 \u05e7\u05e9\u05d1 \u05d1-ADHD \u05dc\u05d1\u05d9\u05df \u05d7\u05d5\u05e1\u05e8 \u05e7\u05e9\u05d1 \u05d4\u05e0\u05d5\u05d1\u05e2 \u05de-SLD?",
      "back": "\u05d1-SLD \u05d7\u05d5\u05e1\u05e8 \u05d4\u05e7\u05e9\u05d1 \u05de\u05d5\u05e4\u05d9\u05e2 \u05d1\u05e2\u05d9\u05e7\u05e8 \u05d1\u05de\u05e9\u05d9\u05de\u05d5\u05ea \u05d4\u05d3\u05d5\u05e8\u05e9\u05d5\u05ea \u05d0\u05ea \u05d4\u05de\u05d9\u05d5\u05de\u05e0\u05d5\u05ea \u05d4\u05dc\u05e7\u05d5\u05d9\u05d4 \u05d5\u05e4\u05d5\u05d7\u05ea \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05d1\u05de\u05d8\u05dc\u05d5\u05ea \u05d0\u05d7\u05e8\u05d5\u05ea (DSM p.74)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d0\u05d5\u05de\u05d3\u05df \u05d4\u05ea\u05d5\u05e8\u05e9\u05ea\u05d9\u05d5\u05ea (Heritability estimate) \u05e2\u05d1\u05d5\u05e8 \u05d9\u05db\u05d5\u05dc\u05d5\u05ea \u05e7\u05e8\u05d9\u05d0\u05d4 \u05d5\u05dc\u05e7\u05d5\u05d9\u05d5\u05ea \u05e7\u05e8\u05d9\u05d0\u05d4 \u05dc\u05e4\u05d9 \u05de\u05d7\u05e7\u05e8\u05d9 \u05ea\u05d0\u05d5\u05de\u05d9\u05dd?",
      "back": "\u05d2\u05d1\u05d5\u05d4 \u05de-0.6 (DSM p.83)."
    },
    {
      "front": "\u05d4\u05de\u05d5\u05e0\u05d7 _____ \u05de\u05e9\u05de\u05e9 \u05db\u05d7\u05dc\u05d5\u05e4\u05d4 \u05dc\u05ea\u05d9\u05d0\u05d5\u05e8 \u05d3\u05e4\u05d5\u05e1 \u05e7\u05e9\u05d9\u05d9\u05dd \u05d4\u05db\u05d5\u05dc\u05dc \u05d1\u05e2\u05d9\u05d5\u05ea \u05d1\u05d6\u05d9\u05d4\u05d5\u05d9 \u05de\u05d9\u05dc\u05d9\u05dd \u05de\u05d3\u05d5\u05d9\u05e7, \u05d3\u05d4-\u05e7\u05d5\u05d3\u05d9\u05e0\u05d2 (Decoding) \u05d5\u05d9\u05db\u05d5\u05dc\u05d5\u05ea \u05d0\u05d9\u05d5\u05ea \u05d7\u05dc\u05e9\u05d5\u05ea.",
      "back": "Dyslexia (DSM p.78)."
    },
    {
      "front": "\u05de\u05d4 \u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05e7\u05e9\u05d9\u05d9\u05dd \u05d0\u05e7\u05d3\u05de\u05d9\u05d9\u05dd \u05d1-Borderline Intellectual Functioning ($IQ$ \u05e9\u05dc 71-84) \u05dc\u05e2\u05d5\u05de\u05ea SLD?",
      "back": "\u05d4\u05e7\u05e9\u05d9\u05d9\u05dd \u05ea\u05d5\u05d0\u05de\u05d9\u05dd \u05d0\u05ea \u05d4\u05d9\u05db\u05d5\u05dc\u05ea \u05d4\u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9\u05ea \u05d4\u05db\u05dc\u05dc\u05d9\u05ea \u05dc\u05dc\u05d0 \"\u05d7\u05d5\u05e1\u05e8 \u05e6\u05e4\u05d9\u05d5\u05ea\" (Unexpectedness) \u05d0\u05e7\u05d3\u05de\u05d9 \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9 (DSM p.836)."
    },
    {
      "front": "\u05de\u05d4\u05df \u05e9\u05ea\u05d9 \u05d4\u05d3\u05e8\u05db\u05d9\u05dd \u05d4\u05e0\u05d3\u05e8\u05e9\u05d5\u05ea \u05dc\u05e4\u05d9 Criterion B \u05dc\u05d0\u05d9\u05e9\u05d5\u05e8 \u05e9\u05d4\u05de\u05d9\u05d5\u05de\u05e0\u05d5\u05d9\u05d5\u05ea \u05d4\u05d0\u05e7\u05d3\u05de\u05d9\u05d5\u05ea \u05e0\u05de\u05d5\u05db\u05d5\u05ea \u05de\u05d4\u05de\u05e6\u05d5\u05e4\u05d4 \u05dc\u05d2\u05d9\u05dc?",
      "back": "\u05de\u05d1\u05d7\u05e0\u05d9 \u05d4\u05d9\u05e9\u05d2\u05d9\u05dd \u05e1\u05d8\u05e0\u05d3\u05e8\u05d8\u05d9\u05d9\u05dd (Standardized achievement measures) \u05d5\u05d4\u05e2\u05e8\u05db\u05d4 \u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05de\u05e7\u05d9\u05e4\u05d4 (DSM p.77)."
    },
    {
      "front": "\u05d0\u05d9\u05dc\u05d5 \u05d2\u05d5\u05e8\u05de\u05d9\u05dd \u05e1\u05d1\u05d9\u05d1\u05ea\u05d9\u05d9\u05dd \u05d0\u05d5 \u05e4\u05e8\u05d9\u05e0\u05d8\u05dc\u05d9\u05d9\u05dd \u05de\u05e6\u05d5\u05d9\u05e0\u05d9\u05dd \u05d1-DSM-5-TR \u05db\u05d2\u05d5\u05e8\u05de\u05d9 \u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea SLD?",
      "back": "\u05dc\u05d9\u05d3\u05d4 \u05de\u05d5\u05e7\u05d3\u05de\u05ea (Preterm delivery) \u05d0\u05d5 \u05de\u05e9\u05e7\u05dc \u05dc\u05d9\u05d3\u05d4 \u05e0\u05de\u05d5\u05da \u05de\u05d0\u05d5\u05d3 (DSM p.83)."
    },
    {
      "front": "\u05d1\u05d0\u05d9\u05d6\u05d5 \u05d4\u05e4\u05e8\u05e2\u05d4 \u05e0\u05d5\u05d9\u05e8\u05d5-\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9\u05ea \u05e9\u05db\u05d9\u05d7 \u05de\u05d0\u05d5\u05d3 \u05dc\u05de\u05e6\u05d5\u05d0 \u05dc\u05d9\u05e7\u05d5\u05d9 \u05e0\u05dc\u05d5\u05d5\u05d4 \u05d1\u05d1\u05d9\u05d8\u05d5\u05d9 \u05d1\u05db\u05ea\u05d1 (Written expression) \u05dc\u05e4\u05d9 \u05de\u05d7\u05e7\u05e8\u05d9 \u05e2\u05d5\u05e7\u05d1\u05d4?",
      "back": "ADHD (Dulcan p.167)."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05de\u05d5\u05d2\u05d3\u05e8\u05ea \u05e8\u05de\u05ea \u05d7\u05d5\u05de\u05e8\u05d4 Severe \u05d1-SLD \u05de\u05d1\u05d7\u05d9\u05e0\u05ea \u05e4\u05d5\u05d8\u05e0\u05e6\u05d9\u05d0\u05dc \u05e8\u05db\u05d9\u05e9\u05ea \u05d4\u05de\u05d9\u05d5\u05de\u05e0\u05d5\u05d9\u05d5\u05ea \u05dc\u05dc\u05d0 \u05d4\u05d5\u05e8\u05d0\u05d4 \u05de\u05ea\u05de\u05d7\u05d4?",
      "back": "\u05d4\u05e4\u05e8\u05d8 \u05dc\u05d0 \u05e6\u05e4\u05d5\u05d9 \u05dc\u05e8\u05db\u05d5\u05e9 \u05d0\u05ea \u05d4\u05de\u05d9\u05d5\u05de\u05e0\u05d5\u05d9\u05d5\u05ea \u05dc\u05dc\u05d0 \u05d4\u05d5\u05e8\u05d0\u05d4 \u05d0\u05d9\u05e0\u05d3\u05d9\u05d1\u05d9\u05d3\u05d5\u05d0\u05dc\u05d9\u05ea, \u05d0\u05d9\u05e0\u05d8\u05e0\u05e1\u05d9\u05d1\u05d9\u05ea \u05d5\u05de\u05ea\u05de\u05d7\u05d4 \u05d1\u05de\u05e9\u05da \u05e8\u05d5\u05d1 \u05e9\u05e0\u05d5\u05ea \u05d1\u05d9\u05ea \u05d4\u05e1\u05e4\u05e8 (DSM p.78)."
    },
    {
      "front": "\u05de\u05d4 \u05e0\u05d9\u05ea\u05df \u05dc\u05d4\u05d7\u05dc\u05d9\u05e3 \u05d1\u05de\u05e7\u05d5\u05dd \u05de\u05d1\u05d7\u05e0\u05d9\u05dd \u05e1\u05d8\u05e0\u05d3\u05e8\u05d8\u05d9\u05d9\u05dd \u05dc\u05e6\u05d5\u05e8\u05da \u05d0\u05d1\u05d7\u05e0\u05ea SLD \u05d1\u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd \u05de\u05e2\u05dc \u05d2\u05d9\u05dc 17?",
      "back": "\u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4 \u05de\u05ea\u05d5\u05e2\u05d3\u05ea \u05e9\u05dc \u05e7\u05e9\u05d9\u05d9 \u05dc\u05de\u05d9\u05d3\u05d4 \u05d4\u05e4\u05d5\u05d2\u05e2\u05d9\u05dd \u05d1\u05ea\u05e4\u05e7\u05d5\u05d3 (DSM p.77)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05de\u05d5\u05e0\u05d7 \u05d4\u05d7\u05dc\u05d5\u05e4\u05d9 \u05d4\u05de\u05ea\u05d0\u05e8 \u05e7\u05e9\u05d9\u05d9\u05dd \u05d1\u05e2\u05d9\u05d1\u05d5\u05d3 \u05de\u05d9\u05d3\u05e2 \u05de\u05e1\u05e4\u05e8\u05d9, \u05dc\u05de\u05d9\u05d3\u05ea \u05e2\u05d5\u05d1\u05d3\u05d5\u05ea \u05d0\u05e8\u05d9\u05ea\u05de\u05d8\u05d9\u05d5\u05ea \u05d5\u05d1\u05d9\u05e6\u05d5\u05e2 \u05d7\u05d9\u05e9\u05d5\u05d1\u05d9\u05dd \u05de\u05d3\u05d5\u05d9\u05e7\u05d9\u05dd?",
      "back": "Dyscalculia (DSM p.78)."
    },
