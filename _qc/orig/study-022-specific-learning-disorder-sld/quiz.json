        }
      ],
      "hint": "\u05e2\u05d9\u05d9\u05df \u05d1\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df A \u05e9\u05dc \u05d4\u05e4\u05e8\u05e2\u05ea \u05dc\u05de\u05d9\u05d3\u05d4 \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05ea \u05d1-DSM-5-TR."
    },
    {
      "question": "\u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05e2\u05e8\u05db\u05ea \u05d9\u05dc\u05d3\u05d4 \u05e2\u05dd \u05e7\u05e9\u05d9\u05d9\u05dd \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05d9\u05dd \u05d1\u05de\u05ea\u05de\u05d8\u05d9\u05e7\u05d4 (Number sense), \u05e0\u05de\u05e6\u05d0 \u05db\u05d9 \u05de\u05e0\u05ea \u05d4\u05de\u05e9\u05db\u05dc (IQ) \u05e9\u05dc\u05d4 \u05d4\u05d9\u05d0 65. \u05d0\u05d9\u05d6\u05d4 \u05de\u05d4\u05de\u05e9\u05e4\u05d8\u05d9\u05dd \u05d4\u05d1\u05d0\u05d9\u05dd \u05de\u05ea\u05d0\u05e8 \u05d1\u05e6\u05d5\u05e8\u05d4 \u05d4\u05de\u05d3\u05d5\u05d9\u05e7\u05ea \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d0\u05ea \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05de\u05d1\u05d3\u05dc\u05ea \u05d1\u05d9\u05df Specific Learning Disorder \u05dc\u05d1\u05d9\u05df Intellectual Developmental Disorder (IDD)?",
      "answerOptions": [
        {
          "text": "\u05dc\u05d0 \u05e0\u05d9\u05ea\u05df \u05dc\u05d0\u05d1\u05d7\u05df Specific Learning Disorder \u05d0\u05dd \u05d4-IQ \u05e0\u05de\u05d5\u05da \u05de-85.",
          "isCorrect": false,
          "rationale": "\u05d4\u05e1\u05e3 \u05d4\u05de\u05e7\u05d5\u05d1\u05dc \u05dc\u05ea\u05e4\u05e7\u05d5\u05d3 \u05d0\u05d9\u05e0\u05d8\u05dc\u05e7\u05d8\u05d5\u05d0\u05dc\u05d9 \u05ea\u05e7\u05d9\u05df \u05d1\u05d4\u05e7\u05e9\u05e8 \u05e9\u05dc SLD \u05d4\u05d5\u05d0 \u05e1\u05d1\u05d9\u05d1 $70 \\pm 5$ (DSM p.79-80)."
        },
        {
          "text": "\u05d1-Specific Learning Disorder, \u05e8\u05de\u05ea \u05d4\u05d0\u05d9\u05e0\u05d8\u05dc\u05d9\u05d2\u05e0\u05e6\u05d9\u05d4 \u05d4\u05db\u05dc\u05dc\u05d9\u05ea \u05e6\u05e4\u05d5\u05d9\u05d4 \u05dc\u05d4\u05d9\u05d5\u05ea \u05ea\u05e7\u05d9\u05e0\u05d4, \u05dc\u05e8\u05d5\u05d1 \u05de\u05e2\u05dc $70 \\pm 5$.",
          "isCorrect": true,
          "rationale": "SLD \u05de\u05d0\u05d5\u05e4\u05d9\u05d9\u05df \u05d1\u05e4\u05e2\u05e8 \u05d1\u05d9\u05df \u05d4\u05d9\u05e9\u05d2\u05d9\u05dd \u05d0\u05e7\u05d3\u05de\u05d9\u05d9\u05dd \u05dc\u05d1\u05d9\u05df \u05e8\u05de\u05ea \u05d0\u05d9\u05e0\u05d8\u05dc\u05d9\u05d2\u05e0\u05e6\u05d9\u05d4 \u05db\u05dc\u05dc\u05d9\u05ea \u05ea\u05e7\u05d9\u05e0\u05d4, \u05d1\u05e2\u05d5\u05d3 \u05e9-IDD \u05de\u05d0\u05d5\u05e4\u05d9\u05d9\u05df \u05d1\u05dc\u05d9\u05e7\u05d5\u05d9\u05d9\u05dd \u05d0\u05d9\u05e0\u05d8\u05dc\u05e7\u05d8\u05d5\u05d0\u05dc\u05d9\u05d9\u05dd \u05d5\u05d0\u05d3\u05e4\u05d8\u05d9\u05d1\u05d9\u05d9\u05dd \u05db\u05dc\u05dc\u05d9\u05d9\u05dd (DSM p.79-80, 84)."
        },
        {
          "text": "\u05d0\u05dd \u05e7\u05d9\u05d9\u05dd IDD, \u05dc\u05d0 \u05e0\u05d9\u05ea\u05df \u05dc\u05d0\u05d1\u05d7\u05df \u05d1\u05de\u05e7\u05d1\u05d9\u05dc Specific Learning Disorder \u05d1\u05e9\u05d5\u05dd \u05de\u05e7\u05e8\u05d4.",
          "isCorrect": false,
          "rationale": "\u05e0\u05d9\u05ea\u05df \u05dc\u05d0\u05d1\u05d7\u05df \u05d0\u05ea \u05e9\u05ea\u05d9\u05d4\u05df \u05db-comorbidity \u05d0\u05dd \u05e7\u05e9\u05d9\u05d9 \u05d4\u05dc\u05de\u05d9\u05d3\u05d4 \u05d7\u05d5\u05e8\u05d2\u05d9\u05dd \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05de\u05d0\u05dc\u05d5 \u05d4\u05de\u05e6\u05d5\u05e4\u05d9\u05dd \u05dc\u05e8\u05de\u05ea \u05d4-IDD (DSM p.84)."
        },
        {
          "text": "\u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc Specific Learning Disorder \u05de\u05d1\u05d5\u05e1\u05e1\u05ea \u05d0\u05da \u05d5\u05e8\u05e7 \u05e2\u05dc \u05de\u05d1\u05d7\u05e0\u05d9 \u05d4\u05d9\u05e9\u05d2\u05d9\u05dd \u05dc\u05dc\u05d0 \u05e7\u05e9\u05e8 \u05dc-IQ.",
          "isCorrect": false,
          "rationale": "\u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d3\u05d5\u05e8\u05e9\u05ea \u05e9\u05dc\u05d9\u05dc\u05d4 \u05e9\u05dc IDD \u05db\u05d4\u05e1\u05d1\u05e8 \u05d8\u05d5\u05d1 \u05d9\u05d5\u05ea\u05e8 \u05dc\u05e7\u05e9\u05d9\u05d9 \u05d4\u05dc\u05de\u05d9\u05d3\u05d4 (DSM p.77)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05d2\u05d3\u05e8\u05ea \u05d4-IQ \u05d4\u05de\u05d9\u05e0\u05d9\u05de\u05dc\u05d9 \u05d4\u05e0\u05d3\u05e8\u05e9 \u05db\u05d3\u05d9 \u05e9\u05e7\u05e9\u05d9\u05d9 \u05dc\u05de\u05d9\u05d3\u05d4 \u05d9\u05d9\u05d7\u05e9\u05d1\u05d5 \u05db'\u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05d9\u05dd'."
    },
    {
      "question": "\u05e0\u05e2\u05e8\u05d4 \u05d1\u05ea 15 \u05e2\u05dd \u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc Specific Learning Disorder with impairment in reading \u05de\u05e6\u05d9\u05d2\u05d4 \u05e8\u05de\u05ea \u05d7\u05d5\u05de\u05e8\u05d4 \u05e9\u05d1\u05d4 \u05d4\u05d9\u05d0 \u05d6\u05e7\u05d5\u05e7\u05d4 \u05dc\u05d4\u05d5\u05e8\u05d0\u05d4 \u05d0\u05d9\u05e0\u05d8\u05e0\u05e1\u05d9\u05d1\u05d9\u05ea \u05d5\u05de\u05e7\u05e6\u05d5\u05e2\u05d9\u05ea \u05dc\u05e4\u05d7\u05d5\u05ea \u05d1\u05d7\u05dc\u05e7 \u05de\u05d9\u05d5\u05dd \u05d4\u05dc\u05d9\u05de\u05d5\u05d3\u05d9\u05dd, \u05d5\u05e0\u05d3\u05e8\u05e9\u05d5\u05ea \u05dc\u05d4 \u05d4\u05ea\u05d0\u05de\u05d5\u05ea \u05d1\u05de\u05e7\u05d5\u05dd \u05d4\u05e2\u05d1\u05d5\u05d3\u05d4 \u05d4\u05e2\u05ea\u05d9\u05d3\u05d9 \u05db\u05d3\u05d9 \u05dc\u05d4\u05e9\u05dc\u05d9\u05dd \u05de\u05e9\u05d9\u05de\u05d5\u05ea \u05d1\u05d9\u05e2\u05d9\u05dc\u05d5\u05ea. \u05dc\u05d0\u05d9\u05d6\u05d5 \u05e8\u05de\u05ea \u05d7\u05d5\u05de\u05e8\u05d4 (Severity) \u05d4\u05d3\u05d1\u05e8 \u05de\u05ea\u05d0\u05d9\u05dd?",
      "answerOptions": [
        {
          "text": "Mild",
          "isCorrect": false,
          "rationale": "\u05d1\u05e8\u05de\u05ea Mild, \u05d4\u05e4\u05e8\u05d8 \u05dc\u05e8\u05d5\u05d1 \u05de\u05e1\u05d5\u05d2\u05dc \u05dc\u05e4\u05e6\u05d5\u05ea \u05e2\u05dc \u05d4\u05e7\u05e9\u05d9\u05d9\u05dd \u05d0\u05d5 \u05dc\u05ea\u05e4\u05e7\u05d3 \u05d4\u05d9\u05d8\u05d1 \u05e2\u05dd \u05ea\u05de\u05d9\u05db\u05d4 \u05de\u05d5\u05e2\u05d8\u05d4 \u05d1\u05dc\u05d1\u05d3 (DSM p.78)."
        },
        {
          "text": "Moderate",
          "isCorrect": true,
          "rationale": "\u05e8\u05de\u05ea Moderate \u05de\u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05ea \u05d1\u05e7\u05e9\u05d9\u05d9\u05dd \u05d1\u05d5\u05dc\u05d8\u05d9\u05dd \u05d4\u05d3\u05d5\u05e8\u05e9\u05d9\u05dd \u05d4\u05d5\u05e8\u05d0\u05d4 \u05d0\u05d9\u05e0\u05d8\u05e0\u05e1\u05d9\u05d1\u05d9\u05ea \u05d5\u05de\u05ea\u05de\u05d7\u05d4 \u05d5\u05db\u05df \u05d4\u05ea\u05d0\u05de\u05d5\u05ea \u05dc\u05e4\u05d7\u05d5\u05ea \u05d7\u05dc\u05e7 \u05de\u05d4\u05d9\u05d5\u05dd (DSM p.78)."
        },
        {
          "text": "Severe",
          "isCorrect": false,
          "rationale": "\u05e8\u05de\u05ea Severe \u05d3\u05d5\u05e8\u05e9\u05ea \u05d4\u05d5\u05e8\u05d0\u05d4 \u05d0\u05d9\u05e0\u05d3\u05d9\u05d1\u05d9\u05d3\u05d5\u05d0\u05dc\u05d9\u05ea \u05d5\u05d0\u05d9\u05e0\u05d8\u05e0\u05e1\u05d9\u05d1\u05d9\u05ea \u05dc\u05d0\u05d5\u05e8\u05da \u05e8\u05d5\u05d1 \u05e9\u05e0\u05d5\u05ea \u05d1\u05d9\u05ea \u05d4\u05e1\u05e4\u05e8, \u05d5\u05dc\u05e8\u05d5\u05d1 \u05d4\u05e4\u05e8\u05d8 \u05dc\u05d0 \u05d9\u05e6\u05dc\u05d9\u05d7 \u05dc\u05d4\u05e9\u05dc\u05d9\u05dd \u05d0\u05ea \u05db\u05dc \u05d4\u05e4\u05e2\u05d9\u05dc\u05d5\u05d9\u05d5\u05ea \u05d1\u05d9\u05e2\u05d9\u05dc\u05d5\u05ea \u05d2\u05dd \u05e2\u05dd \u05d4\u05ea\u05d0\u05de\u05d5\u05ea (DSM p.78)."
        },
        {
          "text": "Profound",
          "isCorrect": false,
          "rationale": "\u05de\u05d5\u05e0\u05d7 \u05d6\u05d4 \u05de\u05e9\u05de\u05e9 \u05dc\u05ea\u05d9\u05d0\u05d5\u05e8 \u05e8\u05de\u05d5\u05ea \u05d7\u05d5\u05de\u05e8\u05d4 \u05d1-IDD \u05d0\u05da \u05d0\u05d9\u05e0\u05d5 \u05d7\u05dc\u05e7 \u05de\u05d4\u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05d9\u05e8\u05d9\u05dd \u05e9\u05dc SLD \u05d1-DSM-5-TR (DSM p.78)."
        }
      ],
      "hint": "\u05e8\u05de\u05d4 \u05d6\u05d5 \u05e0\u05de\u05e6\u05d0\u05ea \u05d1\u05d9\u05df \u05d4\u05e6\u05d5\u05e8\u05da \u05d1\u05e4\u05d9\u05e6\u05d5\u05d9 \u05e2\u05e6\u05de\u05d9 \u05dc\u05d1\u05d9\u05df \u05d7\u05d5\u05e1\u05e8 \u05d9\u05db\u05d5\u05dc\u05ea \u05dc\u05d4\u05e9\u05dc\u05d9\u05dd \u05de\u05e9\u05d9\u05de\u05d5\u05ea \u05d1\u05d9\u05e2\u05d9\u05dc\u05d5\u05ea."
    },
    {
      "question": "\u05de\u05d7\u05e7\u05e8\u05d9\u05dd \u05d0\u05e4\u05d9\u05d3\u05de\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05d9\u05dd \u05de\u05e6\u05d1\u05d9\u05e2\u05d9\u05dd \u05e2\u05dc \u05d4\u05d1\u05d3\u05dc\u05d9\u05dd \u05de\u05d2\u05d3\u05e8\u05d9\u05d9\u05dd \u05d1\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05e9\u05dc Specific Learning Disorder. \u05de\u05d4\u05d5 \u05d4\u05d9\u05d7\u05e1 \u05d4\u05de\u05e7\u05d5\u05d1\u05dc \u05d1\u05d9\u05df \u05d6\u05db\u05e8\u05d9\u05dd \u05dc\u05e0\u05e7\u05d1\u05d5\u05ea \u05e2\u05dc \u05e4\u05d9 \u05d4-DSM-5-TR?",
