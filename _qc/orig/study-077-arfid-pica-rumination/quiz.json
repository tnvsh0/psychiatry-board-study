    {
      "type": "short_answer",
      "question": "\u05d4\u05e1\u05d1\u05e8 \u05de\u05d3\u05d5\u05e2 \u05e0\u05e9\u05d9\u05de\u05d4 \u05e1\u05e8\u05e2\u05e4\u05ea\u05d9\u05ea (Diaphragmatic Breathing) \u05e0\u05d7\u05e9\u05d1\u05ea \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05d1\u05d7\u05d9\u05e8\u05d4 \u05d1\u05d4\u05e4\u05e8\u05e2\u05ea Rumination Disorder \u05d5\u05db\u05d9\u05e6\u05d3 \u05d4\u05d9\u05d0 \u05e4\u05d5\u05e2\u05dc\u05ea \u05de\u05d1\u05d7\u05d9\u05e0\u05d4 \u05de\u05db\u05e0\u05d9\u05ea.",
      "grading": {
