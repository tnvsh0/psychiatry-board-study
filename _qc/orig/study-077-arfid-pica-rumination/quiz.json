    {
      "type": "multiple_choice",
      "question": "\u05e0\u05e2\u05e8\u05d4 \u05d1\u05ea 13 \u05de\u05d5\u05d1\u05d0\u05ea \u05dc\u05d4\u05e2\u05e8\u05db\u05d4 \u05d3\u05d7\u05d5\u05e4\u05d4 \u05e2\u05e7\u05d1 \u05d4\u05e4\u05e1\u05e7\u05d4 \u05e4\u05ea\u05d0\u05d5\u05de\u05d9\u05ea \u05d5\u05d3\u05e8\u05de\u05d8\u05d9\u05ea \u05e9\u05dc \u05d0\u05db\u05d9\u05dc\u05d4 ( severely restricted food intake). \u05d4\u05d5\u05e8\u05d9\u05d4 \u05de\u05d3\u05d5\u05d5\u05d7\u05d9\u05dd \u05db\u05d9 \u05d4\u05de\u05e6\u05d1 \u05d4\u05d7\u05dc \u05dc\u05e4\u05e0\u05d9 \u05e9\u05d1\u05d5\u05e2\u05d9\u05d9\u05dd \u05d5\u05de\u05dc\u05d5\u05d5\u05d4 \u05d1\u05d7\u05e8\u05d3\u05ea \u05e4\u05e8\u05d9\u05d3\u05d4 \u05e7\u05e9\u05d4, \u05d8\u05d9\u05e7\u05d9\u05dd \u05de\u05d5\u05d8\u05d5\u05e8\u05d9\u05d9\u05dd \u05d7\u05d3\u05e9\u05d9\u05dd \u05d5\u05d4\u05d9\u05d3\u05e8\u05d3\u05e8\u05d5\u05ea \u05d1\u05db\u05ea\u05d1 \u05d4\u05d9\u05d3. \u05de\u05d4\u05d9 \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05de\u05d1\u05d3\u05dc\u05ea \u05d4\u05d7\u05e9\u05d5\u05d1\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05e9\u05d9\u05e9 \u05dc\u05e9\u05e7\u05d5\u05dc \u05d1\u05de\u05e7\u05e8\u05d4 \u05d6\u05d4?",
      "answerOptions": [
        {
          "text": "PANS (Pediatric Acute-onset Neuropsychiatric Syndrome).",
          "isCorrect": true,
          "rationale": "\u05d4\u05d5\u05e4\u05e2\u05d4 \u05e4\u05ea\u05d0\u05d5\u05de\u05d9\u05ea (abrupt/dramatic) \u05e9\u05dc \u05d4\u05d2\u05d1\u05dc\u05ea \u05de\u05d6\u05d5\u05df \u05d9\u05d7\u05d3 \u05e2\u05dd \u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05e0\u05d5\u05d9\u05e8\u05d5\u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9\u05d9\u05dd \u05db\u05de\u05d5 \u05d8\u05d9\u05e7\u05d9\u05dd \u05d0\u05d5 \u05d7\u05e8\u05d3\u05ea \u05e4\u05e8\u05d9\u05d3\u05d4 \u05de\u05e8\u05de\u05d6\u05ea \u05e2\u05dc PANS (Dulcan p.370; DSM p.379)."
        },
        {
          "text": "\u05d0\u05e0\u05d5\u05e8\u05e7\u05e1\u05d9\u05d4 \u05e0\u05e8\u05d1\u05d5\u05d6\u05d4 \u05d8\u05d9\u05e4\u05d5\u05e1\u05d9\u05ea.",
          "isCorrect": false,
          "rationale": "\u05d0\u05e0\u05d5\u05e8\u05e7\u05e1\u05d9\u05d4 \u05de\u05ea\u05e4\u05ea\u05d7\u05ea \u05d1\u05d3\u05e8\u05da \u05db\u05dc\u05dc \u05d1\u05d4\u05d3\u05e8\u05d2\u05d4 \u05d5\u05de\u05dc\u05d5\u05d5\u05d4 \u05d1\u05e2\u05d9\u05d5\u05d5\u05ea \u05d1\u05d3\u05d9\u05de\u05d5\u05d9 \u05d4\u05d2\u05d5\u05e3, \u05d1\u05e0\u05d9\u05d2\u05d5\u05d3 \u05dc\u05d4\u05d5\u05e4\u05e2\u05d4 \u05d4\u05e4\u05ea\u05d0\u05d5\u05de\u05d9\u05ea \u05d5\u05d4\u05e0\u05d5\u05d9\u05e8\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea \u05d4\u05de\u05ea\u05d5\u05d0\u05e8\u05ea \u05db\u05d0\u05df (Dulcan p.412)."
        },
        {
          "text": "OCD \u05e2\u05dd \u05e7\u05d5\u05de\u05d5\u05e8\u05d1\u05d9\u05d3\u05d9\u05d5\u05ea \u05e9\u05dc ARFID.",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05e9\u05d9\u05e9 \u05d7\u05e4\u05d9\u05e4\u05d4, \u05d4\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05d4\u05e0\u05d5\u05d9\u05e8\u05d5\u05dc\u05d5\u05d2\u05d9\u05d9\u05dd \u05d5\u05d4\u05d4\u05d5\u05e4\u05e2\u05d4 \u05d4\u05d3\u05e8\u05de\u05d8\u05d9\u05ea \u05de\u05d7\u05d9\u05d9\u05d1\u05d9\u05dd \u05d1\u05e8\u05d0\u05e9 \u05d5\u05d1\u05e8\u05d0\u05e9\u05d5\u05e0\u05d4 \u05e9\u05dc\u05d9\u05dc\u05d4 \u05e9\u05dc \u05ea\u05e1\u05de\u05d5\u05e0\u05ea \u05e4\u05d5\u05e1\u05d8-\u05d6\u05d9\u05d4\u05d5\u05de\u05d9\u05ea \u05d0\u05d5 \u05d0\u05d5\u05d8\u05d5\u05d0\u05d9\u05de\u05d5\u05e0\u05d9\u05ea (Dulcan p.370)."
        },
        {
          "text": "Rumination Disorder.",
          "isCorrect": false,
          "rationale": "\u05e8\u05d5\u05de\u05d9\u05e0\u05e6\u05d9\u05d4 \u05de\u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05ea \u05d1\u05d4\u05e2\u05dc\u05d0\u05ea \u05de\u05d6\u05d5\u05df \u05d5\u05dc\u05d0 \u05d1\u05d4\u05d9\u05de\u05e0\u05e2\u05d5\u05ea \u05de\u05d5\u05d7\u05dc\u05d8\u05ea \u05de\u05d0\u05db\u05d9\u05dc\u05d4 \u05d4\u05de\u05dc\u05d5\u05d5\u05d4 \u05d1\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05e0\u05d5\u05d9\u05e8\u05d5\u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9\u05d9\u05dd (DSM p.374)."
        }
      ],
      "hint": "\u05e9\u05d9\u05dd \u05dc\u05d1 \u05dc\u05de\u05d4\u05d9\u05e8\u05d5\u05ea \u05d4\u05d5\u05e4\u05e2\u05ea \u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d5\u05dc\u05e9\u05d9\u05dc\u05d5\u05d1 \u05e9\u05dc \u05d4\u05d2\u05d1\u05dc\u05ea \u05de\u05d6\u05d5\u05df \u05e2\u05dd \u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd \u05e0\u05d5\u05d9\u05e8\u05d5\u05dc\u05d5\u05d2\u05d9\u05d9\u05dd.",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05dc\u05e4\u05d9 \u05d4-DSM-5-TR, \u05de\u05d4\u05d5 \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05d4\u05d0\u05e4\u05d9\u05d3\u05de\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d4\u05de\u05d1\u05d3\u05d9\u05dc \u05d0\u05ea \u05d4\u05e4\u05e8\u05e2\u05ea \u05d4-Pica \u05de\u05d0\u05d7\u05e8\u05d5\u05ea?",
      "answerOptions": [
        {
          "text": "\u05e7\u05d9\u05d9\u05de\u05ea \u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d2\u05d1\u05d5\u05d4\u05d4 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05d1\u05e7\u05e8\u05d1 \u05e0\u05e9\u05d9\u05dd \u05d1\u05d4\u05e8\u05d9\u05d5\u05df, \u05d4\u05de\u05d5\u05e2\u05e8\u05db\u05ea \u05d1-28% \u05d1\u05de\u05d7\u05e7\u05e8\u05d9\u05dd \u05de\u05e1\u05d5\u05d9\u05de\u05d9\u05dd.",
          "isCorrect": true,
          "rationale": "\u05e4\u05d9\u05e7\u05d4 \u05de\u05d5\u05e4\u05d9\u05e2\u05d4 \u05d1\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d2\u05d1\u05d5\u05d4\u05d4 \u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05e8\u05d9\u05d5\u05df \u05d5\u05de\u05e9\u05db\u05d1 \u05dc\u05d9\u05d3\u05d4, \u05dc\u05e2\u05d9\u05ea\u05d9\u05dd \u05e2\u05dc \u05e8\u05e7\u05e2 \u05d7\u05e1\u05e8\u05d9\u05dd \u05ea\u05d6\u05d5\u05e0\u05ea\u05d9\u05d9\u05dd (DSM p.373)."
        },
        {
          "text": "\u05d4\u05d9\u05d0 \u05de\u05d5\u05e4\u05d9\u05e2\u05d4 \u05db\u05de\u05e2\u05d8 \u05d0\u05da \u05d5\u05e8\u05e7 \u05d1\u05d1\u05e0\u05d9\u05dd \u05e2\u05dd ASD.",
          "isCorrect": false,
          "rationale": "\u05d1\u05e2\u05d5\u05d3 \u05e9\u05d9\u05e9 \u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d2\u05d1\u05d5\u05d4\u05d4 \u05d1-ASD, \u05d4\u05d4\u05e4\u05e8\u05e2\u05d4 \u05de\u05d5\u05e4\u05d9\u05e2\u05d4 \u05d2\u05dd \u05d1\u05d1\u05e0\u05d5\u05ea \u05d5\u05d1\u05e0\u05e9\u05d9\u05dd \u05d1\u05d4\u05e8\u05d9\u05d5\u05df (DSM p.373)."
        },
        {
          "text": "\u05d4\u05d9\u05d0 \u05e9\u05db\u05d9\u05d7\u05d4 \u05d9\u05d5\u05ea\u05e8 \u05d1\u05e7\u05e8\u05d1 \u05de\u05ea\u05d1\u05d2\u05e8\u05d5\u05ea \u05e2\u05dd \u05d3\u05d0\u05d2\u05d5\u05ea \u05dc\u05d2\u05d1\u05d9 \u05de\u05e9\u05e7\u05dc \u05d2\u05d5\u05e3.",
          "isCorrect": false,
          "rationale": "\u05e4\u05d9\u05e7\u05d4 \u05d0\u05d9\u05e0\u05d4 \u05e7\u05e9\u05d5\u05e8\u05d4 \u05dc\u05d3\u05d0\u05d2\u05d5\u05ea \u05de\u05e9\u05e7\u05dc; \u05d0\u05dd \u05d0\u05db\u05d9\u05dc\u05ea \u05d7\u05d5\u05de\u05e8\u05d9\u05dd \u05e0\u05e2\u05e9\u05d9\u05ea \u05dc\u05e9\u05dc\u05d9\u05d8\u05d4 \u05d1\u05de\u05e9\u05e7\u05dc, \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05d9\u05d0 \u05d0\u05e0\u05d5\u05e8\u05e7\u05e1\u05d9\u05d4 (DSM p.374)."
        },
        {
          "text": "\u05e9\u05db\u05d9\u05d7\u05d5\u05ea\u05d4 \u05d1\u05d0\u05d5\u05db\u05dc\u05d5\u05e1\u05d9\u05d9\u05d4 \u05d4\u05db\u05dc\u05dc\u05d9\u05ea \u05e9\u05dc \u05d9\u05dc\u05d3\u05d9 \u05d1\u05d9\u05ea \u05e1\u05e4\u05e8 \u05d4\u05d9\u05d0 15%.",
          "isCorrect": false,
          "rationale": "\u05d4\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d1\u05d9\u05dc\u05d3\u05d9 \u05d1\u05d9\u05ea \u05e1\u05e4\u05e8 \u05e0\u05de\u05d5\u05db\u05d4 \u05d9\u05d5\u05ea\u05e8 \u05d5\u05de\u05d5\u05e2\u05e8\u05db\u05ea \u05d1\u05db-1.6% \u05e2\u05d3 5% (DSM p.372)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05e7\u05d1\u05d5\u05e6\u05ea \u05d0\u05d5\u05db\u05dc\u05d5\u05e1\u05d9\u05d9\u05d4 \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05ea \u05e9\u05d7\u05d5\u05d5\u05d4 \u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd \u05e4\u05d9\u05d6\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05d9\u05dd \u05d5\u05ea\u05d6\u05d5\u05e0\u05ea\u05d9\u05d9\u05dd \u05d6\u05de\u05e0\u05d9\u05d9\u05dd.",
