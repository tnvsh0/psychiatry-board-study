{
  "title": "Feeding Quiz",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\u05d1\u05df 9 \u05d4\u05de\u05d0\u05d5\u05d1\u05d7\u05df \u05e2\u05dd ASD \u05d5-ADHD \u05de\u05d8\u05d5\u05e4\u05dc \u05d1-Methylphenidate. \u05d4\u05d5\u05e8\u05d9\u05d5 \u05de\u05d3\u05d5\u05d5\u05d7\u05d9\u05dd \u05e2\u05dc \u05e6\u05de\u05e6\u05d5\u05dd \u05e7\u05d9\u05e6\u05d5\u05e0\u05d9 \u05d1\u05de\u05d2\u05d5\u05d5\u05df \u05d4\u05de\u05d6\u05d5\u05e0\u05d5\u05ea \u05d4\u05de\u05dc\u05d5\u05d5\u05d4 \u05d1\u05d9\u05e8\u05d9\u05d3\u05d4 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05d1\u05de\u05e9\u05e7\u05dc ($BMI < 5^{th} percentile$). \u05d4\u05d9\u05dc\u05d3 \u05de\u05e1\u05e8\u05d1 \u05dc\u05d0\u05db\u05d5\u05dc \u05de\u05d6\u05d5\u05e0\u05d5\u05ea \u05e9\u05d0\u05d9\u05e0\u05dd \u05d1\u05e2\u05dc\u05d9 \u05de\u05e8\u05e7\u05dd \u05d7\u05dc\u05e7 \u05de\u05d0\u05d5\u05d3 \u05d5\u05d8\u05d5\u05e2\u05df \u05e9\u05d0\u05d9\u05e0\u05d5 \u05e8\u05e2\u05d1, \u05d0\u05da \u05d0\u05d9\u05e0\u05d5 \u05de\u05d1\u05d9\u05e2 \u05d3\u05d0\u05d2\u05d4 \u05dc\u05d2\u05d1\u05d9 \u05e6\u05d5\u05e8\u05ea \u05d2\u05d5\u05e4\u05d5. \u05de\u05d4\u05d9 \u05d4\u05e4\u05e2\u05d5\u05dc\u05d4 \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05d4\u05d7\u05e9\u05d5\u05d1\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d1\u05e0\u05d9\u05d4\u05d5\u05dc \u05d4\u05ea\u05e8\u05d5\u05e4\u05ea\u05d9 \u05d1\u05de\u05e7\u05e8\u05d4 \u05d6\u05d4?",
      "answerOptions": [
        {
          "text": "\u05e9\u05e7\u05d9\u05dc\u05ea \u05d4\u05e4\u05e1\u05e7\u05d4 \u05d0\u05d5 \u05d4\u05d7\u05dc\u05e4\u05d4 \u05e9\u05dc \u05d4-Methylphenidate \u05e2\u05e7\u05d1 \u05d7\u05e9\u05e9 \u05dc\u05d4\u05d7\u05de\u05e8\u05ea \u05d4\u05d3\u05d9\u05db\u05d5\u05d9 \u05d1\u05ea\u05d9\u05d0\u05d1\u05d5\u05df.",
          "isCorrect": true,
          "rationale": "\u05d1\u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd \u05e2\u05dd \u05e7\u05d5\u05de\u05d5\u05e8\u05d1\u05d9\u05d3\u05d9\u05d5\u05ea \u05e9\u05dc ADHD \u05d5-ARFID, \u05e9\u05d9\u05de\u05d5\u05e9 \u05d1-stimulants \u05e2\u05dc\u05d5\u05dc \u05dc\u05d4\u05d7\u05de\u05d9\u05e8 \u05d0\u05ea \u05d4\u05d9\u05e8\u05d9\u05d3\u05d4 \u05d1\u05de\u05e9\u05e7\u05dc \u05e2\u05e7\u05d1 \u05d3\u05d9\u05db\u05d5\u05d9 \u05ea\u05d9\u05d0\u05d1\u05d5\u05df, \u05de\u05d4 \u05e9\u05de\u05d4\u05d5\u05d5\u05d4 \u05e1\u05d9\u05db\u05d5\u05df \u05e7\u05dc\u05d9\u05e0\u05d9 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9 (Dulcan p.418)."
        },
        {
          "text": "\u05d4\u05e2\u05dc\u05d0\u05ea \u05de\u05d9\u05e0\u05d5\u05df \u05d4-Methylphenidate \u05db\u05d3\u05d9 \u05dc\u05e9\u05e4\u05e8 \u05d0\u05ea \u05d4\u05e8\u05d9\u05db\u05d5\u05d6 \u05d1\u05d6\u05de\u05df \u05d4\u05d0\u05e8\u05d5\u05d7\u05d5\u05ea.",
          "isCorrect": false,
          "rationale": "\u05d4\u05e2\u05dc\u05d0\u05ea \u05de\u05d9\u05e0\u05d5\u05df \u05e9\u05dc stimulants \u05e8\u05e7 \u05ea\u05d7\u05de\u05d9\u05e8 \u05d0\u05ea \u05d4\u05d3\u05d9\u05db\u05d5\u05d9 \u05d1\u05ea\u05d9\u05d0\u05d1\u05d5\u05df \u05d5\u05ea\u05e4\u05d2\u05e2 \u05d1\u05de\u05d0\u05de\u05e6\u05d9 \u05e9\u05d9\u05e7\u05d5\u05dd \u05d4\u05de\u05e9\u05e7\u05dc \u05d4\u05e0\u05d3\u05e8\u05e9\u05d9\u05dd \u05d1-ARFID (Dulcan p.418)."
        },
        {
          "text": "\u05d4\u05d5\u05e1\u05e4\u05ea Fluoxetine \u05db\u05e7\u05d5 \u05e8\u05d0\u05e9\u05d5\u05df \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05d7\u05e8\u05d3\u05d4 \u05de\u05d4\u05de\u05e8\u05e7\u05dd \u05e9\u05dc \u05d4\u05de\u05d6\u05d5\u05df.",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05e9-Fluoxetine \u05de\u05d0\u05d5\u05e9\u05e8 \u05dc-MDD \u05d5-OCD \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd, \u05d4\u05d5\u05d0 \u05d0\u05d9\u05e0\u05d5 \u05de\u05d4\u05d5\u05d5\u05d4 \u05e7\u05d5 \u05e8\u05d0\u05e9\u05d5\u05df \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-ARFID, \u05d5\u05d9\u05e9 \u05dc\u05ea\u05ea \u05e7\u05d3\u05d9\u05de\u05d5\u05ea \u05dc\u05e0\u05d9\u05d4\u05d5\u05dc \u05ea\u05d5\u05e4\u05e2\u05d5\u05ea \u05d4\u05dc\u05d5\u05d5\u05d0\u05d9 \u05e9\u05dc \u05d4\u05e1\u05d8\u05d9\u05de\u05d5\u05dc\u05e0\u05d8\u05d9\u05dd (StahlKids p.199)."
        },
        {
          "text": "\u05de\u05ea\u05df Lisdexamfetamine \u05db\u05d7\u05dc\u05d5\u05e4\u05d4 \u05d1\u05d8\u05d5\u05d7\u05d4 \u05d9\u05d5\u05ea\u05e8 \u05e9\u05d0\u05d9\u05e0\u05d4 \u05de\u05e9\u05e4\u05d9\u05e2\u05d4 \u05e2\u05dc \u05d4\u05ea\u05d9\u05d0\u05d1\u05d5\u05df.",
          "isCorrect": false,
          "rationale": "\u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 Lisdexamfetamine \u05d4\u05d9\u05d0 stimulant \u05d5\u05de\u05d0\u05d5\u05e9\u05e8\u05ea \u05dc-BED \u05d1\u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd, \u05d0\u05da \u05d4\u05d9\u05d0 \u05d2\u05d5\u05e8\u05de\u05ea \u05dc\u05d3\u05d9\u05db\u05d5\u05d9 \u05ea\u05d9\u05d0\u05d1\u05d5\u05df \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9 \u05d5\u05de\u05e1\u05d5\u05db\u05e0\u05ea \u05d1-ARFID (StahlKids p.268)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05d4\u05e9\u05e4\u05e2\u05d4 \u05d4\u05e4\u05d9\u05d6\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea \u05e9\u05dc \u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05dc-ADHD \u05e2\u05dc \u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05e8\u05e2\u05d1 \u05d5\u05d4\u05e9\u05d5\u05d1\u05e2.",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05dc\u05e4\u05d9 \u05d4\u05de\u05d5\u05d3\u05dc \u05d4\u05e0\u05d5\u05d9\u05e8\u05d5\u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d4\u05ea\u05dc\u05ea-\u05de\u05de\u05d3\u05d9 \u05e9\u05dc Thomas et al. (2017) \u05d4\u05de\u05d5\u05e6\u05d2 \u05d1\u05e1\u05e4\u05e8 Dulcan, \u05d0\u05d9\u05d6\u05d4 \u05de\u05e2\u05d2\u05dc \u05de\u05d5\u05d7\u05d9 (circuit) \u05de\u05e7\u05d5\u05e9\u05e8 \u05dc\u05e4\u05e0\u05d5\u05d8\u05d9\u05e4 \u05e9\u05dc ARFID \u05d4\u05de\u05ea\u05d0\u05e4\u05d9\u05d9\u05df \u05d1\u05e4\u05d7\u05d3 \u05de\u05ea\u05d5\u05e6\u05d0\u05d5\u05ea \u05d0\u05d1\u05e8\u05e1\u05d9\u05d1\u05d9\u05d5\u05ea (\u05db\u05de\u05d5 \u05d7\u05e0\u05e7 \u05d0\u05d5 \u05d4\u05e7\u05d0\u05d4)?",
      "answerOptions": [
        {
          "text": "\u05de\u05e2\u05d2\u05dc \u05d4\u05e4\u05d7\u05d3 \u05d5\u05d4\u05d7\u05e8\u05d3\u05d4 \u05d4\u05de\u05e2\u05e8\u05d1 \u05d0\u05ea \u05d4-Amygdala \u05d5\u05d4-PFC.",
          "isCorrect": true,
          "rationale": "\u05d4\u05de\u05d5\u05d3\u05dc \u05de\u05e6\u05d9\u05e2 \u05e9\u05d3\u05d9\u05e1\u05e8\u05d2\u05d5\u05dc\u05e6\u05d9\u05d4 \u05d1\u05de\u05e2\u05d2\u05dc\u05d9 \u05d4\u05e4\u05d7\u05d3 (Amygdala/PFC) \u05d4\u05d9\u05d0 \u05d4\u05d1\u05e1\u05d9\u05e1 \u05dc\u05d4\u05d9\u05de\u05e0\u05e2\u05d5\u05ea \u05de\u05de\u05d6\u05d5\u05df \u05d4\u05de\u05d5\u05e0\u05e2\u05ea \u05de\u05e4\u05d7\u05d3 \u05de\u05d8\u05e8\u05d0\u05d5\u05de\u05d4 \u05d0\u05d5 \u05ea\u05d5\u05e6\u05d0\u05d5\u05ea \u05e9\u05dc\u05d9\u05dc\u05d9\u05d5\u05ea (Dulcan p.419)."
        },
        {
          "text": "\u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05ea\u05d9\u05d0\u05d1\u05d5\u05df \u05d4\u05d4\u05d5\u05de\u05d0\u05d5\u05e1\u05d8\u05d8\u05d9\u05ea \u05d1-Hypothalamus.",
          "isCorrect": false,
          "rationale": "\u05de\u05e2\u05e8\u05db\u05ea \u05d6\u05d5 \u05de\u05e7\u05d5\u05e9\u05e8\u05ea \u05dc\u05e4\u05e0\u05d5\u05d8\u05d9\u05e4 \u05e9\u05dc \u05d7\u05d5\u05e1\u05e8 \u05e2\u05e0\u05d9\u05d9\u05df \u05d1\u05d0\u05d5\u05db\u05dc (lack of interest) \u05d5\u05dc\u05d0 \u05dc\u05e4\u05d7\u05d3 \u05de\u05ea\u05d5\u05e6\u05d0\u05d5\u05ea \u05d0\u05d1\u05e8\u05e1\u05d9\u05d1\u05d9\u05d5\u05ea (Dulcan p.419)."
        },
        {
          "text": "\u05d4\u05de\u05e2\u05d2\u05dc \u05d4\u05e1\u05e0\u05e1\u05d5\u05e8\u05d9 \u05d1-Insula \u05d5\u05d1-Somatosensory cortex.",
          "isCorrect": false,
          "rationale": "\u05de\u05e2\u05d2\u05dc \u05d6\u05d4 \u05d0\u05d7\u05e8\u05d0\u05d9 \u05e2\u05dc \u05e8\u05d2\u05d9\u05e9\u05d5\u05ea \u05d9\u05ea\u05e8 \u05dc\u05d8\u05e2\u05dd \u05d5\u05de\u05e8\u05e7\u05dd (sensory sensitivity) \u05d1-ARFID (Dulcan p.419)."
        },
        {
          "text": "\u05d4-Dorsal habit system \u05d1-Dorsal Striatum.",
          "isCorrect": false,
          "rationale": "\u05de\u05e2\u05e8\u05db\u05ea \u05d6\u05d5 \u05de\u05e7\u05d5\u05e9\u05e8\u05ea \u05d9\u05d5\u05ea\u05e8 \u05dc\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05d9\u05d5\u05ea \u05e9\u05dc Pica \u05d5-Rumination \u05db\u05d4\u05e8\u05d2\u05dc\u05d9\u05dd \u05e7\u05d5\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05d9\u05dd \u05d5\u05dc\u05d0 \u05dc\u05de\u05e2\u05d2\u05dc\u05d9 \u05d4\u05e4\u05d7\u05d3 \u05e9\u05dc ARFID (StahlNeuro p.540)."
        }
      ],
      "hint": "\u05d4\u05ea\u05de\u05e7\u05d3 \u05d1\u05de\u05d1\u05e0\u05d4 \u05d4\u05de\u05d5\u05d7\u05d9 \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05d4\u05d0\u05d7\u05e8\u05d0\u05d9 \u05e2\u05dc \u05e2\u05d9\u05d1\u05d5\u05d3 \u05e8\u05d2\u05e9\u05d5\u05ea \u05e9\u05dc \u05e4\u05d7\u05d3 \u05d5\u05d4\u05d9\u05de\u05e0\u05e2\u05d5\u05ea.",
      "imageUrls": []
    },
    {
      "type": "multiple_select",
      "question": "\u05e7\u05dc\u05d9\u05e0\u05d0\u05d9 \u05de\u05e2\u05e8\u05d9\u05da \u05e0\u05e2\u05e8 \u05d1\u05df 15 \u05d4\u05d7\u05e9\u05d5\u05d3 \u05db\u05e1\u05d5\u05d1\u05dc \u05de\u05d4\u05e4\u05e8\u05e2\u05ea ARFID. \u05d0\u05d9\u05dc\u05d5 \u05de\u05db\u05dc\u05d9 \u05d4\u05d4\u05e2\u05e8\u05db\u05d4 \u05d4\u05d1\u05d0\u05d9\u05dd \u05e0\u05d7\u05e9\u05d1\u05d9\u05dd \u05dc\u05de\u05ea\u05d0\u05d9\u05de\u05d9\u05dd \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05d0\u05d5\u05db\u05dc\u05d5\u05e1\u05d9\u05d9\u05ea \u05d2\u05d9\u05dc \u05d6\u05d5 \u05dc\u05e6\u05d5\u05e8\u05da \u05d0\u05d1\u05d7\u05d5\u05df \u05d5\u05e1\u05d9\u05e0\u05d5\u05df \u05dc\u05e4\u05d9 \u05d4\u05de\u05e7\u05d5\u05e8\u05d5\u05ea?",
      "answerOptions": [
        {
          "text": "\u05e8\u05d0\u05d9\u05d5\u05df \u05d4-PARDI (Pica, ARFID, and Rumination Disorder Interview).",
          "isCorrect": true,
          "rationale": "\u05d4-PARDI \u05d4\u05d5\u05d0 \u05e8\u05d0\u05d9\u05d5\u05df \u05d7\u05e6\u05d9-\u05de\u05d5\u05d1\u05e0\u05d4 \u05d4\u05de\u05d9\u05d5\u05e2\u05d3 \u05dc\u05d2\u05d9\u05dc\u05d0\u05d9 10-22 \u05dc\u05d4\u05e2\u05e8\u05db\u05ea \u05d0\u05d1\u05d7\u05e0\u05ea\u05d9\u05ea \u05e9\u05dc \u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05d0\u05db\u05d9\u05dc\u05d4 \u05d5\u05d4\u05d6\u05e0\u05d4 (Dulcan p.424)."
        },
        {
          "text": "\u05e9\u05d0\u05dc\u05d5\u05df \u05d4-NIAS (Nine Item ARFID Screen).",
          "isCorrect": true,
          "rationale": "\u05d4-NIAS \u05d4\u05d5\u05d0 \u05db\u05dc\u05d9 \u05e1\u05d9\u05e0\u05d5\u05df \u05d1\u05df 9 \u05e4\u05e8\u05d9\u05d8\u05d9\u05dd \u05d4\u05de\u05d9\u05d5\u05e2\u05d3 \u05dc\u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd \u05de\u05d2\u05d9\u05dc 14 \u05d5\u05de\u05e2\u05dc\u05d4 \u05d5\u05de\u05e2\u05e8\u05d9\u05da \u05d0\u05ea \u05e9\u05dc\u05d5\u05e9\u05ea \u05d4\u05e4\u05e0\u05d5\u05d8\u05d9\u05e4\u05d9\u05dd \u05e9\u05dc ARFID (Dulcan p.424)."
        },
        {
          "text": "\u05d4\u05d2\u05e8\u05e1\u05d4 \u05d4\u05e4\u05d3\u05d9\u05d0\u05d8\u05e8\u05d9\u05ea \u05e9\u05dc \u05d4-EDE (Eating Disorder Examination).",
          "isCorrect": true,
          "rationale": "\u05d4-EDE \u05d4\u05e4\u05d3\u05d9\u05d0\u05d8\u05e8\u05d9 \u05de\u05e1\u05d9\u05d9\u05e2 \u05d1\u05d0\u05d1\u05d7\u05e0\u05d4 \u05de\u05d1\u05d3\u05dc\u05ea \u05e2\u05dc \u05d9\u05d3\u05d9 \u05e9\u05dc\u05d9\u05dc\u05ea \u05e2\u05d9\u05d5\u05d5\u05ea \u05d1\u05d3\u05d9\u05de\u05d5\u05d9 \u05d4\u05d2\u05d5\u05e3 \u05d4\u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05d9 \u05dc\u05d0\u05e0\u05d5\u05e8\u05e7\u05e1\u05d9\u05d4 (Dulcan p.424)."
        },
        {
          "text": "\u05e9\u05d0\u05dc\u05d5\u05df \u05d4-EDY-Q (Eating Disorders in Youth-Questionnaire).",
          "isCorrect": false,
