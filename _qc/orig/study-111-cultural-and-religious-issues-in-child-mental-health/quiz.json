        },
        {
          "text": "\u05d4\u05e1\u05d1\u05d9\u05e8\u05d5\u05ea \u05d4\u05d2\u05d1\u05d5\u05d4\u05d4 \u05e9\u05de\u05d3\u05d5\u05d1\u05e8 \u05d1-Dhat syndrome \u05d1\u05e9\u05dc \u05d4\u05d7\u05e8\u05d3\u05d4 \u05d4\u05e1\u05d5\u05de\u05d8\u05d9\u05ea.",
