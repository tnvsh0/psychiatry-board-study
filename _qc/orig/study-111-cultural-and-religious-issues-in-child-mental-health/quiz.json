      "question": "\u05ea\u05d0\u05e8\u05d5 \u05d0\u05ea \u05d7\u05e9\u05d9\u05d1\u05d5\u05ea \u05d4-Domain \u05d4-4 \u05d1\u05e8\u05d0\u05d9\u05d5\u05df \u05d4-CFI (Cultural Factors Affecting Current Help Seeking) \u05d1\u05ea\u05d4\u05dc\u05d9\u05da \u05ea\u05db\u05e0\u05d5\u05df \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc (Treatment Planning).",
      "grading": {
        "modelAnswer": "Domain 4 \u05d1-CFI \u05de\u05ea\u05de\u05e7\u05d3 \u05d1\u05e6\u05d9\u05e4\u05d9\u05d5\u05ea \u05d4\u05e2\u05db\u05e9\u05d5\u05d5\u05d9\u05d5\u05ea \u05e9\u05dc \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05de\u05d4\u05e2\u05d6\u05e8\u05d4 \u05d5\u05d1\u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05d9\u05d7\u05e1\u05d9\u05dd \u05d1\u05d9\u05df \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05dc\u05de\u05d8\u05e4\u05dc. \u05d4\u05d5\u05d0 \u05de\u05d0\u05e4\u05e9\u05e8 \u05dc\u05d6\u05d4\u05d5\u05ea \u05d7\u05e1\u05de\u05d9\u05dd \u05db\u05de\u05d5 \u05d4\u05d1\u05d3\u05dc\u05d9 \u05e9\u05e4\u05d4, \u05e4\u05e2\u05e8\u05d9\u05dd \u05d1\u05e6\u05d9\u05e4\u05d9\u05d5\u05ea \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc\u05d9\u05d5\u05ea, \u05d5\u05d7\u05e9\u05e9\u05d5\u05ea \u05de\u05d0\u05d9-\u05d4\u05d1\u05e0\u05d4 \u05ea\u05e8\u05d1\u05d5\u05ea\u05d9\u05ea \u05d0\u05d5 \u05d2\u05d6\u05e2\u05e0\u05d5\u05ea, \u05d5\u05d1\u05db\u05da \u05de\u05e1\u05d9\u05d9\u05e2 \u05d1\u05d1\u05e0\u05d9\u05d9\u05ea \u05ea\u05d5\u05db\u05e0\u05d9\u05ea \u05d8\u05d9\u05e4\u05d5\u05dc \u05de\u05e7\u05d5\u05d1\u05dc\u05ea (Negotiated treatment plan) \u05d4\u05de\u05d2\u05d1\u05d9\u05e8\u05d4 \u05d0\u05ea \u05d4-Engagement \u05e9\u05dc \u05d4\u05de\u05d8\u05d5\u05e4\u05dc.",
        "rationale": "\u05d4\u05d1\u05e0\u05ea \u05d4\u05e6\u05d9\u05e4\u05d9\u05d5\u05ea \u05e9\u05dc \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05d5\u05d4\u05d7\u05e1\u05de\u05d9\u05dd \u05d1\u05e7\u05e9\u05e8 \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc\u05d9 \u05d7\u05d9\u05d5\u05e0\u05d9\u05ea \u05db\u05d3\u05d9 \u05dc\u05de\u05e0\u05d5\u05e2 \u05e0\u05e9\u05d9\u05e8\u05d4 \u05de\u05d8\u05d9\u05e4\u05d5\u05dc \u05d5\u05dc\u05d4\u05d1\u05d8\u05d9\u05d7 \u05e9\u05d4\u05ea\u05d5\u05db\u05e0\u05d9\u05ea \u05ea\u05d5\u05d0\u05de\u05ea \u05d0\u05ea \u05e2\u05e8\u05db\u05d9\u05d5 (DSM p.863, p.866-867).",
        "requiredAttributes": [
          "\u05e6\u05d9\u05d5\u05df \u05d4\u05ea\u05de\u05e7\u05d3\u05d5\u05ea \u05d1\u05e6\u05d9\u05e4\u05d9\u05d5\u05ea \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05de\u05d4\u05e2\u05d6\u05e8\u05d4 \u05d4\u05e0\u05d5\u05db\u05d7\u05d9\u05ea.",
          "\u05d4\u05ea\u05d9\u05d9\u05d7\u05e1\u05d5\u05ea \u05dc\u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05d9\u05d7\u05e1\u05d9\u05dd \u05de\u05d8\u05e4\u05dc-\u05de\u05d8\u05d5\u05e4\u05dc \u05d5\u05e4\u05e2\u05e8\u05d9\u05dd \u05ea\u05e8\u05d1\u05d5\u05ea\u05d9\u05d9\u05dd \u05d1\u05d9\u05e0\u05d9\u05d4\u05dd.",
          "\u05d4\u05e1\u05d1\u05e8 \u05db\u05d9\u05e6\u05d3 \u05d6\u05d4 \u05ea\u05d5\u05e8\u05dd \u05dc\u05ea\u05db\u05e0\u05d5\u05df \u05d8\u05d9\u05e4\u05d5\u05dc \u05d0\u05d5 \u05dc-Adherence/Engagement."
        ],
        "errors": {
          "misconceptions": [
            "\u05d4\u05e0\u05d7\u05d4 \u05e9\u05d4-CFI \u05e0\u05d5\u05e2\u05d3 \u05e8\u05e7 \u05dc\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d5\u05dc\u05d0 \u05dc\u05ea\u05db\u05e0\u05d5\u05df \u05d8\u05d9\u05e4\u05d5\u05dc."
          ],
          "bluffs": [
            "\u05d0\u05de\u05d9\u05e8\u05d5\u05ea \u05db\u05dc\u05dc\u05d9\u05d5\u05ea \u05e2\u05dc '\u05db\u05d1\u05d5\u05d3 \u05dc\u05ea\u05e8\u05d1\u05d5\u05ea' \u05d1\u05dc\u05d9 \u05dc\u05e6\u05d9\u05d9\u05df \u05d0\u05ea \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05e9\u05dc \u05ea\u05d9\u05d0\u05d5\u05dd \u05e6\u05d9\u05e4\u05d9\u05d5\u05ea."
          ]
        }
      },
      "hint": "\u05d7\u05e9\u05d1\u05d5 \u05e2\u05dc \u05d4\u05e9\u05d0\u05dc\u05d5\u05ea \u05d4\u05d0\u05d7\u05e8\u05d5\u05e0\u05d5\u05ea \u05d1\u05e8\u05d0\u05d9\u05d5\u05df (14-16) \u05d4\u05e2\u05d5\u05e1\u05e7\u05d5\u05ea \u05d1\u05de\u05d4 \u05e9\u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05e8\u05d5\u05e6\u05d4 \u05e9\u05d9\u05e7\u05e8\u05d4 \u05e2\u05db\u05e9\u05d9\u05d5.",
