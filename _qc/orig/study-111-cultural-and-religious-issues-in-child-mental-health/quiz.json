    {
      "type": "multiple_select",
      "question": "\u05d1\u05de\u05d4\u05dc\u05da \u05d1\u05d9\u05e6\u05d5\u05e2 Cultural Formulation Interview (CFI) \u05e2\u05dd \u05de\u05e9\u05e4\u05d7\u05d4 \u05d7\u05e8\u05d3\u05d9\u05ea, \u05d0\u05d9\u05dc\u05d5 \u05de\u05d4\u05e4\u05e2\u05d5\u05dc\u05d5\u05ea \u05d4\u05d1\u05d0\u05d5\u05ea \u05e0\u05d7\u05e9\u05d1\u05d5\u05ea \u05dc\u05e9\u05d9\u05de\u05d5\u05e9 \u05e0\u05db\u05d5\u05df \u05d1\u05db\u05dc\u05d9 \u05d6\u05d4 \u05d5\u05d1\u05d4\u05ea\u05d0\u05de\u05d4 \u05ea\u05e8\u05d1\u05d5\u05ea\u05d9\u05ea \u05e2\u05dc \u05e4\u05d9 \u05d4\u05de\u05e7\u05d5\u05e8\u05d5\u05ea?",
      "answerOptions": [
        {
          "text": "\u05e9\u05e7\u05d9\u05dc\u05ea \u05d2\u05d9\u05d5\u05e1 \u05d1\u05e8\u05db\u05d4 \u05d0\u05d5 \u05d4\u05e1\u05db\u05de\u05d4 \u05de\u05d4\u05e1\u05de\u05db\u05d5\u05ea \u05d4\u05e8\u05d1\u05e0\u05d9\u05ea (Rabbinic authority) \u05db\u05d3\u05d9 \u05dc\u05e9\u05e4\u05e8 Adherence.",
          "isCorrect": true,
          "rationale": "\u05d1\u05d7\u05d1\u05e8\u05d4 \u05d4\u05d7\u05e8\u05d3\u05d9\u05ea, \u05d0\u05d9\u05e9\u05d5\u05e8 \u05de\u05d4\u05e8\u05d1 \u05d9\u05db\u05d5\u05dc \u05dc\u05d4\u05e4\u05d9\u05d2 \u05d7\u05e9\u05e9\u05d5\u05ea \u05d0\u05d9\u05d3\u05d0\u05d5\u05dc\u05d5\u05d2\u05d9\u05d9\u05dd \u05d5\u05dc\u05d4\u05d1\u05d8\u05d9\u05d7 \u05e9\u05d9\u05ea\u05d5\u05e3 \u05e4\u05e2\u05d5\u05dc\u05d4 \u05e2\u05dd \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc (Dulcan p.542)."
        },
        {
          "text": "\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1-16 \u05e9\u05d0\u05dc\u05d5\u05ea \u05d4\u05dc\u05d9\u05d1\u05d4 \u05e9\u05dc \u05d4-CFI \u05db\u05d3\u05d9 \u05dc\u05d4\u05d1\u05d9\u05df \u05d0\u05ea \u05d4-Cultural Definition of the Problem.",
          "isCorrect": true,
          "rationale": "\u05d4-CFI \u05de\u05d5\u05e8\u05db\u05d1 \u05de-16 \u05e9\u05d0\u05dc\u05d5\u05ea \u05de\u05d5\u05d1\u05e0\u05d5\u05ea \u05e9\u05e0\u05d5\u05e2\u05d3\u05d5 \u05dc\u05d4\u05d5\u05e6\u05d9\u05d0 \u05d0\u05ea \u05e0\u05e7\u05d5\u05d3\u05ea \u05d4\u05de\u05d1\u05d8 \u05e9\u05dc \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05e2\u05dc \u05d1\u05e2\u05d9\u05d9\u05ea\u05d5 (DSM p.862-863)."
        },
        {
          "text": "\u05d4\u05e2\u05e8\u05db\u05ea \u05d4\u05d7\u05e9\u05e9 \u05de\u05e1\u05d8\u05d9\u05d2\u05de\u05d4 \u05d5\u05d4\u05e9\u05e4\u05e2\u05ea\u05d4 \u05e2\u05dc \u05e2\u05d5\u05dc\u05dd \u05d4\u05e9\u05d9\u05d3\u05d5\u05db\u05d9\u05dd (Shidduchim).",
          "isCorrect": true,
          "rationale": "\u05d1\u05e6\u05d9\u05d1\u05d5\u05e8 \u05d4\u05d7\u05e8\u05d3\u05d9, \u05d0\u05d1\u05d7\u05e0\u05d4 \u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9\u05ea \u05e0\u05ea\u05e4\u05e1\u05ea \u05db\u05d1\u05e2\u05dc\u05ea \u05d4\u05e9\u05e4\u05e2\u05d4 \u05de\u05db\u05e8\u05e2\u05ea \u05e2\u05dc \u05e1\u05d9\u05db\u05d5\u05d9\u05d9 \u05d4\u05e0\u05d9\u05e9\u05d5\u05d0\u05d9\u05df \u05e9\u05dc \u05d4\u05d9\u05dc\u05d3 \u05d5\u05d0\u05d7\u05d9\u05d5, \u05d5\u05dc\u05db\u05df \u05d7\u05d9\u05d5\u05e0\u05d9 \u05dc\u05d4\u05e2\u05e8\u05d9\u05da \u05d7\u05e1\u05dd \u05d6\u05d4 (Syllabus p.27)."
        },
        {
          "text": "\u05e9\u05d0\u05d9\u05dc\u05ea \u05e9\u05d0\u05dc\u05d5\u05ea \u05d9\u05e9\u05d9\u05e8\u05d5\u05ea \u05e2\u05dc \u05ea\u05e4\u05e7\u05d5\u05d3 \u05de\u05d9\u05e0\u05d9 \u05db\u05d7\u05dc\u05e7 \u05de-Domain 1 \u05e9\u05dc \u05d4-CFI.",
          "isCorrect": false,
          "rationale": "\u05d9\u05e9 \u05dc\u05d4\u05d9\u05de\u05e0\u05e2 \u05de\u05ea\u05d9\u05d0\u05d5\u05e8\u05d9\u05dd \u05de\u05d9\u05e0\u05d9\u05d9\u05dd \u05de\u05e4\u05d5\u05e8\u05e9\u05d9\u05dd \u05d0\u05d5 \u05e9\u05d0\u05dc\u05d5\u05ea \u05d7\u05d5\u05d3\u05e8\u05e0\u05d9\u05d5\u05ea \u05d1\u05ea\u05d7\u05d5\u05dd \u05d6\u05d4 \u05d1\u05ea\u05d7\u05d9\u05dc\u05ea \u05d4\u05e7\u05e9\u05e8 \u05e2\u05dd \u05de\u05e9\u05e4\u05d7\u05d4 \u05d7\u05e8\u05d3\u05d9\u05ea \u05d1\u05e9\u05dc \u05e2\u05e8\u05db\u05d9 \u05d4\u05e6\u05e0\u05d9\u05e2\u05d5\u05ea, \u05d5\u05d4-CFI \u05d1-Domain 1 \u05de\u05ea\u05de\u05e7\u05d3 \u05d1\u05d4\u05d2\u05d3\u05e8\u05ea \u05d4\u05d1\u05e2\u05d9\u05d4 \u05d4\u05db\u05dc\u05dc\u05d9\u05ea (Dulcan p.543, DSM p.864)."
