          "isCorrect": false,
          "rationale": "\u05d1\u05d4\u05ea\u05e7\u05e9\u05e8\u05d5\u05ea \u05d1\u05d8\u05d5\u05d7\u05d4 \u05d4\u05d9\u05dc\u05d3 \u05d9\u05e4\u05d2\u05d9\u05df \u05de\u05e6\u05d5\u05e7\u05d4 \u05de\u05e1\u05d5\u05d9\u05de\u05ea \u05d1\u05e4\u05e8\u05d9\u05d3\u05d4 \u05d0\u05da \u05d9\u05d7\u05e4\u05e9 \u05e7\u05e8\u05d1\u05d4 \u05d5\u05d9\u05d9\u05e8\u05d2\u05e2 \u05d1\u05de\u05d4\u05d9\u05e8\u05d5\u05ea \u05e2\u05dd \u05d4\u05d0\u05d9\u05d7\u05d5\u05d3 (Synopsis ch.34.1)."
        }
      ],
      "hint": "\u05d7\u05e4\u05e9 \u05d0\u05ea \u05d4\u05d3\u05e4\u05d5\u05e1 \u05e9\u05d1\u05d5 \u05d4\u05ea\u05d9\u05e0\u05d5\u05e7 '\u05de\u05d5\u05d5\u05ea\u05e8' \u05e2\u05dc \u05d4\u05d1\u05e2\u05ea \u05de\u05e6\u05d5\u05e7\u05d4 \u05db\u05d3\u05d9 \u05dc\u05e9\u05de\u05d5\u05e8 \u05e2\u05dc \u05e7\u05e8\u05d1\u05d4 \u05de\u05d9\u05e0\u05d9\u05de\u05dc\u05d9\u05ea."
    },
    {
      "type": "multiple_choice",
      "question": "\u05dc\u05e4\u05d9 \u05d4\u05ea\u05d9\u05d0\u05d5\u05e8\u05d9\u05d4 \u05e9\u05dc Melanie Klein, \u05de\u05d4\u05d5 \u05d4\u05de\u05e2\u05d1\u05e8 \u05d4\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9 \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05d4\u05de\u05ea\u05e8\u05d7\u05e9 \u05d1\u05de\u05e2\u05d1\u05e8 \u05de\u05d4\u05e4\u05d5\u05d6\u05d9\u05e6\u05d9\u05d4 \u05d4\u05e4\u05e8\u05e0\u05d5\u05d0\u05d9\u05d3\u05d9\u05ea-\u05e1\u05db\u05d9\u05d6\u05d5\u05d0\u05d9\u05d3\u05d9\u05ea \u05dc\u05e4\u05d5\u05d6\u05d9\u05e6\u05d9\u05d4 \u05d4\u05d3\u05d9\u05db\u05d0\u05d5\u05e0\u05d9\u05ea?",
      "answerOptions": [
        {
          "text": "\u05d4\u05d9\u05db\u05d5\u05dc\u05ea \u05dc\u05ea\u05e4\u05d5\u05e1 \u05d0\u05ea \u05d4\u05d0\u05dd \u05db\u05d0\u05d5\u05d1\u05d9\u05d9\u05e7\u05d8 \u05e9\u05dc\u05dd (whole object) \u05d5\u05d4\u05d5\u05e4\u05e2\u05ea \u05e8\u05d2\u05e9\u05d5\u05ea \u05d0\u05e9\u05dd \u05d5\u05d3\u05d0\u05d2\u05d4 \u05dc\u05d2\u05d5\u05e8\u05dc\u05d4.",
          "isCorrect": true,
          "rationale": "\u05d1\u05e4\u05d5\u05d6\u05d9\u05e6\u05d9\u05d4 \u05d4\u05d3\u05d9\u05db\u05d0\u05d5\u05e0\u05d9\u05ea, \u05d4\u05d9\u05dc\u05d3 \u05de\u05d1\u05d9\u05df \u05e9\u05d4'\u05d0\u05dd \u05d4\u05d8\u05d5\u05d1\u05d4' \u05d5\u05d4'\u05d0\u05dd \u05d4\u05e8\u05e2\u05d4' \u05d4\u05df \u05d0\u05d5\u05ea\u05d4 \u05d3\u05de\u05d5\u05ea, \u05d5\u05d7\u05d5\u05e9\u05e9 \u05e9\u05d4\u05ea\u05d5\u05e7\u05e4\u05e0\u05d5\u05ea \u05e9\u05dc\u05d5 \u05e4\u05d2\u05e2\u05d4 \u05d1\u05d4 (Syllabus p.52, Synopsis ch.34.4)."
        },
        {
          "text": "\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1-splitting \u05db\u05d3\u05d9 \u05dc\u05d4\u05d2\u05df \u05e2\u05dc \u05d4'\u05d8\u05d5\u05d1' \u05de\u05e4\u05e0\u05d9 \u05d4'\u05e8\u05e2' \u05d4\u05de\u05d0\u05d9\u05d9\u05dd.",
          "isCorrect": false,
          "rationale": "\u05e4\u05d9\u05e6\u05d5\u05dc (splitting) \u05d4\u05d5\u05d0 \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05d1\u05e4\u05d5\u05d6\u05d9\u05e6\u05d9\u05d4 \u05d4\u05e4\u05e8\u05e0\u05d5\u05d0\u05d9\u05d3\u05d9\u05ea-\u05e1\u05db\u05d9\u05d6\u05d5\u05d0\u05d9\u05d3\u05d9\u05ea, \u05d5\u05dc\u05d0 \u05d1\u05d3\u05d9\u05db\u05d0\u05d5\u05e0\u05d9\u05ea (Syllabus p.52)."
        },
        {
          "text": "\u05d4\u05e9\u05d2\u05ea Object Permanence \u05d4\u05de\u05d0\u05e4\u05e9\u05e8\u05ea \u05dc\u05d9\u05dc\u05d3 \u05dc\u05e9\u05de\u05d5\u05e8 \u05e2\u05dc \u05d3\u05de\u05d5\u05ea \u05d4\u05d0\u05dd \u05d1\u05e0\u05e4\u05e9\u05d5 \u05d1\u05d4\u05d9\u05e2\u05d3\u05e8\u05d4.",
          "isCorrect": false,
          "rationale": "\u05e7\u05d1\u05d9\u05e2\u05d5\u05ea \u05d0\u05d5\u05d1\u05d9\u05d9\u05e7\u05d8 \u05d4\u05d9\u05d0 \u05de\u05d5\u05e9\u05d2 \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9 \u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9 (\u05e4\u05d9\u05d0\u05d6'\u05d4), \u05d1\u05e2\u05d5\u05d3 \u05e7\u05dc\u05d9\u05d9\u05df \u05de\u05ea\u05de\u05e7\u05d3\u05ea \u05d1\u05e2\u05de\u05d3\u05d4 \u05d4\u05e8\u05d2\u05e9\u05d9\u05ea \u05db\u05dc\u05e4\u05d9 \u05d4\u05d0\u05d5\u05d1\u05d9\u05d9\u05e7\u05d8 (Synopsis ch.34.4)."
        },
        {
          "text": "\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea \u05d4-Superego \u05d3\u05e8\u05da \u05e4\u05ea\u05e8\u05d5\u05df \u05d4\u05e7\u05d5\u05e0\u05e4\u05dc\u05d9\u05e7\u05d8 \u05d4\u05d0\u05d3\u05d9\u05e4\u05dc\u05d9.",
          "isCorrect": false,
          "rationale": "\u05d0\u05e3 \u05e9\u05e7\u05dc\u05d9\u05d9\u05df \u05d4\u05e7\u05d3\u05d9\u05de\u05d4 \u05d0\u05ea \u05d4\u05d5\u05e4\u05e2\u05ea \u05d4\u05d0\u05d3\u05d9\u05e4\u05d5\u05e1, \u05d4\u05de\u05e2\u05d1\u05e8 \u05d1\u05d9\u05df \u05d4\u05e4\u05d5\u05d6\u05d9\u05e6\u05d9\u05d5\u05ea \u05de\u05ea\u05de\u05e7\u05d3 \u05d1\u05d9\u05d7\u05e1\u05d9\u05dd \u05d4\u05de\u05d5\u05e7\u05d3\u05de\u05d9\u05dd \u05e2\u05dd \u05d4\u05d0\u05dd \u05d5\u05dc\u05d0 \u05d1\u05e7\u05d5\u05e0\u05e4\u05dc\u05d9\u05e7\u05d8 \u05d4\u05e9\u05dc\u05e9\u05d5\u05e0\u05d9 (Syllabus p.52)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05de\u05d5\u05e0\u05d7 'Ambibalence' (\u05d0\u05de\u05d1\u05d9\u05d5\u05d5\u05dc\u05e0\u05d8\u05d9\u05d5\u05ea) \u05d5\u05d4\u05d9\u05db\u05d5\u05dc\u05ea \u05dc\u05e9\u05d0\u05ea \u05e8\u05d2\u05e9\u05d5\u05ea \u05de\u05e2\u05d5\u05e8\u05d1\u05d9\u05dd."
    },
    {
      "type": "multiple_choice",
      "question": "\u05de\u05d4\u05d5 \u05d4\u05de\u05de\u05e6\u05d0 \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05d1\u05de\u05d7\u05e7\u05e8 \u05d4-RCT \u05e9\u05dc Rossouw & Fonagy (2012) \u05d1\u05e0\u05d5\u05d2\u05e2 \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-MBT-A \u05d1\u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd \u05e2\u05dd \u05e4\u05e6\u05d9\u05e2\u05d4 \u05e2\u05e6\u05de\u05d9\u05ea (self-harm)?",
      "explanation": "\u05d4\u05de\u05d7\u05e7\u05e8 \u05d4\u05e8\u05d0\u05d4 \u05d9\u05e8\u05d9\u05d3\u05d4 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05d1\u05e4\u05e6\u05d9\u05e2\u05d4 \u05e2\u05e6\u05de\u05d9\u05ea \u05d5\u05d3\u05d9\u05db\u05d0\u05d5\u05df, \u05db\u05d0\u05e9\u05e8 \u05d4\u05e9\u05d9\u05e4\u05d5\u05e8 \u05d1\u05d9\u05db\u05d5\u05dc\u05ea \u05d4\u05de\u05e0\u05d8\u05dc\u05d9\u05d6\u05e6\u05d9\u05d4 \u05ea\u05d9\u05d5\u05d5\u05da \u05d0\u05ea \u05d4\u05ea\u05d5\u05e6\u05d0\u05d5\u05ea.",
      "answerOptions": [
        {
          "text": "MBT-A \u05d4\u05e4\u05d7\u05d9\u05ea \u05e4\u05e6\u05d9\u05e2\u05d4 \u05e2\u05e6\u05de\u05d9\u05ea \u05dc-43% \u05dc\u05e2\u05d5\u05de\u05ea 68% \u05d1\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05e8\u05d2\u05d9\u05dc (TAU), \u05d1\u05ea\u05d9\u05d5\u05d5\u05da \u05e9\u05dc \u05e9\u05d9\u05e4\u05d5\u05e8 \u05d1-Reflective Function.",
