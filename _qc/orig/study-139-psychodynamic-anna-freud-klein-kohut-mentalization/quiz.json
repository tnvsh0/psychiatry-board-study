{
  "title": "Psychodynamic Quiz",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\u05de\u05d8\u05e4\u05dc \u05d1\u05d2\u05d9\u05e9\u05d4 \u05e4\u05e1\u05d9\u05db\u05d5\u05d3\u05d9\u05e0\u05de\u05d9\u05ea \u05de\u05ea\u05d7\u05d9\u05dc \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05d9\u05dc\u05d3 \u05d1\u05df 5 \u05d4\u05e1\u05d5\u05d1\u05dc \u05de\u05d7\u05e8\u05d3\u05d5\u05ea. \u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05e9\u05e2\u05d4 \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc\u05d9\u05ea, \u05d4\u05d9\u05dc\u05d3 \u05de\u05e9\u05d7\u05e7 \u05d1\u05d1\u05d5\u05d1\u05d5\u05ea \u05d5\u05de\u05e6\u05d9\u05d2 \u05e1\u05e6\u05e0\u05d4 \u05ea\u05d5\u05e7\u05e4\u05e0\u05d9\u05ea. \u05dc\u05e4\u05d9 \u05d4\u05d2\u05d9\u05e9\u05d4 \u05e9\u05dc Melanie Klein, \u05de\u05d4\u05d9 \u05d4\u05e2\u05de\u05d3\u05d4 \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc\u05d9\u05ea \u05d4\u05e0\u05db\u05d5\u05e0\u05d4 \u05d5\u05de\u05d4 \u05d4\u05e8\u05e6\u05d9\u05d5\u05e0\u05dc \u05d4\u05e2\u05d5\u05de\u05d3 \u05de\u05d0\u05d7\u05d5\u05e8\u05d9\u05d4?",
      "answerOptions": [
        {
          "text": "\u05e4\u05d9\u05e8\u05d5\u05e9 \u05d9\u05e9\u05d9\u05e8 \u05d5\u05e2\u05de\u05d5\u05e7 \u05e9\u05dc \u05d4\u05e4\u05e0\u05d8\u05d6\u05d9\u05d5\u05ea \u05d4\u05dc\u05d0-\u05de\u05d5\u05d3\u05e2\u05d5\u05ea \u05d5\u05d4\u05d4\u05e2\u05d1\u05e8\u05d4 \u05d4\u05de\u05dc\u05d0\u05d4 \u05d4\u05de\u05ea\u05d1\u05d8\u05d0\u05ea \u05d1\u05de\u05e9\u05d7\u05e7.",
          "isCorrect": true,
          "rationale": "\u05e7\u05dc\u05d9\u05d9\u05df \u05d8\u05e2\u05e0\u05d4 \u05db\u05d9 \u05de\u05e9\u05d7\u05e7 \u05d4\u05d9\u05dc\u05d3 \u05e9\u05e7\u05d5\u05dc \u05dc\u05d0\u05e1\u05d5\u05e6\u05d9\u05d0\u05e6\u05d9\u05d5\u05ea \u05d7\u05d5\u05e4\u05e9\u05d9\u05d5\u05ea \u05e9\u05dc \u05de\u05d1\u05d5\u05d2\u05e8 \u05d5\u05de\u05d1\u05d8\u05d0 \u05d4\u05e2\u05d1\u05e8\u05d4 \u05de\u05dc\u05d0\u05d4 \u05e9\u05dc \u05d4\u05e2\u05d5\u05dc\u05dd \u05d4\u05e4\u05e0\u05d9\u05de\u05d9 \u05db\u05d1\u05e8 \u05de\u05e8\u05d0\u05e9\u05d9\u05ea \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc (Dulcan p.850, Syllabus p.50)."
        },
        {
          "text": "\u05e0\u05e7\u05d9\u05d8\u05ea \u05e2\u05de\u05d3\u05d4 \u05d7\u05d9\u05e0\u05d5\u05db\u05d9\u05ea \u05d5\u05de\u05d0\u05d6\u05e0\u05ea, \u05ea\u05d5\u05da \u05d4\u05d9\u05de\u05e0\u05e2\u05d5\u05ea \u05de\u05e4\u05d9\u05e8\u05d5\u05e9 \u05d4\u05e2\u05d1\u05e8\u05d4 \u05de\u05dc\u05d0\u05d4 \u05d1\u05e9\u05dc \u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05d4\u05d4\u05d5\u05e8\u05d9\u05dd \u05d4\u05de\u05e6\u05d9\u05d0\u05d5\u05ea\u05d9\u05d9\u05dd.",
          "isCorrect": false,
          "rationale": "\u05e2\u05de\u05d3\u05d4 \u05d6\u05d5 \u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05ea \u05d0\u05ea \u05d2\u05d9\u05e9\u05ea\u05d4 \u05e9\u05dc \u05d0\u05e0\u05d4 \u05e4\u05e8\u05d5\u05d9\u05d3, \u05e9\u05d8\u05e2\u05e0\u05d4 \u05db\u05d9 \u05d9\u05dc\u05d3\u05d9\u05dd \u05d0\u05d9\u05e0\u05dd \u05de\u05e4\u05ea\u05d7\u05d9\u05dd transference neurosis \u05de\u05dc\u05d0\u05d4 \u05d1\u05e9\u05dc \u05d4\u05e9\u05e4\u05e2\u05ea \u05d4\u05d4\u05d5\u05e8\u05d9\u05dd \u05d4\u05de\u05de\u05e9\u05d9\u05d9\u05dd (Dulcan p.850, Syllabus p.50)."
        },
        {
          "text": "\u05d4\u05ea\u05de\u05e7\u05d3\u05d5\u05ea \u05d1\u05d7\u05d9\u05d6\u05d5\u05e7 \u05d4-Ego \u05d5\u05d1\u05e0\u05d9\u05d9\u05ea \u05d1\u05e8\u05d9\u05ea \u05d8\u05d9\u05e4\u05d5\u05dc\u05d9\u05ea (working alliance) \u05dc\u05e4\u05e0\u05d9 \u05de\u05ea\u05df \u05e4\u05d9\u05e8\u05d5\u05e9\u05d9\u05dd \u05dc\u05ea\u05d5\u05e7\u05e4\u05e0\u05d5\u05ea.",
          "isCorrect": false,
          "rationale": "\u05d0\u05e0\u05d4 \u05e4\u05e8\u05d5\u05d9\u05d3 \u05d4\u05d3\u05d2\u05d9\u05e9\u05d4 \u05d0\u05ea \u05d4\u05e6\u05d5\u05e8\u05da \u05d1\u05d7\u05d9\u05d6\u05d5\u05e7 \u05d4-Ego \u05d5\u05d1\u05de\u05e8\u05db\u05d9\u05d1\u05d9\u05dd \u05ea\u05de\u05d9\u05db\u05d9\u05d9\u05dd, \u05d1\u05e2\u05d5\u05d3 \u05e7\u05dc\u05d9\u05d9\u05df \u05d3\u05d2\u05dc\u05d4 \u05d1\u05e4\u05d9\u05e8\u05d5\u05e9 \u05d9\u05e9\u05d9\u05e8 \u05e9\u05dc \u05d3\u05d7\u05e4\u05d9 \u05d4\u05de\u05d5\u05d5\u05ea \u05d5\u05d4\u05d7\u05e8\u05d3\u05d5\u05ea (Syllabus p.52)."
        },
        {
          "text": "\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05de\u05e9\u05d7\u05e7 \u05db\u05db\u05dc\u05d9 \u05dc\u05d4\u05e1\u05d7\u05ea \u05d3\u05e2\u05ea \u05de\u05d4\u05d7\u05e8\u05d3\u05d4 \u05d5\u05de\u05ea\u05df suggestion \u05d7\u05d9\u05d5\u05d1\u05d9 \u05dc\u05d7\u05d9\u05d6\u05d5\u05e7 \u05d4\u05d1\u05d9\u05d8\u05d7\u05d5\u05df \u05d4\u05e2\u05e6\u05de\u05d9.",
          "isCorrect": false,
          "rationale": "Suggestion \u05d4\u05d5\u05d0 \u05db\u05dc\u05d9 \u05d1\u05d8\u05d9\u05e4\u05d5\u05dc \u05ea\u05de\u05d9\u05db\u05ea\u05d9 (supportive), \u05d0\u05da \u05d0\u05d9\u05e0\u05d5 \u05e2\u05d5\u05dc\u05d4 \u05d1\u05e7\u05e0\u05d4 \u05d0\u05d7\u05d3 \u05e2\u05dd \u05d4\u05d8\u05db\u05e0\u05d9\u05e7\u05d4 \u05d4\u05d0\u05e0\u05dc\u05d9\u05d8\u05d9\u05ea \u05e9\u05dc \u05e7\u05dc\u05d9\u05d9\u05df \u05d4\u05de\u05ea\u05de\u05e7\u05d3\u05ea \u05d1\u05e4\u05d9\u05e8\u05d5\u05e9 \u05e7\u05d5\u05e0\u05e4\u05dc\u05d9\u05e7\u05d8\u05d9\u05dd \u05e2\u05de\u05d5\u05e7\u05d9\u05dd (Dulcan p.848)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05de\u05d7\u05dc\u05d5\u05e7\u05ea \u05d4\u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05ea \u05d1\u05e0\u05d5\u05d2\u05e2 \u05dc\u05d4\u05e9\u05d5\u05d5\u05d0\u05ea \u05de\u05e9\u05d7\u05e7 \u05d4\u05d9\u05dc\u05d3 \u05dc\u05d0\u05e1\u05d5\u05e6\u05d9\u05d0\u05e6\u05d9\u05d5\u05ea \u05d7\u05d5\u05e4\u05e9\u05d9\u05d5\u05ea \u05e9\u05dc \u05de\u05d1\u05d5\u05d2\u05e8."
    },
    {
      "type": "multiple_choice",
      "question": "\u05e0\u05e2\u05e8 \u05d1\u05df 17 \u05e2\u05dd Narcissistic Personality Disorder (NPD) \u05de\u05d2\u05d9\u05e2 \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc. \u05d4\u05d5\u05d0 \u05e0\u05d5\u05d8\u05d4 \u05dc\u05d4\u05d0\u05d3\u05d9\u05e8 \u05d0\u05ea \u05d4\u05de\u05d8\u05e4\u05dc, \u05de\u05db\u05e0\u05d4 \u05d0\u05d5\u05ea\u05d5 '\u05d4\u05de\u05d5\u05de\u05d7\u05d4 \u05d4\u05d2\u05d3\u05d5\u05dc \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d1\u05d0\u05e8\u05e5' \u05d5\u05de\u05e8\u05d2\u05d9\u05e9 \u05d7\u05d6\u05e7 \u05d5\u05d1\u05d8\u05d5\u05d7 \u05e8\u05e7 \u05db\u05d0\u05e9\u05e8 \u05d4\u05d5\u05d0 \u05d1\u05e7\u05e8\u05d1\u05ea\u05d5. \u05dc\u05e4\u05d9 Heinz Kohut, \u05d1\u05d0\u05d9\u05d6\u05d4 \u05e1\u05d5\u05d2 \u05e9\u05dc transference \u05de\u05d3\u05d5\u05d1\u05e8 \u05d5\u05db\u05d9\u05e6\u05d3 \u05d9\u05e9 \u05dc\u05d4\u05ea\u05d9\u05d9\u05d7\u05e1 \u05d0\u05dc\u05d9\u05d4?",
      "answerOptions": [
        {
          "text": "Idealizing transference; \u05d9\u05e9 \u05dc\u05d0\u05e4\u05e9\u05e8 \u05d0\u05d5\u05ea\u05d4 \u05db\u05e6\u05d5\u05e8\u05da \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9 \u05dc\u05d1\u05e0\u05d9\u05d9\u05ea \u05dc\u05db\u05d9\u05d3\u05d5\u05ea \u05d4\u05e2\u05e6\u05de\u05d9.",
          "isCorrect": true,
          "rationale": "\u05e7\u05d5\u05d4\u05d5\u05d8 \u05e8\u05d0\u05d4 \u05d1\u05d4\u05e2\u05d1\u05e8\u05ea \u05d0\u05d9\u05d3\u05d9\u05d0\u05dc\u05d9\u05d6\u05e6\u05d9\u05d4 \u05e6\u05d5\u05e8\u05da \u05e9\u05dc \u05d4\u05e2\u05e6\u05de\u05d9 \u05dc\u05d4\u05ea\u05de\u05d6\u05d2 \u05e2\u05dd \u05d3\u05de\u05d5\u05ea \u05d7\u05d6\u05e7\u05d4 \u05db\u05d3\u05d9 \u05dc\u05e9\u05de\u05d5\u05e8 \u05e2\u05dc \u05e9\u05d9\u05d5\u05d5\u05d9 \u05de\u05e9\u05e7\u05dc \u05e0\u05e8\u05e7\u05d9\u05e1\u05d9\u05e1\u05d8\u05d9 (Synopsis ch.34.4)."
        },
        {
          "text": "Mirror transference; \u05d9\u05e9 \u05dc\u05e4\u05e8\u05e9 \u05d0\u05d5\u05ea\u05d4 \u05de\u05d9\u05d3 \u05db\u05d4\u05d2\u05e0\u05d4 \u05de\u05e4\u05e0\u05d9 \u05d4\u05e2\u05e8\u05db\u05d4 \u05e2\u05e6\u05de\u05d9\u05ea \u05e0\u05de\u05d5\u05db\u05d4.",
          "isCorrect": false,
          "rationale": "\u05d4\u05e2\u05d1\u05e8\u05ea \u05de\u05e8\u05d0\u05d4 \u05de\u05ea\u05de\u05e7\u05d3\u05ea \u05d1\u05e6\u05d5\u05e8\u05da \u05e9\u05dc \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05d1\u05e9\u05d9\u05e7\u05d5\u05e3 \u05d4\u05d2\u05e8\u05e0\u05d3\u05d9\u05d5\u05d6\u05d9\u05d5\u05ea \u05e9\u05dc\u05d5 ('\u05d4\u05d1\u05e8\u05e7 \u05d1\u05e2\u05d9\u05e0\u05d9 \u05d4\u05d0\u05dd'), \u05d5\u05dc\u05d0 \u05d1\u05d0\u05d9\u05d3\u05d9\u05d0\u05dc\u05d9\u05d6\u05e6\u05d9\u05d4 \u05e9\u05dc \u05d4\u05de\u05d8\u05e4\u05dc (Synopsis ch.34.4)."
        },
        {
          "text": "Twinship transference; \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05de\u05d7\u05e4\u05e9 \u05d3\u05de\u05d9\u05d5\u05df \u05d5\u05e9\u05d5\u05ea\u05e4\u05d5\u05ea \u05db\u05d3\u05d9 \u05dc\u05d4\u05e4\u05d9\u05d2 \u05ea\u05d7\u05d5\u05e9\u05ea \u05d1\u05d3\u05d9\u05d3\u05d5\u05ea.",
          "isCorrect": false,
          "rationale": "\u05d4\u05e2\u05d1\u05e8\u05ea \u05ea\u05d0\u05d5\u05de\u05d5\u05ea (alter-ego) \u05de\u05d1\u05d5\u05e1\u05e1\u05ea \u05e2\u05dc \u05d4\u05e6\u05d5\u05e8\u05da \u05dc\u05d7\u05d5\u05e9 \u05d3\u05de\u05d9\u05d5\u05df \u05dc\u05de\u05d8\u05e4\u05dc, \u05d5\u05dc\u05d0 \u05e2\u05dc \u05d4\u05d0\u05d3\u05e8\u05ea\u05d5 \u05db\u05d3\u05de\u05d5\u05ea \u05e2\u05d9\u05dc\u05d0\u05d9\u05ea (Synopsis ch.34.4)."
        },
        {
          "text": "Projective Identification; \u05d4\u05de\u05d8\u05e4\u05dc \u05d7\u05d5\u05d5\u05d4 '\u05dc\u05d7\u05e5' \u05dc\u05d4\u05e8\u05d2\u05d9\u05e9 \u05de\u05d5\u05e9\u05dc\u05dd \u05db\u05d3\u05d9 \u05dc\u05d4\u05d2\u05df \u05e2\u05dc \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05de\u05d7\u05e8\u05d3\u05ea \u05e4\u05d9\u05e8\u05d5\u05e7.",
          "isCorrect": false,
          "rationale": "\u05d4\u05d6\u05d3\u05d4\u05d5\u05ea \u05d4\u05e9\u05dc\u05db\u05ea\u05d9\u05ea \u05d4\u05d9\u05d0 \u05de\u05d5\u05e9\u05d2 \u05e7\u05dc\u05d9\u05d9\u05e0\u05d9\u05d0\u05e0\u05d9 \u05d4\u05de\u05ea\u05d0\u05e8 \u05ea\u05d4\u05dc\u05d9\u05da \u05d1\u05d9\u05e0\u05d0\u05d9\u05e9\u05d9 \u05e9\u05dc \u05d4\u05e9\u05dc\u05db\u05ea \u05d7\u05dc\u05e7\u05d9\u05dd \u05e4\u05e0\u05d9\u05de\u05d9\u05d9\u05dd \u05dc\u05ea\u05d5\u05da \u05d4\u05d0\u05d5\u05d1\u05d9\u05d9\u05e7\u05d8, \u05d5\u05dc\u05d0 \u05de\u05d5\u05e0\u05d7 \u05de\u05e8\u05db\u05d6\u05d9 \u05d1-Self Psychology \u05e9\u05dc \u05e7\u05d5\u05d4\u05d5\u05d8 (Synopsis ch.34.4)."
        }
      ],
      "hint": "\u05e9\u05d9\u05dd \u05dc\u05d1 \u05dc\u05d4\u05d1\u05d7\u05e0\u05d4 \u05d1\u05d9\u05df \u05d4\u05e6\u05d5\u05e8\u05da \u05e9\u05dc \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05dc\u05d4\u05d9\u05d5\u05ea \u05de\u05d5\u05e2\u05e8\u05da \u05dc\u05d1\u05d9\u05df \u05d4\u05e6\u05d5\u05e8\u05da \u05e9\u05dc\u05d5 \u05dc\u05d4\u05e9\u05ea\u05d9\u05d9\u05da \u05dc\u05d3\u05de\u05d5\u05ea \u05de\u05d5\u05e2\u05e8\u05db\u05ea."
    },
    {
      "type": "fill_in_the_blank",
      "question": "\u05dc\u05e4\u05d9 D.W. Winnicott, \u05d4\u05de\u05e6\u05d1 \u05d4\u05e0\u05e4\u05e9\u05d9 \u05d4\u05d9\u05d9\u05d7\u05d5\u05d3\u05d9 \u05e9\u05dc \u05d4\u05d0\u05dd \u05d1\u05e9\u05dc\u05d4\u05d9 \u05d4\u05d4\u05e8\u05d9\u05d5\u05df \u05d5\u05d1\u05e9\u05d1\u05d5\u05e2\u05d5\u05ea \u05d4\u05e8\u05d0\u05e9\u05d5\u05e0\u05d9\u05dd \u05dc\u05d0\u05d7\u05e8 \u05d4\u05dc\u05d9\u05d3\u05d4, \u05d4\u05de\u05d0\u05e4\u05e9\u05e8 \u05dc\u05d4 \u05dc\u05d4\u05e1\u05ea\u05e0\u05db\u05e8\u05df \u05d1\u05d0\u05d5\u05e4\u05df \u05d8\u05d5\u05d8\u05d0\u05dc\u05d9 \u05e2\u05dd \u05e6\u05d5\u05e8\u05db\u05d9 \u05d4\u05ea\u05d9\u05e0\u05d5\u05e7, \u05de\u05db\u05d5\u05e0\u05d4 ___ (Primary Maternal Preoccupation).",
      "bestAnswer": "\u05de\u05d5\u05e9\u05e7\u05e2\u05d5\u05ea \u05d0\u05d9\u05de\u05d4\u05d9\u05ea \u05e8\u05d0\u05e9\u05d5\u05e0\u05d9\u05ea",
      "acceptableAnswers": [
        "\u05de\u05d5\u05e9\u05e7\u05e2\u05d5\u05ea \u05d0\u05d9\u05de\u05d4\u05d9\u05ea",
        "primary maternal preoccupation"
      ],
      "rationale": "\u05de\u05d5\u05e9\u05d2 \u05d6\u05d4 \u05de\u05ea\u05d0\u05e8 \u05d0\u05ea \u05d4\u05e8\u05d2\u05d9\u05e9\u05d5\u05ea \u05d4\u05de\u05d5\u05d2\u05d1\u05e8\u05ea \u05e9\u05dc \u05d4\u05d0\u05dd \u05d4\u05de\u05d0\u05e4\u05e9\u05e8\u05ea \u05dc\u05d4 \u05dc\u05e1\u05e4\u05e7 \u05e1\u05d1\u05d9\u05d1\u05d4 \u05de\u05d7\u05d6\u05d9\u05e7\u05d4 (Holding) \u05de\u05d5\u05ea\u05d0\u05de\u05ea \u05d0\u05d9\u05e9\u05d9\u05ea \u05dc\u05ea\u05d9\u05e0\u05d5\u05e7 (Dulcan p.937, Syllabus p.52).",
      "hint": "\u05d6\u05d4\u05d5 \u05d4\u05de\u05d5\u05e0\u05d7 \u05d4\u05de\u05ea\u05d0\u05e8 \u05d0\u05ea \u05d4'\u05d8\u05d9\u05e8\u05d5\u05e3 \u05d4\u05e0\u05d5\u05e8\u05de\u05dc\u05d9' \u05e9\u05dc \u05d4\u05d0\u05dd \u05d4\u05de\u05de\u05d5\u05e7\u05d3\u05ea \u05db\u05d5\u05dc\u05d4 \u05d1\u05ea\u05d9\u05e0\u05d5\u05e7\u05d4."
    },
    {
      "type": "multiple_select",
      "question": "\u05de\u05d4\u05df \u05d4\u05ea\u05db\u05d5\u05e0\u05d5\u05ea \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d5\u05ea \u05d0\u05ea \u05d4-False Self \u05d1\u05d3\u05e8\u05d2\u05d5\u05ea \u05d4\u05e4\u05ea\u05d5\u05dc\u05d5\u05d2\u05d9\u05d5\u05ea \u05e9\u05dc\u05d5, \u05dc\u05e4\u05d9 \u05ea\u05d9\u05d0\u05d5\u05e8\u05d9\u05d9\u05ea \u05d9\u05d7\u05e1\u05d9 \u05d4\u05d0\u05d5\u05d1\u05d9\u05d9\u05e7\u05d8 \u05e9\u05dc \u05d5\u05d9\u05e0\u05d9\u05e7\u05d5\u05d8?",
      "answerOptions": [
        {
          "text": "\u05d4\u05d5\u05d0 \u05de\u05ea\u05e4\u05ea\u05d7 \u05db\u05de\u05d1\u05e0\u05d4 \u05d4\u05d2\u05e0\u05ea\u05d9 \u05db\u05d0\u05e9\u05e8 \u05d4\u05e1\u05d1\u05d9\u05d1\u05d4 \u05d0\u05d9\u05e0\u05d4 \u05e0\u05e2\u05e0\u05d9\u05ea \u05dc\u05d3\u05d7\u05e4\u05d9\u05dd \u05d4\u05e1\u05e4\u05d5\u05e0\u05d8\u05e0\u05d9\u05d9\u05dd \u05e9\u05dc \u05d4\u05ea\u05d9\u05e0\u05d5\u05e7.",
          "isCorrect": true,
          "rationale": "\u05d4\u05e2\u05e6\u05de\u05d9 \u05d4\u05db\u05d5\u05d6\u05d1 \u05e0\u05d5\u05e6\u05e8 \u05db\u05d3\u05d9 \u05dc\u05d4\u05d2\u05df \u05e2\u05dc \u05d4\u05e2\u05e6\u05de\u05d9 \u05d4\u05d0\u05de\u05d9\u05ea\u05d9 \u05de\u05e4\u05e0\u05d9 \u05d7\u05d3\u05d9\u05e8\u05d4 \u05e1\u05d1\u05d9\u05d1\u05ea\u05d9\u05ea \u05dc\u05d0 \u05de\u05d5\u05ea\u05d0\u05de\u05ea (Syllabus p.52)."
        },
        {
          "text": "\u05d4\u05d5\u05d0 \u05de\u05d5\u05d1\u05d9\u05dc \u05dc\u05ea\u05d7\u05d5\u05e9\u05ea \u05d7\u05d5\u05e1\u05e8 \u05d0\u05d5\u05ea\u05e0\u05d8\u05d9\u05d5\u05ea \u05d5\u05e0\u05d9\u05ea\u05d5\u05e7 \u05de\u05d4\u05d7\u05d5\u05d5\u05d9\u05d5\u05ea \u05d4\u05e4\u05e0\u05d9\u05de\u05d9\u05d5\u05ea.",
          "isCorrect": true,
          "rationale": "\u05d1\u05de\u05e6\u05d1\u05d9 \u05d7\u05d5\u05dc\u05d9, \u05d4-False Self \u05de\u05e9\u05ea\u05dc\u05d8 \u05e2\u05dc \u05d4\u05d0\u05d9\u05e9\u05d9\u05d5\u05ea \u05d5\u05de\u05e0\u05ea\u05e7 \u05d0\u05ea \u05d4\u05d0\u05d3\u05dd \u05de\u05d7\u05d9\u05d5\u05e0\u05d9\u05d5\u05ea\u05d5 (Synopsis ch.34.4)."
        },
        {
          "text": "\u05d4\u05d5\u05d0 \u05de\u05ea\u05d1\u05d8\u05d0 \u05d1\u05e6\u05d9\u05d5\u05ea \u05d9\u05ea\u05e8 (compliance) \u05dc\u05e6\u05d9\u05e4\u05d9\u05d5\u05ea \u05d4\u05d4\u05d5\u05e8\u05d9\u05dd \u05e2\u05dc \u05d7\u05e9\u05d1\u05d5\u05df \u05e6\u05e8\u05db\u05d9\u05dd \u05d0\u05d9\u05e9\u05d9\u05d9\u05dd.",
          "isCorrect": true,
          "rationale": "\u05d4\u05ea\u05d9\u05e0\u05d5\u05e7 \u05e0\u05d0\u05dc\u05e5 \u05dc\u05d4\u05ea\u05d0\u05d9\u05dd \u05d0\u05ea \u05e2\u05e6\u05de\u05d5 \u05e9\u05d5\u05d1 \u05d5\u05e9\u05d5\u05d1 \u05dc\u05e6\u05d5\u05e8\u05db\u05d9 \u05d4\u05d4\u05d5\u05e8\u05d4 \u05db\u05d3\u05d9 \u05dc\u05e9\u05e8\u05d5\u05d3 \u05e8\u05d2\u05e9\u05d9\u05ea (Syllabus p.52)."
        },
        {
          "text": "\u05d4\u05d5\u05d0 \u05de\u05d4\u05d5\u05d5\u05d4 \u05d0\u05ea \u05d4\u05de\u05e7\u05d5\u05e8 \u05dc\u05d9\u05e6\u05d9\u05e8\u05ea\u05d9\u05d5\u05ea, \u05dc\u05de\u05e9\u05d7\u05e7 \u05d5\u05dc\u05d7\u05d5\u05d5\u05d9\u05d4 \u05d4\u05ea\u05e8\u05d1\u05d5\u05ea\u05d9\u05ea \u05d1\u05de\u05e8\u05d7\u05d1 \u05d4\u05e4\u05d5\u05d8\u05e0\u05e6\u05d9\u05d0\u05dc\u05d9.",
          "isCorrect": false,
          "rationale": "\u05d9\u05e6\u05d9\u05e8\u05ea\u05d9\u05d5\u05ea \u05d5\u05de\u05e9\u05d7\u05e7 \u05e0\u05d5\u05d1\u05e2\u05d9\u05dd \u05de\u05d4-True Self \u05d5\u05de\u05d7\u05d9\u05d5\u05e0\u05d9\u05d5\u05ea\u05d5 \u05d4\u05d0\u05d5\u05ea\u05e0\u05d8\u05d9\u05ea, \u05d5\u05dc\u05d0 \u05de\u05d4\u05de\u05d1\u05e0\u05d4 \u05d4\u05d4\u05d2\u05e0\u05ea\u05d9 \u05e9\u05dc \u05d4\u05e2\u05e6\u05de\u05d9 \u05d4\u05db\u05d5\u05d6\u05d1 (Dulcan p.851, Syllabus p.52)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05e9\u05e0\u05d5\u05e2\u05d3 '\u05dc\u05e8\u05e6\u05d5\u05ea' \u05d0\u05ea \u05d4\u05e1\u05d1\u05d9\u05d1\u05d4 \u05d1\u05de\u05d7\u05d9\u05e8 \u05e9\u05dc \u05d0\u05d5\u05d1\u05d3\u05df \u05d4\u05e1\u05e4\u05d5\u05e0\u05d8\u05e0\u05d9\u05d5\u05ea.",
      "hasAllOfTheAbove": false,
      "hasNoneOfTheAbove": false
    },
    {
      "type": "multiple_choice",
      "question": "\u05e0\u05e2\u05e8\u05d4 \u05d1\u05ea 15 \u05d4\u05e1\u05d5\u05d1\u05dc\u05ea \u05de-Borderline Personality Disorder (BPD) \u05d5\u05e4\u05e6\u05d9\u05e2\u05d4 \u05e2\u05e6\u05de\u05d9\u05ea \u05de\u05d5\u05e4\u05e0\u05d9\u05ea \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05de\u05d1\u05d5\u05e1\u05e1 \u05de\u05e0\u05d8\u05dc\u05d9\u05d6\u05e6\u05d9\u05d4 (MBT-A). \u05d1\u05de\u05d4\u05dc\u05da \u05e4\u05d2\u05d9\u05e9\u05d4, \u05d4\u05d9\u05d0 \u05d8\u05d5\u05e2\u05e0\u05ea \u05d1\u05d1\u05d9\u05d8\u05d7\u05d5\u05df \u05de\u05d5\u05d7\u05dc\u05d8: '\u05d4\u05de\u05d8\u05e4\u05dc\u05ea \u05e9\u05dc\u05d9 \u05e9\u05d5\u05e0\u05d0\u05ea \u05d0\u05d5\u05ea\u05d9 \u05db\u05d9 \u05d4\u05d9\u05d0 \u05dc\u05d0 \u05d7\u05d9\u05d9\u05db\u05d4 \u05db\u05e9\u05e0\u05db\u05e0\u05e1\u05ea\u05d9 \u05dc\u05d7\u05d3\u05e8'. \u05d1\u05d0\u05d9\u05d6\u05d4 \u05de\u05e6\u05d1 \u05d8\u05e8\u05d5\u05dd-\u05de\u05e0\u05d8\u05dc\u05d9\u05e1\u05d8\u05d9 (pre-mentalizing mode) \u05d4\u05d9\u05d0 \u05e0\u05de\u05e6\u05d0\u05ea?",
      "answerOptions": [
        {
          "text": "Psychic Equivalence (\u05e9\u05e7\u05d9\u05dc\u05d5\u05ea \u05e0\u05e4\u05e9\u05d9\u05ea).",
          "isCorrect": true,
          "rationale": "\u05d1\u05de\u05e6\u05d1 \u05d6\u05d4 \u05d0\u05d9\u05df \u05d4\u05d1\u05d7\u05e0\u05d4 \u05d1\u05d9\u05df \u05d4\u05de\u05e6\u05d9\u05d0\u05d5\u05ea \u05d4\u05e4\u05e0\u05d9\u05de\u05d9\u05ea \u05dc\u05d7\u05d9\u05e6\u05d5\u05e0\u05d9\u05ea; \u05de\u05d4 \u05e9\u05e0\u05ea\u05e4\u05e1 \u05d1\u05e0\u05e4\u05e9 \u05e0\u05d7\u05d5\u05d5\u05d4 \u05db\u05d0\u05de\u05ea \u05d0\u05d5\u05d1\u05d9\u05d9\u05e7\u05d8\u05d9\u05d1\u05d9\u05ea \u05d1\u05dc\u05ea\u05d9 \u05e0\u05d9\u05ea\u05e0\u05ea \u05dc\u05e2\u05e8\u05e2\u05d5\u05e8 (Synopsis ch.23)."
        },
        {
          "text": "Pretend mode (\u05de\u05e6\u05d1 \u05db\u05d0\u05d9\u05dc\u05d5).",
          "isCorrect": false,
          "rationale": "\u05d1\u05de\u05e6\u05d1 '\u05db\u05d0\u05d9\u05dc\u05d5' \u05e7\u05d9\u05d9\u05dd \u05e0\u05ea\u05e7 \u05d1\u05d9\u05df \u05d4\u05e8\u05d2\u05e9 \u05dc\u05ea\u05d5\u05db\u05df, \u05d5\u05d4\u05de\u05d7\u05e9\u05d1\u05d5\u05ea \u05d0\u05d9\u05e0\u05df \u05de\u05e2\u05d5\u05d2\u05e0\u05d5\u05ea \u05d1\u05de\u05e6\u05d9\u05d0\u05d5\u05ea (Synopsis ch.23)."
        },
        {
          "text": "Teleological mode (\u05de\u05e6\u05d1 \u05d8\u05dc\u05d0\u05d5\u05dc\u05d5\u05d2\u05d9).",
          "isCorrect": false,
          "rationale": "\u05d1\u05de\u05e6\u05d1 \u05d8\u05dc\u05d0\u05d5\u05dc\u05d5\u05d2\u05d9, \u05e8\u05e7 \u05e4\u05e2\u05d5\u05dc\u05d5\u05ea \u05e4\u05d9\u05d6\u05d9\u05d5\u05ea \u05e0\u05ea\u05e4\u05e1\u05d5\u05ea \u05db\u05d1\u05d9\u05d8\u05d5\u05d9 \u05dc\u05de\u05e6\u05d1\u05d9\u05dd \u05e0\u05e4\u05e9\u05d9\u05d9\u05dd (\u05dc\u05de\u05e9\u05dc, '\u05d4\u05d5\u05d0 \u05d0\u05d5\u05d4\u05d1 \u05d0\u05d5\u05ea\u05d9 \u05e8\u05e7 \u05d0\u05dd \u05d4\u05d5\u05d0 \u05e7\u05d5\u05e0\u05d4 \u05dc\u05d9 \u05de\u05ea\u05e0\u05d4') (Synopsis ch.23)."
        },
        {
          "text": "Reflective Functioning (RF) \u05d2\u05d1\u05d5\u05d4.",
          "isCorrect": false,
          "rationale": "RF \u05d2\u05d1\u05d5\u05d4 \u05de\u05e2\u05d9\u05d3 \u05e2\u05dc \u05d9\u05db\u05d5\u05dc\u05ea \u05d8\u05d5\u05d1\u05d4 \u05dc\u05d4\u05d1\u05d9\u05df \u05de\u05e6\u05d1\u05d9\u05dd \u05e0\u05e4\u05e9\u05d9\u05d9\u05dd, \u05d4\u05e4\u05d5\u05da \u05dc\u05d7\u05dc\u05d5\u05d8\u05d9\u05df \u05de\u05d4\u05d7\u05e9\u05d9\u05d1\u05d4 \u05d4\u05e7\u05d5\u05e0\u05e7\u05e8\u05d8\u05d9\u05ea \u05d5\u05d4\u05e0\u05d5\u05e7\u05e9\u05d4 \u05d4\u05de\u05d5\u05d3\u05d2\u05de\u05ea \u05d1\u05de\u05e7\u05e8\u05d4 \u05d6\u05d4 (Dulcan p.971)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05de\u05e6\u05d1 \u05d1\u05d5 '\u05e4\u05e0\u05d9\u05dd \u05e9\u05d5\u05d5\u05d4 \u05dc\u05d7\u05d5\u05e5' \u05dc\u05dc\u05d0 \u05de\u05e8\u05d7\u05d1 \u05e9\u05dc \u05e1\u05e4\u05e7 \u05d0\u05d5 \u05e4\u05e8\u05e9\u05e0\u05d5\u05ea."
    },
    {
      "type": "short_answer",
      "question": "\u05de\u05d4\u05df \u05e9\u05ea\u05d9 \u05e0\u05e7\u05d5\u05d3\u05d5\u05ea \u05d4\u05de\u05d7\u05dc\u05d5\u05e7\u05ea \u05d4\u05de\u05e8\u05db\u05d6\u05d9\u05d5\u05ea \u05d1\u05d9\u05df Heinz Kohut \u05dc\u05d1\u05d9\u05df Otto Kernberg \u05d1\u05e0\u05d5\u05d2\u05e2 \u05dc\u05d4\u05d1\u05e0\u05ea \u05d4\u05e4\u05e8\u05e2\u05ea \u05d0\u05d9\u05e9\u05d9\u05d5\u05ea \u05e0\u05e8\u05e7\u05d9\u05e1\u05d9\u05e1\u05d8\u05d9\u05ea (NPD)?",
      "grading": {
        "modelAnswer": "\u05e7\u05d5\u05d4\u05d5\u05d8 \u05e8\u05d0\u05d4 \u05d1\u05e0\u05e8\u05e7\u05d9\u05e1\u05d9\u05d6\u05dd \u05e4\u05ea\u05d5\u05dc\u05d5\u05d2\u05d9 '\u05e2\u05e6\u05d9\u05e8\u05d4 \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9\u05ea' (Developmental Arrest) \u05d5\u05e6\u05d5\u05e8\u05da \u05d1\u05e2\u05de\u05d3\u05d4 \u05d0\u05de\u05e4\u05ea\u05d9\u05ea \u05d5\u05de\u05e9\u05e7\u05e4\u05ea, \u05d1\u05e2\u05d5\u05d3 \u05e7\u05e8\u05e0\u05d1\u05e8\u05d2 \u05e8\u05d0\u05d4 \u05d1\u05d5 '\u05de\u05d1\u05e0\u05d4 \u05d4\u05d2\u05e0\u05ea\u05d9 \u05e4\u05ea\u05d5\u05dc\u05d5\u05d2\u05d9' \u05d4\u05d3\u05d5\u05e8\u05e9 \u05e2\u05d9\u05de\u05d5\u05ea \u05de\u05d5\u05e7\u05d3\u05dd (confrontation) \u05d5\u05e4\u05d9\u05e8\u05d5\u05e9 \u05e9\u05dc \u05d4\u05ea\u05d5\u05e7\u05e4\u05e0\u05d5\u05ea (Synopsis ch.34.4).",
        "rationale": "\u05d4\u05d4\u05d1\u05d3\u05dc \u05d8\u05de\u05d5\u05df \u05d1\u05e9\u05d0\u05dc\u05d4 \u05d4\u05d0\u05dd \u05d4\u05d2\u05e8\u05e0\u05d3\u05d9\u05d5\u05d6\u05d9\u05d5\u05ea \u05d4\u05d9\u05d0 \u05e6\u05d5\u05e8\u05da \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9 \u05e9\u05dc\u05d0 \u05e0\u05e2\u05e0\u05d4 \u05d0\u05d5 \u05de\u05d1\u05e0\u05d4 \u05d4\u05d2\u05e0\u05ea\u05d9 \u05e9\u05e0\u05d5\u05e2\u05d3 \u05dc\u05d4\u05d2\u05df \u05de\u05e4\u05e0\u05d9 \u05d6\u05e2\u05dd \u05d5\u05ea\u05d5\u05e7\u05e4\u05e0\u05d5\u05ea (Synopsis ch.34.4).",
        "requiredAttributes": [
          "\u05e6\u05d9\u05d5\u05df \u05e7\u05d5\u05d4\u05d5\u05d8 \u05db\u05de\u05d9 \u05e9\u05e8\u05d0\u05d4 \u05d1\u05d6\u05d4 \u05e2\u05e6\u05d9\u05e8\u05d4 \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9\u05ea/Developmental Arrest.",
          "\u05e6\u05d9\u05d5\u05df \u05e7\u05e8\u05e0\u05d1\u05e8\u05d2 \u05db\u05de\u05d9 \u05e9\u05e8\u05d0\u05d4 \u05d1\u05d6\u05d4 \u05de\u05d1\u05e0\u05d4 \u05d4\u05d2\u05e0\u05ea\u05d9 \u05e4\u05ea\u05d5\u05dc\u05d5\u05d2\u05d9.",
          "\u05d4\u05ea\u05d9\u05d9\u05d7\u05e1\u05d5\u05ea \u05dc\u05d4\u05d1\u05d3\u05dc \u05d1\u05d8\u05db\u05e0\u05d9\u05e7\u05d4 (\u05d0\u05de\u05e4\u05ea\u05d9\u05d4 \u05de\u05d5\u05dc \u05e2\u05d9\u05de\u05d5\u05ea/\u05e4\u05d9\u05e8\u05d5\u05e9)."
        ],
        "errors": {
          "misconceptions": [
            "\u05d4\u05e0\u05d7\u05d4 \u05e9\u05e9\u05e0\u05d9\u05d4\u05dd \u05de\u05e1\u05db\u05d9\u05de\u05d9\u05dd \u05e2\u05dc \u05db\u05da \u05e9\u05e0\u05e8\u05e7\u05d9\u05e1\u05d9\u05d6\u05dd \u05d4\u05d5\u05d0 \u05ea\u05de\u05d9\u05d3 \u05d4\u05d2\u05e0\u05d4 \u05e2\u05dc \u05d4\u05e2\u05e8\u05db\u05d4 \u05e2\u05e6\u05de\u05d9\u05ea \u05e0\u05de\u05d5\u05db\u05d4."
