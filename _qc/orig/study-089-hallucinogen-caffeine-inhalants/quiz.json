    {
      "type": "multiple_choice",
      "question": "\u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05e2\u05e8\u05db\u05ea SUD \u05d1\u05de\u05ea\u05d1\u05d2\u05e8, \u05de\u05d4\u05d9 \u05d4\u05de\u05e9\u05de\u05e2\u05d5\u05ea \u05e9\u05dc \u05ea\u05d5\u05e6\u05d0\u05ea '2' \u05d1\u05e9\u05d0\u05dc\u05d5\u05df \u05d4\u05e1\u05e7\u05d9\u05e8\u05d4 CRAFFT \u05dc\u05e4\u05d9 Dulcan?",
      "answerOptions": [
        {
          "text": "\u05d4\u05ea\u05d5\u05e6\u05d0\u05d4 \u05de\u05e2\u05d9\u05d3\u05d4 \u05e2\u05dc \u05e1\u05d9\u05db\u05d5\u05df \u05d2\u05d1\u05d5\u05d4 \u05dc-SUD \u05d5\u05de\u05d7\u05d9\u05d9\u05d1\u05ea \u05d4\u05e4\u05e0\u05d9\u05d4 \u05dc\u05d4\u05e2\u05e8\u05db\u05d4 \u05de\u05e7\u05d9\u05e4\u05d4.",
          "isCorrect": true,
          "rationale": "\u05e0\u05d9\u05e7\u05d5\u05d3 \u05e9\u05dc 2 \u05d5\u05de\u05e2\u05dc\u05d4 \u05d1\u05e9\u05d0\u05dc\u05d5\u05df \u05d4-CRAFFT \u05e0\u05d7\u05e9\u05d1 \u05dc-positive screen \u05e9\u05de\u05d7\u05d9\u05d9\u05d1 \u05d4\u05de\u05e9\u05da \u05d1\u05d9\u05e8\u05d5\u05e8 \u05de\u05e2\u05de\u05d9\u05e7 (Dulcan p.230)."
        },
        {
          "text": "\u05d4\u05ea\u05d5\u05e6\u05d0\u05d4 \u05de\u05e2\u05d9\u05d3\u05d4 \u05e2\u05dc \u05e9\u05d9\u05de\u05d5\u05e9 \u05de\u05d6\u05d3\u05de\u05df \u05d1\u05dc\u05d1\u05d3 \u05d4\u05de\u05d7\u05d9\u05d9\u05d1 \u05d4\u05ea\u05e2\u05e8\u05d1\u05d5\u05ea \u05e7\u05e6\u05e8\u05d4 (Brief intervention).",
          "isCorrect": false,
          "rationale": "\u05d4\u05ea\u05e2\u05e8\u05d1\u05d5\u05ea \u05e7\u05e6\u05e8\u05d4 \u05dc\u05e9\u05d9\u05de\u05d5\u05e9 \u05de\u05d6\u05d3\u05de\u05df \u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05ea \u05e0\u05d9\u05e7\u05d5\u05d3 \u05e0\u05de\u05d5\u05da \u05d9\u05d5\u05ea\u05e8 \u05d0\u05d5 \u05e9\u05dc\u05d1\u05d9\u05dd \u05de\u05d5\u05e7\u05d3\u05de\u05d9\u05dd \u05d1-S2BI, \u05d0\u05da \u05d1-CRAFFT \u05e0\u05d9\u05e7\u05d5\u05d3 2 \u05d4\u05d5\u05d0 \u05db\u05d1\u05e8 \u05e1\u05e3 \u05d2\u05d1\u05d5\u05d4 (Dulcan p.230)."
        },
        {
          "text": "\u05d4\u05ea\u05d5\u05e6\u05d0\u05d4 \u05ea\u05e7\u05d9\u05e0\u05d4 (Negative) \u05d5\u05d3\u05d5\u05e8\u05e9\u05ea \u05e8\u05e7 \u05d7\u05d9\u05d6\u05d5\u05e7 \u05d7\u05d9\u05d5\u05d1\u05d9 \u05dc\u05de\u05e0\u05d9\u05e2\u05d4.",
          "isCorrect": false,
          "rationale": "\u05e0\u05d9\u05e7\u05d5\u05d3 0 \u05d4\u05d5\u05d0 \u05e9\u05dc\u05d9\u05dc\u05d9; \u05db\u05dc \u05e0\u05d9\u05e7\u05d5\u05d3 \u05de\u05e2\u05dc 1 \u05de\u05e2\u05dc\u05d4 \u05d7\u05e9\u05d3 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9 (Dulcan p.230)."
        },
        {
          "text": "\u05d4\u05ea\u05d5\u05e6\u05d0\u05d4 \u05de\u05d7\u05d9\u05d9\u05d1\u05ea \u05d0\u05e9\u05e4\u05d5\u05d6 \u05db\u05e4\u05d5\u05d9 \u05de\u05d9\u05d3\u05d9 \u05d1\u05e9\u05dc \u05e1\u05db\u05e0\u05d4 \u05d0\u05d5\u05d1\u05d3\u05e0\u05d9\u05ea.",
          "isCorrect": false,
          "rationale": "\u05e9\u05d0\u05dc\u05d5\u05df \u05d4-CRAFFT \u05d1\u05d5\u05d3\u05e7 \u05d4\u05e8\u05d2\u05dc\u05d9 \u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05e1\u05de\u05d9\u05dd \u05d5\u05dc\u05d0 \u05e1\u05d9\u05db\u05d5\u05df \u05d0\u05d5\u05d1\u05d3\u05e0\u05d9, \u05d5\u05d0\u05d9\u05e0\u05d5 \u05de\u05d4\u05d5\u05d5\u05d4 \u05e2\u05d9\u05dc\u05d4 \u05dc\u05d0\u05e9\u05e4\u05d5\u05d6 \u05db\u05e4\u05d5\u05d9 \u05db\u05e9\u05dc\u05e2\u05e6\u05de\u05d5 (Dulcan p.230)."
        }
      ],
      "hint": "\u05d6\u05db\u05d5\u05e8 \u05d0\u05ea \u05d4'Cut-off' \u05d4\u05de\u05e7\u05d5\u05d1\u05dc \u05d1\u05e9\u05d0\u05dc\u05d5\u05df \u05d6\u05d4 \u05dc\u05d6\u05d9\u05d4\u05d5\u05d9 \u05e1\u05d9\u05db\u05d5\u05df.",
