      "hint": "\u05d4\u05ea\u05d4\u05dc\u05d9\u05da \u05db\u05d5\u05dc\u05dc '\u05d3\u05d9\u05e1-\u05d0\u05d9\u05e0\u05d4\u05d9\u05d1\u05d9\u05e6\u05d9\u05d4' (Disinhibition) \u05e9\u05dc \u05e0\u05d5\u05d9\u05e8\u05d5\u05e0\u05d9\u05dd \u05de\u05e2\u05d5\u05e8\u05e8\u05d9\u05dd.",
      "imageUrls": []
