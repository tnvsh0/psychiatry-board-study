    {
      "type": "multiple_choice",
      "question": "\u05e1\u05d8\u05d5\u05d3\u05e0\u05d8\u05d9\u05ea \u05d1\u05ea 24 \u05de\u05d3\u05d5\u05d5\u05d7\u05ea \u05e2\u05dc \u05db\u05d0\u05d1 \u05e8\u05d0\u05e9 \u05e4\u05d5\u05e2\u05dd (throbbing) \u05e7\u05e9\u05d4, \u05e2\u05d9\u05d9\u05e4\u05d5\u05ea \u05e0\u05d9\u05db\u05e8\u05ea, \u05d5\u05e8\u05d5\u05d2\u05d6\u05e0\u05d5\u05ea \u05e9\u05d4\u05d7\u05dc\u05d5 \u05d4\u05d1\u05d5\u05e7\u05e8. \u05d4\u05d9\u05d0 \u05de\u05e6\u05d9\u05d9\u05e0\u05ea \u05db\u05d9 \u05d4\u05d7\u05dc\u05d9\u05d8\u05d4 \u05dc\u05d4\u05e4\u05e1\u05d9\u05e7 \u05d1\u05d1\u05ea-\u05d0\u05d7\u05ea \u05d0\u05ea \u05e6\u05e8\u05d9\u05db\u05ea \u05d4\u05e7\u05e4\u05d4 \u05d4\u05d9\u05d5\u05de\u05d9\u05ea \u05e9\u05dc\u05d4 (4 \u05db\u05d5\u05e1\u05d5\u05ea \u05d1\u05d9\u05d5\u05dd) \u05de\u05d0\u05ea\u05de\u05d5\u05dc. \u05de\u05d4\u05d5 \u05d4\u05de\u05d4\u05dc\u05da \u05d4\u05e6\u05e4\u05d5\u05d9 \u05e9\u05dc \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d0\u05dc\u05d5 \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR?",
      "answerOptions": [
        {
          "text": "\u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d9\u05d2\u05d9\u05e2\u05d5 \u05dc\u05e9\u05d9\u05d0 \u05ea\u05d5\u05da 1-2 \u05d9\u05de\u05d9\u05dd \u05d5\u05d9\u05d9\u05de\u05e9\u05db\u05d5 \u05dc\u05e8\u05d5\u05d1 \u05d1\u05d9\u05df 2 \u05dc-9 \u05d9\u05de\u05d9\u05dd.",
          "isCorrect": true,
          "rationale": "\u05ea\u05e1\u05de\u05d9\u05e0\u05d9 \u05d2\u05de\u05d9\u05dc\u05d4 \u05de\u05e7\u05e4\u05d0\u05d9\u05df \u05de\u05ea\u05d7\u05d9\u05dc\u05d9\u05dd \u05ea\u05d5\u05da 12-24 \u05e9\u05e2\u05d5\u05ea, \u05de\u05d2\u05d9\u05e2\u05d9\u05dd \u05dc\u05e9\u05d9\u05d0 \u05d1\u05d9\u05d5\u05dd \u05d4\u05e8\u05d0\u05e9\u05d5\u05df \u05d0\u05d5 \u05d4\u05e9\u05e0\u05d9, \u05d5\u05d7\u05d5\u05dc\u05e4\u05d9\u05dd \u05ea\u05d5\u05da \u05db\u05e9\u05d1\u05d5\u05e2 (DSM p.573)."
        },
        {
          "text": "\u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d9\u05d7\u05dc\u05e4\u05d5 \u05ea\u05d5\u05da 30-60 \u05d3\u05e7\u05d5\u05ea \u05de\u05e8\u05d2\u05e2 \u05e9\u05ea\u05e6\u05e8\u05d5\u05da \u05de\u05e0\u05d4 \u05e7\u05d8\u05e0\u05d4 \u05e9\u05dc \u05e7\u05e4\u05d0\u05d9\u05df.",
          "isCorrect": false,
          "rationale": "\u05d0\u05de\u05e0\u05dd \u05d6\u05d5 \u05d8\u05e2\u05e0\u05d4 \u05e0\u05db\u05d5\u05e0\u05d4 \u05e4\u05d9\u05d6\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea, \u05d0\u05da \u05d4\u05e9\u05d0\u05dc\u05d4 \u05d1\u05d9\u05e7\u05e9\u05d4 \u05d0\u05ea \u05d4\u05de\u05d4\u05dc\u05da \u05d4\u05e6\u05e4\u05d5\u05d9 (prognosis) \u05e9\u05dc \u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d4\u05e0\u05d5\u05db\u05d7\u05d9\u05d9\u05dd \u05dc\u05dc\u05d0 \u05d4\u05ea\u05e2\u05e8\u05d1\u05d5\u05ea (DSM p.573)."
        },
        {
          "text": "\u05db\u05d0\u05d1\u05d9 \u05d4\u05e8\u05d0\u05e9 \u05d9\u05d7\u05de\u05d9\u05e8\u05d5 \u05d1\u05d4\u05d3\u05e8\u05d2\u05d4 \u05d5\u05d9\u05d9\u05de\u05e9\u05db\u05d5 \u05d7\u05d5\u05d3\u05e9 \u05dc\u05e4\u05d7\u05d5\u05ea \u05dc\u05dc\u05d0 \u05d8\u05d9\u05e4\u05d5\u05dc \u05ea\u05e8\u05d5\u05e4\u05ea\u05d9.",
          "isCorrect": false,
          "rationale": "\u05dc\u05e4\u05d9 \u05d4-DSM, \u05db\u05d0\u05d1\u05d9 \u05e8\u05d0\u05e9 \u05e2\u05e9\u05d5\u05d9\u05d9\u05dd \u05dc\u05d4\u05d9\u05de\u05e9\u05da \u05e2\u05d3 21 \u05d9\u05d5\u05dd \u05d1\u05de\u05e7\u05e8\u05d9\u05dd \u05e7\u05d9\u05e6\u05d5\u05e0\u05d9\u05d9\u05dd, \u05d0\u05da \u05d4\u05de\u05d4\u05dc\u05da \u05d4\u05e1\u05d8\u05e0\u05d3\u05e8\u05d8\u05d9 \u05e7\u05e6\u05e8 \u05d1\u05d4\u05e8\u05d1\u05d4 (DSM p.573)."
        },
        {
          "text": "\u05de\u05d3\u05d5\u05d1\u05e8 \u05d1\u05de\u05e6\u05d1 \u05d7\u05d9\u05e8\u05d5\u05dd \u05e8\u05e4\u05d5\u05d0\u05d9 \u05d4\u05de\u05d7\u05d9\u05d9\u05d1 \u05d0\u05e9\u05e4\u05d5\u05d6 \u05dc\u05de\u05e0\u05d9\u05e2\u05ea \u05e4\u05e8\u05db\u05d5\u05e1\u05d9\u05dd.",
          "isCorrect": false,
          "rationale": "\u05d2\u05de\u05d9\u05dc\u05d4 \u05de\u05e7\u05e4\u05d0\u05d9\u05df \u05d2\u05d5\u05e8\u05de\u05ea \u05dc\u05de\u05e6\u05d5\u05e7\u05d4 \u05d0\u05da \u05d0\u05d9\u05e0\u05d4 \u05de\u05e1\u05db\u05e0\u05ea \u05d7\u05d9\u05d9\u05dd \u05d5\u05d0\u05d9\u05e0\u05d4 \u05d2\u05d5\u05e8\u05de\u05ea \u05dc\u05e4\u05e8\u05db\u05d5\u05e1\u05d9\u05dd, \u05d1\u05e0\u05d9\u05d2\u05d5\u05d3 \u05dc\u05d2\u05de\u05d9\u05dc\u05d4 \u05de\u05d0\u05dc\u05db\u05d5\u05d4\u05d5\u05dc \u05d0\u05d5 \u05d1\u05e0\u05d6\u05d5\u05d3\u05d9\u05d0\u05d6\u05e4\u05d9\u05e0\u05d9\u05dd (DSM p.572)."
        }
      ],
      "hint": "\u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e9\u05dc \u05d2\u05de\u05d9\u05dc\u05d4 \u05d6\u05d5 \u05d4\u05dd \u05e7\u05e6\u05e8\u05d9 \u05de\u05d5\u05e2\u05d3 \u05d9\u05d7\u05e1\u05d9\u05ea \u05d5\u05de\u05d2\u05d9\u05e2\u05d9\u05dd \u05dc\u05e9\u05d9\u05d0 \u05de\u05d4\u05d9\u05e8.",
      "imageUrls": []
    },
    {
      "type": "multiple_select",
      "question": "\u05de\u05ea\u05d1\u05d2\u05e8 \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05d1-Inhalants (\u05d7\u05d5\u05de\u05e8\u05d9\u05dd \u05e0\u05d3\u05d9\u05e4\u05d9\u05dd) \u05d1\u05d0\u05d5\u05e4\u05df \u05db\u05e8\u05d5\u05e0\u05d9 \u05e0\u05de\u05e6\u05d0 \u05d1\u05e1\u05d9\u05db\u05d5\u05df \u05d2\u05d1\u05d5\u05d4 \u05dc\u05e0\u05d6\u05e7\u05d9\u05dd \u05e0\u05d5\u05d9\u05e8\u05d5\u05dc\u05d5\u05d2\u05d9\u05d9\u05dd \u05d1\u05dc\u05ea\u05d9 \u05d4\u05e4\u05d9\u05db\u05d9\u05dd. \u05d0\u05d9\u05dc\u05d5 \u05de\u05d4\u05de\u05de\u05e6\u05d0\u05d9\u05dd \u05d4\u05d1\u05d0\u05d9\u05dd \u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9\u05dd \u05e4\u05d2\u05d9\u05e2\u05d4 \u05d6\u05d5 \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR \u05d5-StahlNeuro?",
      "answerOptions": [
        {
          "text": "Leukoencephalopathy \u05d5\u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd \u05de\u05d5\u05e4\u05e9\u05d8\u05d9\u05dd \u05d1\u05d7\u05d5\u05de\u05e8 \u05d4\u05dc\u05d1\u05df (White matter).",
          "isCorrect": true,
          "rationale": "\u05d8\u05d5\u05dc\u05d5\u05d0\u05df (Toluene) \u05d5\u05d7\u05d5\u05de\u05e8\u05d9\u05dd \u05e0\u05d3\u05d9\u05e4\u05d9\u05dd \u05d0\u05d7\u05e8\u05d9\u05dd \u05de\u05de\u05d9\u05e1\u05d9\u05dd \u05e9\u05d5\u05de\u05e0\u05d9\u05dd \u05d5\u05e4\u05d5\u05d2\u05e2\u05d9\u05dd \u05d9\u05e9\u05d9\u05e8\u05d5\u05ea \u05d1\u05de\u05d9\u05d0\u05dc\u05d9\u05df, \u05de\u05d4 \u05e9\u05de\u05d5\u05d1\u05d9\u05dc \u05dc\u05d4\u05e8\u05e1 \u05d4\u05d7\u05d5\u05de\u05e8 \u05d4\u05dc\u05d1\u05df (DSM p.603, p.712)."
        },
        {
          "text": "\u05d9\u05e8\u05d9\u05d3\u05d4 \u05d1\u05de\u05d4\u05d9\u05e8\u05d5\u05ea \u05d4\u05e2\u05d9\u05d1\u05d5\u05d3 \u05d4\u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9 \u05d5\u05e4\u05d2\u05d9\u05e2\u05d4 \u05d1\u05ea\u05e4\u05e7\u05d5\u05d3\u05d9\u05dd \u05e0\u05d9\u05d4\u05d5\u05dc\u05d9\u05d9\u05dd (Executive functions).",
          "isCorrect": true,
          "rationale": "\u05d4\u05e4\u05d2\u05d9\u05e2\u05d4 \u05d4\u05dc\u05d1\u05e0\u05d4 \u05de\u05ea\u05d1\u05d8\u05d0\u05ea \u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05d1\u05d4\u05d0\u05d8\u05d4 \u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9\u05ea \u05d5\u05d1\u05e7\u05d5\u05e9\u05d9 \u05d1\u05de\u05d1\u05d7\u05e0\u05d9\u05dd \u05db\u05de\u05d5 Stroop \u05d5-Wisconsin Card Sorting (DSM p.714)."
        },
        {
          "text": "\u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05de\u05d5\u05d5\u05ea \u05e4\u05ea\u05d0\u05d5\u05de\u05d9 (Sudden Sniffing Death) \u05e2\u05e7\u05d1 \u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05e7\u05e6\u05d1 \u05dc\u05d1\u05d1\u05d9\u05d5\u05ea.",
          "isCorrect": true,
          "rationale": "\u05d7\u05e9\u05d9\u05e4\u05d4 \u05dc\u05e4\u05d7\u05de\u05d9\u05de\u05e0\u05d9\u05dd \u05e0\u05d3\u05d9\u05e4\u05d9\u05dd \u05d2\u05d5\u05e8\u05de\u05ea \u05dc\u05e8\u05d2\u05d9\u05e9\u05d5\u05ea-\u05d9\u05ea\u05e8 \u05e9\u05dc \u05e9\u05e8\u05d9\u05e8 \u05d4\u05dc\u05d1 \u05dc\u05e7\u05d8\u05db\u05d5\u05dc\u05d0\u05de\u05d9\u05e0\u05d9\u05dd, \u05de\u05d4 \u05e9\u05e2\u05dc\u05d5\u05dc \u05dc\u05d4\u05d5\u05d1\u05d9\u05dc \u05dc\u05e4\u05e8\u05e4\u05d5\u05e8 \u05d7\u05d3\u05e8\u05d9\u05dd \u05e7\u05d8\u05dc\u05e0\u05d9 (DSM p.604)."
        },
        {
          "text": "\u05e6\u05d1\u05d9\u05e8\u05d4 \u05e9\u05dc \u05de\u05e9\u05e7\u05e2\u05d9 Amyloid plaques \u05d1\u05e7\u05dc\u05d9\u05e4\u05ea \u05d4\u05de\u05d5\u05d7.",
          "isCorrect": false,
          "rationale": "\u05d6\u05d4\u05d5 \u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05e9\u05dc \u05de\u05d7\u05dc\u05ea \u05d0\u05dc\u05e6\u05d4\u05d9\u05d9\u05de\u05e8, \u05d5\u05dc\u05d0 \u05e9\u05dc \u05e8\u05e2\u05d9\u05dc\u05d5\u05ea \u05de\u05d7\u05d5\u05de\u05e8\u05d9\u05dd \u05e0\u05d3\u05d9\u05e4\u05d9\u05dd \u05d4\u05de\u05ea\u05de\u05e7\u05d3\u05ea \u05d1\u05d7\u05d5\u05de\u05e8 \u05d4\u05dc\u05d1\u05df (StahlNeuro p.109)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05de\u05e8\u05db\u05d9\u05d1 \u05d4\u05e2\u05d9\u05e7\u05e8\u05d9 \u05e9\u05dc \u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05e2\u05e6\u05d1\u05d9\u05dd \u05e9\u05e0\u05e4\u05d2\u05e2 \u05de\u05d7\u05d5\u05de\u05e8\u05d9\u05dd \u05d4\u05de\u05de\u05d9\u05e1\u05d9\u05dd \u05e9\u05d5\u05de\u05df.",
      "hasAllOfTheAbove": false,
      "hasNoneOfTheAbove": false
    },
    {
      "type": "short_answer",
      "question": "\u05d1\u05de\u05e7\u05e8\u05d4 \u05e9\u05dc \u05d4\u05d7\u05d9\u05d9\u05d0\u05ea \u05de\u05d8\u05d5\u05e4\u05dc \u05e9\u05e0\u05de\u05e6\u05d0 \u05d1\u05de\u05e6\u05d1 \u05e9\u05dc \u05d3\u05d5\u05dd \u05dc\u05d1 \u05de\u05d9\u05d3 \u05dc\u05d0\u05d7\u05e8 \u05e9\u05d0\u05d9\u05e4\u05ea \u05d7\u05d5\u05de\u05e8\u05d9\u05dd \u05e0\u05d3\u05d9\u05e4\u05d9\u05dd (Inhalant Intoxication), \u05de\u05d3\u05d5\u05e2 \u05d9\u05e9 \u05dc\u05d4\u05d9\u05de\u05e0\u05e2 \u05de\u05de\u05ea\u05df Epinephrine (\u05d0\u05e4\u05d9\u05e0\u05e4\u05e8\u05d9\u05df)?",
      "grading": {
        "modelAnswer": "\u05d9\u05e9 \u05dc\u05d4\u05d9\u05de\u05e0\u05e2 \u05de\u05de\u05ea\u05df \u05d0\u05e4\u05d9\u05e0\u05e4\u05e8\u05d9\u05df \u05d0\u05d5 \u05de\u05de\u05e8\u05d9\u05e6\u05d9\u05dd \u05e1\u05d9\u05de\u05e4\u05ea\u05d5\u05de\u05d9\u05d9\u05de\u05d8\u05d9\u05d9\u05dd \u05de\u05db\u05d9\u05d5\u05d5\u05df \u05e9\u05e4\u05d7\u05de\u05d9\u05de\u05e0\u05d9\u05dd \u05e0\u05d3\u05d9\u05e4\u05d9\u05dd \u05d2\u05d5\u05e8\u05de\u05d9\u05dd \u05dc-Myocardial Sensitization (\u05e8\u05d2\u05d9\u05e9\u05d5\u05ea-\u05d9\u05ea\u05e8 \u05e9\u05dc \u05e9\u05e8\u05d9\u05e8 \u05d4\u05dc\u05d1). \u05de\u05ea\u05df \u05e7\u05d8\u05db\u05d5\u05dc\u05d0\u05de\u05d9\u05e0\u05d9\u05dd \u05d1\u05de\u05e6\u05d1 \u05d6\u05d4 \u05e2\u05dc\u05d5\u05dc \u05dc\u05d4\u05e9\u05e8\u05d5\u05ea \u05e4\u05e8\u05e4\u05d5\u05e8 \u05d7\u05d3\u05e8\u05d9\u05dd (Ventricular Fibrillation) \u05e7\u05d8\u05dc\u05e0\u05d9 \u05d5\u05dc\u05d4\u05d5\u05d1\u05d9\u05dc \u05dc-'Sudden Sniffing Death'.",
        "rationale": "\u05d4\u05e4\u05d9\u05d6\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05d4 \u05e9\u05dc \u05d4\u05dc\u05d1 \u05ea\u05d7\u05ea \u05d4\u05e9\u05e4\u05e2\u05ea \u05de\u05de\u05e1\u05d9\u05dd \u05e0\u05d3\u05d9\u05e4\u05d9\u05dd \u05de\u05e9\u05ea\u05e0\u05d4 \u05db\u05da \u05e9\u05d2\u05d9\u05e8\u05d5\u05d9 \u05d0\u05d3\u05e8\u05e0\u05e8\u05d2\u05d9 \u05d4\u05d5\u05e4\u05da \u05dc\u05de\u05e1\u05d5\u05db\u05df \u05d1\u05de\u05e7\u05d5\u05dd \u05dc\u05de\u05e6\u05d9\u05dc \u05d7\u05d9\u05d9\u05dd.",
        "requiredAttributes": [
          "\u05e6\u05d9\u05d5\u05df \u05d4\u05de\u05d5\u05e9\u05d2 Myocardial Sensitization \u05d0\u05d5 \u05e8\u05d2\u05d9\u05e9\u05d5\u05ea-\u05d9\u05ea\u05e8 \u05e9\u05dc \u05d4\u05dc\u05d1.",
          "\u05d4\u05e1\u05d1\u05e8 \u05e9\u05d4\u05d0\u05e4\u05d9\u05e0\u05e4\u05e8\u05d9\u05df \u05e2\u05dc\u05d5\u05dc \u05dc\u05d2\u05e8\u05d5\u05dd \u05dc\u05e4\u05e8\u05e4\u05d5\u05e8 \u05d7\u05d3\u05e8\u05d9\u05dd (Ventricular Fibrillation) \u05d0\u05d5 \u05d4\u05e4\u05e8\u05e2\u05ea \u05e7\u05e6\u05d1 \u05e7\u05d8\u05dc\u05e0\u05d9\u05ea.",
          "\u05e7\u05d9\u05e9\u05d5\u05e8 \u05dc\u05de\u05d5\u05e9\u05d2 Sudden Sniffing Death."
        ],
        "errors": {
          "misconceptions": [
