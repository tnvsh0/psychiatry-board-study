    {
      "type": "multiple_choice",
      "question": "\u05de\u05d4\u05d5 \u05d4\u05d4\u05e1\u05d1\u05e8 \u05d4\u05e0\u05d5\u05d9\u05e8\u05d5\u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05dc\u05e4\u05d9 StahlNeuro \u05dc\u05db\u05da \u05e9\u05de\u05ea\u05df Ketamine \u05d1\u05de\u05d9\u05e0\u05d5\u05e0\u05d9\u05dd \u05ea\u05ea-\u05d0\u05dc\u05d7\u05d5\u05e9\u05d9\u05d9\u05dd (subanesthetic doses) \u05d9\u05db\u05d5\u05dc \u05dc\u05d4\u05d5\u05d1\u05d9\u05dc \u05dc\u05e9\u05d9\u05e4\u05d5\u05e8 \u05de\u05d4\u05d9\u05e8 \u05d1\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05e9\u05dc \u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05e2\u05de\u05d9\u05d3?",
      "answerOptions": [
        {
          "text": "\u05d7\u05e1\u05d9\u05de\u05ea NMDA \u05e2\u05dc \u05d0\u05d9\u05e0\u05d8\u05e8\u05e0\u05d5\u05d9\u05e8\u05d5\u05e0\u05d9\u05dd \u05e9\u05dc GABA \u05d2\u05d5\u05e8\u05de\u05ea \u05dc-Glutamate burst \u05e9\u05de\u05e4\u05e2\u05d9\u05dc \u05de\u05e1\u05dc\u05d5\u05dc\u05d9 mTOR \u05d5-BDNF.",
          "isCorrect": true,
          "rationale": "\u05d7\u05e1\u05d9\u05de\u05ea \u05d4-NMDA \u05e2\u05dc \u05d4\u05d0\u05d9\u05e0\u05d8\u05e8\u05e0\u05d5\u05d9\u05e8\u05d5\u05e0\u05d9\u05dd \u05de\u05e9\u05d7\u05e8\u05e8\u05ea \u05d0\u05ea \u05d4\u05e2\u05d9\u05db\u05d5\u05d1 \u05e2\u05dc \u05d4\u05e0\u05d5\u05d9\u05e8\u05d5\u05e0\u05d9\u05dd \u05d4\u05e4\u05d9\u05e8\u05d9\u05de\u05d9\u05d3\u05dc\u05d9\u05d9\u05dd, \u05de\u05d4 \u05e9\u05d2\u05d5\u05e8\u05dd \u05dc\u05e9\u05d7\u05e8\u05d5\u05e8 \u05e4\u05e8\u05e6\u05d9 \u05d2\u05dc\u05d5\u05d8\u05de\u05d8 \u05e9\u05de\u05e4\u05e2\u05d9\u05dc\u05d9\u05dd AMPA receptors \u05d5\u05de\u05e2\u05d5\u05d3\u05d3\u05d9\u05dd \u05e1\u05d9\u05e0\u05e4\u05d8\u05d5\u05d2\u05e0\u05d6\u05d4 \u05de\u05d4\u05d9\u05e8\u05d4 (StahlNeuro p.330-331)."
        },
        {
          "text": "\u05e2\u05dc\u05d9\u05d9\u05d4 \u05d9\u05e9\u05d9\u05e8\u05d4 \u05d5\u05de\u05d9\u05d3\u05d9\u05ea \u05d1\u05e8\u05d9\u05db\u05d5\u05d6 \u05d4-Serotonin \u05d1\u05de\u05e8\u05d5\u05d5\u05d7 \u05d4\u05e1\u05d9\u05e0\u05e4\u05d8\u05d9 \u05d1-Prefrontal Cortex.",
          "isCorrect": false,
          "rationale": "\u05e7\u05d8\u05d0\u05de\u05d9\u05df \u05e4\u05d5\u05e2\u05dc \u05d1\u05e2\u05d9\u05e7\u05e8 \u05e2\u05dc \u05d4\u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05d2\u05dc\u05d5\u05d8\u05de\u05d8\u05e8\u05d2\u05d9\u05ea; \u05d4\u05e9\u05e4\u05e2\u05ea\u05d5 \u05e2\u05dc \u05d4\u05e1\u05e8\u05d5\u05d8\u05d5\u05e0\u05d9\u05df \u05d4\u05d9\u05d0 \u05de\u05e9\u05e0\u05d9\u05ea \u05d5\u05d7\u05dc\u05e9\u05d4 \u05de\u05d0\u05d5\u05d3 (StahlNeuro p.328)."
        },
        {
          "text": "\u05d3\u05d9\u05db\u05d5\u05d9 \u05e9\u05dc \u05de\u05e1\u05dc\u05d5\u05dc \u05d4-Mesolimbic Dopamine \u05dc\u05d4\u05e4\u05d7\u05ea\u05ea \u05ea\u05d7\u05d5\u05e9\u05ea \u05d4\u05d7\u05e8\u05d3\u05d4.",
          "isCorrect": false,
          "rationale": "\u05e7\u05d8\u05d0\u05de\u05d9\u05df \u05d3\u05d5\u05d5\u05e7\u05d0 \u05e2\u05e9\u05d5\u05d9 \u05dc\u05d4\u05e4\u05e2\u05d9\u05dc \u05de\u05e1\u05dc\u05d5\u05dc\u05d9\u05dd \u05d3\u05d5\u05e4\u05de\u05d9\u05e0\u05e8\u05d2\u05d9\u05d9\u05dd \u05db\u05ea\u05d5\u05e6\u05d0\u05d4 \u05de\u05d4\u05e4\u05e8\u05e5 \u05d4\u05d2\u05dc\u05d5\u05d8\u05de\u05d8\u05e8\u05d2\u05d9, \u05de\u05d4 \u05e9\u05e7\u05e9\u05d5\u05e8 \u05dc\u05d4\u05e9\u05e4\u05e2\u05d5\u05ea\u05d9\u05d5 \u05d4\u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d5\u05de\u05d9\u05de\u05d8\u05d9\u05d5\u05ea (StahlNeuro p.112)."
        },
        {
          "text": "\u05d9\u05d9\u05e6\u05d5\u05d1 \u05e9\u05dc \u05ea\u05e2\u05dc\u05d5\u05ea \u05e1\u05d9\u05d3\u05df \u05ea\u05dc\u05d5\u05d9\u05d5\u05ea \u05de\u05ea\u05d7 (VSCC) \u05dc\u05de\u05e0\u05d9\u05e2\u05ea \u05d0\u05e7\u05e1\u05d9\u05d8\u05d5\u05d8\u05d5\u05e7\u05e1\u05d9\u05e1\u05d9\u05d8\u05d9.",
