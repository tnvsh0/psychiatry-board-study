    {
      "type": "multiple_choice",
      "question": "\u05e0\u05e2\u05e8\u05d4 \u05d1\u05ea 16 \u05e2\u05dd \u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4 \u05e9\u05dc Bipolar II Disorder \u05de\u05d3\u05d5\u05d5\u05d7\u05ea \u05e2\u05dc \u05d4\u05d7\u05de\u05e8\u05d4 \u05d1\u05ea\u05d3\u05d9\u05e8\u05d5\u05ea \u05db\u05d0\u05d1\u05d9 \u05d4\u05e8\u05d0\u05e9 \u05e9\u05dc\u05d4, \u05d4\u05de\u05ea\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9\u05dd \u05d1\u05d0\u05d5\u05e4\u05d9 \u05e4\u05d5\u05e2\u05dd \u05d5\u05e4\u05d5\u05d8\u05d5\u05e4\u05d5\u05d1\u05d9\u05d4. \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR, \u05de\u05d4\u05d5 \u05d4\u05e7\u05e9\u05e8 \u05d4\u05d0\u05e4\u05d9\u05d3\u05de\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d1\u05d9\u05df \u05e9\u05ea\u05d9 \u05d4\u05d0\u05d1\u05d7\u05e0\u05d5\u05ea \u05d4\u05dc\u05dc\u05d5?",
      "answerOptions": [
        {
          "text": "Migraine \u05d4\u05d9\u05d0 \u05d0\u05d7\u05ea \u05d4\u05de\u05d7\u05dc\u05d5\u05ea \u05d4\u05e8\u05e4\u05d5\u05d0\u05d9\u05d5\u05ea \u05d4\u05e0\u05dc\u05d5\u05d5\u05ea \u05d4\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d1-Bipolar II Disorder.",
          "isCorrect": true,
          "rationale": "\u05dc\u05e4\u05d9 \u05d4-DSM-5-TR, \u05de\u05d9\u05d2\u05e8\u05e0\u05d4 \u05d4\u05d9\u05d0 \u05e7\u05d5\u05de\u05d5\u05e8\u05d1\u05d9\u05d3\u05d9\u05d5\u05ea \u05e8\u05e4\u05d5\u05d0\u05d9\u05ea \u05e9\u05db\u05d9\u05d7\u05d4 \u05de\u05d0\u05d5\u05d3 \u05d1\u05e7\u05e8\u05d1 \u05d4\u05e1\u05d5\u05d1\u05dc\u05d9\u05dd \u05de\u05d4\u05e4\u05e8\u05e2\u05d4 \u05d1\u05d9\u05e4\u05d5\u05dc\u05e8\u05d9\u05ea \u05de\u05e1\u05d5\u05d2 II (DSM p.159)."
        },
        {
          "text": "\u05e7\u05d9\u05d5\u05dd Migraine \u05e9\u05d5\u05dc\u05dc \u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc Bipolar II \u05d5\u05de\u05db\u05d5\u05d5\u05df \u05dc-Cyclothymic Disorder.",
          "isCorrect": false,
          "rationale": "\u05d0\u05d9\u05df \u05e1\u05ea\u05d9\u05e8\u05d4 \u05d1\u05d9\u05df \u05d4\u05d0\u05d1\u05d7\u05e0\u05d5\u05ea; \u05dc\u05de\u05e2\u05e9\u05d4, \u05d4\u05df \u05de\u05d5\u05e4\u05d9\u05e2\u05d5\u05ea \u05d9\u05d7\u05d3 \u05d1\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d2\u05d1\u05d5\u05d4\u05d4 \u05d5\u05d0\u05d9\u05e0\u05df \u05de\u05e9\u05e4\u05d9\u05e2\u05d5\u05ea \u05e2\u05dc \u05e2\u05e6\u05dd \u05d4\u05d2\u05d3\u05e8\u05ea \u05d4\u05e1\u05e4\u05e7\u05d8\u05e8\u05d5\u05dd \u05d4\u05d1\u05d9\u05e4\u05d5\u05dc\u05e8\u05d9 (DSM p.159)."
        },
        {
          "text": "\u05db\u05d0\u05d1\u05d9 \u05d4\u05e8\u05d0\u05e9 \u05d4\u05dd \u05db\u05db\u05dc \u05d4\u05e0\u05e8\u05d0\u05d4 \u05ea\u05d5\u05e6\u05d0\u05d4 \u05e9\u05dc Rapid cycling \u05d1\u05dc\u05d1\u05d3.",
          "isCorrect": false,
          "rationale": "\u05d1\u05e2\u05d5\u05d3 \u05e9\u05de\u05ea\u05d7 \u05e0\u05e4\u05e9\u05d9 \u05de\u05e9\u05e4\u05d9\u05e2 \u05e2\u05dc \u05de\u05d9\u05d2\u05e8\u05e0\u05d4, \u05d4-DSM \u05de\u05e6\u05d9\u05d9\u05df \u05d0\u05d5\u05ea\u05d4 \u05db\u05d9\u05e9\u05d5\u05ea \u05e8\u05e4\u05d5\u05d0\u05d9\u05ea \u05e0\u05dc\u05d5\u05d5\u05d4 (Comorbid) \u05d5\u05dc\u05d0 \u05e8\u05e7 \u05db\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05dd \u05e9\u05dc \u05de\u05d4\u05dc\u05da \u05d4\u05de\u05d7\u05dc\u05d4 (DSM p.159)."
        },
        {
          "text": "\u05d4\u05e7\u05e9\u05e8 \u05e7\u05d9\u05d9\u05dd \u05e8\u05e7 \u05d1\u05e0\u05e9\u05d9\u05dd \u05e2\u05dd Premenstrual Dysphoric Disorder.",
          "isCorrect": false,
          "rationale": "\u05d4\u05e7\u05e9\u05e8 \u05dc-Bipolar II Disorder \u05d4\u05d5\u05d0 \u05e2\u05e6\u05de\u05d0\u05d9, \u05dc\u05de\u05e8\u05d5\u05ea \u05e9\u05e7\u05d9\u05d9\u05de\u05ea \u05d4\u05d7\u05de\u05e8\u05d4 \u05e7\u05d3\u05dd-\u05d5\u05d5\u05e1\u05ea\u05d9\u05ea \u05e9\u05dc \u05de\u05d9\u05d2\u05e8\u05e0\u05d5\u05ea \u05d1\u05e0\u05e9\u05d9\u05dd \u05e2\u05dd PMDD (DSM p.159, p.200)."
        }
