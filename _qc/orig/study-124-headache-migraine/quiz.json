{
  "title": "Migraine Quiz",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\u05d9\u05dc\u05d3 \u05d1\u05df 7 \u05de\u05d5\u05d1\u05d0 \u05dc\u05d4\u05e2\u05e8\u05db\u05d4 \u05d1\u05e9\u05dc \u05d0\u05d9\u05e8\u05d5\u05e2\u05d9\u05dd \u05d7\u05d5\u05d6\u05e8\u05d9\u05dd \u05e9\u05dc \u05db\u05d0\u05d1 \u05e8\u05d0\u05e9 \u05d4\u05e0\u05de\u05e9\u05db\u05d9\u05dd \u05db\u05e9\u05e2\u05ea\u05d9\u05d9\u05dd. \u05d1\u05d6\u05de\u05df \u05d4\u05d4\u05ea\u05e7\u05e3 \u05d4\u05d5\u05d0 \u05e0\u05e8\u05d0\u05d4 \u05d7\u05d9\u05d5\u05d5\u05e8 \u05de\u05d0\u05d5\u05d3, \u05de\u05e7\u05d9\u05d0, \u05d5\u05de\u05e1\u05e8\u05d1 \u05dc\u05e6\u05e4\u05d5\u05ea \u05d1\u05d8\u05dc\u05d5\u05d5\u05d9\u05d6\u05d9\u05d4 \u05d0\u05d5 \u05dc\u05e9\u05d7\u05e7 \u05d1\u05d2\u05d9\u05e0\u05d4, \u05d5\u05de\u05e2\u05d3\u05d9\u05e3 \u05dc\u05e9\u05db\u05d1 \u05d1\u05d7\u05d3\u05e8 \u05d7\u05e9\u05d5\u05da. \u05d4\u05db\u05d0\u05d1 \u05de\u05ea\u05d5\u05d0\u05e8 \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d4\u05d4\u05d5\u05e8\u05d9\u05dd \u05db\u05d3\u05d5-\u05e6\u05d3\u05d3\u05d9 \u05d1\u05d0\u05d6\u05d5\u05e8 \u05d4\u05de\u05e6\u05d7 (Bifrontal). \u05de\u05d4\u05d5 \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9 \u05d1\u05de\u05e7\u05e8\u05d4 \u05d6\u05d4 \u05d4\u05ea\u05d5\u05d0\u05dd \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d0\u05ea \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc Pediatric Migraine \u05dc\u05e2\u05d5\u05de\u05ea \u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd?",
      "answerOptions": [
        {
          "text": "\u05de\u05e9\u05da \u05d4\u05d4\u05ea\u05e7\u05e3 \u05d4\u05e7\u05e6\u05e8 (\u05e9\u05e2\u05ea\u05d9\u05d9\u05dd) \u05d5\u05d4\u05de\u05d9\u05e7\u05d5\u05dd \u05d4\u05d3\u05d5-\u05e6\u05d3\u05d3\u05d9.",
          "isCorrect": true,
          "rationale": "\u05d1\u05e0\u05d9\u05d2\u05d5\u05d3 \u05dc\u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd, \u05de\u05d9\u05d2\u05e8\u05e0\u05d4 \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d4\u05d9\u05d0 \u05dc\u05e8\u05d5\u05d1 \u05e7\u05e6\u05e8\u05d4 \u05d9\u05d5\u05ea\u05e8 (1\u201372 \u05e9\u05e2\u05d5\u05ea) \u05d5\u05e0\u05d5\u05d8\u05d4 \u05dc\u05d4\u05d9\u05d5\u05ea \u05d3\u05d5-\u05e6\u05d3\u05d3\u05d9\u05ea (Bifrontal/Bitemporal) \u05d5\u05dc\u05d0 \u05d7\u05d3-\u05e6\u05d3\u05d3\u05d9\u05ea (Dulcan p.98)."
        },
        {
          "text": "\u05d4\u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05e9\u05dc \u05d1\u05d7\u05d9\u05dc\u05d5\u05ea \u05d5\u05d4\u05e7\u05d0\u05d5\u05ea \u05d3\u05d5\u05de\u05d9\u05e0\u05e0\u05d8\u05d9\u05d5\u05ea.",
          "isCorrect": false,
          "rationale": "\u05d1\u05e2\u05d5\u05d3 \u05e9\u05d4\u05e7\u05d0\u05d5\u05ea \u05d1\u05d5\u05dc\u05d8\u05d5\u05ea \u05de\u05d0\u05d5\u05d3 \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd, \u05d4\u05df \u05e7\u05d9\u05d9\u05de\u05d5\u05ea \u05d2\u05dd \u05d1\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05e9\u05dc \u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd \u05d5\u05d0\u05d9\u05e0\u05df \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05d4\u05de\u05d1\u05d3\u05d9\u05dc \u05d4\u05e2\u05d9\u05e7\u05e8\u05d9 \u05de\u05d1\u05d7\u05d9\u05e0\u05ea \u05de\u05d4\u05dc\u05da \u05d5\u05de\u05d9\u05e7\u05d5\u05dd (Dulcan p.98)."
        },
        {
          "text": "\u05d4\u05d3\u05d9\u05d5\u05d5\u05d7 \u05d4\u05de\u05d9\u05dc\u05d5\u05dc\u05d9 \u05e2\u05dc \u05e4\u05d5\u05d8\u05d5\u05e4\u05d5\u05d1\u05d9\u05d4 \u05d5\u05e4\u05d5\u05e0\u05d5\u05e4\u05d5\u05d1\u05d9\u05d4.",
          "isCorrect": false,
          "rationale": "\u05d9\u05dc\u05d3\u05d9\u05dd \u05e6\u05e2\u05d9\u05e8\u05d9\u05dd \u05dc\u05e8\u05d5\u05d1 \u05d0\u05d9\u05e0\u05dd \u05de\u05d3\u05d5\u05d5\u05d7\u05d9\u05dd \u05de\u05d9\u05dc\u05d5\u05dc\u05d9\u05ea \u05e2\u05dc \u05e8\u05d2\u05d9\u05e9\u05d5\u05ea \u05dc\u05d0\u05d5\u05e8 \u05d5\u05e8\u05e2\u05e9, \u05d0\u05dc\u05d0 \u05de\u05e8\u05d0\u05d9\u05dd \u05d6\u05d0\u05ea \u05d3\u05e8\u05da \u05d1\u05d9\u05d8\u05d5\u05d9 \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea\u05d9 \u05e9\u05dc \u05e0\u05e1\u05d9\u05d2\u05d4 \u05dc\u05d7\u05d3\u05e8 \u05d7\u05e9\u05d5\u05da (Dulcan p.98)."
        },
        {
          "text": "\u05d4\u05e2\u05d5\u05d1\u05d3\u05d4 \u05e9\u05d4\u05db\u05d0\u05d1 \u05de\u05d5\u05d7\u05de\u05e8 \u05d1\u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05d2\u05d5\u05e4\u05e0\u05d9\u05ea.",
          "isCorrect": false,
          "rationale": "\u05d4\u05d7\u05de\u05e8\u05d4 \u05d1\u05de\u05d0\u05de\u05e5 \u05d4\u05d9\u05d0 \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df \u05d0\u05d1\u05d7\u05e0\u05ea\u05d9 \u05d4\u05de\u05e9\u05d5\u05ea\u05e3 \u05d2\u05dd \u05dc\u05d9\u05dc\u05d3\u05d9\u05dd \u05d5\u05d2\u05dd \u05dc\u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd \u05dc\u05e4\u05d9 \u05d4-ICHD-3 \u05d5\u05d0\u05d9\u05e0\u05d4 \u05d9\u05d9\u05d7\u05d5\u05d3\u05d9\u05ea \u05dc\u05d2\u05d9\u05dc \u05d4\u05e6\u05e2\u05d9\u05e8 (DSM p.409)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d1\u05d5 \u05e2\u05dc \u05d4\u05d4\u05d1\u05d3\u05dc\u05d9\u05dd \u05d1\u05de\u05d9\u05e7\u05d5\u05dd \u05d4\u05db\u05d0\u05d1 \u05d5\u05d1\u05de\u05e9\u05da \u05d4\u05d6\u05de\u05df \u05d4\u05de\u05d9\u05e0\u05d9\u05de\u05dc\u05d9 \u05d4\u05e0\u05d3\u05e8\u05e9 \u05dc\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05dc\u05e2\u05d5\u05de\u05ea \u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd.",
      "imageUrls": []
