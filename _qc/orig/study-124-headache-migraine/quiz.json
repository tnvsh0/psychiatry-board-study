    {
      "type": "multiple_select",
      "question": "\u05d9\u05dc\u05d3 \u05d1\u05df 5 \u05de\u05d5\u05d1\u05d0 \u05dc\u05de\u05d9\u05d5\u05df \u05e2\u05dd \u05ea\u05dc\u05d5\u05e0\u05d4 \u05d7\u05d3\u05e9\u05d4 \u05e2\u05dc \u05db\u05d0\u05d1 \u05e8\u05d0\u05e9 \u05e2\u05d6 \u05d4\u05de\u05de\u05d5\u05e7\u05dd \u05d1\u05d0\u05d6\u05d5\u05e8 \u05d4\u05e2\u05d5\u05e8\u05e3 (Occipital). \u05d1\u05d1\u05d3\u05d9\u05e7\u05d4 \u05d2\u05d5\u05e4\u05e0\u05d9\u05ea \u05e0\u05e8\u05d0\u05d9\u05dd \u05de\u05e1\u05e4\u05e8 Caf\u00e9-au-lait macules \u05e2\u05dc \u05d4\u05d2\u05d5. \u05d0\u05d9\u05dc\u05d5 \u05de\u05d4\u05d1\u05d0\u05d9\u05dd \u05de\u05d4\u05d5\u05d5\u05d9\u05dd '\u05d3\u05d2\u05dc\u05d9\u05dd \u05d0\u05d3\u05d5\u05de\u05d9\u05dd' (Red Flags) \u05d1\u05de\u05e7\u05e8\u05d4 \u05d6\u05d4 \u05d4\u05de\u05d7\u05d9\u05d9\u05d1\u05d9\u05dd \u05d1\u05d9\u05e8\u05d5\u05e8 \u05d3\u05d9\u05de\u05d5\u05ea \u05d3\u05d7\u05d5\u05e3?",
      "answerOptions": [
        {
          "text": "\u05de\u05d9\u05e7\u05d5\u05dd \u05d4\u05db\u05d0\u05d1 \u05d1\u05d0\u05d6\u05d5\u05e8 \u05d4-Occipital.",
          "isCorrect": true,
          "rationale": "\u05db\u05d0\u05d1 \u05e8\u05d0\u05e9 \u05e2\u05d5\u05e8\u05e4\u05d9 \u05de\u05d1\u05d5\u05d3\u05d3 \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d0\u05d9\u05e0\u05d5 \u05d8\u05d9\u05e4\u05d5\u05e1\u05d9 \u05dc\u05de\u05d9\u05d2\u05e8\u05e0\u05d4 \u05d5\u05de\u05d7\u05d9\u05d9\u05d1 \u05e9\u05dc\u05d9\u05dc\u05ea \u05e0\u05d2\u05e2 \u05d1\u05d2\u05d5\u05de\u05e5 \u05d4\u05d0\u05d7\u05d5\u05e8\u05d9 (Dulcan p.98)."
        },
        {
          "text": "\u05d2\u05d9\u05dc\u05d5 \u05d4\u05e6\u05e2\u05d9\u05e8 \u05e9\u05dc \u05d4\u05d9\u05dc\u05d3 (\u05de\u05ea\u05d7\u05ea \u05dc\u05d2\u05d9\u05dc 5).",
          "isCorrect": true,
          "rationale": "\u05d4\u05d5\u05e4\u05e2\u05ea \u05db\u05d0\u05d1\u05d9 \u05e8\u05d0\u05e9 \u05d7\u05d3\u05e9\u05d9\u05dd \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05de\u05ea\u05d7\u05ea \u05dc\u05d2\u05d9\u05dc 5 \u05e0\u05d7\u05e9\u05d1\u05ea \u05dc\u05d3\u05d2\u05dc \u05d0\u05d3\u05d5\u05dd \u05d4\u05de\u05e6\u05e8\u05d9\u05da \u05d1\u05d9\u05e8\u05d5\u05e8 \u05d0\u05d5\u05e8\u05d2\u05e0\u05d9 (Dulcan p.98)."
        },
        {
          "text": "\u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05e1\u05d9\u05de\u05e0\u05d9\u05dd \u05e0\u05d5\u05d9\u05e8\u05d5\u05e7\u05d5\u05d8\u05e0\u05d0\u05d9\u05d9\u05dd (Caf\u00e9-au-lait spots).",
          "isCorrect": true,
          "rationale": "\u05db\u05ea\u05de\u05d9 \u05e7\u05e4\u05d4-\u05d1\u05d7\u05dc\u05d1 \u05e2\u05e9\u05d5\u05d9\u05d9\u05dd \u05dc\u05d4\u05e2\u05d9\u05d3 \u05e2\u05dc NF1, \u05d4\u05de\u05e2\u05dc\u05d4 \u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05d2\u05d9\u05d3\u05d5\u05dc\u05d9\u05dd \u05d1\u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05e2\u05e6\u05d1\u05d9\u05dd \u05d4\u05de\u05e8\u05db\u05d6\u05d9\u05ea (Dulcan p.94, p.98)."
        },
        {
          "text": "\u05d4\u05e2\u05d5\u05d1\u05d3\u05d4 \u05e9\u05d4\u05d9\u05dc\u05d3 \u05e1\u05d5\u05d1\u05dc \u05de\u05d1\u05d7\u05d9\u05dc\u05d5\u05ea \u05d1\u05d6\u05de\u05df \u05d4\u05db\u05d0\u05d1.",
          "isCorrect": false,
          "rationale": "\u05d1\u05d7\u05d9\u05dc\u05d5\u05ea \u05d4\u05df \u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05dd \u05e9\u05db\u05d9\u05d7 \u05d1\u05de\u05d9\u05d2\u05e8\u05e0\u05d4 \u05e8\u05d0\u05e9\u05d5\u05e0\u05d9\u05ea \u05d5\u05d0\u05d9\u05e0\u05df \u05e0\u05d7\u05e9\u05d1\u05d5\u05ea \u05db\u05e9\u05dc\u05e2\u05e6\u05de\u05df \u05dc\u05d3\u05d2\u05dc \u05d0\u05d3\u05d5\u05dd \u05dc\u05e4\u05ea\u05d5\u05dc\u05d5\u05d2\u05d9\u05d4 \u05ea\u05d5\u05da-\u05d2\u05d5\u05dc\u05d2\u05d5\u05dc\u05ea\u05d9\u05ea \u05d7\u05de\u05d5\u05e8\u05d4 (Dulcan p.98)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d1\u05d5 \u05e2\u05dc \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9 SNOOP \u05d5\u05d4\u05e7\u05e9\u05e8 \u05d1\u05d9\u05df \u05de\u05de\u05e6\u05d0\u05d9 \u05e2\u05d5\u05e8 \u05dc\u05e4\u05ea\u05d5\u05dc\u05d5\u05d2\u05d9\u05d4 \u05de\u05d5\u05d7\u05d9\u05ea.",
      "hasAllOfTheAbove": false,
      "hasNoneOfTheAbove": false
    },
    {
      "type": "short_answer",
      "question": "\u05ea\u05d0\u05e8\u05d5 \u05d0\u05ea \u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05e4\u05e2\u05d5\u05dc\u05d4 \u05d4\u05e4\u05e8\u05de\u05e7\u05d5\u05dc\u05d5\u05d2\u05d9 \u05e9\u05dc Triptans \u05d1\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05de\u05d9\u05d2\u05e8\u05e0\u05d4 \u05d5\u05d0\u05ea \u05d4\u05e9\u05e4\u05e2\u05ea\u05d5 \u05e2\u05dc \u05d4\u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05d8\u05e8\u05d9\u05d2\u05de\u05d9\u05e0\u05d5-\u05d5\u05e1\u05e7\u05d5\u05dc\u05e8\u05d9\u05ea.",
      "grading": {
        "modelAnswer": "Triptans \u05e4\u05d5\u05e2\u05dc\u05d9\u05dd \u05db\u05d0\u05d2\u05d5\u05e0\u05d9\u05e1\u05d8\u05d9\u05dd \u05e1\u05dc\u05e7\u05d8\u05d9\u05d1\u05d9\u05d9\u05dd \u05dc\u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 $5-HT_{1B/1D}$. \u05d4\u05e4\u05e2\u05dc\u05ea \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9\u05dd \u05d0\u05dc\u05d5 \u05d2\u05d5\u05e8\u05de\u05ea \u05dc\u05db\u05d9\u05d5\u05d5\u05e5 \u05db\u05dc\u05d9 \u05d3\u05dd (Vasoconstriction) \u05d1\u05e7\u05e8\u05d5\u05de\u05d9 \u05d4\u05de\u05d5\u05d7 \u05d5\u05dc\u05e2\u05d9\u05db\u05d5\u05d1 \u05e4\u05e8\u05d4-\u05e1\u05d9\u05e0\u05e4\u05d8\u05d9 \u05e9\u05dc \u05e9\u05d7\u05e8\u05d5\u05e8 \u05e0\u05d5\u05d9\u05e8\u05d5\u05e4\u05e4\u05d8\u05d9\u05d3\u05d9\u05dd \u05de\u05ea\u05d5\u05d5\u05db\u05d9 \u05d3\u05dc\u05e7\u05ea \u05d5\u05db\u05d0\u05d1, \u05db\u05d2\u05d5\u05df CGRP \u05d5\u05d2\u05dc\u05d5\u05d8\u05de\u05d8, \u05de\u05e7\u05e6\u05d5\u05d5\u05ea \u05d4\u05e2\u05e6\u05d1 \u05d4\u05d8\u05e8\u05d9\u05d2\u05de\u05d9\u05e0\u05dc\u05d9 (StahlNeuro p.390; Hebrew Source).",
        "rationale": "\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05d8\u05e8\u05d9\u05e4\u05d8\u05e0\u05d9\u05dd \u05de\u05e9\u05dc\u05d1 \u05d4\u05e9\u05e4\u05e2\u05d4 \u05d5\u05e1\u05e7\u05d5\u05dc\u05e8\u05d9\u05ea \u05d9\u05e9\u05d9\u05e8\u05d4 \u05d9\u05d7\u05d3 \u05e2\u05dd \u05e2\u05d9\u05db\u05d5\u05d1 \u05e9\u05d7\u05e8\u05d5\u05e8 \u05de\u05ea\u05d5\u05d5\u05db\u05d9 \u05db\u05d0\u05d1 \u05de\u05d4\u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05d8\u05e8\u05d9\u05d2\u05de\u05d9\u05e0\u05dc\u05d9\u05ea.",
        "requiredAttributes": [
          "\u05e6\u05d9\u05d5\u05df \u05d4\u05e7\u05d5\u05dc\u05d8\u05e0\u05d9\u05dd $5-HT_{1B/1D}$ (\u05d0\u05d5 \u05dc\u05e4\u05d7\u05d5\u05ea \u05d0\u05d7\u05d3 \u05de\u05d4\u05dd).",
          "\u05e6\u05d9\u05d5\u05df \u05e4\u05e2\u05d5\u05dc\u05ea \u05d0\u05d2\u05d5\u05e0\u05d9\u05d6\u05dd (Agonism).",
          "\u05d4\u05ea\u05d9\u05d9\u05d7\u05e1\u05d5\u05ea \u05dc\u05db\u05d9\u05d5\u05d5\u05e5 \u05db\u05dc\u05d9 \u05d3\u05dd (Vasoconstriction).",
          "\u05d4\u05ea\u05d9\u05d9\u05d7\u05e1\u05d5\u05ea \u05dc\u05e2\u05d9\u05db\u05d5\u05d1 \u05e9\u05d7\u05e8\u05d5\u05e8 \u05e0\u05d5\u05d9\u05e8\u05d5\u05e4\u05e4\u05d8\u05d9\u05d3\u05d9\u05dd \u05d0\u05d5 CGRP."
        ],
        "errors": {
