        "\u05e9\u05dc\u05d5\u05e9"
      ],
      "rationale": "\u05de\u05d7\u05e7\u05e8\u05d9\u05dd \u05e2\u05e7\u05d1\u05d9\u05d9\u05dd \u05de\u05e8\u05d0\u05d9\u05dd \u05db\u05d9 \u05e9\u05d9\u05de\u05d5\u05e9 \u05e7\u05d1\u05d5\u05e2 \u05d1\u05e7\u05e0\u05d0\u05d1\u05d9\u05e1 \u05de\u05e2\u05dc\u05d4 \u05d0\u05ea \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05d4\u05d9\u05d7\u05e1\u05d9 \u05dc\u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d4 \u05e4\u05d9 3 \u05d1\u05d4\u05e9\u05d5\u05d5\u05d0\u05d4 \u05dc\u05dc\u05d0-\u05de\u05e9\u05ea\u05de\u05e9\u05d9\u05dd.",
      "hint": "\u05d4\u05de\u05e1\u05e4\u05e8 \u05de\u05e6\u05d5\u05d9\u05df \u05db-'Threefold increase' \u05d1\u05de\u05e7\u05d5\u05e8\u05d5\u05ea \u05d4\u05dc\u05d9\u05d1\u05d4."
    },
    {
      "type": "multiple_select",
      "question": "\u05d0\u05d9\u05dc\u05d5 \u05de\u05d4\u05de\u05de\u05e6\u05d0\u05d9\u05dd \u05d4\u05d1\u05d0\u05d9\u05dd \u05dc\u05d2\u05d1\u05d9 \u05d4\u05ea\u05d7\u05dc\u05d5\u05d0\u05d4 \u05d4\u05e0\u05dc\u05d5\u05d5\u05d9\u05ea (Comorbidity) \u05e9\u05dc Cannabis Use Disorder \u05d1\u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd \u05e0\u05ea\u05de\u05db\u05d9\u05dd \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d4-DSM-5-TR \u05d5\u05d4-Dulcan? (DSM p.581-582, Dulcan p.226)",
      "answerOptions": [
        {
          "text": "\u05db-64% \u05de\u05d4\u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd \u05e2\u05dd CUD \u05e1\u05d5\u05d1\u05dc\u05d9\u05dd \u05de\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05de\u05d5\u05d7\u05e6\u05e0\u05d5\u05ea (Externalizing disorders) \u05db\u05d2\u05d5\u05df Conduct Disorder.",
          "isCorrect": true,
          "rationale": "\u05d9\u05e9 \u05e7\u05e9\u05e8 \u05d7\u05d6\u05e7 \u05d1\u05d9\u05df CUD \u05dc\u05d1\u05d9\u05df \u05d1\u05e2\u05d9\u05d5\u05ea \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05de\u05d5\u05d7\u05e6\u05e0\u05d5\u05ea \u05d1\u05e7\u05e8\u05d1 \u05d1\u05e0\u05d9 \u05e0\u05d5\u05e2\u05e8 (DSM p.582)."
        },
        {
          "text": "\u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05e9\u05dc ADHD \u05de\u05d4\u05d5\u05d5\u05d4 \u05d2\u05d5\u05e8\u05dd \u05e1\u05d9\u05db\u05d5\u05df \u05e2\u05e6\u05de\u05d0\u05d9 \u05dc\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea \u05de\u05d5\u05e7\u05d3\u05de\u05ea \u05e9\u05dc SUD.",
          "isCorrect": true,
          "rationale": "ADHD \u05dc\u05d0 \u05de\u05d8\u05d5\u05e4\u05dc \u05e0\u05de\u05e6\u05d0 \u05d1\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d2\u05d1\u05d5\u05d4\u05d4 (\u05e2\u05d3 44%) \u05d1\u05e7\u05e8\u05d1 \u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd \u05d4\u05e4\u05d5\u05e0\u05d9\u05dd \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05d4\u05ea\u05de\u05db\u05e8\u05d5\u05d9\u05d5\u05ea (Dulcan p.226)."
        },
        {
          "text": "\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1-Cannabis \u05d1\u05d2\u05d9\u05dc \u05d4\u05d4\u05ea\u05d1\u05d2\u05e8\u05d5\u05ea \u05de\u05e2\u05dc\u05d4 \u05e4\u05d9 3.46 \u05d0\u05ea \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05d1\u05d9\u05e6\u05d5\u05e2 \u05e0\u05d9\u05e1\u05d9\u05d5\u05e0\u05d5\u05ea \u05d0\u05d5\u05d1\u05d3\u05e0\u05d9\u05d9\u05dd \u05d1\u05d1\u05d2\u05e8\u05d5\u05ea \u05d4\u05e6\u05e2\u05d9\u05e8\u05d4.",
          "isCorrect": true,
          "rationale": "\u05d4\u05de\u05d8\u05d4-\u05d0\u05e0\u05dc\u05d9\u05d6\u05d4 \u05e9\u05dc Gobbi et al. (2019) \u05de\u05e6\u05d1\u05d9\u05e2\u05d4 \u05e2\u05dc \u05e2\u05dc\u05d9\u05d9\u05d4 \u05d3\u05e8\u05de\u05d8\u05d9\u05ea \u05d1\u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05e0\u05d9\u05e1\u05d9\u05d5\u05e0\u05d5\u05ea \u05d0\u05d5\u05d1\u05d3\u05e0\u05d9\u05d9\u05dd (Dulcan p.226)."
        },
        {
          "text": "\u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc CUD \u05de\u05e4\u05d7\u05d9\u05ea\u05d4 \u05d0\u05ea \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05d0\u05d5\u05e4\u05d9\u05d0\u05d5\u05d0\u05d9\u05d3\u05d9\u05dd \u05d1\u05e9\u05dc '\u05d0\u05e4\u05e7\u05d8 \u05d4\u05d4\u05d7\u05dc\u05e4\u05d4'.",
          "isCorrect": false,
