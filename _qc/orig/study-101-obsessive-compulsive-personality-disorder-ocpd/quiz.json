    {
      "type": "multiple_select",
      "question": "\u05d0\u05d9\u05dc\u05d5 \u05de\u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9\u05dd \u05d4\u05d1\u05d0\u05d9\u05dd \u05e2\u05d5\u05d6\u05e8\u05d9\u05dd \u05dc\u05d4\u05d1\u05d7\u05d9\u05df \u05d1\u05d9\u05df OCPD \u05dc\u05d1\u05d9\u05df Narcissistic Personality Disorder (NPD) \u05d1\u05e1\u05d9\u05d8\u05d5\u05d0\u05e6\u05d9\u05d4 \u05e7\u05dc\u05d9\u05e0\u05d9\u05ea?",
      "answerOptions": [
        {
          "text": "\u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd \u05e2\u05dd OCPD \u05e0\u05d5\u05d8\u05d9\u05dd \u05dc\u05d1\u05d9\u05e7\u05d5\u05e8\u05ea \u05e2\u05e6\u05de\u05d9\u05ea \u05e0\u05d5\u05e7\u05e9\u05d4, \u05d1\u05e2\u05d5\u05d3 \u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd \u05e2\u05dd NPD \u05e0\u05d5\u05d8\u05d9\u05dd \u05dc\u05d4\u05d0\u05de\u05d9\u05df \u05e9\u05d4\u05dd \u05db\u05d1\u05e8 \u05d4\u05e9\u05d9\u05d2\u05d5 \u05e9\u05dc\u05de\u05d5\u05ea.",
          "isCorrect": true,
          "rationale": "\u05d6\u05d4\u05d5 \u05d4\u05d1\u05d3\u05dc \u05de\u05e8\u05db\u05d6\u05d9 \u05d1\u05ea\u05e4\u05d9\u05e1\u05ea \u05d4\u05e2\u05e6\u05de\u05d9 \u05d5\u05d4\u05d4\u05d9\u05e9\u05d2\u05d9\u05dd \u05d1\u05d9\u05df \u05e9\u05ea\u05d9 \u05d4\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea (DSM p.764, 775)."
        },
        {
          "text": "\u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd \u05e2\u05dd OCPD \u05de\u05e4\u05d2\u05d9\u05e0\u05d9\u05dd \u05e1\u05d2\u05e0\u05d5\u05df \u05d4\u05d5\u05e6\u05d0\u05d5\u05ea \u05e7\u05de\u05e6\u05e0\u05d9 \u05db\u05dc\u05e4\u05d9 \u05e2\u05e6\u05de\u05dd \u05d5\u05db\u05dc\u05e4\u05d9 \u05d0\u05d7\u05e8\u05d9\u05dd, \u05d1\u05e2\u05d5\u05d3 \u05e0\u05e8\u05e7\u05d9\u05e1\u05d9\u05e1\u05d8\u05d9\u05dd \u05e2\u05e9\u05d5\u05d9\u05d9\u05dd \u05dc\u05d4\u05d9\u05d5\u05ea \u05d1\u05d6\u05d1\u05d6\u05e0\u05d9\u05dd \u05db\u05dc\u05e4\u05d9 \u05e2\u05e6\u05de\u05dd.",
          "isCorrect": true,
          "rationale": "\u05d4\u05d9\u05d7\u05e1 \u05dc\u05db\u05e1\u05e3 \u05d5\u05dc\u05de\u05e9\u05d0\u05d1\u05d9\u05dd \u05e9\u05d5\u05e0\u05d4: \u05d1-OCPD \u05d4\u05db\u05e1\u05e3 \u05e0\u05e9\u05de\u05e8 \u05dc'\u05d0\u05e1\u05d5\u05e0\u05d5\u05ea', \u05d1\u05e0\u05e8\u05e7\u05d9\u05e1\u05d9\u05d6\u05dd \u05d4\u05d5\u05d0 \u05de\u05e9\u05de\u05e9 \u05dc\u05d4\u05d0\u05d3\u05e8\u05ea \u05d4\u05e2\u05e6\u05de\u05d9 (DSM p.775)."
