    {
      "type": "short_answer",
      "question": "\u05ea\u05d0\u05e8 \u05d0\u05ea \u05d4\u05d4\u05d1\u05d3\u05dc \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05d1\u05d9\u05df \u05d4\u05e7\u05d5\u05e9\u05d9 \u05dc\u05d4\u05e9\u05dc\u05d9\u05da \u05d7\u05e4\u05e6\u05d9\u05dd \u05d1-OCPD \u05dc\u05d1\u05d9\u05df \u05d4\u05d0\u05d2\u05d9\u05e8\u05d4 \u05d4\u05e0\u05e6\u05e4\u05d9\u05ea \u05d1-Hoarding Disorder, \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR.",
      "grading": {
        "modelAnswer": "\u05d1-OCPD \u05d4\u05e7\u05d5\u05e9\u05d9 \u05dc\u05d4\u05e9\u05dc\u05d9\u05da \u05d7\u05e4\u05e6\u05d9\u05dd \u05e0\u05d5\u05d1\u05e2 \u05de\u05d4\u05ea\u05e4\u05d9\u05e1\u05d4 \u05e9\u05d4\u05dd \u05e2\u05e9\u05d5\u05d9\u05d9\u05dd \u05dc\u05d4\u05d9\u05d5\u05ea \u05e0\u05d7\u05d5\u05e6\u05d9\u05dd \u05d1\u05e2\u05ea\u05d9\u05d3 \u05d0\u05d5 \u05de\u05d7\u05d5\u05e1\u05e8 \u05e8\u05e6\u05d5\u05df \u05dc\u05d1\u05d6\u05d1\u05d6, \u05d0\u05da \u05d4\u05d0\u05d2\u05d9\u05e8\u05d4 \u05d0\u05d9\u05e0\u05d4 \u05de\u05d1\u05d9\u05d0\u05d4 \u05dc\u05d4\u05e6\u05d8\u05d1\u05e8\u05d5\u05ea \u05e7\u05d9\u05e6\u05d5\u05e0\u05d9\u05ea (clutter) \u05e9\u05d7\u05d5\u05e1\u05de\u05ea \u05d0\u05ea \u05e9\u05d8\u05d7\u05d9 \u05d4\u05de\u05d7\u05d9\u05d4. \u05d1-Hoarding Disorder, \u05d4\u05d0\u05d2\u05d9\u05e8\u05d4 \u05d4\u05d9\u05d0 \u05d0\u05e7\u05e1\u05d8\u05e8\u05de\u05d9\u05ea, \u05d2\u05d5\u05d3\u05e9\u05ea \u05d0\u05ea \u05d4\u05d1\u05d9\u05ea \u05d5\u05e4\u05d5\u05d2\u05e2\u05ea \u05d1\u05d0\u05d5\u05e4\u05df \u05de\u05d4\u05d5\u05ea\u05d9 \u05d1\u05d9\u05db\u05d5\u05dc\u05ea \u05dc\u05d4\u05e9\u05ea\u05de\u05e9 \u05d1\u05d7\u05d3\u05e8\u05d9\u05dd \u05dc\u05de\u05d8\u05e8\u05ea\u05dd \u05d4\u05de\u05d9\u05d5\u05e2\u05d3\u05ea.",
        "rationale": "\u05d4\u05d4\u05d1\u05d7\u05e0\u05d4 \u05de\u05ea\u05d1\u05e1\u05e1\u05ea \u05e2\u05dc \u05d7\u05d5\u05de\u05e8\u05ea \u05d4\u05d4\u05e6\u05d8\u05d1\u05e8\u05d5\u05ea \u05d5\u05d4\u05e9\u05e4\u05e2\u05ea\u05d4 \u05e2\u05dc \u05e9\u05d8\u05d7\u05d9 \u05d4\u05de\u05d7\u05d9\u05d4 \u05d4\u05e4\u05e2\u05d9\u05dc\u05d9\u05dd \u05d1\u05d1\u05d9\u05ea (DSM p.277, 774).",
        "requiredAttributes": [
          "\u05e6\u05d9\u05d5\u05df \u05d4\u05e2\u05d5\u05d1\u05d3\u05d4 \u05e9\u05d1-OCPD \u05d4\u05d0\u05d2\u05d9\u05e8\u05d4 \u05d0\u05d9\u05e0\u05d4 \u05d7\u05d5\u05e1\u05de\u05ea \u05d0\u05ea \u05e9\u05d8\u05d7\u05d9 \u05d4\u05de\u05d7\u05d9\u05d4 (no extreme clutter).",
