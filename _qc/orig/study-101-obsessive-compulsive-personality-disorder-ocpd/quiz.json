{
  "title": "Psychiatry Quiz",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\u05de\u05ea\u05d1\u05d2\u05e8 \u05d1\u05df 17 \u05de\u05d5\u05e4\u05e0\u05d4 \u05dc\u05d4\u05e2\u05e8\u05db\u05d4 \u05e2\u05e7\u05d1 \u05d9\u05e8\u05d9\u05d3\u05d4 \u05d1\u05e6\u05d9\u05d5\u05e0\u05d9\u05dd. \u05d1\u05d1\u05d9\u05e8\u05d5\u05e8 \u05e2\u05d5\u05dc\u05d4 \u05db\u05d9 \u05d4\u05d5\u05d0 \u05de\u05d1\u05dc\u05d4 \u05e9\u05e2\u05d5\u05ea \u05d1\u05db\u05ea\u05d9\u05d1\u05d4 \u05de\u05d7\u05d3\u05e9 \u05e9\u05dc \u05e2\u05d1\u05d5\u05d3\u05d5\u05ea \u05db\u05d3\u05d9 \u05dc\u05d4\u05d1\u05d8\u05d9\u05d7 \u05e9\u05d4\u05df \"\u05de\u05d5\u05e9\u05dc\u05de\u05d5\u05ea\", \u05de\u05d4 \u05e9\u05de\u05d5\u05d1\u05d9\u05dc \u05dc\u05d4\u05d7\u05de\u05e6\u05ea \u05de\u05d5\u05e2\u05d3\u05d9 \u05d4\u05d2\u05e9\u05d4. \u05d4\u05d5\u05d0 \u05de\u05ea\u05d5\u05d0\u05e8 \u05db\"\u05e7\u05de\u05e6\u05df\" \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d7\u05d1\u05e8\u05d9\u05d5, \u05e9\u05d5\u05de\u05e8 \u05d7\u05e4\u05e6\u05d9\u05dd \u05d9\u05e9\u05e0\u05d9\u05dd \u05d5\u05d7\u05e1\u05e8\u05d9 \u05e2\u05e8\u05da \u05d1\u05d7\u05d3\u05e8\u05d5, \u05d5\u05de\u05e1\u05e8\u05d1 \u05dc\u05d4\u05d0\u05e6\u05d9\u05dc \u05e1\u05de\u05db\u05d5\u05d9\u05d5\u05ea \u05d1\u05e4\u05e8\u05d5\u05d9\u05e7\u05d8\u05d9\u05dd \u05e7\u05d1\u05d5\u05e6\u05ea\u05d9\u05d9\u05dd \u05d0\u05dc\u05d0 \u05d0\u05dd \u05db\u05df \u05db\u05d5\u05dc\u05dd \u05e4\u05d5\u05e2\u05dc\u05d9\u05dd \u05d1\u05d3\u05d9\u05d5\u05e7 \u05dc\u05e4\u05d9 \u05d4\u05db\u05dc\u05dc\u05d9\u05dd \u05e9\u05dc\u05d5. \u05d4\u05d5\u05d0 \u05d0\u05d9\u05e0\u05d5 \u05de\u05d3\u05d5\u05d5\u05d7 \u05e2\u05dc \u05de\u05d7\u05e9\u05d1\u05d5\u05ea \u05e4\u05d5\u05dc\u05e9\u05e0\u05d9\u05d5\u05ea \u05d0\u05d5 \u05d8\u05e7\u05e1\u05d9\u05dd \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05d9\u05dd \u05e9\u05e0\u05d5\u05e2\u05d3\u05d5 \u05dc\u05d4\u05e4\u05d7\u05d9\u05ea \u05d7\u05e8\u05d3\u05d4, \u05d0\u05dc\u05d0 \u05de\u05d0\u05de\u05d9\u05df \u05e9\u05d3\u05e8\u05db\u05d5 \u05d4\u05d9\u05d0 \u05d4\u05d3\u05e8\u05da \u05d4\u05e0\u05db\u05d5\u05e0\u05d4 \u05d4\u05d9\u05d7\u05d9\u05d3\u05d4. \u05de\u05d4\u05d9 \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05e1\u05d1\u05d9\u05e8\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR?",
      "answerOptions": [
        {
          "text": "Obsessive-Compulsive Personality Disorder (OCPD)",
          "isCorrect": true,
          "rationale": "\u05d4\u05de\u05e7\u05e8\u05d4 \u05de\u05d3\u05d2\u05d9\u05dd \u05d3\u05e4\u05d5\u05e1 \u05e9\u05dc \u05e4\u05e8\u05e4\u05e7\u05e6\u05d9\u05d5\u05e0\u05d9\u05d6\u05dd \u05d4\u05de\u05e4\u05e8\u05d9\u05e2 \u05dc\u05e1\u05d9\u05d5\u05dd \u05de\u05e9\u05d9\u05de\u05d5\u05ea, \u05e0\u05d5\u05e7\u05e9\u05d5\u05ea, \u05d7\u05d5\u05e1\u05e8 \u05e8\u05e6\u05d5\u05df \u05dc\u05d4\u05d0\u05e6\u05d9\u05dc \u05e1\u05de\u05db\u05d5\u05d9\u05d5\u05ea, \u05d5\u05e1\u05d2\u05e0\u05d5\u05df \u05d4\u05d5\u05e6\u05d0\u05d5\u05ea \u05e7\u05de\u05e6\u05e0\u05d9, \u05d4\u05de\u05d4\u05d5\u05d5\u05d9\u05dd \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05de\u05e8\u05db\u05d6\u05d9\u05d9\u05dd \u05dc-OCPD (DSM p.772)."
        },
        {
          "text": "Obsessive-Compulsive Disorder (OCD)",
          "isCorrect": false,
          "rationale": "\u05d1\u05e0\u05d9\u05d2\u05d5\u05d3 \u05dc-OCD, \u05db\u05d0\u05df \u05d0\u05d9\u05df \u05e2\u05d3\u05d5\u05ea \u05dc\u05d0\u05d5\u05d1\u05e1\u05e1\u05d9\u05d5\u05ea \u05e4\u05d5\u05dc\u05e9\u05e0\u05d9\u05d5\u05ea \u05d0\u05d5 \u05e7\u05d5\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d5\u05ea \u05d3\u05d9\u05e1\u05e7\u05e8\u05d8\u05d9\u05d5\u05ea \u05d4\u05d7\u05d5\u05d5\u05ea \u05db-ego-dystonic; \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05d7\u05d5\u05d5\u05d4 \u05d0\u05ea \u05ea\u05db\u05d5\u05e0\u05d5\u05ea\u05d9\u05d5 \u05db\u05e0\u05db\u05d5\u05e0\u05d5\u05ea \u05d5\u05e8\u05e6\u05d5\u05d9\u05d5\u05ea (DSM p.271, 774)."
        },
        {
          "text": "Narcissistic Personality Disorder (NPD)",
          "isCorrect": false,
          "rationale": "\u05d0\u05e3 \u05e2\u05dc \u05e4\u05d9 \u05e9\u05e9\u05ea\u05d9 \u05d4\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05db\u05d5\u05dc\u05dc\u05d5\u05ea \u05e4\u05e8\u05e4\u05e7\u05e6\u05d9\u05d5\u05e0\u05d9\u05d6\u05dd, \u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd \u05e2\u05dd OCPD \u05e0\u05d5\u05d8\u05d9\u05dd \u05dc\u05d4\u05d9\u05d5\u05ea \u05d1\u05d9\u05e7\u05d5\u05e8\u05ea\u05d9\u05d9\u05dd \u05de\u05d0\u05d5\u05d3 \u05db\u05dc\u05e4\u05d9 \u05e2\u05e6\u05de\u05dd, \u05d1\u05e2\u05d5\u05d3 \u05e9\u05e0\u05e8\u05e7\u05d9\u05e1\u05d9\u05e1\u05d8\u05d9\u05dd \u05de\u05d0\u05de\u05d9\u05e0\u05d9\u05dd \u05e9\u05d4\u05dd \u05db\u05d1\u05e8 \u05d4\u05e9\u05d9\u05d2\u05d5 \u05e9\u05dc\u05de\u05d5\u05ea (DSM p.764, 775)."
        },
        {
          "text": "Hoarding Disorder",
          "isCorrect": false,
          "rationale": "\u05d0\u05d2\u05d9\u05e8\u05d4 \u05d1-OCPD \u05d0\u05d9\u05e0\u05d4 \u05de\u05d2\u05d9\u05e2\u05d4 \u05dc\u05e8\u05de\u05ea \u05d4\u05e6\u05d8\u05d1\u05e8\u05d5\u05ea (clutter) \u05e7\u05d9\u05e6\u05d5\u05e0\u05d9\u05ea \u05d4\u05d2\u05d5\u05d3\u05e9\u05ea \u05d0\u05ea \u05e9\u05d8\u05d7\u05d9 \u05d4\u05de\u05d7\u05d9\u05d4 \u05d5\u05d4\u05d5\u05e4\u05db\u05ea \u05d0\u05d5\u05ea\u05dd \u05dc\u05de\u05e1\u05d5\u05db\u05e0\u05d9\u05dd \u05db\u05e4\u05d9 \u05e9\u05e7\u05d5\u05e8\u05d4 \u05d1-Hoarding Disorder (DSM p.277, 774)."
        }
      ],
      "hint": "\u05d4\u05ea\u05de\u05e7\u05d3 \u05d1\u05d0\u05d5\u05e4\u05d9 \u05d4\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05db-ego-syntonic \u05d5\u05d1\u05e4\u05d2\u05d9\u05e2\u05d4 \u05d1\u05ea\u05e4\u05e7\u05d5\u05d3 \u05e2\u05e7\u05d1 \u05e4\u05e8\u05e4\u05e7\u05e6\u05d9\u05d5\u05e0\u05d9\u05d6\u05dd."
    },
    {
      "type": "multiple_choice",
      "question": "\u05d1\u05d4\u05e7\u05e9\u05e8 \u05e9\u05dc \u05d4\u05d0\u05d8\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05d4 \u05d4\u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea, \u05d0\u05d9\u05dc\u05d5 \u05de\u05d4\u05de\u05de\u05e6\u05d0\u05d9\u05dd \u05d4\u05e4\u05d9\u05d6\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05d9\u05dd \u05d4\u05d1\u05d0\u05d9\u05dd \u05d4\u05de\u05d6\u05d5\u05d4\u05d9\u05dd \u05e2\u05dd Major Depressive Disorder \u05e0\u05de\u05e6\u05d0\u05d5 \u05d2\u05dd \u05d0\u05e6\u05dc \u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd \u05e2\u05dd OCPD?",
      "answerOptions": [
        {
          "text": "\u05e7\u05d9\u05e6\u05d5\u05e8 \u05ea\u05e7\u05d5\u05e4\u05ea \u05d4\u05d7\u05d1\u05d9\u05d5\u05df \u05e9\u05dc \u05e9\u05e0\u05ea REM (Shortened REM latency) \u05d5\u05ea\u05d5\u05e6\u05d0\u05d5\u05ea \u05dc\u05d0 \u05ea\u05e7\u05d9\u05e0\u05d5\u05ea \u05d1\u05de\u05d1\u05d7\u05df DST.",
          "isCorrect": true,
          "rationale": "\u05de\u05de\u05e7\u05e8\u05d9\u05dd \u05d0\u05dc\u05d5 \u05de\u05e6\u05d1\u05d9\u05e2\u05d9\u05dd \u05e2\u05dc \u05e7\u05e9\u05e8 \u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d0\u05e4\u05e9\u05e8\u05d9 \u05d1\u05d9\u05df OCPD \u05dc\u05d1\u05d9\u05df \u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05de\u05e6\u05d1 \u05e8\u05d5\u05d7 (Synopsis ch.19 Personality Disorders)."
        },
        {
          "text": "\u05e8\u05de\u05d5\u05ea \u05e0\u05de\u05d5\u05db\u05d5\u05ea \u05e9\u05dc Testosterone \u05d5-17-estradiol \u05d1\u05d3\u05dd.",
          "isCorrect": false,
          "rationale": "\u05e8\u05de\u05d5\u05ea \u05d2\u05d1\u05d5\u05d4\u05d5\u05ea \u05e9\u05dc \u05d4\u05d5\u05e8\u05de\u05d5\u05e0\u05d9\u05dd \u05d0\u05dc\u05d5 \u05e7\u05e9\u05d5\u05e8\u05d5\u05ea \u05d3\u05d5\u05d5\u05e7\u05d0 \u05dc\u05ea\u05db\u05d5\u05e0\u05d5\u05ea \u05d0\u05d9\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05d5\u05ea \u05d5\u05ea\u05d5\u05e7\u05e4\u05e0\u05d5\u05ea, \u05d5\u05dc\u05d0 \u05dc\u05e7\u05e9\u05d9\u05d7\u05d5\u05ea \u05d4\u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05d9\u05ea \u05dc-Cluster C (Synopsis ch.19 Personality Disorders)."
        },
        {
          "text": "\u05e2\u05dc\u05d9\u05d9\u05d4 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05d1\u05e0\u05e4\u05d7 \u05d4-thalamus \u05d1\u05d1\u05d3\u05d9\u05e7\u05d5\u05ea MRI \u05de\u05d1\u05e0\u05d9\u05d5\u05ea.",
          "isCorrect": false,
          "rationale": "\u05e2\u05dc\u05d9\u05d9\u05d4 \u05d1\u05e0\u05e4\u05d7 \u05d4-thalamus \u05ea\u05d5\u05d0\u05e8\u05d4 \u05d1\u05de\u05d7\u05e7\u05e8\u05d9\u05dd \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd OCD, \u05d0\u05da \u05d0\u05d9\u05e0\u05d4 \u05de\u05e6\u05d5\u05d9\u05e0\u05ea \u05db\u05de\u05de\u05e6\u05d0 \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9 \u05e2\u05d1\u05d5\u05e8 OCPD (Dulcan p.369)."
        },
        {
          "text": "\u05e7\u05d9\u05e6\u05d5\u05e8 \u05e9\u05dc \u05d4\u05d8\u05dc\u05d5\u05de\u05e8\u05d9\u05dd \u05d1\u05ea\u05d0\u05d9 \u05d3\u05dd \u05dc\u05d1\u05e0\u05d9\u05dd \u05e2\u05e7\u05d1 \u05e2\u05e7\u05d4 \u05d7\u05de\u05e6\u05d5\u05e0\u05d9\u05ea \u05db\u05e8\u05d5\u05e0\u05d9\u05ea.",
          "isCorrect": false,
          "rationale": "\u05de\u05de\u05e6\u05d0 \u05d6\u05d4 \u05d0\u05d9\u05e0\u05d5 \u05de\u05d5\u05d6\u05db\u05e8 \u05d1\u05de\u05e7\u05d5\u05e8\u05d5\u05ea \u05db\u05e7\u05e9\u05d5\u05e8 \u05dc-OCPD \u05d0\u05d5 \u05dc\u05d4\u05d1\u05d7\u05e0\u05d4 \u05d1\u05d9\u05df \u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05d0\u05d9\u05e9\u05d9\u05d5\u05ea."
        }
      ],
      "hint": "\u05d7\u05e4\u05e9 \u05e1\u05de\u05e0\u05d9\u05dd \u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05d9\u05dd \u05d4\u05de\u05e9\u05d5\u05ea\u05e4\u05d9\u05dd \u05dc-Cluster C \u05d5\u05dc\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05de\u05e6\u05d1 \u05e8\u05d5\u05d7."
    },
    {
      "type": "multiple_choice",
      "question": "\u05dc\u05e4\u05d9 \u05d4\u05de\u05d5\u05d3\u05dc \u05d4\u05e0\u05d5\u05d9\u05e8\u05d5\u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d4\u05de\u05d5\u05e6\u05d2 \u05d1-StahlNeuro, \u05db\u05d9\u05e6\u05d3 \u05de\u05d5\u05e1\u05d1\u05e8 \u05d4\u05de\u05e2\u05d1\u05e8 \u05de\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d4\u05de\u05d5\u05e0\u05e2\u05ea \u05e2\u05dc \u05d9\u05d3\u05d9 \u05ea\u05d2\u05de\u05d5\u05dc \u05dc\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05db\u05e4\u05d9\u05d9\u05ea\u05d9\u05ea \u05d5\u05e0\u05d5\u05e7\u05e9\u05d4?",
      "answerOptions": [
        {
          "text": "\u05e0\u05d3\u05d9\u05d3\u05d4 \u05e9\u05dc \u05d4\u05e9\u05dc\u05d9\u05d8\u05d4 \u05d4\u05e2\u05e6\u05d1\u05d9\u05ea \u05de\u05d4\u05dc\u05d5\u05dc\u05d0\u05d4 \u05e9\u05dc \u05d4-ventral striatum (\u05d4\u05e7\u05e9\u05d5\u05e8\u05d4 \u05dc-reward) \u05d0\u05dc \u05d4-dorsal striatum (\u05d4\u05e7\u05e9\u05d5\u05e8\u05d4 \u05dc\u05de\u05e2\u05e8\u05db\u05ea \u05d4-habit).",
          "isCorrect": true,
          "rationale": "\u05ea\u05d4\u05dc\u05d9\u05da \u05d6\u05d4 \u05e9\u05dc \u05e0\u05d5\u05d9\u05e8\u05d5-\u05d0\u05d3\u05e4\u05d8\u05e6\u05d9\u05d4 \u05d2\u05d5\u05e8\u05dd \u05dc\u05db\u05da \u05e9\u05e4\u05e2\u05d5\u05dc\u05d4 \u05e9\u05d4\u05d7\u05dc\u05d4 \u05db\u05d0\u05d9\u05de\u05e4\u05d5\u05dc\u05e1 \u05d4\u05d5\u05e4\u05db\u05ea \u05dc\u05d4\u05e8\u05d2\u05dc \u05db\u05e4\u05d9\u05d9\u05ea\u05d9 \u05e9\u05e7\u05e9\u05d4 \u05dc\u05d4\u05e4\u05e1\u05d9\u05e7\u05d5 (StahlNeuro p.574-575)."
        },
        {
          "text": "\u05d9\u05e8\u05d9\u05d3\u05d4 \u05d1\u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05d4-\u05d3\u05d5\u05d1\u05d9 (Dopamine) \u05d1\u05de\u05e1\u05dc\u05d5\u05dc \u05d4-mesolimbic \u05e2\u05dd \u05e2\u05dc\u05d9\u05d9\u05d4 \u05d1-\u05d3\u05ea (DAT) \u05d1-OFC.",
          "isCorrect": false,
