        "\u05d8\u05db\u05e0\u05d9\u05e7\u05ea \u05d4\u05e7\u05d0\u05e3",
        "\u05e0\u05d9\u05e4\u05d5\u05d7 \u05e9\u05e8\u05d5\u05d5\u05dc"
      ],
      "rationale": "\u05d8\u05db\u05e0\u05d9\u05e7\u05ea \u05d4-Cuff \u05de\u05d5\u05e0\u05e2\u05ea \u05de\u05d4-Succinylcholine \u05dc\u05d4\u05d2\u05d9\u05e2 \u05dc\u05db\u05e3 \u05d4\u05e8\u05d2\u05dc, \u05d5\u05d1\u05db\u05da \u05de\u05d0\u05e4\u05e9\u05e8\u05ea \u05dc\u05e6\u05e4\u05d5\u05ea \u05d1\u05e4\u05e8\u05db\u05d5\u05e1 \u05d4\u05de\u05d5\u05d8\u05d5\u05e8\u05d9 \u05dc\u05e6\u05d5\u05e8\u05da \u05d4\u05e2\u05e8\u05db\u05ea \u05de\u05e9\u05db\u05d5 (Synopsis ch.22).",
      "hint": "\u05de\u05d3\u05d5\u05d1\u05e8 \u05d1\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05e9\u05e8\u05d5\u05d5\u05dc \u05dc\u05d7\u05e5 \u05d3\u05dd \u05d4\u05de\u05e0\u05d5\u05e4\u05d7 \u05de\u05e2\u05dc \u05d4\u05dc\u05d7\u05e5 \u05d4\u05e1\u05d9\u05e1\u05d8\u05d5\u05dc\u05d9 \u05dc\u05e4\u05e0\u05d9 \u05d4\u05d6\u05e8\u05e7\u05ea \u05de\u05e8\u05e4\u05d4 \u05d4\u05e9\u05e8\u05d9\u05e8\u05d9\u05dd."
    },
    {
      "type": "short_answer",
      "question": "\u05de\u05d4\u05dd \u05d4\u05ea\u05e0\u05d0\u05d9\u05dd \u05d4\u05de\u05e9\u05e4\u05d8\u05d9\u05d9\u05dd \u05d5\u05d4\u05d0\u05ea\u05d9\u05d9\u05dd \u05d4\u05de\u05e8\u05db\u05d6\u05d9\u05d9\u05dd \u05d4\u05e0\u05d3\u05e8\u05e9\u05d9\u05dd \u05dc\u05d1\u05d9\u05e6\u05d5\u05e2 ECT \u05d1\u05e7\u05d8\u05d9\u05df \u05d1\u05d9\u05e9\u05e8\u05d0\u05dc, \u05d5\u05de\u05d9 \u05d4\u05d2\u05d5\u05e8\u05dd \u05d4\u05de\u05d0\u05e9\u05e8?",
      "grading": {
        "modelAnswer": "\u05dc\u05d1\u05d9\u05e6\u05d5\u05e2 ECT \u05d1\u05e7\u05d8\u05d9\u05df \u05d1\u05d9\u05e9\u05e8\u05d0\u05dc \u05e0\u05d3\u05e8\u05e9\u05ea \u05d4\u05e1\u05db\u05de\u05d4 \u05de\u05d3\u05e2\u05ea \u05e9\u05dc \u05d4\u05d0\u05e4\u05d5\u05d8\u05e8\u05d5\u05e4\u05d5\u05e1\u05d9\u05dd \u05d4\u05d7\u05d5\u05e7\u05d9\u05d9\u05dd (\u05d4\u05d5\u05e8\u05d9\u05dd), \u05d5\u05d1\u05e0\u05d5\u05e1\u05e3 \u05d0\u05d9\u05e9\u05d5\u05e8 \u05e9\u05dc \u05d5\u05d5\u05e2\u05d3\u05d4 \u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9\u05ea \u05de\u05d7\u05d5\u05d6\u05d9\u05ea \u05d0\u05d5 \u05d5\u05d5\u05e2\u05d3\u05d4 \u05d0\u05ea\u05d9\u05ea \u05de\u05d9\u05d5\u05d7\u05d3\u05ea. \u05d4\u05ea\u05d4\u05dc\u05d9\u05da \u05de\u05d7\u05d9\u05d9\u05d1 \u05ea\u05d9\u05e2\u05d5\u05d3 \u05e9\u05dc \u05e2\u05de\u05d9\u05d3\u05d5\u05ea \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc\u05d9\u05dd \u05e7\u05d5\u05d3\u05de\u05d9\u05dd \u05d0\u05d5 \u05de\u05e6\u05d1 \u05d7\u05d9\u05e8\u05d5\u05dd \u05de\u05e1\u05db\u05df \u05d7\u05d9\u05d9\u05dd (Dulcan p.637, p.683; Syllabus p.14).",
        "rationale": "\u05d1\u05d9\u05e9\u05e8\u05d0\u05dc, \u05d1\u05e9\u05dc \u05d4\u05d9\u05d5\u05ea\u05d5 \u05e9\u05dc \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05e4\u05d5\u05dc\u05e9\u05e0\u05d9 \u05d5\u05d1\u05e2\u05dc \u05e1\u05d8\u05d9\u05d2\u05de\u05d4, \u05e7\u05d9\u05d9\u05de\u05ea \u05e8\u05d2\u05d5\u05dc\u05e6\u05d9\u05d4 \u05de\u05d7\u05de\u05d9\u05e8\u05d4 \u05d4\u05db\u05d5\u05dc\u05dc\u05ea \u05d1\u05e7\u05e8\u05d4 \u05d7\u05d9\u05e6\u05d5\u05e0\u05d9\u05ea \u05e2\u05dc \u05d4\u05d7\u05dc\u05d8\u05ea \u05d4\u05d4\u05d5\u05e8\u05d9\u05dd \u05d5\u05d4\u05e8\u05d5\u05e4\u05d0\u05d9\u05dd.",
        "requiredAttributes": [
          "\u05d4\u05e1\u05db\u05de\u05d4 \u05de\u05d3\u05e2\u05ea \u05e9\u05dc \u05d4\u05d5\u05e8\u05d9\u05dd/\u05d0\u05e4\u05d5\u05d8\u05e8\u05d5\u05e4\u05d5\u05e1\u05d9\u05dd",
          "\u05d0\u05d9\u05e9\u05d5\u05e8 \u05d5\u05e2\u05d3\u05d4 \u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9\u05ea \u05de\u05d7\u05d5\u05d6\u05d9\u05ea \u05d0\u05d5 \u05d5\u05e2\u05d3\u05ea \u05de\u05d5\u05de\u05d7\u05d9\u05dd",
          "\u05d4\u05e6\u05d3\u05e7\u05d4 \u05e7\u05dc\u05d9\u05e0\u05d9\u05ea (\u05e2\u05de\u05d9\u05d3\u05d5\u05ea \u05d0\u05d5 \u05e1\u05db\u05e0\u05ea \u05d7\u05d9\u05d9\u05dd)"
        ],
        "errors": {
