{
  "title": "ECT Quiz",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\u05de\u05ea\u05d1\u05d2\u05e8 \u05d1\u05df 16 \u05e2\u05dd Major Depressive Disorder (MDD) \u05d0\u05d9\u05e0\u05d5 \u05de\u05d2\u05d9\u05d1 \u05dc\u05e9\u05e0\u05d9 \u05e0\u05d9\u05e1\u05d9\u05d5\u05e0\u05d5\u05ea \u05e9\u05dc SSRI \u05d5\u05dc\u05e0\u05d9\u05e1\u05d9\u05d5\u05df \u05e9\u05dc Venlafaxine \u05d1\u05e9\u05d9\u05dc\u05d5\u05d1 \u05e2\u05dd CBT. \u05d1\u05e9\u05d1\u05d5\u05e2\u05d9\u05d9\u05dd \u05d4\u05d0\u05d7\u05e8\u05d5\u05e0\u05d9\u05dd \u05de\u05e6\u05d9\u05d2 Stupor, Mutism \u05d5-Waxy flexibility. \u05d4\u05d5\u05d0 \u05de\u05e1\u05e8\u05d1 \u05dc\u05d0\u05db\u05d5\u05dc \u05d5\u05dc\u05e9\u05ea\u05d5\u05ea (Inanition), \u05d5\u05de\u05e6\u05d1\u05d5 \u05d4\u05d2\u05d5\u05e4\u05e0\u05d9 \u05de\u05d9\u05d3\u05e8\u05d3\u05e8 \u05d1\u05de\u05d4\u05d9\u05e8\u05d5\u05ea. \u05de\u05d4\u05d9 \u05d4\u05d4\u05ea\u05e2\u05e8\u05d1\u05d5\u05ea \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc\u05d9\u05ea \u05d4\u05de\u05d5\u05de\u05dc\u05e6\u05ea \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d1\u05e9\u05dc\u05d1 \u05d6\u05d4?",
      "answerOptions": [
        {
          "text": "\u05d4\u05ea\u05d7\u05dc\u05ea \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-ECT.",
          "isCorrect": true,
          "rationale": "\u05d1\u05de\u05e6\u05d1\u05d9 \u05e7\u05d8\u05d8\u05d5\u05e0\u05d9\u05d4, \u05e1\u05d9\u05e8\u05d5\u05d1 \u05d0\u05db\u05d9\u05dc\u05d4 (Inanition) \u05d0\u05d5 \u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05e2\u05de\u05d9\u05d3 (TRD) \u05e2\u05dd \u05e1\u05db\u05e0\u05ea \u05d7\u05d9\u05d9\u05dd \u05de\u05d9\u05d9\u05d3\u05d9\u05ea, ECT \u05e0\u05d7\u05e9\u05d1 \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05de\u05d4\u05d9\u05e8 \u05d5\u05d4\u05d0\u05e4\u05e7\u05d8\u05d9\u05d1\u05d9 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05d4\u05e6\u05dc\u05ea \u05d7\u05d9\u05d9\u05dd (Dulcan p.264; Synopsis ch.22)."
        },
        {
          "text": "\u05d4\u05d7\u05dc\u05e4\u05ea \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05ea\u05e8\u05d5\u05e4\u05ea\u05d9 \u05dc-Clozapine.",
          "isCorrect": false,
          "rationale": "Clozapine \u05de\u05d9\u05d5\u05e2\u05d3 \u05dc\u05e1\u05db\u05d9\u05d6\u05d5\u05e4\u05e8\u05e0\u05d9\u05d4 \u05e2\u05de\u05d9\u05d3\u05d4, \u05d0\u05da \u05d1\u05de\u05e6\u05d1 \u05d0\u05e7\u05d5\u05d8\u05d9 \u05e9\u05dc \u05e7\u05d8\u05d8\u05d5\u05e0\u05d9\u05d4 \u05d5\u05e1\u05db\u05e0\u05ea \u05d7\u05d9\u05d9\u05dd \u05e2\u05e7\u05d1 \u05d7\u05d5\u05e1\u05e8 \u05d0\u05db\u05d9\u05dc\u05d4, ECT \u05d4\u05d5\u05d0 \u05d4\u05de\u05e2\u05e0\u05d4 \u05d4\u05de\u05d4\u05d9\u05e8 \u05d5\u05d4\u05de\u05ea\u05d0\u05d9\u05dd \u05d9\u05d5\u05ea\u05e8 (Synopsis ch.22)."
        },
        {
          "text": "\u05d4\u05d5\u05e1\u05e4\u05ea Lithium \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05e7\u05d9\u05d9\u05dd.",
          "isCorrect": false,
          "rationale": "\u05d1\u05e2\u05d5\u05d3 \u05e9-Lithium \u05de\u05e9\u05de\u05e9 \u05dc\u05d0\u05d5\u05d2\u05de\u05e0\u05d8\u05e6\u05d9\u05d4 \u05d1\u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05e2\u05de\u05d9\u05d3, \u05d4\u05d5\u05d0 \u05d0\u05d9\u05e0\u05d5 \u05e0\u05d5\u05ea\u05df \u05de\u05e2\u05e0\u05d4 \u05de\u05d4\u05d9\u05e8 \u05de\u05e1\u05e4\u05d9\u05e7 \u05dc\u05de\u05e6\u05d1 \u05e9\u05dc Inanition \u05d5\u05e7\u05d8\u05d8\u05d5\u05e0\u05d9\u05d4 \u05de\u05e1\u05db\u05e0\u05ea \u05d7\u05d9\u05d9\u05dd (Dulcan p.264)."
        },
        {
          "text": "\u05d4\u05ea\u05d7\u05dc\u05ea \u05e1\u05d3\u05e8\u05ea \u05d8\u05d9\u05e4\u05d5\u05dc\u05d9 rTMS.",
          "isCorrect": false,
          "rationale": "rTMS \u05e0\u05d7\u05e9\u05d1 \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-TRD \u05d1\u05de\u05e6\u05d1\u05d9\u05dd \u05e4\u05d7\u05d5\u05ea \u05d3\u05d7\u05d5\u05e4\u05d9\u05dd; \u05d1\u05de\u05e6\u05d1\u05d9 \u05d7\u05d9\u05e8\u05d5\u05dd \u05e7\u05d8\u05d8\u05d5\u05e0\u05d9\u05d9\u05dd, ECT \u05d4\u05d5\u05d0 \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05de\u05d5\u05e2\u05d3\u05e3 \u05d5\u05d4\u05de\u05d1\u05d5\u05e1\u05e1 \u05d9\u05d5\u05ea\u05e8 (Synopsis ch.22)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05de\u05d4\u05d9\u05e8\u05d5\u05ea \u05d4\u05e0\u05d3\u05e8\u05e9\u05ea \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05de\u05e6\u05d1 \u05e9\u05dc \u05e7\u05d8\u05d8\u05d5\u05e0\u05d9\u05d4 \u05de\u05e1\u05db\u05e0\u05ea \u05d7\u05d9\u05d9\u05dd.",
      "covered": [
        "ECT indications in pediatrics"
      ]
    },
    {
      "type": "multiple_choice",
      "question": "\u05de\u05d8\u05d5\u05e4\u05dc \u05d1\u05df 17 \u05d4\u05e1\u05d5\u05d1\u05dc \u05de-Bipolar I Disorder, Manic Episode, \u05de\u05d9\u05d5\u05e2\u05d3 \u05dc\u05d4\u05ea\u05d7\u05dc\u05ea \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-ECT \u05e2\u05e7\u05d1 \u05e2\u05de\u05d9\u05d3\u05d5\u05ea \u05dc-Lithium \u05d5-Haloperidol. \u05de\u05d4\u05d9 \u05d4\u05d4\u05e0\u05d7\u05d9\u05d4 \u05d4\u05d7\u05e9\u05d5\u05d1\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05d2\u05d1\u05d9 \u05d4-Lithium \u05dc\u05e4\u05e0\u05d9 \u05d1\u05d9\u05e6\u05d5\u05e2 \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc?",
      "answerOptions": [
        {
          "text": "\u05d9\u05e9 \u05dc\u05d4\u05e4\u05e1\u05d9\u05e7 \u05d0\u05ea \u05d4-Lithium \u05dc\u05e4\u05e0\u05d9 \u05ea\u05d7\u05d9\u05dc\u05ea \u05d4-ECT.",
          "isCorrect": true,
          "rationale": "\u05e9\u05d9\u05dc\u05d5\u05d1 \u05e9\u05dc Lithium \u05d5-ECT \u05de\u05e2\u05dc\u05d4 \u05d0\u05ea \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05d3\u05dc\u05d9\u05e8\u05d9\u05d5\u05dd \u05e4\u05d5\u05e1\u05d8-\u05d0\u05d9\u05e7\u05d8\u05dc\u05d9 \u05de\u05de\u05d5\u05e9\u05da, \u05d1\u05dc\u05d1\u05d5\u05dc \u05d5\u05e0\u05d5\u05d9\u05e8\u05d5\u05d8\u05d5\u05e7\u05e1\u05d9\u05d5\u05ea (Synopsis ch.22; StahlKids p.285)."
        },
        {
          "text": "\u05d9\u05e9 \u05dc\u05d4\u05de\u05e9\u05d9\u05da \u05d0\u05ea \u05d4-Lithium \u05db\u05d3\u05d9 \u05dc\u05de\u05e0\u05d5\u05e2 Switch \u05dc\u05de\u05d0\u05e0\u05d9\u05d4 \u05e1\u05d5\u05e2\u05e8\u05ea.",
          "isCorrect": false,
          "rationale": "\u05d4\u05de\u05e9\u05da Lithium \u05de\u05e2\u05dc\u05d4 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05d0\u05ea \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05e1\u05d9\u05d1\u05d5\u05db\u05d9\u05dd \u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9\u05d9\u05dd \u05d5\u05e0\u05d5\u05d9\u05e8\u05d5\u05d8\u05d5\u05e7\u05e1\u05d9\u05d5\u05ea \u05d1\u05de\u05d4\u05dc\u05da ECT (Synopsis ch.22)."
        },
        {
          "text": "\u05d9\u05e9 \u05dc\u05d4\u05e2\u05dc\u05d5\u05ea \u05d0\u05ea \u05de\u05d9\u05e0\u05d5\u05df \u05d4-Lithium \u05db\u05d3\u05d9 \u05dc\u05d4\u05e2\u05dc\u05d5\u05ea \u05d0\u05ea \u05e1\u05e3 \u05d4\u05e4\u05e8\u05db\u05d5\u05e1.",
          "isCorrect": false,
          "rationale": "Lithium \u05d3\u05d5\u05d5\u05e7\u05d0 \u05e2\u05e9\u05d5\u05d9 \u05dc\u05d4\u05d5\u05e8\u05d9\u05d3 \u05d0\u05ea \u05e1\u05e3 \u05d4\u05e4\u05e8\u05db\u05d5\u05e1 \u05d0\u05d5 \u05dc\u05d2\u05e8\u05d5\u05dd \u05dc\u05e4\u05e8\u05db\u05d5\u05e1\u05d9\u05dd \u05de\u05de\u05d5\u05e9\u05db\u05d9\u05dd \u05d5\u05dc\u05d0 \u05e0\u05e9\u05dc\u05d8\u05d9\u05dd \u05d1\u05e9\u05d9\u05dc\u05d5\u05d1 \u05e2\u05dd ECT (Synopsis ch.22)."
        },
        {
          "text": "\u05d9\u05e9 \u05dc\u05d4\u05d7\u05dc\u05d9\u05e3 \u05d0\u05ea \u05d4-Lithium \u05d1-Theophylline \u05dc\u05e6\u05d5\u05e8\u05da \u05d4\u05db\u05e0\u05d4 \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc.",
          "isCorrect": false,
          "rationale": "Theophylline \u05de\u05d4\u05d5\u05d5\u05d4 \u05d4\u05ea\u05d5\u05d5\u05d9\u05d9\u05ea \u05e0\u05d2\u05d3 \u05de\u05d5\u05d7\u05dc\u05d8\u05ea \u05d1-ECT \u05d1\u05e9\u05dc \u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d0\u05e4\u05d9\u05dc\u05e4\u05d8\u05d9\u05e7\u05d5\u05e1 (Synopsis ch.22)."
        }
      ],
      "hint": "\u05e9\u05d9\u05dc\u05d5\u05d1 \u05de\u05e1\u05d5\u05d9\u05dd \u05e9\u05dc \u05de\u05d9\u05d9\u05e6\u05d1\u05d9 \u05de\u05e6\u05d1 \u05e8\u05d5\u05d7 \u05e2\u05dd ECT \u05e2\u05dc\u05d5\u05dc \u05dc\u05d2\u05e8\u05d5\u05dd \u05dc\u05d1\u05dc\u05d1\u05d5\u05dc \u05e0\u05d5\u05d9\u05e8\u05d5\u05d8\u05d5\u05e7\u05e1\u05d9 \u05e7\u05e9\u05d4.",
      "covered": [
        "ECT monitoring protocol"
      ]
    },
    {
      "type": "multiple_choice",
      "question": "\u05d1\u05de\u05d4\u05dc\u05da \u05e1\u05d3\u05e8\u05ea \u05d8\u05d9\u05e4\u05d5\u05dc\u05d9 ECT \u05d1\u05e0\u05e2\u05e8\u05d4 \u05d1\u05ea 15, \u05d4\u05e6\u05d5\u05d5\u05ea \u05de\u05ea\u05dc\u05d1\u05d8 \u05d1\u05d9\u05df \u05de\u05d9\u05e7\u05d5\u05dd \u05d0\u05dc\u05e7\u05d8\u05e8\u05d5\u05d3\u05d5\u05ea Right Unilateral (RUL) \u05dc\u05d1\u05d9\u05df Bilateral (BL). \u05d0\u05d9\u05d6\u05d4 \u05de\u05d4\u05de\u05e9\u05e4\u05d8\u05d9\u05dd \u05d4\u05d1\u05d0\u05d9\u05dd \u05de\u05ea\u05d0\u05e8 \u05e0\u05db\u05d5\u05df \u05d0\u05ea \u05d4\u05d4\u05d1\u05d3\u05dc \u05d1\u05d9\u05e0\u05d9\u05d4\u05dd?",
      "answerOptions": [
        {
          "text": "RUL \u05e0\u05de\u05e6\u05d0 \u05e7\u05e9\u05d5\u05e8 \u05dc\u05e4\u05d7\u05d5\u05ea \u05ea\u05d5\u05e4\u05e2\u05d5\u05ea \u05dc\u05d5\u05d5\u05d0\u05d9 \u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9\u05d5\u05ea \u05d1\u05d4\u05e9\u05d5\u05d5\u05d0\u05d4 \u05dc-BL.",
          "isCorrect": true,
          "rationale": "\u05de\u05d9\u05e7\u05d5\u05dd \u05d0\u05dc\u05e7\u05d8\u05e8\u05d5\u05d3\u05d5\u05ea \u05d7\u05d3-\u05e6\u05d3\u05d3\u05d9 (RUL) \u05de\u05e4\u05d7\u05d9\u05ea \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05d0\u05ea \u05d7\u05d5\u05de\u05e8\u05ea \u05d4\u05d0\u05de\u05e0\u05d6\u05d9\u05d4 \u05d5\u05d4\u05d1\u05dc\u05d1\u05d5\u05dc \u05d1\u05d4\u05e9\u05d5\u05d5\u05d0\u05d4 \u05dc\u05de\u05d9\u05e7\u05d5\u05dd \u05d3\u05d5-\u05e6\u05d3\u05d3\u05d9 (Synopsis ch.22)."
        },
        {
          "text": "BL \u05d3\u05d5\u05e8\u05e9 \u05de\u05d9\u05e0\u05d5\u05df \u05d7\u05e9\u05de\u05dc\u05d9 \u05e0\u05de\u05d5\u05da \u05d9\u05d5\u05ea\u05e8 \u05db\u05d3\u05d9 \u05dc\u05d4\u05e9\u05d9\u05d2 \u05d9\u05e2\u05d9\u05dc\u05d5\u05ea \u05d6\u05d4\u05d4 \u05dc-RUL.",
          "isCorrect": false,
          "rationale": "\u05db\u05d3\u05d9 \u05dc\u05d4\u05e9\u05d9\u05d2 \u05d9\u05e2\u05d9\u05dc\u05d5\u05ea \u05d1-RUL, \u05e0\u05d3\u05e8\u05e9 \u05dc\u05e8\u05d5\u05d1 \u05de\u05d9\u05e0\u05d5\u05df \u05d4\u05d2\u05d1\u05d5\u05d4 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05de\u05e1\u05e3 \u05d4\u05e4\u05e8\u05db\u05d5\u05e1 (\u05e2\u05d3 500%), \u05d1\u05e2\u05d5\u05d3 BL \u05d9\u05e2\u05d9\u05dc \u05d2\u05dd \u05d1\u05de\u05d9\u05e0\u05d5\u05e0\u05d9\u05dd \u05e7\u05e8\u05d5\u05d1\u05d9\u05dd \u05d9\u05d5\u05ea\u05e8 \u05dc\u05e1\u05e3 (Synopsis ch.22)."
        },
        {
          "text": "RUL \u05d4\u05d5\u05d0 \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05de\u05d5\u05e2\u05d3\u05e3 \u05d1\u05de\u05e6\u05d1\u05d9 \u05e7\u05d8\u05d8\u05d5\u05e0\u05d9\u05d4 \u05d3\u05d7\u05d5\u05e4\u05d9\u05dd \u05d1\u05e9\u05dc \u05de\u05d4\u05d9\u05e8\u05d5\u05ea \u05d4\u05ea\u05d2\u05d5\u05d1\u05d4.",
          "isCorrect": false,
          "rationale": "BL \u05e0\u05d7\u05e9\u05d1 \u05dc\u05e8\u05d5\u05d1 \u05dc\u05de\u05d4\u05d9\u05e8 \u05d9\u05d5\u05ea\u05e8 \u05d1\u05d4\u05e9\u05d2\u05ea \u05ea\u05d2\u05d5\u05d1\u05d4 \u05e7\u05dc\u05d9\u05e0\u05d9\u05ea, \u05d5\u05dc\u05db\u05df \u05e2\u05e9\u05d5\u05d9 \u05dc\u05d4\u05d9\u05d1\u05d7\u05e8 \u05d1\u05de\u05e6\u05d1\u05d9\u05dd \u05d3\u05d7\u05d5\u05e4\u05d9\u05dd \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05de\u05e8\u05d5\u05ea \u05ea\u05d5\u05e4\u05e2\u05d5\u05ea \u05d4\u05dc\u05d5\u05d5\u05d0\u05d9 (Synopsis ch.22)."
