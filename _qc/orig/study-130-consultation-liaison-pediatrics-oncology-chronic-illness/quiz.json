          "\u05e6\u05d9\u05d5\u05df 12 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05db\u05de\u05e9\u05da \u05d4\u05de\u05d9\u05e0\u05d9\u05de\u05dc\u05d9 \u05d1\u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd."
        ],
        "errors": {
          "misconceptions": [
