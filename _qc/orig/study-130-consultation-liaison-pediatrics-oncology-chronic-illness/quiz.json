{
  "title": "Pediatric Psychiatry Quiz",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\u05d9\u05dc\u05d3 \u05d1\u05df 8 \u05d4\u05de\u05d0\u05d5\u05e9\u05e4\u05d6 \u05d1\u05de\u05d7\u05dc\u05e7\u05d4 \u05d4\u05de\u05d8\u05d5\u05d0\u05d5\u05e0\u05e7\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea \u05d1\u05e9\u05dc Leukemia \u05de\u05e6\u05d9\u05d2 \u05d7\u05d5\u05dc\u05e9\u05d4, \u05d0\u05e4\u05d8\u05d9\u05d5\u05ea \u05e7\u05d9\u05e6\u05d5\u05e0\u05d9\u05ea, \u05dc\u05ea\u05e8\u05d2\u05d9\u05d4 \u05d5\u05d7\u05d5\u05e1\u05e8 \u05e9\u05d9\u05ea\u05d5\u05e3 \u05e4\u05e2\u05d5\u05dc\u05d4 \u05e2\u05dd \u05d4\u05e6\u05d5\u05d5\u05ea \u05d4\u05e1\u05d9\u05e2\u05d5\u05d3\u05d9. \u05d1\u05d1\u05d3\u05d9\u05e7\u05ea \u05de\u05e6\u05d1 \u05d4\u05db\u05e8\u05d4 \u05e0\u05e8\u05d0\u05d4 \u05db\u05d9 \u05d4\u05d5\u05d0 \u05e9\u05e7\u05d8 \u05de\u05d0\u05d5\u05d3, \u05d0\u05da \u05dc\u05e2\u05d9\u05ea\u05d9\u05dd \u05de\u05e0\u05e1\u05d4 \u05dc\u05de\u05e9\u05d5\u05da \u05d1\u05e6\u05d9\u05e0\u05d5\u05e8 \u05d4-IV \u05e9\u05dc\u05d5 \u05dc\u05dc\u05d0 \u05de\u05d8\u05e8\u05d4 \u05d1\u05e8\u05d5\u05e8\u05d4. \u05d4\u05e6\u05d5\u05d5\u05ea \u05d4\u05e8\u05e4\u05d5\u05d0\u05d9 \u05e9\u05d5\u05e7\u05dc \u05dc\u05d4\u05d5\u05e1\u05d9\u05e3 Morphine \u05d1\u05e9\u05dc \u05d7\u05e9\u05d3 \u05dc\u05db\u05d0\u05d1 \u05e9\u05dc\u05d0 \u05d8\u05d5\u05e4\u05dc. \u05de\u05d4\u05d9 \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05e1\u05d1\u05d9\u05e8\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d5\u05de\u05d4\u05d5 \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05d1\u05d4\u05ea\u05e2\u05e8\u05d1\u05d5\u05ea \u05d4\u05de\u05d5\u05e6\u05e2\u05ea?",
      "answerOptions": [
        {
          "text": "\u05de\u05d3\u05d5\u05d1\u05e8 \u05d1-Hypoactive Delirium; \u05de\u05ea\u05df Morphine \u05e2\u05dc\u05d5\u05dc \u05dc\u05d4\u05d7\u05de\u05d9\u05e8 \u05d0\u05ea \u05d4\u05d3\u05d9\u05db\u05d5\u05d9 \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05d5\u05d4\u05d1\u05dc\u05d1\u05d5\u05dc.",
          "isCorrect": true,
          "rationale": "\u05d6\u05d4\u05d5 \u05d4-Opioid Toxicity Trap; \u05d3\u05dc\u05d9\u05e8\u05d9\u05d5\u05dd \u05d4\u05d9\u05e4\u05d5\u05d0\u05e7\u05d8\u05d9\u05d1\u05d9 \u05d4\u05d5\u05d0 \u05d4\u05e9\u05db\u05d9\u05d7 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05de\u05d0\u05d5\u05e9\u05e4\u05d6\u05d9\u05dd \u05d5\u05e4\u05d9\u05e8\u05d5\u05e9 \u05de\u05d5\u05d8\u05e2\u05d4 \u05e9\u05dc\u05d5 \u05db\u05db\u05d0\u05d1 \u05d5\u05d4\u05d5\u05e1\u05e4\u05ea \u05d0\u05d5\u05e4\u05d9\u05d5\u05d0\u05d9\u05d3\u05d9\u05dd \u05de\u05d7\u05de\u05d9\u05e8\u05d4 \u05d0\u05ea \u05d4\u05de\u05e6\u05d1 (Dulcan p.616)."
        },
        {
          "text": "\u05de\u05d3\u05d5\u05d1\u05e8 \u05d1-Major Depressive Disorder; \u05de\u05ea\u05df Morphine \u05d9\u05e1\u05d9\u05d9\u05e2 \u05d1\u05d4\u05e4\u05d7\u05ea\u05ea \u05d4\u05ea\u05dc\u05d5\u05e0\u05d5\u05ea \u05d4\u05e1\u05d5\u05de\u05d8\u05d9\u05d5\u05ea \u05d4\u05e0\u05dc\u05d5\u05d5\u05ea.",
          "isCorrect": false,
          "rationale": "\u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05d0\u05d9\u05e0\u05d5 \u05de\u05ea\u05e4\u05ea\u05d7 \u05d1\u05e6\u05d5\u05e8\u05d4 \u05d0\u05e7\u05d5\u05d8\u05d9\u05ea \u05db\u05d6\u05d5 \u05e2\u05dd \u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05d1\u05e7\u05e9\u05d1 \u05d5\u05d1\u05de\u05d5\u05d3\u05e2\u05d5\u05ea, \u05d5\u05d0\u05d5\u05e4\u05d9\u05d5\u05d0\u05d9\u05d3\u05d9\u05dd \u05d0\u05d9\u05e0\u05dd \u05d8\u05d9\u05e4\u05d5\u05dc \u05dc\u05d3\u05d9\u05db\u05d0\u05d5\u05df (DSM p.672)."
        },
        {
          "text": "\u05de\u05d3\u05d5\u05d1\u05e8 \u05d1-Oppositional Defiant Disorder; \u05de\u05ea\u05df Morphine \u05d9\u05d2\u05e8\u05d5\u05dd \u05dc\u05e1\u05d3\u05e6\u05d9\u05d4 \u05e9\u05ea\u05d0\u05e4\u05e9\u05e8 \u05e9\u05d9\u05ea\u05d5\u05e3 \u05e4\u05e2\u05d5\u05dc\u05d4.",
          "isCorrect": false,
          "rationale": "ODD \u05d4\u05d9\u05d0 \u05d4\u05e4\u05e8\u05e2\u05d4 \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea\u05d9\u05ea \u05db\u05e8\u05d5\u05e0\u05d9\u05ea \u05d5\u05dc\u05d0 \u05d4\u05e1\u05d1\u05e8 \u05dc\u05e9\u05d9\u05e0\u05d5\u05d9 \u05d0\u05e7\u05d5\u05d8\u05d9 \u05d1\u05de\u05e6\u05d1 \u05d4\u05db\u05e8\u05d4 \u05d1\u05d9\u05dc\u05d3 \u05de\u05d0\u05d5\u05e9\u05e4\u05d6 (Dulcan p.616)."
        },
        {
          "text": "\u05de\u05d3\u05d5\u05d1\u05e8 \u05d1-Adjustment Disorder; \u05de\u05ea\u05df Morphine \u05d4\u05d5\u05d0 \u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05d1\u05d7\u05d9\u05e8\u05d4 \u05dc\u05db\u05d0\u05d1 \u05e4\u05e1\u05d9\u05db\u05d5\u05d2\u05e0\u05d9 \u05d1\u05de\u05e6\u05d1\u05d9 \u05d3\u05d7\u05e7.",
          "isCorrect": false,
          "rationale": "\u05d4\u05e4\u05e8\u05e2\u05ea \u05d4\u05e1\u05ea\u05d2\u05dc\u05d5\u05ea \u05d0\u05d9\u05e0\u05d4 \u05de\u05e1\u05d1\u05d9\u05e8\u05d4 \u05d0\u05ea \u05d4\u05e1\u05d9\u05de\u05e0\u05d9\u05dd \u05d4\u05e0\u05d5\u05d9\u05e8\u05d5\u05dc\u05d5\u05d2\u05d9\u05d9\u05dd \u05e9\u05dc \u05d7\u05d5\u05e1\u05e8 \u05de\u05d5\u05d3\u05e2\u05d5\u05ea \u05dc\u05e1\u05d1\u05d9\u05d1\u05d4 \u05d5\u05de\u05e9\u05d9\u05db\u05d4 \u05d1\u05e6\u05d9\u05e0\u05d5\u05e8\u05d5\u05ea (DSM p.672)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05ea\u05ea-\u05e1\u05d5\u05d2 \u05e9\u05dc \u05d3\u05dc\u05d9\u05e8\u05d9\u05d5\u05dd \u05e9\u05e0\u05d5\u05d8\u05d4 \u05dc\u05d4\u05d9\u05d5\u05ea \u05e9\u05e7\u05d8 \u05d5\u05de\u05d5\u05d7\u05de\u05e5 \u05d1\u05de\u05d7\u05dc\u05e7\u05d5\u05ea \u05e8\u05e4\u05d5\u05d0\u05d9\u05d5\u05ea.",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05d9\u05dc\u05d3\u05d4 \u05d1\u05ea 4 \u05d0\u05d9\u05d1\u05d3\u05d4 \u05d0\u05ea \u05e1\u05d1\u05d4 \u05dc\u05e4\u05e0\u05d9 \u05db\u05e9\u05dc\u05d5\u05e9\u05d4 \u05e9\u05d1\u05d5\u05e2\u05d5\u05ea. \u05d4\u05d9\u05d0 \u05e9\u05d5\u05d0\u05dc\u05ea \u05d0\u05ea \u05d0\u05de\u05d4 \u05de\u05d3\u05d9 \u05d9\u05d5\u05dd '\u05de\u05ea\u05d9 \u05e1\u05d1\u05d0 \u05d9\u05ea\u05e2\u05d5\u05e8\u05e8 \u05de\u05d4\u05e9\u05d9\u05e0\u05d4 \u05e9\u05dc\u05d5 \u05d5\u05d9\u05d1\u05d5\u05d0 \u05dc\u05e9\u05d7\u05e7 \u05d0\u05d9\u05ea\u05d9?'. \u05d4\u05d0\u05dd \u05de\u05d5\u05d3\u05d0\u05d2\u05ea \u05de\u05d4\u05db\u05d7\u05e9\u05ea \u05d4\u05de\u05d5\u05d5\u05ea. \u05e2\u05dc \u05e4\u05d9 \u05d4\u05d1\u05e0\u05ea \u05ea\u05e4\u05d9\u05e1\u05ea \u05d4\u05de\u05d5\u05d5\u05ea \u05d4\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9\u05ea, \u05db\u05d9\u05e6\u05d3 \u05d9\u05e9 \u05dc\u05d4\u05de\u05e9\u05d9\u05d2 \u05d0\u05ea \u05ea\u05d2\u05d5\u05d1\u05ea\u05d4?",
      "answer": "\u05ea\u05e4\u05d9\u05e1\u05d4 \u05e0\u05d5\u05e8\u05de\u05d8\u05d9\u05d1\u05d9\u05ea \u05dc\u05d2\u05d9\u05dc \u05d4\u05d2\u05df; \u05d4\u05de\u05d5\u05d5\u05ea \u05e0\u05ea\u05e4\u05e1 \u05db\u05d6\u05de\u05e0\u05d9, \u05d4\u05e4\u05d9\u05da \u05d5\u05d3\u05d5\u05de\u05d4 \u05dc\u05e9\u05d9\u05e0\u05d4.",
      "answerOptions": [
        {
          "text": "\u05ea\u05e4\u05d9\u05e1\u05d4 \u05e0\u05d5\u05e8\u05de\u05d8\u05d9\u05d1\u05d9\u05ea \u05dc\u05d2\u05d9\u05dc \u05d4\u05d2\u05df; \u05d4\u05de\u05d5\u05d5\u05ea \u05e0\u05ea\u05e4\u05e1 \u05db\u05d6\u05de\u05e0\u05d9, \u05d4\u05e4\u05d9\u05da \u05d5\u05d3\u05d5\u05de\u05d4 \u05dc\u05e9\u05d9\u05e0\u05d4.",
          "isCorrect": true,
          "rationale": "\u05d1\u05d2\u05d9\u05dc\u05d0\u05d9 3-5 (Preschool age), \u05d9\u05dc\u05d3\u05d9\u05dd \u05d8\u05e8\u05dd \u05ea\u05d5\u05e4\u05e1\u05d9\u05dd \u05d0\u05ea \u05d4\u05e1\u05d5\u05e4\u05d9\u05d5\u05ea \u05e9\u05dc \u05d4\u05de\u05d5\u05d5\u05ea \u05d5\u05e8\u05d5\u05d0\u05d9\u05dd \u05d1\u05d5 \u05de\u05e6\u05d1 \u05d4\u05e4\u05d9\u05da (DSM p.325; Dulcan p.625)."
        },
        {
          "text": "\u05d1\u05d9\u05d8\u05d5\u05d9 \u05de\u05d5\u05e7\u05d3\u05dd \u05e9\u05dc Prolonged Grief Disorder; \u05d4\u05d9\u05dc\u05d3\u05d4 \u05de\u05e8\u05d0\u05d4 \u05d7\u05d5\u05e1\u05e8 \u05d9\u05db\u05d5\u05dc\u05ea \u05dc\u05e7\u05d1\u05dc \u05d0\u05ea \u05d4\u05d0\u05d5\u05d1\u05d3\u05df.",
          "isCorrect": false,
          "rationale": "PGD \u05d3\u05d5\u05e8\u05e9\u05ea \u05de\u05e9\u05da \u05e9\u05dc \u05dc\u05e4\u05d7\u05d5\u05ea 6 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd, \u05d5\u05d4\u05ea\u05d2\u05d5\u05d1\u05d4 \u05d4\u05de\u05ea\u05d5\u05d0\u05e8\u05ea \u05ea\u05d5\u05d0\u05de\u05ea \u05d0\u05ea \u05e9\u05dc\u05d1\u05d4 \u05d4\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9 (DSM p.323)."
        },
        {
          "text": "\u05e9\u05d9\u05de\u05d5\u05e9 \u05e4\u05ea\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d1-Magical Thinking; \u05d4\u05d9\u05dc\u05d3\u05d4 \u05de\u05e0\u05e1\u05d4 \u05dc\u05d4\u05d7\u05d9\u05d5\u05ea \u05d0\u05ea \u05d4\u05de\u05ea \u05d1\u05db\u05d5\u05d7 \u05de\u05d7\u05e9\u05d1\u05ea\u05d4.",
          "isCorrect": false,
          "rationale": "\u05d7\u05e9\u05d9\u05d1\u05d4 \u05de\u05d0\u05d2\u05d9\u05ea \u05d4\u05d9\u05d0 \u05e0\u05d5\u05e8\u05de\u05d8\u05d9\u05d1\u05d9\u05ea \u05d1\u05d2\u05d9\u05dc \u05d6\u05d4 \u05d5\u05d0\u05d9\u05e0\u05d4 \u05e0\u05d7\u05e9\u05d1\u05ea \u05e4\u05ea\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea \u05d1\u05d4\u05e7\u05e9\u05e8 \u05e9\u05dc \u05d0\u05d1\u05dc \u05d8\u05e8\u05d9 (Dulcan p.42)."
        },
        {
          "text": "\u05d4\u05e4\u05e8\u05e2\u05d4 \u05d1\u05ea\u05e4\u05d9\u05e1\u05ea \u05d4\u05de\u05e6\u05d9\u05d0\u05d5\u05ea; \u05d3\u05d5\u05e8\u05e9 \u05d1\u05d9\u05e8\u05d5\u05e8 \u05dc\u05e9\u05dc\u05d9\u05dc\u05ea \u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d4 \u05d1\u05d9\u05dc\u05d3\u05d5\u05ea.",
          "isCorrect": false,
          "rationale": "\u05d0\u05d9-\u05d4\u05d1\u05e0\u05ea \u05e1\u05d5\u05e4\u05d9\u05d5\u05ea \u05d4\u05de\u05d5\u05d5\u05ea \u05d1\u05d2\u05d9\u05dc 4 \u05d4\u05d9\u05d0 \u05de\u05d2\u05d1\u05dc\u05d4 \u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9\u05ea \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9\u05ea \u05d5\u05dc\u05d0 \u05d4\u05e4\u05e8\u05e2\u05d4 \u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9\u05ea (Dulcan p.625)."
        }
      ],
      "hint": "\u05d1\u05d2\u05d9\u05dc\u05d0\u05d9 \u05d4\u05d2\u05df, \u05d4\u05e7\u05d1\u05d9\u05e2\u05d5\u05ea (Permanence) \u05e9\u05dc \u05d4\u05de\u05d5\u05d5\u05ea \u05e2\u05d3\u05d9\u05d9\u05df \u05dc\u05d0 \u05d4\u05d5\u05e4\u05e0\u05de\u05d4 \u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9\u05ea.",
      "imageUrls": []
    },
    {
      "type": "multiple_select",
      "question": "\u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8 \u05d9\u05dc\u05d3\u05d9\u05dd \u05e0\u05e7\u05e8\u05d0 \u05dc\u05d9\u05d9\u05e2\u05d5\u05e5 \u05d1\u05de\u05d7\u05dc\u05e7\u05d4 \u05db\u05d9\u05e8\u05d5\u05e8\u05d2\u05d9\u05ea \u05db\u05d3\u05d9 \u05dc\u05d4\u05e2\u05e8\u05d9\u05da \u05d9\u05dc\u05d3 \u05e2\u05dd \u05e7\u05e9\u05d9\u05d9\u05dd \u05d1\u05d4\u05d9\u05e2\u05e0\u05d5\u05ea \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc (Nonadherence). \u05e2\u05dc \u05e4\u05d9 \u05d4\u05de\u05d5\u05d3\u05dc \u05e9\u05dc Kullgren et al., \u05de\u05d4\u05dd \u05d4\u05de\u05e8\u05db\u05d9\u05d1\u05d9\u05dd (6 \u05d4-C's) \u05e9\u05e2\u05dc \u05d4\u05d9\u05d5\u05e2\u05e5 \u05dc\u05d1\u05d7\u05d5\u05df \u05d1\u05de\u05e1\u05d2\u05e8\u05ea \u05e2\u05d1\u05d5\u05d3\u05ea \u05d4-Liaison?",
      "answerOptions": [
        {
          "text": "Compliance, Crisis, Communication",
          "isCorrect": true,
          "rationale": "\u05d0\u05dc\u05d5 \u05e9\u05dc\u05d5\u05e9\u05ea \u05d4\u05de\u05e8\u05db\u05d9\u05d1\u05d9\u05dd \u05d4\u05e8\u05d0\u05e9\u05d5\u05e0\u05d9\u05dd \u05d4\u05de\u05ea\u05de\u05e7\u05d3\u05d9\u05dd \u05d1\u05d4\u05d9\u05e2\u05e0\u05d5\u05ea, \u05de\u05e6\u05d1\u05d9 \u05de\u05e9\u05d1\u05e8 \u05d5\u05db\u05e9\u05dc\u05d9 \u05ea\u05e7\u05e9\u05d5\u05e8\u05ea (Dulcan p.1086)."
        },
        {
          "text": "Coping, Collaboration, Changing systems",
          "isCorrect": true,
          "rationale": "\u05d0\u05dc\u05d5 \u05e9\u05dc\u05d5\u05e9\u05ea \u05d4\u05de\u05e8\u05db\u05d9\u05d1\u05d9\u05dd \u05d4\u05e0\u05d5\u05e1\u05e4\u05d9\u05dd \u05d4\u05de\u05ea\u05de\u05e7\u05d3\u05d9\u05dd \u05d1\u05de\u05e0\u05d2\u05e0\u05d5\u05e0\u05d9 \u05d4\u05ea\u05de\u05d5\u05d3\u05d3\u05d5\u05ea, \u05e9\u05d9\u05ea\u05d5\u05e3 \u05e4\u05e2\u05d5\u05dc\u05d4 \u05d1\u05d9\u05df-\u05de\u05e7\u05e6\u05d5\u05e2\u05d9 \u05d5\u05d3\u05d9\u05e0\u05de\u05d9\u05e7\u05d4 \u05de\u05e2\u05e8\u05db\u05ea\u05d9\u05ea (Dulcan p.1086)."
        },
        {
          "text": "Cognition, Capacity, Consent",
          "isCorrect": false,
          "rationale": "\u05de\u05d5\u05e9\u05d2\u05d9\u05dd \u05d0\u05dc\u05d5 \u05e8\u05dc\u05d5\u05d5\u05e0\u05d8\u05d9\u05d9\u05dd \u05dc\u05d0\u05ea\u05d9\u05e7\u05d4 \u05d5\u05de\u05e9\u05e4\u05d8 \u05d0\u05da \u05d0\u05d9\u05e0\u05dd \u05d7\u05dc\u05e7 \u05de\u05de\u05d5\u05d3\u05dc 6 \u05d4-C's \u05d4\u05e1\u05e4\u05e6\u05d9\u05e4\u05d9 \u05e9\u05dc Kullgren \u05dc\u05d9\u05d9\u05e2\u05d5\u05e5 \u05e4\u05d3\u05d9\u05d0\u05d8\u05e8\u05d9 (Dulcan p.1086)."
        },
        {
          "text": "Catatonia, Comorbidity, Complexity",
          "isCorrect": false,
          "rationale": "\u05d0\u05dc\u05d5 \u05de\u05d5\u05e9\u05d2\u05d9\u05dd \u05e7\u05dc\u05d9\u05e0\u05d9\u05d9\u05dd \u05db\u05dc\u05dc\u05d9\u05d9\u05dd \u05e9\u05d0\u05d9\u05e0\u05dd \u05d7\u05dc\u05e7 \u05de\u05d4\u05de\u05d5\u05d3\u05dc \u05d4\u05de\u05d5\u05d1\u05e0\u05d4 \u05e9\u05dc Kullgren (Dulcan p.1086)."
        }
      ],
      "hint": "\u05d4\u05de\u05d5\u05d3\u05dc \u05de\u05ea\u05de\u05e7\u05d3 \u05d1\u05de\u05de\u05e9\u05e7 \u05e9\u05d1\u05d9\u05df \u05d4\u05d9\u05dc\u05d3, \u05d4\u05de\u05e9\u05e4\u05d7\u05d4, \u05d4\u05e6\u05d5\u05d5\u05ea \u05d4\u05e8\u05e4\u05d5\u05d0\u05d9 \u05d5\u05d4\u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05d0\u05e9\u05e4\u05d5\u05d6\u05d9\u05ea.",
      "hasAllOfTheAbove": false,
      "hasNoneOfTheAbove": false
    },
    {
      "type": "multiple_choice",
      "question": "\u05de\u05ea\u05d1\u05d2\u05e8 \u05d1\u05df 15 \u05e2\u05dd Type 1 Diabetes (T1D) \u05de\u05e6\u05d9\u05d2 \u05e2\u05dc\u05d9\u05d9\u05d4 \u05d7\u05d3\u05d4 \u05d1\u05e8\u05de\u05d5\u05ea HbA1c \u05dc-$13.5\\%$ \u05d5\u05d0\u05e9\u05e4\u05d5\u05d6\u05d9\u05dd \u05d7\u05d5\u05d6\u05e8\u05d9\u05dd \u05d1\u05e9\u05dc Diabetic Ketoacidosis (DKA). \u05d1\u05d1\u05d9\u05e8\u05d5\u05e8 \u05e2\u05d5\u05dc\u05d4 \u05db\u05d9 \u05d4\u05d5\u05e8\u05d9\u05d5 \u05d4\u05e2\u05d1\u05d9\u05e8\u05d5 \u05dc\u05d5 \u05d0\u05ea \u05d4\u05d0\u05d7\u05e8\u05d9\u05d5\u05ea \u05d4\u05de\u05dc\u05d0\u05d4 \u05e2\u05dc \u05d4\u05d6\u05e8\u05e7\u05d5\u05ea \u05d4-Insulin \u05dc\u05e4\u05e0\u05d9 \u05db\u05d7\u05e6\u05d9 \u05e9\u05e0\u05d4. \u05d0\u05d9\u05d6\u05d4 \u05de\u05d5\u05e9\u05d2 \u05e7\u05dc\u05d9\u05e0\u05d9 \u05de\u05ea\u05d0\u05e8 \u05d1\u05e6\u05d5\u05e8\u05d4 \u05d4\u05d8\u05d5\u05d1\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d0\u05ea \u05d4\u05d2\u05d5\u05e8\u05dd \u05dc\u05d4\u05d9\u05d3\u05e8\u05d3\u05e8\u05d5\u05ea?",
      "answerOptions": [
        {
          "text": "Premature Transfer of Responsibility",
          "isCorrect": true,
          "rationale": "\u05d4\u05e2\u05d1\u05e8\u05ea \u05d0\u05d7\u05e8\u05d9\u05d5\u05ea \u05de\u05d5\u05e7\u05d3\u05de\u05ea \u05de\u05d3\u05d9 \u05dc\u05e0\u05d9\u05d4\u05d5\u05dc \u05d4\u05de\u05d7\u05dc\u05d4 \u05de\u05d4\u05d4\u05d5\u05e8\u05d4 \u05dc\u05de\u05ea\u05d1\u05d2\u05e8 \u05d4\u05d9\u05d0 \u05d2\u05d5\u05e8\u05dd \u05e1\u05d9\u05db\u05d5\u05df \u05de\u05e8\u05db\u05d6\u05d9 \u05dc\u05d0\u05d9-\u05d4\u05d9\u05e2\u05e0\u05d5\u05ea \u05d5\u05d4\u05d9\u05d3\u05e8\u05d3\u05e8\u05d5\u05ea \u05e8\u05e4\u05d5\u05d0\u05d9\u05ea (Dulcan p.1090)."
        },
        {
          "text": "Secondary Control Coping",
          "isCorrect": false,
          "rationale": "\u05d6\u05d4\u05d5 \u05e1\u05d2\u05e0\u05d5\u05df \u05d4\u05ea\u05de\u05d5\u05d3\u05d3\u05d5\u05ea \u05d0\u05d3\u05e4\u05d8\u05d9\u05d1\u05d9 (\u05d4\u05e2\u05e8\u05db\u05d4 \u05de\u05d7\u05d3\u05e9 \u05d7\u05d9\u05d5\u05d1\u05d9\u05ea) \u05d5\u05d0\u05d9\u05e0\u05d5 \u05de\u05ea\u05d0\u05e8 \u05d0\u05ea \u05d4\u05db\u05e9\u05dc \u05d1\u05e0\u05d9\u05d4\u05d5\u05dc \u05d4\u05d0\u05d7\u05e8\u05d9\u05d5\u05ea (Dulcan p.1088)."
        },
        {
          "text": "Vulnerable Child Syndrome",
          "isCorrect": false,
          "rationale": "\u05ea\u05e1\u05de\u05d5\u05e0\u05ea \u05d6\u05d5 \u05de\u05ea\u05d0\u05e8\u05ea \u05d4\u05d2\u05e0\u05ea-\u05d9\u05ea\u05e8 \u05d4\u05d5\u05e8\u05d9\u05ea (Overprotection) \u05d5\u05dc\u05d0 \u05d4\u05e2\u05d1\u05e8\u05ea \u05d0\u05d7\u05e8\u05d9\u05d5\u05ea \u05de\u05d5\u05e7\u05d3\u05de\u05ea \u05de\u05d3\u05d9 (Dulcan p.1091)."
        },
        {
          "text": "Anticipatory Nausea",
          "isCorrect": false,
          "rationale": "\u05de\u05d5\u05e9\u05d2 \u05d6\u05d4 \u05e7\u05e9\u05d5\u05e8 \u05dc\u05d1\u05d7\u05d9\u05dc\u05d5\u05ea \u05de\u05d5\u05ea\u05e0\u05d5\u05ea \u05d1\u05d0\u05d5\u05e0\u05e7\u05d5\u05dc\u05d5\u05d2\u05d9\u05d4 \u05d5\u05d0\u05d9\u05e0\u05d5 \u05e8\u05dc\u05d5\u05d5\u05e0\u05d8\u05d9 \u05dc\u05e0\u05d9\u05d4\u05d5\u05dc \u05d4\u05d6\u05e8\u05e7\u05d5\u05ea \u05d0\u05d9\u05e0\u05e1\u05d5\u05dc\u05d9\u05df \u05d1\u05e1\u05d5\u05db\u05e8\u05ea (Dulcan p.1090)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05e4\u05e2\u05e8 \u05d1\u05d9\u05df \u05d4\u05d9\u05db\u05d5\u05dc\u05ea \u05d4\u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9\u05ea \u05e9\u05dc \u05d4\u05de\u05ea\u05d1\u05d2\u05e8 \u05dc\u05d1\u05d9\u05df \u05d4\u05d1\u05e9\u05dc\u05d5\u05ea \u05d4\u05e8\u05d2\u05e9\u05d9\u05ea \u05dc\u05e0\u05d9\u05d4\u05d5\u05dc \u05de\u05d7\u05dc\u05d4 \u05db\u05e8\u05d5\u05e0\u05d9\u05ea.",
      "imageUrls": []
    },
    {
      "type": "fill_in_the_blank",
      "question": "\u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d4\u05e1\u05d5\u05d1\u05dc\u05d9\u05dd \u05de-Somatic Symptom Disorder, \u05d1\u05e9\u05d5\u05e0\u05d4 \u05de\u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd, \u05d4\u05de\u05e6\u05d2 \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9 \u05d4\u05e9\u05db\u05d9\u05d7 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d4\u05d5\u05d0 \u05e9\u05dc ___ (Single prominent symptom) \u05d5\u05dc\u05d0 \u05e9\u05dc \u05e8\u05d9\u05d1\u05d5\u05d9 \u05ea\u05dc\u05d5\u05e0\u05d5\u05ea \u05d1\u05de\u05e2\u05e8\u05db\u05d5\u05ea \u05d2\u05d5\u05e3 \u05e9\u05d5\u05e0\u05d5\u05ea.",
      "bestAnswer": "\u05ea\u05e1\u05de\u05d9\u05df \u05d1\u05d5\u05dc\u05d8 \u05d9\u05d7\u05d9\u05d3",
      "acceptableAnswers": [
        "\u05ea\u05e1\u05de\u05d9\u05df \u05d9\u05d7\u05d9\u05d3",
        "single prominent symptom",
        "\u05ea\u05dc\u05d5\u05e0\u05d4 \u05d2\u05d5\u05e4\u05e0\u05d9\u05ea \u05d1\u05d5\u05dc\u05d8\u05ea \u05d0\u05d7\u05ea"
      ],
      "rationale": "\u05d4-DSM-5-TR \u05de\u05e6\u05d9\u05d9\u05df \u05db\u05d9 \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd SSD \u05de\u05ea\u05d1\u05d8\u05d0 \u05dc\u05e8\u05d5\u05d1 \u05d1\u05ea\u05dc\u05d5\u05e0\u05d4 \u05d0\u05d7\u05ea \u05d3\u05d5\u05de\u05d9\u05e0\u05e0\u05d8\u05d9\u05ea \u05db\u05de\u05d5 \u05db\u05d0\u05d1\u05d9 \u05d1\u05d8\u05df \u05d0\u05d5 \u05db\u05d0\u05d1\u05d9 \u05e8\u05d0\u05e9 (DSM p.350).",
      "hint": "\u05d4\u05ea\u05de\u05e7\u05d3 \u05d1\u05d4\u05d1\u05d3\u05dc \u05d4\u05de\u05d1\u05e0\u05d9 \u05d1\u05d9\u05df \u05e1\u05d5\u05de\u05d8\u05d9\u05d6\u05e6\u05d9\u05d4 \u05e4\u05d3\u05d9\u05d0\u05d8\u05e8\u05d9\u05ea \u05dc\u05d4\u05e6\u05d2\u05d4 \u05d4\u05de\u05d5\u05dc\u05d8\u05d9-\u05e1\u05d9\u05e1\u05d8\u05de\u05d9\u05ea \u05d1\u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd."
    },
    {
      "type": "multiple_choice",
      "question": "\u05e9\u05d5\u05e8\u05d3 Leukemia \u05d1\u05df 12 \u05e9\u05e2\u05d1\u05e8 \u05d4\u05e7\u05e8\u05e0\u05d5\u05ea \u05de\u05d5\u05d7\u05d9\u05d5\u05ea (Cranial Irradiation) \u05d1\u05d2\u05d9\u05dc 4 \u05de\u05d5\u05e4\u05e0\u05d4 \u05dc\u05d4\u05e2\u05e8\u05db\u05d4 \u05d1\u05e9\u05dc \u05d9\u05e8\u05d9\u05d3\u05d4 \u05d1\u05d4\u05d9\u05e9\u05d2\u05d9\u05dd \u05d4\u05dc\u05d9\u05de\u05d5\u05d3\u05d9\u05d9\u05dd. \u05d1\u05d1\u05d3\u05d9\u05e7\u05d4 \u05e0\u05d5\u05d9\u05e8\u05d5\u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9\u05ea, \u05de\u05d4\u05d5 \u05d4\u05de\u05de\u05e6\u05d0 \u05d4\u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05d9 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc-'Late Effects' \u05e9\u05dc \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05d0\u05d5\u05e0\u05e7\u05d5\u05dc\u05d5\u05d2\u05d9?",
      "answerOptions": [
        {
          "text": "\u05d4\u05d0\u05d8\u05d4 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05d1-Processing Speed \u05d5\u05e7\u05e9\u05d9\u05d9\u05dd \u05d1\u05e8\u05db\u05d9\u05e9\u05ea \u05de\u05d9\u05d5\u05de\u05e0\u05d5\u05d9\u05d5\u05ea \u05d7\u05d3\u05e9\u05d5\u05ea.",
          "isCorrect": true,
          "rationale": "\u05d4\u05e4\u05d2\u05d9\u05e2\u05d4 \u05d4\u05e2\u05d9\u05e7\u05e8\u05d9\u05ea \u05d4\u05d9\u05d0 \u05d1\u05d7\u05d5\u05de\u05e8 \u05d4\u05dc\u05d1\u05df, \u05de\u05d4 \u05e9\u05de\u05d5\u05d1\u05d9\u05dc \u05dc\u05d4\u05d0\u05d8\u05d4 \u05d1\u05e2\u05d9\u05d1\u05d5\u05d3 \u05de\u05d9\u05d3\u05e2 \u05d5\u05e7\u05d5\u05e9\u05d9 \u05dc\u05dc\u05de\u05d5\u05d3 \u05d3\u05d1\u05e8\u05d9\u05dd \u05d7\u05d3\u05e9\u05d9\u05dd \u05d1\u05e7\u05e6\u05d1 \u05d4\u05ea\u05d5\u05d0\u05dd \u05d0\u05ea \u05d4\u05d2\u05d9\u05dc (Dulcan p.96, 159)."
        },
        {
          "text": "\u05d0\u05d5\u05d1\u05d3\u05df \u05e4\u05ea\u05d0\u05d5\u05de\u05d9 \u05e9\u05dc \u05d6\u05d9\u05db\u05e8\u05d5\u05e0\u05d5\u05ea \u05dc\u05d8\u05d5\u05d5\u05d7 \u05d0\u05e8\u05d5\u05da (Retrograde Amnesia).",
          "isCorrect": false,
          "rationale": "\u05d4\u05e4\u05d2\u05d9\u05e2\u05d4 \u05d1\u05d4\u05e7\u05e8\u05e0\u05d5\u05ea \u05d0\u05d9\u05e0\u05d4 \u05de\u05ea\u05d1\u05d8\u05d0\u05ea \u05d1\u05d0\u05d5\u05d1\u05d3\u05df \u05d9\u05d3\u05e2 \u05e7\u05d9\u05d9\u05dd \u05d0\u05dc\u05d0 \u05d1\u05e7\u05e6\u05d1 \u05d4\u05e8\u05db\u05d9\u05e9\u05d4 \u05d4\u05e2\u05ea\u05d9\u05d3\u05d9 (Dulcan p.96)."
        },
        {
          "text": "\u05e2\u05dc\u05d9\u05d9\u05d4 \u05d4\u05d3\u05e8\u05d2\u05ea\u05d9\u05ea \u05d1-IQ \u05db\u05e4\u05d9\u05e6\u05d5\u05d9 \u05e2\u05dc \u05d4\u05e4\u05d2\u05d9\u05e2\u05d4 \u05d4\u05de\u05d5\u05d7\u05d9\u05ea \u05d4\u05de\u05d5\u05e7\u05d3\u05de\u05ea.",
          "isCorrect": false,
          "rationale": "\u05d4\u05de\u05d7\u05e7\u05e8 \u05de\u05e8\u05d0\u05d4 \u05d9\u05e8\u05d9\u05d3\u05d4 \u05d4\u05d3\u05e8\u05d2\u05ea\u05d9\u05ea \u05d1-IQ \u05dc\u05d0\u05d5\u05e8\u05da \u05d4\u05e9\u05e0\u05d9\u05dd \u05d1\u05d9\u05d7\u05e1 \u05dc\u05e7\u05d1\u05d5\u05e6\u05ea \u05d4\u05d2\u05d9\u05dc \u05d1\u05e9\u05dc \u05d0\u05d9-\u05d4\u05e9\u05d2\u05ea \u05d0\u05d1\u05e0\u05d9 \u05d3\u05e8\u05da \u05d7\u05d3\u05e9\u05d5\u05ea (Dulcan p.96)."
        },
        {
          "text": "\u05d4\u05e4\u05e8\u05e2\u05d4 \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05ea \u05d1\u05e7\u05e8\u05d9\u05d0\u05d4 (Dyslexia) \u05dc\u05dc\u05d0 \u05e4\u05d2\u05d9\u05e2\u05d4 \u05d1\u05ea\u05e4\u05e7\u05d5\u05d3\u05d9\u05dd \u05e0\u05d9\u05d4\u05d5\u05dc\u05d9\u05d9\u05dd.",
          "isCorrect": false,
          "rationale": "\u05d4\u05e4\u05d2\u05d9\u05e2\u05d4 \u05d4\u05d9\u05d0 \u05e8\u05d7\u05d1\u05d4 \u05d5\u05db\u05d5\u05dc\u05dc\u05ea \u05ea\u05e4\u05e7\u05d5\u05d3\u05d9\u05dd \u05e0\u05d9\u05d4\u05d5\u05dc\u05d9\u05d9\u05dd, \u05e7\u05e9\u05d1 \u05de\u05ea\u05de\u05e9\u05da \u05d5\u05d6\u05d9\u05db\u05e8\u05d5\u05df \u05e2\u05d1\u05d5\u05d3\u05d4 (Dulcan p.159)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05e4\u05d2\u05d9\u05e2\u05d4 \u05d1\u05de\u05d9\u05d0\u05dc\u05d9\u05e0\u05d9\u05d6\u05e6\u05d9\u05d4 \u05d5\u05d1\u05d7\u05d5\u05de\u05e8 \u05d4\u05dc\u05d1\u05df \u05d1\u05de\u05d5\u05d7 \u05d4\u05de\u05ea\u05e4\u05ea\u05d7.",
      "imageUrls": []
    },
    {
      "type": "short_answer",
      "question": "\u05de\u05d4\u05d5 \u05d4\u05d4\u05d1\u05d3\u05dc \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05d1\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df \u05d4\u05de\u05e9\u05da (Duration) \u05e9\u05dc Prolonged Grief Disorder \u05d1\u05d9\u05df \u05d9\u05dc\u05d3\u05d9\u05dd/\u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd \u05dc\u05d1\u05d9\u05df \u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd \u05e2\u05dc \u05e4\u05d9 \u05d4-DSM-5-TR?",
      "grading": {
        "modelAnswer": "\u05e2\u05dc \u05e4\u05d9 \u05d4-DSM-5-TR, \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d5\u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd \u05e0\u05d3\u05e8\u05e9 \u05de\u05e9\u05da \u05e9\u05dc \u05dc\u05e4\u05d7\u05d5\u05ea 6 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05de\u05d0\u05d6 \u05d4\u05d0\u05d5\u05d1\u05d3\u05df \u05db\u05d3\u05d9 \u05dc\u05d0\u05d1\u05d7\u05df PGD, \u05d1\u05e2\u05d5\u05d3 \u05e9\u05d1\u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd \u05e0\u05d3\u05e8\u05e9 \u05de\u05e9\u05da \u05e9\u05dc \u05dc\u05e4\u05d7\u05d5\u05ea 12 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd (DSM p.323).",
        "rationale": "\u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df \u05e7\u05d5\u05e6\u05e8 \u05e2\u05d1\u05d5\u05e8 \u05d9\u05dc\u05d3\u05d9\u05dd \u05d1\u05e9\u05dc \u05d4\u05d4\u05d1\u05e0\u05d4 \u05e9\u05d7\u05e6\u05d9 \u05e9\u05e0\u05d4 \u05d4\u05d9\u05d0 \u05d6\u05de\u05df \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9 \u05d1\u05d7\u05d9\u05d9 \u05d9\u05dc\u05d3 \u05d5\u05d4\u05ea\u05e2\u05e8\u05d1\u05d5\u05ea \u05de\u05d5\u05e7\u05d3\u05de\u05ea \u05d4\u05d9\u05d0 \u05e7\u05e8\u05d9\u05d8\u05d9\u05ea (DSM p.323).",
        "requiredAttributes": [
