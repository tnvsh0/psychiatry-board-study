    {
      "type": "multiple_choice",
      "question": "\u05d1\u05de\u05e1\u05d2\u05e8\u05ea \u05de\u05d5\u05d3\u05dc \u05d4-Collaborative Care (AIMS Center), \u05de\u05d4\u05d5 \u05ea\u05e4\u05e7\u05d9\u05d3\u05d5 \u05d4\u05de\u05d3\u05d5\u05d9\u05e7 \u05e9\u05dc \u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8 \u05d4\u05d9\u05dc\u05d3\u05d9\u05dd \u05d4\u05de\u05d9\u05d9\u05e2\u05e5 \u05de\u05d5\u05dc \u05d4-Care Coordinator?",
      "answerOptions": [
        {
          "text": "\u05e1\u05e7\u05d9\u05e8\u05d4 \u05e9\u05d2\u05e8\u05ea\u05d9\u05ea \u05e9\u05dc \u05d4-Registry \u05d5\u05de\u05ea\u05df \u05d4\u05de\u05dc\u05e6\u05d5\u05ea \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05e2\u05d1\u05d5\u05e8 \u05d7\u05d5\u05dc\u05d9\u05dd \u05e9\u05dc\u05d0 \u05de\u05e9\u05ea\u05e4\u05e8\u05d9\u05dd.",
          "isCorrect": true,
          "rationale": "\u05d4\u05d9\u05d5\u05e2\u05e5 \u05e1\u05d5\u05e7\u05e8 \u05d0\u05ea \u05de\u05e8\u05e9\u05dd \u05d4\u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd \u05e2\u05dd \u05d4\u05de\u05ea\u05d0\u05dd \u05d5\u05de\u05e0\u05d7\u05d4 \u05d0\u05ea \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05dc\u05dc\u05d0 \u05d1\u05d3\u05d9\u05e7\u05ea \u05db\u05dc \u05d7\u05d5\u05dc\u05d4 \u05d1\u05d0\u05d5\u05e4\u05df \u05d0\u05d9\u05e9\u05d9 (Dulcan p.1074)."
        },
        {
          "text": "\u05d1\u05d9\u05e6\u05d5\u05e2 \u05d4\u05e2\u05e8\u05db\u05d4 \u05e4\u05e8\u05d5\u05e0\u05d8\u05dc\u05d9\u05ea \u05de\u05dc\u05d0\u05d4 \u05dc\u05db\u05dc \u05d9\u05dc\u05d3 \u05d4\u05de\u05d5\u05e4\u05e0\u05d4 \u05e2\u05dc \u05d9\u05d3\u05d9 \u05e8\u05d5\u05e4\u05d0 \u05d4\u05d9\u05dc\u05d3\u05d9\u05dd.",
          "isCorrect": false,
          "rationale": "\u05d6\u05d4\u05d5 \u05de\u05d5\u05d3\u05dc \u05d4-Consultative Collaboration \u05d0\u05d5 Referral, \u05d5\u05dc\u05d0 \u05d4-Collaborative Care \u05d4\u05d0\u05d5\u05db\u05dc\u05d5\u05e1\u05d9\u05d9\u05ea\u05d9 (Dulcan p.1074)."
        },
        {
          "text": "\u05de\u05ea\u05df \u05de\u05e2\u05e0\u05d4 \u05d8\u05dc\u05e4\u05d5\u05e0\u05d9 \u05de\u05d9\u05d9\u05d3\u05d9 (On-demand) \u05dc\u05e8\u05d5\u05e4\u05d0\u05d9 \u05d9\u05dc\u05d3\u05d9\u05dd \u05d1\u05e4\u05e8\u05d9\u05e1\u05d4 \u05d0\u05e8\u05e6\u05d9\u05ea.",
          "isCorrect": false,
          "rationale": "\u05d6\u05d4\u05d5 \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05e9\u05dc \u05d4-Child Psychiatry Access Programs (\u05db\u05de\u05d5 MCPAP) (Dulcan p.1073)."
        },
        {
          "text": "\u05e0\u05d9\u05d4\u05d5\u05dc \u05d9\u05e9\u05d9\u05e8 \u05e9\u05dc \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05ea\u05e8\u05d5\u05e4\u05ea\u05d9 \u05d5\u05d4\u05de\u05e8\u05e9\u05de\u05d9\u05dd \u05d1\u05de\u05e7\u05d5\u05dd \u05e8\u05d5\u05e4\u05d0 \u05d4\u05d9\u05dc\u05d3\u05d9\u05dd.",
          "isCorrect": false,
          "rationale": "\u05d1\u05de\u05d5\u05d3\u05dc \u05d6\u05d4 \u05e8\u05d5\u05e4\u05d0 \u05d4\u05d9\u05dc\u05d3\u05d9\u05dd \u05e0\u05e9\u05d0\u05e8 \u05d4-Director \u05d5\u05de\u05e0\u05d4\u05dc \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05e4\u05d5\u05e2\u05dc (Dulcan p.1074)."
        }
      ],
      "hint": "\u05d4\u05de\u05d5\u05d3\u05dc \u05de\u05d1\u05d5\u05e1\u05e1 \u05e2\u05dc \u05e0\u05d9\u05d4\u05d5\u05dc \u05d0\u05d5\u05db\u05dc\u05d5\u05e1\u05d9\u05d9\u05d4 (Population-based care) \u05d5\u05dc\u05d0 \u05e2\u05dc \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05de\u05e7\u05e8\u05d9\u05dd \u05d1\u05d5\u05d3\u05d3\u05d9\u05dd.",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05d9\u05dc\u05d3 \u05d1\u05df 7 \u05e2\u05dd IBD \u05de\u05e6\u05d9\u05d2 \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e9\u05dc \u05d0\u05e4\u05d8\u05d9\u05d5\u05ea, \u05d7\u05d5\u05e1\u05e8 \u05ea\u05d9\u05d0\u05d1\u05d5\u05df, \u05d5\u05e6\u05de\u05e6\u05d5\u05dd \u05d7\u05d1\u05e8\u05ea\u05d9. \u05d1\u05d1\u05d3\u05d9\u05e7\u05d5\u05ea \u05d3\u05dd \u05e0\u05e6\u05e4\u05ea\u05d4 \u05e2\u05dc\u05d9\u05d9\u05d4 \u05d1\u05e6\u05d9\u05d8\u05d5\u05e7\u05d9\u05e0\u05d9\u05dd \u05d3\u05dc\u05e7\u05ea\u05d9\u05d9\u05dd ($TNF-\\alpha, IL-6$). \u05de\u05d4\u05d5 \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05e0\u05d5\u05d9\u05e8\u05d5\u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d4\u05de\u05e1\u05d1\u05d9\u05e8 \u05d0\u05ea \u05d4\u05e7\u05e9\u05e8 \u05d1\u05d9\u05df \u05d4\u05d3\u05dc\u05e7\u05ea \u05d1\u05de\u05e2\u05d9 \u05dc\u05ea\u05e1\u05de\u05d9\u05e0\u05d9 \u05d4\u05d3\u05d9\u05db\u05d0\u05d5\u05df?",
      "answerOptions": [
        {
          "text": "Sickness Behavior; \u05e6\u05d9\u05d8\u05d5\u05e7\u05d9\u05e0\u05d9\u05dd \u05d7\u05d5\u05e6\u05d9\u05dd \u05d0\u05ea \u05d4-BBB \u05d5\u05de\u05e9\u05e8\u05d9\u05dd \u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd \u05d1\u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05e2\u05e6\u05d1\u05d9\u05dd \u05d4\u05de\u05e8\u05db\u05d6\u05d9\u05ea.",
          "isCorrect": true,
          "rationale": "\u05d6\u05d4\u05d5 \u05e6\u05d9\u05e8 \u05d4\u05de\u05e2\u05d9-\u05de\u05d5\u05d7; \u05e6\u05d9\u05d8\u05d5\u05e7\u05d9\u05e0\u05d9\u05dd \u05d3\u05dc\u05e7\u05ea\u05d9\u05d9\u05dd \u05de\u05d4\u05e4\u05e8\u05d9\u05e4\u05e8\u05d9\u05d4 \u05de\u05e9\u05e4\u05d9\u05e2\u05d9\u05dd \u05d9\u05e9\u05d9\u05e8\u05d5\u05ea \u05e2\u05dc \u05d4\u05de\u05d5\u05d7 \u05d5\u05de\u05d9\u05d9\u05e6\u05e8\u05d9\u05dd \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d3\u05de\u05d5\u05d9\u05d9 \u05d3\u05d9\u05db\u05d0\u05d5\u05df (Dulcan p.1097)."
        },
        {
          "text": "Anticipatory Nausea; \u05ea\u05d2\u05d5\u05d1\u05d4 \u05de\u05d5\u05ea\u05e0\u05d9\u05ea \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05ea\u05e8\u05d5\u05e4\u05ea\u05d9 \u05d4\u05de\u05e2\u05e8\u05d1\u05ea \u05d0\u05ea \u05d4-HPA axis.",
          "isCorrect": false,
          "rationale": "\u05de\u05d5\u05e9\u05d2 \u05d6\u05d4 \u05e7\u05e9\u05d5\u05e8 \u05dc\u05d4\u05ea\u05e0\u05d9\u05d4 \u05e9\u05dc \u05d1\u05d7\u05d9\u05dc\u05d4 \u05e1\u05d1\u05d9\u05d1 \u05db\u05d9\u05de\u05d5\u05ea\u05e8\u05e4\u05d9\u05d4 \u05d5\u05dc\u05d0 \u05dc\u05d3\u05dc\u05e7\u05ea \u05e1\u05d9\u05e1\u05d8\u05de\u05d9\u05ea \u05d1-IBD (Dulcan p.1090)."
        },
        {
          "text": "Central Sensitization; \u05d9\u05e8\u05d9\u05d3\u05d4 \u05d1\u05e1\u05e3 \u05d4\u05db\u05d0\u05d1 \u05e2\u05e7\u05d1 \u05d0\u05d8\u05e8\u05d5\u05e4\u05d9\u05d4 \u05e9\u05dc \u05d4\u05d7\u05d5\u05de\u05e8 \u05d4\u05d0\u05e4\u05d5\u05e8 \u05d1-DLPFC.",
          "isCorrect": false,
          "rationale": "\u05e1\u05e0\u05e1\u05d9\u05d8\u05d9\u05d6\u05e6\u05d9\u05d4 \u05de\u05e8\u05db\u05d6\u05d9\u05ea \u05de\u05e1\u05d1\u05d9\u05e8\u05d4 \u05db\u05d0\u05d1 \u05db\u05e8\u05d5\u05e0\u05d9, \u05d0\u05da \u05d0\u05d9\u05e0\u05d4 \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05d9\u05e9\u05d9\u05e8 \u05dc-Sickness behavior \u05d4\u05de\u05d5\u05e9\u05e8\u05d4 \u05de\u05e6\u05d9\u05d8\u05d5\u05e7\u05d9\u05e0\u05d9\u05dd (StahlNeuro p.385)."
        },
        {
          "text": "Secondary Control Coping; \u05e0\u05d9\u05e1\u05d9\u05d5\u05df \u05db\u05d5\u05e9\u05dc \u05dc\u05d4\u05e1\u05ea\u05d2\u05dc \u05dc\u05de\u05d7\u05dc\u05d4 \u05db\u05e8\u05d5\u05e0\u05d9\u05ea \u05d3\u05e8\u05da \u05d4\u05d9\u05de\u05e0\u05e2\u05d5\u05ea.",
          "isCorrect": false,
          "rationale": "\u05d6\u05d4\u05d5 \u05de\u05d5\u05e9\u05d2 \u05e4\u05e1\u05d9\u05db\u05d5\u05dc\u05d5\u05d2\u05d9 \u05e9\u05dc \u05e1\u05d2\u05e0\u05d5\u05df \u05d4\u05ea\u05de\u05d5\u05d3\u05d3\u05d5\u05ea, \u05dc\u05d0 \u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05e0\u05d5\u05d9\u05e8\u05d5\u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05e9\u05dc \u05e6\u05d9\u05d8\u05d5\u05e7\u05d9\u05e0\u05d9\u05dd (Dulcan p.1088)."
