    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05e4\u05d5\u05e2\u05dc \u05d4\u05de\u05d8\u05e4\u05dc \u05db-Mirror (\u05de\u05e8\u05d0\u05d4) \u05d1\u05d8\u05d9\u05e4\u05d5\u05dc \u05e4\u05e1\u05d9\u05db\u05d5\u05d0\u05e0\u05dc\u05d9\u05d8\u05d9?",
      "back": "\u05d4\u05de\u05d8\u05e4\u05dc \u05e9\u05d5\u05de\u05e8 \u05e2\u05dc \u05e0\u05d9\u05d8\u05e8\u05dc\u05d9\u05d5\u05ea \u05d5\u05de\u05e9\u05e7\u05e3 \u05dc\u05de\u05d8\u05d5\u05e4\u05dc \u05e8\u05e7 \u05d0\u05ea \u05de\u05d4 \u05e9\u05d4\u05d5\u05d0 \u05de\u05d1\u05d9\u05d0, \u05de\u05d1\u05dc\u05d9 \u05dc\u05d4\u05db\u05e0\u05d9\u05e1 \u05d0\u05ea \u05d0\u05d9\u05e9\u05d9\u05d5\u05ea\u05d5 \u05d0\u05d5 \u05e2\u05e8\u05db\u05d9\u05d5 (Synopsis ch.23 Psychotherapy)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4-Primary Maternal Preoccupation \u05dc\u05e4\u05d9 \u05d5\u05d9\u05e0\u05d9\u05e7\u05d5\u05d8?",
      "back": "\u05de\u05e6\u05d1 \u05e0\u05e4\u05e9\u05d9 \u05de\u05d9\u05d5\u05d7\u05d3 \u05e9\u05dc \u05d4\u05d0\u05dd \u05d1\u05e1\u05d5\u05e3 \u05d4\u05d4\u05e8\u05d9\u05d5\u05df \u05d4\u05de\u05d0\u05e4\u05e9\u05e8 \u05dc\u05d4 \u05dc\u05d4\u05d9\u05d5\u05ea \u05e7\u05e9\u05d5\u05d1\u05d4 \u05d5\u05e8\u05d2\u05d9\u05e9\u05d4 \u05d1\u05d0\u05d5\u05e4\u05df \u05d8\u05d5\u05d8\u05d0\u05dc\u05d9 \u05dc\u05e6\u05e8\u05db\u05d9 \u05d4\u05ea\u05d9\u05e0\u05d5\u05e7 (Syllabus p.52)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4-Squiggle Game \u05d5\u05de\u05d9 \u05d4\u05de\u05e6\u05d9\u05d0 \u05d0\u05d5\u05ea\u05d5?",
      "back": "\u05de\u05e9\u05d7\u05e7 \u05e9\u05e8\u05d1\u05d5\u05d8\u05d9\u05dd \u05e9\u05e4\u05d9\u05ea\u05d7 \u05d5\u05d9\u05e0\u05d9\u05e7\u05d5\u05d8 \u05db\u05db\u05dc\u05d9 \u05dc\u05d9\u05e6\u05d9\u05e8\u05ea \u05e7\u05e9\u05e8 \u05d5\u05ea\u05e7\u05e9\u05d5\u05e8\u05ea \u05e2\u05dd \u05d4\u05d9\u05dc\u05d3 \u05d1\u05ea\u05d5\u05da \u05d4\u05de\u05e8\u05d7\u05d1 \u05d4\u05e4\u05d5\u05d8\u05e0\u05e6\u05d9\u05d0\u05dc\u05d9 (Dulcan p.867)."
