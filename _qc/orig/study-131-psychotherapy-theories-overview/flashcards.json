{
  "title": "Psychotherapy Flashcards",
  "cards": [
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05de\u05e7\u05e8\u05d4 \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9 \u05d4\u05e8\u05d0\u05e9\u05d5\u05df \u05d1\u05d9\u05dc\u05d3 \u05d4\u05de\u05ea\u05d5\u05d0\u05e8 \u05d1\u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4 \u05e9\u05dc \u05d4\u05e4\u05e1\u05d9\u05db\u05d5\u05d0\u05e0\u05dc\u05d9\u05d6\u05d4 \u05d1\u05e9\u05e0\u05ea 1909?",
      "back": "\u05d4\u05de\u05e7\u05e8\u05d4 \u05e9\u05dc \"\u05d4\u05e0\u05e1 \u05d4\u05e7\u05d8\u05df\" (Little Hans) \u05e9\u05e1\u05d1\u05dc \u05de\u05e4\u05d5\u05d1\u05d9\u05d9\u05ea \u05e1\u05d5\u05e1\u05d9\u05dd \u05d5\u05d8\u05d5\u05e4\u05dc \u05d1\u05e2\u05e7\u05d9\u05e4\u05d9\u05df \u05d3\u05e8\u05da \u05d0\u05d1\u05d9\u05d5 (Dulcan p.849)."
    },
    {
      "front": "\u05d4\u05d2\u05d3\u05e8 \u05d0\u05ea \u05e8\u05db\u05d9\u05d1 \u05d4-Id \u05d1\u05de\u05d5\u05d3\u05dc \u05d4\u05de\u05d1\u05e0\u05d9 \u05e9\u05dc \u05d4\u05e0\u05e4\u05e9.",
      "back": "\u05d4\u05de\u05e8\u05d7\u05d1 \u05d4\u05e4\u05e1\u05d9\u05db\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d4\u05de\u05d0\u05d5\u05db\u05dc\u05e1 \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d3\u05d7\u05e4\u05d9\u05dd \u05de\u05d9\u05e0\u05d9\u05d9\u05dd \u05d5\u05ea\u05d5\u05e7\u05e4\u05e0\u05d9\u05d9\u05dd \u05d2\u05d5\u05dc\u05de\u05d9\u05d9\u05dd \u05d5\u05e8\u05d0\u05e9\u05d5\u05e0\u05d9\u05d9\u05dd, \u05e9\u05e8\u05d5\u05d1\u05dd \u05d0\u05d9\u05e0\u05dd \u05de\u05d5\u05d3\u05e2\u05d9\u05dd (Dulcan p.848)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05ea\u05e4\u05e7\u05d9\u05d3 \u05d4-Ego \u05d1\u05de\u05d5\u05d3\u05dc \u05d4\u05de\u05d1\u05e0\u05d9 \u05e9\u05dc \u05e4\u05e8\u05d5\u05d9\u05d3?",
      "back": "\u05d4\u05de\u05e8\u05d7\u05d1 \u05d4\u05e4\u05e1\u05d9\u05db\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d4\u05d0\u05d7\u05e8\u05d0\u05d9 \u05e2\u05dc \u05d4\u05ea\u05de\u05d5\u05d3\u05d3\u05d5\u05ea, \u05d4\u05d2\u05e0\u05d4, \u05d7\u05e9\u05d9\u05d1\u05d4 \u05e8\u05e6\u05d9\u05d5\u05e0\u05dc\u05d9\u05ea \u05d5\u05ea\u05d9\u05d5\u05d5\u05da \u05d1\u05d9\u05df \u05d4\u05d3\u05d7\u05e4\u05d9\u05dd \u05dc\u05d1\u05d9\u05df \u05d4\u05de\u05e6\u05d9\u05d0\u05d5\u05ea (Dulcan p.848)."
    },
    {
      "front": "\u05d4\u05d2\u05d3\u05e8 \u05d0\u05ea \u05d4\u05de\u05d5\u05e9\u05d2 Superego \u05dc\u05e4\u05d9 \u05d4\u05de\u05d5\u05d3\u05dc \u05d4\u05de\u05d1\u05e0\u05d9.",
      "back": "\u05d4\u05de\u05e8\u05db\u05d9\u05d1 \u05d1\u05e0\u05e4\u05e9 \u05d4\u05de\u05d9\u05d9\u05e6\u05d2 \u05d0\u05ea \u05d4\u05de\u05e6\u05e4\u05d5\u05df, \u05d4\u05d0\u05ea\u05d9\u05e7\u05d4, \u05d4\u05de\u05d5\u05e1\u05e8 \u05d5\u05d0\u05d9\u05d3\u05d9\u05d0\u05dc \u05d4\u05e2\u05e6\u05de\u05d9 (Dulcan p.848)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05e4\u05e1\u05d9\u05db\u05d5\u05dc\u05d5\u05d2\u05d9 \u05e9\u05dc Interpretation (\u05e4\u05d9\u05e8\u05d5\u05e9) \u05d1\u05d8\u05d9\u05e4\u05d5\u05dc?",
      "back": "\u05d4\u05d1\u05d0\u05ea \u05e8\u05e2\u05d9\u05d5\u05e0\u05d5\u05ea \u05dc\u05d2\u05d1\u05d9 \u05d4\u05d4\u05d2\u05e0\u05d5\u05ea \u05d5\u05d4\u05de\u05e9\u05d0\u05dc\u05d5\u05ea \u05e9\u05dc \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05dc\u05de\u05d5\u05d3\u05e2\u05d5\u05ea, \u05d5\u05d1\u05db\u05da \u05d4\u05e4\u05d9\u05db\u05ea \u05de\u05e0\u05d2\u05e0\u05d5\u05e0\u05d9\u05dd \u05dc\u05d0 \u05de\u05d5\u05d3\u05e2\u05d9\u05dd \u05dc\u05e0\u05e8\u05d0\u05d9\u05dd \u05d5\u05e2\u05d1\u05d9\u05d3\u05d9\u05dd (Dulcan p.848)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05ea\u05e8\u05d5\u05de\u05d4 \u05d4\u05de\u05e8\u05db\u05d6\u05d9\u05ea \u05e9\u05dc Anna Freud \u05dc\u05e9\u05d9\u05e0\u05d5\u05d9 \u05d4\u05d3\u05d2\u05e9 \u05d1\u05d8\u05d9\u05e4\u05d5\u05dc \u05e4\u05e1\u05d9\u05db\u05d5\u05ea\u05e8\u05e4\u05d9 \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd?",
      "back": "\u05d4\u05e1\u05d8\u05ea \u05d4\u05d3\u05d2\u05e9 \u05de\u05d7\u05e7\u05d9\u05e8\u05ea \u05d4-Id \u05dc\u05d7\u05e7\u05d9\u05e8\u05ea \u05d4-Ego \u05d5\u05de\u05e0\u05d2\u05e0\u05d5\u05e0\u05d9 \u05d4\u05d4\u05d2\u05e0\u05d4 \u05d4\u05de\u05ea\u05e4\u05ea\u05d7\u05d9\u05dd \u05d1\u05d9\u05dc\u05d3\u05d5\u05ea (Dulcan p.850)."
    },
    {
      "front": "\u05de\u05d3\u05d5\u05e2 \u05dc\u05e4\u05d9 \u05d0\u05e0\u05d4 \u05e4\u05e8\u05d5\u05d9\u05d3 \u05d9\u05dc\u05d3\u05d9\u05dd \u05d0\u05d9\u05e0\u05dd \u05de\u05d9\u05d9\u05e6\u05e8\u05d9\u05dd Transference neurosis \u05de\u05dc\u05d0\u05d4 \u05db\u05dc\u05e4\u05d9 \u05d4\u05de\u05d8\u05e4\u05dc?",
      "back": "\u05de\u05db\u05d9\u05d5\u05d5\u05df \u05e9\u05d4\u05dd \u05e2\u05d3\u05d9\u05d9\u05df \u05de\u05e2\u05d5\u05e8\u05d1\u05d9\u05dd \u05e2\u05de\u05d5\u05e7\u05d5\u05ea \u05d1\u05de\u05e9\u05e4\u05d7\u05d5\u05ea\u05d9\u05d4\u05dd \u05d5\u05d4\u05d5\u05e8\u05d9\u05d4\u05dd \u05d4\u05d0\u05de\u05d9\u05ea\u05d9\u05d9\u05dd \u05e2\u05d3\u05d9\u05d9\u05df \u05de\u05e9\u05de\u05e9\u05d9\u05dd \u05db\u05d0\u05d5\u05d1\u05d9\u05d9\u05e7\u05d8\u05d9\u05dd \u05e8\u05d0\u05e9\u05d5\u05e0\u05d9\u05d9\u05dd \u05d1\u05de\u05e6\u05d9\u05d0\u05d5\u05ea (Dulcan p.850)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05d4\u05d2\u05d3\u05e8\u05d4 \u05e9\u05dc Transference (\u05d4\u05e2\u05d1\u05e8\u05d4) \u05dc\u05e4\u05d9 \u05d4\u05d2\u05d9\u05e9\u05d4 \u05d4\u05e4\u05e1\u05d9\u05db\u05d5\u05d3\u05d9\u05e0\u05de\u05d9\u05ea?",
      "back": "\u05d4\u05ea\u05e7\u05d4 (Displacement) \u05e9\u05dc \u05e2\u05de\u05d3\u05d5\u05ea \u05d5\u05e8\u05d2\u05e9\u05d5\u05ea \u05d9\u05e9\u05e0\u05d9\u05dd \u05db\u05dc\u05e4\u05d9 \u05d3\u05de\u05d5\u05d9\u05d5\u05ea \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05d5\u05ea \u05de\u05d4\u05e2\u05d1\u05e8 \u05d0\u05dc \u05d4\u05de\u05d8\u05e4\u05dc \u05d1\u05d4\u05d5\u05d5\u05d4 (Dulcan p.848)."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05de\u05d2\u05d3\u05d9\u05e8 \u05d4-DSM-5-TR \u05d0\u05ea \u05d4\u05de\u05d5\u05e9\u05d2 Mental disorder?",
      "back": "\u05ea\u05e1\u05de\u05d5\u05e0\u05ea \u05d4\u05de\u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05ea \u05d1\u05d4\u05e4\u05e8\u05e2\u05d4 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05d1\u05e7\u05d5\u05d2\u05e0\u05d9\u05e6\u05d9\u05d4, \u05d5\u05d9\u05e1\u05d5\u05ea \u05e8\u05d2\u05e9\u05d9 \u05d0\u05d5 \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d4\u05de\u05e9\u05e7\u05e4\u05ea \u05d3\u05d9\u05e1\u05e4\u05d5\u05e0\u05e7\u05e6\u05d9\u05d4 \u05d1\u05ea\u05d4\u05dc\u05d9\u05db\u05d9\u05dd \u05e4\u05e0\u05d9\u05de\u05d9\u05d9\u05dd (DSM p.14)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4-Schizoid-Paranoid Position \u05dc\u05e4\u05d9 Melanie Klein?",
      "back": "\u05e2\u05de\u05d3\u05d4 \u05e0\u05e4\u05e9\u05d9\u05ea \u05de\u05d5\u05e7\u05d3\u05de\u05ea \u05d4\u05de\u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05ea \u05d1\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05e4\u05d9\u05e6\u05d5\u05dc (Splitting) \u05d5\u05d4\u05d6\u05d3\u05d4\u05d5\u05ea \u05d4\u05e9\u05dc\u05db\u05ea\u05d9\u05ea \u05dc\u05d4\u05d2\u05e0\u05d4 \u05de\u05e4\u05e0\u05d9 \u05ea\u05d5\u05e7\u05e4\u05e0\u05d5\u05ea \u05d5\u05d7\u05e8\u05d3\u05d4 (Syllabus p.51)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4-Depressive Position \u05dc\u05e4\u05d9 \u05de\u05dc\u05d0\u05e0\u05d9 \u05e7\u05dc\u05d9\u05d9\u05df?",
      "back": "\u05e2\u05de\u05d3\u05d4 \u05d4\u05de\u05ea\u05e4\u05ea\u05d7\u05ea \u05db\u05d0\u05e9\u05e8 \u05d4\u05ea\u05d9\u05e0\u05d5\u05e7 \u05ea\u05d5\u05e4\u05e1 \u05d0\u05ea \u05d4\u05d0\u05dd \u05db\u05d0\u05d5\u05d1\u05d9\u05d9\u05e7\u05d8 \u05e9\u05dc\u05dd, \u05d3\u05d1\u05e8 \u05d4\u05de\u05e2\u05d5\u05e8\u05e8 \u05d7\u05e8\u05d3\u05d4 \u05d0\u05e9\u05de\u05ea\u05d9\u05ea \u05d5\u05d3\u05d7\u05e3 \u05dc\u05ea\u05d9\u05e7\u05d5\u05df (Reparation) (Syllabus p.52)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4-Holding environment \u05dc\u05e4\u05d9 Winnicott?",
      "back": "\u05d0\u05e1\u05e4\u05e7\u05ea \u05e1\u05d1\u05d9\u05d1\u05d4 \u05d7\u05d1\u05e8\u05ea\u05d9\u05ea \u05d1\u05d8\u05d5\u05d7\u05d4 \u05d5\u05de\u05e1\u05e4\u05e7\u05ea-\u05e6\u05e8\u05db\u05d9\u05dd \u05d4\u05de\u05d0\u05e4\u05e9\u05e8\u05ea \u05dc\u05ea\u05d9\u05e0\u05d5\u05e7 \u05d5\u05dc\u05d9\u05dc\u05d3 \u05dc\u05d4\u05ea\u05e4\u05ea\u05d7 \u05d5\u05dc\u05e6\u05de\u05d5\u05d7 \u05e4\u05e1\u05d9\u05db\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea (Dulcan p.937)."
    },
    {
      "front": "\u05d4\u05d2\u05d3\u05e8 \u05d0\u05ea \u05d4\u05de\u05d5\u05e9\u05d2 Good-enough mother \u05dc\u05e4\u05d9 \u05d5\u05d9\u05e0\u05d9\u05e7\u05d5\u05d8.",
      "back": "\u05d0\u05dd \u05d4\u05de\u05e1\u05e4\u05e7\u05ea \u05d4\u05ea\u05d0\u05de\u05d4 \u05e4\u05e2\u05d9\u05dc\u05d4 \u05dc\u05e6\u05e8\u05db\u05d9 \u05d4\u05ea\u05d9\u05e0\u05d5\u05e7, \u05e9\u05e4\u05d5\u05d7\u05ea\u05ea \u05d1\u05d4\u05d3\u05e8\u05d2\u05d4 \u05db\u05db\u05dc \u05e9\u05d4\u05d9\u05dc\u05d3 \u05de\u05e4\u05ea\u05d7 \u05d9\u05db\u05d5\u05dc\u05ea \u05dc\u05d4\u05ea\u05de\u05d5\u05d3\u05d3 \u05e2\u05dd \u05ea\u05e1\u05db\u05d5\u05dc (Dulcan p.937)."
    },
    {
      "front": "\u05de\u05d4\u05d5 Transitional Object (\u05d0\u05d5\u05d1\u05d9\u05d9\u05e7\u05d8 \u05de\u05e2\u05d1\u05e8) \u05dc\u05e4\u05d9 \u05d5\u05d9\u05e0\u05d9\u05e7\u05d5\u05d8?",
      "back": "\u05d7\u05e4\u05e5 \u05d4\u05de\u05d9\u05d9\u05e6\u05d2 \u05d0\u05ea \u05d0\u05d6\u05d5\u05e8 \u05d4\u05d1\u05d9\u05e0\u05d9\u05d9\u05dd \u05d1\u05d9\u05df \u05d4\u05e4\u05e0\u05d9\u05dd \u05dc\u05d7\u05d5\u05e5 \u05d5\u05de\u05e1\u05d9\u05d9\u05e2 \u05dc\u05d9\u05dc\u05d3 \u05dc\u05e8\u05db\u05d5\u05e9 \u05e0\u05e4\u05e8\u05d3\u05d5\u05ea \u05de\u05d4\u05d0\u05dd (Syllabus p.52)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4-Potential Space \u05dc\u05e4\u05d9 \u05d5\u05d9\u05e0\u05d9\u05e7\u05d5\u05d8 \u05d5\u05de\u05d4 \u05d7\u05e9\u05d9\u05d1\u05d5\u05ea\u05d5 \u05d1\u05d8\u05d9\u05e4\u05d5\u05dc?",
      "back": "\u05de\u05e8\u05d7\u05d1 \u05d4\u05d1\u05d9\u05e0\u05d9\u05d9\u05dd \u05e9\u05d1\u05d5 \u05de\u05ea\u05e7\u05d9\u05d9\u05de\u05d9\u05dd \u05d4\u05de\u05e9\u05d7\u05e7 \u05d5\u05d4\u05d9\u05e6\u05d9\u05e8\u05ea\u05d9\u05d5\u05ea, \u05d5\u05d1\u05d5 \u05de\u05ea\u05e8\u05d7\u05e9 \u05d4\u05de\u05e4\u05d2\u05e9 \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc\u05d9 (Syllabus p.52)."
    },
    {
      "front": "\u05de\u05d4 \u05d4\u05d4\u05d1\u05d3\u05dc \u05d1\u05d9\u05df True Self \u05dc-False Self \u05dc\u05e4\u05d9 \u05d5\u05d9\u05e0\u05d9\u05e7\u05d5\u05d8?",
      "back": "\u05e2\u05e6\u05de\u05d9 \u05d0\u05de\u05d9\u05ea\u05d9 \u05e6\u05d5\u05de\u05d7 \u05de\u05d4\u05d9\u05e2\u05e0\u05d5\u05ea \u05dc\u05e6\u05e8\u05db\u05d9\u05dd \u05d0\u05d5\u05ea\u05e0\u05d8\u05d9\u05d9\u05dd, \u05d1\u05e2\u05d5\u05d3 \u05e2\u05e6\u05de\u05d9 \u05db\u05d5\u05d6\u05d1 \u05de\u05ea\u05e4\u05ea\u05d7 \u05db\u05d4\u05d2\u05e0\u05d4 \u05d4\u05de\u05d9\u05d5\u05e2\u05d3\u05ea \u05dc\u05e8\u05e6\u05d5\u05ea \u05d0\u05ea \u05e6\u05d9\u05e4\u05d9\u05d5\u05ea \u05d4\u05e1\u05d1\u05d9\u05d1\u05d4 (Syllabus p.52)."
    },
    {
      "front": "\u05ea\u05d0\u05e8 \u05d0\u05ea \u05ea\u05ea-\u05e9\u05dc\u05d1 \u05d4-Practicing (\u05d0\u05d9\u05de\u05d5\u05df) \u05d1\u05ea\u05d4\u05dc\u05d9\u05da \u05d4\u05e1\u05e4\u05e8\u05e6\u05d9\u05d4-\u05d0\u05d9\u05e0\u05d3\u05d9\u05d1\u05d9\u05d3\u05d5\u05d0\u05e6\u05d9\u05d4 \u05e9\u05dc Mahler.",
      "back": "\u05e9\u05dc\u05d1 \u05d1\u05d5 \u05d4\u05d9\u05dc\u05d3 \u05d7\u05d5\u05e7\u05e8 \u05d0\u05ea \u05d4\u05e2\u05d5\u05dc\u05dd \u05d1\u05d0\u05d5\u05e4\u05df \u05e4\u05e2\u05d9\u05dc (\u05d6\u05d7\u05d9\u05dc\u05d4/\u05d4\u05dc\u05d9\u05db\u05d4) \u05d5\u05d7\u05d5\u05d6\u05e8 \u05dc\u05d0\u05dd \u05dc\"\u05ea\u05d3\u05dc\u05d5\u05e7 \u05e8\u05d2\u05e9\u05d9\" (Syllabus p.52)."
    },
    {
      "front": "\u05de\u05d4 \u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05d0\u05ea \u05de\u05e9\u05d1\u05e8 \u05d4-Rapprochement crisis (\u05d4\u05ea\u05e7\u05e8\u05d1\u05d5\u05ea \u05de\u05d7\u05d3\u05e9) \u05dc\u05e4\u05d9 \u05de\u05d0\u05d4\u05dc\u05e8?",
      "back": "\u05d0\u05de\u05d1\u05d9\u05d5\u05d5\u05dc\u05e0\u05d8\u05d9\u05d5\u05ea \u05e2\u05d6\u05d4 \u05d1\u05d9\u05df \u05d4\u05e8\u05e6\u05d5\u05df \u05d1\u05e7\u05e8\u05d1\u05d4 \u05dc\u05d0\u05dd \u05dc\u05d1\u05d9\u05df \u05d4\u05e6\u05d5\u05e8\u05da \u05d1\u05e2\u05e6\u05de\u05d0\u05d5\u05ea \u05d5\u05d0\u05d5\u05d8\u05d5\u05e0\u05d5\u05de\u05d9\u05d4 (Syllabus p.52)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05e7\u05d1\u05d9\u05e2\u05d5\u05ea \u05d0\u05d5\u05d1\u05d9\u05d9\u05e7\u05d8 \u05e8\u05d2\u05e9\u05d9\u05ea (Emotional Object Constancy) \u05dc\u05e4\u05d9 \u05de\u05d0\u05d4\u05dc\u05e8?",
      "back": "\u05d4\u05e4\u05e0\u05de\u05ea \u05d9\u05d9\u05e6\u05d5\u05d2 \u05e4\u05e0\u05d9\u05de\u05d9 \u05d9\u05e6\u05d9\u05d1 \u05d5\u05d0\u05d5\u05d4\u05d1 \u05e9\u05dc \u05d4\u05d0\u05dd \u05d4\u05de\u05d0\u05e4\u05e9\u05e8 \u05dc\u05d9\u05dc\u05d3 \u05dc\u05ea\u05e4\u05e7\u05d3 \u05d1\u05e0\u05e4\u05e8\u05d3 \u05de\u05de\u05e0\u05d4 (Syllabus p.52)."
    },
    {
      "front": "\u05d4\u05d2\u05d3\u05e8 \u05d0\u05ea \u05d4\u05de\u05d5\u05e9\u05d2 Selfobject (\u05d6\u05d5\u05dc\u05ea\u05e2\u05e6\u05de\u05d9) \u05dc\u05e4\u05d9 Kohut.",
      "back": "\u05d6\u05d5\u05dc\u05ea \u05d4\u05de\u05e9\u05de\u05e9 \u05e4\u05d5\u05e0\u05e7\u05e6\u05d9\u05d4 \u05e2\u05d1\u05d5\u05e8 \u05d4\u05e2\u05e6\u05de\u05d9 \u05dc\u05d4\u05d6\u05e0\u05d4 \u05e0\u05e8\u05e6\u05d9\u05e1\u05d9\u05e1\u05d8\u05d9\u05ea, \u05d5\u05d9\u05e1\u05d5\u05ea \u05e2\u05e8\u05da \u05e2\u05e6\u05de\u05d9 \u05d5\u05d0\u05e8\u05d2\u05d5\u05df \u05e0\u05e4\u05e9\u05d9 (Syllabus p.51)."
    },
    {
      "front": "\u05de\u05d4\u05d9 Mirroring Transference \u05dc\u05e4\u05d9 \u05e7\u05d5\u05d4\u05d5\u05d8?",
      "back": "\u05e6\u05d5\u05e8\u05da \u05d1\u05d4\u05e2\u05d1\u05e8\u05d4 \u05e9\u05d1\u05d5 \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05d6\u05e7\u05d5\u05e7 \u05dc\u05d0\u05d9\u05e9\u05d5\u05e8, \u05d4\u05e2\u05e8\u05e6\u05d4 \u05d5\u05ea\u05d9\u05e7\u05d5\u05e3 \u05e9\u05dc \u05d4\u05d2\u05e8\u05e0\u05d3\u05d9\u05d5\u05d6\u05d9\u05d5\u05ea \u05d4\u05d9\u05dc\u05d3\u05d9\u05ea \u05e9\u05dc\u05d5 (Syllabus p.51)."
    },
    {
      "front": "\u05de\u05d4\u05d9 Idealizing Transference \u05dc\u05e4\u05d9 \u05e7\u05d5\u05d4\u05d5\u05d8?",
      "back": "\u05e6\u05d5\u05e8\u05da \u05e9\u05dc \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05dc\u05d4\u05ea\u05de\u05d6\u05d2 \u05e2\u05dd \u05d3\u05de\u05d5\u05ea (\u05d4\u05de\u05d8\u05e4\u05dc) \u05d4\u05e0\u05ea\u05e4\u05e1\u05ea \u05db\u05d7\u05d6\u05e7\u05d4, \u05e9\u05dc\u05d5\u05d5\u05d4 \u05d5\u05de\u05d2\u05d9\u05e0\u05d4 (Syllabus p.51)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05de\u05d5\u05e9\u05d2 Twinship Transference \u05d1\u05ea\u05d9\u05d0\u05d5\u05e8\u05d9\u05d9\u05ea \u05d4\u05e2\u05e6\u05de\u05d9?",
      "back": "\u05e6\u05d5\u05e8\u05da \u05dc\u05d4\u05e8\u05d2\u05d9\u05e9 \u05d3\u05de\u05d9\u05d5\u05df \u05d5\u05d7\u05d1\u05e8\u05d5\u05ea \u05d1\u05e1\u05d9\u05e1\u05d9\u05ea \u05e2\u05dd \u05d4\u05d6\u05d5\u05dc\u05ea (Syllabus p.52)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \"\u05d4\u05e4\u05e0\u05de\u05d4 \u05de\u05de\u05d9\u05e8\u05d4\" (Transmuting internalization) \u05dc\u05e4\u05d9 \u05e7\u05d5\u05d4\u05d5\u05d8?",
      "back": "\u05ea\u05d4\u05dc\u05d9\u05da \u05e9\u05d1\u05d5 \u05db\u05e9\u05dc\u05d9\u05dd \u05d0\u05de\u05e4\u05ea\u05d9\u05d9\u05dd \u05e7\u05dc\u05d9\u05dd \u05d5\u05d0\u05d5\u05e4\u05d8\u05d9\u05de\u05dc\u05d9\u05d9\u05dd \u05de\u05e6\u05d3 \u05d4\u05de\u05d8\u05e4\u05dc \u05de\u05d5\u05d1\u05d9\u05dc\u05d9\u05dd \u05dc\u05d1\u05e0\u05d9\u05d9\u05ea \u05de\u05d1\u05e0\u05d4 \u05e0\u05e4\u05e9\u05d9 \u05e2\u05e6\u05de\u05d0\u05d9 \u05d0\u05e6\u05dc \u05d4\u05de\u05d8\u05d5\u05e4\u05dc (Syllabus p.52)."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05de\u05d2\u05d3\u05d9\u05e8 John Bowlby \u05d0\u05ea \u05de\u05d5\u05e9\u05d2 \u05d4-Attachment?",
      "back": "\u05de\u05e2\u05e8\u05db\u05ea \u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea \u05de\u05d5\u05dc\u05d3\u05ea \u05d4\u05de\u05d9\u05d5\u05e2\u05d3\u05ea \u05dc\u05d4\u05d1\u05d8\u05d9\u05d7 \u05d4\u05d9\u05e9\u05e8\u05d3\u05d5\u05ea \u05e2\u05dc \u05d9\u05d3\u05d9 \u05e9\u05de\u05d9\u05e8\u05d4 \u05e2\u05dc \u05e7\u05e8\u05d1\u05d4 \u05dc\u05d3\u05de\u05d5\u05ea \u05de\u05d8\u05e4\u05dc\u05ea (Dulcan p.937)."
    },
    {
      "front": "\u05de\u05d4\u05d5 Internal Working Model (\u05d3\u05d2\u05dd \u05e2\u05d1\u05d5\u05d3\u05d4 \u05e4\u05e0\u05d9\u05de\u05d9) \u05dc\u05e4\u05d9 \u05d1\u05d5\u05dc\u05d1\u05d9?",
      "back": "\u05d9\u05d9\u05e6\u05d5\u05d2\u05d9\u05dd \u05e4\u05e0\u05d9\u05de\u05d9\u05d9\u05dd \u05d4\u05de\u05d1\u05d5\u05e1\u05e1\u05d9\u05dd \u05e2\u05dc \u05d7\u05d5\u05d5\u05d9\u05d5\u05ea \u05de\u05d5\u05e7\u05d3\u05de\u05d5\u05ea \u05e2\u05dd \u05d4\u05de\u05d8\u05e4\u05dc \u05d5\u05de\u05e2\u05e6\u05d1\u05d9\u05dd \u05d0\u05ea \u05d4\u05e6\u05d9\u05e4\u05d9\u05d5\u05ea \u05de\u05d9\u05d7\u05e1\u05d9\u05dd \u05e2\u05ea\u05d9\u05d3\u05d9\u05d9\u05dd (Dulcan p.525)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05d4\u05e2\u05d9\u05e7\u05e8\u05d9 \u05e9\u05dc Secure Attachment (\u05d4\u05ea\u05e7\u05e9\u05e8\u05d5\u05ea \u05d1\u05d8\u05d5\u05d7\u05d4)?",
      "back": "\u05d4\u05d9\u05db\u05d5\u05dc\u05ea \u05dc\u05d4\u05e9\u05ea\u05de\u05e9 \u05d1\u05d3\u05de\u05d5\u05ea \u05d4\u05de\u05d8\u05e4\u05dc\u05ea \u05db\u05d1\u05e1\u05d9\u05e1 \u05d1\u05d8\u05d5\u05d7 (Secure base) \u05dc\u05d7\u05e7\u05d9\u05e8\u05ea \u05d4\u05e2\u05d5\u05dc\u05dd \u05d5\u05dc\u05d5\u05d5\u05d9\u05e1\u05d5\u05ea \u05de\u05e6\u05d5\u05e7\u05d4 (Dulcan p.50)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05e9\u05dc Disorganized Attachment?",
      "back": "\u05d7\u05d5\u05e1\u05e8 \u05d1\u05d0\u05e1\u05d8\u05e8\u05d8\u05d2\u05d9\u05d4 \u05e2\u05e7\u05d1\u05d9\u05ea \u05dc\u05d4\u05ea\u05de\u05d5\u05d3\u05d3\u05d5\u05ea \u05e2\u05dd \u05e4\u05e8\u05d9\u05d3\u05d4 \u05d5\u05d0\u05d9\u05d7\u05d5\u05d3, \u05dc\u05e2\u05d9\u05ea\u05d9\u05dd \u05e7\u05e8\u05d5\u05d1\u05d5\u05ea \u05db\u05ea\u05d5\u05e6\u05d0\u05d4 \u05de\u05d4\u05ea\u05e2\u05dc\u05dc\u05d5\u05ea \u05d0\u05d5 \u05d8\u05e8\u05d0\u05d5\u05de\u05d4 (Dulcan p.50)."
    },
    {
      "front": "\u05d4\u05d2\u05d3\u05e8 \u05d0\u05ea \u05d4\u05de\u05d5\u05e9\u05d2 Mentalizing \u05dc\u05e4\u05d9 Peter Fonagy.",
      "back": "\u05d4\u05d9\u05db\u05d5\u05dc\u05ea \u05dc\u05d4\u05d1\u05d9\u05df \u05d0\u05ea \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d4\u05e2\u05e6\u05de\u05d9 \u05d5\u05d4\u05d6\u05d5\u05dc\u05ea \u05d1\u05de\u05d5\u05e0\u05d7\u05d9\u05dd \u05e9\u05dc \u05de\u05e6\u05d1\u05d9\u05dd \u05e0\u05e4\u05e9\u05d9\u05d9\u05dd \u05e4\u05e0\u05d9\u05de\u05d9\u05d9\u05dd \u05db\u05de\u05d5 \u05de\u05d7\u05e9\u05d1\u05d5\u05ea, \u05e8\u05d2\u05e9\u05d5\u05ea \u05d5\u05db\u05d5\u05d5\u05e0\u05d5\u05ea (Dulcan p.851)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4-Sessional intervention trajectory \u05d1\u05d8\u05d9\u05e4\u05d5\u05dc MBT?",
      "back": "\u05ea\u05d4\u05dc\u05d9\u05da \u05de\u05d5\u05d1\u05e0\u05d4 \u05d4\u05db\u05d5\u05dc\u05dc \u05d0\u05de\u05e4\u05ea\u05d9\u05d4 \u05d5\u05ea\u05d9\u05e7\u05d5\u05e3, \u05d5\u05d0\u05d7\u05e8\u05d9\u05d4\u05dd \u05d4\u05d1\u05d4\u05e8\u05d4, \u05d7\u05e7\u05d9\u05e8\u05d4 \u05d5\u05d0\u05ea\u05d2\u05e8 \u05e2\u05d3\u05d9\u05df \u05dc\u05d4\u05e8\u05d7\u05d1\u05ea \u05d4\u05de\u05e0\u05d8\u05dc\u05d9\u05d6\u05e6\u05d9\u05d4 (Synopsis ch.23 Psychotherapy)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4-Cognitive model \u05dc\u05e4\u05d9 Beck?",
      "back": "\u05d4\u05d4\u05e0\u05d7\u05d4 \u05e9\u05ea\u05e4\u05d9\u05e1\u05d5\u05ea \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9\u05d5\u05ea \u05e9\u05dc \u05de\u05e6\u05d1 \u05de\u05e9\u05e4\u05d9\u05e2\u05d5\u05ea \u05e2\u05dc \u05d4\u05ea\u05d2\u05d5\u05d1\u05d4 \u05d4\u05e8\u05d2\u05e9\u05d9\u05ea, \u05d4\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea\u05d9\u05ea \u05d5\u05d4\u05e4\u05d9\u05d6\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea \u05d9\u05d5\u05ea\u05e8 \u05de\u05d0\u05e9\u05e8 \u05d4\u05de\u05e6\u05d1 \u05e2\u05e6\u05de\u05d5 (Synopsis ch.23 Psychotherapy)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4-Cognitive triad \u05d1\u05d3\u05d9\u05db\u05d0\u05d5\u05df?",
      "back": "\u05de\u05d7\u05e9\u05d1\u05d5\u05ea \u05e9\u05dc\u05d9\u05dc\u05d9\u05d5\u05ea \u05e2\u05dc \u05d4\u05e2\u05e6\u05de\u05d9, \u05e2\u05dc \u05d4\u05e2\u05d5\u05dc\u05dd \u05d5\u05e2\u05dc \u05d4\u05e2\u05ea\u05d9\u05d3 (Synopsis ch.23 Psychotherapy)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05de\u05e8\u05db\u05d9\u05d1 \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9 \u05d4\u05e7\u05e8\u05d9\u05d8\u05d9 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d1\u05d8\u05d9\u05e4\u05d5\u05dc CBT \u05e2\u05d1\u05d5\u05e8 Anxiety disorders?",
      "back": "\u05d7\u05e9\u05d9\u05e4\u05d4 (Exposure) (Dulcan p.968)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05de\u05d8\u05e8\u05d4 \u05d4\u05de\u05e8\u05db\u05d6\u05d9\u05ea \u05e9\u05dc Dialectical Behavior Therapy (DBT)?",
      "back": "\u05dc\u05e2\u05d6\u05d5\u05e8 \u05dc\u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd \u05d4\u05e1\u05d5\u05d1\u05dc\u05d9\u05dd \u05de\u05d0\u05d5\u05d3 \u05dc\u05d9\u05e6\u05d5\u05e8 \"\u05d7\u05d9\u05d9\u05dd \u05e9\u05e9\u05d5\u05d5\u05d4 \u05dc\u05d7\u05d9\u05d5\u05ea \u05d0\u05d5\u05ea\u05dd\" \u05e2\u05dc \u05d9\u05d3\u05d9 \u05e9\u05d9\u05e4\u05d5\u05e8 \u05d5\u05d9\u05e1\u05d5\u05ea \u05e8\u05d2\u05e9\u05d9 (Synopsis ch.23 Psychotherapy)."
    },
    {
      "front": "\u05d0\u05d9\u05dc\u05d5 \u05d0\u05e8\u05d1\u05e2\u05d4 \u05ea\u05d7\u05d5\u05de\u05d9\u05dd \u05e2\u05d5\u05de\u05d3\u05d9\u05dd \u05d1\u05de\u05d5\u05e7\u05d3 \u05e9\u05dc Interpersonal Psychotherapy (IPT)?",
      "back": "\u05d0\u05d1\u05dc (Grief), \u05e1\u05db\u05e1\u05d5\u05db\u05d9 \u05ea\u05e4\u05e7\u05d9\u05d3\u05d9\u05dd, \u05de\u05e2\u05d1\u05e8\u05d9 \u05ea\u05e4\u05e7\u05d9\u05d3 \u05d5\u05d7\u05e1\u05db\u05d9\u05dd \u05d1\u05d9\u05df-\u05d0\u05d9\u05e9\u05d9\u05d9\u05dd (Synopsis ch.23 Psychotherapy)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4-Holding \u05d1\u05ea\u05d4\u05dc\u05d9\u05da \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc\u05d9 \u05dc\u05e4\u05d9 \u05d4\u05d2\u05d9\u05e9\u05d4 \u05d4\u05de\u05e9\u05e4\u05d7\u05ea\u05d9\u05ea \u05d4\u05de\u05d5\u05e9\u05e4\u05e2\u05ea \u05de\u05d5\u05d5\u05d9\u05e0\u05d9\u05e7\u05d5\u05d8?",
      "back": "\u05d9\u05e6\u05d9\u05e8\u05ea \u05d4\u05e7\u05e9\u05e8 \u05d8\u05d9\u05e4\u05d5\u05dc\u05d9 \u05d1\u05d8\u05d5\u05d7 \u05e9\u05d1\u05d5 \u05d1\u05e0\u05d9 \u05d4\u05de\u05e9\u05e4\u05d7\u05d4 \u05d9\u05db\u05d5\u05dc\u05d9\u05dd \u05dc\u05d1\u05d8\u05d0 \u05e8\u05d2\u05e9\u05d5\u05ea \u05d5\u05dc\u05e4\u05ea\u05d7 \u05d7\u05d5\u05e1\u05df (Dulcan p.937)."
