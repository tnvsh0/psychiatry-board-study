{
  "title": "Antipsychotics Flashcards",
  "cards": [
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05e2\u05d9\u05e7\u05e8\u05d9 \u05d4\u05de\u05e9\u05d5\u05ea\u05e3 \u05dc\u05de\u05e8\u05d1\u05d9\u05ea \u05d4-Second-Generation Antipsychotics (SGA) \u05d4\u05de\u05d1\u05d3\u05d9\u05dc \u05d0\u05d5\u05ea\u05dd \u05de\u05d4\u05d3\u05d5\u05e8 \u05d4\u05e8\u05d0\u05e9\u05d5\u05df?",
      "back": "\u05e9\u05d9\u05dc\u05d5\u05d1 \u05e9\u05dc $D_{2}$ antagonism \u05d9\u05d7\u05d3 \u05e2\u05dd $5-HT_{2A}$ antagonism (StahlNeuro p.184)."
    },
    {
      "front": "\u05d0\u05d9\u05dc\u05d5 \u05e9\u05ea\u05d9 \u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05de\u05de\u05e9\u05e4\u05d7\u05ea \u05d4-SGA \u05e0\u05d7\u05e9\u05d1\u05d5\u05ea \u05dc\u05d1\u05e2\u05dc\u05d5\u05ea \u05d4-high metabolic risk \u05d4\u05d2\u05d1\u05d5\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8?",
      "back": "Clozapine \u05d5-Olanzapine (StahlNeuro p.204)."
    },
    {
      "front": "\u05d0\u05d9\u05d6\u05d5 \u05ea\u05e8\u05d5\u05e4\u05d4 \u05de\u05de\u05e9\u05e4\u05d7\u05ea \u05d4-SGA \u05d9\u05d3\u05d5\u05e2\u05d4 \u05db\u05d2\u05d5\u05e8\u05de\u05ea \u05dc\u05e9\u05d9\u05e2\u05d5\u05e8 \u05d4\u05d2\u05d1\u05d5\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05e9\u05dc hyperprolactinemia, \u05d1\u05de\u05d9\u05d5\u05d7\u05d3 \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d5\u05e0\u05d5\u05e2\u05e8?",
      "back": "Risperidone (Dulcan p.825; StahlKids p.424)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05e4\u05e8\u05de\u05e7\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d4\u05d9\u05d9\u05d7\u05d5\u05d3\u05d9 \u05e9\u05dc Aripiprazole \u05e2\u05dc \u05d4\u05e7\u05d5\u05dc\u05d8\u05df $D_{2}$?",
      "back": "\u05d4\u05d9\u05d0 \u05e4\u05d5\u05e2\u05dc\u05ea \u05db-$D_{2}$ partial agonist (StahlNeuro p.192; StahlKids p.3)."
    },
    {
      "front": "\u05dc\u05e4\u05d9 \u05d4-StahlKids, \u05de\u05d4\u05d9 \u05d4\u05ea\u05d3\u05d9\u05e8\u05d5\u05ea \u05d4\u05de\u05d5\u05de\u05dc\u05e6\u05ea \u05dc\u05e0\u05d9\u05d8\u05d5\u05e8 BMI \u05dc\u05d0\u05d7\u05e8 \u05d4\u05ea\u05d7\u05dc\u05ea \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Olanzapine?",
      "back": "\u05d0\u05d7\u05ea \u05dc\u05d7\u05d5\u05d3\u05e9 \u05d1-3 \u05d4\u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05d4\u05e8\u05d0\u05e9\u05d5\u05e0\u05d9\u05dd, \u05d5\u05dc\u05d0\u05d7\u05e8 \u05de\u05db\u05df \u05d0\u05d7\u05ea \u05dc\u05e8\u05d1\u05e2\u05d5\u05df (StahlKids p.351)."
    },
    {
      "front": "\u05de\u05d4 \u05de\u05d9\u05d9\u05d7\u05d3 \u05d0\u05ea \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05e9\u05dc Pimavanserin \u05de\u05db\u05dc \u05e9\u05d0\u05e8 \u05d4\u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05d4\u05de\u05d0\u05d5\u05e9\u05e8\u05d5\u05ea \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-psychosis?",
      "back": "\u05d4\u05d9\u05d0 \u05e4\u05d5\u05e2\u05dc\u05ea \u05db-$5-HT_{2A}$ inverse agonist \u05dc\u05dc\u05d0 \u05d7\u05e1\u05d9\u05de\u05d4 \u05e9\u05dc \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 $D_{2}$ (StahlNeuro p.232)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05e2\u05e8\u05da \u05d4-ANC (Absolute Neutrophil Count) \u05d4\u05de\u05d9\u05e0\u05d9\u05de\u05dc\u05d9 \u05d4\u05e0\u05d3\u05e8\u05e9 \u05dc\u05d4\u05de\u05e9\u05da \u05d8\u05d9\u05e4\u05d5\u05dc \u05e9\u05d2\u05e8\u05ea\u05d9 \u05d1-Clozapine?",
      "back": "\u05de\u05e2\u05dc $2,000/mm^{3}$ (Dulcan p.831)."
    },
    {
      "front": "\u05de\u05d4\u05dd \u05d4\u05d9\u05ea\u05e8\u05d5\u05e0\u05d5\u05ea \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9\u05d9\u05dd \u05d4\u05d1\u05d5\u05dc\u05d8\u05d9\u05dd \u05e9\u05dc Lurasidone \u05d1\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Bipolar disorder?",
      "back": "\u05d9\u05e2\u05d9\u05dc\u05d5\u05ea \u05de\u05d5\u05db\u05d7\u05ea \u05d1-bipolar depression \u05d5\u05e4\u05e8\u05d5\u05e4\u05d9\u05dc metabolic risk \u05e0\u05de\u05d5\u05da (StahlNeuro p.232; StahlKids p.291)."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 $5-HT_{2A}$ antagonism \u05d1-nigrostriatal pathway \u05de\u05e1\u05d9\u05d9\u05e2 \u05d1\u05d4\u05e4\u05d7\u05ea\u05ea EPS?",
      "back": "\u05e2\u05dc \u05d9\u05d3\u05d9 disinhibition \u05e9\u05dc \u05e9\u05d7\u05e8\u05d5\u05e8 \u05d3\u05d5\u05e4\u05de\u05d9\u05df, \u05e9\u05de\u05ea\u05d7\u05e8\u05d4 \u05e2\u05dd \u05d4-$D_{2}$ blocker \u05d1-motor striatum (StahlNeuro p.185)."
    },
    {
      "front": "\u05dc\u05d0\u05d9\u05d6\u05d4 \u05e7\u05d5\u05dc\u05d8\u05df \u05d3\u05d5\u05e4\u05de\u05d9\u05df \u05d9\u05e9 \u05dc-Cariprazine \u05d6\u05d9\u05e7\u05d4 (affinity) \u05d2\u05d1\u05d5\u05d4\u05d4 \u05d9\u05d5\u05ea\u05e8 \u05de\u05d0\u05e9\u05e8 \u05dc\u05d3\u05d5\u05e4\u05de\u05d9\u05df \u05e2\u05e6\u05de\u05d5?",
      "back": "\u05dc\u05e7\u05d5\u05dc\u05d8\u05df $D_{3}$ (StahlNeuro p.230; StahlNeuro p.375)."
    },
    {
      "front": "\u05d0\u05d9\u05d6\u05d5 \u05ea\u05d5\u05e4\u05e2\u05ea \u05dc\u05d5\u05d5\u05d0\u05d9 \u05de\u05d5\u05d8\u05d5\u05e8\u05d9\u05ea \u05e9\u05db\u05d9\u05d7\u05d4 \u05d1\u05de\u05d9\u05d5\u05d7\u05d3 \u05d1\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1-Aripiprazole \u05dc\u05de\u05e8\u05d5\u05ea \u05d4\u05d9\u05d5\u05ea\u05d5 prolactin-sparing?",
      "back": "Akathisia (StahlKids p.4)."
    },
    {
      "front": "\u05dc\u05d0\u05d9\u05dc\u05d5 \u05e9\u05ea\u05d9 \u05ea\u05e8\u05d5\u05e4\u05d5\u05ea SGA \u05d9\u05e9 \u05d0\u05d9\u05e9\u05d5\u05e8 FDA \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9 \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-irritability associated with autistic disorder \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d5\u05e0\u05d5\u05e2\u05e8?",
      "back": "Risperidone \u05d5-Aripiprazole (StahlKids p.4; StahlKids p.423)."
    },
    {
      "front": "\u05d7\u05e1\u05d9\u05de\u05ea \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 $D_{2}$ \u05d1\u05d0\u05d9\u05d6\u05d4 \u05de\u05e1\u05dc\u05d5\u05dc \u05d3\u05d5\u05e4\u05de\u05d9\u05e0\u05e8\u05d2\u05d9 \u05de\u05d5\u05d1\u05d9\u05dc\u05d4 \u05dc\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea hyperprolactinemia?",
      "back": "\u05d4\u05de\u05e1\u05dc\u05d5\u05dc \u05d4-Tuberoinfundibular (StahlNeuro p.164)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05de\u05d9\u05e0\u05d5\u05df \u05d4\u05d9\u05d5\u05de\u05d9 \u05d4\u05de\u05e7\u05d5\u05e8\u05d1 (\u05d4-\"Mama Bear\") \u05d4\u05de\u05d5\u05de\u05dc\u05e5 \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Bipolar Depression \u05d1\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1-Quetiapine?",
      "back": "$300\\ mg$ (StahlNeuro p.227)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05d4\u05e0\u05d7\u05d9\u05d4 \u05d4\u05ea\u05d6\u05d5\u05e0\u05ea\u05d9\u05ea \u05d4\u05e7\u05e8\u05d9\u05d8\u05d9\u05ea \u05d1\u05e2\u05ea \u05e0\u05d8\u05d9\u05dc\u05ea Ziprasidone \u05e4\u05d5\u05de\u05d9 \u05dc\u05d4\u05d1\u05d8\u05d7\u05ea \u05e1\u05e4\u05d9\u05d2\u05d4 \u05d9\u05e2\u05d9\u05dc\u05d4?",
      "back": "\u05d7\u05d5\u05d1\u05d4 \u05dc\u05d9\u05d8\u05d5\u05dc \u05d0\u05ea \u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 \u05d9\u05d7\u05d3 \u05e2\u05dd \u05d0\u05d5\u05db\u05dc (StahlNeuro p.232)."
    },
    {
      "front": "\u05de\u05d4 \u05e7\u05d1\u05e2\u05d4 \u05e1\u05e7\u05d9\u05e8\u05ea \u05d4-Cochrane \u05dc\u05d2\u05d1\u05d9 Risperidone \u05d1\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-aggression \u05d1\u05e7\u05e8\u05d1 \u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd disruptive behavior disorders?",
      "back": "\u05d4\u05d5\u05d0 \u05d9\u05e2\u05d9\u05dc \u05d9\u05d5\u05ea\u05e8 \u05de-placebo \u05dc\u05d4\u05e4\u05d7\u05ea\u05ea \u05d0\u05d2\u05e8\u05e1\u05d9\u05d1\u05d9\u05d5\u05ea \u05d1\u05d8\u05d5\u05d5\u05d7 \u05d4\u05e7\u05e6\u05e8 \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d1\u05d2\u05d9\u05dc\u05d0\u05d9 5-18 (Dulcan p.127)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05d4\u05d2\u05d3\u05e8\u05d4 \u05e9\u05dc Neuroleptic-induced deficit syndrome?",
      "back": "\u05de\u05e6\u05d1 \u05e9\u05dc apathy \u05d5-anhedonia \u05d4\u05e0\u05d2\u05e8\u05dd \u05de\u05d7\u05e1\u05d9\u05de\u05ea $D_{2}$ \u05d1-mesolimbic pathway \u05d4\u05de\u05d3\u05de\u05d4 \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e9\u05dc\u05d9\u05dc\u05d9\u05d9\u05dd (StahlNeuro p.163)."
    },
    {
      "front": "\u05e1\u05d3\u05e8 \u05d0\u05ea \u05d4\u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05d4\u05d1\u05d0\u05d5\u05ea \u05de\u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05d4\u05de\u05d8\u05d1\u05d5\u05dc\u05d9 \u05d4\u05d2\u05d1\u05d5\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05e0\u05de\u05d5\u05da \u05d1\u05d9\u05d5\u05ea\u05e8: Quetiapine, Olanzapine, Aripiprazole.",
      "back": "Olanzapine > Quetiapine > Aripiprazole (StahlNeuro p.204)."
    },
    {
      "front": "Clozapine \u05d4\u05d9\u05d0 \u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 \u05d4\u05d9\u05d7\u05d9\u05d3\u05d4 \u05d1-schizophrenia \u05e9\u05d4\u05d5\u05db\u05d7\u05d4 \u05db\u05de\u05e4\u05d7\u05d9\u05ea\u05d4 \u05d1\u05d0\u05d5\u05e4\u05df \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9 \u05d0\u05d9\u05d6\u05d4 \u05e1\u05d9\u05db\u05d5\u05df \u05e7\u05dc\u05d9\u05e0\u05d9?",
      "back": "\u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05d0\u05d5\u05d1\u05d3\u05e0\u05d5\u05ea (Suicide risk) (StahlNeuro p.226)."
    },
    {
      "front": "\u05e2\u05dc\u05d9\u05d9\u05d4 \u05e9\u05dc \u05d0\u05d9\u05d6\u05d4 \u05d0\u05d7\u05d5\u05d6 \u05de\u05de\u05e9\u05e7\u05dc \u05d4\u05d2\u05d5\u05e3 \u05d4\u05d1\u05e1\u05d9\u05e1\u05d9 \u05ea\u05d5\u05da 3 \u05d7\u05d5\u05d3\u05e9\u05d9 \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-SGA \u05e0\u05d7\u05e9\u05d1\u05ea \u05dc-clinically significant?",
      "back": "$7\\%$ \u05d5\u05de\u05e2\u05dc\u05d4 (Dulcan p.824; StahlKids p.351)."
    }
  ]
}