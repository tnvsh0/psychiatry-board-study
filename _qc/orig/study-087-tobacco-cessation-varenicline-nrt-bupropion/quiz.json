    {
      "type": "short_answer",
      "question": "\u05de\u05d3\u05d5\u05e2 Bupropion \u05e0\u05d7\u05e9\u05d1 \u05dc\u05d9\u05e2\u05d9\u05dc \u05d1\u05d4\u05e4\u05d7\u05ea\u05ea Craving \u05dc\u05e0\u05d9\u05e7\u05d5\u05d8\u05d9\u05df \u05de\u05d1\u05dc\u05d9 \u05e9\u05d9\u05d4\u05d9\u05d4 \u05d1\u05e2\u05dc \u05e4\u05d5\u05d8\u05e0\u05e6\u05d9\u05d0\u05dc Abuse \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9, \u05d1\u05d4\u05ea\u05d1\u05e1\u05e1 \u05e2\u05dc \u05e8\u05de\u05ea \u05ea\u05e4\u05d5\u05e1\u05ea \u05d4-DAT?",
      "grading": {
