            "\u05de\u05d7\u05e9\u05d1\u05d4 \u05e9\u05d4\u05e4\u05e1\u05e7\u05ea \u05d4\u05e2\u05d9\u05e9\u05d5\u05df \u05ea\u05d5\u05e8\u05d9\u05d3 \u05d0\u05ea \u05e8\u05de\u05ea \u05d4-Clozapine \u05d1\u05d3\u05dd."
          ],
          "bluffs": [
            "\u05d0\u05de\u05d9\u05e8\u05d4 \u05db\u05dc\u05dc\u05d9\u05ea \u05e9\u05e2\u05d9\u05e9\u05d5\u05df \u05de\u05e9\u05e4\u05d9\u05e2 \u05e2\u05dc \u05d4\u05de\u05d8\u05d1\u05d5\u05dc\u05d9\u05d6\u05dd \u05de\u05d1\u05dc\u05d9 \u05dc\u05e6\u05d9\u05d9\u05df \u05d0\u05ea \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05d0\u05e0\u05d6\u05d9\u05de\u05d8\u05d9 \u05d4\u05e1\u05e4\u05e6\u05d9\u05e4\u05d9."
          ]
        }
      },
      "hint": "\u05d4\u05ea\u05de\u05e7\u05d3 \u05d1\u05d4\u05e9\u05e4\u05e2\u05d4 \u05e9\u05dc \u05e8\u05db\u05d9\u05d1\u05d9 \u05e2\u05e9\u05df \u05d4\u05d8\u05d1\u05e7 \u05e2\u05dc \u05d4\u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05d0\u05e0\u05d6\u05d9\u05de\u05d8\u05d9\u05ea \u05d4\u05db\u05d1\u05d3\u05d9\u05ea CYP450.",
      "imageUrls": []
