    {
      "type": "multiple_choice",
      "question": "\u05e2\u05dc \u05e1\u05de\u05da \u05d4\u05e8\u05d0\u05d9\u05d5\u05ea \u05d4\u05de\u05d7\u05e7\u05e8\u05d9\u05d5\u05ea \u05d4\u05de\u05d5\u05e6\u05d2\u05d5\u05ea \u05d1-Dulcan \u05d1\u05e0\u05d5\u05d2\u05e2 \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05d1\u05e0\u05d9 \u05e0\u05d5\u05e2\u05e8, \u05de\u05d4\u05d9 \u05d4\u05d0\u05e1\u05d8\u05e8\u05d8\u05d2\u05d9\u05d4 \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc\u05d9\u05ea \u05e9\u05d4\u05d5\u05db\u05d7\u05d4 \u05db\u05d9\u05e2\u05d9\u05dc\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 (\u05d9\u05d5\u05ea\u05e8 \u05de\u05d0\u05e9\u05e8 \u05db\u05dc \u05de\u05e8\u05db\u05d9\u05d1 \u05d1\u05e0\u05e4\u05e8\u05d3) \u05dc\u05d4\u05e9\u05d2\u05ea \u05d4\u05d9\u05e0\u05d6\u05e8\u05d5\u05ea \u05de\u05e2\u05d9\u05e9\u05d5\u05df \u05d1\u05d0\u05d5\u05db\u05dc\u05d5\u05e1\u05d9\u05d9\u05d4 \u05d6\u05d5?",
      "answerOptions": [
        {
          "text": "\u05e9\u05d9\u05dc\u05d5\u05d1 \u05e9\u05dc Bupropion SR \u05d9\u05d7\u05d3 \u05e2\u05dd Contingency Management (CM).",
          "isCorrect": true,
          "rationale": "\u05d4\u05de\u05d7\u05e7\u05e8 \u05e9\u05dc Gray et al. (2011) \u05d4\u05e8\u05d0\u05d4 \u05db\u05d9 \u05d4\u05e9\u05d9\u05dc\u05d5\u05d1 \u05e9\u05dc \u05d8\u05d9\u05e4\u05d5\u05dc \u05ea\u05e8\u05d5\u05e4\u05ea\u05d9 \u05d1-Bupropion \u05d9\u05d7\u05d3 \u05e2\u05dd \u05d7\u05d9\u05d6\u05d5\u05e7\u05d9\u05dd \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea\u05d9\u05d9\u05dd (CM) \u05d4\u05d9\u05d4 \u05d9\u05e2\u05d9\u05dc \u05d9\u05d5\u05ea\u05e8 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05de\u05db\u05dc \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05e0\u05e4\u05e8\u05d3 (Dulcan p.234)."
        },
        {
          "text": "\u05de\u05d5\u05e0\u05d5\u05ea\u05e8\u05e4\u05d9\u05d4 \u05d1-Varenicline \u05d1\u05de\u05d9\u05e0\u05d5\u05df \u05de\u05dc\u05d0 \u05e9\u05dc \u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd.",
          "isCorrect": false,
          "rationale": "\u05de\u05d7\u05e7\u05e8\u05d9\u05dd \u05e8\u05d7\u05d1\u05d9 \u05d4\u05d9\u05e7\u05e3 \u05d1-Varenicline \u05d1\u05d1\u05e0\u05d9 \u05e0\u05d5\u05e2\u05e8 \u05dc\u05d0 \u05d4\u05e6\u05dc\u05d9\u05d7\u05d5 \u05dc\u05d4\u05e8\u05d0\u05d5\u05ea \u05de\u05d5\u05d1\u05d4\u05e7\u05d5\u05ea \u05e1\u05d8\u05d8\u05d9\u05e1\u05d8\u05d9\u05ea \u05d1\u05de\u05d3\u05d3 \u05d4\u05e8\u05d0\u05e9\u05d5\u05e0\u05d9 \u05e9\u05dc \u05d4\u05d9\u05e0\u05d6\u05e8\u05d5\u05ea \u05d0\u05e8\u05d5\u05db\u05ea \u05d8\u05d5\u05d5\u05d7 (Dulcan p.234)."
        },
        {
          "text": "\u05e9\u05d9\u05dc\u05d5\u05d1 \u05e9\u05dc \u05de\u05d3\u05d1\u05e7\u05ea \u05e0\u05d9\u05e7\u05d5\u05d8\u05d9\u05df (Nicotine Patch) \u05d9\u05d7\u05d3 \u05e2\u05dd Bupropion SR.",
          "isCorrect": false,
          "rationale": "\u05de\u05d7\u05e7\u05e8\u05d9\u05dd (Killen et al. 2004) \u05d4\u05e8\u05d0\u05d5 \u05e9\u05ea\u05d5\u05e1\u05e4\u05ea Bupropion \u05dc\u05de\u05d3\u05d1\u05e7\u05d4 \u05dc\u05d0 \u05e9\u05d9\u05e4\u05e8\u05d4 \u05d0\u05ea \u05e9\u05d9\u05e2\u05d5\u05e8\u05d9 \u05d4\u05d2\u05de\u05d9\u05dc\u05d4 \u05d1\u05d1\u05e0\u05d9 \u05e0\u05d5\u05e2\u05e8 \u05de\u05e2\u05d1\u05e8 \u05dc\u05de\u05d3\u05d1\u05e7\u05d4 \u05d1\u05dc\u05d1\u05d3 (Dulcan p.234, StahlKids p.88)."
        },
        {
          "text": "\u05d8\u05d9\u05e4\u05d5\u05dc \u05ea\u05d7\u05dc\u05d9\u05e4\u05d9 \u05d1\u05e0\u05d9\u05e7\u05d5\u05d8\u05d9\u05df (NRT) \u05d1\u05de\u05d9\u05e0\u05d5\u05e0\u05d9\u05dd \u05d4\u05d3\u05e8\u05d2\u05ea\u05d9\u05d9\u05dd \u05d1\u05dc\u05d1\u05d3.",
          "isCorrect": false,
          "rationale": "\u05d4\u05d9\u05e2\u05d9\u05dc\u05d5\u05ea \u05e9\u05dc NRT \u05db\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05d5\u05d3\u05d3 \u05d1\u05d1\u05e0\u05d9 \u05e0\u05d5\u05e2\u05e8 \u05e0\u05de\u05e6\u05d0\u05d4 \u05db\u05e6\u05e0\u05d5\u05e2\u05d4 \u05de\u05d0\u05d5\u05d3 \u05d5\u05e0\u05d5\u05d8\u05d4 \u05dc\u05e6\u05e0\u05d5\u05d7 \u05d1\u05d8\u05d5\u05d5\u05d7 \u05d4\u05d0\u05e8\u05d5\u05da (Dulcan p.234)."
        }
      ],
      "hint": "\u05d7\u05e4\u05e9 \u05d0\u05ea \u05d4\u05e9\u05d9\u05dc\u05d5\u05d1 \u05d4\u05de\u05e9\u05dc\u05d1 \u05de\u05e8\u05db\u05d9\u05d1 \u05e4\u05e8\u05de\u05e7\u05d5\u05dc\u05d5\u05d2\u05d9 \u05e2\u05dd \u05e9\u05d9\u05d8\u05d4 \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea\u05d9\u05ea \u05de\u05d1\u05d5\u05e1\u05e1\u05ea \u05d7\u05d9\u05d6\u05d5\u05e7\u05d9\u05dd.",
      "imageUrls": []
