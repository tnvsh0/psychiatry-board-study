{
  "title": "Smoking Quiz",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\u05de\u05ea\u05d1\u05d2\u05e8 \u05d1\u05df 17 \u05e2\u05dd \u05d4\u05ea\u05de\u05db\u05e8\u05d5\u05ea \u05e7\u05e9\u05d4 \u05dc\u05e0\u05d9\u05e7\u05d5\u05d8\u05d9\u05df \u05de\u05ea\u05d7\u05d9\u05dc \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Varenicline. \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05de\u05d3\u05d5\u05d5\u05d7 \u05db\u05d9 \u05d1\u05d9\u05d5\u05de\u05d9\u05d9\u05dd \u05d4\u05d0\u05d7\u05e8\u05d5\u05e0\u05d9\u05dd \u05d4\u05d5\u05d0 \u05e0\u05d9\u05e1\u05d4 \u05dc\u05e2\u05e9\u05df \u05e1\u05d9\u05d2\u05e8\u05d9\u05d4, \u05d0\u05da \u05d4\u05d9\u05d0 '\u05dc\u05d0 \u05d4\u05e8\u05d2\u05d9\u05e9\u05d4 \u05d0\u05d5\u05ea\u05d5 \u05d3\u05d1\u05e8' \u05d5\u05dc\u05d0 \u05d2\u05e8\u05de\u05d4 \u05dc\u05ea\u05d7\u05d5\u05e9\u05ea \u05d4\u05e1\u05d9\u05e4\u05d5\u05e7 \u05d4\u05de\u05d5\u05db\u05e8\u05ea. \u05de\u05d4\u05d5 \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05e0\u05d5\u05d9\u05e8\u05d5\u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d4\u05de\u05e1\u05d1\u05d9\u05e8 \u05d0\u05ea \u05d4-Net Antagonist effect \u05e9\u05dc \u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 \u05d1\u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05e0\u05d9\u05e7\u05d5\u05d8\u05d9\u05df \u05d7\u05d9\u05e6\u05d5\u05e0\u05d9?",
      "answerOptions": [
        {
          "text": "\u05dc-Varenicline \u05d9\u05e9 Affinity \u05d2\u05d1\u05d5\u05d4\u05d4 \u05d1\u05d4\u05e8\u05d1\u05d4 \u05dc\u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 $\\alpha_4\\beta_2$ \u05de\u05d0\u05e9\u05e8 \u05dc\u05e0\u05d9\u05e7\u05d5\u05d8\u05d9\u05df, \u05de\u05d4 \u05e9\u05d7\u05d5\u05e1\u05dd \u05ea\u05d7\u05e8\u05d5\u05ea\u05d9\u05ea \u05d0\u05ea \u05d4-pulsatile dopamine spike.",
          "isCorrect": true,
          "rationale": "\u05d1\u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05e0\u05d9\u05e7\u05d5\u05d8\u05d9\u05df, \u05d4\u05d6\u05d9\u05e7\u05d4 \u05d4\u05d2\u05d1\u05d5\u05d4\u05d4 \u05e9\u05dc Varenicline \u05de\u05d5\u05e0\u05e2\u05ea \u05de\u05d4\u05e0\u05d9\u05e7\u05d5\u05d8\u05d9\u05df \u05dc\u05d4\u05d9\u05e7\u05e9\u05e8 \u05dc\u05e7\u05d5\u05dc\u05d8\u05df \u05d5\u05dc\u05d2\u05e8\u05d5\u05dd \u05dc\u05e9\u05d7\u05e8\u05d5\u05e8 \u05d4\u05de\u05d4\u05d9\u05e8 \u05d5\u05d4\u05d7\u05d3 \u05e9\u05dc \u05d3\u05d5\u05e4\u05de\u05d9\u05df \u05d1\u05de\u05e1\u05dc\u05d5\u05dc \u05d4\u05ea\u05d2\u05de\u05d5\u05dc (StahlNeuro p.550-551)."
        },
        {
          "text": "\u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 \u05d2\u05d5\u05e8\u05de\u05ea \u05dc-Desensitization \u05de\u05d4\u05d9\u05e8\u05d4 \u05d5\u05e7\u05d1\u05d5\u05e2\u05d4 \u05e9\u05dc \u05d4\u05e7\u05d5\u05dc\u05d8\u05e0\u05d9\u05dd \u05d4\u05e0\u05d9\u05e7\u05d5\u05d8\u05d9\u05e0\u05d9\u05d9\u05dd \u05d1-Ventral Tegmental Area (VTA) \u05d4\u05de\u05d5\u05e0\u05e2\u05ea \u05db\u05dc \u05ea\u05d2\u05d5\u05d1\u05d4 \u05dc\u05e0\u05d9\u05e7\u05d5\u05d8\u05d9\u05df.",
          "isCorrect": false,
          "rationale": "Varenicline \u05d0\u05d9\u05e0\u05d4 \u05e4\u05d5\u05e2\u05dc\u05ea \u05d3\u05e8\u05da \u05d3\u05e1\u05e0\u05e1\u05d9\u05d8\u05d9\u05d6\u05e6\u05d9\u05d4 \u05e7\u05d1\u05d5\u05e2\u05d4 \u05d0\u05dc\u05d0 \u05de\u05d9\u05d9\u05e6\u05d1\u05ea \u05d0\u05ea \u05d4\u05e7\u05d5\u05dc\u05d8\u05df \u05d1\u05de\u05e6\u05d1 \u05d1\u05d9\u05e0\u05d9\u05d9\u05dd \u05e4\u05e2\u05d9\u05dc \u05e7\u05dc\u05d5\u05ea \u05db-partial agonist (StahlNeuro p.551)."
        },
        {
          "text": "Varenicline \u05de\u05e2\u05dc\u05d4 \u05d0\u05ea \u05e8\u05de\u05d5\u05ea \u05d4-GABA \u05d1-VTA, \u05d5\u05d1\u05db\u05da \u05d2\u05d5\u05e8\u05de\u05ea \u05dc\u05e2\u05d9\u05db\u05d5\u05d1 \u05d8\u05d5\u05e0\u05d9 \u05e9\u05dc \u05d4\u05e0\u05d5\u05d9\u05e8\u05d5\u05e0\u05d9\u05dd \u05d4\u05d3\u05d5\u05e4\u05de\u05d9\u05e0\u05e8\u05d2\u05d9\u05d9\u05dd \u05dc\u05dc\u05d0 \u05e7\u05e9\u05e8 \u05dc\u05e7\u05d9\u05e9\u05d5\u05e8 \u05d4\u05e0\u05d9\u05e7\u05d5\u05d8\u05d9\u05df.",
          "isCorrect": false,
          "rationale": "\u05d0\u05de\u05e0\u05dd \u05e0\u05d9\u05e7\u05d5\u05d8\u05d9\u05df \u05de\u05e9\u05e4\u05d9\u05e2 \u05e2\u05dc \u05d0\u05d9\u05e0\u05d8\u05e8\u05e0\u05d5\u05d9\u05e8\u05d5\u05e0\u05d9\u05dd GABA\u05e8\u05d2\u05d9\u05d9\u05dd, \u05d0\u05da \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05e9\u05dc Varenicline \u05db\u05d7\u05d5\u05e1\u05dd \u05d4\u05e0\u05d0\u05d4 \u05de\u05e2\u05d9\u05e9\u05d5\u05df \u05d4\u05d5\u05d0 \u05ea\u05d7\u05e8\u05d5\u05ea \u05d9\u05e9\u05d9\u05e8\u05d4 \u05e2\u05dc \u05e7\u05d5\u05dc\u05d8\u05df $\\alpha_4\\beta_2$ (StahlNeuro p.548-550)."
        },
        {
          "text": "\u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 \u05de\u05e2\u05db\u05d1\u05ea \u05d0\u05ea \u05d4-Dopamine Transporter (DAT) \u05d1\u05d2\u05e8\u05e2\u05d9\u05df \u05d4\u05d0\u05e7\u05d5\u05de\u05d1\u05e0\u05e1, \u05de\u05d4 \u05e9\u05de\u05d5\u05d1\u05d9\u05dc \u05dc\u05e8\u05d5\u05d5\u05d9\u05d4 \u05e9\u05dc \u05d4\u05e7\u05d5\u05dc\u05d8\u05e0\u05d9\u05dd \u05d4\u05e4\u05d5\u05e1\u05d8-\u05e1\u05d9\u05e0\u05e4\u05d8\u05d9\u05d9\u05dd \u05d5\u05de\u05e0\u05d9\u05e2\u05ea \u05ea\u05d2\u05d5\u05d1\u05d4 \u05dc\u05e1\u05d9\u05d2\u05e8\u05d9\u05d4.",
          "isCorrect": false,
          "rationale": "\u05e2\u05d9\u05db\u05d5\u05d1 DAT \u05d4\u05d5\u05d0 \u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05e4\u05e2\u05d5\u05dc\u05d4 \u05e9\u05dc Bupropion \u05d5\u05dc\u05d0 \u05e9\u05dc Varenicline (StahlNeuro p.303, p.551)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05ea\u05d7\u05e8\u05d5\u05ea \u05d4\u05e4\u05d9\u05d6\u05d9\u05ea \u05e2\u05dc \u05d0\u05ea\u05e8 \u05d4\u05e7\u05d9\u05e9\u05d5\u05e8 \u05e9\u05dc \u05d4\u05e7\u05d5\u05dc\u05d8\u05df \u05d4\u05e1\u05e4\u05e6\u05d9\u05e4\u05d9 \u05d5\u05d4\u05d4\u05d1\u05d3\u05dc \u05d1\u05d6\u05d9\u05e7\u05d4 (Affinity).",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05e0\u05e2\u05e8\u05d4 \u05d1\u05ea 16 \u05e4\u05d5\u05e0\u05d4 \u05dc\u05de\u05e8\u05e4\u05d0\u05d4 \u05d1\u05d1\u05e7\u05e9\u05d4 \u05dc\u05e2\u05d6\u05e8\u05d4 \u05d1\u05d2\u05de\u05d9\u05dc\u05d4 \u05de\u05e2\u05d9\u05e9\u05d5\u05df. \u05d1\u05d1\u05d3\u05d9\u05e7\u05ea \u05d4\u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4 \u05d4\u05e8\u05e4\u05d5\u05d0\u05d9\u05ea \u05e2\u05d5\u05dc\u05d4 \u05db\u05d9 \u05d4\u05d9\u05d0 \u05e1\u05d1\u05dc\u05d4 \u05de-Bulimia Nervosa \u05e4\u05e2\u05d9\u05dc\u05d4 \u05dc\u05e4\u05e0\u05d9 \u05db\u05e9\u05e0\u05d4, \u05d5\u05db\u05d9\u05d5\u05dd \u05e0\u05de\u05e6\u05d0\u05ea \u05d1\u05e0\u05e1\u05d9\u05d2\u05d4 (Remission). \u05e2\u05dc \u05e1\u05de\u05da \u05e4\u05e8\u05d5\u05e4\u05d9\u05dc \u05d4\u05d1\u05d8\u05d9\u05d7\u05d5\u05ea \u05d4\u05de\u05e4\u05d5\u05e8\u05d8 \u05d1-StahlKids \u05d5-Dulcan, \u05d0\u05d9\u05d6\u05d4 \u05de\u05d4\u05de\u05e9\u05e4\u05d8\u05d9\u05dd \u05d4\u05d1\u05d0\u05d9\u05dd \u05de\u05ea\u05d0\u05e8 \u05e0\u05db\u05d5\u05df \u05d0\u05ea \u05d4\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1-Bupropion \u05d1\u05de\u05e7\u05e8\u05d4 \u05d6\u05d4?",
      "answerOptions": [
        {
          "text": "\u05d4\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1-Bupropion \u05d4\u05d5\u05d0 Contraindicated \u05d1\u05d0\u05d5\u05e4\u05df \u05de\u05d5\u05d7\u05dc\u05d8 \u05e2\u05e7\u05d1 \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05d4\u05de\u05d5\u05d2\u05d1\u05e8 \u05dc-Seizures \u05d1\u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd \u05e2\u05dd \u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05d0\u05db\u05d9\u05dc\u05d4.",
          "isCorrect": true,
          "rationale": "\u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4 \u05e9\u05dc \u05d0\u05e0\u05d5\u05e8\u05e7\u05e1\u05d9\u05d4 \u05d0\u05d5 \u05d1\u05d5\u05dc\u05d9\u05de\u05d9\u05d4 \u05de\u05d4\u05d5\u05d5\u05d4 \u05d4\u05ea\u05ea\u05d5\u05d5\u05d9\u05d9\u05ea \u05e0\u05d2\u05d3 \u05de\u05d5\u05d7\u05dc\u05d8\u05ea \u05dc-Bupropion \u05d1\u05e9\u05dc \u05e8\u05d2\u05d9\u05e9\u05d5\u05ea \u05d9\u05ea\u05e8 \u05dc\u05e4\u05e8\u05db\u05d5\u05e1\u05d9\u05dd \u05e2\u05e7\u05d1 \u05ea\u05e0\u05d5\u05d3\u05d5\u05ea \u05d0\u05dc\u05e7\u05d8\u05e8\u05d5\u05dc\u05d9\u05d8\u05e8\u05d9\u05d5\u05ea (StahlKids p.84, Dulcan p.718)."
        },
        {
          "text": "\u05e0\u05d9\u05ea\u05df \u05dc\u05d4\u05e9\u05ea\u05de\u05e9 \u05d1-Bupropion \u05d1\u05d6\u05d4\u05d9\u05e8\u05d5\u05ea, \u05db\u05dc \u05e2\u05d5\u05d3 \u05de\u05e9\u05ea\u05de\u05e9\u05d9\u05dd \u05d1\u05e4\u05d5\u05e8\u05de\u05d5\u05dc\u05e6\u05d9\u05d9\u05ea \u05d4-XL \u05e9\u05d0\u05d9\u05e0\u05d4 \u05de\u05e2\u05dc\u05d4 \u05d0\u05ea \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05e4\u05e8\u05db\u05d5\u05e1\u05d9\u05dd \u05d1\u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd \u05d0\u05dc\u05d5.",
          "isCorrect": false,
          "rationale": "\u05d4\u05ea\u05d5\u05d5\u05d9\u05d9\u05ea \u05d4\u05e0\u05d2\u05d3 \u05ea\u05e7\u05e4\u05d4 \u05dc\u05db\u05dc \u05d4\u05e4\u05d5\u05e8\u05de\u05d5\u05dc\u05e6\u05d9\u05d5\u05ea \u05e9\u05dc Bupropion \u05d1\u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd \u05e2\u05dd \u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4 \u05e9\u05dc \u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05d0\u05db\u05d9\u05dc\u05d4 (StahlKids p.84)."
        },
        {
          "text": "\u05d4\u05e9\u05d9\u05de\u05d5\u05e9 \u05de\u05d5\u05ea\u05e8 \u05e8\u05e7 \u05d0\u05dd \u05e8\u05de\u05d5\u05ea \u05d4\u05d0\u05dc\u05e7\u05d8\u05e8\u05d5\u05dc\u05d9\u05d8\u05d9\u05dd \u05d1\u05d3\u05dd (Potassium, Sodium) \u05ea\u05e7\u05d9\u05e0\u05d5\u05ea \u05d1\u05d1\u05d3\u05d9\u05e7\u05ea \u05d1\u05e1\u05d9\u05e1 (Baseline).",
          "isCorrect": false,
          "rationale": "\u05d2\u05dd \u05e2\u05dd \u05e8\u05de\u05d5\u05ea \u05d0\u05dc\u05e7\u05d8\u05e8\u05d5\u05dc\u05d9\u05d8\u05d9\u05dd \u05ea\u05e7\u05d9\u05e0\u05d5\u05ea \u05d1\u05d1\u05d3\u05d9\u05e7\u05d4 \u05d1\u05d5\u05d3\u05d3\u05ea, \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05d4\u05de\u05d5\u05d1\u05e0\u05d4 \u05d1\u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd \u05d0\u05dc\u05d5 \u05e0\u05d5\u05ea\u05e8 \u05d2\u05d1\u05d5\u05d4 \u05de\u05d3\u05d9 \u05dc\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05d1\u05d8\u05d7\u05d4 (StahlKids p.84)."
        },
        {
          "text": "Bupropion \u05de\u05d5\u05de\u05dc\u05e5 \u05d1\u05de\u05d9\u05d5\u05d7\u05d3 \u05d1\u05de\u05e7\u05e8\u05d4 \u05d6\u05d4 \u05db\u05d9\u05d5\u05d5\u05df \u05e9\u05d4\u05d5\u05d0 \u05de\u05e1\u05d9\u05d9\u05e2 \u05d1\u05de\u05e0\u05d9\u05e2\u05ea \u05d4\u05e2\u05dc\u05d9\u05d9\u05d4 \u05d1\u05de\u05e9\u05e7\u05dc \u05d4\u05de\u05dc\u05d5\u05d5\u05d4 \u05dc\u05e2\u05d9\u05ea\u05d9\u05dd \u05e7\u05e8\u05d5\u05d1\u05d5\u05ea \u05d2\u05de\u05d9\u05dc\u05d4 \u05de\u05e2\u05d9\u05e9\u05d5\u05df.",
          "isCorrect": false,
          "rationale": "\u05d0\u05de\u05e0\u05dd Bupropion \u05e2\u05e9\u05d5\u05d9 \u05dc\u05d4\u05e4\u05d7\u05d9\u05ea \u05e2\u05dc\u05d9\u05d9\u05d4 \u05d1\u05de\u05e9\u05e7\u05dc, \u05d0\u05da \u05d1\u05de\u05d8\u05d5\u05e4\u05dc\u05ea \u05e2\u05dd \u05e8\u05e7\u05e2 \u05e9\u05dc \u05d1\u05d5\u05dc\u05d9\u05de\u05d9\u05d4, \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05e4\u05e8\u05db\u05d5\u05e1 \u05d2\u05d5\u05d1\u05e8 \u05e2\u05dc \u05ea\u05d5\u05e2\u05dc\u05ea \u05d6\u05d5 (StahlKids p.84, Dulcan p.718)."
        }
      ],
      "hint": "\u05d1\u05d3\u05d5\u05e7 \u05d0\u05ea \u05e8\u05e9\u05d9\u05de\u05ea \u05d4\u05ea\u05d5\u05d5\u05d9\u05d5\u05ea \u05d4\u05e0\u05d2\u05d3 \u05d4\u05de\u05d5\u05d7\u05dc\u05d8\u05d5\u05ea (Absolute Contraindications) \u05d4\u05e7\u05e9\u05d5\u05e8\u05d5\u05ea \u05dc\u05e1\u05e3 \u05e4\u05e8\u05db\u05d5\u05e1.",
