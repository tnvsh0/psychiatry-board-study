        },
        {
          "text": "\u05de\u05d2\u05d9\u05dc $3$ (\u05d1\u05d4\u05ea\u05d0\u05dd \u05dc-DC:0-5) \u05d5\u05e2\u05d3 \u05d2\u05d9\u05dc $21$",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05e9\u05e7\u05d9\u05d9\u05de\u05d5\u05ea \u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05d6\u05e2\u05dd \u05d1\u05d2\u05d9\u05dc \u05d4\u05e8\u05da, \u05d4-DSM \u05e7\u05d5\u05d1\u05e2 \u05e1\u05e3 \u05de\u05d9\u05e0\u05d9\u05de\u05dc\u05d9 \u05e9\u05dc \u05d2\u05d9\u05dc $6$ \u05dc\u05d0\u05d1\u05d7\u05e0\u05ea DMDD (\u05de\u05e7\u05d5\u05e8: Dulcan p. 21, DSM p. 178)."
        },
        {
          "text": "\u05de\u05d2\u05d9\u05dc $10$ \u05d5\u05e2\u05d3 \u05d2\u05d9\u05dc $18$ \u05d1\u05dc\u05d1\u05d3",
          "isCorrect": false,
          "rationale": "\u05d2\u05d9\u05dc $10$ \u05d4\u05d5\u05d0 \u05d4\u05d2\u05d9\u05dc \u05d4\u05de\u05e7\u05e1\u05d9\u05de\u05dc\u05d9 \u05dc*\u05d4\u05d5\u05e4\u05e2\u05ea* \u05d4\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd, \u05d0\u05da \u05e0\u05d9\u05ea\u05df \u05dc\u05d0\u05d1\u05d7\u05df \u05db\u05d1\u05e8 \u05de\u05d2\u05d9\u05dc $6$ (\u05de\u05e7\u05d5\u05e8: DSM p. 178)."
        },
        {
          "text": "\u05d1\u05db\u05dc \u05d2\u05d9\u05dc, \u05db\u05dc \u05e2\u05d5\u05d3 \u05e7\u05d9\u05d9\u05de\u05d5\u05ea \u05d0\u05e4\u05d9\u05d6\u05d5\u05d3\u05d5\u05ea \u05e9\u05dc Temper outbursts",
          "isCorrect": false,
          "rationale": "\u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05d5\u05db\u05e0\u05e1\u05d4 \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05ea \u05dc\u05d9\u05dc\u05d3\u05d9\u05dd \u05d5\u05e0\u05d5\u05e2\u05e8 \u05db\u05d3\u05d9 \u05dc\u05de\u05e0\u05d5\u05e2 \u05d0\u05d1\u05d7\u05d5\u05df \u05d9\u05ea\u05e8 \u05e9\u05dc Bipolar Disorder \u05d1\u05e7\u05d1\u05d5\u05e6\u05ea \u05d2\u05d9\u05dc \u05d6\u05d5 (\u05de\u05e7\u05d5\u05e8: Dulcan p. 267)."
        }
      ],
      "hint": "\u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05e0\u05d5\u05e2\u05d3\u05d4 \u05dc\u05de\u05e0\u05d5\u05e2 \u05d0\u05d1\u05d7\u05d5\u05df \u05d9\u05ea\u05e8 \u05e9\u05dc \u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05d0\u05d7\u05e8\u05d5\u05ea \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05e6\u05e2\u05d9\u05e8\u05d9\u05dd \u05de\u05d0\u05d5\u05d3 \u05d0\u05d5 \u05d1\u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd."
    },
    {
      "question": "\u05de\u05d8\u05d5\u05e4\u05dc \u05e2\u05dd Persistent Depressive Disorder (PDD) \u05de\u05e6\u05d9\u05d2 \u05d4\u05d7\u05de\u05e8\u05d4 \u05d1\u05de\u05e6\u05d1\u05d5, \u05d5\u05db\u05e2\u05ea \u05d4\u05d5\u05d0 \u05e2\u05d5\u05e0\u05d4 \u05e2\u05dc \u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05d4\u05de\u05dc\u05d0\u05d9\u05dd \u05dc-Major Depressive Episode. \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR, \u05d0\u05d9\u05d6\u05d4 Specifier \u05de\u05ea\u05d0\u05e8 \u05de\u05e6\u05d1 \u05e9\u05d1\u05d5 \u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05dc-MDD \u05d4\u05ea\u05e7\u05d9\u05d9\u05de\u05d5 \u05dc\u05d0\u05d5\u05e8\u05da \u05db\u05dc \u05e9\u05e0\u05ea\u05d9\u05d9\u05dd \u05d4\u05d0\u05d7\u05e8\u05d5\u05e0\u05d5\u05ea \u05e9\u05dc \u05d4\u05e4\u05e8\u05e2\u05ea \u05d4-PDD?",
      "answerOptions": [
        {
          "text": "With persistent major depressive episode",
          "isCorrect": true,
          "rationale": "\u05de\u05e6\u05d9\u05d9\u05df \u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05e8\u05e6\u05d9\u05e4\u05d4 \u05e9\u05dc \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05de\u05dc\u05d0\u05d9\u05dd \u05dc-MDD \u05dc\u05d0\u05d5\u05e8\u05da \u05db\u05dc \u05ea\u05e7\u05d5\u05e4\u05ea \u05d4\u05e9\u05e0\u05ea\u05d9\u05d9\u05dd (\u05de\u05e7\u05d5\u05e8: DSM p. 193)."
        },
        {
          "text": "With pure dysthymic syndrome",
          "isCorrect": false,
          "rationale": "\u05de\u05ea\u05d9\u05d9\u05d7\u05e1 \u05dc\u05de\u05e6\u05d1 \u05e9\u05d1\u05d5 \u05dc\u05d0 \u05d4\u05ea\u05e7\u05d9\u05d9\u05de\u05d5 \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05dc-MDD \u05d1\u05e9\u05e0\u05ea\u05d9\u05d9\u05dd \u05d4\u05d0\u05d7\u05e8\u05d5\u05e0\u05d5\u05ea (\u05de\u05e7\u05d5\u05e8: DSM p. 193)."
        },
        {
          "text": "With intermittent major depressive episodes",
          "isCorrect": false,
          "rationale": "\u05de\u05ea\u05d0\u05e8 \u05de\u05e6\u05d1 \u05e9\u05d1\u05d5 \u05d9\u05e9 \u05d0\u05e4\u05d9\u05d6\u05d5\u05d3\u05d5\u05ea \u05e9\u05dc MDD \u05e9\u05d1\u05d9\u05e0\u05d9\u05d4\u05df \u05ea\u05e7\u05d5\u05e4\u05d5\u05ea \u05dc\u05dc\u05d0 \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05de\u05dc\u05d0\u05d9\u05dd, \u05d0\u05da \u05e2\u05d3\u05d9\u05d9\u05df \u05e2\u05dd \u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05e9\u05dc PDD (\u05de\u05e7\u05d5\u05e8: Dulcan p. 254)."
        },
        {
          "text": "With melancholic features",
          "isCorrect": false,
          "rationale": "\u05de\u05ea\u05d9\u05d9\u05d7\u05e1 \u05dc\u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9\u05dd \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05d9\u05dd \u05e9\u05dc \u05d7\u05d5\u05de\u05e8\u05ea \u05d4\u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05d5\u05d0\u05d5\u05d1\u05d3\u05df \u05d4\u05e0\u05d0\u05d4, \u05dc\u05dc\u05d0 \u05e7\u05e9\u05e8 \u05dc\u05e8\u05e6\u05e3 \u05d4\u05db\u05e8\u05d5\u05e0\u05d5\u05dc\u05d5\u05d2\u05d9 \u05e9\u05dc \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 (\u05de\u05e7\u05d5\u05e8: DSM p. 183)."
        }
      ],
      "hint": "\u05d7\u05e4\u05e9\u05d5 \u05d0\u05ea \u05d4\u05de\u05d5\u05e0\u05d7 \u05e9\u05de\u05ea\u05d0\u05e8 \u05e8\u05e6\u05d9\u05e4\u05d5\u05ea (Persistence) \u05e9\u05dc \u05d4\u05d0\u05e4\u05d9\u05d6\u05d5\u05d3\u05d4 \u05d4\u05e7\u05e9\u05d4 \u05d1\u05ea\u05d5\u05da \u05d4\u05de\u05e6\u05d1 \u05d4\u05db\u05e8\u05d5\u05e0\u05d9."
    },
    {
      "question": "\u05d4\u05d9\u05e4\u05d5\u05ea\u05d6\u05ea \u05d4-Neuroplasticity \u05d1\u05d3\u05d9\u05db\u05d0\u05d5\u05df, \u05d4\u05de\u05d5\u05e1\u05d1\u05e8\u05ea \u05d1-StahlNeuro, \u05de\u05e6\u05d9\u05e2\u05d4 \u05db\u05d9 \u05d8\u05d9\u05e4\u05d5\u05dc \u05de\u05d5\u05e6\u05dc\u05d7 \u05d1-Antidepressants \u05de\u05d5\u05d1\u05d9\u05dc \u05dc\u05e2\u05dc\u05d9\u05d9\u05d4 \u05d1\u05d1\u05d9\u05d8\u05d5\u05d9 \u05e9\u05dc \u05d0\u05d9\u05d6\u05d4 \u05d7\u05dc\u05d1\u05d5\u05df \u05e7\u05e8\u05d9\u05d8\u05d9 \u05dc\u05d4\u05d9\u05e9\u05e8\u05d3\u05d5\u05ea \u05e0\u05d5\u05d9\u05e8\u05d5\u05e0\u05dc\u05d9\u05ea \u05d5\u05dc\u05d9\u05e6\u05d9\u05e8\u05ea \u05e1\u05d9\u05e0\u05e4\u05e1\u05d5\u05ea \u05d7\u05d3\u05e9\u05d5\u05ea?",
      "answerOptions": [
        {
          "text": "Brain-derived neurotrophic factor (BDNF)",
          "isCorrect": true,
          "rationale": "\u05e2\u05dc\u05d9\u05d9\u05d4 \u05d1\u05e8\u05de\u05d5\u05ea \u05d4-BDNF \u05e0\u05d7\u05e9\u05d1\u05ea \u05dc\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05de\u05e4\u05ea\u05d7 \u05d1\u05ea\u05d9\u05e7\u05d5\u05df \u05e0\u05d6\u05e7\u05d9 \u05d4\u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05d1-Hippocampus \u05d5\u05d1\u05e9\u05d9\u05e4\u05d5\u05e8 \u05d4-Plasticity \u05d4\u05e1\u05d9\u05e0\u05e4\u05d8\u05d9\u05ea (\u05de\u05e7\u05d5\u05e8: StahlNeuro p. 269)."
        },
        {
          "text": "Monoamine Oxidase (MAO)",
          "isCorrect": false,
          "rationale": "\u05d6\u05d4\u05d5 \u05d0\u05e0\u05d6\u05d9\u05dd \u05d4\u05de\u05e4\u05e8\u05e7 \u05de\u05d5\u05e0\u05d5\u05d0\u05de\u05d9\u05e0\u05d9\u05dd; \u05e2\u05d9\u05db\u05d5\u05d1\u05d5 (\u05d5\u05dc\u05d0 \u05e2\u05dc\u05d9\u05d9\u05ea\u05d5) \u05d4\u05d5\u05d0 \u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d0\u05e0\u05d8\u05d9-\u05d3\u05d9\u05db\u05d0\u05d5\u05e0\u05d9 (\u05de\u05e7\u05d5\u05e8: StahlNeuro p. 265)."
        },
        {
          "text": "Corticotropin-releasing factor (CRF)",
          "isCorrect": false,
          "rationale": "\u05e8\u05de\u05d5\u05ea \u05d2\u05d1\u05d5\u05d4\u05d5\u05ea \u05e9\u05dc CRF \u05e7\u05e9\u05d5\u05e8\u05d5\u05ea \u05dc\u05ea\u05d2\u05d5\u05d1\u05ea \u05d3\u05d7\u05e7 (Stress) \u05de\u05d5\u05d2\u05d1\u05e8\u05ea \u05d5\u05e2\u05dc\u05d5\u05dc\u05d5\u05ea \u05dc\u05d4\u05d7\u05de\u05d9\u05e8 \u05d3\u05d9\u05db\u05d0\u05d5\u05df (\u05de\u05e7\u05d5\u05e8: StahlNeuro p. 270)."
        },
        {
          "text": "GABA-A Receptor $ \\alpha_1 $ subunit",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05e9\u05dc-GABA \u05d9\u05e9 \u05ea\u05e4\u05e7\u05d9\u05d3, \u05d4-BDNF \u05d4\u05d5\u05d0 \u05d4'\u05d3\u05dc\u05e7' \u05d4\u05e2\u05d9\u05e7\u05e8\u05d9 \u05d4\u05de\u05d5\u05d6\u05db\u05e8 \u05d1\u05d4\u05e7\u05e9\u05e8 \u05e9\u05dc \u05e6\u05de\u05d9\u05d7\u05d4 \u05d5\u05e9\u05d9\u05e7\u05d5\u05dd \u05e0\u05d5\u05d9\u05e8\u05d5\u05e0\u05dc\u05d9 (\u05de\u05e7\u05d5\u05e8: StahlNeuro p. 271)."
        }
      ],
      "hint": "\u05d6\u05d4\u05d5 \u05d2\u05d5\u05e8\u05dd \u05d2\u05d3\u05d9\u05dc\u05d4 (Growth factor) \u05d4\u05de\u05d5\u05e9\u05e4\u05e2 \u05de\u05de\u05e1\u05dc\u05d5\u05dc\u05d9 \u05d4-cAMP \u05d5\u05d4-CREB."
    }
  ]
