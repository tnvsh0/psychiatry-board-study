{
  "title": "Psychiatry Quiz",
  "questions": [
    {
      "question": "\u05d1\u05df $9$ \u05de\u05d5\u05e4\u05e0\u05d4 \u05dc\u05d4\u05e2\u05e8\u05db\u05d4 \u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9\u05ea \u05d1\u05e9\u05dc \u05de\u05e6\u05d1 \u05e8\u05d5\u05d7 \u05d9\u05e8\u05d5\u05d3 \u05d5\u05e0\u05d5\u05d8\u05d4 \u05dc\u05e8\u05d5\u05d2\u05d6 (Irritable) \u05e9\u05e0\u05de\u05e9\u05da \u05dc\u05e4\u05d7\u05d5\u05ea $14$ \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05d1\u05e8\u05e6\u05d9\u05e4\u05d5\u05ea. \u05d4\u05d5\u05e8\u05d9\u05d5 \u05de\u05d3\u05d5\u05d5\u05d7\u05d9\u05dd \u05db\u05d9 \u05dc\u05d0 \u05d4\u05d9\u05d9\u05ea\u05d4 \u05ea\u05e7\u05d5\u05e4\u05d4 \u05e9\u05dc \u05d9\u05d5\u05ea\u05e8 \u05de\u05d7\u05d5\u05d3\u05e9 \u05e9\u05d1\u05d4 \u05e0\u05e8\u05d0\u05d4 \u05e0\u05d9\u05e0\u05d5\u05d7, \u05d5\u05d4\u05d5\u05d0 \u05e1\u05d5\u05d1\u05dc \u05de\u05d4\u05e2\u05e8\u05db\u05d4 \u05e2\u05e6\u05de\u05d9\u05ea \u05e0\u05de\u05d5\u05db\u05d4 \u05d5\u05de\u05e7\u05e9\u05d9\u05d9 \u05e8\u05d9\u05db\u05d5\u05d6 \u05d1\u05dc\u05d9\u05de\u05d5\u05d3\u05d9\u05dd. \u05dc\u05d0 \u05ea\u05d5\u05d0\u05e8\u05d5 \u05d0\u05e4\u05d9\u05d6\u05d5\u05d3\u05d5\u05ea \u05e9\u05dc Mania \u05d0\u05d5 Hypomania, \u05d5\u05d4\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05d0\u05d9\u05e0\u05dd \u05de\u05d5\u05e1\u05d1\u05e8\u05d9\u05dd \u05e2\u05dc \u05d9\u05d3\u05d9 MDD \u05db\u05e8\u05d5\u05e0\u05d9 \u05d1\u05dc\u05d1\u05d3. \u05de\u05d4\u05d9 \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05e1\u05d1\u05d9\u05e8\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR?",
      "answerOptions": [
        {
          "text": "Persistent Depressive Disorder (PDD)",
          "isCorrect": true,
          "rationale": "\u05d1\u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc PDD \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d5\u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd, \u05de\u05e9\u05da \u05d4\u05d6\u05de\u05df \u05d4\u05e0\u05d3\u05e8\u05e9 \u05d4\u05d5\u05d0 \u05e9\u05e0\u05d4 \u05d0\u05d7\u05ea \u05dc\u05e4\u05d7\u05d5\u05ea (\u05dc\u05e2\u05d5\u05de\u05ea \u05e9\u05e0\u05ea\u05d9\u05d9\u05dd \u05d1\u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd), \u05d5\u05de\u05e6\u05d1 \u05d4\u05e8\u05d5\u05d7 \u05d9\u05db\u05d5\u05dc \u05dc\u05d4\u05d9\u05d5\u05ea Irritable \u05d5\u05dc\u05d0\u05d5 \u05d3\u05d5\u05d5\u05e7\u05d0 Depressed (\u05de\u05e7\u05d5\u05e8: DSM p. 193)."
        },
        {
          "text": "Major Depressive Disorder (MDD), Single Episode",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05e9\u05d4\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05d7\u05d5\u05e4\u05e4\u05d9\u05dd, \u05d4\u05d0\u05d5\u05e4\u05d9 \u05d4\u05db\u05e8\u05d5\u05e0\u05d9 \u05d5\u05d4\u05de\u05ea\u05de\u05e9\u05da (\u05de\u05e2\u05dc \u05e9\u05e0\u05d4) \u05dc\u05dc\u05d0 \u05d4\u05e4\u05d5\u05d2\u05d5\u05ea \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05d5\u05ea \u05de\u05db\u05d5\u05d5\u05df \u05dc\u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc PDD \u05d4\u05de\u05d0\u05d7\u05d3\u05ea Dysthymia \u05d5-MDD \u05db\u05e8\u05d5\u05e0\u05d9 (\u05de\u05e7\u05d5\u05e8: DSM p. 193)."
        },
        {
          "text": "Disruptive Mood Dysregulation Disorder (DMDD)",
          "isCorrect": false,
          "rationale": "\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d6\u05d5 \u05d3\u05d5\u05e8\u05e9\u05ea \u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05e9\u05dc \u05d4\u05ea\u05e4\u05e8\u05e6\u05d5\u05d9\u05d5\u05ea \u05d6\u05e2\u05dd (Temper outbursts) \u05ea\u05d3\u05d9\u05e8\u05d5\u05ea \u05d5\u05d7\u05de\u05d5\u05e8\u05d5\u05ea, \u05d5\u05dc\u05d0 \u05e8\u05e7 \u05de\u05e6\u05d1 \u05e8\u05d5\u05d7 Irritable \u05db\u05e8\u05d5\u05e0\u05d9 (\u05de\u05e7\u05d5\u05e8: DSM p. 178)."
        },
        {
          "text": "Adjustment Disorder with Depressed Mood",
          "isCorrect": false,
          "rationale": "\u05d4\u05e4\u05e8\u05e2\u05ea \u05d4\u05e1\u05ea\u05d2\u05dc\u05d5\u05ea \u05de\u05d5\u05d2\u05d3\u05e8\u05ea \u05db\u05ea\u05d2\u05d5\u05d1\u05d4 \u05dc\u05d2\u05d5\u05e8\u05dd \u05d3\u05d7\u05e7 \u05de\u05d6\u05d5\u05d4\u05d4 \u05d5\u05d0\u05d9\u05e0\u05d4 \u05d0\u05de\u05d5\u05e8\u05d4 \u05dc\u05d4\u05d9\u05de\u05e9\u05da \u05de\u05e2\u05dc $6$ \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05de\u05e8\u05d2\u05e2 \u05d4\u05e1\u05e8\u05ea \u05d2\u05d5\u05e8\u05dd \u05d4\u05d3\u05d7\u05e7 (\u05de\u05e7\u05d5\u05e8: Dulcan p. 331)."
        }
      ],
      "hint": "\u05e9\u05d9\u05de\u05d5 \u05dc\u05d1 \u05dc\u05de\u05e9\u05da \u05d4\u05d6\u05de\u05df \u05d4\u05e0\u05d3\u05e8\u05e9 \u05dc\u05d0\u05d1\u05d7\u05e0\u05d4 \u05db\u05e8\u05d5\u05e0\u05d9\u05ea \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05dc\u05e2\u05d5\u05de\u05ea \u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd."
    },
    {
      "question": "\u05d1\u05df $10$ \u05e2\u05dd \u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4 \u05e9\u05dc Oppositional Defiant Disorder (ODD) \u05de\u05e6\u05d9\u05d2 \u05d4\u05d7\u05de\u05e8\u05d4 \u05d1\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea. \u05d1\u05e9\u05e0\u05d4 \u05d4\u05d0\u05d7\u05e8\u05d5\u05e0\u05d4 \u05d4\u05d5\u05d0 \u05d7\u05d5\u05d5\u05d4 \u05d4\u05ea\u05e4\u05e8\u05e6\u05d5\u05d9\u05d5\u05ea \u05d6\u05e2\u05dd \u05e7\u05e9\u05d5\u05ea \u05d4\u05db\u05d5\u05dc\u05dc\u05d5\u05ea \u05e6\u05e2\u05e7\u05d5\u05ea \u05d5\u05e9\u05d1\u05d9\u05e8\u05ea \u05d7\u05e4\u05e6\u05d9\u05dd \u05d4\u05de\u05ea\u05e8\u05d7\u05e9\u05d5\u05ea \u05d1\u05de\u05de\u05d5\u05e6\u05e2 $4$ \u05e4\u05e2\u05de\u05d9\u05dd \u05d1\u05e9\u05d1\u05d5\u05e2 \u05d1\u05d1\u05d9\u05ea \u05d5\u05d1\u05d1\u05d9\u05ea \u05d4\u05e1\u05e4\u05e8. \u05d1\u05d9\u05df \u05d4\u05d4\u05ea\u05e4\u05e8\u05e6\u05d5\u05d9\u05d5\u05ea, \u05d4\u05de\u05d5\u05e8\u05d4 \u05d5\u05d4\u05d5\u05e8\u05d9\u05d5 \u05de\u05ea\u05d0\u05e8\u05d9\u05dd \u05d0\u05d5\u05ea\u05d5 \u05db\u05db\u05e2\u05d5\u05e1 \u05d5-Irritable \u05e8\u05d5\u05d1 \u05e9\u05e2\u05d5\u05ea \u05d4\u05d9\u05d5\u05dd. \u05de\u05d4\u05d9 \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05e0\u05db\u05d5\u05e0\u05d4 \u05dc\u05e4\u05d9 \u05e1\u05d3\u05e8 \u05d4\u05e7\u05d3\u05d9\u05de\u05d5\u05d9\u05d5\u05ea \u05d1-DSM-5-TR?",
      "answerOptions": [
        {
          "text": "Disruptive Mood Dysregulation Disorder (DMDD)",
          "isCorrect": true,
          "rationale": "\u05db\u05d0\u05e9\u05e8 \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05dc-ODD \u05d5\u05dc-DMDD \u05de\u05ea\u05e7\u05d9\u05d9\u05de\u05d9\u05dd \u05d1\u05d5-\u05d6\u05de\u05e0\u05d9\u05ea, \u05d9\u05e9 \u05dc\u05ea\u05ea \u05d0\u05ea \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc DMDD \u05d1\u05dc\u05d1\u05d3, \u05e9\u05db\u05df \u05d4\u05d9\u05d0 \u05e0\u05d7\u05e9\u05d1\u05ea \u05dc\u05d0\u05d1\u05d7\u05e0\u05d4 '\u05d7\u05d6\u05e7\u05d4' \u05d9\u05d5\u05ea\u05e8 \u05d1\u05de\u05d3\u05e8\u05d2 (\u05de\u05e7\u05d5\u05e8: DSM p. 182)."
        },
        {
          "text": "Oppositional Defiant Disorder (ODD)",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05e9\u05d4\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05de\u05ea\u05d0\u05d9\u05de\u05d9\u05dd \u05dc-ODD, \u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05d4\u05ea\u05e4\u05e8\u05e6\u05d5\u05d9\u05d5\u05ea \u05d7\u05de\u05d5\u05e8\u05d5\u05ea \u05d1\u05ea\u05d3\u05d9\u05e8\u05d5\u05ea \u05e9\u05dc $\\ge 3$ \u05e4\u05e2\u05de\u05d9\u05dd \u05d1\u05e9\u05d1\u05d5\u05e2 \u05e2\u05dc \u05e8\u05e7\u05e2 Irritability \u05db\u05e8\u05d5\u05e0\u05d9 \u05de\u05d7\u05d9\u05d9\u05d1\u05ea \u05d0\u05d1\u05d7\u05e0\u05ea DMDD (\u05de\u05e7\u05d5\u05e8: Dulcan p. 267)."
        },
        {
          "text": "Intermittent Explosive Disorder (IED)",
          "isCorrect": false,
          "rationale": "\u05d1-IED \u05d0\u05d9\u05df \u05d3\u05e8\u05d9\u05e9\u05d4 \u05dc\u05de\u05e6\u05d1 \u05e8\u05d5\u05d7 Irritable \u05d0\u05d5 \u05db\u05e2\u05d5\u05e1 \u05d1\u05d9\u05df \u05d4\u05d4\u05ea\u05e4\u05e8\u05e6\u05d5\u05d9\u05d5\u05ea, \u05d5\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d6\u05d5 \u05dc\u05d0 \u05d9\u05db\u05d5\u05dc\u05d4 \u05dc\u05d4\u05d9\u05e0\u05ea\u05df \u05d9\u05d7\u05d3 \u05e2\u05dd DMDD (\u05de\u05e7\u05d5\u05e8: DSM p. 182)."
        },
        {
          "text": "Pediatric Bipolar Disorder",
          "isCorrect": false,
          "rationale": "\u05d4\u05e4\u05e8\u05e2\u05d4 \u05d3\u05d5-\u05e7\u05d5\u05d8\u05d1\u05d9\u05ea \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d3\u05d5\u05e8\u05e9\u05ea \u05d0\u05e4\u05d9\u05d6\u05d5\u05d3\u05d5\u05ea \u05d1\u05e8\u05d5\u05e8\u05d5\u05ea (Episodic) \u05e9\u05dc \u05e9\u05d9\u05e0\u05d5\u05d9 \u05d1\u05de\u05e6\u05d1 \u05d4\u05e8\u05d5\u05d7, \u05d1\u05e0\u05d9\u05d2\u05d5\u05d3 \u05dc-Irritability \u05d4\u05db\u05e8\u05d5\u05e0\u05d9 \u05e9\u05de\u05d0\u05e4\u05d9\u05d9\u05df DMDD (\u05de\u05e7\u05d5\u05e8: Dulcan p. 296)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d1\u05d5 \u05e2\u05dc \u05d4\u05de\u05d3\u05e8\u05d2 \u05d4\u05d0\u05d1\u05d7\u05e0\u05ea\u05d9 (Hierarchy) \u05d1\u05d9\u05df \u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05dc\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05de\u05e6\u05d1 \u05e8\u05d5\u05d7 \u05d1-DSM."
    },
    {
      "question": "\u05d1\u05d1\u05d7\u05d9\u05e0\u05ea \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05e0\u05d9\u05dd \u05d4\u05e0\u05d5\u05d9\u05e8\u05d5\u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05d9\u05dd \u05e9\u05dc \u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05de\u05e6\u05d1 \u05e8\u05d5\u05d7 \u05dc\u05e4\u05d9 StahlNeuro, \u05de\u05d4\u05d5 \u05d4\u05de\u05de\u05e6\u05d0 \u05d4\u05de\u05d1\u05e0\u05d9 \u05d1-MRI \u05d4\u05de\u05e7\u05d5\u05e9\u05e8 \u05dc\u05e2\u05dc\u05d9\u05d9\u05d4 \u05db\u05e8\u05d5\u05e0\u05d9\u05ea \u05d1\u05e8\u05de\u05d5\u05ea Glucocorticoids \u05d5\u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05d9\u05ea\u05e8 \u05e9\u05dc HPA axis \u05d1\u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd \u05e2\u05dd Depressive Disorders?",
      "answerOptions": [
        {
          "text": "Atrophy \u05e9\u05dc \u05d4-Hippocampus",
          "isCorrect": true,
          "rationale": "\u05d7\u05e9\u05d9\u05e4\u05d4 \u05de\u05de\u05d5\u05e9\u05db\u05ea \u05dc-Stress \u05d5\u05e8\u05de\u05d5\u05ea \u05d2\u05d1\u05d5\u05d4\u05d5\u05ea \u05e9\u05dc Cortisol \u05e2\u05dc\u05d5\u05dc\u05d4 \u05dc\u05d4\u05d9\u05d5\u05ea \u05d8\u05d5\u05e7\u05e1\u05d9\u05ea \u05dc\u05e0\u05d5\u05d9\u05e8\u05d5\u05e0\u05d9\u05dd \u05d1-Hippocampus \u05d5\u05dc\u05d4\u05d5\u05d1\u05d9\u05dc \u05dc\u05d9\u05e8\u05d9\u05d3\u05d4 \u05d1\u05e0\u05e4\u05d7\u05d5 (\u05de\u05e7\u05d5\u05e8: StahlNeuro p. 270)."
        },
        {
          "text": "Hypertrophy \u05e9\u05dc \u05d4-Prefrontal Cortex (PFC)",
          "isCorrect": false,
          "rationale": "\u05d1\u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05e0\u05e6\u05e4\u05d9\u05ea \u05d1\u05d3\u05e8\u05da \u05db\u05dc\u05dc \u05d9\u05e8\u05d9\u05d3\u05d4 \u05d1\u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05d5\u05d1\u05e0\u05e4\u05d7 \u05d4-PFC, \u05d5\u05dc\u05d0 \u05d2\u05d3\u05d9\u05dc\u05d4 \u05e9\u05dc\u05d5 (\u05de\u05e7\u05d5\u05e8: StahlNeuro p. 270)."
        },
        {
          "text": "\u05d4\u05d2\u05d3\u05dc\u05ea \u05d4-Nucleus Accumbens",
          "isCorrect": false,
          "rationale": "\u05d0\u05d6\u05d5\u05e8 \u05d6\u05d4 \u05e7\u05e9\u05d5\u05e8 \u05dc\u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05ea\u05d2\u05de\u05d5\u05dc (Reward) \u05d5\u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05e7\u05e9\u05d5\u05e8 \u05dc\u05e8\u05d5\u05d1 \u05dc-Hypoactivation \u05e9\u05dc\u05d5, \u05d1\u05de\u05d9\u05d5\u05d7\u05d3 \u05d1\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05e9\u05dc Anhedonia (\u05de\u05e7\u05d5\u05e8: StahlNeuro p. 90)."
        },
        {
          "text": "\u05d9\u05e8\u05d9\u05d3\u05d4 \u05d1\u05e0\u05e4\u05d7 \u05d4-Ventricular system",
          "isCorrect": false,
          "rationale": "\u05d1\u05de\u05e6\u05d1\u05d9\u05dd \u05e0\u05d5\u05d9\u05e8\u05d5-\u05d3\u05d2\u05e0\u05e8\u05d8\u05d9\u05d1\u05d9\u05d9\u05dd \u05d0\u05d5 \u05db\u05e8\u05d5\u05e0\u05d9\u05d9\u05dd \u05e7\u05e9\u05d9\u05dd, \u05d4\u05d7\u05d3\u05e8\u05d9\u05dd \u05e0\u05d5\u05d8\u05d9\u05dd \u05d3\u05d5\u05d5\u05e7\u05d0 \u05dc\u05d4\u05ea\u05e8\u05d7\u05d1 \u05db\u05ea\u05d5\u05e6\u05d0\u05d4 \u05de\u05d0\u05d5\u05d1\u05d3\u05df \u05e8\u05e7\u05de\u05ea \u05de\u05d5\u05d7 (\u05de\u05e7\u05d5\u05e8: StahlNeuro p. 269)."
