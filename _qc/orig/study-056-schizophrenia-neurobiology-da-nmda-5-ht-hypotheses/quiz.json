    {
      "type": "multiple_choice",
      "question": "\u05d1\u05de\u05e1\u05d2\u05e8\u05ea \u05d4-integrative hub concept \u05d4\u05de\u05d5\u05e6\u05d2 \u05d1-StahlNeuro, \u05d4\u05d9\u05db\u05df \u05de\u05de\u05d5\u05e7\u05de\u05ea \u05e2\u05d9\u05e7\u05e8 \u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05d4\u05d9\u05ea\u05e8 \u05d4\u05d3\u05d5\u05e4\u05de\u05d9\u05e0\u05e8\u05d2\u05d9\u05ea \u05d4\u05de\u05e7\u05d5\u05e9\u05e8\u05ea \u05dc\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05d4\u05d7\u05d9\u05d5\u05d1\u05d9\u05d9\u05dd \u05e9\u05dc schizophrenia?",
      "answerOptions": [
        {
          "text": "Associative striatum",
          "isCorrect": true,
          "rationale": "\u05e0\u05ea\u05d5\u05e0\u05d9 \u05d4\u05d3\u05de\u05d9\u05d4 \u05de\u05e6\u05d9\u05e2\u05d9\u05dd \u05e9\u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05d4\u05d9\u05ea\u05e8 \u05d4\u05d3\u05d5\u05e4\u05de\u05d9\u05e0\u05e8\u05d2\u05d9\u05ea \u05d1-schizophrenia \u05de\u05de\u05d5\u05e7\u05d3\u05ea \u05d1-associative striatum, \u05d4\u05de\u05e7\u05d1\u05dc \u05e7\u05dc\u05d8 \u05de\u05d4-substantia nigra (StahlNeuro p.93)."
        },
        {
          "text": "Nucleus accumbens (Ventral striatum)",
          "isCorrect": false,
          "rationale": "\u05dc\u05e4\u05d9 \u05d4\u05de\u05d5\u05e9\u05d2 \u05d4\u05d7\u05d3\u05e9, \u05d4\u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05d1-ventral striatum \u05e2\u05e9\u05d5\u05d9\u05d4 \u05dc\u05d4\u05d9\u05d5\u05ea \u05ea\u05e7\u05d9\u05e0\u05d4, \u05d1\u05e0\u05d9\u05d2\u05d5\u05d3 \u05dc\u05ea\u05e4\u05d9\u05e1\u05d4 \u05d4\u05e7\u05dc\u05d0\u05e1\u05d9\u05ea (StahlNeuro p.93)."
        },
        {
          "text": "Dorsolateral Prefrontal Cortex (DLPFC)",
          "isCorrect": false,
          "rationale": "\u05d1\u05d0\u05d6\u05d5\u05e8 \u05d6\u05d4 \u05e7\u05d9\u05d9\u05de\u05ea \u05d3\u05d5\u05d5\u05e7\u05d0 \u05d4\u05d9\u05e4\u05d5\u05d3\u05d5\u05e4\u05de\u05d9\u05e0\u05e8\u05d2\u05d9\u05d4 \u05d4\u05e7\u05e9\u05d5\u05e8\u05d4 \u05dc\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9\u05d9\u05dd (StahlNeuro p.94)."
        },
        {
          "text": "Motor striatum",
          "isCorrect": false,
          "rationale": "\u05d0\u05d6\u05d5\u05e8 \u05d6\u05d4 \u05e7\u05d5\u05e8\u05dc\u05d8\u05d9\u05d1\u05d9 \u05dc\u05ea\u05e0\u05d5\u05e2\u05d4; \u05d7\u05e1\u05d9\u05de\u05ea \u05d3\u05d5\u05e4\u05de\u05d9\u05df \u05d1\u05d5 \u05d2\u05d5\u05e8\u05de\u05ea \u05dc-DIP (StahlNeuro p.93)."
        }
      ],
      "hint": "\u05d6\u05d4\u05d5 \u05d0\u05d6\u05d5\u05e8 '\u05d1\u05d9\u05e0\u05d9\u05d9\u05dd' \u05d1\u05e1\u05d8\u05e8\u05d9\u05d0\u05d8\u05d5\u05dd, \u05e9\u05d0\u05d9\u05e0\u05d5 \u05d4-accumbens \u05d4\u05e7\u05dc\u05d0\u05e1\u05d9."
    },
    {
      "type": "multiple_choice",
      "question": "\u05e0\u05e2\u05e8 \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05d1-Clozapine \u05e2\u05e7\u05d1 schizophrenia \u05e2\u05de\u05d9\u05d3\u05d4 \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc. \u05d4\u05de\u05d8\u05e4\u05dc \u05e9\u05d5\u05e7\u05dc \u05dc\u05d1\u05e6\u05e2 \u05d1\u05d3\u05d9\u05e7\u05ea \u05e2\u05d6\u05e8 \u05e0\u05d5\u05d9\u05e8\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea \u05e2\u05e7\u05d1 \u05d4\u05d9\u05d3\u05d5\u05e2 \u05e2\u05dc \u05d4\u05e9\u05e4\u05e2\u05ea \u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 \u05e2\u05dc \u05e1\u05e3 \u05d4\u05e4\u05e8\u05db\u05d5\u05e1. \u05d0\u05d9\u05d6\u05d4 \u05de\u05d4\u05d1\u05d3\u05d9\u05e7\u05d5\u05ea \u05d4\u05d1\u05d0\u05d5\u05ea \u05de\u05d5\u05d6\u05db\u05e8\u05ea \u05d1-Dulcan \u05db\u05e8\u05dc\u05d5\u05d5\u05e0\u05d8\u05d9\u05ea \u05dc\u05e4\u05e0\u05d9 \u05d0\u05d5 \u05d1\u05de\u05d4\u05dc\u05da \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Clozapine \u05d1\u05de\u05e7\u05e8\u05d9\u05dd \u05de\u05e1\u05d5\u05d9\u05de\u05d9\u05dd?",
      "answerOptions": [
        {
          "text": "Electroencephalogram (EEG)",
          "isCorrect": true,
          "rationale": "\u05e7\u05dc\u05d9\u05e0\u05d0\u05d9\u05dd \u05e2\u05e9\u05d5\u05d9\u05d9\u05dd \u05dc\u05d4\u05d6\u05de\u05d9\u05df EEG \u05dc\u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd \u05d4\u05de\u05d5\u05e2\u05de\u05d3\u05d9\u05dd \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05d4\u05de\u05d5\u05e8\u05d9\u05d3\u05d5\u05ea \u05d0\u05ea \u05e1\u05e3 \u05d4\u05e4\u05e8\u05db\u05d5\u05e1, \u05db\u05de\u05d5 Clozapine, \u05d1\u05de\u05d9\u05d5\u05d7\u05d3 \u05d0\u05dd \u05d9\u05e9 \u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4 \u05e9\u05dc seizures (Dulcan p.684)."
        },
        {
          "text": "Computed Tomography (CT)",
          "isCorrect": false,
          "rationale": "CT \u05de\u05d5\u05d6\u05db\u05e8 \u05db\u05e8\u05dc\u05d5\u05d5\u05e0\u05d8\u05d9 \u05dc\u05e9\u05dc\u05d9\u05dc\u05ea \u05e4\u05ea\u05d5\u05dc\u05d5\u05d2\u05d9\u05d4 \u05ea\u05d5\u05da-\u05d2\u05d5\u05dc\u05d2\u05d5\u05dc\u05ea\u05d9\u05ea \u05d1-new-onset psychosis, \u05d0\u05da \u05d0\u05d9\u05e0\u05d5 \u05db\u05dc\u05d9 \u05e0\u05d9\u05d8\u05d5\u05e8 \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9 \u05dc-Clozapine (Dulcan p.684)."
        },
        {
          "text": "Lumbar Puncture (LP)",
          "isCorrect": false,
          "rationale": "\u05d1\u05d3\u05d9\u05e7\u05d4 \u05d6\u05d5 \u05d0\u05d9\u05e0\u05d4 \u05d7\u05dc\u05e7 \u05de\u05d4\u05e0\u05d9\u05d8\u05d5\u05e8 \u05d4\u05e1\u05d8\u05e0\u05d3\u05e8\u05d8\u05d9 \u05e9\u05dc \u05e7\u05dc\u05d5\u05d6\u05e4\u05d9\u05df \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd (Dulcan p.684)."
        },
        {
          "text": "fMRI",
          "isCorrect": false,
          "rationale": "fMRI \u05d4\u05d5\u05d0 \u05db\u05dc\u05d9 \u05de\u05d7\u05e7\u05e8\u05d9 \u05d1\u05e2\u05d9\u05e7\u05e8\u05d5 \u05d5\u05d0\u05d9\u05e0\u05d5 \u05de\u05e9\u05de\u05e9 \u05dc\u05e0\u05d9\u05d8\u05d5\u05e8 \u05e7\u05dc\u05d9\u05e0\u05d9 \u05e9\u05dc \u05d8\u05d9\u05e4\u05d5\u05dc \u05ea\u05e8\u05d5\u05e4\u05ea\u05d9 \u05d1-schizophrenia (Synopsis ch.5)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d1\u05d5 \u05e2\u05dc \u05d1\u05d3\u05d9\u05e7\u05d4 \u05d4\u05de\u05d5\u05d3\u05d3\u05ea \u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05d7\u05e9\u05de\u05dc\u05d9\u05ea \u05d1\u05de\u05d5\u05d7."
    },
    {
      "type": "multiple_choice",
      "question": "\u05de\u05d7\u05e7\u05e8\u05d9 structural neuroimaging \u05d1-Synopsis \u05de\u05e6\u05d1\u05d9\u05e2\u05d9\u05dd \u05e2\u05dc \u05db\u05da \u05e9\u05d1\u05d7\u05d5\u05dc\u05d9\u05dd \u05e2\u05dd schizophrenia \u05e7\u05d9\u05d9\u05dd \u05de\u05de\u05e6\u05d0 \u05e2\u05e7\u05d1\u05d9 \u05e9\u05dc \u05d9\u05e8\u05d9\u05d3\u05d4 \u05d1\u05e0\u05e4\u05d7 \u05e9\u05dc \u05de\u05d1\u05e0\u05d4 \u05d1\u05de\u05d5\u05d7 \u05d1\u05db-5%. \u05de\u05d4\u05d5 \u05d4\u05de\u05d1\u05e0\u05d4?",
      "answerOptions": [
        {
          "text": "Hippocampus",
          "isCorrect": true,
          "rationale": "\u05d4\u05d3\u05de\u05d9\u05d4 \u05de\u05d1\u05e0\u05d9\u05ea \u05ea\u05d5\u05de\u05db\u05ea \u05d1\u05d0\u05d5\u05e4\u05df \u05d7\u05d6\u05e7 \u05d1\u05de\u05e1\u05e7\u05e0\u05d4 \u05e9\u05d4\u05d4\u05d9\u05e4\u05d5\u05e7\u05de\u05e4\u05d5\u05e1 \u05d1-schizophrenia \u05e7\u05d8\u05df \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea, \u05d1\u05e2\u05e8\u05da \u05d1-5% (Synopsis ch.33)."
        },
        {
          "text": "Thalamus",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05de\u05e2\u05d5\u05e8\u05d1\u05d5\u05ea\u05d5 \u05d1\u05e8\u05e9\u05ea\u05d5\u05ea \u05d4\u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d4, \u05d4\u05e0\u05ea\u05d5\u05df \u05d4\u05e1\u05e4\u05e6\u05d9\u05e4\u05d9 \u05e9\u05dc \u05d9\u05e8\u05d9\u05d3\u05d4 \u05e9\u05dc 5% \u05d1\u05e0\u05e4\u05d7 \u05de\u05d9\u05d5\u05d7\u05e1 \u05dc\u05d4\u05d9\u05e4\u05d5\u05e7\u05de\u05e4\u05d5\u05e1 (Synopsis ch.33; Synopsis ch.5)."
        },
        {
          "text": "Amygdala",
          "isCorrect": false,
          "rationale": "\u05d4\u05d0\u05de\u05d9\u05d2\u05d3\u05dc\u05d4 \u05de\u05e2\u05d5\u05e8\u05d1\u05ea \u05d1\u05ea\u05d2\u05d5\u05d1\u05d4 \u05d4\u05e8\u05d2\u05e9\u05d9\u05ea, \u05d0\u05da \u05d4\u05d9\u05e8\u05d9\u05d3\u05d4 \u05d4\u05de\u05d5\u05e8\u05e4\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea \u05d4\u05de\u05d3\u05d5\u05d5\u05d7\u05ea \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d4\u05d9\u05d0 \u05d1\u05d4\u05d9\u05e4\u05d5\u05e7\u05de\u05e4\u05d5\u05e1 (Synopsis ch.33)."
        },
        {
          "text": "Cerebellum",
          "isCorrect": false,
          "rationale": "\u05de\u05d1\u05e0\u05d4 \u05d6\u05d4 \u05d0\u05d9\u05e0\u05d5 \u05d4\u05de\u05de\u05e6\u05d0 \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05d1\u05de\u05d7\u05e7\u05e8\u05d9 \u05d4\u05e0\u05e4\u05d7 \u05d4\u05de\u05d1\u05e0\u05d9 \u05e9\u05dc schizophrenia (Synopsis ch.33)."
        }
      ],
      "hint": "\u05d6\u05d4\u05d5 \u05de\u05d1\u05e0\u05d4 \u05d1\u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05dc\u05d9\u05de\u05d1\u05d9\u05ea \u05d4\u05e7\u05e9\u05d5\u05e8 \u05dc\u05d6\u05d9\u05db\u05e8\u05d5\u05df \u05d5\u05e0\u05d9\u05d5\u05d5\u05d8 \u05de\u05e8\u05d7\u05d1\u05d9."
    }
