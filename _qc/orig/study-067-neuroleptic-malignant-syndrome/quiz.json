    {
      "type": "short_answer",
      "question": "\u05db\u05d9\u05e6\u05d3 \u05e0\u05d9\u05ea\u05df \u05dc\u05d4\u05d1\u05d7\u05d9\u05df \u05d1\u05d9\u05df Malignant Catatonia \u05dc\u05d1\u05d9\u05df Neuroleptic Malignant Syndrome (NMS) \u05e2\u05dc \u05e4\u05d9 \u05d4\u05de\u05d4\u05dc\u05da \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9 \u05d5\u05d4\u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4 \u05d4\u05ea\u05e8\u05d5\u05e4\u05ea\u05d9\u05ea \u05e9\u05dc \u05d4\u05de\u05d8\u05d5\u05e4\u05dc?",
      "grading": {
        "modelAnswer": "\u05d4\u05d4\u05d1\u05d7\u05e0\u05d4 \u05de\u05ea\u05d1\u05e1\u05e1\u05ea \u05e2\u05dc \u05e1\u05d3\u05e8 \u05d4\u05d5\u05e4\u05e2\u05ea \u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd: \u05d1-Malignant Catatonia \u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d4\u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9\u05d9\u05dd \u05d5\u05d4\u05e7\u05d8\u05d8\u05d5\u05e0\u05d9\u05d9\u05dd (\u05db\u05d2\u05d5\u05df \u05de\u05d5\u05d8\u05d9\u05d6\u05dd \u05d0\u05d5 \u05e4\u05d5\u05e1\u05d8\u05d5\u05e8\u05d9\u05e0\u05d2) \u05de\u05d5\u05e4\u05d9\u05e2\u05d9\u05dd \u05dc\u05e4\u05e0\u05d9 \u05d4\u05d7\u05d5\u05dd \u05d5\u05d4\u05d0\u05d9-\u05d9\u05e6\u05d9\u05d1\u05d5\u05ea \u05d4\u05d0\u05d5\u05d8\u05d5\u05e0\u05d5\u05de\u05d9\u05ea, \u05d5\u05dc\u05e2\u05d9\u05ea\u05d9\u05dd \u05dc\u05dc\u05d0 \u05d7\u05e9\u05d9\u05e4\u05d4 \u05e7\u05d5\u05d3\u05de\u05ea \u05dc\u05d7\u05d5\u05e1\u05dd \u05d3\u05d5\u05e4\u05de\u05d9\u05df. \u05d1-NMS, \u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05de\u05ea\u05e4\u05ea\u05d7\u05d9\u05dd \u05d1\u05d6\u05d9\u05e7\u05d4 \u05d9\u05e9\u05d9\u05e8\u05d4 \u05dc\u05d7\u05e9\u05d9\u05e4\u05d4 \u05d0\u05d5 \u05d4\u05e2\u05dc\u05d0\u05ea \u05de\u05d9\u05e0\u05d5\u05df \u05e9\u05dc D2 antagonist \u05d1-72 \u05d4\u05e9\u05e2\u05d5\u05ea \u05e9\u05e7\u05d3\u05de\u05d5 \u05dc\u05d4\u05ea\u05e7\u05e3.",
        "rationale": "\u05d4\u05d6\u05de\u05df \u05d4\u05db\u05e8\u05d5\u05e0\u05d5\u05dc\u05d5\u05d2\u05d9 \u05e9\u05dc \u05d4\u05d7\u05e9\u05d9\u05e4\u05d4 \u05dc\u05ea\u05e8\u05d5\u05e4\u05d4 \u05d4\u05d5\u05d0 \u05d4\u05de\u05e4\u05ea\u05d7 \u05d4\u05de\u05d1\u05d3\u05d9\u05dc \u05d1\u05d9\u05df NMS \u05dc\u05d1\u05d9\u05df \u05e7\u05d8\u05d8\u05d5\u05e0\u05d9\u05d4 \u05de\u05de\u05d0\u05d9\u05e8\u05d4 (DSM p.135, p.811).",
        "requiredAttributes": [
          "\u05e6\u05d9\u05d5\u05df \u05e9\u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d1-Malignant Catatonia \u05de\u05d5\u05e4\u05d9\u05e2\u05d9\u05dd \u05dc\u05e4\u05e0\u05d9 \u05d4\u05d7\u05d5\u05dd/\u05d0\u05d9-\u05d9\u05e6\u05d9\u05d1\u05d5\u05ea.",
          "\u05e6\u05d9\u05d5\u05df \u05d4\u05e7\u05e9\u05e8 \u05d4\u05d9\u05e9\u05d9\u05e8 \u05d1\u05d9\u05df NMS \u05dc\u05d7\u05e9\u05d9\u05e4\u05d4 \u05dc-D2 antagonist \u05d1-72 \u05d4\u05e9\u05e2\u05d5\u05ea \u05d4\u05d0\u05d7\u05e8\u05d5\u05e0\u05d5\u05ea.",
          "\u05d4\u05ea\u05d9\u05d9\u05d7\u05e1\u05d5\u05ea \u05dc\u05db\u05da \u05e9\u05e7\u05d8\u05d8\u05d5\u05e0\u05d9\u05d4 \u05de\u05de\u05d0\u05d9\u05e8\u05d4 \u05d9\u05db\u05d5\u05dc\u05d4 \u05dc\u05d4\u05d5\u05e4\u05d9\u05e2 \u05dc\u05dc\u05d0 \u05d7\u05e9\u05d9\u05e4\u05d4 \u05ea\u05e8\u05d5\u05e4\u05ea\u05d9\u05ea."
        ],
        "errors": {
          "misconceptions": [
            "\u05d8\u05e0\u05d4 \u05e9-CPK \u05d2\u05d1\u05d5\u05d4 \u05de\u05d5\u05e4\u05d9\u05e2 \u05e8\u05e7 \u05d1-NMS (\u05d4\u05d5\u05d0 \u05d9\u05db\u05d5\u05dc \u05dc\u05e2\u05dc\u05d5\u05ea \u05d2\u05dd \u05d1\u05e7\u05d8\u05d8\u05d5\u05e0\u05d9\u05d4 \u05de\u05de\u05d0\u05d9\u05e8\u05d4)."
          ],
          "bluffs": [
            "\u05d0\u05de\u05d9\u05e8\u05d4 \u05db\u05dc\u05dc\u05d9\u05ea \u05e9\u05e7\u05d8\u05d8\u05d5\u05e0\u05d9\u05d4 \u05d4\u05d9\u05d0 \u05de\u05d7\u05dc\u05ea \u05e0\u05e4\u05e9 \u05d5-NMS \u05d4\u05d5\u05d0 \u05ea\u05d2\u05d5\u05d1\u05d4 \u05dc\u05ea\u05e8\u05d5\u05e4\u05d4 \u05d1\u05dc\u05d9 \u05dc\u05d4\u05e1\u05d1\u05d9\u05e8 \u05d0\u05ea \u05d4\u05de\u05d4\u05dc\u05da \u05d4\u05d6\u05de\u05e0\u05d9."
          ]
        }
      },
      "hint": "\u05d4\u05ea\u05de\u05e7\u05d3 \u05d1'\u05de\u05d9 \u05d4\u05d5\u05e4\u05d9\u05e2 \u05e7\u05d5\u05d3\u05dd' - \u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d4\u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9\u05d9\u05dd \u05d0\u05d5 \u05d4\u05d7\u05e9\u05d9\u05e4\u05d4 \u05dc\u05d7\u05d5\u05e1\u05dd \u05d4\u05d3\u05d5\u05e4\u05de\u05d9\u05df.",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05d1\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05ea\u05e8\u05d5\u05e4\u05ea\u05d9 \u05d4\u05d9\u05d9\u05e2\u05d5\u05d3\u05d9 \u05dc-NMS \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d5\u05e0\u05d5\u05e2\u05e8, \u05de\u05d4\u05d5 \u05d4\u05ea\u05e4\u05e7\u05d9\u05d3 \u05d4\u05e4\u05d9\u05d6\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05e9\u05dc \u05de\u05ea\u05df Dantrolene?",
      "answerOptions": [
        {
          "text": "\u05d4\u05e8\u05e4\u05d9\u05d9\u05ea \u05e9\u05e8\u05d9\u05e8\u05d9\u05dd \u05d9\u05e9\u05d9\u05e8\u05d4 \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d4\u05e9\u05e4\u05e2\u05d4 \u05d4\u05d9\u05e7\u05e4\u05d9\u05ea \u05e2\u05dc \u05d4\u05e9\u05e8\u05d9\u05e8 \u05d4\u05e9\u05dc\u05d3.",
          "isCorrect": true,
          "rationale": "Dantrolene \u05e4\u05d5\u05e2\u05dc \u05db\u05de\u05e8\u05e4\u05d4 \u05e9\u05e8\u05d9\u05e8\u05d9\u05dd \u05d4\u05d9\u05e7\u05e4\u05d9 \u05d9\u05e9\u05d9\u05e8, \u05de\u05d4 \u05e9\u05de\u05e1\u05d9\u05d9\u05e2 \u05d1\u05d4\u05e4\u05d7\u05ea\u05ea \u05d4\u05e7\u05e9\u05d9\u05d7\u05d5\u05ea \u05d5\u05d4\u05d4\u05d9\u05e4\u05e8\u05ea\u05e8\u05de\u05d9\u05d4 \u05d4\u05e0\u05d5\u05d1\u05e2\u05ea \u05de\u05db\u05d9\u05d5\u05d5\u05e5 \u05d4\u05e9\u05e8\u05d9\u05e8\u05d9\u05dd (StahlNeuro p.169, Syllabus p.33)."
        },
        {
          "text": "\u05d0\u05d2\u05d5\u05e0\u05d9\u05e1\u05d8 \u05d3\u05d5\u05e4\u05de\u05d9\u05e0\u05e8\u05d2\u05d9 \u05dc\u05ea\u05d9\u05e7\u05d5\u05df \u05d4\u05d7\u05e1\u05d9\u05de\u05d4 \u05d1\u05d4\u05d9\u05e4\u05d5\u05ea\u05dc\u05de\u05d5\u05e1.",
          "isCorrect": false,
          "rationale": "\u05d6\u05d4\u05d5 \u05d4\u05ea\u05e4\u05e7\u05d9\u05d3 \u05e9\u05dc Bromocriptine, \u05dc\u05d0 \u05e9\u05dc Dantrolene (StahlNeuro p.169)."
        },
        {
          "text": "\u05d7\u05e1\u05d9\u05de\u05d4 \u05e9\u05dc \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 5-HT2A \u05dc\u05de\u05e0\u05d9\u05e2\u05ea Serotonin Syndrome.",
          "isCorrect": false,
          "rationale": "Dantrolene \u05d0\u05d9\u05e0\u05d5 \u05e4\u05d5\u05e2\u05dc \u05e2\u05dc \u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05e1\u05e8\u05d5\u05d8\u05d5\u05e0\u05d9\u05df; \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Cyproheptadine \u05d4\u05d5\u05d0 \u05d4\u05de\u05d9\u05d5\u05e2\u05d3 \u05dc\u05db\u05da (DSM p.812)."
        },
        {
