{
  "title": "NMS Flashcards",
  "cards": [
    {
      "front": "\u05de\u05d4\u05d5 \u05d7\u05dc\u05d5\u05df \u05d4\u05d6\u05de\u05e0\u05d9\u05dd \u05d4\u05d8\u05d9\u05e4\u05d5\u05e1\u05d9 \u05dc\u05d7\u05e9\u05d9\u05e4\u05d4 \u05dc-Dopamine Antagonist \u05dc\u05e4\u05e0\u05d9 \u05d4\u05d5\u05e4\u05e2\u05ea \u05ea\u05e1\u05de\u05d9\u05e0\u05d9 NMS?",
      "back": "\u05d7\u05e9\u05d9\u05e4\u05d4 \u05d1-72 \u05d4\u05e9\u05e2\u05d5\u05ea \u05e9\u05e7\u05d3\u05de\u05d5 \u05dc\u05ea\u05d7\u05d9\u05dc\u05ea \u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd (DSM p.810)."
    },
    {
      "front": "\u05dc\u05e4\u05d9 \u05d4-DSM-5-TR, \u05de\u05d4\u05d5 \u05e8\u05e3 \u05d4\u05d7\u05d5\u05dd \u05d4\u05de\u05d5\u05d2\u05d3\u05e8 \u05db\u05d4\u05d9\u05e4\u05e8\u05ea\u05e8\u05de\u05d9\u05d4 \u05d1\u05d0\u05d1\u05d7\u05e0\u05ea NMS?",
      "back": "\u05d7\u05d5\u05dd \u05d2\u05d5\u05e3 \u05e9\u05dc \u05de\u05e2\u05dc $38.0^{\\circ}C$ (\u05d0\u05d5 $100.4^{\\circ}F$) \u05d1\u05e9\u05ea\u05d9 \u05de\u05d3\u05d9\u05d3\u05d5\u05ea \u05e0\u05e4\u05e8\u05d3\u05d5\u05ea \u05dc\u05e4\u05d7\u05d5\u05ea (DSM p.810)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9 \u05d4\u05de\u05d1\u05d3\u05d9\u05dc (Distinguishing feature) \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05d1\u05d9\u05df NMS \u05dc\u05d1\u05d9\u05df EPS \u05d0\u05d7\u05e8\u05d9\u05dd \u05e9\u05dc \u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05d0\u05e0\u05d8\u05d9-\u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9\u05d5\u05ea?",
      "back": "\u05d4\u05d9\u05e4\u05e8\u05ea\u05e8\u05de\u05d9\u05d4 \u05d4\u05de\u05dc\u05d5\u05d5\u05d4 \u05d1-Profuse Diaphoresis (\u05d6\u05d9\u05e2\u05d4 \u05e9\u05d5\u05e4\u05e2\u05ea) (DSM p.810)."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05de\u05ea\u05d5\u05d0\u05e8\u05ea \u05e7\u05e9\u05d9\u05d7\u05d5\u05ea \u05d4\u05e9\u05e8\u05d9\u05e8\u05d9\u05dd \u05d1-NMS \u05d1\u05e6\u05d5\u05e8\u05ea\u05d4 \u05d4\u05d7\u05de\u05d5\u05e8\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8?",
      "back": "\u05e7\u05e9\u05d9\u05d7\u05d5\u05ea \"\u05e6\u05d9\u05e0\u05d5\u05e8 \u05e2\u05d5\u05e4\u05e8\u05ea\" (Lead-pipe Rigidity) (DSM p.810)."
    },
    {
      "front": "\u05de\u05d4\u05dd \u05d4\u05de\u05d3\u05d3\u05d9\u05dd \u05d4\u05db\u05de\u05d5\u05ea\u05d9\u05d9\u05dd \u05dc\u05d4\u05d2\u05d3\u05e8\u05ea Tachycardia \u05d5-Tachypnea \u05db\u05d7\u05dc\u05e7 \u05de\u05d0\u05d9-\u05d9\u05e6\u05d9\u05d1\u05d5\u05ea \u05d0\u05d5\u05d8\u05d5\u05e0\u05d5\u05de\u05d9\u05ea \u05d1-NMS?",
      "back": "Tachycardia \u05de\u05e2\u05dc $25\\%$ \u05d5-Tachypnea \u05de\u05e2\u05dc $50\\%$ \u05de\u05e2\u05dc \u05e2\u05e8\u05da \u05d4\u05d1\u05e1\u05d9\u05e1 (Baseline) (DSM p.810)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05e2\u05e8\u05da \u05d4\u05de\u05d9\u05e0\u05d9\u05de\u05dc\u05d9 \u05e9\u05dc Creatine Kinase (CK) \u05d4\u05ea\u05d5\u05de\u05da \u05d1\u05d0\u05d1\u05d7\u05e0\u05ea NMS?",
      "back": "\u05e2\u05dc\u05d9\u05d9\u05d4 \u05e9\u05dc \u05dc\u05e4\u05d7\u05d5\u05ea \u05e4\u05d9 4 \u05de\u05d4\u05d2\u05d1\u05d5\u05dc \u05d4\u05e2\u05dc\u05d9\u05d5\u05df \u05e9\u05dc \u05d4\u05e0\u05d5\u05e8\u05de\u05d4 ($\\ge 4 \\times ULN$) (DSM p.810)."
    },
    {
      "front": "\u05d0\u05d9\u05d6\u05d4 \u05e9\u05d9\u05e0\u05d5\u05d9 \u05d1\u05e8\u05de\u05ea \u05d4\u05d1\u05e8\u05d6\u05dc (Serum Iron) \u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05d9 \u05dc\u05e9\u05dc\u05d1 \u05d4\u05d7\u05e8\u05d9\u05e3 \u05e9\u05dc NMS?",
      "back": "\u05d9\u05e8\u05d9\u05d3\u05d4 \u05d1\u05e8\u05de\u05ea \u05d4\u05d1\u05e8\u05d6\u05dc \u05d1\u05e1\u05e8\u05d5\u05dd (Decreased Serum Iron) (DSM p.810)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05e4\u05ea\u05d5\u05e4\u05d9\u05d6\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d4\u05de\u05e9\u05d5\u05e2\u05e8 \u05e9\u05dc NMS \u05dc\u05e4\u05d9 StahlNeuro?",
      "back": "\u05d7\u05e1\u05d9\u05de\u05ea \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 D2 \u05d1\u05de\u05e1\u05dc\u05d5\u05dc \u05d4-Nigrostriatal \u05d5\u05d1\u05d4\u05d9\u05e4\u05d5\u05ea\u05dc\u05de\u05d5\u05e1 (StahlNeuro p.169)."
    },
    {
      "front": "\u05d1\u05d0\u05d1\u05d7\u05e0\u05d4 \u05de\u05d1\u05d3\u05dc\u05ea \u05d1\u05d9\u05df Serotonin Syndrome \u05dc-NMS, \u05d0\u05d9\u05dc\u05d5 \u05de\u05de\u05e6\u05d0\u05d9\u05dd \u05de\u05d5\u05d8\u05d5\u05e8\u05d9\u05d9\u05dd \u05de\u05db\u05d5\u05d5\u05e0\u05d9\u05dd \u05dc\u05e1\u05e8\u05d5\u05d8\u05d5\u05e0\u05d9\u05df?",
      "back": "\u05d4\u05d9\u05e4\u05e8-\u05e8\u05e4\u05dc\u05e7\u05e1\u05d9\u05d4 \u05de\u05d5\u05d3\u05d2\u05e9\u05ea (Hyperreflexia) \u05d5\u05e0\u05d5\u05db\u05d7\u05d5\u05ea Clonus (DSM p.812)."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05e0\u05d1\u05d3\u05d9\u05dc \u05d1\u05d9\u05df Malignant Catatonia \u05dc-NMS \u05de\u05d1\u05d7\u05d9\u05e0\u05ea \u05d4\u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4 \u05d4\u05ea\u05e8\u05d5\u05e4\u05ea\u05d9\u05ea?",
      "back": "\u05d1\u05e7\u05d8\u05d8\u05d5\u05e0\u05d9\u05d4 \u05de\u05de\u05d0\u05d9\u05e8\u05d4 \u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05de\u05d5\u05e4\u05d9\u05e2\u05d9\u05dd \u05dc\u05e4\u05e0\u05d9 \u05d4\u05d7\u05e9\u05d9\u05e4\u05d4 \u05dc\u05d7\u05d5\u05e1\u05dd D2 (DSM p.811)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05d4\u05d1\u05d3\u05dc \u05d1\u05de\u05e6\u05d1 \u05d4\u05d0\u05d9\u05e9\u05d5\u05e0\u05d9\u05dd \u05d5\u05d4\u05e2\u05d5\u05e8 \u05d1\u05d9\u05df Anticholinergic Toxicity \u05dc\u05d1\u05d9\u05df NMS?",
      "back": "\u05d1\u05d4\u05e8\u05e2\u05dc\u05d4 \u05d0\u05e0\u05d8\u05d9\u05db\u05d5\u05dc\u05d9\u05e0\u05e8\u05d2\u05d9\u05ea \u05d4\u05e2\u05d5\u05e8 \u05d9\u05d1\u05e9 (Anhidrosis) \u05d5\u05d4\u05d0\u05d9\u05e9\u05d5\u05e0\u05d9\u05dd \u05de\u05d5\u05e8\u05d7\u05d1\u05d9\u05dd \u05de\u05d0\u05d5\u05d3, \u05d1\u05e0\u05d9\u05d2\u05d5\u05d3 \u05dc\u05d6\u05d9\u05e2\u05d4 \u05d4\u05e9\u05d5\u05e4\u05e2\u05ea \u05d1-NMS (DSM p.811)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05e6\u05e2\u05d3 \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc\u05d9 \u05d4\u05de\u05d9\u05d9\u05d3\u05d9 \u05d5\u05d4\u05e7\u05e8\u05d9\u05d8\u05d9 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d1\u05db\u05dc \u05de\u05e7\u05e8\u05d4 \u05e9\u05dc \u05d7\u05e9\u05d3 \u05dc-NMS?",
      "back": "\u05d4\u05e4\u05e1\u05e7\u05d4 \u05de\u05d9\u05d9\u05d3\u05d9\u05ea \u05e9\u05dc \u05db\u05dc \u05d7\u05d5\u05e1\u05de\u05d9 \u05d4\u05d3\u05d5\u05e4\u05de\u05d9\u05df (Stop Offending Drug) (StahlNeuro p.169)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05e4\u05e2\u05d5\u05dc\u05d4 \u05e9\u05dc Dantrolene \u05d1\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-NMS?",
      "back": "\u05de\u05e8\u05e4\u05d4 \u05e9\u05e8\u05d9\u05e8\u05d9\u05dd \u05d4\u05e4\u05d5\u05e2\u05dc \u05d1\u05d0\u05d5\u05e4\u05df \u05d4\u05d9\u05e7\u05e4\u05d9 (Peripheral muscle relaxant) (StahlNeuro p.169)."
    },
    {
      "front": "\u05de\u05d3\u05d5\u05e2 \u05de\u05e9\u05ea\u05de\u05e9\u05d9\u05dd \u05d1-Bromocriptine \u05d1\u05e0\u05d9\u05d4\u05d5\u05dc NMS?",
      "back": "\u05db\u05d3\u05d9 \u05dc\u05e9\u05de\u05e9 \u05db-D2 Agonist \u05d5\u05dc\u05d4\u05ea\u05d2\u05d1\u05e8 \u05e2\u05dc \u05d4\u05d7\u05e1\u05d9\u05de\u05d4 \u05d4\u05d3\u05d5\u05e4\u05de\u05d9\u05e0\u05e8\u05d2\u05d9\u05ea (StahlNeuro p.169)."
    },
    {
      "front": "\u05d0\u05d9\u05d6\u05d4 \u05e1\u05d9\u05db\u05d5\u05df \u05d9\u05d9\u05d7\u05d5\u05d3\u05d9 \u05e7\u05d9\u05d9\u05dd \u05d1\u05e9\u05d9\u05dc\u05d5\u05d1 Lithium \u05d5\u05ea\u05e8\u05d5\u05e4\u05d4 \u05d0\u05e0\u05d8\u05d9-\u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9\u05ea \u05d1\u05d0\u05d5\u05db\u05dc\u05d5\u05e1\u05d9\u05d9\u05ea \u05d9\u05dc\u05d3\u05d9\u05dd?",
      "back": "\u05e4\u05d9\u05ea\u05d5\u05d7 Encephalopathic syndrome \u05d4\u05d3\u05d5\u05de\u05d4 \u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05dc-NMS (StahlKids p.100)."
    },
    {
      "front": "\u05d1\u05d7\u05d3\u05e8 \u05de\u05d9\u05d5\u05df \u05e4\u05d3\u05d9\u05d0\u05d8\u05e8\u05d9, \u05de\u05d4\u05d5 \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05de\u05d5\u05de\u05dc\u05e5 \u05dc-Agitation \u05d1\u05de\u05e7\u05e8\u05d4 \u05e9\u05dc \u05d7\u05e9\u05d3 \u05dc-NMS \u05d0\u05d5 Delirium?",
      "back": "\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1-Benzodiazepines (\u05db\u05d2\u05d5\u05df Lorazepam) \u05d0\u05d5 Diphenhydramine, \u05d5\u05d4\u05d9\u05de\u05e0\u05e2\u05d5\u05ea \u05de\u05e0\u05d5\u05d2\u05d3\u05d9 \u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d4 (Dulcan p.612)."
    },
    {
      "front": "\u05db\u05de\u05d4 \u05d6\u05de\u05df \u05de\u05d5\u05de\u05dc\u05e5 \u05dc\u05d4\u05de\u05ea\u05d9\u05df \u05dc\u05e4\u05e0\u05d9 \u05d1\u05d9\u05e6\u05d5\u05e2 Rechallenge \u05e9\u05dc \u05d8\u05d9\u05e4\u05d5\u05dc \u05d0\u05e0\u05d8\u05d9-\u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9 \u05dc\u05d0\u05d7\u05e8 \u05d0\u05d9\u05e8\u05d5\u05e2 NMS?",
      "back": "\u05d4\u05de\u05ea\u05e0\u05d4 \u05e9\u05dc \u05dc\u05e4\u05d7\u05d5\u05ea 2\u20133 \u05e9\u05d1\u05d5\u05e2\u05d5\u05ea (DSM p.811)."
    },
    {
      "front": "\u05de\u05d4\u05dd \u05d4\u05de\u05de\u05e6\u05d0\u05d9\u05dd \u05d4\u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05d9\u05d9\u05dd \u05d1\u05d1\u05d3\u05d9\u05e7\u05d5\u05ea CSF \u05d5\u05d3\u05d9\u05de\u05d5\u05ea \u05de\u05d5\u05d7\u05d9 (CT/MRI) \u05d1-NMS?",
      "back": "\u05d4\u05d1\u05d3\u05d9\u05e7\u05d5\u05ea \u05ea\u05e7\u05d9\u05e0\u05d5\u05ea \u05dc\u05d7\u05dc\u05d5\u05d8\u05d9\u05df, \u05d5\u05de\u05e9\u05de\u05e9\u05d5\u05ea \u05d1\u05e2\u05d9\u05e7\u05e8 \u05dc\u05e9\u05dc\u05d9\u05dc\u05ea \u05d6\u05d9\u05d4\u05d5\u05de\u05d9\u05dd \u05d0\u05d5 \u05d0\u05d9\u05e8\u05d5\u05e2\u05d9\u05dd \u05d5\u05e1\u05e7\u05d5\u05dc\u05e8\u05d9\u05d9\u05dd (DSM p.810)."
    }
  ]
}