      "question": "\u05e0\u05e2\u05e8\u05d4 \u05d1\u05ea 17 \u05de\u05d3\u05d5\u05d5\u05d7\u05ea \u05e2\u05dc \u05e4\u05d7\u05d3 \u05e2\u05d6 \u05d5\u05d7\u05e8\u05d3\u05d4 \u05dc\u05e7\u05e8\u05d0\u05ea \u05e7\u05d9\u05d5\u05dd \u05d9\u05d7\u05e1\u05d9 \u05de\u05d9\u05df \u05d4\u05db\u05d5\u05dc\u05dc\u05d9\u05dd \u05d7\u05d3\u05d9\u05e8\u05d4 \u05d5\u05d2\u05d9\u05e0\u05dc\u05d9\u05ea, \u05d5\u05de\u05ea\u05d0\u05e8\u05ea \u05db\u05d0\u05d1 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9 \u05d1\u05e0\u05d9\u05e1\u05d9\u05d5\u05e0\u05d5\u05ea \u05e7\u05d5\u05d3\u05de\u05d9\u05dd. \u05d1\u05d1\u05d3\u05d9\u05e7\u05d4 \u05d2\u05d5\u05e4\u05e0\u05d9\u05ea \u05e0\u05e9\u05dc\u05dc\u05d5 \u05de\u05de\u05e6\u05d0\u05d9\u05dd \u05d0\u05d5\u05e8\u05d2\u05e0\u05d9\u05d9\u05dd. \u05de\u05d4\u05d9 \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05de\u05ea\u05d0\u05d9\u05de\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR?",
      "answerOptions": [
        {
          "text": "Genito-Pelvic Pain/Penetration Disorder (F52.6)",
          "isCorrect": true,
          "rationale": "\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d6\u05d5 \u05de\u05d0\u05d7\u05d3\u05ea \u05db\u05d0\u05d1 \u05d2\u05e0\u05d9\u05d8\u05dc\u05d9 \u05d5\u05d7\u05e8\u05d3\u05d4 \u05de\u05e4\u05e0\u05d9 \u05d7\u05d3\u05d9\u05e8\u05d4 \u05d5\u05d2\u05d9\u05e0\u05dc\u05d9\u05ea \u05e9\u05e0\u05de\u05e9\u05db\u05d9\u05dd \u05dc\u05e4\u05d7\u05d5\u05ea 6 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05d5\u05d2\u05d5\u05e8\u05de\u05d9\u05dd \u05dc\u05de\u05e6\u05d5\u05e7\u05d4, \u05d1\u05d4\u05d9\u05e2\u05d3\u05e8 \u05d2\u05d5\u05e8\u05dd \u05d0\u05d5\u05e8\u05d2\u05e0\u05d9 \u05de\u05d5\u05d1\u05d4\u05e7 (DSM p.493)."
        },
        {
          "text": "Specific Phobia, situational type",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05e9\u05e7\u05d9\u05d9\u05de\u05ea \u05d7\u05e8\u05d3\u05d4, \u05db\u05d0\u05e9\u05e8 \u05d4\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05de\u05de\u05d5\u05e7\u05d3\u05d9\u05dd \u05e1\u05d1\u05d9\u05d1 \u05db\u05d0\u05d1 \u05d5\u05d7\u05d3\u05d9\u05e8\u05d4 \u05d5\u05d2\u05d9\u05e0\u05dc\u05d9\u05ea, \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05ea \u05d1-DSM-5 \u05d4\u05d9\u05d0 GPPPD \u05d5\u05dc\u05d0 \u05e4\u05d5\u05d1\u05d9\u05d4 (DSM p.498)."
        },
        {
          "text": "Female Sexual Interest/Arousal Disorder (F52.22)",
          "isCorrect": false,
          "rationale": "\u05d4\u05e4\u05e8\u05e2\u05d4 \u05d6\u05d5 \u05de\u05ea\u05de\u05e7\u05d3\u05ea \u05d1\u05d7\u05d5\u05e1\u05e8 \u05e2\u05e0\u05d9\u05d9\u05df \u05d0\u05d5 \u05e2\u05d5\u05e8\u05e8\u05d5\u05ea, \u05d1\u05e2\u05d5\u05d3 \u05e9\u05d1\u05de\u05e7\u05e8\u05d4 \u05d6\u05d4 \u05d4\u05d1\u05e2\u05d9\u05d4 \u05d4\u05de\u05e8\u05db\u05d6\u05d9\u05ea \u05d4\u05d9\u05d0 \u05db\u05d0\u05d1 \u05d5\u05e4\u05d7\u05d3 \u05de\u05d7\u05d3\u05d9\u05e8\u05d4 (DSM p.489)."
        },
        {
          "text": "Somatic Symptom Disorder",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05e9\u05d9\u05e9 \u05de\u05e8\u05db\u05d9\u05d1 \u05e1\u05d5\u05de\u05d8\u05d9, \u05d4-DSM \u05de\u05d2\u05d3\u05d9\u05e8 \u05d4\u05e4\u05e8\u05e2\u05d4 \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05ea \u05dc\u05ea\u05e4\u05e7\u05d5\u05d3 \u05d4\u05de\u05d9\u05e0\u05d9 \u05d1\u05de\u05e6\u05d1\u05d9\u05dd \u05d0\u05dc\u05d5, \u05d5\u05d9\u05e9 \u05dc\u05d4\u05e2\u05d3\u05d9\u05e3 \u05d0\u05d5\u05ea\u05d4 \u05e2\u05dc \u05e4\u05e0\u05d9 \u05d0\u05d1\u05d7\u05e0\u05d4 \u05e1\u05d5\u05de\u05d8\u05d9\u05ea \u05db\u05dc\u05dc\u05d9\u05ea (DSM p.498)."
        }
      ],
      "hint": "\u05d4-DSM-5 \u05d0\u05d9\u05d7\u05d3 \u05d0\u05ea \u05d4\u05d0\u05d1\u05d7\u05e0\u05d5\u05ea \u05e9\u05dc Vaginismus \u05d5-Dyspareunia \u05dc\u05d4\u05e4\u05e8\u05e2\u05d4 \u05d0\u05d7\u05ea.",
      "imageUrls": []
    },
    {
      "type": "multiple_select",
      "question": "\u05d0\u05d9\u05dc\u05d5 \u05de\u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05d4\u05d1\u05d0\u05d9\u05dd \u05d4\u05db\u05e8\u05d7\u05d9\u05d9\u05dd \u05dc\u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc Pedophilic Disorder (F65.4) \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR?",
      "answerOptions": [
        {
          "text": "\u05d4\u05d0\u05d3\u05dd \u05d4\u05d5\u05d0 \u05d1\u05df 16 \u05dc\u05e4\u05d7\u05d5\u05ea \u05d5\u05de\u05d1\u05d5\u05d2\u05e8 \u05d1-5 \u05e9\u05e0\u05d9\u05dd \u05dc\u05e4\u05d7\u05d5\u05ea \u05de\u05d4\u05d9\u05dc\u05d3/\u05d9\u05dd.",
          "isCorrect": true,
          "rationale": "\u05d6\u05d4\u05d5 \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df \u05d2\u05d9\u05dc \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9 (Criterion C) \u05e9\u05e0\u05d5\u05e2\u05d3 \u05dc\u05d4\u05d1\u05d7\u05d9\u05df \u05d1\u05d9\u05df \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05de\u05d9\u05e0\u05d9\u05ea \u05ea\u05d5\u05d0\u05de\u05ea \u05d2\u05d9\u05dc \u05d1\u05d9\u05df \u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd \u05dc\u05d1\u05d9\u05df \u05d4\u05e4\u05e8\u05e2\u05d4 \u05e4\u05d3\u05d5\u05e4\u05d9\u05dc\u05d9\u05ea (DSM p.793)."
        },
        {
          "text": "\u05e2\u05d5\u05e8\u05e8\u05d5\u05ea \u05de\u05d9\u05e0\u05d9\u05ea \u05d0\u05d9\u05e0\u05d8\u05e0\u05e1\u05d9\u05d1\u05d9\u05ea \u05d5\u05d7\u05d5\u05d6\u05e8\u05ea \u05de\u05e4\u05e0\u05d8\u05d6\u05d9\u05d5\u05ea \u05d0\u05d5 \u05d3\u05d7\u05e4\u05d9\u05dd \u05d4\u05de\u05e2\u05e8\u05d1\u05d9\u05dd \u05d9\u05dc\u05d3\u05d9\u05dd (\u05d1\u05d3\u05e8\u05da \u05db\u05dc\u05dc \u05d1\u05e0\u05d9 13 \u05d5\u05de\u05d8\u05d4).",
          "isCorrect": true,
          "rationale": "\u05d6\u05d4\u05d5 Criterion A \u05d4\u05de\u05d2\u05d3\u05d9\u05e8 \u05d0\u05ea \u05d4\u05de\u05d5\u05e7\u05d3 \u05d4\u05e4\u05e8\u05e4\u05d9\u05dc\u05d9 \u05e9\u05dc \u05d4\u05d4\u05e4\u05e8\u05e2\u05d4 (DSM p.792)."
        },
        {
          "text": "\u05d4\u05d0\u05d3\u05dd \u05e4\u05e2\u05dc \u05e2\u05dc \u05d4\u05d3\u05d7\u05e4\u05d9\u05dd \u05e2\u05dd \u05d9\u05dc\u05d3, \u05d0\u05d5 \u05e9\u05d4\u05d3\u05d7\u05e4\u05d9\u05dd \u05d2\u05d5\u05e8\u05de\u05d9\u05dd \u05dc\u05de\u05e6\u05d5\u05e7\u05d4 \u05e0\u05d9\u05db\u05e8\u05ea \u05d0\u05d5 \u05e7\u05d5\u05e9\u05d9 \u05d1\u05d9\u05e0\u05d0\u05d9\u05e9\u05d9.",
          "isCorrect": true,
          "rationale": "\u05d6\u05d4\u05d5 Criterion B \u05d4\u05de\u05d1\u05d3\u05d9\u05dc \u05d1\u05d9\u05df \u05e2\u05e0\u05d9\u05d9\u05df \u05e4\u05d3\u05d5\u05e4\u05d9\u05dc\u05d9 \u05dc\u05d1\u05d9\u05df \u05d4\u05e4\u05e8\u05e2\u05d4 \u05e4\u05d3\u05d5\u05e4\u05d9\u05dc\u05d9\u05ea (DSM p.792)."
        },
        {
          "text": "\u05d4\u05d0\u05d3\u05dd \u05e1\u05d5\u05d1\u05dc \u05de\u05d4\u05e4\u05e8\u05e2\u05ea \u05d0\u05d9\u05e9\u05d9\u05d5\u05ea \u05d0\u05e0\u05d8\u05d9-\u05e1\u05d5\u05e6\u05d9\u05d0\u05dc\u05d9\u05ea \u05e0\u05dc\u05d5\u05d5\u05d9\u05ea.",
          "isCorrect": false,
          "rationale": "\u05d0\u05de\u05e0\u05dd \u05e7\u05d9\u05d9\u05de\u05ea \u05e7\u05d5\u05de\u05d5\u05e8\u05d1\u05d9\u05d3\u05d9\u05d5\u05ea \u05d1\u05d7\u05dc\u05e7 \u05de\u05d4\u05de\u05e7\u05e8\u05d9\u05dd, \u05d0\u05da \u05d6\u05d5 \u05d0\u05d9\u05e0\u05d4 \u05d3\u05e8\u05d9\u05e9\u05d4 \u05d0\u05d1\u05d7\u05e0\u05ea\u05d9\u05ea \u05dc\u05d4\u05e4\u05e8\u05e2\u05d4 \u05e4\u05d3\u05d5\u05e4\u05d9\u05dc\u05d9\u05ea (DSM p.792)."
        }
      ],
      "hint": "\u05d4\u05ea\u05de\u05e7\u05d3 \u05d1\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05d4\u05de\u05d2\u05d3\u05d9\u05e8\u05d9\u05dd \u05d0\u05ea \u05d2\u05d9\u05dc \u05d4\u05de\u05d0\u05d1\u05d7\u05df, \u05d2\u05d9\u05dc \u05d4\u05e7\u05d5\u05e8\u05d1\u05df \u05d5\u05d4\u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05e9\u05dc \u05de\u05e6\u05d5\u05e7\u05d4 \u05d0\u05d5 \u05e4\u05e2\u05d5\u05dc\u05d4.",
      "hasAllOfTheAbove": false,
      "hasNoneOfTheAbove": false
    },
    {
      "type": "short_answer",
      "question": "\u05d4\u05e1\u05d1\u05e8 \u05d1\u05e7\u05e6\u05e8\u05d4 \u05d0\u05ea \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05e4\u05e1\u05d9\u05db\u05d5\u05e4\u05e8\u05de\u05e7\u05d5\u05dc\u05d5\u05d2\u05d9 \u05e9\u05dc GnRH agonists (\u05db\u05d2\u05d5\u05df Leuprolide) \u05d1\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Paraphilic Disorders \u05d7\u05de\u05d5\u05e8\u05d5\u05ea, \u05d5\u05de\u05d4\u05d9 \u05d4\u05ea\u05d5\u05e4\u05e2\u05d4 \u05d4\u05de\u05ea\u05e8\u05d7\u05e9\u05ea \u05d1\u05ea\u05d7\u05d9\u05dc\u05ea \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc?",
      "grading": {
        "modelAnswer": "\u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05d0\u05dc\u05d5 \u05d2\u05d5\u05e8\u05de\u05d5\u05ea \u05d1\u05d4\u05ea\u05d7\u05dc\u05d4 \u05dc\u05e2\u05dc\u05d9\u05d9\u05d4 \u05d7\u05d5\u05dc\u05e4\u05ea (Flare) \u05d1\u05e8\u05de\u05d5\u05ea \u05d4-LH \u05d5\u05d4-FSH, \u05d0\u05da \u05d1\u05e9\u05d9\u05de\u05d5\u05e9 \u05de\u05de\u05d5\u05e9\u05da \u05d4\u05df \u05de\u05d5\u05d1\u05d9\u05dc\u05d5\u05ea \u05dc-Down-regulation \u05d5\u05d3\u05e1\u05e0\u05e1\u05d9\u05d8\u05d9\u05d6\u05e6\u05d9\u05d4 \u05e9\u05dc \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 \u05d4-GnRH \u05d1\u05d4\u05d9\u05e4\u05d5\u05e4\u05d9\u05d6\u05d4. \u05d4\u05ea\u05d5\u05e6\u05d0\u05d4 \u05d4\u05d9\u05d0 \u05d3\u05d9\u05db\u05d5\u05d9 \u05e2\u05de\u05d5\u05e7 \u05e9\u05dc \u05e6\u05d9\u05e8 \u05d4\u05d2\u05d5\u05e0\u05d3\u05d5\u05ea \u05d5\u05d9\u05e8\u05d9\u05d3\u05d4 \u05d1\u05e8\u05de\u05d5\u05ea \u05d4-Testosterone \u05dc\u05e8\u05de\u05d4 \u05e1\u05d9\u05e8\u05d5\u05e1\u05d9\u05ea (Chemical Castration), \u05de\u05d4 \u05e9\u05de\u05e4\u05d7\u05d9\u05ea \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05d3\u05d7\u05e4\u05d9\u05dd \u05d5\u05e4\u05e0\u05d8\u05d6\u05d9\u05d5\u05ea \u05de\u05d9\u05e0\u05d9\u05d5\u05ea.",
        "rationale": "\u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05de\u05d1\u05d5\u05e1\u05e1 \u05e2\u05dc \u05de\u05e0\u05d9\u05e4\u05d5\u05dc\u05e6\u05d9\u05d4 \u05e9\u05dc \u05e6\u05d9\u05e8 \u05d4-HPG \u05db\u05d3\u05d9 \u05dc\u05d4\u05d5\u05e8\u05d9\u05d3 \u05d0\u05ea \u05e8\u05de\u05d5\u05ea \u05d4\u05d8\u05e1\u05d8\u05d5\u05e1\u05d8\u05e8\u05d5\u05df, \u05d4\u05de\u05d4\u05d5\u05d5\u05d4 \u05d3\u05dc\u05e7 \u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05dc\u05d3\u05d7\u05e4\u05d9\u05dd \u05d4\u05de\u05d9\u05e0\u05d9\u05d9\u05dd (StahlNeuro p.539; Dulcan p.575).",
        "requiredAttributes": [
          "\u05e6\u05d9\u05d5\u05df \u05d4-Down-regulation \u05d0\u05d5 \u05d3\u05e1\u05e0\u05e1\u05d9\u05d8\u05d9\u05d6\u05e6\u05d9\u05d4 \u05e9\u05dc \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9\u05dd \u05d1\u05d4\u05d9\u05e4\u05d5\u05e4\u05d9\u05d6\u05d4.",
          "\u05e6\u05d9\u05d5\u05df \u05d4\u05d9\u05e8\u05d9\u05d3\u05d4 \u05d1-Testosterone \u05dc\u05e8\u05de\u05d4 \u05e1\u05d9\u05e8\u05d5\u05e1\u05d9\u05ea/\u05e0\u05de\u05d5\u05db\u05d4 \u05de\u05d0\u05d5\u05d3.",
          "\u05d4\u05ea\u05d9\u05d9\u05d7\u05e1\u05d5\u05ea \u05dc\u05e2\u05dc\u05d9\u05d9\u05d4 \u05d4\u05e8\u05d0\u05e9\u05d5\u05e0\u05d9\u05ea (Flare) \u05d1\u05e8\u05de\u05d5\u05ea \u05d4\u05d4\u05d5\u05e8\u05de\u05d5\u05e0\u05d9\u05dd."
        ],
        "errors": {
          "misconceptions": [
            "\u05de\u05d7\u05e9\u05d1\u05d4 \u05e9\u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 \u05d7\u05d5\u05e1\u05de\u05ea \u05d9\u05e9\u05d9\u05e8\u05d5\u05ea \u05d0\u05ea \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 \u05d4\u05d8\u05e1\u05d8\u05d5\u05e1\u05d8\u05e8\u05d5\u05df (\u05d6\u05d4\u05d5 \u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05e9\u05dc Anti-androgens \u05d0\u05d7\u05e8\u05d9\u05dd)."
