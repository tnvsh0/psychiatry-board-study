{
  "title": "Lithium Quiz",
  "questions": [
    {
      "question": "\u05de\u05ea\u05d1\u05d2\u05e8 \u05d1\u05df 15 \u05d4\u05de\u05d0\u05d5\u05d1\u05d7\u05df \u05e2\u05dd Bipolar I Disorder \u05de\u05d8\u05d5\u05e4\u05dc \u05d1-Lithium \u05d1\u05de\u05d9\u05e0\u05d5\u05df \u05d9\u05e6\u05d9\u05d1 \u05de\u05d6\u05d4 \u05e9\u05e0\u05d4. \u05d1\u05d1\u05d3\u05d9\u05e7\u05ea \u05d3\u05dd \u05ea\u05e7\u05d5\u05e4\u05ea\u05d9\u05ea \u05e0\u05de\u05e6\u05d0\u05d4 \u05e2\u05dc\u05d9\u05d9\u05d4 \u05d1\u05e8\u05de\u05ea \u05d4-Serum Calcium. \u05de\u05d4\u05d5 \u05d4\u05e6\u05e2\u05d3 \u05d4\u05d1\u05d0 \u05d4\u05de\u05d5\u05de\u05dc\u05e5 \u05dc\u05e4\u05d9 \u05d4\u05e1\u05e4\u05e8\u05d5\u05ea \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9\u05ea?",
      "answerOptions": [
        {
          "text": "\u05d1\u05d9\u05e6\u05d5\u05e2 \u05d1\u05d3\u05d9\u05e7\u05ea \u05d3\u05dd \u05dc\u05e8\u05de\u05ea \u05d4\u05e1\u05d9\u05d3\u05df \u05e4\u05e2\u05dd \u05d1\u05e9\u05e0\u05d4 \u05dc\u05d6\u05d9\u05d4\u05d5\u05d9 Hyperparathyroidism.",
          "isCorrect": true,
          "rationale": "\u05e9\u05d9\u05de\u05d5\u05e9 \u05db\u05e8\u05d5\u05e0\u05d9 \u05d1-Lithium \u05e2\u05dc\u05d5\u05dc \u05dc\u05d2\u05e8\u05d5\u05dd \u05dc-Hyperparathyroidism, \u05d5\u05dc\u05db\u05df \u05de\u05d5\u05de\u05dc\u05e5 \u05dc\u05d1\u05d3\u05d5\u05e7 \u05e8\u05de\u05d5\u05ea \u05e1\u05d9\u05d3\u05df \u05d0\u05d7\u05ea \u05dc\u05e9\u05e0\u05d4 (Dulcan p. 765)."
        },
        {
          "text": "\u05d4\u05e4\u05e1\u05e7\u05d4 \u05de\u05d9\u05d9\u05d3\u05d9\u05ea \u05e9\u05dc \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05de\u05d7\u05e9\u05e9 \u05dc-Lithium Toxicity.",
          "isCorrect": false,
          "rationale": "\u05e2\u05dc\u05d9\u05d9\u05ea \u05e1\u05d9\u05d3\u05df \u05d0\u05d9\u05e0\u05d4 \u05e1\u05d9\u05de\u05df \u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05d9 \u05dc-Toxicity \u05d7\u05e8\u05d9\u05e4\u05d4 \u05d0\u05dc\u05d0 \u05ea\u05d5\u05e6\u05d0\u05d4 \u05e9\u05dc \u05d4\u05e9\u05e4\u05e2\u05d4 \u05d0\u05e0\u05d3\u05d5\u05e7\u05e8\u05d9\u05e0\u05d9\u05ea \u05db\u05e8\u05d5\u05e0\u05d9\u05ea (Dulcan p. 765)."
        },
        {
          "text": "\u05de\u05ea\u05df \u05ea\u05d5\u05e1\u05e3 \u05d5\u05d9\u05d8\u05de\u05d9\u05df D \u05dc\u05ea\u05d9\u05e7\u05d5\u05df \u05de\u05d0\u05d6\u05df \u05d4\u05d0\u05dc\u05e7\u05d8\u05e8\u05d5\u05dc\u05d9\u05d8\u05d9\u05dd.",
          "isCorrect": false,
          "rationale": "\u05d4\u05d1\u05e2\u05d9\u05d4 \u05e0\u05d5\u05d1\u05e2\u05ea \u05de\u05d4\u05e9\u05e4\u05e2\u05ea \u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 \u05e2\u05dc \u05d1\u05dc\u05d5\u05d8\u05ea \u05d4\u05e4\u05d0\u05e8\u05d0\u05ea\u05d9\u05e8\u05d5\u05d0\u05d9\u05d3 \u05d5\u05dc\u05d0 \u05de\u05d7\u05e1\u05e8 \u05ea\u05d6\u05d5\u05e0\u05ea\u05d9 (Dulcan p. 765)."
        },
        {
          "text": "\u05d4\u05e4\u05d7\u05ea\u05ea \u05de\u05d9\u05e0\u05d5\u05df \u05d4-Lithium \u05d1-50% \u05d5\u05e0\u05d9\u05d8\u05d5\u05e8 \u05e8\u05de\u05d5\u05ea TSH.",
          "isCorrect": false,
          "rationale": "\u05e0\u05d9\u05d8\u05d5\u05e8 TSH \u05e8\u05dc\u05d5\u05d5\u05e0\u05d8\u05d9 \u05dc\u05ea\u05e4\u05e7\u05d5\u05d3 \u05d1\u05dc\u05d5\u05d8\u05ea \u05d4\u05ea\u05e8\u05d9\u05e1, \u05d1\u05e2\u05d5\u05d3 \u05e9\u05e1\u05d9\u05d3\u05df \u05e7\u05e9\u05d5\u05e8 \u05dc\u05d1\u05dc\u05d5\u05d8\u05ea \u05d4\u05e4\u05d0\u05e8\u05d0\u05ea\u05d9\u05e8\u05d5\u05d0\u05d9\u05d3 (Dulcan p. 765)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05d4\u05e9\u05e4\u05e2\u05d4 \u05d0\u05e8\u05d5\u05db\u05ea \u05d4\u05d8\u05d5\u05d5\u05d7 \u05e9\u05dc \u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 \u05e2\u05dc \u05d1\u05dc\u05d5\u05d8\u05d5\u05ea \u05e9\u05d0\u05d7\u05e8\u05d0\u05d9\u05d5\u05ea \u05e2\u05dc \u05de\u05e9\u05e7 \u05d4\u05de\u05d9\u05e0\u05e8\u05dc\u05d9\u05dd."
    },
    {
      "question": "\u05d9\u05dc\u05d3 \u05d1\u05df 10 \u05de\u05d0\u05d5\u05e9\u05e4\u05d6 \u05e2\u05e7\u05d1 Acute Mania \u05d5\u05de\u05ea\u05d7\u05d9\u05dc \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Lithium Carbonate. \u05dc\u05d0\u05d7\u05e8 \u05d4\u05d2\u05e2\u05d4 \u05dc\u05de\u05d9\u05e0\u05d5\u05df \u05e9\u05dc $30\\text{ mg/kg/day}$ \u05d1\u05e9\u05ea\u05d9 \u05de\u05e0\u05d5\u05ea \u05de\u05d7\u05d5\u05dc\u05e7\u05d5\u05ea, \u05de\u05ea\u05d9 \u05d9\u05e9 \u05dc\u05d1\u05e6\u05e2 \u05d1\u05d3\u05d9\u05e7\u05ea \u05e8\u05de\u05ea \u05ea\u05e8\u05d5\u05e4\u05d4 \u05d1\u05d3\u05dd (Trough level)?",
      "answerOptions": [
        {
          "text": "\u05d1\u05d3\u05d9\u05d5\u05e7 12 \u05e9\u05e2\u05d5\u05ea \u05dc\u05d0\u05d7\u05e8 \u05e0\u05d8\u05d9\u05dc\u05ea \u05d4\u05de\u05e0\u05d4 \u05d4\u05d0\u05d7\u05e8\u05d5\u05e0\u05d4.",
          "isCorrect": true,
          "rationale": "\u05e8\u05de\u05d5\u05ea \u05d4-Steady state \u05d1\u05d3\u05dd \u05e0\u05de\u05d3\u05d3\u05d5\u05ea \u05db-Trough level \u05db-12 \u05e9\u05e2\u05d5\u05ea \u05dc\u05d0\u05d7\u05e8 \u05d4\u05de\u05e0\u05d4 \u05d4\u05d0\u05d7\u05e8\u05d5\u05e0\u05d4 (Dulcan p. 767, StahlKids p. 288)."
        },
        {
          "text": "\u05e9\u05e2\u05ea\u05d9\u05d9\u05dd \u05dc\u05d0\u05d7\u05e8 \u05d4\u05de\u05e0\u05d4 \u05d4\u05e8\u05d0\u05e9\u05d5\u05e0\u05d4 \u05db\u05d3\u05d9 \u05dc\u05d1\u05d3\u05d5\u05e7 Peak level.",
          "isCorrect": false,
          "rationale": "\u05d1\u05d3\u05d9\u05e7\u05d4 \u05dc\u05d0\u05d7\u05e8 \u05e9\u05e2\u05ea\u05d9\u05d9\u05dd \u05de\u05d5\u05d3\u05d3\u05ea \u05e9\u05d9\u05d0 \u05e1\u05e4\u05d9\u05d2\u05d4 \u05d5\u05dc\u05d0 \u05e8\u05de\u05ea \u05e9\u05e4\u05dc \u05ea\u05e8\u05e4\u05d5\u05d9\u05d8\u05d9\u05ea (StahlKids p. 289)."
        },
        {
          "text": "\u05d1\u05db\u05dc \u05d1\u05d5\u05e7\u05e8 \u05dc\u05e4\u05e0\u05d9 \u05e0\u05d8\u05d9\u05dc\u05ea \u05d4\u05de\u05e0\u05d4, \u05dc\u05dc\u05d0 \u05e7\u05e9\u05e8 \u05dc\u05d6\u05de\u05df \u05d4\u05de\u05e0\u05d4 \u05d1\u05e2\u05e8\u05d1.",
          "isCorrect": false,
          "rationale": "\u05d4\u05ea\u05d6\u05de\u05d5\u05df \u05d4\u05de\u05d3\u05d5\u05d9\u05e7 \u05e9\u05dc 12 \u05e9\u05e2\u05d5\u05ea \u05d4\u05d5\u05d0 \u05e7\u05e8\u05d9\u05d8\u05d9 \u05dc\u05d3\u05d9\u05d5\u05e7 \u05d4\u05de\u05d3\u05d9\u05d3\u05d4 \u05d5\u05d4\u05e9\u05d5\u05d5\u05d0\u05d4 \u05dc\u05d8\u05d5\u05d5\u05d7 \u05d4\u05ea\u05e8\u05e4\u05d5\u05d9\u05d8\u05d9 (Dulcan p. 767)."
        },
        {
          "text": "24 \u05e9\u05e2\u05d5\u05ea \u05dc\u05d0\u05d7\u05e8 \u05d4\u05de\u05e0\u05d4 \u05d4\u05d0\u05d7\u05e8\u05d5\u05e0\u05d4 \u05db\u05d3\u05d9 \u05dc\u05d5\u05d5\u05d3\u05d0 \u05e4\u05d9\u05e0\u05d5\u05d9 \u05db\u05dc\u05d9\u05d9\u05ea\u05d9.",
          "isCorrect": false,
          "rationale": "\u05d1\u05d3\u05d9\u05e7\u05d4 \u05dc\u05d0\u05d7\u05e8 24 \u05e9\u05e2\u05d5\u05ea \u05d1\u05de\u05d9\u05e0\u05d5\u05df \u05de\u05d7\u05d5\u05dc\u05e7 \u05d0\u05d9\u05e0\u05d4 \u05de\u05e9\u05e7\u05e4\u05ea \u05d0\u05ea \u05e8\u05de\u05ea \u05d4\u05e9\u05e4\u05dc \u05d4\u05e1\u05d8\u05e0\u05d3\u05e8\u05d8\u05d9\u05ea \u05d4\u05e0\u05d3\u05e8\u05e9\u05ea \u05dc\u05e0\u05d9\u05d8\u05d5\u05e8 (Dulcan p. 767)."
        }
      ],
      "hint": "\u05d6\u05d4\u05d5 \u05d7\u05dc\u05d5\u05df \u05d4\u05d6\u05de\u05e0\u05d9\u05dd \u05d4\u05e1\u05d8\u05e0\u05d3\u05e8\u05d8\u05d9 \u05dc\u05e0\u05d9\u05d8\u05d5\u05e8 \u05de\u05e8\u05d1\u05d9\u05ea \u05d4\u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05e2\u05dd \u05d7\u05dc\u05d5\u05df \u05ea\u05e8\u05e4\u05d5\u05d9\u05d8\u05d9 \u05e6\u05e8."
    },
    {
      "question": "\u05d1\u05de\u05d4\u05dc\u05da \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Lithium, \u05de\u05d4\u05d5 \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05de\u05d5\u05e6\u05e2 \u05d4\u05de\u05e1\u05d1\u05d9\u05e8 \u05d0\u05ea \u05d4\u05d4\u05e9\u05e4\u05e2\u05d4 \u05d4-Neuroprotective \u05d5\u05d4\u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd \u05d1-Long-term plasticity?",
      "answerOptions": [
        {
          "text": "\u05e2\u05d9\u05db\u05d5\u05d1 \u05d4\u05d0\u05e0\u05d6\u05d9\u05dd Glycogen Synthase Kinase 3 (GSK-3).",
          "isCorrect": true,
          "rationale": "\u05e2\u05d9\u05db\u05d5\u05d1 GSK-3 \u05e2\u05dc \u05d9\u05d3\u05d9 Lithium \u05de\u05e7\u05d3\u05dd \u05d4\u05d9\u05e9\u05e8\u05d3\u05d5\u05ea \u05ea\u05d0\u05d9\u05dd \u05d5\u05e4\u05dc\u05e1\u05d8\u05d9\u05e1\u05d9\u05d5\u05ea \u05e1\u05d9\u05e0\u05e4\u05d8\u05d9\u05ea (StahlNeuro p. 50, p. 345)."
        },
        {
          "text": "\u05d7\u05e1\u05d9\u05de\u05d4 \u05e1\u05dc\u05e7\u05d8\u05d9\u05d1\u05d9\u05ea \u05e9\u05dc \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 $D_{2}$ \u05d1\u05de\u05e1\u05dc\u05d5\u05dc \u05d4\u05de\u05d6\u05d5\u05dc\u05d9\u05de\u05d1\u05d9.",
          "isCorrect": false,
          "rationale": "Lithium \u05d0\u05d9\u05e0\u05d5 \u05d7\u05d5\u05e1\u05dd \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 \u05d3\u05d5\u05e4\u05de\u05d9\u05df \u05d1\u05d0\u05d5\u05e4\u05df \u05d9\u05e9\u05d9\u05e8; \u05d6\u05d4\u05d5 \u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05e9\u05dc \u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05d0\u05e0\u05d8\u05d9-\u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9\u05d5\u05ea (StahlNeuro p. 345)."
        },
        {
          "text": "\u05d4\u05d2\u05d1\u05e8\u05ea \u05d4\u05e1\u05e4\u05d9\u05d2\u05d4 \u05d4\u05d7\u05d5\u05d6\u05e8\u05ea \u05e9\u05dc Glutamate \u05de\u05d4\u05de\u05e8\u05d5\u05d5\u05d7 \u05d4\u05e1\u05d9\u05e0\u05e4\u05d8\u05d9.",
          "isCorrect": false,
          "rationale": "\u05d1\u05e2\u05d5\u05d3 \u05e9-Lithium \u05de\u05e9\u05e4\u05d9\u05e2 \u05e2\u05dc \u05de\u05e2\u05e8\u05db\u05d5\u05ea \u05e8\u05d1\u05d5\u05ea, \u05e2\u05d9\u05db\u05d5\u05d1 GSK-3 \u05d4\u05d5\u05d0 \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05d4\u05de\u05e7\u05d5\u05e9\u05e8 \u05dc\u05e4\u05dc\u05e1\u05d8\u05d9\u05e1\u05d9\u05d5\u05ea (StahlNeuro p. 345)."
        },
        {
          "text": "\u05d0\u05e7\u05d8\u05d9\u05d1\u05e6\u05d9\u05d4 \u05d9\u05e9\u05d9\u05e8\u05d4 \u05e9\u05dc \u05ea\u05e2\u05dc\u05d5\u05ea Sodium \u05ea\u05dc\u05d5\u05d9\u05d5\u05ea \u05de\u05ea\u05d7.",
          "isCorrect": false,
          "rationale": "Lithium \u05de\u05e9\u05e0\u05d4 \u05d4\u05d5\u05dc\u05db\u05ea \u05e0\u05ea\u05e8\u05df \u05d0\u05da \u05d0\u05d9\u05e0\u05d5 \u05de\u05e4\u05e2\u05d9\u05dc \u05ea\u05e2\u05dc\u05d5\u05ea \u05d0\u05dc\u05d5 \u05db\u05e9\u05dc\u05e2\u05e6\u05de\u05d5 \u05dc\u05e6\u05d5\u05e8\u05da \u05e4\u05dc\u05e1\u05d8\u05d9\u05e1\u05d9\u05d5\u05ea (StahlKids p. 284)."
        }
      ],
      "hint": "\u05d7\u05e4\u05e9 \u05d0\u05e0\u05d6\u05d9\u05dd \u05d4\u05de\u05e2\u05d5\u05e8\u05d1 \u05d1\u05de\u05e1\u05dc\u05d5\u05dc\u05d9 Signal transduction \u05d4\u05e7\u05e9\u05d5\u05e8\u05d9\u05dd \u05dc\u05de\u05d5\u05d5\u05ea \u05ea\u05d0\u05d9 (Apoptosis)."
    },
    {
      "question": "\u05de\u05d8\u05d5\u05e4\u05dc\u05ea \u05d1\u05ea 16 \u05e2\u05dd Bipolar Disorder \u05d4\u05de\u05d0\u05d5\u05d6\u05e0\u05ea \u05e2\u05dc Lithium \u05de\u05e4\u05ea\u05d7\u05ea \u05d6\u05d9\u05d4\u05d5\u05dd \u05d1\u05d3\u05e8\u05db\u05d9 \u05d4\u05e9\u05ea\u05df \u05d5\u05de\u05ea\u05d7\u05d9\u05dc\u05d4 \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-NSAIDs \u05dc\u05db\u05d0\u05d1\u05d9\u05dd. \u05dc\u05d0\u05d7\u05e8 \u05de\u05e1\u05e4\u05e8 \u05d9\u05de\u05d9\u05dd \u05d4\u05d9\u05d0 \u05de\u05ea\u05dc\u05d5\u05e0\u05e0\u05ea \u05e2\u05dc \u05d1\u05d7\u05d9\u05dc\u05d5\u05ea, \u05e8\u05e2\u05d3 \u05d2\u05e1 \u05d1\u05d9\u05d3\u05d9\u05d9\u05dd \u05d5\u05d3\u05d9\u05d1\u05d5\u05e8 \u05de\u05e2\u05d5\u05de\u05e2\u05dd (Dysarthria). \u05de\u05d4\u05d5 \u05d4\u05d4\u05e1\u05d1\u05e8 \u05d4\u05e1\u05d1\u05d9\u05e8 \u05d1\u05d9\u05d5\u05ea\u05e8?",
      "answerOptions": [
        {
          "text": "\u05d4-NSAIDs \u05d4\u05e4\u05d7\u05d9\u05ea\u05d5 \u05d0\u05ea \u05d4\u05e4\u05d9\u05e0\u05d5\u05d9 \u05d4\u05db\u05dc\u05d9\u05d9\u05ea\u05d9 \u05e9\u05dc \u05d4-Lithium \u05d5\u05d4\u05e2\u05dc\u05d5 \u05d0\u05ea \u05e8\u05de\u05ea\u05d5 \u05dc\u05e8\u05de\u05d4 \u05e8\u05e2\u05d9\u05dc\u05d4.",
