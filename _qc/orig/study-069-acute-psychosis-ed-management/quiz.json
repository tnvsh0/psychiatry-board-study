          "text": "\u05e8\u05e7 \u05db\u05d0\u05e9\u05e8 \u05db\u05dc \u05d4\u05d0\u05e1\u05d8\u05e8\u05d8\u05d2\u05d9\u05d5\u05ea \u05d4\u05d0\u05d7\u05e8\u05d5\u05ea \u05e0\u05db\u05e9\u05dc\u05d5 \u05d5\u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05de\u05d4\u05d5\u05d5\u05d4 \u05d0\u05d9\u05d5\u05dd \u05de\u05d9\u05d9\u05d3\u05d9 \u05e9\u05dc \u05e4\u05d2\u05d9\u05e2\u05d4 \u05d1\u05e2\u05e6\u05de\u05d5 \u05d0\u05d5 \u05d1\u05d0\u05d7\u05e8\u05d9\u05dd",
          "isCorrect": true,
          "rationale": "\u05e8\u05d9\u05e1\u05d5\u05df \u05e4\u05d9\u05d6\u05d9 \u05d4\u05d5\u05d0 \u05de\u05d5\u05e6\u05d0 \u05d0\u05d7\u05e8\u05d5\u05df \u05d1\u05dc\u05d1\u05d3 (Last resort) \u05dc\u05de\u05e6\u05d1\u05d9 \u05e1\u05db\u05e0\u05d4 \u05de\u05d9\u05d9\u05d3\u05d9\u05ea \u05e9\u05dc\u05d0 \u05d4\u05d2\u05d9\u05d1\u05d5 \u05dc\u05d3\u05d4-\u05d0\u05e1\u05e7\u05dc\u05e6\u05d9\u05d4 \u05d0\u05d5 \u05d0\u05d9\u05e4\u05d5\u05e7 \u05db\u05d9\u05de\u05d9 (Dulcan p.611)."
        },
        {
          "text": "\u05db\u05d0\u05de\u05e6\u05e2\u05d9 \u05e2\u05e0\u05d9\u05e9\u05d4 \u05e2\u05dc \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05dc\u05d0 \u05de\u05e0\u05d5\u05de\u05e1\u05ea \u05db\u05dc\u05e4\u05d9 \u05d4\u05e6\u05d5\u05d5\u05ea",
          "isCorrect": false,
          "rationale": "\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05e8\u05d9\u05e1\u05d5\u05df \u05db\u05e2\u05e0\u05d9\u05e9\u05d4 \u05d0\u05d9\u05e0\u05d5 \u05d0\u05ea\u05d9 \u05d5\u05d0\u05e1\u05d5\u05e8 \u05e2\u05dc \u05e4\u05d9 \u05d7\u05d5\u05e7 \u05d5\u05e8\u05d2\u05d5\u05dc\u05e6\u05d9\u05d4 (Dulcan p.611)."
        },
        {
          "text": "\u05d1\u05d0\u05d5\u05e4\u05df \u05e8\u05d5\u05d8\u05d9\u05e0\u05d9 \u05dc\u05db\u05dc \u05de\u05d8\u05d5\u05e4\u05dc \u05e9\u05de\u05d5\u05d1\u05d0 \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d4\u05de\u05e9\u05d8\u05e8\u05d4",
          "isCorrect": false,
          "rationale": "\u05d0\u05d9\u05df \u05dc\u05d4\u05e9\u05ea\u05de\u05e9 \u05d1\u05e8\u05d9\u05e1\u05d5\u05df \u05d1\u05d0\u05d5\u05e4\u05df \u05d2\u05d5\u05e8\u05e3; \u05db\u05dc \u05de\u05e7\u05e8\u05d4 \u05d7\u05d9\u05d9\u05d1 \u05d4\u05e2\u05e8\u05db\u05d4 \u05e4\u05e8\u05d8\u05e0\u05d9\u05ea \u05e9\u05dc \u05e8\u05de\u05ea \u05d4\u05e1\u05db\u05e0\u05d4 (Dulcan p.611)."
        },
        {
          "text": "\u05db\u05d0\u05e9\u05e8 \u05d7\u05d3\u05e8 \u05d4\u05de\u05d9\u05d5\u05df \u05e2\u05de\u05d5\u05e1 \u05d5\u05d0\u05d9\u05df \u05de\u05e1\u05e4\u05d9\u05e7 \u05d0\u05e0\u05e9\u05d9 \u05e6\u05d5\u05d5\u05ea \u05dc\u05d4\u05e9\u05d2\u05d7\u05d4",
          "isCorrect": false,
          "rationale": "\u05de\u05d7\u05e1\u05d5\u05e8 \u05d1\u05db\u05d5\u05d7 \u05d0\u05d3\u05dd \u05d0\u05d9\u05e0\u05d5 \u05d4\u05e6\u05d3\u05e7\u05d4 \u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05d0\u05d5 \u05d0\u05ea\u05d9\u05ea \u05dc\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05e8\u05d9\u05e1\u05d5\u05df (Dulcan p.611)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05e2\u05e7\u05e8\u05d5\u05df \u05d4-Least Restrictive Alternative \u05d5\u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05e4\u05d2\u05d9\u05e2\u05d4 \u05e4\u05d9\u05d6\u05d9\u05ea/\u05e0\u05e4\u05e9\u05d9\u05ea.",
      "imageUrls": []
    },
    {
      "type": "short_answer",
      "question": "\u05d4\u05e1\u05d1\u05e8 \u05de\u05d3\u05d5\u05e2 \u05e9\u05d9\u05dc\u05d5\u05d1 \u05e4\u05d0\u05e8\u05d0\u05e0\u05d8\u05e8\u05dc\u05d9 (IM) \u05e9\u05dc Olanzapine \u05d9\u05d7\u05d3 \u05e2\u05dd Benzodiazepines (\u05db\u05d2\u05d5\u05df Lorazepam) \u05e0\u05d7\u05e9\u05d1 \u05dc\u05e1\u05d9\u05db\u05d5\u05df \u05d1\u05d8\u05d9\u05d7\u05d5\u05ea\u05d9 \u05d7\u05de\u05d5\u05e8 \u05d1\u05de\u05d9\u05d5\u05df, \u05d5\u05de\u05d4\u05d5 \u05e4\u05e8\u05e7 \u05d4\u05d6\u05de\u05df \u05d4\u05de\u05d9\u05e0\u05d9\u05de\u05dc\u05d9 \u05d4\u05e0\u05d3\u05e8\u05e9 \u05d1\u05d9\u05df \u05de\u05ea\u05df \u05e9\u05ea\u05d9 \u05d4\u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05d4\u05dc\u05dc\u05d5?",
      "grading": {
        "modelAnswer": "\u05d4\u05e9\u05d9\u05dc\u05d5\u05d1 \u05d4\u05e4\u05d0\u05e8\u05d0\u05e0\u05d8\u05e8\u05dc\u05d9 \u05e9\u05dc Olanzapine IM \u05d5\u05d1\u05e0\u05d6\u05d5\u05d3\u05d9\u05d0\u05d6\u05e4\u05d9\u05e0\u05d9\u05dd IM \u05db\u05e8\u05d5\u05da \u05d1\u05e1\u05d9\u05db\u05d5\u05df \u05d2\u05d1\u05d5\u05d4 \u05dc\u05d3\u05d9\u05db\u05d5\u05d9 \u05e0\u05e9\u05d9\u05de\u05ea\u05d9 \u05d7\u05de\u05d5\u05e8 (Respiratory depression), \u05ea\u05ea-\u05dc\u05d7\u05e5 \u05d3\u05dd \u05d5\u05d1\u05e8\u05d0\u05d3\u05d9\u05e7\u05e8\u05d3\u05d9\u05d4. \u05d9\u05e9 \u05dc\u05d4\u05de\u05ea\u05d9\u05df \u05dc\u05e4\u05d7\u05d5\u05ea \u05e9\u05e2\u05d4 \u05d0\u05d7\u05ea (1 hour) \u05d1\u05d9\u05df \u05de\u05ea\u05df Olanzapine IM \u05dc\u05d1\u05d9\u05df \u05de\u05ea\u05df \u05d1\u05e0\u05d6\u05d5\u05d3\u05d9\u05d0\u05d6\u05e4\u05d9\u05df IM.",
        "rationale": "\u05d4\u05d0\u05d9\u05e0\u05d8\u05e8\u05d0\u05e7\u05e6\u05d9\u05d4 \u05d1\u05d9\u05df \u05e9\u05ea\u05d9 \u05d4\u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05d1\u05de\u05ea\u05df \u05ea\u05d5\u05da-\u05e9\u05e8\u05d9\u05e8\u05d9 \u05e2\u05dc\u05d5\u05dc\u05d4 \u05dc\u05d4\u05d5\u05d1\u05d9\u05dc \u05dc\u05e7\u05e8\u05d9\u05e1\u05d4 \u05e0\u05e9\u05d9\u05de\u05ea\u05d9\u05ea \u05d5\u05d4\u05de\u05d5\u05d3\u05d9\u05e0\u05de\u05d9\u05ea, \u05db\u05e4\u05d9 \u05e9\u05de\u05e6\u05d5\u05d9\u05df \u05d1\u05d0\u05d6\u05d4\u05e8\u05d5\u05ea \u05d4-Black Box (Dulcan p.612, StahlKids p.351).",
        "requiredAttributes": [
          "\u05e6\u05d9\u05d5\u05df \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05d3\u05d9\u05db\u05d5\u05d9 \u05e0\u05e9\u05d9\u05de\u05ea\u05d9 (Respiratory depression).",
          "\u05e6\u05d9\u05d5\u05df \u05e4\u05e8\u05e7 \u05d4\u05d6\u05de\u05df \u05d4\u05de\u05d9\u05e0\u05d9\u05de\u05dc\u05d9 \u05e9\u05dc \u05e9\u05e2\u05d4 (1 hour).",
          "\u05d4\u05ea\u05d9\u05d9\u05d7\u05e1\u05d5\u05ea \u05dc\u05de\u05ea\u05df \u05d4\u05e4\u05d0\u05e8\u05d0\u05e0\u05d8\u05e8\u05dc\u05d9 (IM/IV)."
        ],
        "errors": {
          "misconceptions": [
            "\u05e1\u05d1\u05e8\u05d4 \u05e9\u05e0\u05d9\u05ea\u05df \u05dc\u05ea\u05ea \u05d0\u05d5\u05ea\u05df \u05d9\u05d7\u05d3 \u05d0\u05dd \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05d1\u05e0\u05d8\u05d5\u05e8 (Monitoring) \u05e6\u05de\u05d5\u05d3.",
            "\u05d1\u05dc\u05d1\u05d5\u05dc \u05d1\u05d9\u05df \u05de\u05ea\u05df \u05e4\u05d5\u05de\u05d9 (PO) \u05dc\u05de\u05ea\u05df \u05ea\u05d5\u05da-\u05e9\u05e8\u05d9\u05e8\u05d9 (IM)."
          ],
          "bluffs": [
            "\u05d0\u05de\u05d9\u05e8\u05d4 \u05db\u05dc\u05dc\u05d9\u05ea \u05e9\u05d4\u05df '\u05de\u05ea\u05e0\u05d2\u05e9\u05d5\u05ea' \u05d1\u05dc\u05d9 \u05dc\u05d4\u05e1\u05d1\u05d9\u05e8 \u05d0\u05ea \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05e0\u05e9\u05d9\u05de\u05ea\u05d9."
          ]
        }
      },
      "hint": "\u05d4\u05ea\u05de\u05e7\u05d3 \u05d1\u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05e0\u05e9\u05d9\u05de\u05d4 \u05d5\u05d1\u05dc\u05d7\u05e5 \u05d4\u05d3\u05dd \u05db\u05e1\u05d9\u05d1\u05d5\u05db\u05d9\u05dd \u05e4\u05d5\u05d8\u05e0\u05e6\u05d9\u05d0\u05dc\u05d9\u05d9\u05dd \u05e7\u05d8\u05dc\u05e0\u05d9\u05d9\u05dd.",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05e2\u05e8\u05db\u05ea \u05d0\u05d2\u05d9\u05d8\u05e6\u05d9\u05d4 \u05d1\u05de\u05d9\u05d5\u05df, \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05de\u05e6\u05d9\u05d2 \u05e1\u05d9\u05de\u05e0\u05d9\u05dd \u05e9\u05dc 'Clouded consciousness', \u05d3\u05d9\u05e1\u05d0\u05d5\u05e8\u05d9\u05d9\u05e0\u05d8\u05e6\u05d9\u05d4 \u05d5\u05ea\u05e0\u05d5\u05d3\u05d5\u05ea \u05d1\u05e2\u05e8\u05e0\u05d5\u05ea \u05dc\u05d0\u05d5\u05e8\u05da \u05d4\u05de\u05e9\u05de\u05e8\u05ea. \u05d1\u05d1\u05d3\u05d9\u05e7\u05ea \u05de\u05e2\u05d1\u05d3\u05d4 \u05d4\u05ea\u05d2\u05dc\u05ea\u05d4 \u05d4\u05d9\u05e4\u05d5\u05e0\u05ea\u05e8\u05de\u05d9\u05d4 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea. \u05de\u05d4\u05d5 \u05d4\u05e6\u05e2\u05d3 \u05d4\u05e0\u05d9\u05d4\u05d5\u05dc\u05d9 \u05d4\u05d7\u05e9\u05d5\u05d1 \u05d1\u05d9\u05d5\u05ea\u05e8?",
      "answerOptions": [
        {
          "text": "\u05ea\u05d9\u05e7\u05d5\u05df \u05d4\u05de\u05e6\u05d1 \u05d4\u05e8\u05e4\u05d5\u05d0\u05d9 \u05d4\u05d1\u05e1\u05d9\u05e1\u05d9 (\u05d4\u05d4\u05d9\u05e4\u05d5\u05e0\u05ea\u05e8\u05de\u05d9\u05d4) \u05d1\u05de\u05e7\u05d1\u05d9\u05dc \u05dc\u05e0\u05d9\u05d4\u05d5\u05dc \u05d4\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd",
          "isCorrect": true,
          "rationale": "\u05d3\u05dc\u05d9\u05e8\u05d9\u05d5\u05dd \u05d4\u05d5\u05d0 \u05de\u05e9\u05e0\u05d9 \u05dc\u05de\u05e6\u05d1 \u05e8\u05e4\u05d5\u05d0\u05d9; \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05e2\u05d9\u05e7\u05e8\u05d9 \u05d4\u05d5\u05d0 \u05d6\u05d9\u05d4\u05d5\u05d9 \u05d5\u05ea\u05d9\u05e7\u05d5\u05df \u05d4\u05d2\u05d5\u05e8\u05dd \u05d4\u05d0\u05d5\u05e8\u05d2\u05e0\u05d9 (Dulcan p.615-616)."
        },
        {
          "text": "\u05d4\u05e2\u05dc\u05d0\u05ea \u05de\u05d9\u05e0\u05d5\u05df \u05d4-Benzodiazepines \u05dc\u05e9\u05d9\u05e4\u05d5\u05e8 \u05d4\u05e9\u05d9\u05e0\u05d4",
          "isCorrect": false,
          "rationale": "\u05d1\u05e0\u05d6\u05d5\u05d3\u05d9\u05d0\u05d6\u05e4\u05d9\u05e0\u05d9\u05dd \u05dc\u05e8\u05d5\u05d1 \u05de\u05d7\u05de\u05d9\u05e8\u05d9\u05dd \u05d3\u05dc\u05d9\u05e8\u05d9\u05d5\u05dd (\u05e4\u05e8\u05d8 \u05dc\u05de\u05e6\u05d1\u05d9 \u05d2\u05de\u05d9\u05dc\u05d4) \u05d5\u05d0\u05d9\u05e0\u05dd \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05e1\u05d9\u05d1\u05d4 \u05d4\u05d0\u05d5\u05e8\u05d2\u05e0\u05d9\u05ea (Dulcan p.616)."
        },
        {
          "text": "\u05de\u05ea\u05df \u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc \u05e1\u05db\u05d9\u05d6\u05d5\u05e4\u05e8\u05e0\u05d9\u05d4 \u05d5\u05e9\u05d7\u05e8\u05d5\u05e8 \u05dc\u05de\u05e2\u05e7\u05d1 \u05de\u05e8\u05e4\u05d0\u05ea\u05d9",
          "isCorrect": false,
          "rationale": "\u05d0\u05d9\u05df \u05dc\u05d0\u05d1\u05d7\u05df \u05e1\u05db\u05d9\u05d6\u05d5\u05e4\u05e8\u05e0\u05d9\u05d4 \u05d1\u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05d3\u05dc\u05d9\u05e8\u05d9\u05d5\u05dd \u05d0\u05d5 \u05d4\u05e4\u05e8\u05e2\u05d4 \u05d0\u05dc\u05e7\u05d8\u05e8\u05d5\u05dc\u05d9\u05d8\u05e8\u05d9\u05ea \u05d7\u05e8\u05d9\u05e4\u05d4 (DSM p.131)."
        },
        {
          "text": "\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1-Ziprasidone IM \u05d1\u05e9\u05dc \u05d9\u05e2\u05d9\u05dc\u05d5\u05ea\u05d5 \u05d1\u05d3\u05dc\u05d9\u05e8\u05d9\u05d5\u05dd",
          "isCorrect": false,
          "rationale": "Ziprasidone \u05d0\u05d9\u05e0\u05d5 \u05de\u05d5\u05de\u05dc\u05e5 \u05d1\u05de\u05d9\u05d5\u05df \u05d1\u05e9\u05dc \u05ea\u05db\u05d5\u05e0\u05d5\u05ea\u05d9\u05d5 \u05d4\u05de\u05e2\u05d5\u05e8\u05e8\u05d5\u05ea (Activating) \u05d5\u05d4\u05d0\u05e8\u05db\u05ea QTc (Dulcan p.612)."
        }
      ],
      "hint": "\u05d1\u05d3\u05dc\u05d9\u05e8\u05d9\u05d5\u05dd, \u05d4\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05d4\u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9\u05d9\u05dd \u05d4\u05dd \u05ea\u05d5\u05e6\u05d0\u05d4 \u05e9\u05dc \u05ea\u05e7\u05dc\u05d4 \u05e4\u05d9\u05d6\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea.",
      "imageUrls": []
