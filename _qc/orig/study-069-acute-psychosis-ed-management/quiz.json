    {
      "type": "multiple_choice",
      "question": "\u05d9\u05dc\u05d3 \u05d1\u05df 9 \u05d4\u05de\u05d0\u05d5\u05d1\u05d7\u05df \u05e2\u05dd Autism Spectrum Disorder (ASD) \u05de\u05d5\u05d1\u05d0 \u05dc\u05de\u05d9\u05d5\u05df \u05d1\u05e9\u05dc \u05d4\u05ea\u05e4\u05e8\u05e6\u05d5\u05ea \u05d6\u05e2\u05dd \u05d5\u05d0\u05d2\u05d9\u05d8\u05e6\u05d9\u05d4. \u05d4\u05e6\u05d5\u05d5\u05ea \u05e9\u05d5\u05e7\u05dc \u05de\u05ea\u05df Lorazepam \u05dc\u05d4\u05e8\u05d2\u05e2\u05d4. \u05de\u05d4\u05d9 \u05d4\u05d0\u05d6\u05d4\u05e8\u05d4 \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05d4\u05d7\u05e9\u05d5\u05d1\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05d2\u05d1\u05d9 \u05e9\u05d9\u05de\u05d5\u05e9 \u05d1-Benzodiazepines \u05d1\u05d0\u05d5\u05db\u05dc\u05d5\u05e1\u05d9\u05d9\u05d4 \u05d6\u05d5?",
      "answerOptions": [
        {
          "text": "\u05e1\u05d9\u05db\u05d5\u05df \u05de\u05d5\u05d2\u05d1\u05e8 \u05dc\u05ea\u05d5\u05e4\u05e2\u05d4 \u05e9\u05dc Paradoxical disinhibition",
          "isCorrect": true,
          "rationale": "\u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd ASD \u05d0\u05d5 \u05de\u05d5\u05d2\u05d1\u05dc\u05d5\u05ea \u05e9\u05db\u05dc\u05d9\u05ea \u05e0\u05de\u05e6\u05d0\u05d9\u05dd \u05d1\u05e1\u05d9\u05db\u05d5\u05df \u05de\u05d5\u05d2\u05d1\u05e8 \u05dc\u05ea\u05d2\u05d5\u05d1\u05d4 \u05e4\u05e8\u05d3\u05d5\u05e7\u05e1\u05dc\u05d9\u05ea \u05dc\u05d1\u05e0\u05d6\u05d5\u05d3\u05d9\u05d0\u05d6\u05e4\u05d9\u05e0\u05d9\u05dd, \u05e9\u05e2\u05dc\u05d5\u05dc\u05d4 \u05dc\u05d4\u05d7\u05de\u05d9\u05e8 \u05d0\u05ea \u05d4\u05d0\u05d2\u05d9\u05d8\u05e6\u05d9\u05d4 \u05d5\u05d4\u05ea\u05d5\u05e7\u05e4\u05e0\u05d5\u05ea (Dulcan p.612)."
        },
        {
          "text": "\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea \u05de\u05d9\u05d9\u05d3\u05d9\u05ea \u05e9\u05dc Tardive dyskinesia",
          "isCorrect": false,
          "rationale": "\u05d3\u05d9\u05e1\u05e7\u05d9\u05e0\u05d6\u05d9\u05d4 \u05de\u05d0\u05d5\u05d7\u05e8\u05ea \u05d4\u05d9\u05d0 \u05e1\u05d9\u05d1\u05d5\u05da \u05e9\u05dc \u05d0\u05e0\u05d8\u05d2\u05d5\u05e0\u05d9\u05e1\u05d8\u05d9\u05dd \u05dc\u05d3\u05d5\u05e4\u05de\u05d9\u05df (\u05d0\u05e0\u05d8\u05d9-\u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9\u05d9\u05dd), \u05dc\u05d0 \u05e9\u05dc \u05d1\u05e0\u05d6\u05d5\u05d3\u05d9\u05d0\u05d6\u05e4\u05d9\u05e0\u05d9\u05dd (DSM p.812)."
        },
        {
          "text": "\u05d9\u05e8\u05d9\u05d3\u05d4 \u05d7\u05d3\u05d4 \u05d1\u05e8\u05de\u05d5\u05ea \u05d4-Prolactin",
          "isCorrect": false,
          "rationale": "\u05d1\u05e0\u05d6\u05d5\u05d3\u05d9\u05d0\u05d6\u05e4\u05d9\u05e0\u05d9\u05dd \u05d0\u05d9\u05e0\u05dd \u05de\u05e9\u05e4\u05d9\u05e2\u05d9\u05dd \u05d1\u05d0\u05d5\u05e4\u05df \u05d8\u05d9\u05e4\u05d5\u05e1\u05d9 \u05e2\u05dc \u05e8\u05de\u05d5\u05ea \u05d4\u05e4\u05e8\u05d5\u05dc\u05e7\u05d8\u05d9\u05df; \u05d4\u05e9\u05e4\u05e2\u05d4 \u05d6\u05d5 \u05e7\u05e9\u05d5\u05e8\u05d4 \u05dc\u05d7\u05e1\u05d9\u05de\u05ea D2 (StahlNeuro p.147)."
        },
        {
          "text": "\u05e2\u05dc\u05d9\u05d9\u05d4 \u05de\u05e1\u05d5\u05db\u05e0\u05ea \u05d1\u05e1\u05e3 \u05d4\u05e4\u05e8\u05db\u05d5\u05e1 (Seizure threshold)",
          "isCorrect": false,
          "rationale": "\u05d1\u05e0\u05d6\u05d5\u05d3\u05d9\u05d0\u05d6\u05e4\u05d9\u05e0\u05d9\u05dd \u05d3\u05d5\u05d5\u05e7\u05d0 \u05de\u05e2\u05dc\u05d9\u05dd \u05d0\u05ea \u05e1\u05e3 \u05d4\u05e4\u05e8\u05db\u05d5\u05e1 (\u05e0\u05d5\u05d2\u05d3\u05d9 \u05e4\u05e8\u05db\u05d5\u05e1\u05d9\u05dd), \u05d5\u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05d1\u05de\u05ea\u05df \u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05d0\u05d7\u05e8\u05d5\u05ea \u05d4\u05d5\u05d0 \u05dc\u05e8\u05d5\u05d1 \u05d9\u05e8\u05d9\u05d3\u05d4 \u05d1\u05e1\u05e3 \u05d6\u05d4 (Dulcan p.1096)."
        }
