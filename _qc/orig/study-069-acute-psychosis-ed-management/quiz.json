        {
          "text": "Risperidone 2mg ODT + Lorazepam 1mg PO",
          "isCorrect": false,
          "rationale": "\u05d1\u05de\u05e6\u05d1 \u05e9\u05dc \u05ea\u05d5\u05e7\u05e4\u05e0\u05d5\u05ea \u05e4\u05e2\u05d9\u05dc\u05d4 \u05d5\u05e1\u05db\u05e0\u05d4 \u05de\u05d9\u05d9\u05d3\u05d9\u05ea, \u05de\u05ea\u05df \u05e4\u05d5\u05de\u05d9 (PO/ODT) \u05d0\u05d9\u05e0\u05d5 \u05d4\u05d5\u05dc\u05dd \u05d5\u05d0\u05d9\u05e0\u05d5 \u05de\u05d4\u05d5\u05d5\u05d4 \u05d7\u05dc\u05e7 \u05de\u05e4\u05e8\u05d5\u05d8\u05d5\u05e7\u05d5\u05dc \u05d4-B-52 \u05d4\u05de\u05d9\u05d5\u05e2\u05d3 \u05dc\u05de\u05e6\u05d1\u05d9 \u05d7\u05d9\u05e8\u05d5\u05dd IM (Dulcan p.611)."
        },
        {
          "text": "Chlorpromazine 100mg IM",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05d4\u05e9\u05e4\u05e2\u05ea\u05d5 \u05d4\u05e1\u05d3\u05d8\u05d9\u05d1\u05d9\u05ea, Chlorpromazine \u05d1\u05de\u05d9\u05e0\u05d5\u05df \u05d2\u05d1\u05d5\u05d4 \u05db\u05e8\u05d5\u05da \u05d1\u05e1\u05d9\u05db\u05d5\u05df \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9 \u05dc\u05ea\u05ea-\u05dc\u05d7\u05e5 \u05d3\u05dd \u05d0\u05d5\u05e8\u05ea\u05d5\u05e1\u05d8\u05d8\u05d9 \u05d5\u05d0\u05d9\u05e0\u05d5 \u05e0\u05d7\u05e9\u05d1 \u05dc\u05e4\u05e8\u05d5\u05d8\u05d5\u05e7\u05d5\u05dc \u05d4\u05d1\u05d7\u05d9\u05e8\u05d4 \u05d4\u05de\u05d4\u05d9\u05e8 \u05d1\u05de\u05d9\u05d5\u05df (Dulcan p.612, StahlKids p.101)."
        }
      ],
      "hint": "\u05d4\u05e4\u05e8\u05d5\u05d8\u05d5\u05e7\u05d5\u05dc \u05de\u05e9\u05dc\u05d1 \u05e9\u05dc\u05d5\u05e9 \u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05d4\u05e4\u05d5\u05e2\u05dc\u05d5\u05ea \u05e2\u05dc \u05de\u05e2\u05e8\u05db\u05d5\u05ea \u05d4\u05d3\u05d5\u05e4\u05de\u05d9\u05df, \u05d4-GABA \u05d5\u05d4\u05d4\u05d9\u05e1\u05d8\u05de\u05d9\u05df/\u05d0\u05e6\u05d8\u05d9\u05dc\u05db\u05d5\u05dc\u05d9\u05df \u05d1\u05de\u05ea\u05df \u05ea\u05d5\u05da-\u05e9\u05e8\u05d9\u05e8\u05d9.",
      "imageUrls": []
