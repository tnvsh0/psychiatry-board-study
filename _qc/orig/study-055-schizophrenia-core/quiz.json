          ],
          "bluffs": [
            "\u05d0\u05de\u05d9\u05e8\u05d4 \u05db\u05dc\u05dc\u05d9\u05ea \u05e9-Schizoaffective \u05d4\u05d9\u05d0 \u05e9\u05d9\u05dc\u05d5\u05d1 \u05e9\u05dc \u05e9\u05ea\u05d9 \u05d4\u05de\u05d7\u05dc\u05d5\u05ea \u05dc\u05dc\u05d0 \u05e4\u05d9\u05e8\u05d5\u05d8 \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df \u05d4\u05d6\u05de\u05df."
          ]
