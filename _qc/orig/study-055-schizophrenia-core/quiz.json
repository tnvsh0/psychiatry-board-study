      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05ea\u05d4\u05dc\u05d9\u05db\u05d9\u05dd \u05d4\u05de\u05ea\u05e8\u05d7\u05e9\u05d9\u05dd \u05d1\u05de\u05d4\u05dc\u05da \u05e6\u05de\u05d9\u05d7\u05ea \u05d4\u05de\u05d5\u05d7 \u05d5\u05e2\u05dc \u05d4\u05d9\u05e2\u05d3\u05e8 \u05e1\u05d9\u05de\u05e0\u05d9\u05dd \u05dc\u05ea\u05d4\u05dc\u05d9\u05da \u05d3\u05dc\u05e7\u05ea\u05d9 \u05d0\u05d5 \u05e0\u05d9\u05d5\u05d5\u05e0\u05d9 \u05e7\u05dc\u05d0\u05e1\u05d9.",
      "hasAllOfTheAbove": false,
      "hasNoneOfTheAbove": false
    },
    {
      "type": "fill_in_the_blank",
      "question": "\u05dc\u05e4\u05d9 StahlNeuro, \u05d4\u05ea\u05d9\u05d0\u05d5\u05e8\u05d9\u05d4 \u05e9\u05dc NMDA receptor hypofunction \u05de\u05e6\u05d9\u05e2\u05d4 \u05db\u05d9 \u05dc\u05d9\u05e7\u05d5\u05d9 \u05d1\u05e8\u05e6\u05e4\u05d8\u05d5\u05e8\u05d9\u05dd \u05d0\u05dc\u05d5 \u05e2\u05dc \u05d2\u05d1\u05d9 \u05d0\u05d9\u05e0\u05d8\u05e8\u05e0\u05d5\u05d9\u05e8\u05d5\u05e0\u05d9\u05dd \u05de\u05e1\u05d5\u05d2 ___ \u05de\u05d5\u05d1\u05d9\u05dc \u05dc\u05d7\u05d5\u05e1\u05e8 \u05e2\u05db\u05d1\u05d4 (disinhibition) \u05e9\u05dc \u05de\u05e1\u05dc\u05d5\u05dc\u05d9\u05dd \u05d2\u05dc\u05d5\u05d8\u05de\u05d8\u05e8\u05d2\u05d9\u05d9\u05dd \u05d1\u05de\u05d5\u05d7.",
      "bestAnswer": "GABA",
      "acceptableAnswers": [
        "gamma-aminobutyric acid"
      ],
      "rationale": "\u05d4\u05d9\u05e4\u05d5\u05e4\u05d5\u05e0\u05e7\u05e6\u05d9\u05d4 \u05e9\u05dc \u05e8\u05e6\u05e4\u05d8\u05d5\u05e8\u05d9 NMDA \u05e2\u05dc \u05d0\u05d9\u05e0\u05d8\u05e8\u05e0\u05d5\u05d9\u05e8\u05d5\u05e0\u05d9\u05dd \u05de\u05e2\u05db\u05d1\u05d9\u05dd \u05de\u05e1\u05d5\u05d2 GABA \u05de\u05d5\u05e0\u05e2\u05ea \u05de\u05d4\u05dd \u05dc\u05e9\u05d7\u05e8\u05e8 GABA, \u05de\u05d4 \u05e9\u05de\u05d5\u05d1\u05d9\u05dc \u05dc\u05d4\u05e4\u05e2\u05dc\u05d4 \u05de\u05d5\u05d2\u05d1\u05e8\u05ea \u05e9\u05dc \u05e0\u05d5\u05d9\u05e8\u05d5\u05e0\u05d9\u05dd \u05e4\u05d9\u05e8\u05de\u05d9\u05d3\u05dc\u05d9\u05d9\u05dd \u05d2\u05dc\u05d5\u05d8\u05de\u05d8\u05e8\u05d2\u05d9\u05d9\u05dd (StahlNeuro p.141).",
      "hint": "\u05de\u05d3\u05d5\u05d1\u05e8 \u05d1\u05de\u05d5\u05dc\u05d9\u05da \u05d4\u05e2\u05e6\u05d1\u05d9 \u05d4\u05de\u05e2\u05db\u05d1 \u05d4\u05e2\u05d9\u05e7\u05e8\u05d9 \u05d1\u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05e2\u05e6\u05d1\u05d9\u05dd \u05d4\u05de\u05e8\u05db\u05d6\u05d9\u05ea."
    },
    {
      "type": "multiple_choice",
      "question": "\u05d9\u05dc\u05d3 \u05d1\u05df 10 \u05de\u05d0\u05d5\u05d1\u05d7\u05df \u05e2\u05dd Childhood-Onset Schizophrenia (COS). \u05de\u05d4\u05d5 \u05d4\u05e0\u05ea\u05d5\u05df \u05d4\u05d0\u05e4\u05d9\u05d3\u05de\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d4\u05de\u05d3\u05d5\u05d9\u05e7 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05d2\u05d1\u05d9 \u05e7\u05d1\u05d5\u05e6\u05ea \u05d2\u05d9\u05dc \u05d6\u05d5 \u05dc\u05e4\u05d9 Dulcan?",
      "answerOptions": [
        {
          "text": "\u05d4\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d4\u05d9\u05d0 \u05e0\u05de\u05d5\u05db\u05d4 \u05de\u05d0\u05d5\u05d3, \u05e4\u05d7\u05d5\u05ea \u05de-1 \u05dc-10,000 \u05d9\u05dc\u05d3\u05d9\u05dd.",
          "isCorrect": true,
          "rationale": "\u05d4\u05d5\u05e4\u05e2\u05ea \u05d4\u05de\u05d7\u05dc\u05d4 \u05dc\u05e4\u05e0\u05d9 \u05d2\u05d9\u05dc 13 \u05d4\u05d9\u05d0 \u05e0\u05d3\u05d9\u05e8\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d5\u05e9\u05db\u05d9\u05d7\u05d5\u05ea\u05d4 \u05e0\u05d0\u05de\u05d3\u05ea \u05d1\u05e4\u05d7\u05d5\u05ea \u05de-0.01% (Dulcan p.390)."
        },
        {
          "text": "\u05e7\u05d9\u05d9\u05de\u05ea \u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05e9\u05d5\u05d5\u05d4 \u05d1\u05d9\u05df \u05d1\u05e0\u05d9\u05dd \u05dc\u05d1\u05e0\u05d5\u05ea \u05d1\u05e7\u05d1\u05d5\u05e6\u05ea \u05d2\u05d9\u05dc \u05d6\u05d5.",
          "isCorrect": false,
          "rationale": "\u05d1-EOS \u05d5-COS \u05d9\u05e9\u05e0\u05d4 \u05d3\u05d5\u05de\u05d9\u05e0\u05e0\u05d8\u05d9\u05d5\u05ea \u05d2\u05d1\u05e8\u05d9\u05ea \u05d1\u05e8\u05d5\u05e8\u05d4 \u05d1\u05d9\u05d7\u05e1 \u05e9\u05e0\u05e2 \u05d1\u05d9\u05df 2:1 \u05dc-5:1 (Dulcan p.390)."
        },
        {
          "text": "\u05d4\u05e4\u05e8\u05d5\u05d2\u05e0\u05d5\u05d6\u05d4 \u05d1-COS \u05d8\u05d5\u05d1\u05d4 \u05d9\u05d5\u05ea\u05e8 \u05de\u05d0\u05e9\u05e8 \u05d1-Adult-Onset Schizophrenia.",
          "isCorrect": false,
          "rationale": "\u05de\u05e7\u05e8\u05d9\u05dd \u05e9\u05dc \u05d4\u05d5\u05e4\u05e2\u05d4 \u05d1\u05d2\u05d9\u05dc \u05d4\u05d9\u05dc\u05d3\u05d5\u05ea \u05e0\u05d5\u05d8\u05d9\u05dd \u05dc\u05d4\u05d9\u05d5\u05ea \u05e7\u05e9\u05d9\u05dd \u05d9\u05d5\u05ea\u05e8, \u05e2\u05dd \u05de\u05d4\u05dc\u05da \u05db\u05e8\u05d5\u05e0\u05d9 \u05d5\u05ea\u05d2\u05d5\u05d1\u05d4 \u05e4\u05d7\u05d5\u05ea \u05d8\u05d5\u05d1\u05d4 \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc (Dulcan p.389)."
        },
        {
          "text": "\u05d4\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05dd \u05d4\u05e9\u05db\u05d9\u05d7 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d4\u05d5\u05d0 \u05de\u05d7\u05e9\u05d1\u05d5\u05ea \u05e9\u05d5\u05d5\u05d0 \u05d2\u05e8\u05e0\u05d3\u05d9\u05d5\u05d6\u05d9\u05d5\u05ea \u05de\u05d5\u05e8\u05db\u05d1\u05d5\u05ea.",
          "isCorrect": false,
          "rationale": "\u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d4\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05d4\u05d7\u05d9\u05d5\u05d1\u05d9\u05d9\u05dd \u05e4\u05d7\u05d5\u05ea \u05de\u05d5\u05d1\u05d7\u05e0\u05d9\u05dd \u05de\u05d0\u05e9\u05e8 \u05d1\u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd, \u05d5\u05dc\u05e2\u05d9\u05ea\u05d9\u05dd \u05e7\u05e8\u05d5\u05d1\u05d5\u05ea \u05d9\u05e9 \u05d3\u05d5\u05de\u05d9\u05e0\u05e0\u05d8\u05d9\u05d5\u05ea \u05e9\u05dc \u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05e9\u05dc\u05d9\u05dc\u05d9\u05d9\u05dd \u05d5\u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9\u05d9\u05dd (Dulcan p.393)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05de\u05d9\u05d3\u05ea \u05d4\u05e0\u05d3\u05d9\u05e8\u05d5\u05ea \u05e9\u05dc \u05d4\u05de\u05d7\u05dc\u05d4 \u05d1\u05d2\u05d9\u05dc\u05d0\u05d9\u05dd \u05e6\u05e2\u05d9\u05e8\u05d9\u05dd \u05de\u05d0\u05d5\u05d3 \u05d5\u05e2\u05dc \u05d4\u05d4\u05d1\u05d3\u05dc\u05d9\u05dd \u05d1\u05d9\u05df \u05d4\u05de\u05d9\u05e0\u05d9\u05dd \u05dc\u05e4\u05e0\u05d9 \u05d2\u05d9\u05dc \u05d4\u05d4\u05ea\u05d1\u05d2\u05e8\u05d5\u05ea."
