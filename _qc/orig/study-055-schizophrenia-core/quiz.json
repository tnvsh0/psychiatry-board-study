{
  "title": "Schizophrenia Quiz",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\u05de\u05ea\u05d1\u05d2\u05e8 \u05d1\u05df 16 \u05de\u05d5\u05d1\u05d0 \u05dc\u05d4\u05e2\u05e8\u05db\u05d4 \u05d1\u05e9\u05dc \u05d9\u05e8\u05d9\u05d3\u05d4 \u05d1\u05ea\u05e4\u05e7\u05d5\u05d3 \u05d4\u05d0\u05e7\u05d3\u05de\u05d9, \u05d4\u05e1\u05ea\u05d2\u05e8\u05d5\u05ea \u05d7\u05d1\u05e8\u05ea\u05d9\u05ea \u05d5\u05de\u05dc\u05de\u05d5\u05dc \u05dc\u05e2\u05e6\u05de\u05d5 \u05e9\u05d4\u05d7\u05dc\u05d5 \u05dc\u05e4\u05e0\u05d9 \u05db-4 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd. \u05d1\u05d7\u05d5\u05d3\u05e9\u05d9\u05d9\u05dd \u05d4\u05d0\u05d7\u05e8\u05d5\u05e0\u05d9\u05dd \u05de\u05d3\u05d5\u05d5\u05d7\u05d9\u05dd \u05d4\u05d5\u05e8\u05d9\u05d5 \u05e2\u05dc \u05e9\u05de\u05d9\u05e2\u05ea \u05e7\u05d5\u05dc\u05d5\u05ea \u05d4\u05de\u05e6\u05d5\u05d5\u05d9\u05dd \u05e2\u05dc\u05d9\u05d5 \u05dc\u05e4\u05d2\u05d5\u05e2 \u05d1\u05e2\u05e6\u05de\u05d5 \u05d5\u05de\u05d7\u05e9\u05d1\u05d5\u05ea \u05e9\u05d5\u05d5\u05d0 \u05e9\u05dc \u05e8\u05d3\u05d9\u05e4\u05d4. \u05de\u05d4\u05d9 \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05de\u05ea\u05d0\u05d9\u05de\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR \u05d1\u05e9\u05dc\u05d1 \u05d6\u05d4?",
      "answerOptions": [
        {
          "text": "Schizophreniform Disorder",
          "isCorrect": true,
          "rationale": "\u05d4\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05e0\u05de\u05e9\u05db\u05d9\u05dd \u05d9\u05d5\u05ea\u05e8 \u05de\u05d7\u05d5\u05d3\u05e9 \u05d0\u05da \u05e4\u05d7\u05d5\u05ea \u05de\u05e9\u05d9\u05e9\u05d4 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd, \u05de\u05d4 \u05e9\u05de\u05ea\u05d0\u05d9\u05dd \u05dc\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df \u05de\u05e9\u05da \u05d4\u05d6\u05de\u05df \u05e9\u05dc \u05d4\u05e4\u05e8\u05e2\u05d4 \u05d6\u05d5 (DSM p.111)."
        },
        {
          "text": "Schizophrenia",
          "isCorrect": false,
          "rationale": "\u05d0\u05d1\u05d7\u05e0\u05ea Schizophrenia \u05d3\u05d5\u05e8\u05e9\u05ea \u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05e9\u05dc \u05e1\u05d9\u05de\u05e0\u05d9 \u05d4\u05e4\u05e8\u05e2\u05d4 \u05de\u05ea\u05de\u05e9\u05db\u05d9\u05dd \u05dc\u05de\u05e9\u05da 6 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05dc\u05e4\u05d7\u05d5\u05ea, \u05d4\u05db\u05d5\u05dc\u05dc\u05d9\u05dd \u05dc\u05e4\u05d7\u05d5\u05ea \u05d7\u05d5\u05d3\u05e9 \u05d0\u05d7\u05d3 \u05e9\u05dc \u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05e4\u05e2\u05d9\u05dc\u05d9\u05dd (DSM p.114)."
        },
        {
          "text": "Brief Psychotic Disorder",
          "isCorrect": false,
          "rationale": "\u05d4\u05e4\u05e8\u05e2\u05d4 \u05d6\u05d5 \u05de\u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05ea \u05d1\u05de\u05d4\u05dc\u05da \u05e9\u05e0\u05de\u05e9\u05da \u05dc\u05e4\u05d7\u05d5\u05ea \u05d9\u05d5\u05dd \u05d0\u05d7\u05d3 \u05d0\u05da \u05e4\u05d7\u05d5\u05ea \u05de\u05d7\u05d5\u05d3\u05e9 \u05d0\u05d7\u05d3, \u05e2\u05dd \u05d7\u05d6\u05e8\u05d4 \u05de\u05dc\u05d0\u05d4 \u05dc\u05ea\u05e4\u05e7\u05d5\u05d3 (DSM p.108)."
        },
        {
          "text": "Schizotypal Personality Disorder",
          "isCorrect": false,
          "rationale": "\u05d6\u05d5\u05d4\u05d9 \u05d4\u05e4\u05e8\u05e2\u05ea \u05d0\u05d9\u05e9\u05d9\u05d5\u05ea \u05d4\u05de\u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05ea \u05d1\u05d3\u05e4\u05d5\u05e1 \u05de\u05ea\u05de\u05e9\u05da \u05e9\u05dc \u05dc\u05d9\u05e7\u05d5\u05d9\u05d9\u05dd \u05d7\u05d1\u05e8\u05ea\u05d9\u05d9\u05dd \u05d5\u05ea\u05e4\u05d9\u05e1\u05ea\u05d9\u05d9\u05dd, \u05d0\u05da \u05dc\u05dc\u05d0 \u05d0\u05e4\u05d9\u05d6\u05d5\u05d3\u05d5\u05ea \u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9\u05d5\u05ea \u05d1\u05d5\u05dc\u05d8\u05d5\u05ea \u05d5\u05de\u05de\u05d5\u05e9\u05db\u05d5\u05ea \u05db\u05de\u05d5 \u05e9\u05ea\u05d5\u05d0\u05e8\u05d5 \u05db\u05d0\u05df (DSM p.104)."
        }
      ],
      "hint": "\u05e9\u05d9\u05dd \u05dc\u05d1 \u05dc\u05de\u05e9\u05da \u05d4\u05d6\u05de\u05df \u05d4\u05db\u05d5\u05dc\u05dc \u05e9\u05dc \u05d4\u05d4\u05e4\u05e8\u05e2\u05d4 \u05de\u05d0\u05d6 \u05ea\u05d7\u05d9\u05dc\u05ea \u05d4\u05d9\u05e8\u05d9\u05d3\u05d4 \u05d1\u05ea\u05e4\u05e7\u05d5\u05d3 \u05d5\u05e2\u05d3 \u05dc\u05de\u05d5\u05e2\u05d3 \u05d4\u05d4\u05e2\u05e8\u05db\u05d4."
    },
    {
      "type": "multiple_choice",
      "question": "\u05de\u05d8\u05d5\u05e4\u05dc \u05e2\u05dd Schizophrenia \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05d1-Haloperidol (DRA) \u05de\u05d3\u05d5\u05d5\u05d7 \u05e2\u05dc \u05d4\u05d7\u05de\u05e8\u05d4 \u05d1\u05ea\u05d7\u05d5\u05e9\u05ea \u05d7\u05d5\u05e1\u05e8 \u05d4\u05e0\u05d0\u05d4 (anhedonia), \u05d0\u05e4\u05d0\u05ea\u05d9\u05d5\u05ea \u05d5\u05d7\u05d5\u05e1\u05e8 \u05de\u05d5\u05d8\u05d9\u05d1\u05e6\u05d9\u05d4, \u05dc\u05de\u05e8\u05d5\u05ea \u05e9\u05e7\u05d5\u05dc\u05d5\u05ea \u05d4\u05e8\u05e7\u05e2 \u05e0\u05e4\u05e1\u05e7\u05d5. \u05dc\u05e4\u05d9 \u05d4\u05ea\u05d9\u05d0\u05d5\u05e8\u05d9\u05d4 \u05e9\u05dc StahlNeuro, \u05de\u05d4\u05d5 \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05e1\u05d1\u05d9\u05e8 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05ea\u05d5\u05e4\u05e2\u05d4 \u05d6\u05d5?",
      "answerOptions": [
        {
          "text": "Blockade of D2 receptors in the mesolimbic pathway",
          "isCorrect": true,
          "rationale": "\u05d7\u05e1\u05d9\u05de\u05ea \u05e8\u05e6\u05e4\u05d8\u05d5\u05e8\u05d9 D2 \u05d1\u05de\u05e1\u05dc\u05d5\u05dc \u05d4\u05de\u05e1\u05d5\u05dc\u05d9\u05de\u05d1\u05d9/\u05de\u05e1\u05d5\u05e1\u05d8\u05e8\u05d9\u05d0\u05d8\u05dc\u05d9 \u05de\u05e4\u05d7\u05d9\u05ea\u05d4 \u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d4 \u05d0\u05da \u05d2\u05dd \u05e4\u05d5\u05d2\u05e2\u05ea \u05d1\u05de\u05e0\u05d2\u05e0\u05d5\u05e0\u05d9 \u05d2\u05de\u05d5\u05dc \u05d5\u05d4\u05e0\u05d0\u05d4, \u05de\u05d4 \u05e9\u05de\u05d5\u05d1\u05d9\u05dc \u05dc-secondary negative symptoms (StahlNeuro p.162)."
        },
        {
          "text": "Hypoactivity of dopamine in the mesocortical pathway to the DLPFC",
          "isCorrect": false,
          "rationale": "\u05ea\u05ea-\u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05e9\u05dc \u05d3\u05d5\u05e4\u05de\u05d9\u05df \u05d1\u05de\u05e1\u05dc\u05d5\u05dc \u05d6\u05d4 \u05de\u05e7\u05d5\u05e9\u05e8\u05ea \u05dc\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9\u05d9\u05dd \u05d5\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05e9\u05dc\u05d9\u05dc\u05d9\u05d9\u05dd \u05e8\u05d0\u05e9\u05d5\u05e0\u05d9\u05d9\u05dd \u05e9\u05dc \u05d4\u05de\u05d7\u05dc\u05d4 \u05e2\u05e6\u05de\u05d4, \u05d5\u05dc\u05d0 \u05d1\u05d4\u05db\u05e8\u05d7 \u05dc\u05ea\u05d5\u05e4\u05e2\u05ea \u05d4\u05dc\u05d5\u05d5\u05d0\u05d9 \u05d4\u05ea\u05e8\u05d5\u05e4\u05ea\u05d9\u05ea \u05d4\u05de\u05ea\u05d5\u05d0\u05e8\u05ea (StahlNeuro p.94)."
        },
        {
          "text": "Hyperactivity of glutamate output from the prefrontal cortex",
          "isCorrect": false,
          "rationale": "\u05d4\u05d9\u05e4\u05e8-\u05d0\u05e7\u05d8\u05d9\u05d1\u05d9\u05d5\u05ea \u05e9\u05dc \u05d2\u05dc\u05d5\u05d8\u05de\u05d8 \u05de\u05e7\u05d5\u05e9\u05e8\u05ea \u05d1\u05ea\u05d9\u05d0\u05d5\u05e8\u05d9\u05d4 \u05e9\u05dc StahlNeuro \u05dc\u05d4\u05e4\u05e2\u05dc\u05d4 \u05e2\u05d5\u05d3\u05e4\u05ea \u05e9\u05dc \u05d3\u05d5\u05e4\u05de\u05d9\u05df \u05d1\u05de\u05e1\u05dc\u05d5\u05dc \u05d4\u05de\u05e1\u05d5\u05dc\u05d9\u05de\u05d1\u05d9 \u05d4\u05d2\u05d5\u05e8\u05de\u05ea \u05dc\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05d7\u05d9\u05d5\u05d1\u05d9\u05d9\u05dd (StahlNeuro p.141)."
        },
        {
          "text": "NMDA receptor hypofunction on cortical GABA interneurons",
          "isCorrect": false,
          "rationale": "\u05d6\u05d4\u05d5 \u05d4\u05d1\u05e1\u05d9\u05e1 \u05d4\u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d4\u05de\u05d5\u05e6\u05e2 \u05dc\u05ea\u05d7\u05d9\u05dc\u05ea \u05d4\u05e9\u05e8\u05e9\u05e8\u05ea \u05d4\u05d2\u05d5\u05e8\u05de\u05ea \u05dc\u05d3\u05d9\u05e1-\u05e8\u05d2\u05d5\u05dc\u05e6\u05d9\u05d4 \u05e9\u05dc \u05d3\u05d5\u05e4\u05de\u05d9\u05df, \u05d0\u05da \u05d4\u05d5\u05d0 \u05d0\u05d9\u05e0\u05d5 \u05de\u05e1\u05d1\u05d9\u05e8 \u05d9\u05e9\u05d9\u05e8\u05d5\u05ea \u05d0\u05ea \u05ea\u05d5\u05e4\u05e2\u05ea \u05d4\u05dc\u05d5\u05d5\u05d0\u05d9 \u05e9\u05dc \u05d7\u05e1\u05d9\u05de\u05ea \u05d4\u05e8\u05e6\u05e4\u05d8\u05d5\u05e8\u05d9\u05dd (StahlNeuro p.141)."
        }
      ],
      "hint": "\u05d4\u05ea\u05de\u05e7\u05d3 \u05d1\u05d4\u05e9\u05e4\u05e2\u05d4 \u05e9\u05dc \u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05d7\u05d5\u05e1\u05de\u05d5\u05ea \u05d3\u05d5\u05e4\u05de\u05d9\u05df \u05e2\u05dc \u05de\u05e8\u05db\u05d6 \u05d4\u05d4\u05e0\u05d0\u05d4 \u05d1\u05de\u05d5\u05d7."
    },
    {
      "type": "multiple_select",
      "question": "\u05d0\u05d9\u05dc\u05d5 \u05de\u05d4\u05de\u05de\u05e6\u05d0\u05d9\u05dd \u05d4\u05d1\u05d0\u05d9\u05dd \u05ea\u05d5\u05de\u05db\u05d9\u05dd \u05d1\u05de\u05d5\u05d3\u05dc \u05d4-neurodevelopmental \u05e9\u05dc Schizophrenia \u05dc\u05e4\u05d9 Dulcan \u05d5-Synopsis?",
      "answerOptions": [
        {
          "text": "\u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05e9\u05dc 'Neurological soft signs' \u05db\u05d2\u05d5\u05df \u05dc\u05d9\u05e7\u05d5\u05d9\u05d9\u05dd \u05d1\u05e7\u05d5\u05d0\u05d5\u05e8\u05d3\u05d9\u05e0\u05e6\u05d9\u05d4 \u05de\u05d5\u05d8\u05d5\u05e8\u05d9\u05ea \u05d5\u05d0\u05d9\u05e0\u05d8\u05d2\u05e8\u05e6\u05d9\u05d4 \u05e1\u05e0\u05e1\u05d5\u05e8\u05d9\u05ea (DSM p.117).",
          "isCorrect": true,
          "rationale": "\u05e1\u05d9\u05de\u05e0\u05d9\u05dd \u05d0\u05dc\u05d5 \u05de\u05e2\u05d9\u05d3\u05d9\u05dd \u05e2\u05dc \u05dc\u05d9\u05e7\u05d5\u05d9\u05d9\u05dd \u05e0\u05d5\u05d9\u05e8\u05d5\u05dc\u05d5\u05d2\u05d9\u05d9\u05dd \u05e2\u05d3\u05d9\u05e0\u05d9\u05dd \u05e9\u05e7\u05d9\u05d9\u05de\u05d9\u05dd \u05dc\u05e2\u05d9\u05ea\u05d9\u05dd \u05e7\u05e8\u05d5\u05d1\u05d5\u05ea \u05e2\u05d5\u05d3 \u05dc\u05e4\u05e0\u05d9 \u05e4\u05e8\u05d5\u05e5 \u05d4\u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d4 (DSM p.117)."
        },
        {
          "text": "\u05e7\u05e9\u05e8 \u05d2\u05e0\u05d8\u05d9 \u05dc\u05d5\u05e8\u05d9\u05d0\u05e0\u05d8\u05d9\u05dd \u05e9\u05dc C4 alleles \u05d4\u05de\u05e2\u05d5\u05e8\u05d1\u05d9\u05dd \u05d1\u05ea\u05d4\u05dc\u05d9\u05da \u05d4-synaptic pruning (Synopsis ch.5).",
          "isCorrect": true,
          "rationale": "\u05de\u05d7\u05e7\u05e8\u05d9\u05dd \u05de\u05e6\u05d1\u05d9\u05e2\u05d9\u05dd \u05e2\u05dc \u05db\u05da \u05e9\u05d2\u05d9\u05d6\u05d5\u05dd \u05e1\u05d9\u05e0\u05e4\u05d8\u05d9 \u05de\u05d5\u05d2\u05d1\u05e8 \u05d1\u05d6\u05de\u05df \u05d4\u05d4\u05ea\u05d1\u05d2\u05e8\u05d5\u05ea \u05ea\u05d5\u05e8\u05dd \u05dc\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea \u05d4\u05de\u05d7\u05dc\u05d4 (Synopsis ch.5)."
        },
        {
          "text": "\u05d4\u05d9\u05e2\u05d3\u05e8 \u05d2\u05dc\u05d9\u05d5\u05d6\u05d9\u05e1 (gliosis) \u05d1\u05d1\u05d3\u05d9\u05e7\u05d5\u05ea \u05e4\u05d5\u05e1\u05d8-\u05de\u05d5\u05e8\u05d8\u05dd \u05e9\u05dc \u05d4\u05de\u05d5\u05d7 (Synopsis ch.5).",
          "isCorrect": true,
          "rationale": "\u05d4\u05d9\u05e2\u05d3\u05e8 \u05d2\u05dc\u05d9\u05d5\u05d6\u05d9\u05e1 \u05de\u05e6\u05d1\u05d9\u05e2 \u05e2\u05dc \u05db\u05da \u05e9\u05d4\u05ea\u05d4\u05dc\u05d9\u05da \u05d4\u05d5\u05d0 \u05e9\u05dc \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea \u05dc\u05d0 \u05ea\u05e7\u05d9\u05e0\u05d4 \u05d5\u05dc\u05d0 \u05e9\u05dc \u05e0\u05d9\u05d5\u05d5\u05df \u05e2\u05e6\u05d1\u05d9 (neurodegeneration) \u05d0\u05e7\u05d8\u05d9\u05d1\u05d9 \u05dc\u05d0\u05d7\u05e8 \u05e9\u05d4\u05de\u05d5\u05d7 \u05db\u05d1\u05e8 \u05e0\u05d5\u05e6\u05e8 (Synopsis ch.5)."
        },
        {
          "text": "\u05e2\u05dc\u05d9\u05d9\u05d4 \u05d4\u05d3\u05e8\u05d2\u05ea\u05d9\u05ea \u05d1\u05e0\u05e4\u05d7 \u05d4\u05d7\u05d5\u05de\u05e8 \u05d4\u05d0\u05e4\u05d5\u05e8 \u05d1\u05de\u05d5\u05d7 \u05d1\u05de\u05d4\u05dc\u05da \u05d2\u05d9\u05dc \u05d4\u05d4\u05ea\u05d1\u05d2\u05e8\u05d5\u05ea (Dulcan p.392).",
          "isCorrect": false,
          "rationale": "\u05d1-COS \u05e0\u05e6\u05e4\u05d9\u05ea \u05d3\u05d5\u05d5\u05e7\u05d0 \u05d9\u05e8\u05d9\u05d3\u05d4 \u05de\u05d4\u05d9\u05e8\u05d4 \u05d5\u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05d1\u05e0\u05e4\u05d7 \u05d4\u05d7\u05d5\u05de\u05e8 \u05d4\u05d0\u05e4\u05d5\u05e8 (gray matter) \u05e2\u05e7\u05d1 \u05d2\u05d9\u05d6\u05d5\u05dd \u05e1\u05d9\u05e0\u05e4\u05d8\u05d9 \u05de\u05d5\u05d2\u05d1\u05e8 (Dulcan p.392)."
        }
