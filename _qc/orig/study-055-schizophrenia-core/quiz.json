    {
      "type": "short_answer",
      "question": "\u05db\u05d9\u05e6\u05d3 \u05e0\u05d9\u05ea\u05df \u05dc\u05d4\u05d1\u05d7\u05d9\u05df \u05d1\u05d9\u05df \u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc Schizoaffective Disorder \u05dc\u05d1\u05d9\u05df Schizophrenia \u05e2\u05dd \u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05e9\u05dc \u05de\u05e6\u05d1 \u05e8\u05d5\u05d7 \u05dc\u05e4\u05d9 \u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05e9\u05dc \u05d4-DSM-5-TR?",
      "grading": {
        "modelAnswer": "\u05d1\u05d0\u05d1\u05d7\u05e0\u05ea Schizoaffective Disorder, \u05d7\u05d9\u05d9\u05d1\u05ea \u05dc\u05d4\u05d9\u05d5\u05ea \u05ea\u05e7\u05d5\u05e4\u05d4 \u05e9\u05dc \u05e9\u05d1\u05d5\u05e2\u05d9\u05d9\u05dd \u05dc\u05e4\u05d7\u05d5\u05ea \u05e9\u05dc \u05de\u05d7\u05e9\u05d1\u05d5\u05ea \u05e9\u05d5\u05d5\u05d0 \u05d0\u05d5 \u05d4\u05d6\u05d9\u05d5\u05ea \u05dc\u05dc\u05d0 \u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05d1\u05d5\u05dc\u05d8\u05d9\u05dd \u05e9\u05dc \u05de\u05e6\u05d1 \u05e8\u05d5\u05d7 \u05d1\u05de\u05d4\u05dc\u05da \u05de\u05e9\u05da \u05d4\u05de\u05d7\u05dc\u05d4. \u05d1\u05e0\u05d5\u05e1\u05e3, \u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05e9\u05dc \u05d0\u05e4\u05d9\u05d6\u05d5\u05d3\u05ea \u05de\u05e6\u05d1 \u05e8\u05d5\u05d7 \u05de\u05dc\u05d0\u05d4 \u05e6\u05e8\u05d9\u05db\u05d9\u05dd \u05dc\u05d4\u05d9\u05d5\u05ea \u05e0\u05d5\u05db\u05d7\u05d9\u05dd \u05dc\u05d0\u05d5\u05e8\u05da \u05e8\u05d5\u05d1 \u05de\u05e9\u05da \u05d4\u05de\u05d7\u05dc\u05d4 \u05d4\u05e4\u05e2\u05d9\u05dc\u05d4 (DSM p.121).",
        "rationale": "\u05d4\u05d4\u05d1\u05d7\u05e0\u05d4 \u05de\u05ea\u05d1\u05e1\u05e1\u05ea \u05e2\u05dc \u05d4\u05ea\u05d6\u05de\u05d5\u05df \u05e9\u05dc \u05d4\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05d4\u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9\u05d9\u05dd \u05d1\u05d9\u05d7\u05e1 \u05dc\u05d0\u05e4\u05d9\u05d6\u05d5\u05d3\u05d5\u05ea \u05de\u05e6\u05d1 \u05d4\u05e8\u05d5\u05d7 \u05d5\u05e2\u05dc \u05d4\u05e4\u05e8\u05d5\u05e4\u05d5\u05e8\u05e6\u05d9\u05d4 \u05e9\u05dc \u05d6\u05de\u05df \u05d4\u05de\u05e6\u05d1 \u05e8\u05d5\u05d7 \u05de\u05db\u05dc\u05dc \u05d4\u05de\u05d7\u05dc\u05d4.",
        "requiredAttributes": [
          "\u05e6\u05d9\u05d5\u05df \u05d4\u05ea\u05e7\u05d5\u05e4\u05d4 \u05e9\u05dc \u05e9\u05d1\u05d5\u05e2\u05d9\u05d9\u05dd \u05e9\u05dc \u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d4 \u05dc\u05dc\u05d0 \u05de\u05e6\u05d1 \u05e8\u05d5\u05d7.",
          "\u05e6\u05d9\u05d5\u05df \u05e9\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9 \u05d4\u05de\u05e6\u05d1 \u05e8\u05d5\u05d7 \u05e0\u05d5\u05db\u05d7\u05d9\u05dd \u05d1\u05e8\u05d5\u05d1 \u05de\u05e9\u05da \u05d4\u05de\u05d7\u05dc\u05d4 (majority of total duration)."
        ],
        "errors": {
