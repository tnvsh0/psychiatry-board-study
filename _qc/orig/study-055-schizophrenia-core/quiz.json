    {
      "type": "multiple_choice",
      "question": "\u05de\u05ea\u05d1\u05d2\u05e8 \u05d1\u05df 17 \u05e1\u05d5\u05d1\u05dc \u05de\u05d4\u05ea\u05e7\u05e4\u05d9\u05dd \u05d0\u05e4\u05d9\u05dc\u05e4\u05d8\u05d9\u05d9\u05dd \u05de\u05e1\u05d5\u05d2 Complex Partial Seizures. \u05d4\u05d5\u05d0 \u05de\u05ea\u05d7\u05d9\u05dc \u05dc\u05e4\u05ea\u05d7 \u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05d3\u05de\u05d5\u05d9\u05d9 \u05e1\u05db\u05d9\u05d6\u05d5\u05e4\u05e8\u05e0\u05d9\u05d4 \u05db\u05d2\u05d5\u05df \u05de\u05d7\u05e9\u05d1\u05d5\u05ea \u05e9\u05d5\u05d5\u05d0 \u05e9\u05dc \u05d9\u05d7\u05e1 \u05d5\u05d4\u05d6\u05d9\u05d5\u05ea \u05e9\u05de\u05d9\u05e2\u05d4. \u05dc\u05e4\u05d9 \u05d4-Synopsis, \u05d0\u05d9\u05d6\u05d4 \u05de\u05de\u05e6\u05d0 \u05e0\u05d5\u05d9\u05e8\u05d5\u05dc\u05d5\u05d2\u05d9 \u05de\u05e2\u05dc\u05d4 \u05d0\u05ea \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea \u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d4 \u05db\u05d6\u05d5?",
      "answerOptions": [
        {
          "text": "A left-sided seizure focus in the temporal lobe",
          "isCorrect": true,
          "rationale": "\u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d5\u05ea \u05d3\u05de\u05d5\u05d9\u05d5\u05ea \u05e1\u05db\u05d9\u05d6\u05d5\u05e4\u05e8\u05e0\u05d9\u05d4 \u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d9\u05d5\u05ea\u05e8 \u05d1\u05d7\u05d5\u05dc\u05d9\u05dd \u05e2\u05dd \u05de\u05d5\u05e7\u05d3 \u05d0\u05e4\u05d9\u05dc\u05e4\u05d8\u05d9 \u05e6\u05d3 \u05e9\u05de\u05d0\u05dc\u05d9 \u05d1\u05d0\u05d5\u05e0\u05d4 \u05d4\u05d8\u05de\u05e4\u05d5\u05e8\u05dc\u05d9\u05ea (Synopsis ch.5)."
        },
        {
          "text": "A right-sided seizure focus in the frontal lobe",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05e9\u05e4\u05d2\u05d9\u05e2\u05d5\u05ea \u05e4\u05e8\u05d5\u05e0\u05d8\u05dc\u05d9\u05d5\u05ea \u05de\u05e9\u05e4\u05d9\u05e2\u05d5\u05ea \u05e2\u05dc \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea, \u05d4\u05e7\u05e9\u05e8 \u05d4\u05e1\u05e4\u05e6\u05d9\u05e4\u05d9 \u05dc\u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d4 \u05d3\u05de\u05d5\u05d9\u05ea \u05e1\u05db\u05d9\u05d6\u05d5\u05e4\u05e8\u05e0\u05d9\u05d4 \u05d1\u05d0\u05e4\u05d9\u05dc\u05e4\u05e1\u05d9\u05d4 \u05de\u05d5\u05d3\u05d2\u05e9 \u05d1\u05de\u05d5\u05e7\u05d3\u05d9\u05dd \u05d8\u05de\u05e4\u05d5\u05e8\u05dc\u05d9\u05d9\u05dd \u05e9\u05de\u05d0\u05dc\u05d9\u05d9\u05dd (Synopsis ch.5)."
        },
        {
          "text": "Bilateral involvement of the occipital lobes",
          "isCorrect": false,
          "rationale": "\u05e0\u05d2\u05e2\u05d9\u05dd \u05d1\u05d0\u05d5\u05e0\u05d4 \u05d4\u05d0\u05d5\u05e7\u05e1\u05d9\u05e4\u05d9\u05d8\u05dc\u05d9\u05ea \u05de\u05e7\u05d5\u05e9\u05e8\u05d9\u05dd \u05d9\u05d5\u05ea\u05e8 \u05dc\u05d4\u05d6\u05d9\u05d5\u05ea \u05e8\u05d0\u05d9\u05d9\u05d4 \u05e4\u05e9\u05d5\u05d8\u05d5\u05ea \u05d5\u05e4\u05d7\u05d5\u05ea \u05dc\u05ea\u05de\u05d5\u05e0\u05d4 \u05e9\u05dc \u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d4 \u05de\u05d5\u05e8\u05db\u05d1\u05ea (Synopsis ch.5)."
        },
        {
          "text": "Generalized tonic-clonic seizures without a focal onset",
          "isCorrect": false,
          "rationale": "\u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d4 \u05d2\u05d1\u05d5\u05d4 \u05d9\u05d5\u05ea\u05e8 \u05d1\u05d0\u05e4\u05d9\u05dc\u05e4\u05e1\u05d9\u05d4 \u05de\u05d5\u05e7\u05d3\u05d9\u05ea \u05e9\u05dc \u05d4\u05d0\u05d5\u05e0\u05d4 \u05d4\u05d8\u05de\u05e4\u05d5\u05e8\u05dc\u05d9\u05ea \u05de\u05d0\u05e9\u05e8 \u05d1\u05d0\u05e4\u05d9\u05dc\u05e4\u05e1\u05d9\u05d4 \u05db\u05dc\u05dc\u05d9\u05ea (Synopsis ch.5)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05de\u05d9\u05e7\u05d5\u05dd \u05d4\u05de\u05d5\u05d7\u05d9 \u05d4\u05de\u05e7\u05d5\u05e9\u05e8 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05e2\u05d9\u05d1\u05d5\u05d3 \u05e9\u05e4\u05d4 \u05d5\u05de\u05e9\u05de\u05e2\u05d5\u05ea, \u05e9\u05e4\u05d2\u05d9\u05e2\u05d4 \u05d1\u05d5 \u05e2\u05dc\u05d5\u05dc\u05d4 \u05dc\u05d4\u05d5\u05d1\u05d9\u05dc \u05dc\u05de\u05d7\u05e9\u05d1\u05d5\u05ea \u05e9\u05d5\u05d5\u05d0 \u05d5\u05d4\u05d6\u05d9\u05d5\u05ea \u05e9\u05de\u05d9\u05e2\u05d4."
    },
    {
      "type": "multiple_choice",
      "question": "\u05de\u05d4\u05d5 \u05d4\u05d2\u05d5\u05e8\u05dd \u05d4\u05de\u05e0\u05d1\u05d0 (predictor) \u05d4\u05d8\u05d5\u05d1 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05e8\u05de\u05ea \u05d4\u05ea\u05e4\u05e7\u05d5\u05d3 \u05e9\u05dc \u05d7\u05d5\u05dc\u05d9 \u05e1\u05db\u05d9\u05d6\u05d5\u05e4\u05e8\u05e0\u05d9\u05d4 \u05de\u05d7\u05d5\u05e5 \u05dc\u05d0\u05e9\u05e4\u05d5\u05d6, \u05dc\u05e4\u05d9 \u05d4-Synopsis?",
      "answerOptions": [
        {
          "text": "The severity of subtle cognitive impairment",
          "isCorrect": true,
          "rationale": "\u05dc\u05d9\u05e7\u05d5\u05d9\u05d9\u05dd \u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9\u05d9\u05dd (\u05db\u05de\u05d5 \u05d1\u05d6\u05d9\u05db\u05e8\u05d5\u05df \u05e2\u05d1\u05d5\u05d3\u05d4 \u05d5\u05ea\u05e4\u05e7\u05d5\u05d3\u05d9\u05dd \u05e0\u05d9\u05d4\u05d5\u05dc\u05d9\u05d9\u05dd) \u05d4\u05dd \u05de\u05e0\u05d1\u05d0 \u05d8\u05d5\u05d1 \u05d9\u05d5\u05ea\u05e8 \u05dc\u05ea\u05e4\u05e7\u05d5\u05d3 \u05de\u05d0\u05e9\u05e8 \u05d7\u05d5\u05de\u05e8\u05ea \u05d4\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05d4\u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9\u05d9\u05dd (Synopsis ch.5)."
        },
        {
          "text": "The frequency of auditory hallucinations",
          "isCorrect": false,
          "rationale": "\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05d7\u05d9\u05d5\u05d1\u05d9\u05d9\u05dd \u05db\u05de\u05d5 \u05d4\u05d6\u05d9\u05d5\u05ea \u05d9\u05db\u05d5\u05dc\u05d9\u05dd \u05dc\u05d4\u05d9\u05d5\u05ea \u05d1\u05d5\u05dc\u05d8\u05d9\u05dd \u05d0\u05da \u05d4\u05dd \u05d0\u05d9\u05e0\u05dd \u05d4\u05de\u05e0\u05d1\u05d0 \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05dc\u05ea\u05e4\u05e7\u05d5\u05d3 \u05d9\u05d5\u05de\u05d9\u05d5\u05de\u05d9 \u05d0\u05e8\u05d5\u05da \u05d8\u05d5\u05d5\u05d7 (Synopsis ch.5)."
        },
        {
          "text": "The presence of grandiose delusions",
          "isCorrect": false,
          "rationale": "\u05de\u05d7\u05e9\u05d1\u05d5\u05ea \u05e9\u05d5\u05d5\u05d0 \u05d4\u05df \u05d7\u05dc\u05e7 \u05de\u05d4\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05d4\u05d7\u05d9\u05d5\u05d1\u05d9\u05d9\u05dd \u05e9\u05e0\u05d5\u05d8\u05d9\u05dd \u05dc\u05d4\u05d2\u05d9\u05d1 \u05d8\u05d5\u05d1 \u05d9\u05d5\u05ea\u05e8 \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05ea\u05e8\u05d5\u05e4\u05ea\u05d9 \u05d5\u05d0\u05d9\u05e0\u05df \u05d4\u05de\u05e0\u05d1\u05d0 \u05d4\u05e2\u05d9\u05e7\u05e8\u05d9 \u05dc\u05e0\u05db\u05d5\u05ea (Synopsis ch.5)."
        },
        {
          "text": "The level of premorbid social activity",
          "isCorrect": false,
          "rationale": "\u05ea\u05e4\u05e7\u05d5\u05d3 \u05e4\u05e8\u05d4-\u05de\u05d5\u05e8\u05d1\u05d9\u05d3\u05d9 \u05d4\u05d5\u05d0 \u05d2\u05d5\u05e8\u05dd \u05e4\u05e8\u05d5\u05d2\u05e0\u05d5\u05e1\u05d8\u05d9 \u05d7\u05e9\u05d5\u05d1, \u05d0\u05da \u05d4\u05dc\u05d9\u05e7\u05d5\u05d9 \u05d4\u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9 \u05d4\u05e0\u05d5\u05db\u05d7\u05d9 \u05d4\u05d5\u05d0 \u05d4\u05de\u05e0\u05d1\u05d0 \u05d4\u05d9\u05e9\u05d9\u05e8 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05ea\u05e4\u05e7\u05d5\u05d3 \u05d4\u05e0\u05d5\u05db\u05d7\u05d9 (Synopsis ch.5)."
        }
      ],
      "hint": "\u05d4\u05ea\u05de\u05e7\u05d3 \u05d1\u05ea\u05d7\u05d5\u05dd \u05e9\u05de\u05e9\u05e4\u05d9\u05e2 \u05e2\u05dc \u05d4\u05d9\u05db\u05d5\u05dc\u05ea \u05dc\u05d1\u05e6\u05e2 \u05de\u05e9\u05d9\u05de\u05d5\u05ea \u05d9\u05d5\u05de\u05d9\u05d5\u05de\u05d9\u05d5\u05ea, \u05dc\u05e2\u05d1\u05d5\u05d3 \u05d5\u05dc\u05dc\u05de\u05d5\u05d3, \u05d2\u05dd \u05db\u05e9\u05d0\u05d9\u05df \u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d4 \u05e4\u05e2\u05d9\u05dc\u05d4."
    }
  ]
}