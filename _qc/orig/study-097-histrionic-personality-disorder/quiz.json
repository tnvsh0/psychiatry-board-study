{
  "title": "Histrionic Quiz",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\u05de\u05d8\u05d5\u05e4\u05dc\u05ea \u05d1\u05ea 19 \u05de\u05d5\u05e4\u05e0\u05d9\u05ea \u05dc\u05d4\u05e2\u05e8\u05db\u05d4 \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d4\u05de\u05e2\u05e1\u05d9\u05e7 \u05e9\u05dc\u05d4 \u05d1\u05e9\u05dc \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea '\u05d3\u05e8\u05de\u05d8\u05d9\u05ea \u05de\u05d3\u05d9' \u05d1\u05de\u05e9\u05e8\u05d3. \u05d1\u05e8\u05d0\u05d9\u05d5\u05df, \u05d4\u05d9\u05d0 \u05dc\u05d1\u05d5\u05e9\u05d4 \u05d1\u05d1\u05d2\u05d3\u05d9\u05dd \u05e6\u05d1\u05e2\u05d5\u05e0\u05d9\u05d9\u05dd \u05d5\u05e4\u05e8\u05d5\u05d1\u05d5\u05e7\u05d8\u05d9\u05d1\u05d9\u05d9\u05dd, \u05de\u05d3\u05d1\u05e8\u05ea \u05d1\u05d8\u05d5\u05df \u05ea\u05d9\u05d0\u05d8\u05e8\u05dc\u05d9 \u05d5\u05e0\u05d5\u05d8\u05d4 \u05dc\u05d4\u05d7\u05de\u05d9\u05d0 \u05dc\u05e7\u05dc\u05d9\u05e0\u05d0\u05d9 \u05d1\u05d0\u05d5\u05e4\u05df \u05de\u05d5\u05e4\u05e8\u05d6. \u05d4\u05d9\u05d0 \u05de\u05ea\u05d0\u05e8\u05ea \u05e7\u05e9\u05e8\u05d9\u05dd \u05e2\u05dd \u05e2\u05de\u05d9\u05ea\u05d9\u05dd \u05dc\u05e2\u05d1\u05d5\u05d3\u05d4 \u05db'\u05d7\u05d1\u05e8\u05d9 \u05e0\u05e4\u05e9' \u05dc\u05de\u05e8\u05d5\u05ea \u05e9\u05d4\u05db\u05d9\u05e8\u05d4 \u05d0\u05d5\u05ea\u05dd \u05e9\u05d1\u05d5\u05e2\u05d5\u05ea \u05d1\u05d5\u05d3\u05d3\u05d9\u05dd. \u05e2\u05dd \u05d6\u05d0\u05ea, \u05d4\u05d9\u05d0 \u05de\u05db\u05d7\u05d9\u05e9\u05d4 \u05ea\u05d7\u05d5\u05e9\u05d5\u05ea \u05e9\u05dc \u05e8\u05d9\u05e7\u05e0\u05d5\u05ea \u05db\u05e8\u05d5\u05e0\u05d9\u05ea, \u05d0\u05d9\u05e0\u05d4 \u05de\u05e6\u05d9\u05d2\u05d4 \u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4 \u05e9\u05dc self-harm, \u05d5\u05d4\u05d0\u05e4\u05e7\u05d8 \u05e9\u05dc\u05d4 \u05e0\u05e8\u05d0\u05d4 \u05de\u05e9\u05ea\u05e0\u05d4 \u05d1\u05de\u05d4\u05d9\u05e8\u05d5\u05ea \u05d5\u05e9\u05d8\u05d7\u05d9. \u05de\u05d4\u05d9 \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05de\u05d1\u05d3\u05dc\u05ea \u05d4\u05e1\u05d1\u05d9\u05e8\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d5\u05de\u05d4\u05d5 \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05d4\u05de\u05d1\u05d3\u05d9\u05dc \u05d0\u05d5\u05ea\u05d4 \u05de-Borderline Personality Disorder (BPD)?",
      "answerOptions": [
        {
          "text": "\u05d4\u05e4\u05e8\u05e2\u05ea \u05d0\u05d9\u05e9\u05d9\u05d5\u05ea \u05d4\u05d9\u05e1\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05ea (HPD); \u05d4\u05d9\u05e2\u05d3\u05e8 self-mutilation \u05d5\u05e8\u05d9\u05e7\u05e0\u05d5\u05ea \u05e2\u05de\u05d5\u05e7\u05d4.",
          "isCorrect": true,
          "rationale": "\u05dc\u05e4\u05d9 \u05d4-DSM-5-TR \u05d5\u05d4-Synopsis, \u05d1\u05e2\u05d5\u05d3 \u05e9\u05e9\u05ea\u05d9 \u05d4\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05db\u05d5\u05dc\u05dc\u05d5\u05ea \u05e8\u05d2\u05e9\u05e0\u05d5\u05ea \u05d5\u05e6\u05d5\u05e8\u05da \u05d1\u05ea\u05e9\u05d5\u05de\u05ea \u05dc\u05d1, HPD \u05de\u05ea\u05d0\u05e4\u05d9\u05d9\u05e0\u05ea \u05d1\u05d0\u05e4\u05e7\u05d8 \u05e9\u05d8\u05d7\u05d9 \u05d5\u05e4\u05d7\u05d5\u05ea \u05d4\u05e8\u05e1\u05e0\u05d9, \u05d1\u05e2\u05d5\u05d3 BPD \u05db\u05d5\u05dc\u05dc\u05ea \u05e4\u05d2\u05d9\u05e2\u05d4 \u05e2\u05e6\u05de\u05d9\u05ea, \u05ea\u05d7\u05d5\u05e9\u05d5\u05ea \u05e8\u05d9\u05e7\u05e0\u05d5\u05ea \u05d5\u05d6\u05d4\u05d5\u05ea \u05dc\u05d0 \u05d9\u05e6\u05d9\u05d1\u05d4 (DSM p.759; Synopsis ch.19 Personality Disorders)."
        },
        {
          "text": "\u05d4\u05e4\u05e8\u05e2\u05ea \u05d0\u05d9\u05e9\u05d9\u05d5\u05ea \u05e0\u05e8\u05e7\u05d9\u05e1\u05d9\u05e1\u05d8\u05d9\u05ea (NPD); \u05d4\u05e6\u05d5\u05e8\u05da \u05d1\u05d9\u05d9\u05d7\u05d5\u05d3\u05d9\u05d5\u05ea \u05d5\u05e2\u05dc\u05d9\u05d5\u05e0\u05d5\u05ea.",
          "isCorrect": false,
          "rationale": "\u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd \u05e2\u05dd NPD \u05de\u05d7\u05e4\u05e9\u05d9\u05dd \u05ea\u05e9\u05d5\u05de\u05ea \u05dc\u05d1 \u05db\u05d3\u05d9 \u05dc\u05e7\u05d1\u05dc \u05d4\u05e2\u05e8\u05e6\u05d4 \u05e2\u05dc '\u05e2\u05dc\u05d9\u05d5\u05e0\u05d5\u05ea\u05dd', \u05d1\u05e2\u05d5\u05d3 \u05e9\u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd \u05e2\u05dd HPD \u05de\u05d5\u05db\u05e0\u05d9\u05dd \u05dc\u05d4\u05d9\u05e8\u05d0\u05d5\u05ea \u05e9\u05d1\u05d9\u05e8\u05d9\u05dd \u05d0\u05d5 \u05ea\u05dc\u05d5\u05ea\u05d9\u05d9\u05dd \u05d5\u05d1\u05dc\u05d1\u05d3 \u05e9\u05d9\u05e7\u05d1\u05dc\u05d5 \u05ea\u05e9\u05d5\u05de\u05ea \u05dc\u05d1 (DSM p.760)."
        },
        {
          "text": "\u05d4\u05e4\u05e8\u05e2\u05ea \u05d0\u05d9\u05e9\u05d9\u05d5\u05ea \u05d2\u05d1\u05d5\u05dc\u05d9\u05ea (BPD); \u05e7\u05d9\u05d5\u05de\u05dd \u05e9\u05dc \u05e7\u05e9\u05e8\u05d9\u05dd \u05d1\u05d9\u05df-\u05d0\u05d9\u05e9\u05d9\u05d9\u05dd \u05d0\u05d9\u05e0\u05d8\u05e0\u05e1\u05d9\u05d1\u05d9\u05d9\u05dd.",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05e9\u05e9\u05ea\u05d9\u05d4\u05df \u05de\u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05d5\u05ea \u05d1\u05e7\u05e9\u05e8\u05d9\u05dd \u05e1\u05d5\u05e2\u05e8\u05d9\u05dd, \u05d4\u05ea\u05de\u05d5\u05e0\u05d4 \u05e9\u05dc \u05d0\u05e4\u05e7\u05d8 \u05e9\u05d8\u05d7\u05d9 \u05d5\u05d4\u05d9\u05e2\u05d3\u05e8 \u05d0\u05d9\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05d5\u05ea \u05d4\u05e8\u05e1\u05e0\u05d9\u05ea \u05de\u05db\u05d5\u05d5\u05e0\u05ea \u05d9\u05d5\u05ea\u05e8 \u05dc-HPD \u05de\u05d0\u05e9\u05e8 \u05dc-BPD (Synopsis ch.19 Personality Disorders)."
        },
        {
          "text": "\u05d4\u05e4\u05e8\u05e2\u05ea \u05d0\u05d9\u05e9\u05d9\u05d5\u05ea \u05d0\u05e0\u05d8\u05d9\u05e1\u05d5\u05e6\u05d9\u05d0\u05dc\u05d9\u05ea (ASPD); \u05de\u05e0\u05d9\u05e4\u05d5\u05dc\u05d8\u05d9\u05d1\u05d9\u05d5\u05ea \u05dc\u05e6\u05d5\u05e8\u05da \u05e8\u05d5\u05d5\u05d7 \u05d0\u05d9\u05e9\u05d9.",
          "isCorrect": false,
          "rationale": "\u05d1-ASPD \u05d4\u05de\u05e0\u05d9\u05e4\u05d5\u05dc\u05e6\u05d9\u05d4 \u05de\u05db\u05d5\u05d5\u05e0\u05ea \u05dc\u05e8\u05d5\u05d5\u05d7 \u05d7\u05d5\u05de\u05e8\u05d9 \u05d0\u05d5 \u05db\u05d5\u05d7, \u05d1\u05e2\u05d5\u05d3 \u05e9\u05d1-HPD \u05d4\u05de\u05d8\u05e8\u05d4 \u05d4\u05d9\u05d0 \u05d4\u05e9\u05d2\u05ea \u05d4\u05d6\u05e0\u05d4 \u05e8\u05d2\u05e9\u05d9\u05ea \u05d5\u05ea\u05e9\u05d5\u05de\u05ea \u05dc\u05d1 (DSM p.759)."
        }
      ],
      "hint": "\u05d4\u05ea\u05de\u05e7\u05d3\u05d5 \u05d1\u05d0\u05d9\u05db\u05d5\u05ea \u05d4\u05d0\u05e4\u05e7\u05d8 \u05d5\u05d1\u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05d0\u05d5 \u05d4\u05d9\u05e2\u05d3\u05e8 \u05e9\u05dc \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d4\u05e8\u05e1\u05e0\u05d9\u05ea \u05db\u05dc\u05e4\u05d9 \u05d4\u05e2\u05e6\u05de\u05d9."
    },
    {
      "type": "short_answer",
      "question": "\u05d4\u05e1\u05d1\u05e8 \u05d0\u05ea \u05e9\u05e0\u05d9 \u05de\u05e0\u05d2\u05e0\u05d5\u05e0\u05d9 \u05d4\u05d4\u05d2\u05e0\u05d4 \u05d4\u05de\u05e8\u05db\u05d6\u05d9\u05d9\u05dd \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9\u05dd \u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd \u05e2\u05dd Histrionic Personality Disorder \u05dc\u05e4\u05d9 \u05d4\u05d2\u05d9\u05e9\u05d4 \u05d4\u05e4\u05e1\u05d9\u05db\u05d5\u05d3\u05d9\u05e0\u05de\u05d9\u05ea, \u05d5\u05db\u05d9\u05e6\u05d3 \u05d4\u05dd \u05de\u05e9\u05e4\u05d9\u05e2\u05d9\u05dd \u05e2\u05dc \u05d4\u05de\u05d5\u05d3\u05e2\u05d5\u05ea \u05e9\u05dc \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05dc\u05de\u05e0\u05d9\u05e2\u05d9\u05d5.",
      "grading": {
        "modelAnswer": "\u05de\u05e0\u05d2\u05e0\u05d5\u05e0\u05d9 \u05d4\u05d4\u05d2\u05e0\u05d4 \u05d4\u05de\u05e8\u05db\u05d6\u05d9\u05d9\u05dd \u05d4\u05dd \u05d4\u05d3\u05d7\u05e7\u05d4 (Repression) \u05d5\u05d3\u05d9\u05e1\u05d5\u05e6\u05d9\u05d0\u05e6\u05d9\u05d4 (Dissociation). \u05db\u05ea\u05d5\u05e6\u05d0\u05d4 \u05de\u05d4\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05d4\u05d3\u05d7\u05e7\u05d4, \u05d4\u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd \u05d0\u05d9\u05e0\u05dd \u05de\u05d5\u05d3\u05e2\u05d9\u05dd \u05dc\u05e8\u05d2\u05e9\u05d5\u05ea\u05d9\u05d4\u05dd \u05d4\u05d0\u05de\u05d9\u05ea\u05d9\u05d9\u05dd \u05d0\u05d5 \u05dc\u05de\u05e0\u05d9\u05e2\u05d9\u05dd \u05d4\u05e2\u05d5\u05de\u05d3\u05d9\u05dd \u05d1\u05d1\u05e1\u05d9\u05e1 \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea\u05dd \u05d4\u05d3\u05e8\u05de\u05d8\u05d9\u05ea, \u05d5\u05dc\u05db\u05df \u05d4\u05dd \u05de\u05ea\u05e7\u05e9\u05d9\u05dd \u05dc\u05d4\u05e1\u05d1\u05d9\u05e8 \u05d0\u05ea \u05e4\u05e9\u05e8 \u05de\u05e2\u05e9\u05d9\u05d4\u05dd \u05d1\u05e8\u05d0\u05d9\u05d5\u05df (Synopsis ch.19 Personality Disorders).",
        "rationale": "\u05d4\u05d1\u05e0\u05ea \u05de\u05e0\u05d2\u05e0\u05d5\u05e0\u05d9 \u05d4\u05d4\u05d2\u05e0\u05d4 \u05d7\u05d9\u05d5\u05e0\u05d9\u05ea \u05dc\u05d4\u05d1\u05e0\u05ea \u05d4\u05e4\u05e2\u05e8 \u05d1\u05d9\u05df \u05d4\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d4\u05de\u05d5\u05d7\u05e6\u05e0\u05ea \u05dc\u05d1\u05d9\u05df \u05d7\u05d5\u05e1\u05e8 \u05d4\u05ea\u05d5\u05d1\u05e0\u05d4 \u05e9\u05dc \u05d4\u05de\u05d8\u05d5\u05e4\u05dc (Synopsis ch.19 Personality Disorders).",
        "requiredAttributes": [
          "\u05e6\u05d9\u05d5\u05df \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df Repression (\u05d4\u05d3\u05d7\u05e7\u05d4).",
          "\u05e6\u05d9\u05d5\u05df \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df Dissociation (\u05d3\u05d9\u05e1\u05d5\u05e6\u05d9\u05d0\u05e6\u05d9\u05d4).",
          "\u05d4\u05e1\u05d1\u05e8 \u05e9\u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05d0\u05d9\u05e0\u05d5 \u05de\u05d5\u05d3\u05e2 \u05dc\u05de\u05e0\u05d9\u05e2\u05d9\u05d5 \u05d0\u05d5 \u05dc\u05e8\u05d2\u05e9\u05d5\u05ea\u05d9\u05d5 \u05d4\u05d0\u05de\u05d9\u05ea\u05d9\u05d9\u05dd."
        ],
        "errors": {
          "misconceptions": [
            "\u05d8\u05e2\u05d5\u05ea \u05d1\u05d6\u05d9\u05d4\u05d5\u05d9 \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05e0\u05d9\u05dd \u05db-Splitting \u05d0\u05d5 Projective Identification (\u05d4\u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05d9\u05d9\u05dd \u05dc-BPD)."
          ],
          "bluffs": [
            "\u05d0\u05de\u05d9\u05e8\u05d4 \u05db\u05dc\u05dc\u05d9\u05ea \u05e9\u05d4\u05dd \u05de\u05e0\u05d9\u05e4\u05d5\u05dc\u05d8\u05d9\u05d1\u05d9\u05d9\u05dd \u05d1\u05dc\u05d9 \u05dc\u05e6\u05d9\u05d9\u05df \u05d0\u05ea \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05e0\u05d9\u05dd \u05d4\u05d3\u05d9\u05e0\u05de\u05d9\u05d9\u05dd."
          ]
        }
      },
      "hint": "\u05d7\u05e9\u05d1\u05d5 \u05e2\u05dc \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05e9\u05d2\u05d5\u05e8\u05dd \u05dc\u05de\u05d9\u05d3\u05e2 \u05e8\u05d2\u05e9\u05d9 '\u05dc\u05d4\u05d9\u05e2\u05dc\u05dd' \u05de\u05d4\u05ea\u05d5\u05d3\u05e2\u05d4."
    },
    {
      "type": "multiple_choice",
      "question": "\u05e7\u05dc\u05d9\u05e0\u05d0\u05d9 \u05d4\u05de\u05e2\u05e8\u05d9\u05da \u05d2\u05d1\u05e8 \u05d1\u05df 25 \u05d7\u05d5\u05e9\u05d3 \u05d1\u05e7\u05d9\u05d5\u05de\u05d4 \u05e9\u05dc Histrionic Personality Disorder. \u05d1\u05d1\u05d5\u05d0\u05d5 \u05dc\u05e7\u05d1\u05d5\u05e2 \u05d0\u05d1\u05d7\u05e0\u05d4, \u05e2\u05dc\u05d9\u05d5 \u05dc\u05d4\u05ea\u05d7\u05e9\u05d1 \u05d1\u05de\u05de\u05e6\u05d0\u05d9\u05dd \u05d4\u05d0\u05e4\u05d9\u05d3\u05de\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05d9\u05dd \u05dc\u05d2\u05d1\u05d9 \u05d4\u05d9\u05d7\u05e1 \u05d4\u05de\u05d2\u05d3\u05e8\u05d9 \u05e9\u05dc \u05d4\u05d4\u05e4\u05e8\u05e2\u05d4. \u05de\u05d4\u05d5 \u05d4\u05de\u05de\u05e6\u05d0 \u05d4\u05de\u05d3\u05d5\u05d9\u05e7 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR?",
      "answerOptions": [
        {
          "text": "\u05d1\u05de\u05d7\u05e7\u05e8\u05d9\u05dd \u05d0\u05e4\u05d9\u05d3\u05de\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05d9\u05dd \u05d4\u05de\u05e9\u05ea\u05de\u05e9\u05d9\u05dd \u05d1\u05db\u05dc\u05d9 \u05d4\u05e2\u05e8\u05db\u05d4 \u05de\u05d5\u05d1\u05e0\u05d9\u05dd, \u05d4\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d1\u05d9\u05df \u05d2\u05d1\u05e8\u05d9\u05dd \u05dc\u05e0\u05e9\u05d9\u05dd \u05d3\u05d5\u05de\u05d4.",
          "isCorrect": true,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05e9\u05d1\u05e7\u05dc\u05d9\u05e0\u05d9\u05e7\u05d4 \u05d4\u05d4\u05e4\u05e8\u05e2\u05d4 \u05de\u05d0\u05d5\u05d1\u05d7\u05e0\u05ea \u05d9\u05d5\u05ea\u05e8 \u05d1\u05e0\u05e9\u05d9\u05dd, \u05de\u05d7\u05e7\u05e8\u05d9\u05dd \u05de\u05d5\u05d1\u05e0\u05d9\u05dd \u05de\u05e8\u05d0\u05d9\u05dd \u05e9\u05d4\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d0\u05d9\u05e0\u05d4 \u05e9\u05d5\u05e0\u05d4 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05d1\u05d9\u05df \u05d4\u05de\u05d9\u05e0\u05d9\u05dd, \u05de\u05d4 \u05e9\u05de\u05e8\u05de\u05d6 \u05e2\u05dc \u05d4\u05d8\u05d9\u05d4 \u05d1\u05d0\u05d1\u05d7\u05d5\u05df \u05e7\u05dc\u05d9\u05e0\u05d9 (DSM p.759)."
        },
        {
          "text": "\u05d4\u05d4\u05e4\u05e8\u05e2\u05d4 \u05e9\u05db\u05d9\u05d7\u05d4 \u05e4\u05d9 10 \u05d1\u05e0\u05e9\u05d9\u05dd \u05dc\u05e2\u05d5\u05de\u05ea \u05d2\u05d1\u05e8\u05d9\u05dd \u05d1\u05db\u05dc \u05e1\u05d5\u05d2\u05d9 \u05d4\u05de\u05d3\u05d2\u05de\u05d9\u05dd.",
          "isCorrect": false,
          "rationale": "\u05e0\u05ea\u05d5\u05df \u05d6\u05d4 \u05e9\u05d2\u05d5\u05d9; \u05d4\u05d5\u05d0 \u05de\u05e9\u05e7\u05e3 \u05d0\u05d5\u05dc\u05d9 \u05e1\u05d8\u05e8\u05d9\u05d0\u05d5\u05d8\u05d9\u05e4\u05d9\u05dd \u05d9\u05e9\u05e0\u05d9\u05dd \u05d0\u05da \u05dc\u05d0 \u05d0\u05ea \u05d4\u05e0\u05ea\u05d5\u05e0\u05d9\u05dd \u05d4\u05de\u05d7\u05e7\u05e8\u05d9\u05d9\u05dd \u05d4\u05e2\u05d3\u05db\u05e0\u05d9\u05d9\u05dd (DSM p.759)."
        },
        {
          "text": "\u05d2\u05d1\u05e8\u05d9\u05dd \u05e2\u05dd HPD \u05de\u05e6\u05d9\u05d2\u05d9\u05dd \u05ea\u05de\u05d9\u05d3 \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d0\u05e0\u05d8\u05d9\u05e1\u05d5\u05e6\u05d9\u05d0\u05dc\u05d9\u05ea \u05e0\u05dc\u05d5\u05d5\u05d9\u05ea \u05db\u05d7\u05dc\u05e7 \u05de\u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd.",
          "isCorrect": false,
          "rationale": "\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d0\u05e0\u05d8\u05d9\u05e1\u05d5\u05e6\u05d9\u05d0\u05dc\u05d9\u05ea \u05d0\u05d9\u05e0\u05d4 \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df \u05dc-HPD, \u05d0\u05dd \u05db\u05d9 \u05e7\u05d9\u05d9\u05de\u05ea \u05ea\u05d7\u05dc\u05d5\u05d0\u05d4 \u05e0\u05dc\u05d5\u05d5\u05d9\u05ea \u05d0\u05e4\u05e9\u05e8\u05d9\u05ea (DSM p.760)."
        },
        {
          "text": "\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d4\u05d4\u05e4\u05e8\u05e2\u05d4 \u05d1\u05d0\u05d5\u05db\u05dc\u05d5\u05e1\u05d9\u05d9\u05d4 \u05d4\u05db\u05dc\u05dc\u05d9\u05ea \u05e0\u05d0\u05de\u05d3\u05ea \u05d1\u05db-5% \u05de\u05d4\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd.",
          "isCorrect": false,
          "rationale": "\u05d4\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05e0\u05de\u05d5\u05db\u05d4 \u05d9\u05d5\u05ea\u05e8, \u05e1\u05d1\u05d9\u05d1 1.8% \u05dc\u05e4\u05d9 \u05de\u05d7\u05e7\u05e8 \u05d4-NESARC \u05d0\u05d5 \u05d7\u05e6\u05d9\u05d5\u05df \u05e9\u05dc 0.9% \u05d1\u05e1\u05e7\u05d9\u05e8\u05d5\u05ea \u05d0\u05d7\u05e8\u05d5\u05ea (DSM p.759)."
        }
      ],
      "hint": "\u05d4\u05d1\u05d7\u05d9\u05e0\u05d5 \u05d1\u05d9\u05df \u05e0\u05ea\u05d5\u05e0\u05d9 \u05de\u05e8\u05e4\u05d0\u05d4 (clinical settings) \u05dc\u05d1\u05d9\u05df \u05de\u05d7\u05e7\u05e8\u05d9 \u05d0\u05d5\u05db\u05dc\u05d5\u05e1\u05d9\u05d9\u05d4 \u05de\u05d1\u05d5\u05e1\u05e1\u05d9 \u05db\u05dc\u05d9\u05dd \u05de\u05d5\u05d1\u05e0\u05d9\u05dd."
    },
    {
      "type": "fill_in_the_blank",
      "question": "\u05d1\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Histrionic Personality Disorder, \u05d4\u05de\u05d5\u05d3\u05d0\u05dc\u05d9\u05d5\u05ea \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc\u05d9\u05ea \u05e9\u05e0\u05d7\u05e9\u05d1\u05ea \u05dc-treatment of choice \u05d4\u05d9\u05d0 \u05e4\u05e1\u05d9\u05db\u05d5\u05ea\u05e8\u05e4\u05d9\u05d4 \u05de\u05e1\u05d5\u05d2 ___, \u05db\u05d0\u05e9\u05e8 \u05d4\u05de\u05d8\u05e8\u05d4 \u05d4\u05d9\u05d0 \u05dc\u05e2\u05d6\u05d5\u05e8 \u05dc\u05de\u05d8\u05d5\u05e4\u05dc \u05dc\u05d4\u05d1\u05d4\u05d9\u05e8 \u05d0\u05ea \u05e8\u05d2\u05e9\u05d5\u05ea\u05d9\u05d5 \u05d4\u05e4\u05e0\u05d9\u05de\u05d9\u05d9\u05dd \u05d5\u05dc\u05e2\u05d1\u05d3 \u05d0\u05ea \u05de\u05e0\u05d2\u05e0\u05d5\u05e0\u05d9 \u05d4\u05d4\u05d2\u05e0\u05d4 \u05e9\u05dc\u05d5.",
      "bestAnswer": "psychoanalytically oriented psychotherapy",
