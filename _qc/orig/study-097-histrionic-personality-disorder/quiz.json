    {
      "type": "multiple_choice",
      "question": "\u05de\u05d8\u05d5\u05e4\u05dc\u05ea \u05d1\u05ea 17 \u05de\u05e6\u05d9\u05d2\u05d4 \u05d3\u05e4\u05d5\u05e1 \u05e9\u05dc \u05e8\u05d2\u05e9\u05e0\u05d5\u05ea-\u05d9\u05ea\u05e8, \u05d7\u05d9\u05e4\u05d5\u05e9 \u05ea\u05e9\u05d5\u05de\u05ea \u05dc\u05d1 \u05e7\u05d1\u05d5\u05e2 \u05d5\u05e1\u05d2\u05e0\u05d5\u05df \u05d3\u05d9\u05d1\u05d5\u05e8 \u05e8\u05d5\u05e9\u05de\u05e0\u05d9 (impressionistic) \u05d5\u05d7\u05e1\u05e8 \u05e4\u05e8\u05d8\u05d9\u05dd. \u05d4\u05d5\u05e8\u05d9\u05d4 \u05de\u05e6\u05d9\u05d9\u05e0\u05d9\u05dd \u05e9\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d6\u05d5 \u05d4\u05d7\u05dc\u05d4 \u05dc\u05e4\u05e0\u05d9 \u05db\u05e9\u05e0\u05ea\u05d9\u05d9\u05dd \u05d5\u05d4\u05d9\u05d0 \u05e2\u05e7\u05d1\u05d9\u05ea \u05d1\u05db\u05dc \u05ea\u05d7\u05d5\u05de\u05d9 \u05d7\u05d9\u05d9\u05d4. \u05de\u05d4\u05d9 \u05d4\u05de\u05d3\u05d9\u05e0\u05d9\u05d5\u05ea \u05dc\u05d0\u05d1\u05d7\u05d5\u05df \u05d4\u05e4\u05e8\u05e2\u05ea \u05d0\u05d9\u05e9\u05d9\u05d5\u05ea \u05d1\u05d2\u05d9\u05dc \u05d4\u05d4\u05ea\u05d1\u05d2\u05e8\u05d5\u05ea \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR?",
      "answerOptions": [
        {
          "text": "\u05e0\u05d9\u05ea\u05df \u05dc\u05d0\u05d1\u05d7\u05df \u05d4\u05e4\u05e8\u05e2\u05ea \u05d0\u05d9\u05e9\u05d9\u05d5\u05ea (\u05de\u05dc\u05d1\u05d3 ASPD) \u05d0\u05dd \u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e0\u05de\u05e9\u05db\u05d9\u05dd \u05dc\u05e4\u05d7\u05d5\u05ea \u05e9\u05e0\u05d4 \u05d0\u05d7\u05ea \u05d5\u05d0\u05d9\u05e0\u05dd \u05de\u05d5\u05d2\u05d1\u05dc\u05d9\u05dd \u05dc\u05e9\u05dc\u05d1 \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9.",
          "isCorrect": true,
          "rationale": "\u05d4-DSM-5-TR \u05de\u05d0\u05e4\u05e9\u05e8 \u05d0\u05d1\u05d7\u05d5\u05df PD \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d5\u05e0\u05d5\u05e2\u05e8 \u05d0\u05dd \u05d4\u05d3\u05e4\u05d5\u05e1 \u05e0\u05e8\u05d7\u05d1, \u05d9\u05e6\u05d9\u05d1 \u05d5\u05e0\u05de\u05e9\u05da \u05dc\u05e4\u05d7\u05d5\u05ea \u05e9\u05e0\u05d4 (DSM p.736)."
        },
        {
          "text": "\u05d0\u05d9\u05df \u05dc\u05d0\u05d1\u05d7\u05df \u05d4\u05e4\u05e8\u05e2\u05ea \u05d0\u05d9\u05e9\u05d9\u05d5\u05ea \u05d1\u05e9\u05d5\u05dd \u05de\u05e7\u05e8\u05d4 \u05dc\u05e4\u05e0\u05d9 \u05d2\u05d9\u05dc 18.",
          "isCorrect": false,
          "rationale": "\u05d6\u05d5\u05d4\u05d9 \u05d8\u05e2\u05d5\u05ea \u05e0\u05e4\u05d5\u05e6\u05d4; \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05d9\u05d7\u05d9\u05d3\u05d4 \u05d4\u05de\u05d5\u05d2\u05d1\u05dc\u05ea \u05dc\u05d2\u05d9\u05dc 18 \u05d5\u05de\u05e2\u05dc\u05d4 \u05d4\u05d9\u05d0 ASPD (DSM p.736; DSM p.748)."
        },
        {
          "text": "\u05d9\u05e9 \u05dc\u05d4\u05e9\u05ea\u05de\u05e9 \u05d1\u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc Conduct Disorder \u05d1\u05de\u05e7\u05d5\u05dd HPD \u05e2\u05d3 \u05d2\u05d9\u05dc 18.",
          "isCorrect": false,
          "rationale": "Conduct Disorder \u05d4\u05d9\u05d0 \u05d0\u05d1\u05d7\u05e0\u05d4 \u05e0\u05e4\u05e8\u05d3\u05ea \u05d4\u05e7\u05e9\u05d5\u05e8\u05d4 \u05dc-ASPD, \u05dc\u05d0 \u05dc-HPD (DSM p.748; Dulcan p.209)."
        },
        {
          "text": "\u05e0\u05d9\u05ea\u05df \u05dc\u05d0\u05d1\u05d7\u05df HPD \u05e8\u05e7 \u05d0\u05dd \u05e7\u05d9\u05d9\u05de\u05ea \u05e2\u05d3\u05d5\u05ea \u05dc\u05d4\u05e4\u05e8\u05e2\u05ea \u05d7\u05e8\u05d3\u05d4 \u05e0\u05dc\u05d5\u05d5\u05d9\u05ea \u05de\u05d2\u05d9\u05dc \u05d4\u05d9\u05dc\u05d3\u05d5\u05ea.",
          "isCorrect": false,
          "rationale": "\u05d0\u05d9\u05df \u05d3\u05e8\u05d9\u05e9\u05d4 \u05db\u05d6\u05d5 \u05d1\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05d4\u05d0\u05d1\u05d7\u05e0\u05ea\u05d9\u05d9\u05dd (DSM p.757)."
        }
      ],
      "hint": "\u05d1\u05d3\u05e7\u05d5 \u05d0\u05ea \u05de\u05e9\u05da \u05d4\u05d6\u05de\u05df \u05d4\u05e0\u05d3\u05e8\u05e9 \u05dc\u05d9\u05e6\u05d9\u05d1\u05d5\u05ea \u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d1\u05d1\u05e0\u05d9 \u05e0\u05d5\u05e2\u05e8."
    },
    {
      "type": "multiple_choice",
      "question": "\u05db\u05d9\u05e6\u05d3 \u05de\u05e9\u05e4\u05d9\u05e2 \u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05e4\u05e2\u05d5\u05dc\u05d4 \u05e9\u05dc $5HT_{2A}/D_2$ antagonism (\u05d1\u05de\u05d9\u05e0\u05d5\u05e0\u05d9\u05dd \u05e0\u05de\u05d5\u05db\u05d9\u05dd) \u05e2\u05dc \u05d4\u05e0\u05d9\u05d4\u05d5\u05dc \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9 \u05e9\u05dc \u05de\u05d8\u05d5\u05e4\u05dc \u05e2\u05dd HPD \u05d4\u05d7\u05d5\u05d5\u05d4 \u05de\u05e9\u05d1\u05e8 \u05d7\u05e8\u05d9\u05e3?",
      "answerOptions": [
        {
          "text": "\u05de\u05d9\u05d9\u05e6\u05d1 \u05d0\u05ea \u05d1\u05d5\u05d7\u05df \u05d4\u05de\u05e6\u05d9\u05d0\u05d5\u05ea \u05d5\u05de\u05e4\u05d7\u05d9\u05ea \u05d0\u05ea \u05d4\u05e0\u05d8\u05d9\u05d9\u05d4 \u05dc\u05d7\u05d5\u05d5\u05ea \u05d0\u05e9\u05dc\u05d9\u05d5\u05ea (illusions) \u05ea\u05d7\u05ea \u05d3\u05d7\u05e7.",
          "isCorrect": true,
          "rationale": "\u05d7\u05e1\u05d9\u05de\u05ea \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 $5HT_{2A}$ \u05d5-$D_2$ \u05d1\u05de\u05d9\u05e0\u05d5\u05df \u05e0\u05de\u05d5\u05da \u05de\u05e1\u05d9\u05d9\u05e2\u05ea \u05d1\u05d5\u05d5\u05d9\u05e1\u05d5\u05ea \u05d7\u05d5\u05e9\u05d9 \u05d5\u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9 \u05d1\u05de\u05e6\u05d1\u05d9 \u05d3\u05d7\u05e7 \u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9\u05d9\u05dd-\u05dc\u05de\u05d7\u05e6\u05d4 (StahlNeuro p.159, 240; Synopsis ch.19 Personality Disorders)."
        },
        {
          "text": "\u05de\u05d2\u05d1\u05d9\u05e8 \u05d0\u05ea \u05d4-Arousal \u05d5\u05de\u05e9\u05e4\u05e8 \u05d0\u05ea \u05d9\u05db\u05d5\u05dc\u05ea \u05d4\u05e8\u05d9\u05db\u05d5\u05d6 \u05d1\u05de\u05d8\u05dc\u05d5\u05ea \u05d7\u05e9\u05d1\u05d5\u05df.",
          "isCorrect": false,
          "rationale": "\u05d6\u05d5\u05d4\u05d9 \u05e4\u05e2\u05d5\u05dc\u05d4 \u05e9\u05dc \u05e1\u05d8\u05d9\u05de\u05d5\u05dc\u05e0\u05d8\u05d9\u05dd (DAT inhibitors), \u05dc\u05d0 \u05e9\u05dc \u05e0\u05d5\u05d2\u05d3\u05d9 \u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d4 (StahlNeuro p.350)."
        },
        {
          "text": "\u05de\u05e2\u05dc\u05d4 \u05e8\u05de\u05d5\u05ea \u05d8\u05e1\u05d8\u05d5\u05e1\u05d8\u05e8\u05d5\u05df \u05d5\u05d1\u05db\u05da \u05de\u05e4\u05d7\u05d9\u05ea \u05d0\u05d9\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05d5\u05ea.",
          "isCorrect": false,
          "rationale": "\u05e8\u05de\u05d5\u05ea \u05d2\u05d1\u05d5\u05d4\u05d5\u05ea \u05e9\u05dc \u05d8\u05e1\u05d8\u05d5\u05e1\u05d8\u05e8\u05d5\u05df \u05d3\u05d5\u05d5\u05e7\u05d0 \u05e0\u05e7\u05e9\u05e8\u05d5 \u05dc\u05d0\u05d9\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05d5\u05ea \u05de\u05d5\u05d2\u05d1\u05e8\u05ea \u05d1\u05de\u05d7\u05e7\u05e8\u05d9\u05dd \u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05d9\u05dd (Synopsis ch.19 Personality Disorders)."
        },
        {
          "text": "\u05de\u05d5\u05e0\u05e2 \u05d0\u05ea \u05ea\u05d5\u05e4\u05e2\u05ea \u05d4-Splitting \u05d4\u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05d9\u05ea \u05dc\u05d4\u05e4\u05e8\u05e2\u05d4 \u05d6\u05d5.",
          "isCorrect": false,
          "rationale": "Splitting \u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05d9 \u05dc-BPD, \u05d5\u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05ea\u05e8\u05d5\u05e4\u05ea\u05d9 \u05d0\u05d9\u05e0\u05d5 \u05de\u05d1\u05d8\u05dc \u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05d2\u05e0\u05d4 \u05d0\u05d9\u05e9\u05d9\u05d5\u05ea\u05d9 \u05d1\u05d0\u05d5\u05e4\u05df \u05d9\u05e9\u05d9\u05e8 (Synopsis ch.19 Personality Disorders)."
        }
      ],
      "hint": "\u05d4\u05ea\u05de\u05e7\u05d3\u05d5 \u05d1\u05ea\u05e4\u05e7\u05d9\u05d3 \u05d4\u05e7\u05d5\u05dc\u05d8\u05e0\u05d9\u05dd \u05d1\u05e9\u05d9\u05e4\u05d5\u05e8 \u05d9\u05e6\u05d9\u05d1\u05d5\u05ea \u05ea\u05e4\u05d9\u05e1\u05ea \u05d4\u05de\u05e6\u05d9\u05d0\u05d5\u05ea."
    },
    {
      "type": "multiple_select",
      "question": "\u05d0\u05d9\u05dc\u05d5 \u05de\u05d1\u05d9\u05df \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9\u05dd \u05d4\u05d1\u05d0\u05d9\u05dd \u05de\u05d4\u05d5\u05d5\u05d9\u05dd \u05d7\u05dc\u05e7 \u05de\u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05d4\u05d0\u05d1\u05d7\u05e0\u05ea\u05d9\u05d9\u05dd \u05e9\u05dc Histrionic Personality Disorder \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR?",
      "answerOptions": [
        {
          "text": "\u05d0\u05d9-\u05e0\u05d5\u05d7\u05d5\u05ea \u05d1\u05de\u05e6\u05d1\u05d9\u05dd \u05d1\u05d4\u05dd \u05d4\u05e4\u05e8\u05d8 \u05d0\u05d9\u05e0\u05d5 \u05de\u05e8\u05db\u05d6 \u05ea\u05e9\u05d5\u05de\u05ea \u05d4\u05dc\u05d1.",
          "isCorrect": true,
          "rationale": "\u05d6\u05d4\u05d5 \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df \u05de\u05e8\u05db\u05d6\u05d9 \u05d4\u05de\u05d1\u05d8\u05d0 \u05d0\u05ea \u05d4\u05e6\u05d5\u05e8\u05da \u05d4\u05d1\u05dc\u05ea\u05d9 \u05e4\u05d5\u05e1\u05e7 \u05d1\u05ea\u05d9\u05e7\u05d5\u05e3 \u05d7\u05d9\u05e6\u05d5\u05e0\u05d9 (DSM p.757)."
        },
        {
          "text": "\u05e1\u05d2\u05e0\u05d5\u05df \u05d3\u05d9\u05d1\u05d5\u05e8 \u05e8\u05d5\u05e9\u05de\u05e0\u05d9 (Impressionistic) \u05d5\u05d3\u05dc \u05d1\u05e4\u05e8\u05d8\u05d9\u05dd.",
          "isCorrect": true,
          "rationale": "\u05d4\u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd \u05e0\u05d5\u05d8\u05d9\u05dd \u05dc\u05d3\u05d1\u05e8 \u05d1\u05d4\u05db\u05dc\u05dc\u05d5\u05ea \u05d3\u05e8\u05de\u05d8\u05d9\u05d5\u05ea \u05d1\u05dc\u05d9 \u05d9\u05db\u05d5\u05dc\u05ea \u05dc\u05d2\u05d1\u05d5\u05ea \u05d0\u05d5\u05ea\u05df \u05d1\u05e2\u05d5\u05d1\u05d3\u05d5\u05ea (DSM p.758)."
        },
        {
          "text": "\u05e1\u05d5\u05d2\u05e1\u05d8\u05d9\u05d1\u05d9\u05dc\u05d9\u05d5\u05ea (Suggestibility) \u05d2\u05d1\u05d5\u05d4\u05d4 \u05d5\u05d4\u05e9\u05e4\u05e2\u05d4 \u05e7\u05dc\u05d4 \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d0\u05d7\u05e8\u05d9\u05dd.",
          "isCorrect": true,
          "rationale": "\u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd \u05d0\u05dc\u05d5 \u05e0\u05d5\u05d8\u05d9\u05dd \u05dc\u05d0\u05de\u05e5 \u05d3\u05e2\u05d5\u05ea \u05e9\u05dc \u05e1\u05de\u05db\u05d5\u05ea \u05d0\u05d5 \u05d0\u05d5\u05e4\u05e0\u05d5\u05ea \u05d7\u05d5\u05dc\u05e4\u05d5\u05ea \u05d1\u05e7\u05dc\u05d5\u05ea (DSM p.758)."
        },
        {
          "text": "\u05d7\u05d5\u05e1\u05e8 \u05d0\u05de\u05e4\u05ea\u05d9\u05d4 \u05d5\u05e0\u05d9\u05e6\u05d5\u05dc \u05d1\u05d9\u05df-\u05d0\u05d9\u05e9\u05d9 \u05dc\u05e6\u05d5\u05e8\u05da \u05db\u05d5\u05d7.",
          "isCorrect": false,
          "rationale": "\u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9\u05dd \u05d0\u05dc\u05d5 \u05de\u05db\u05d5\u05d5\u05e0\u05d9\u05dd \u05d9\u05d5\u05ea\u05e8 \u05dc-Narcissistic Personality Disorder \u05d0\u05d5 Antisocial Personality Disorder (DSM p.760)."
        }
      ],
      "hint": "\u05d7\u05e4\u05e9\u05d5 \u05d0\u05ea \u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05d4\u05e7\u05e9\u05d5\u05e8\u05d9\u05dd \u05dc\u05e1\u05d2\u05e0\u05d5\u05df \u05d4\u05ea\u05e7\u05e9\u05d5\u05e8\u05ea \u05d5\u05d4\u05e6\u05d5\u05e8\u05da \u05d1\u05e7\u05d4\u05dc.",
      "hasAllOfTheAbove": false,
