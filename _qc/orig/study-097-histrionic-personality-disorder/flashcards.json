{
  "title": "Histrionic Flashcards",
  "cards": [
    {
      "front": "\u05de\u05d4\u05d5 \u05de\u05e1\u05e4\u05e8 \u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05d4\u05de\u05d9\u05e0\u05d9\u05de\u05dc\u05d9 \u05d4\u05e0\u05d3\u05e8\u05e9 \u05dc\u05d0\u05d1\u05d7\u05e0\u05ea Histrionic Personality Disorder \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR?",
      "back": "\u05dc\u05e4\u05d7\u05d5\u05ea \u05d7\u05de\u05d9\u05e9\u05d4 (5) \u05de\u05ea\u05d5\u05da \u05e9\u05de\u05d5\u05e0\u05d4 \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd (DSM p.757)."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05de\u05d5\u05d2\u05d3\u05e8 \u05e1\u05d2\u05e0\u05d5\u05df \u05d4\u05d3\u05d9\u05d1\u05d5\u05e8 (style of speech) \u05d4\u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05d9 \u05dc\u05de\u05d8\u05d5\u05e4\u05dc \u05e2\u05dd HPD?",
      "back": "\u05e8\u05d5\u05e9\u05de\u05e0\u05d9 \u05d1\u05d0\u05d5\u05e4\u05df \u05de\u05d5\u05e4\u05e8\u05d6 (excessively impressionistic) \u05d5\u05d7\u05e1\u05e8 \u05e4\u05e8\u05d8\u05d9\u05dd (lacking in detail) (DSM p.757)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05d8\u05e2\u05d5\u05ea \u05d4\u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9\u05ea \u05d4\u05e0\u05e4\u05d5\u05e6\u05d4 \u05d1-HPD \u05dc\u05d2\u05d1\u05d9 \u05d8\u05d9\u05d1 \u05d4\u05e7\u05e9\u05e8\u05d9\u05dd \u05d4\u05d1\u05d9\u05df-\u05d0\u05d9\u05e9\u05d9\u05d9\u05dd (Criterion 8)?",
      "back": "\u05ea\u05e4\u05d9\u05e1\u05ea \u05de\u05e2\u05e8\u05db\u05d5\u05ea \u05d9\u05d7\u05e1\u05d9\u05dd \u05db\u05d4\u05e8\u05d1\u05d4 \u05d9\u05d5\u05ea\u05e8 \u05d0\u05d9\u05e0\u05d8\u05d9\u05de\u05d9\u05d5\u05ea \u05de\u05db\u05e4\u05d9 \u05e9\u05d4\u05df \u05d1\u05de\u05e6\u05d9\u05d0\u05d5\u05ea (DSM p.758)."
    },
    {
      "front": "\u05d1\u05d0\u05d1\u05d7\u05e0\u05d4 \u05de\u05d1\u05d3\u05dc\u05ea, \u05de\u05d4 \u05de\u05d1\u05d3\u05d9\u05dc Borderline Personality Disorder (BPD) \u05de-HPD \u05d1\u05e0\u05d5\u05d2\u05e2 \u05dc\u05d4\u05e8\u05e1 \u05e2\u05e6\u05de\u05d9?",
      "back": "\u05d1-BPD \u05e9\u05db\u05d9\u05d7\u05d9\u05dd \u05e0\u05d9\u05e1\u05d9\u05d5\u05e0\u05d5\u05ea \u05d0\u05d5\u05d1\u05d3\u05e0\u05d9\u05d9\u05dd \u05d5\u05e4\u05e6\u05d9\u05e2\u05d4 \u05e2\u05e6\u05de\u05d9\u05ea (self-mutilation), \u05d1\u05e2\u05d5\u05d3 \u05d1-HPD \u05d0\u05dc\u05d5 \u05d0\u05d9\u05e0\u05dd \u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9 \u05dc\u05d9\u05d1\u05d4 (DSM p.759)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05d4\u05d1\u05d3\u05dc \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05d1\u05d9\u05df HPD \u05dc-BPD \u05d1\u05e0\u05d5\u05d2\u05e2 \u05dc\u05ea\u05d7\u05d5\u05e9\u05ea \u05d4-'\u05e8\u05d9\u05e7\u05e0\u05d5\u05ea' (emptiness)?",
      "back": "\u05ea\u05d7\u05d5\u05e9\u05ea \u05e8\u05d9\u05e7\u05e0\u05d5\u05ea \u05db\u05e8\u05d5\u05e0\u05d9\u05ea \u05d5\u05d3\u05d9\u05e4\u05d5\u05d6\u05d9\u05d9\u05ea \u05d6\u05d4\u05d5\u05ea \u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05d9\u05d5\u05ea \u05dc-BPD, \u05d1\u05e2\u05d5\u05d3 \u05d1-HPD \u05d4\u05e8\u05d2\u05e9\u05d5\u05ea \u05e9\u05d8\u05d7\u05d9\u05d9\u05dd (shallow) \u05d5\u05de\u05e9\u05ea\u05e0\u05d9\u05dd (DSM p.759)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05e0\u05d7\u05e9\u05d1 \u05dc-primary treatment (\u05e7\u05d5 \u05e8\u05d0\u05e9\u05d5\u05df) \u05e2\u05d1\u05d5\u05e8 HPD?",
      "back": "\u05e4\u05e1\u05d9\u05db\u05d5\u05ea\u05e8\u05e4\u05d9\u05d4, \u05dc\u05e8\u05d5\u05d1 \u05d1\u05d2\u05d9\u05e9\u05d4 \u05e4\u05e1\u05d9\u05db\u05d5\u05d0\u05e0\u05dc\u05d9\u05d8\u05d9\u05ea \u05d0\u05d5 \u05d3\u05d9\u05e0\u05de\u05d9\u05ea (Synopsis ch.19 Personality Disorders)."
    },
    {
      "front": "\u05de\u05d4\u05dd \u05e9\u05e0\u05d9 \u05de\u05e0\u05d2\u05e0\u05d5\u05e0\u05d9 \u05d4\u05d4\u05d2\u05e0\u05d4 (defense mechanisms) \u05d4\u05e2\u05d9\u05e7\u05e8\u05d9\u05d9\u05dd \u05d4\u05de\u05d6\u05d5\u05d4\u05d9\u05dd \u05e2\u05dd \u05d0\u05d9\u05e9\u05d9\u05d5\u05ea \u05d4\u05d9\u05e1\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05ea?",
      "back": "\u05d4\u05d3\u05d7\u05e7\u05d4 (Repression) \u05d5\u05d3\u05d9\u05e1\u05d5\u05e6\u05d9\u05d0\u05e6\u05d9\u05d4 (Dissociation) (Synopsis ch.19 Personality Disorders)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05de\u05de\u05e6\u05d0 \u05d4\u05d0\u05e4\u05d9\u05d3\u05de\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05dc\u05d2\u05d1\u05d9 \u05d4\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d4\u05de\u05d2\u05d3\u05e8\u05d9\u05ea \u05e9\u05dc HPD \u05d1\u05de\u05d7\u05e7\u05e8\u05d9\u05dd \u05d1\u05e7\u05d4\u05d9\u05dc\u05d4 (community samples)?",
      "back": "\u05d4\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d3\u05d5\u05de\u05d4 (equal) \u05d1\u05d9\u05df \u05d2\u05d1\u05e8\u05d9\u05dd \u05dc\u05e0\u05e9\u05d9\u05dd, \u05d1\u05e0\u05d9\u05d2\u05d5\u05d3 \u05dc\u05d4\u05d8\u05d9\u05d4 \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05dc\u05d8\u05d5\u05d1\u05ea \u05e0\u05e9\u05d9\u05dd (DSM p.759)."
    },
    {
      "front": "\u05d0\u05d9\u05d6\u05d4 \u05ea\u05e1\u05de\u05d9\u05df \u05de\u05d8\u05e8\u05d4 (target symptom) \u05de\u05e6\u05d3\u05d9\u05e7 \u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05d0\u05e0\u05d8\u05d9-\u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9\u05d5\u05ea \u05d1\u05de\u05d9\u05e0\u05d5\u05df \u05e0\u05de\u05d5\u05da \u05d1-HPD?",
      "back": "\u05de\u05e6\u05d1\u05d9 \u05d3\u05d4-\u05e8\u05d9\u05d0\u05dc\u05d9\u05d6\u05e6\u05d9\u05d4 (derealization) \u05d0\u05d5 \u05d0\u05e9\u05dc\u05d9\u05d5\u05ea (illusions) \u05d4\u05de\u05d5\u05e4\u05d9\u05e2\u05d9\u05dd \u05ea\u05d7\u05ea \u05d3\u05d7\u05e7 (Synopsis ch.19 Personality Disorders)."
    },
    {
      "front": "\u05d1\u05d0\u05d1\u05d7\u05e0\u05d4 \u05de\u05d1\u05d3\u05dc\u05ea, \u05de\u05d4 \u05de\u05d1\u05d3\u05d9\u05dc HPD \u05de-Narcissistic Personality Disorder (NPD) \u05d1\u05e0\u05d5\u05d2\u05e2 \u05dc\u05d7\u05d9\u05e4\u05d5\u05e9 \u05ea\u05e9\u05d5\u05de\u05ea \u05dc\u05d1?",
      "back": "\u05d1-NPD \u05d4\u05e6\u05d5\u05e8\u05da \u05d4\u05d5\u05d0 \u05d1\u05e9\u05d1\u05d7 \u05e2\u05dc '\u05e2\u05dc\u05d9\u05d5\u05e0\u05d5\u05ea', \u05d5\u05d1-HPD \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05de\u05d5\u05db\u05df \u05dc\u05d4\u05d9\u05e8\u05d0\u05d5\u05ea \u05e4\u05d2\u05d9\u05e2 \u05db\u05d3\u05d9 \u05dc\u05e7\u05d1\u05dc \u05ea\u05e9\u05d5\u05de\u05ea \u05dc\u05d1 (DSM p.760)."
    },
    {
      "front": "\u05d0\u05d9\u05d6\u05d5 \u05e7\u05d1\u05d5\u05e6\u05ea \u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05de\u05d9\u05d5\u05e2\u05d3\u05ea \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05ea\u05e1\u05de\u05d9\u05e0\u05d9 \u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05d5\u05ea\u05dc\u05d5\u05e0\u05d5\u05ea \u05e1\u05d5\u05de\u05d8\u05d9\u05d5\u05ea \u05d1\u05de\u05d8\u05d5\u05e4\u05dc\u05d9 HPD?",
      "back": "\u05de\u05e2\u05db\u05d1\u05d9 \u05e1\u05e4\u05d9\u05d2\u05d4 \u05d7\u05d5\u05d6\u05e8\u05ea \u05e9\u05dc \u05e1\u05e8\u05d5\u05d8\u05d5\u05e0\u05d9\u05df (SSRI) \u05d0\u05d5 \u05e1\u05e8\u05d5\u05d8\u05d5\u05e0\u05d9\u05df-\u05e0\u05d5\u05e8\u05d0\u05d3\u05e8\u05e0\u05dc\u05d9\u05df (SNRI) (Synopsis ch.19 Personality Disorders)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05e7\u05e9\u05e8 \u05d4\u05d2\u05e0\u05d8\u05d9 \u05d4\u05de\u05d5\u05e6\u05e2 \u05d1\u05d9\u05df HPD \u05dc\u05d1\u05d9\u05df \u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05d0\u05d7\u05e8\u05d5\u05ea \u05d1-Cluster B?",
      "back": "\u05e7\u05e9\u05e8 \u05d2\u05e0\u05d8\u05d9 \u05d0\u05e4\u05e9\u05e8\u05d9 \u05dc-Antisocial Personality Disorder \u05d5\u05db\u05df \u05dc-Alcohol Use Disorder (Synopsis ch.19 Personality Disorders)."
    },
    {
      "front": "\u05de\u05d4 \u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05d0\u05ea \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05e2\u05dd HPD \u05d1\u05e1\u05d9\u05d8\u05d5\u05d0\u05e6\u05d9\u05d4 \u05d1\u05d4 \u05d0\u05d9\u05e0\u05d5 \u05de\u05e8\u05db\u05d6 \u05ea\u05e9\u05d5\u05de\u05ea \u05d4\u05dc\u05d1?",
      "back": "\u05d7\u05d5\u05e1\u05e8 \u05e0\u05d5\u05d7\u05d5\u05ea (discomfort) \u05d5\u05e0\u05d9\u05e1\u05d9\u05d5\u05e0\u05d5\u05ea \u05d3\u05e8\u05de\u05d8\u05d9\u05d9\u05dd \u05dc\u05de\u05e9\u05d5\u05da \u05d0\u05ea \u05d4\u05e4\u05d5\u05e7\u05d5\u05e1 \u05d1\u05d7\u05d6\u05e8\u05d4 \u05d0\u05dc\u05d9\u05d5 (DSM p.757)."
    },
    {
      "front": "\u05de\u05d3\u05d5\u05e2 \u05de\u05d5\u05de\u05dc\u05e5 \u05dc\u05d4\u05d9\u05de\u05e0\u05e2 \u05de\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05d1\u05e0\u05d6\u05d5\u05d3\u05d9\u05d0\u05d6\u05e4\u05d9\u05e0\u05d9\u05dd \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05d7\u05e8\u05d3\u05d4 \u05d1\u05de\u05d8\u05d5\u05e4\u05dc\u05d9 HPD?",
      "back": "\u05d1\u05e9\u05dc \u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05e9\u05d9\u05de\u05d5\u05e9 \u05dc\u05e8\u05e2\u05d4 (abuse) \u05d5\u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05d3\u05d9\u05e1\u05d4\u05d9\u05e0\u05d9\u05d1\u05d9\u05e6\u05d9\u05d4 (disinhibition) (Synopsis ch.19 Personality Disorders)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05d9\u05e2\u05d3 \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05e9\u05dc Clarification (\u05d4\u05d1\u05d4\u05e8\u05d4) \u05d1\u05ea\u05d4\u05dc\u05d9\u05da \u05d4\u05e4\u05e1\u05d9\u05db\u05d5\u05ea\u05e8\u05e4\u05d9 \u05e9\u05dc HPD?",
      "back": "\u05d6\u05d9\u05d4\u05d5\u05d9 \u05d5\u05d4\u05d1\u05d4\u05e8\u05d4 \u05e9\u05dc \u05d4\u05e8\u05d2\u05e9\u05d5\u05ea \u05d4\u05e4\u05e0\u05d9\u05de\u05d9\u05d9\u05dd \u05d4\u05d0\u05de\u05d9\u05ea\u05d9\u05d9\u05dd \u05e9\u05dc \u05d4\u05de\u05d8\u05d5\u05e4\u05dc, \u05e9\u05de\u05d4\u05dd \u05d4\u05d5\u05d0 \u05e0\u05d5\u05d8\u05d4 \u05dc\u05d4\u05ea\u05e2\u05dc\u05dd (Synopsis ch.19 Personality Disorders)."
    },
    {
      "front": "\u05e0\u05db\u05d5\u05df \u05d0\u05d5 \u05dc\u05d0 \u05e0\u05db\u05d5\u05df: \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05e4\u05ea\u05d9\u05d9\u05e0\u05d9\u05ea \u05d1-HPD \u05de\u05d5\u05d2\u05d1\u05dc\u05ea \u05e8\u05e7 \u05dc\u05d0\u05e0\u05e9\u05d9\u05dd \u05d1\u05d4\u05dd \u05d9\u05e9 \u05dc\u05de\u05d8\u05d5\u05e4\u05dc \u05e2\u05e0\u05d9\u05d9\u05df \u05e8\u05d5\u05de\u05e0\u05d8\u05d9.",
      "back": "\u05dc\u05d0 \u05e0\u05db\u05d5\u05df; \u05d4\u05d9\u05d0 \u05de\u05d5\u05e4\u05d9\u05e2\u05d4 \u05d1\u05de\u05d2\u05d5\u05d5\u05df \u05e8\u05d7\u05d1 \u05e9\u05dc \u05e7\u05e9\u05e8\u05d9\u05dd \u05d7\u05d1\u05e8\u05ea\u05d9\u05d9\u05dd \u05d5\u05de\u05e7\u05e6\u05d5\u05e2\u05d9\u05d9\u05dd \u05de\u05e2\u05d1\u05e8 \u05dc\u05d4\u05e7\u05e9\u05e8 \u05d4\u05de\u05ea\u05d0\u05d9\u05dd (DSM p.758)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d4\u05d7\u05e6\u05d9\u05d5\u05e0\u05d9\u05ea (median prevalence) \u05e9\u05dc HPD \u05dc\u05e4\u05d9 \u05e1\u05e7\u05d9\u05e8\u05d5\u05ea \u05d0\u05e4\u05d9\u05d3\u05de\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05d5\u05ea?",
      "back": "\u05db-0.9% (DSM p.759)."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05de\u05d1\u05d7\u05d9\u05e0\u05d9\u05dd \u05d1\u05d9\u05df HPD \u05dc\u05d1\u05d9\u05df Antisocial Personality Disorder (ASPD) \u05d1\u05e0\u05d5\u05d2\u05e2 \u05dc\u05de\u05e0\u05d9\u05e4\u05d5\u05dc\u05e6\u05d9\u05d4?",
      "back": "\u05d1-ASPD \u05d4\u05de\u05e0\u05d9\u05e4\u05d5\u05dc\u05e6\u05d9\u05d4 \u05d4\u05d9\u05d0 \u05dc\u05e8\u05d5\u05d5\u05d7 \u05d7\u05d5\u05de\u05e8\u05d9 \u05d0\u05d5 \u05db\u05d5\u05d7, \u05d5\u05d1-HPD \u05d4\u05d9\u05d0 \u05dc\u05d4\u05e9\u05d2\u05ea \u05d4\u05d6\u05e0\u05d4 \u05e8\u05d2\u05e9\u05d9\u05ea (nurturance) (DSM p.759)."
    },
    {
