{
  "title": "Telepsychiatry Flashcards",
  "cards": [
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05d2\u05d3\u05e8\u05ea \u05d4-CMS \u05dc-Telemedicine \u05d1\u05de\u05ea\u05df \u05e9\u05d9\u05e8\u05d5\u05ea\u05d9 \u05d1\u05e8\u05d9\u05d0\u05d5\u05ea?",
      "back": "\u05de\u05ea\u05df \u05e9\u05d9\u05e8\u05d5\u05ea\u05d9\u05dd \u05d1\u05d0\u05de\u05e6\u05e2\u05d5\u05ea real-time interactive videoconferencing \u05d4\u05db\u05d5\u05dc\u05dc \u05de\u05e8\u05db\u05d9\u05d1\u05d9 audio \u05d5-video \u05e1\u05d9\u05e0\u05db\u05e8\u05d5\u05e0\u05d9\u05d9\u05dd (Dulcan p.653)."
    },
    {
      "front": "\u05d1\u05d0\u05d9\u05d6\u05d4 \u05de\u05e7\u05d5\u05dd (Jurisdiction) \u05d7\u05d9\u05d9\u05d1 \u05d4\u05e7\u05dc\u05d9\u05e0\u05d0\u05d9 \u05dc\u05d4\u05d7\u05d6\u05d9\u05e7 \u05d1\u05e8\u05d9\u05e9\u05d9\u05d5\u05df \u05e2\u05d1\u05d5\u05d3\u05d4 \u05ea\u05e7\u05e3 \u05dc\u05e4\u05d9 \u05db\u05dc\u05dc\u05d9 \u05d4-FSMB?",
      "back": "\u05d1\u05de\u05d3\u05d9\u05e0\u05d4 \u05d0\u05d5 \u05d1\u05de\u05d7\u05d5\u05d6 \u05e9\u05d1\u05d4\u05dd \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05e0\u05de\u05e6\u05d0 \u05e4\u05d9\u05d6\u05d9\u05ea \u05d1\u05e2\u05ea \u05de\u05ea\u05df \u05d4\u05e9\u05d9\u05e8\u05d5\u05ea (Dulcan p.656)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05de\u05de\u05e6\u05d0 \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05e9\u05dc \u05de\u05d7\u05e7\u05e8 Myers et al. (2015) \u05dc\u05d2\u05d1\u05d9 \u05d9\u05e2\u05d9\u05dc\u05d5\u05ea \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-ADHD \u05de\u05e8\u05d7\u05d5\u05e7?",
      "back": "\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-telepharmacotherapy \u05d4\u05d5\u05db\u05d7 \u05db\u05d9\u05e2\u05d9\u05dc \u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05d1\u05e7\u05d4\u05d9\u05dc\u05d5\u05ea \u05de\u05e8\u05d5\u05d7\u05e7\u05d5\u05ea \u05d1\u05d3\u05d5\u05de\u05d4 \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05e4\u05e8\u05d5\u05e0\u05d8\u05dc\u05d9 (Dulcan p.655)."
    },
    {
      "front": "\u05de\u05d4 \u05d3\u05d5\u05e8\u05e9 \u05d7\u05d5\u05e7 \u05d4-Ryan Haight Online Pharmacy Consumer Protection Act \u05dc\u05d2\u05d1\u05d9 \u05de\u05e8\u05e9\u05dd \u05e9\u05dc Controlled substances?",
      "back": "\u05d1\u05d9\u05e6\u05d5\u05e2 \u05d4\u05e2\u05e8\u05db\u05d4 \u05e4\u05e8\u05d5\u05e0\u05d8\u05dc\u05d9\u05ea (in-person evaluation) \u05d0\u05d7\u05ea \u05dc\u05e4\u05d7\u05d5\u05ea \u05dc\u05e4\u05e0\u05d9 \u05de\u05ea\u05df \u05d4\u05de\u05e8\u05e9\u05dd \u05d4\u05e8\u05d0\u05e9\u05d5\u05e0\u05d9 (Dulcan p.657)."
    },
    {
      "front": "\u05de\u05d3\u05d5\u05e2 \u05de\u05d5\u05de\u05dc\u05e5 \u05dc\u05de\u05e7\u05dd \u05d0\u05ea \u05d4\u05de\u05e6\u05dc\u05de\u05d4 \u05d1\u05d2\u05d5\u05d1\u05d4 \u05d4\u05e2\u05d9\u05e0\u05d9\u05d9\u05dd (Eye level) \u05e9\u05dc \u05d4\u05e7\u05dc\u05d9\u05e0\u05d0\u05d9?",
      "back": "\u05db\u05d3\u05d9 \u05dc\u05d9\u05d9\u05e6\u05e8 \u05ea\u05d7\u05d5\u05e9\u05ea \u05e7\u05e9\u05e8 \u05e2\u05d9\u05df (eye contact) \u05d5\u05d0\u05de\u05e4\u05ea\u05d9\u05d4, \u05d4\u05d9\u05d5\u05ea \u05e9\u05de\u05d1\u05d8 \u05dc\u05de\u05e1\u05da \u05de\u05e4\u05d5\u05e8\u05e9 \u05dc\u05e8\u05d5\u05d1 \u05db\u05d4\u05e1\u05d8\u05ea \u05de\u05d1\u05d8 \u05db\u05dc\u05e4\u05d9 \u05de\u05d8\u05d4 (Dulcan p.661)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4-Bandwidth \u05d4\u05de\u05d9\u05e0\u05d9\u05de\u05dc\u05d9 \u05d4\u05de\u05d5\u05de\u05dc\u05e5 \u05dc\u05d1\u05d9\u05e6\u05d5\u05e2 MSE \u05ea\u05e7\u05d9\u05df \u05d5\u05d6\u05d9\u05d4\u05d5\u05d9 \u05e8\u05de\u05d6\u05d9\u05dd \u05dc\u05d0-\u05de\u05d9\u05dc\u05d5\u05dc\u05d9\u05d9\u05dd?",
      "back": "\u05e8\u05d5\u05d7\u05d1 \u05e4\u05e1 \u05e9\u05dc \u05de\u05e2\u05dc $384 \text{ kbits/second}$ (Dulcan p.660)."
    },
    {
      "front": "\u05d0\u05d9\u05d6\u05d4 \u05e1\u05d5\u05d2 \u05de\u05e6\u05dc\u05de\u05d4 \u05e0\u05d7\u05e9\u05d1 \u05dc\u05d0\u05d5\u05e4\u05d8\u05d9\u05de\u05dc\u05d9 \u05dc\u05d1\u05d3\u05d9\u05e7\u05d4 \u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9\u05ea \u05e9\u05dc \u05d9\u05dc\u05d3\u05d9\u05dd \u05d1-TMH?",
      "back": "\u05de\u05e6\u05dc\u05de\u05ea Pan-tilt-zoom (PTZ) \u05d4\u05de\u05d0\u05e4\u05e9\u05e8\u05ea \u05de\u05e2\u05e7\u05d1 \u05d0\u05d7\u05e8\u05d9 \u05ea\u05e0\u05d5\u05e2\u05d5\u05ea \u05d4\u05d9\u05dc\u05d3 \u05d1\u05d7\u05d3\u05e8 \u05d5\u05d1\u05d7\u05d9\u05e0\u05ea \u05ea\u05d5\u05d5\u05d9 \u05e4\u05e0\u05d9\u05dd (Dulcan p.661)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05ea\u05e4\u05e7\u05d9\u05d3\u05d5 \u05e9\u05dc \u05d4-Telepresenter \u05d1\u05de\u05d5\u05d3\u05dc \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05de\u05e8\u05d7\u05d5\u05e7?",
      "back": "\u05dc\u05d9\u05d5\u05d5\u05d9 \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05dc\u05de\u05e4\u05d2\u05e9, \u05dc\u05e7\u05d9\u05d7\u05ea Vital signs, \u05e1\u05d9\u05d5\u05e2 \u05d1\u05d4\u05d7\u05ea\u05de\u05d4 \u05e2\u05dc \u05d4\u05e1\u05db\u05de\u05d4 \u05d5\u05e0\u05d9\u05d4\u05d5\u05dc \u05d1\u05d8\u05d9\u05d7\u05d5\u05ea \u05d1\u05d0\u05ea\u05e8 \u05d4\u05de\u05d8\u05d5\u05e4\u05dc (Dulcan p.667)."
    },
    {
      "front": "\u05dc\u05e4\u05d9 \u05d4-Nelson et al. (2003), \u05db\u05d9\u05e6\u05d3 \u05d4\u05e9\u05e4\u05d9\u05e2 \u05d8\u05d9\u05e4\u05d5\u05dc CBT \u05de\u05e8\u05d7\u05d5\u05e7 \u05e2\u05dc \u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05e9\u05dc \u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd?",
      "back": "\u05e0\u05de\u05e6\u05d0\u05d4 \u05d4\u05e4\u05d7\u05ea\u05d4 \u05d1\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05d4\u05d3\u05d5\u05de\u05d4 \u05dc\u05d6\u05d5 \u05d4\u05de\u05d5\u05e9\u05d2\u05ea \u05d1\u05d8\u05d9\u05e4\u05d5\u05dc CBT \u05e4\u05e8\u05d5\u05e0\u05d8\u05dc\u05d9 (Dulcan p.655)."
    },
    {
      "front": "\u05d0\u05d9\u05dc\u05d5 \u05e4\u05e2\u05d5\u05dc\u05d5\u05ea \u05d0\u05d9\u05de\u05d5\u05ea \u05d7\u05d5\u05d1\u05d4 \u05e2\u05dc \u05d4\u05e7\u05dc\u05d9\u05e0\u05d0\u05d9 \u05dc\u05d1\u05e6\u05e2 \u05d1\u05e4\u05ea\u05d7 \u05db\u05dc \u05de\u05e4\u05d2\u05e9 TMH?",
      "back": "\u05d0\u05d9\u05de\u05d5\u05ea \u05d6\u05d4\u05d5\u05ea \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05d5\u05d6\u05d9\u05d4\u05d5\u05d9 \u05d4\u05de\u05d9\u05e7\u05d5\u05dd \u05d4\u05e4\u05d9\u05d6\u05d9 \u05d4\u05de\u05d3\u05d5\u05d9\u05e7 \u05e9\u05d1\u05d5 \u05d4\u05d5\u05d0 \u05e9\u05d5\u05d4\u05d4 (Dulcan p.657)."
    },
    {
      "front": "\u05de\u05d3\u05d5\u05e2 \u05de\u05d5\u05de\u05dc\u05e5 \u05dc\u05de\u05e7\u05dd \u05d0\u05ea \u05d7\u05dc\u05d5\u05df \u05d4-EMR \u05de\u05e2\u05dc \u05d0\u05d5 \u05de\u05ea\u05d7\u05ea \u05dc\u05ea\u05de\u05d5\u05e0\u05ea \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05d5\u05dc\u05d0 \u05dc\u05e6\u05d3\u05d3\u05d9\u05d4?",
      "back": "\u05db\u05d3\u05d9 \u05e9\u05ea\u05e0\u05d5\u05e2\u05ea \u05d4\u05de\u05d1\u05d8 \u05e9\u05dc \u05d4\u05e7\u05dc\u05d9\u05e0\u05d0\u05d9 \u05ea\u05d9\u05e8\u05d0\u05d4 \u05db\u05d4\u05e0\u05d4\u05d5\u05df (affirmative nod) \u05d5\u05dc\u05d0 \u05db\u05d4\u05e1\u05d8\u05ea \u05e8\u05d0\u05e9 \u05dc\u05e9\u05dc\u05d9\u05dc\u05d4 (Dulcan p.661)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05db\u05dc\u05dc \u05dc\u05d2\u05d1\u05d9 \u05d4\u05e1\u05db\u05de\u05d4 \u05de\u05d3\u05e2\u05ea (Informed consent) \u05d1\u05de\u05e6\u05d1\u05d9 \u05de\u05e9\u05de\u05d5\u05e8\u05ea \u05de\u05e9\u05d5\u05ea\u05e4\u05ea \u05dc\u05e4\u05d9 StahlKids?",
      "back": "\u05de\u05d5\u05de\u05dc\u05e5 \u05dc\u05e7\u05d1\u05dc \u05d4\u05e1\u05db\u05de\u05d4 \u05de\u05e9\u05e0\u05d9 \u05d4\u05d0\u05e4\u05d5\u05d8\u05e8\u05d5\u05e4\u05d5\u05e1\u05d9\u05dd \u05d4\u05d7\u05d5\u05e7\u05d9\u05d9\u05dd \u05dc\u05dc\u05d0 \u05e7\u05e9\u05e8 \u05dc\u05d0\u05d7\u05d5\u05d6\u05d9 \u05d4\u05de\u05e9\u05de\u05d5\u05e8\u05ea (StahlKids p.184)."
    },
    {
      "front": "\u05de\u05d4\u05df \u05de\u05d2\u05d1\u05dc\u05d5\u05ea \u05d4\u05e1\u05d5\u05d3\u05d9\u05d5\u05ea (Confidentiality) \u05e9\u05d9\u05e9 \u05dc\u05d4\u05e1\u05d1\u05d9\u05e8 \u05dc\u05de\u05ea\u05d1\u05d2\u05e8 \u05d1\u05ea\u05d7\u05d9\u05dc\u05ea \u05d4\u05e2\u05e8\u05db\u05ea TMH?",
      "back": "\u05d7\u05d5\u05d1\u05ea \u05d3\u05d9\u05d5\u05d5\u05d7 \u05dc\u05d4\u05d5\u05e8\u05d9\u05dd \u05d0\u05d5 \u05dc\u05e8\u05e9\u05d5\u05d9\u05d5\u05ea \u05d1\u05de\u05e7\u05e8\u05d4 \u05e9\u05dc \u05e1\u05db\u05e0\u05d4 \u05dc\u05e2\u05e6\u05de\u05d5/\u05dc\u05d0\u05d7\u05e8\u05d9\u05dd \u05d0\u05d5 \u05d7\u05e9\u05d9\u05e4\u05ea abuse (Dulcan p.82, p.640)."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05de\u05e9\u05e4\u05d9\u05e2 \u05d4\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05e6\u05d9\u05d5\u05d3 \u05d5\u05d9\u05d3\u05d0\u05d5 \u05e2\u05dc \u05d4\u05ea\u05e7\u05e9\u05d5\u05e8\u05ea \u05d4\u05dc\u05d0-\u05de\u05d9\u05dc\u05d5\u05dc\u05d9\u05ea \u05e9\u05dc \u05d4\u05de\u05d8\u05e4\u05dc?",
      "back": "\u05d4\u05de\u05db\u05e9\u05d5\u05e8 \u05e0\u05d5\u05d8\u05d4 \u05dc\u05e9\u05d8\u05d7 (Flattening) \u05d4\u05d1\u05e2\u05d5\u05ea \u05e8\u05d2\u05e9\u05d9\u05d5\u05ea, \u05d5\u05dc\u05db\u05df \u05e0\u05d3\u05e8\u05e9\u05ea \u05d4\u05e2\u05e6\u05de\u05d4 \u05de\u05ea\u05d5\u05e0\u05d4 \u05e9\u05dc \u05d4\u05d1\u05e2\u05d5\u05ea \u05e4\u05e0\u05d9\u05dd \u05d5\u05d8\u05d5\u05df \u05d3\u05d9\u05d1\u05d5\u05e8 (Dulcan p.663)."
    },
    {
      "front": "\u05de\u05d4 \u05de\u05d4\u05d5\u05d5\u05d4 \u05d4\u05ea\u05d5\u05d5\u05d9\u05d9\u05ea \u05e0\u05d2\u05d3 (Contraindication) \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc TMH \u05d1\u05d1\u05d9\u05ea \u05d4\u05de\u05d8\u05d5\u05e4\u05dc?",
      "back": "\u05de\u05e6\u05d1\u05d9 \u05d0\u05d5\u05d1\u05d3\u05e0\u05d5\u05ea \u05d0\u05e7\u05d5\u05d8\u05d9\u05ea \u05d0\u05d5 \u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d4 \u05e1\u05d5\u05e2\u05e8\u05ea \u05dc\u05dc\u05d0 \u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05de\u05d1\u05d5\u05d2\u05e8 \u05d0\u05d7\u05e8\u05d0\u05d9 \u05d0\u05d5 \u05e1\u05d1\u05d9\u05d1\u05d4 \u05d1\u05d8\u05d5\u05d7\u05d4 (\u05de\u05e7\u05d5\u05e8: \u05d4\u05e7\u05e9\u05e8 \u05e8\u05d7\u05d1; Dulcan p.666)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05d3\u05e8\u05d9\u05e9\u05d4 \u05d4\u05e8\u05d2\u05d5\u05dc\u05d8\u05d5\u05e8\u05d9\u05ea \u05d4\u05de\u05e8\u05db\u05d6\u05d9\u05ea \u05d1\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05e4\u05dc\u05d8\u05e4\u05d5\u05e8\u05de\u05ea \u05d5\u05d9\u05d3\u05d0\u05d5 \u05dc\u05e4\u05d9 HIPAA?",
      "back": "\u05d7\u05ea\u05d9\u05de\u05d4 \u05e2\u05dc Business Associate Agreement (BAA) \u05de\u05d5\u05dc \u05e1\u05e4\u05e7 \u05d4\u05ea\u05d5\u05db\u05e0\u05d4 \u05dc\u05d4\u05d1\u05d8\u05d7\u05ea \u05d0\u05d1\u05d8\u05d7\u05ea \u05d4-ePHI (Dulcan p.656)."
    },
    {
      "front": "\u05d0\u05d9\u05d6\u05d4 \u05db\u05dc\u05d9 \u05d4\u05e2\u05e8\u05db\u05d4 \u05e0\u05de\u05e6\u05d0 \u05de\u05d4\u05d9\u05de\u05df \u05dc\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05d5\u05d5\u05d9\u05d3\u05d0\u05d5-\u05e7\u05d5\u05e0\u05e4\u05e8\u05e0\u05e1 \u05dc\u05d6\u05d9\u05d4\u05d5\u05d9 \u05ea\u05d5\u05e4\u05e2\u05d5\u05ea \u05dc\u05d5\u05d5\u05d0\u05d9 \u05de\u05d5\u05d8\u05d5\u05e8\u05d9\u05d5\u05ea?",
      "back": "\u05d4-Abnormal Involuntary Movement Scale (AIMS) (Dulcan p.655)."
    },
    {
      "front": "\u05d1\u05de\u05ea\u05df \u05e9\u05d9\u05e8\u05d5\u05ea\u05d9 TMH \u05d1\u05ea\u05d5\u05da \u05d1\u05ea\u05d9 \u05e1\u05e4\u05e8, \u05d0\u05d9\u05dc\u05d5 \u05e9\u05e0\u05d9 \u05d7\u05d5\u05e7\u05d9 \u05e4\u05e8\u05d8\u05d9\u05d5\u05ea \u05e4\u05d3\u05e8\u05dc\u05d9\u05d9\u05dd \u05d7\u05dc\u05d9\u05dd?",
