{
  "title": "Delirium Quiz",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\u05de\u05ea\u05d1\u05d2\u05e8 \u05d1\u05df 17 \u05de\u05d0\u05d5\u05e9\u05e4\u05d6 \u05d1-ICU \u05dc\u05d0\u05d7\u05e8 \u05e4\u05d2\u05d9\u05e2\u05ea \u05e8\u05d0\u05e9 \u05d5\u05e0\u05d9\u05ea\u05d5\u05d7 \u05d3\u05d7\u05d5\u05e3. \u05d4\u05e6\u05d5\u05d5\u05ea \u05d4\u05e1\u05d9\u05e2\u05d5\u05d3\u05d9 \u05de\u05d3\u05d5\u05d5\u05d7 \u05db\u05d9 \u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05d9\u05d5\u05dd \u05d4\u05d5\u05d0 \u05e0\u05e8\u05d0\u05d4 \u05e2\u05e8\u05e0\u05d9 \u05d5\u05de\u05e9\u05ea\u05e3 \u05e4\u05e2\u05d5\u05dc\u05d4, \u05d0\u05da \u05dc\u05e7\u05e8\u05d0\u05ea \u05d4\u05e2\u05e8\u05d1 \u05d4\u05d5\u05d0 \u05de\u05ea\u05d7\u05d9\u05dc \u05dc\u05e6\u05e2\u05d5\u05e7, \u05dc\u05d0 \u05de\u05d6\u05d4\u05d4 \u05d0\u05ea \u05d4\u05d5\u05e8\u05d9\u05d5 \u05d5\u05de\u05e0\u05e1\u05d4 \u05dc\u05ea\u05dc\u05d5\u05e9 \u05d0\u05ea \u05d4\u05e6\u05d9\u05e0\u05d5\u05e8\u05d5\u05ea. \u05d1\u05d1\u05d3\u05d9\u05e7\u05d4, \u05d4\u05d5\u05d0 \u05de\u05ea\u05e7\u05e9\u05d4 \u05dc\u05d7\u05d6\u05d5\u05e8 \u05e2\u05dc \u05e8\u05e6\u05e3 \u05e1\u05e4\u05e8\u05d5\u05ea \u05dc\u05d0\u05d7\u05d5\u05e8 \u05d5\u05de\u05d5\u05e1\u05d7 \u05d1\u05e7\u05dc\u05d5\u05ea \u05e2\u05dc \u05d9\u05d3\u05d9 \u05e8\u05e2\u05e9\u05d9\u05dd \u05d1\u05de\u05e1\u05d3\u05e8\u05d5\u05df. \u05de\u05d4\u05d5 \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9 \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR \u05d4\u05de\u05d1\u05d3\u05d9\u05dc \u05de\u05e6\u05d1 \u05d6\u05d4 \u05de\u05d4\u05e4\u05e8\u05e2\u05d4 \u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9\u05ea \u05e8\u05d0\u05e9\u05d5\u05e0\u05d9\u05ea?",
      "answerOptions": [
        {
          "text": "\u05d4\u05ea\u05e0\u05d5\u05d3\u05ea\u05d9\u05d5\u05ea \u05d1\u05d7\u05d5\u05de\u05e8\u05ea \u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05dc\u05d0\u05d5\u05e8\u05da \u05d4\u05d9\u05de\u05de\u05d4 (Fluctuating course).",
          "isCorrect": true,
          "rationale": "\u05dc\u05e4\u05d9 Criterion B, \u05d3\u05dc\u05d9\u05e8\u05d9\u05d5\u05dd \u05de\u05ea\u05d0\u05e4\u05d9\u05d9\u05df \u05d1\u05de\u05d4\u05dc\u05da \u05d7\u05e8\u05d9\u05e3 \u05d5\u05ea\u05e0\u05d5\u05d3\u05ea\u05d9, \u05dc\u05e8\u05d5\u05d1 \u05e2\u05dd \u05d4\u05d7\u05de\u05e8\u05d4 \u05d1\u05e2\u05e8\u05d1, \u05d1\u05e2\u05d5\u05d3 \u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9\u05d5\u05ea \u05e0\u05d5\u05d8\u05d5\u05ea \u05dc\u05d4\u05d9\u05d5\u05ea \u05d9\u05e6\u05d9\u05d1\u05d5\u05ea \u05d9\u05d5\u05ea\u05e8 \u05dc\u05d0\u05d5\u05e8\u05da \u05d4\u05d9\u05de\u05de\u05d4 (DSM p.672, p.676)."
        },
        {
          "text": "\u05e0\u05d5\u05db\u05d7\u05d5\u05ea\u05df \u05e9\u05dc \u05d4\u05d6\u05d9\u05d5\u05ea \u05d7\u05d6\u05d5\u05ea\u05d9\u05d5\u05ea (Visual hallucinations).",
          "isCorrect": false,
          "rationale": "\u05d4\u05d6\u05d9\u05d5\u05ea \u05d7\u05d6\u05d5\u05ea\u05d9\u05d5\u05ea \u05e0\u05e4\u05d5\u05e6\u05d5\u05ea \u05d1\u05d3\u05dc\u05d9\u05e8\u05d9\u05d5\u05dd \u05d0\u05da \u05d9\u05db\u05d5\u05dc\u05d5\u05ea \u05dc\u05d4\u05d5\u05e4\u05d9\u05e2 \u05d2\u05dd \u05d1\u05de\u05e6\u05d1\u05d9\u05dd \u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9\u05d9\u05dd \u05d0\u05d5 \u05de\u05d0\u05e0\u05d9\u05d4, \u05d5\u05dc\u05db\u05df \u05d0\u05d9\u05e0\u05df \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05d4\u05de\u05d1\u05d7\u05d9\u05df \u05d4\u05de\u05e8\u05db\u05d6\u05d9 (DSM p.678)."
        },
        {
          "text": "\u05d4\u05d9\u05e8\u05d9\u05d3\u05d4 \u05d1\u05e8\u05de\u05ea \u05d4\u05e2\u05d5\u05e8\u05e8\u05d5\u05ea (Reduced level of arousal).",
          "isCorrect": false,
          "rationale": "\u05dc\u05e4\u05d9 \u05d4\u05d2\u05d3\u05e8\u05ea \u05e8\u05e6\u05e3 \u05d4\u05e2\u05d5\u05e8\u05e8\u05d5\u05ea, \u05d3\u05dc\u05d9\u05e8\u05d9\u05d5\u05dd \u05de\u05ea\u05e8\u05d7\u05e9 \u05d1\u05e7\u05d5\u05e8\u05d8\u05e7\u05e1 \u05de\u05e2\u05d5\u05e8\u05e8 ($aroused cortex$), \u05d1\u05e2\u05d5\u05d3 \u05d9\u05e8\u05d9\u05d3\u05d4 \u05d7\u05de\u05d5\u05e8\u05d4 \u05d1\u05e2\u05d5\u05e8\u05e8\u05d5\u05ea \u05de\u05db\u05d5\u05d5\u05e0\u05ea \u05dc-Stupor \u05d0\u05d5 Coma (DSM p.676)."
        },
        {
          "text": "\u05d7\u05d5\u05e1\u05e8 \u05e9\u05d9\u05ea\u05d5\u05e3 \u05e4\u05e2\u05d5\u05dc\u05d4 \u05e2\u05dd \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05e8\u05e4\u05d5\u05d0\u05d9.",
          "isCorrect": false,
          "rationale": "\u05d6\u05d4\u05d5 \u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea\u05d9 \u05e9\u05db\u05d9\u05d7 \u05d1\u05ea\u05ea-\u05d4\u05e1\u05d5\u05d2 \u05d4\u05d4\u05d9\u05e4\u05e8\u05d0\u05e7\u05d8\u05d9\u05d1\u05d9, \u05d0\u05da \u05d4\u05d5\u05d0 \u05d0\u05d9\u05e0\u05d5 \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df \u05d0\u05d1\u05d7\u05e0\u05ea\u05d9 \u05d4\u05de\u05d1\u05d3\u05d9\u05dc \u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d4 \u05de\u05d3\u05dc\u05d9\u05e8\u05d9\u05d5\u05dd (DSM p.672)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05d3\u05d9\u05e0\u05de\u05d9\u05e7\u05d4 \u05e9\u05dc \u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05dc\u05d0\u05d5\u05e8\u05da \u05d4\u05d9\u05d5\u05dd \u05d5\u05d4\u05dc\u05d9\u05dc\u05d4."
    },
    {
      "type": "multiple_choice",
      "question": "\u05de\u05d8\u05d5\u05e4\u05dc\u05ea \u05d1\u05ea 72 \u05de\u05d0\u05d5\u05e9\u05e4\u05d6\u05ea \u05d1\u05de\u05d7\u05dc\u05e7\u05d4 \u05e4\u05e0\u05d9\u05de\u05d9\u05ea \u05e2\u05e7\u05d1 \u05d6\u05d9\u05d4\u05d5\u05dd \u05d1\u05d3\u05e8\u05db\u05d9 \u05d4\u05e9\u05ea\u05df. \u05d4\u05e6\u05d5\u05d5\u05ea \u05de\u05d3\u05d5\u05d5\u05d7 \u05e9\u05d4\u05d9\u05d0 '\u05e9\u05e7\u05d8\u05d4 \u05de\u05d0\u05d5\u05d3', \u05d0\u05d3\u05d9\u05e9\u05d4 \u05dc\u05e1\u05d1\u05d9\u05d1\u05ea\u05d4, \u05de\u05de\u05e2\u05d9\u05d8\u05d4 \u05dc\u05d3\u05d1\u05e8 \u05d5\u05e0\u05e8\u05d0\u05d9\u05ea \u05d9\u05e9\u05e0\u05d5\u05e0\u05d9\u05ea \u05e8\u05d5\u05d1 \u05d4\u05d6\u05de\u05df. \u05e8\u05d5\u05e4\u05d0 \u05d4\u05de\u05d7\u05dc\u05e7\u05d4 \u05e1\u05d1\u05d5\u05e8 \u05db\u05d9 \u05d4\u05d9\u05d0 \u05e1\u05d5\u05d1\u05dc\u05ea \u05de\u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05e2\u05dc \u05e8\u05e7\u05e2 \u05d4\u05d0\u05e9\u05e4\u05d5\u05d6. \u05de\u05d4\u05d5 \u05d4\u05d3\u05d2\u05e9 \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9 \u05d4\u05d7\u05e9\u05d5\u05d1 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05d2\u05d1\u05d9 \u05de\u05e6\u05d1 \u05d6\u05d4 \u05dc\u05e4\u05d9 \u05d4\u05de\u05e7\u05d5\u05e8\u05d5\u05ea?",
      "answerOptions": [
        {
          "text": "\u05de\u05d3\u05d5\u05d1\u05e8 \u05d1-Hypoactive Delirium \u05e9\u05dc\u05e2\u05d9\u05ea\u05d9\u05dd \u05e7\u05e8\u05d5\u05d1\u05d5\u05ea \u05d0\u05d9\u05e0\u05d5 \u05de\u05d6\u05d5\u05d4\u05d4 \u05d0\u05d5 \u05de\u05d0\u05d5\u05d1\u05d7\u05df \u05d1\u05d8\u05e2\u05d5\u05ea \u05db\u05d3\u05d9\u05db\u05d0\u05d5\u05df.",
          "isCorrect": true,
          "rationale": "\u05ea\u05ea-\u05d4\u05e1\u05d5\u05d2 \u05d4\u05d4\u05d9\u05e4\u05d5\u05d0\u05e7\u05d8\u05d9\u05d1\u05d9 \u05e9\u05db\u05d9\u05d7 \u05d1\u05e7\u05e9\u05d9\u05e9\u05d9\u05dd \u05d5\u05dc\u05e2\u05d9\u05ea\u05d9\u05dd \u05e7\u05e8\u05d5\u05d1\u05d5\u05ea \u05de\u05d5\u05e4\u05e1\u05e4\u05e1 \u05e2\u05dc \u05d9\u05d3\u05d9 \u05e6\u05d5\u05d5\u05ea\u05d9\u05dd \u05e8\u05e4\u05d5\u05d0\u05d9\u05d9\u05dd \u05d4\u05de\u05d9\u05d9\u05d7\u05e1\u05d9\u05dd \u05d0\u05ea \u05d4\u05e9\u05e7\u05d8 \u05dc\u05d0\u05e4\u05ea\u05d9\u05d4 \u05d0\u05d5 \u05e2\u05d9\u05d9\u05e4\u05d5\u05ea (DSM p.677, \u05ea\u05de\u05e6\u05d9\u05ea \u05d3\u05dc\u05d9\u05e8\u05d9\u05d5\u05dd \u05e2\u05de' 9)."
        },
        {
          "text": "\u05d9\u05e9 \u05dc\u05d4\u05ea\u05d7\u05d9\u05dc \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-SSRIs \u05d1\u05de\u05d9\u05e0\u05d5\u05df \u05e0\u05de\u05d5\u05da \u05dc\u05e9\u05d9\u05e4\u05d5\u05e8 \u05d4\u05de\u05e6\u05d1 \u05d4\u05e8\u05d5\u05d7.",
          "isCorrect": false,
          "rationale": "\u05d8\u05d9\u05e4\u05d5\u05dc \u05e0\u05d5\u05d2\u05d3 \u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05d0\u05d9\u05e0\u05d5 \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05d1\u05d7\u05d9\u05e8\u05d4 \u05d1\u05d3\u05dc\u05d9\u05e8\u05d9\u05d5\u05dd, \u05d5\u05d1\u05de\u05e6\u05d1 \u05d7\u05e8\u05d9\u05e3 \u05d9\u05e9 \u05e7\u05d5\u05d3\u05dd \u05db\u05dc \u05dc\u05e9\u05dc\u05d5\u05dc \u05e1\u05d9\u05d1\u05d4 \u05d0\u05d5\u05e8\u05d2\u05e0\u05d9\u05ea (StahlNeuro p.533)."
        },
        {
          "text": "\u05de\u05e6\u05d1 \u05d6\u05d4 \u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05d3\u05dc\u05d9\u05e8\u05d9\u05d5\u05dd \u05d4\u05e0\u05d2\u05e8\u05dd \u05d0\u05da \u05d5\u05e8\u05e7 \u05de\u05d2\u05de\u05d9\u05dc\u05d4 \u05de\u05d7\u05d5\u05de\u05e8\u05d9\u05dd (Withdrawal).",
          "isCorrect": false,
          "rationale": "\u05d3\u05dc\u05d9\u05e8\u05d9\u05d5\u05dd \u05d4\u05d9\u05e4\u05d5\u05d0\u05e7\u05d8\u05d9\u05d1\u05d9 \u05d9\u05db\u05d5\u05dc \u05dc\u05d4\u05d9\u05d2\u05e8\u05dd \u05de\u05de\u05d2\u05d5\u05d5\u05df \u05e1\u05d9\u05d1\u05d5\u05ea \u05e8\u05e4\u05d5\u05d0\u05d9\u05d5\u05ea, \u05db\u05d5\u05dc\u05dc \u05d6\u05d9\u05d4\u05d5\u05de\u05d9\u05dd \u05d5\u05ea\u05e8\u05d5\u05e4\u05d5\u05ea, \u05d5\u05dc\u05d0 \u05e8\u05e7 \u05de\u05d2\u05de\u05d9\u05dc\u05d4 (DSM p.672)."
        },
        {
          "text": "\u05d9\u05e9 \u05dc\u05d4\u05e9\u05ea\u05de\u05e9 \u05d1-Benzodiazepines \u05db\u05d3\u05d9 \u05dc\u05e2\u05d5\u05e8\u05e8 \u05d0\u05ea \u05d4\u05de\u05d8\u05d5\u05e4\u05dc\u05ea.",
          "isCorrect": false,
          "rationale": "\u05d1\u05e0\u05d6\u05d5\u05d3\u05d9\u05d0\u05d6\u05e4\u05d9\u05e0\u05d9\u05dd \u05e2\u05dc\u05d5\u05dc\u05d9\u05dd \u05dc\u05d4\u05d7\u05de\u05d9\u05e8 \u05d0\u05ea \u05d4\u05d1\u05dc\u05d1\u05d5\u05dc \u05d5\u05d4\u05d8\u05e9\u05d8\u05d5\u05e9 \u05d1\u05d3\u05dc\u05d9\u05e8\u05d9\u05d5\u05dd \u05d5\u05d0\u05d9\u05e0\u05dd \u05de\u05e9\u05de\u05e9\u05d9\u05dd \u05db\u05de\u05e2\u05d5\u05e8\u05e8\u05d9\u05dd (Dulcan p.616)."
        }
      ],
      "hint": "\u05d4\u05ea\u05de\u05e7\u05d3 \u05d1\u05e1\u05d9\u05db\u05d5\u05df \u05d4\u05d0\u05d1\u05d7\u05e0\u05ea\u05d9 \u05e9\u05dc \u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd \u05e9\u05e7\u05d8\u05d9\u05dd \u05d1\u05d7\u05d3\u05e8\u05d9 \u05de\u05d9\u05d5\u05df \u05d5\u05de\u05d7\u05dc\u05e7\u05d5\u05ea."
    },
    {
      "type": "multiple_choice",
      "question": "\u05d2\u05d1\u05e8 \u05d1\u05df 30 \u05de\u05d5\u05d1\u05d0 \u05dc\u05de\u05d9\u05d5\u05df \u05e2\u05dd \u05db\u05d0\u05d1\u05d9 \u05d1\u05d8\u05df \u05e2\u05d6\u05d9\u05dd (colicky abdominal pain), \u05d7\u05d5\u05dc\u05e9\u05ea \u05e9\u05e8\u05d9\u05e8\u05d9\u05dd \u05d5\u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d4 \u05e1\u05d5\u05e2\u05e8\u05ea. \u05d1\u05d1\u05d3\u05d9\u05e7\u05ea \u05d4\u05e8\u05e7\u05e2 \u05e2\u05d5\u05dc\u05d4 \u05db\u05d9 \u05d4\u05d5\u05d0 \u05e1\u05d5\u05d1\u05dc \u05de\u05d4\u05e4\u05e8\u05e2\u05d4 \u05d2\u05e0\u05d8\u05d9\u05ea \u05e9\u05dc \u05d4\u05de\u05d8\u05d1\u05d5\u05dc\u05d9\u05d6\u05dd \u05e9\u05dc Heme. \u05d0\u05d9\u05d6\u05d4 \u05e1\u05d5\u05d2 \u05e9\u05dc \u05ea\u05e8\u05d5\u05e4\u05d4 \u05de\u05d4\u05d5\u05d5\u05d4 \u05d4\u05ea\u05d5\u05d5\u05d9\u05d9\u05ea \u05e0\u05d2\u05d3 \u05de\u05d5\u05d7\u05dc\u05d8\u05ea ($contraindication$) \u05d1\u05de\u05e7\u05e8\u05d4 \u05d6\u05d4 \u05de\u05d7\u05e9\u05e9 \u05dc\u05d4\u05d7\u05de\u05e8\u05ea \u05d4\u05de\u05e6\u05d1?",
      "answerOptions": [
        {
          "text": "Barbiturates",
          "isCorrect": true,
          "rationale": "\u05d1-Acute Intermittent Porphyria, \u05d1\u05e8\u05d1\u05d9\u05d8\u05d5\u05e8\u05d8\u05d9\u05dd \u05e2\u05dc\u05d5\u05dc\u05d9\u05dd \u05dc\u05d6\u05e8\u05d6 \u05d0\u05d5 \u05dc\u05d4\u05d7\u05de\u05d9\u05e8 \u05d4\u05ea\u05e7\u05e4\u05d9\u05dd \u05d7\u05e8\u05d9\u05e4\u05d9\u05dd \u05d5\u05dc\u05db\u05df \u05d0\u05e1\u05d5\u05e8\u05d9\u05dd \u05dc\u05e9\u05d9\u05de\u05d5\u05e9 (Synopsis ch.3.4)."
        },
        {
          "text": "Haloperidol",
          "isCorrect": false,
          "rationale": "\u05d4\u05dc\u05d5\u05e4\u05e8\u05d9\u05d3\u05d5\u05dc \u05d9\u05db\u05d5\u05dc \u05dc\u05e9\u05de\u05e9 \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9\u05d9\u05dd \u05d1\u05d3\u05dc\u05d9\u05e8\u05d9\u05d5\u05dd \u05d5\u05d0\u05d9\u05e0\u05d5 \u05e0\u05d7\u05e9\u05d1 \u05dc\u05de\u05e2\u05d5\u05e8\u05e8 \u05d4\u05ea\u05e7\u05e4\u05d9 \u05e4\u05d5\u05e8\u05e4\u05d9\u05e8\u05d9\u05d4 (Dulcan p.612)."
        },
        {
          "text": "Quetiapine",
          "isCorrect": false,
          "rationale": "\u05e7\u05d5\u05d5\u05d8\u05d9\u05d0\u05e4\u05d9\u05df \u05d1\u05de\u05d9\u05e0\u05d5\u05df \u05e0\u05de\u05d5\u05da \u05d1\u05d8\u05d5\u05d7 \u05d9\u05d7\u05e1\u05d9\u05ea \u05dc\u05e9\u05d9\u05de\u05d5\u05e9 \u05dc\u05d4\u05e8\u05d2\u05e2\u05d4 \u05d5\u05d0\u05d9\u05e0\u05d5 \u05e7\u05e9\u05d5\u05e8 \u05d9\u05e9\u05d9\u05e8\u05d5\u05ea \u05dc\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05d4\u05d7\u05de\u05e8\u05d4 \u05e9\u05dc AIP (StahlNeuro p.219)."
        },
        {
          "text": "Acetaminophen",
          "isCorrect": false,
          "rationale": "\u05d0\u05e6\u05d8\u05de\u05d9\u05e0\u05d5\u05e4\u05df \u05de\u05e9\u05de\u05e9 \u05dc\u05e9\u05d9\u05db\u05d5\u05da \u05db\u05d0\u05d1\u05d9\u05dd \u05d5\u05d0\u05d9\u05e0\u05d5 \u05de\u05d4\u05d5\u05d5\u05d4 \u05d2\u05d5\u05e8\u05dd \u05e1\u05d9\u05db\u05d5\u05df \u05d1\u05e4\u05d5\u05e8\u05e4\u05d9\u05e8\u05d9\u05d4 (StahlNeuro p.537)."
        }
      ],
      "hint": "\u05d4\u05ea\u05d9\u05d9\u05d7\u05e1 \u05dc\u05de\u05d7\u05dc\u05d4 \u05d4\u05de\u05d8\u05d1\u05d5\u05dc\u05d9\u05ea \u05d4\u05de\u05e2\u05e8\u05d1\u05ea \u05db\u05d0\u05d1\u05d9 \u05d1\u05d8\u05df \u05d5\u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d4."
    },
    {
      "type": "multiple_choice",
      "question": "\u05d1\u05e0\u05d9\u05d4\u05d5\u05dc \u05d3\u05dc\u05d9\u05e8\u05d9\u05d5\u05dd \u05d1\u05d9\u05dc\u05d3 \u05e2\u05dd ASD \u05d4\u05de\u05d0\u05d5\u05e9\u05e4\u05d6 \u05d1\u05d1\u05d9\u05ea \u05d7\u05d5\u05dc\u05d9\u05dd, \u05de\u05d4\u05d9 \u05d4\u05d0\u05e1\u05d8\u05e8\u05d8\u05d2\u05d9\u05d4 \u05d4\u05dc\u05d0-\u05e4\u05e8\u05de\u05e7\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea \u05d4\u05e8\u05d0\u05e9\u05d5\u05e0\u05d4 \u05d4\u05de\u05d5\u05de\u05dc\u05e6\u05ea \u05dc\u05de\u05e0\u05d9\u05e2\u05ea \u05d4\u05e1\u05dc\u05de\u05d4 \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea\u05d9\u05ea \u05dc\u05e4\u05d9 Dulcan?",
      "answerOptions": [
        {
          "text": "\u05d0\u05d5\u05e4\u05d8\u05d9\u05de\u05d9\u05d6\u05e6\u05d9\u05d4 \u05e9\u05dc \u05d4\u05e1\u05d1\u05d9\u05d1\u05d4 \u05d4\u05d7\u05d5\u05e9\u05d9\u05ea \u05d5\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05dc\u05d5\u05d7\u05d5\u05ea \u05d6\u05de\u05e0\u05d9\u05dd \u05d5\u05d9\u05d6\u05d5\u05d0\u05dc\u05d9\u05d9\u05dd.",
          "isCorrect": true,
          "rationale": "\u05d4\u05ea\u05d0\u05de\u05ea \u05d4\u05e1\u05d1\u05d9\u05d1\u05d4 (\u05d4\u05e4\u05d7\u05ea\u05ea \u05e8\u05e2\u05e9, \u05ea\u05d0\u05d5\u05e8\u05d4 \u05de\u05ea\u05d0\u05d9\u05de\u05d4) \u05d5\u05d9\u05e6\u05d9\u05e8\u05ea \u05e9\u05d2\u05e8\u05d4 \u05e6\u05e4\u05d5\u05d9\u05d4 \u05d1\u05e2\u05d6\u05e8\u05ea \u05e2\u05d6\u05e8\u05d9\u05dd \u05d5\u05d9\u05d6\u05d5\u05d0\u05dc\u05d9\u05d9\u05dd \u05d4\u05dd \u05db\u05dc\u05d9 \u05d4\u05de\u05e4\u05ea\u05d7 \u05dc\u05de\u05e0\u05d9\u05e2\u05ea \u05de\u05e9\u05d1\u05e8\u05d9\u05dd \u05d1-ASD (Dulcan p.152)."
        },
        {
          "text": "\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1-Physical Restraints \u05dc\u05de\u05e0\u05d9\u05e2\u05ea \u05e4\u05d2\u05d9\u05e2\u05d4 \u05e2\u05e6\u05de\u05d9\u05ea.",
          "isCorrect": false,
          "rationale": "\u05d9\u05e9 \u05dc\u05d4\u05d9\u05de\u05e0\u05e2 \u05de\u05de\u05e2\u05e6\u05e8\u05d9 \u05d2\u05d5\u05e3 \u05e4\u05d9\u05d6\u05d9\u05d9\u05dd \u05d1\u05de\u05d9\u05d3\u05ea \u05d4\u05d0\u05e4\u05e9\u05e8, \u05e9\u05db\u05df \u05d4\u05dd \u05e0\u05d5\u05d8\u05d9\u05dd \u05dc\u05d4\u05d7\u05de\u05d9\u05e8 \u05d0\u05ea \u05d4\u05d0\u05d2\u05d9\u05d8\u05e6\u05d9\u05d4 \u05d5\u05d4\u05ea\u05e1\u05db\u05d5\u05dc (Dulcan p.152, p.616)."
        },
        {
          "text": "\u05d4\u05ea\u05d7\u05dc\u05d4 \u05de\u05d9\u05d9\u05d3\u05d9\u05ea \u05e9\u05dc $D_2$ antagonists \u05d1\u05de\u05d9\u05e0\u05d5\u05df \u05d2\u05d1\u05d5\u05d4.",
          "isCorrect": false,
          "rationale": "\u05d8\u05d9\u05e4\u05d5\u05dc \u05ea\u05e8\u05d5\u05e4\u05ea\u05d9 \u05d0\u05d9\u05e0\u05d5 \u05d4\u05e7\u05d5 \u05d4\u05e8\u05d0\u05e9\u05d5\u05df \u05d5\u05e0\u05d5\u05e2\u05d3 \u05e8\u05e7 \u05dc\u05de\u05e6\u05d1\u05d9 \u05e1\u05db\u05e0\u05d4; \u05d1\u05de\u05d9\u05d3\u05ea \u05d4\u05e6\u05d5\u05e8\u05da \u05de\u05e9\u05ea\u05de\u05e9\u05d9\u05dd \u05d1\u05de\u05d9\u05e0\u05d5\u05e0\u05d9\u05dd \u05e0\u05de\u05d5\u05db\u05d9\u05dd (Dulcan p.611)."
        },
        {
          "text": "\u05d1\u05d9\u05d3\u05d5\u05d3 \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05d1\u05d7\u05d3\u05e8 \u05d7\u05e9\u05d5\u05da \u05dc\u05dc\u05d0 \u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05de\u05e9\u05e4\u05d7\u05d4.",
          "isCorrect": false,
          "rationale": "\u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05de\u05e9\u05e4\u05d7\u05d4 \u05d3\u05d5\u05d5\u05e7\u05d0 \u05de\u05d5\u05de\u05dc\u05e6\u05ea \u05dc\u05de\u05ea\u05df \u05ea\u05d7\u05d5\u05e9\u05ea \u05d1\u05d9\u05d8\u05d7\u05d5\u05df \u05d5\u05e8\u05e6\u05d9\u05e4\u05d5\u05ea, \u05d0\u05dc\u05d0 \u05d0\u05dd \u05d4\u05d9\u05d0 \u05de\u05d4\u05d5\u05d5\u05d4 \u05d2\u05d5\u05e8\u05dd \u05de\u05ea\u05e1\u05d9\u05e1 (Dulcan p.611)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05e6\u05e8\u05db\u05d9\u05dd \u05d4\u05e1\u05e0\u05e1\u05d5\u05e8\u05d9\u05d9\u05dd \u05d4\u05d9\u05d9\u05d7\u05d5\u05d3\u05d9\u05d9\u05dd \u05d5\u05e2\u05dc \u05d3\u05e8\u05db\u05d9 \u05d4\u05ea\u05e7\u05e9\u05d5\u05e8\u05ea \u05d4\u05de\u05d5\u05e2\u05d3\u05e4\u05d5\u05ea."
    },
    {
      "type": "multiple_choice",
      "question": "\u05de\u05d8\u05d5\u05e4\u05dc \u05d4\u05e1\u05d5\u05d1\u05dc \u05de\u05d3\u05dc\u05d9\u05e8\u05d9\u05d5\u05dd \u05de\u05e6\u05d9\u05d2 \u05d0\u05d2\u05d9\u05d8\u05e6\u05d9\u05d4 \u05d7\u05de\u05d5\u05e8\u05d4 \u05d4\u05de\u05e1\u05db\u05e0\u05ea \u05d0\u05ea \u05d4\u05e6\u05d5\u05d5\u05ea. \u05d4\u05d5\u05d7\u05dc\u05d8 \u05dc\u05d4\u05e9\u05ea\u05de\u05e9 \u05d1-Haloperidol. \u05dc\u05e4\u05d9 \u05d4-StahlKids \u05d5\u05d4-Dulcan, \u05de\u05d4\u05d5 \u05d4\u05e0\u05d9\u05d8\u05d5\u05e8 \u05d4\u05d7\u05d9\u05d5\u05e0\u05d9 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05e9\u05d9\u05e9 \u05dc\u05d1\u05e6\u05e2 \u05d1\u05e2\u05ea \u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05ea\u05e8\u05d5\u05e4\u05d4 \u05d6\u05d5 \u05d1\u05de\u05e6\u05d1\u05d9 \u05d7\u05d9\u05e8\u05d5\u05dd?",
      "answerOptions": [
        {
          "text": "\u05d1\u05d9\u05e6\u05d5\u05e2 \u05d0\u05e7\"\u05d2 \u05dc\u05de\u05e2\u05e7\u05d1 \u05d0\u05d7\u05e8 \u05de\u05e8\u05d5\u05d5\u05d7 QTc.",
          "isCorrect": true,
          "rationale": "\u05d4\u05dc\u05d5\u05e4\u05e8\u05d9\u05d3\u05d5\u05dc, \u05d1\u05de\u05d9\u05d5\u05d7\u05d3 \u05d1\u05de\u05ea\u05df \u05ea\u05d5\u05da-\u05d5\u05e8\u05d9\u05d3\u05d9 \u05d0\u05d5 \u05d1\u05de\u05d9\u05e0\u05d5\u05e0\u05d9\u05dd \u05de\u05e6\u05d8\u05d1\u05e8\u05d9\u05dd, \u05e7\u05e9\u05d5\u05e8 \u05dc\u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05d4\u05d0\u05e8\u05db\u05ea QTc \u05d5\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05e7\u05e6\u05d1 \u05de\u05e1\u05d5\u05d2 Torsades de Pointes (Dulcan p.612, StahlKids p.258)."
        },
        {
          "text": "\u05d1\u05d3\u05d9\u05e7\u05ea \u05e8\u05de\u05d5\u05ea \u05e1\u05d5\u05db\u05e8 \u05d1\u05d3\u05dd (Glucose) \u05db\u05dc \u05e9\u05e2\u05d4.",
          "isCorrect": false,
          "rationale": "\u05d4\u05dc\u05d5\u05e4\u05e8\u05d9\u05d3\u05d5\u05dc \u05d0\u05d9\u05e0\u05d5 \u05e7\u05e9\u05d5\u05e8 \u05dc\u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd \u05d2\u05dc\u05d9\u05e7\u05de\u05d9\u05d9\u05dd \u05d7\u05e8\u05d9\u05e4\u05d9\u05dd \u05d4\u05d3\u05d5\u05e8\u05e9\u05d9\u05dd \u05e0\u05d9\u05d8\u05d5\u05e8 \u05e9\u05e2\u05ea\u05d9 (StahlKids p.258)."
        },
        {
          "text": "\u05de\u05e2\u05e7\u05d1 \u05d0\u05d7\u05e8 \u05e8\u05de\u05d5\u05ea Lithium \u05d1\u05d3\u05dd.",
          "isCorrect": false,
          "rationale": "\u05d0\u05d9\u05df \u05d0\u05d9\u05e0\u05d8\u05e8\u05d0\u05e7\u05e6\u05d9\u05d4 \u05d9\u05e9\u05d9\u05e8\u05d4 \u05d4\u05de\u05d7\u05d9\u05d9\u05d1\u05ea \u05e0\u05d9\u05d8\u05d5\u05e8 \u05dc\u05d9\u05ea\u05d9\u05d5\u05dd \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05ea \u05d1\u05d2\u05dc\u05dc \u05d4\u05dc\u05d5\u05e4\u05e8\u05d9\u05d3\u05d5\u05dc, \u05d0\u05dc\u05d0 \u05d0\u05dd \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05e0\u05d5\u05d8\u05dc \u05dc\u05d9\u05ea\u05d9\u05d5\u05dd \u05db\u05e8\u05d5\u05e0\u05d9\u05ea (StahlKids p.258)."
        },
        {
          "text": "\u05d1\u05d3\u05d9\u05e7\u05ea \u05ea\u05e4\u05e7\u05d5\u05d3\u05d9 \u05db\u05d1\u05d3 (LFTs) \u05de\u05d3\u05d9 \u05d9\u05d5\u05dd.",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05e9\u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 \u05e2\u05d5\u05d1\u05e8\u05ea \u05de\u05d8\u05d1\u05d5\u05dc\u05d9\u05d6\u05dd \u05db\u05d1\u05d3\u05d9, \u05d0\u05d9\u05df \u05e6\u05d5\u05e8\u05da \u05d1\u05e0\u05d9\u05d8\u05d5\u05e8 \u05d9\u05d5\u05de\u05d9 \u05e9\u05dc \u05ea\u05e4\u05e7\u05d5\u05d3\u05d9 \u05db\u05d1\u05d3 \u05d1\u05d8\u05d9\u05e4\u05d5\u05dc \u05e7\u05e6\u05e8 \u05d8\u05d5\u05d5\u05d7 \u05d1\u05d0\u05d2\u05d9\u05d8\u05e6\u05d9\u05d4 (StahlKids p.258)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05d4\u05e7\u05e8\u05d3\u05d9\u05d0\u05dc\u05d9 \u05d4\u05e4\u05d5\u05d8\u05e0\u05e6\u05d9\u05d0\u05dc\u05d9 \u05e9\u05dc \u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05d0\u05e0\u05d8\u05d9\u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9\u05d5\u05ea \u05d8\u05d9\u05e4\u05d9\u05e7\u05dc\u05d9\u05d5\u05ea."
    },
    {
      "type": "multiple_choice",
      "question": "\u05dc\u05e4\u05d9 \u05d4\u05de\u05d5\u05d3\u05dc \u05d4\u05de\u05db\u05d5\u05e0\u05d4 \u05d1-StahlNeuro \u05db-'Goldilocks Dosing', \u05de\u05d4\u05d5 \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05e4\u05e8\u05de\u05e7\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d4\u05d3\u05d5\u05de\u05d9\u05e0\u05e0\u05d8\u05d9 \u05e9\u05dc Quetiapine \u05d1\u05de\u05d9\u05e0\u05d5\u05df \u05e9\u05dc $50~mg$ ('Baby Bear') \u05d5\u05d4\u05e9\u05d9\u05de\u05d5\u05e9 \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9 \u05d4\u05e0\u05d2\u05d6\u05e8 \u05de\u05db\u05da \u05d1\u05d3\u05dc\u05d9\u05e8\u05d9\u05d5\u05dd?",
      "answerOptions": [
        {
          "text": "\u05d0\u05e0\u05d8\u05d2\u05d5\u05e0\u05d9\u05d6\u05dd \u05dc\u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 $H_1$ \u05d4\u05de\u05e1\u05e4\u05e7 \u05e1\u05d3\u05e6\u05d9\u05d4 \u05dc\u05dc\u05d0 EPS.",
          "isCorrect": true,
          "rationale": "\u05d1\u05de\u05d9\u05e0\u05d5\u05df \u05e0\u05de\u05d5\u05da, \u05e7\u05d5\u05d5\u05d8\u05d9\u05d0\u05e4\u05d9\u05df \u05e4\u05d5\u05e2\u05dc \u05d1\u05e2\u05d9\u05e7\u05e8 \u05db-Antihistamine, \u05de\u05d4 \u05e9\u05de\u05d0\u05e4\u05e9\u05e8 \u05d4\u05e8\u05d2\u05e2\u05d4 \u05d5\u05e9\u05d9\u05e4\u05d5\u05e8 \u05e9\u05d9\u05e0\u05d4 \u05dc\u05dc\u05d0 \u05d7\u05e1\u05d9\u05de\u05ea $D_2$ \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea (StahlNeuro p.218-219)."
        },
        {
          "text": "\u05d7\u05e1\u05d9\u05de\u05d4 \u05d7\u05d6\u05e7\u05d4 \u05e9\u05dc \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 $D_2$ \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d4.",
          "isCorrect": false,
          "rationale": "\u05d7\u05e1\u05d9\u05de\u05ea $D_2$ \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05de\u05ea\u05e8\u05d7\u05e9\u05ea \u05e8\u05e7 \u05d1\u05de\u05d9\u05e0\u05d5\u05e0\u05d9\u05dd \u05d4\u05d2\u05d1\u05d5\u05d4\u05d9\u05dd ('Papa Bear' - 800mg) (StahlNeuro p.219)."
        },
        {
          "text": "\u05e2\u05d9\u05db\u05d5\u05d1 \u05e1\u05e4\u05d9\u05d2\u05d4 \u05d7\u05d5\u05d6\u05e8\u05ea \u05e9\u05dc Norepinephrine (NET inhibition).",
          "isCorrect": false,
          "rationale": "\u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05d6\u05d5 (\u05d3\u05e8\u05da \u05d4\u05de\u05d8\u05d1\u05d5\u05dc\u05d9\u05d8 Norquetiapine) \u05e8\u05dc\u05d5\u05d5\u05e0\u05d8\u05d9\u05ea \u05d1\u05e2\u05d9\u05e7\u05e8 \u05d1\u05de\u05d9\u05e0\u05d5\u05e0\u05d9\u05dd \u05d1\u05d9\u05e0\u05d5\u05e0\u05d9\u05d9\u05dd \u05d4\u05de\u05e9\u05de\u05e9\u05d9\u05dd \u05dc\u05d3\u05d9\u05db\u05d0\u05d5\u05df (StahlNeuro p.219)."
        },
        {
          "text": "\u05d0\u05d2\u05d5\u05e0\u05d9\u05d6\u05dd \u05d7\u05dc\u05e7\u05d9 \u05dc\u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 $5HT_{1A}$.",
          "isCorrect": false,
          "rationale": "\u05ea\u05db\u05d5\u05e0\u05d4 \u05d6\u05d5 \u05ea\u05d5\u05e8\u05de\u05ea \u05dc\u05d0\u05e4\u05e7\u05d8 \u05e0\u05d5\u05d2\u05d3 \u05d4\u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05d5\u05d4\u05d7\u05e8\u05d3\u05d4 \u05d1\u05de\u05d9\u05e0\u05d5\u05e0\u05d9\u05dd \u05d1\u05d9\u05e0\u05d5\u05e0\u05d9\u05d9\u05dd \u05d5\u05d2\u05d1\u05d5\u05d4\u05d9\u05dd, \u05d0\u05da \u05d0\u05d9\u05e0\u05d4 \u05d4\u05d3\u05d5\u05de\u05d9\u05e0\u05e0\u05d8\u05d9\u05ea \u05d1\u05de\u05d9\u05e0\u05d5\u05df 'Baby Bear' (StahlNeuro p.218)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05d0\u05d9\u05d6\u05d4 \u05e7\u05d5\u05dc\u05d8\u05df \u05e0\u05e7\u05e9\u05e8 \u05d1\u05d6\u05d9\u05e7\u05d4 \u05d4\u05d2\u05d1\u05d5\u05d4\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d1\u05de\u05d9\u05e0\u05d5\u05e0\u05d9\u05dd \u05e0\u05de\u05d5\u05db\u05d9\u05dd \u05de\u05d0\u05d5\u05d3."
    },
    {
      "type": "multiple_choice",
      "question": "\u05de\u05d4\u05d9 \u05d4\u05d4\u05e0\u05d7\u05d9\u05d4 \u05d4\u05de\u05e4\u05d5\u05e8\u05e9\u05ea \u05dc\u05d2\u05d1\u05d9 \u05e9\u05d9\u05de\u05d5\u05e9 \u05d1-Benzodiazepines (\u05db\u05d2\u05d5\u05df Lorazepam) \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05d3\u05dc\u05d9\u05e8\u05d9\u05d5\u05dd \u05e9\u05d0\u05d9\u05e0\u05d5 \u05e7\u05e9\u05d5\u05e8 \u05dc\u05d2\u05de\u05d9\u05dc\u05d4 \u05de\u05d0\u05dc\u05db\u05d5\u05d4\u05d5\u05dc?",
      "answerOptions": [
        {
          "text": "\u05d9\u05e9 \u05dc\u05d4\u05d9\u05de\u05e0\u05e2 \u05de\u05d4\u05dd \u05e9\u05db\u05df \u05d4\u05dd \u05e2\u05dc\u05d5\u05dc\u05d9\u05dd \u05dc\u05d4\u05d7\u05de\u05d9\u05e8 \u05d0\u05ea \u05d4\u05d1\u05dc\u05d1\u05d5\u05dc \u05d5\u05dc\u05d2\u05e8\u05d5\u05dd \u05dc\u05ea\u05d2\u05d5\u05d1\u05d5\u05ea \u05e4\u05e8\u05d3\u05d5\u05e7\u05e1\u05dc\u05d9\u05d5\u05ea.",
          "isCorrect": true,
          "rationale": "\u05d1\u05e0\u05d6\u05d5\u05d3\u05d9\u05d0\u05d6\u05e4\u05d9\u05e0\u05d9\u05dd \u05d4\u05dd \u05d2\u05d5\u05e8\u05dd \u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05d3\u05dc\u05d9\u05e8\u05d9\u05d5\u05dd \u05d5\u05e2\u05dc\u05d5\u05dc\u05d9\u05dd \u05dc\u05d4\u05d7\u05de\u05d9\u05e8 \u05d0\u05ea \u05d4\u05de\u05e6\u05d1; \u05d4\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05d4\u05dd \u05de\u05d5\u05ea\u05e8 \u05e8\u05e7 \u05d1\u05de\u05e7\u05e8\u05d9 \u05d2\u05de\u05d9\u05dc\u05d4 \u05de\u05d0\u05dc\u05db\u05d5\u05d4\u05d5\u05dc \u05d0\u05d5 \u05e1\u05d3\u05d8\u05d9\u05d1\u05d9\u05d9\u05dd (Dulcan p.611, p.616)."
        },
        {
          "text": "\u05d4\u05dd \u05de\u05d4\u05d5\u05d5\u05d9\u05dd \u05d0\u05ea \u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05d1\u05d7\u05d9\u05e8\u05d4 (First-line) \u05dc\u05d4\u05e8\u05d2\u05e2\u05d4 \u05de\u05d4\u05d9\u05e8\u05d4.",
          "isCorrect": false,
          "rationale": "\u05d1\u05e0\u05d9\u05d2\u05d5\u05d3 \u05dc\u05de\u05e6\u05d1\u05d9 \u05d7\u05e8\u05d3\u05d4, \u05d1\u05d3\u05dc\u05d9\u05e8\u05d9\u05d5\u05dd \u05d4\u05dd \u05e0\u05d7\u05e9\u05d1\u05d9\u05dd \u05dc\u05de\u05e1\u05d5\u05db\u05e0\u05d9\u05dd \u05d5\u05e2\u05dc\u05d5\u05dc\u05d9\u05dd \u05dc\u05d4\u05d7\u05de\u05d9\u05e8 \u05d0\u05ea \u05d4\u05d3\u05d9\u05e1\u05d0\u05d5\u05e8\u05d9\u05d9\u05e0\u05d8\u05e6\u05d9\u05d4 (Dulcan p.616)."
        },
        {
          "text": "\u05d4\u05dd \u05de\u05d5\u05de\u05dc\u05e6\u05d9\u05dd \u05d1\u05de\u05d9\u05d5\u05d7\u05d3 \u05dc\u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd ASD \u05d1\u05d2\u05dc\u05dc \u05d1\u05d8\u05d9\u05d7\u05d5\u05ea\u05dd.",
          "isCorrect": false,
          "rationale": "\u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd ASD \u05d5\u05e2\u05d9\u05db\u05d5\u05d1 \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9 \u05e0\u05de\u05e6\u05d0\u05d9\u05dd \u05d1\u05e1\u05d9\u05db\u05d5\u05df \u05d2\u05d1\u05d5\u05d4 \u05d9\u05d5\u05ea\u05e8 \u05dc\u05ea\u05d2\u05d5\u05d1\u05d4 \u05e4\u05e8\u05d3\u05d5\u05e7\u05e1\u05dc\u05d9\u05ea \u05dc\u05d1\u05e0\u05d6\u05d5\u05d3\u05d9\u05d0\u05d6\u05e4\u05d9\u05e0\u05d9\u05dd (Dulcan p.612)."
        },
        {
          "text": "\u05d9\u05e9 \u05dc\u05e9\u05dc\u05d1\u05dd \u05ea\u05de\u05d9\u05d3 \u05e2\u05dd Olanzapine IM \u05dc\u05de\u05e7\u05e1\u05d9\u05de\u05d5\u05dd \u05d0\u05e4\u05e7\u05d8.",
          "isCorrect": false,
          "rationale": "\u05e7\u05d9\u05d9\u05de\u05ea \u05d0\u05d6\u05d4\u05e8\u05d4 \u05d7\u05de\u05d5\u05e8\u05d4 \u05de\u05e4\u05e0\u05d9 \u05de\u05ea\u05df \u05de\u05e9\u05d5\u05dc\u05d1 \u05e9\u05dc Olanzapine IM \u05d5\u05d1\u05e0\u05d6\u05d5\u05d3\u05d9\u05d0\u05d6\u05e4\u05d9\u05e0\u05d9\u05dd IM \u05d1\u05d8\u05d5\u05d5\u05d7 \u05e9\u05dc \u05e9\u05e2\u05d4 \u05e2\u05e7\u05d1 \u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05d3\u05d9\u05db\u05d5\u05d9 \u05e0\u05e9\u05d9\u05de\u05ea\u05d9 (Dulcan p.612)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05d4\u05e9\u05e4\u05e2\u05d4 \u05e9\u05dc \u05d7\u05d5\u05de\u05e8\u05d9\u05dd \u05e1\u05d3\u05d8\u05d9\u05d1\u05d9\u05d9\u05dd \u05e2\u05dc \u05ea\u05e4\u05e7\u05d5\u05d3 \u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9 \u05dc\u05e7\u05d5\u05d9."
    },
    {
      "type": "multiple_choice",
      "question": "\u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05e2\u05e8\u05db\u05ea \u05d3\u05dc\u05d9\u05e8\u05d9\u05d5\u05dd, \u05de\u05d6\u05d4\u05d4 \u05d4\u05e7\u05dc\u05d9\u05e0\u05d0\u05d9 \u05db\u05d9 \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05de\u05ea\u05e7\u05e9\u05d4 \u05dc\u05d4\u05e1\u05d9\u05d8 \u05e7\u05e9\u05d1 (shift attention) \u05d5\u05d7\u05d5\u05d6\u05e8 \u05e9\u05d5\u05d1 \u05d5\u05e9\u05d5\u05d1 \u05e2\u05dc \u05ea\u05e9\u05d5\u05d1\u05d4 \u05dc\u05e9\u05d0\u05dc\u05d4 \u05e7\u05d5\u05d3\u05de\u05ea. \u05db\u05d9\u05e6\u05d3 \u05de\u05db\u05d5\u05e0\u05d4 \u05ea\u05d5\u05e4\u05e2\u05d4 \u05d6\u05d5 \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR?",
      "answerOptions": [
        {
          "text": "Perseveration",
          "isCorrect": true,
          "rationale": "\u05e4\u05e8\u05e1\u05d1\u05e8\u05e6\u05d9\u05d4 \u05d4\u05d9\u05d0 \u05d7\u05d6\u05e8\u05d4 \u05e2\u05dc \u05ea\u05d2\u05d5\u05d1\u05d4 \u05d0\u05d5 \u05ea\u05e9\u05d5\u05d1\u05d4 \u05e7\u05d5\u05d3\u05de\u05ea \u05dc\u05de\u05e8\u05d5\u05ea \u05e9\u05d4\u05d2\u05d9\u05e8\u05d5\u05d9 \u05d4\u05e9\u05ea\u05e0\u05d4, \u05d5\u05de\u05e2\u05d9\u05d3\u05d4 \u05e2\u05dc \u05d4\u05e4\u05e8\u05e2\u05d4 \u05d1\u05d9\u05db\u05d5\u05dc\u05ea \u05dc\u05d4\u05e1\u05d9\u05d8 \u05e7\u05e9\u05d1 (DSM p.676)."
        },
        {
          "text": "Echolalia",
          "isCorrect": false,
          "rationale": "\u05d0\u05e7\u05d5\u05dc\u05dc\u05d9\u05d4 \u05d4\u05d9\u05d0 \u05d7\u05d6\u05e8\u05d4 \u05e2\u05dc \u05de\u05d9\u05dc\u05d9\u05dd \u05e9\u05e0\u05d0\u05de\u05e8\u05d5 \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d0\u05d7\u05e8\u05d9\u05dd, \u05d4\u05de\u05d5\u05e4\u05d9\u05e2\u05d4 \u05dc\u05e2\u05d9\u05ea\u05d9\u05dd \u05d1\u05e7\u05d8\u05d8\u05d5\u05e0\u05d9\u05d4 \u05d0\u05d5 \u05d0\u05d5\u05d8\u05d9\u05d6\u05dd, \u05d0\u05da \u05d0\u05d9\u05e0\u05d4 \u05de\u05ea\u05d0\u05e8\u05ea \u05d7\u05d6\u05e8\u05d4 \u05e2\u05dc \u05ea\u05e9\u05d5\u05d1\u05d4 \u05e2\u05e6\u05de\u05d9\u05ea (DSM p.137, p.670)."
        },
        {
          "text": "Tangentiality",
          "isCorrect": false,
          "rationale": "\u05d8\u05e0\u05d2\u05e0\u05e6\u05d9\u05d0\u05dc\u05d9\u05d5\u05ea \u05d4\u05d9\u05d0 \u05de\u05ea\u05df \u05ea\u05e9\u05d5\u05d1\u05d4 \u05e9\u05e7\u05e9\u05d5\u05e8\u05d4 \u05e8\u05e7 \u05d1\u05e2\u05e7\u05d9\u05e4\u05d9\u05df \u05dc\u05e0\u05d5\u05e9\u05d0, \u05d1\u05e0\u05d9\u05d2\u05d5\u05d3 \u05dc\u05d7\u05d6\u05e8\u05d4 \u05e2\u05dc \u05ea\u05e9\u05d5\u05d1\u05d4 \u05e7\u05d5\u05d3\u05de\u05ea (DSM p.904)."
        },
        {
          "text": "Loose associations",
          "isCorrect": false,
          "rationale": "\u05d0\u05e1\u05d5\u05e6\u05d9\u05d0\u05e6\u05d9\u05d5\u05ea \u05e8\u05e4\u05d5\u05d9\u05d5\u05ea \u05d4\u05df \u05de\u05e2\u05d1\u05e8 \u05d1\u05d9\u05df \u05e0\u05d5\u05e9\u05d0\u05d9\u05dd \u05dc\u05dc\u05d0 \u05e7\u05e9\u05e8 \u05d4\u05d2\u05d9\u05d5\u05e0\u05d9 \u05d1\u05e8\u05d5\u05e8, \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d5\u05ea \u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05d1\u05d7\u05e9\u05d9\u05d1\u05d4 (DSM p.904)."
        }
      ],
      "hint": "\u05d4\u05de\u05d9\u05dc\u05d4 \u05de\u05ea\u05d0\u05e8\u05ea \u05d4\u05ea\u05de\u05d3\u05d4 (perseverance) \u05d1\u05d3\u05e4\u05d5\u05e1 \u05ea\u05d2\u05d5\u05d1\u05d4 \u05de\u05e1\u05d5\u05d9\u05dd."
    },
    {
      "type": "multiple_choice",
      "question": "\u05de\u05d8\u05d5\u05e4\u05dc \u05d1\u05df 60 \u05e2\u05dd \u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4 \u05e9\u05dc \u05e6\u05e8\u05d9\u05db\u05ea \u05d0\u05dc\u05db\u05d5\u05d4\u05d5\u05dc \u05db\u05e8\u05d5\u05e0\u05d9\u05ea \u05de\u05e6\u05d9\u05d2 \u05e8\u05e2\u05d3 \u05d1\u05d9\u05d3\u05d9\u05d9\u05dd, \u05d4\u05d6\u05d9\u05d5\u05ea \u05d8\u05e7\u05d8\u05d9\u05dc\u05d9\u05d5\u05ea ('\u05d7\u05e8\u05e7\u05d9\u05dd \u05e2\u05dc \u05d4\u05e2\u05d5\u05e8') \u05d5\u05d3\u05d9\u05e1\u05d0\u05d5\u05e8\u05d9\u05d9\u05e0\u05d8\u05e6\u05d9\u05d4 \u05de\u05dc\u05d0\u05d4. \u05de\u05d4\u05d5 \u05d4\u05d0\u05d1\u05d7\u05d5\u05df \u05d4\u05de\u05d3\u05d5\u05d9\u05e7 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR \u05d1\u05de\u05d9\u05d3\u05d4 \u05d5\u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05de\u05d5\u05e4\u05d9\u05e2\u05d9\u05dd \u05d9\u05d5\u05de\u05d9\u05d9\u05dd \u05dc\u05d0\u05d7\u05e8 \u05d4\u05e4\u05e1\u05e7\u05ea \u05d4\u05e9\u05ea\u05d9\u05d9\u05d4?",
      "answerOptions": [
        {
          "text": "Alcohol withdrawal delirium (Delirium Tremens).",
          "isCorrect": true,
          "rationale": "\u05db\u05d0\u05e9\u05e8 \u05ea\u05e1\u05de\u05d9\u05e0\u05d9 \u05d3\u05dc\u05d9\u05e8\u05d9\u05d5\u05dd \u05de\u05d5\u05e4\u05d9\u05e2\u05d9\u05dd \u05d1\u05de\u05d4\u05dc\u05da \u05d2\u05de\u05d9\u05dc\u05d4 \u05de\u05d0\u05dc\u05db\u05d5\u05d4\u05d5\u05dc, \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05d9\u05d0 $Substance$ $withdrawal$ $delirium$ (DSM p.566, p.672)."
        },
        {
          "text": "Alcohol-induced psychotic disorder.",
          "isCorrect": false,
          "rationale": "\u05d0\u05dd \u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05de\u05d5\u05e4\u05d9\u05e2\u05d9\u05dd \u05e8\u05e7 \u05d1\u05de\u05d4\u05dc\u05da \u05d3\u05dc\u05d9\u05e8\u05d9\u05d5\u05dd, \u05d4\u05dd \u05e0\u05d7\u05e9\u05d1\u05d9\u05dd \u05dc\u05d7\u05dc\u05e7 \u05de\u05d4\u05d3\u05dc\u05d9\u05e8\u05d9\u05d5\u05dd \u05d5\u05dc\u05d0 \u05de\u05d0\u05d5\u05d1\u05d7\u05e0\u05d9\u05dd \u05db\u05d4\u05e4\u05e8\u05e2\u05d4 \u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9\u05ea \u05e0\u05e4\u05e8\u05d3\u05ea (DSM p.126, p.568)."
        },
        {
          "text": "Major neurocognitive disorder due to alcohol.",
          "isCorrect": false,
          "rationale": "NCD \u05de\u05ea\u05d9\u05d9\u05d7\u05e1 \u05dc\u05d9\u05e8\u05d9\u05d3\u05d4 \u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9\u05ea \u05d9\u05e6\u05d9\u05d1\u05d4 \u05d5\u05db\u05e8\u05d5\u05e0\u05d9\u05ea, \u05d1\u05e2\u05d5\u05d3 \u05d4\u05de\u05e7\u05e8\u05d4 \u05de\u05ea\u05d0\u05e8 \u05de\u05e6\u05d1 \u05d7\u05e8\u05d9\u05e3 \u05d5\u05e1\u05d5\u05e2\u05e8 \u05e9\u05dc \u05d2\u05de\u05d9\u05dc\u05d4 (DSM p.712)."
        },
        {
          "text": "Schizophrenia, first episode.",
          "isCorrect": false,
          "rationale": "\u05d4\u05e7\u05e9\u05e8 \u05d4\u05db\u05e8\u05d5\u05e0\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d4\u05d1\u05e8\u05d5\u05e8 \u05dc\u05d2\u05de\u05d9\u05dc\u05d4 \u05d5\u05d4\u05e4\u05e8\u05e2\u05ea \u05d4\u05e7\u05e9\u05d1 \u05e4\u05d5\u05e1\u05dc\u05d9\u05dd \u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc \u05e1\u05db\u05d9\u05d6\u05d5\u05e4\u05e8\u05e0\u05d9\u05d4 \u05d1\u05de\u05e6\u05d1 \u05d6\u05d4 (DSM p.114)."
        }
      ],
      "hint": "\u05e9\u05d9\u05dd \u05dc\u05d1 \u05dc\u05e7\u05e9\u05e8 \u05d1\u05d9\u05df \u05d4\u05d2\u05de\u05d9\u05dc\u05d4 \u05dc\u05d1\u05d9\u05df \u05d4\u05d5\u05e4\u05e2\u05ea \u05d4\u05d1\u05dc\u05d1\u05d5\u05dc \u05d5\u05d4\u05d4\u05d6\u05d9\u05d5\u05ea."
    },
    {
      "type": "multiple_choice",
      "question": "\u05de\u05d4\u05d5 \u05d4\u05d2\u05d5\u05e8\u05dd \u05d4\u05e9\u05db\u05d9\u05d7 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05d4\u05d5\u05e4\u05e2\u05ea \u05d3\u05dc\u05d9\u05e8\u05d9\u05d5\u05dd \u05d1\u05d0\u05d5\u05db\u05dc\u05d5\u05e1\u05d9\u05d9\u05d4 \u05d4\u05d2\u05e8\u05d9\u05d0\u05d8\u05e8\u05d9\u05ea \u05d5\u05d1\u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd \u05d1\u05de\u05e6\u05d1 \u05e7\u05e8\u05d9\u05d8\u05d9, \u05d0\u05e9\u05e8 \u05e0\u05d7\u05e9\u05d1 \u05dc\u05d2\u05d5\u05e8\u05dd \u05d4\u05e4\u05d9\u05da (Reversible)?",
      "answerOptions": [
        {
          "text": "\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05ea\u05e8\u05d5\u05e4\u05d5\u05ea (Medications), \u05d1\u05de\u05d9\u05d5\u05d7\u05d3 \u05d0\u05dc\u05d5 \u05e2\u05dd \u05e0\u05d8\u05dc \u05d0\u05e0\u05d8\u05d9\u05db\u05d5\u05dc\u05d9\u05e0\u05e8\u05d2\u05d9.",
          "isCorrect": true,
          "rationale": "\u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05d4\u05df \u05d4\u05d2\u05d5\u05e8\u05dd \u05d4\u05e9\u05db\u05d9\u05d7 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05d3\u05dc\u05d9\u05e8\u05d9\u05d5\u05dd, \u05db\u05d0\u05e9\u05e8 \u05d7\u05e1\u05d9\u05de\u05d4 \u05db\u05d5\u05dc\u05d9\u05e0\u05e8\u05d2\u05d9\u05ea \u05d4\u05d9\u05d0 \u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05de\u05e8\u05db\u05d6\u05d9 \u05dc\u05d4\u05e9\u05e8\u05d0\u05ea \u05d4\u05de\u05e6\u05d1 (StahlNeuro p.523, \u05ea\u05de\u05e6\u05d9\u05ea \u05d3\u05dc\u05d9\u05e8\u05d9\u05d5\u05dd \u05e2\u05de' 5)."
        },
        {
          "text": "\u05ea\u05d4\u05dc\u05d9\u05da \u05d4\u05d6\u05d9\u05e7\u05e0\u05d4 \u05d4\u05d8\u05d1\u05e2\u05d9 (Normal aging).",
          "isCorrect": false,
          "rationale": "\u05d6\u05d9\u05e7\u05e0\u05d4 \u05d4\u05d9\u05d0 \u05d2\u05d5\u05e8\u05dd \u05e1\u05d9\u05db\u05d5\u05df (Risk factor) \u05d0\u05da \u05d0\u05d9\u05e0\u05d4 \u05d2\u05d5\u05e8\u05dd \u05d9\u05e9\u05d9\u05e8 \u05d0\u05d5 \u05d4\u05e4\u05d9\u05da \u05dc\u05d3\u05dc\u05d9\u05e8\u05d9\u05d5\u05dd (DSM p.677)."
        },
        {
          "text": "\u05d7\u05e1\u05da \u05e9\u05d9\u05e0\u05d4 \u05db\u05e8\u05d5\u05e0\u05d9 \u05d1\u05dc\u05d1\u05d3.",
          "isCorrect": false,
          "rationale": "\u05d7\u05e1\u05da \u05e9\u05d9\u05e0\u05d4 \u05e0\u05e4\u05d5\u05e5 \u05d1\u05d3\u05dc\u05d9\u05e8\u05d9\u05d5\u05dd \u05d0\u05da \u05d1\u05d3\u05e8\u05da \u05db\u05dc\u05dc \u05d4\u05d5\u05d0 \u05ea\u05d5\u05e6\u05d0\u05d4 \u05d0\u05d5 \u05d2\u05d5\u05e8\u05dd \u05de\u05e1\u05d9\u05d9\u05e2, \u05d5\u05dc\u05d0 \u05d4\u05d2\u05d5\u05e8\u05dd \u05d4\u05d0\u05d8\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05d4\u05d9\u05d7\u05d9\u05d3 (DSM p.676)."
        },
        {
          "text": "\u05e0\u05d8\u05d9\u05d9\u05d4 \u05d2\u05e0\u05d8\u05d9\u05ea \u05dc\u05e1\u05db\u05d9\u05d6\u05d5\u05e4\u05e8\u05e0\u05d9\u05d4.",
          "isCorrect": false,
          "rationale": "\u05d0\u05d9\u05df \u05e7\u05e9\u05e8 \u05d9\u05e9\u05d9\u05e8 \u05de\u05d5\u05db\u05d7 \u05d1\u05d9\u05df \u05d2\u05e0\u05d8\u05d9\u05e7\u05d4 \u05e9\u05dc \u05e1\u05db\u05d9\u05d6\u05d5\u05e4\u05e8\u05e0\u05d9\u05d4 \u05dc\u05d1\u05d9\u05df \u05d4\u05e0\u05d8\u05d9\u05d9\u05d4 \u05dc\u05e4\u05ea\u05d7 \u05d3\u05dc\u05d9\u05e8\u05d9\u05d5\u05dd \u05e2\u05e7\u05d1 \u05de\u05d7\u05dc\u05d4 \u05e8\u05e4\u05d5\u05d0\u05d9\u05ea (DSM p.677)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05db\u05d5\u05dc\u05d9\u05e0\u05e8\u05d2\u05d9\u05ea \u05d1\u05de\u05d5\u05d7 \u05d5\u05d4\u05e9\u05e4\u05e2\u05ea \u05d7\u05d5\u05de\u05e8\u05d9\u05dd \u05d7\u05d9\u05e6\u05d5\u05e0\u05d9\u05d9\u05dd \u05e2\u05dc\u05d9\u05d4."
    }
  ]
