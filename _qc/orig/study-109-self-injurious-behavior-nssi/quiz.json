{
  "title": "Self-Harm Quiz",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\u05de\u05ea\u05d1\u05d2\u05e8\u05ea \u05d1\u05ea 15 \u05de\u05d5\u05d1\u05d0\u05ea \u05dc\u05d4\u05e2\u05e8\u05db\u05d4 \u05d3\u05d7\u05d5\u05e4\u05d4 \u05dc\u05d0\u05d7\u05e8 \u05e9\u05d9\u05d5\u05e2\u05e6\u05ea \u05d1\u05d9\u05ea \u05d4\u05e1\u05e4\u05e8 \u05d2\u05d9\u05dc\u05ea\u05d4 \u05e1\u05d9\u05de\u05e0\u05d9 \u05d7\u05ea\u05db\u05d9\u05dd \u05e9\u05d8\u05d7\u05d9\u05d9\u05dd \u05de\u05e8\u05d5\u05d1\u05d9\u05dd \u05e2\u05dc \u05d6\u05e8\u05d5\u05e2\u05d5\u05ea\u05d9\u05d4. \u05d4\u05de\u05d8\u05d5\u05e4\u05dc\u05ea \u05de\u05d3\u05d5\u05d5\u05d7\u05ea \u05db\u05d9 \u05d4\u05d9\u05d0 \u05de\u05d1\u05e6\u05e2\u05ea \u05d6\u05d0\u05ea \u05dc\u05e4\u05d7\u05d5\u05ea \u05e4\u05e2\u05de\u05d9\u05d9\u05dd \u05d1\u05e9\u05d1\u05d5\u05e2 \u05d1\u05e9\u05e0\u05d4 \u05d4\u05d0\u05d7\u05e8\u05d5\u05e0\u05d4 \u05db\u05d3\u05d9 '\u05dc\u05d4\u05e9\u05e7\u05d9\u05d8 \u05d0\u05ea \u05d4\u05e8\u05e2\u05e9 \u05d1\u05e8\u05d0\u05e9' \u05dc\u05d0\u05d7\u05e8 \u05de\u05e8\u05d9\u05d1\u05d5\u05ea \u05e2\u05dd \u05d4\u05d5\u05e8\u05d9\u05d4, \u05d5\u05de\u05db\u05d7\u05d9\u05e9\u05d4 \u05db\u05dc \u05e8\u05e6\u05d5\u05df \u05dc\u05de\u05d5\u05ea. \u05e2\u05dc \u05e4\u05d9 \u05d4-DSM-5-TR Section III, \u05d0\u05d9\u05d6\u05d4 \u05de\u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05d4\u05d1\u05d0\u05d9\u05dd \u05d4\u05db\u05e8\u05d7\u05d9 \u05dc\u05d0\u05d1\u05d7\u05e0\u05ea Nonsuicidal Self-Injury Disorder?",
      "answerOptions": [
        {
          "text": "\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d4\u05e4\u05d2\u05d9\u05e2\u05d4 \u05d4\u05e2\u05e6\u05de\u05d9\u05ea \u05e6\u05e8\u05d9\u05db\u05d4 \u05dc\u05d4\u05ea\u05e8\u05d7\u05e9 \u05d1-5 \u05d9\u05de\u05d9\u05dd \u05d0\u05d5 \u05d9\u05d5\u05ea\u05e8 \u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05e9\u05e0\u05d4 \u05d4\u05d0\u05d7\u05e8\u05d5\u05e0\u05d4.",
          "isCorrect": true,
          "rationale": "\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df A \u05d3\u05d5\u05e8\u05e9 \u05ea\u05d3\u05d9\u05e8\u05d5\u05ea \u05e9\u05dc \u05dc\u05e4\u05d7\u05d5\u05ea 5 \u05d9\u05de\u05d9\u05dd \u05d1\u05e9\u05e0\u05d4 \u05d4\u05d0\u05d7\u05e8\u05d5\u05e0\u05d4 \u05e9\u05d1\u05d4\u05dd \u05d1\u05d5\u05e6\u05e2\u05d4 \u05e4\u05d2\u05d9\u05e2\u05d4 \u05e2\u05e6\u05de\u05d9\u05ea \u05de\u05db\u05d5\u05d5\u05e0\u05ea \u05dc\u05de\u05e2\u05d8\u05e4\u05ea \u05d4\u05d2\u05d5\u05e3 \u05dc\u05dc\u05d0 \u05db\u05d5\u05d5\u05e0\u05ea \u05d0\u05d5\u05d1\u05d3\u05e0\u05d5\u05ea (DSM p.923)."
        },
        {
          "text": "\u05d4\u05e4\u05d2\u05d9\u05e2\u05d4 \u05d7\u05d9\u05d9\u05d1\u05ea \u05dc\u05d4\u05ea\u05d1\u05e6\u05e2 \u05d1\u05d0\u05de\u05e6\u05e2\u05d5\u05ea \u05d7\u05e4\u05e5 \u05d7\u05d3 (\u05db\u05de\u05d5 \u05e1\u05db\u05d9\u05df \u05d0\u05d5 \u05d2\u05d9\u05dc\u05d5\u05d7) \u05d1\u05dc\u05d1\u05d3.",
          "isCorrect": false,
          "rationale": "\u05d0\u05de\u05e0\u05dd \u05d7\u05d9\u05ea\u05d5\u05da \u05d4\u05d5\u05d0 \u05d4\u05e9\u05d9\u05d8\u05d4 \u05d4\u05e0\u05e4\u05d5\u05e6\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8, \u05d0\u05da \u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05db\u05d5\u05dc\u05dc\u05d9\u05dd \u05d2\u05dd \u05db\u05d5\u05d5\u05d9\u05d5\u05ea, \u05d3\u05e7\u05d9\u05e8\u05d5\u05ea, \u05d4\u05db\u05d0\u05d4 \u05d5\u05e9\u05e4\u05e9\u05d5\u05e3 \u05de\u05d5\u05e4\u05e8\u05d6 (DSM p.923)."
        },
        {
          "text": "\u05d4\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d7\u05d9\u05d9\u05d1\u05ea \u05dc\u05d4\u05ea\u05e8\u05d7\u05e9 \u05d1\u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05d4\u05e4\u05e8\u05e2\u05ea \u05d0\u05d9\u05e9\u05d9\u05d5\u05ea \u05d2\u05d1\u05d5\u05dc\u05d9\u05ea (Borderline Personality Disorder).",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05e7\u05d5\u05de\u05d5\u05e8\u05d1\u05d9\u05d3\u05d9\u05d5\u05ea \u05d2\u05d1\u05d5\u05d4\u05d4, NSSI Disorder \u05d9\u05db\u05d5\u05dc\u05d4 \u05dc\u05d4\u05d5\u05e4\u05d9\u05e2 \u05dc\u05dc\u05d0 \u05d4\u05e4\u05e8\u05e2\u05ea \u05d0\u05d9\u05e9\u05d9\u05d5\u05ea \u05d2\u05d1\u05d5\u05dc\u05d9\u05ea \u05d5\u05de\u05d4\u05d5\u05d5\u05d4 \u05d9\u05e9\u05d5\u05ea \u05d0\u05d1\u05d7\u05e0\u05ea\u05d9\u05ea \u05e0\u05e4\u05e8\u05d3\u05ea \u05dc\u05de\u05d7\u05e7\u05e8 (DSM p.925)."
        },
        {
          "text": "\u05e2\u05dc \u05d4\u05de\u05d8\u05d5\u05e4\u05dc\u05ea \u05dc\u05d3\u05d5\u05d5\u05d7 \u05e2\u05dc \u05d7\u05d5\u05e1\u05e8 \u05ea\u05d7\u05d5\u05e9\u05ea \u05db\u05d0\u05d1 \u05de\u05d5\u05d7\u05dc\u05d8 \u05d1\u05d6\u05de\u05df \u05d1\u05d9\u05e6\u05d5\u05e2 \u05d4\u05d0\u05e7\u05d8.",
          "isCorrect": false,
          "rationale": "\u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05d0\u05d9\u05e0\u05dd \u05d3\u05d5\u05e8\u05e9\u05d9\u05dd \u05d4\u05d9\u05e2\u05d3\u05e8 \u05db\u05d0\u05d1; \u05dc\u05e2\u05d9\u05ea\u05d9\u05dd \u05d4\u05db\u05d0\u05d1 \u05e2\u05e6\u05de\u05d5 \u05d4\u05d5\u05d0 \u05d7\u05dc\u05e7 \u05de\u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05dc\u05d4\u05e9\u05d2\u05ea \u05d4\u05e7\u05dc\u05d4 \u05de\u05e8\u05d2\u05e9 \u05e9\u05dc\u05d9\u05dc\u05d9 (DSM p.923)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05e1\u05e3 \u05d4\u05d9\u05de\u05d9\u05dd \u05d4\u05de\u05d9\u05e0\u05d9\u05de\u05dc\u05d9 \u05d4\u05e0\u05d3\u05e8\u05e9 \u05d1\u05e9\u05e0\u05d4 \u05d4\u05d0\u05d7\u05e8\u05d5\u05e0\u05d4 \u05dc\u05e4\u05d9 \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df A.",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05e0\u05e2\u05e8 \u05d1\u05df 16 \u05e2\u05dd \u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4 \u05e9\u05dc NSSI \u05de\u05d3\u05d5\u05d5\u05d7 \u05db\u05d9 \u05d1\u05ea\u05e7\u05d5\u05e4\u05d4 \u05d4\u05d0\u05d7\u05e8\u05d5\u05e0\u05d4 \u05d4\u05d5\u05d0 \u05de\u05e8\u05d2\u05d9\u05e9 '\u05d3\u05d7\u05e3 \u05d1\u05dc\u05ea\u05d9 \u05e0\u05e9\u05dc\u05d8' (urgency) \u05d5-craving \u05e2\u05d6 \u05dc\u05d1\u05e6\u05e2 \u05e4\u05d2\u05d9\u05e2\u05d4 \u05e2\u05e6\u05de\u05d9\u05ea, \u05d2\u05dd \u05db\u05d0\u05e9\u05e8 \u05d0\u05d9\u05df \u05d8\u05e8\u05d9\u05d2\u05e8 \u05e8\u05d2\u05e9\u05d9 \u05de\u05d9\u05d9\u05d3\u05d9. \u05dc\u05e4\u05d9 \u05d4\u05de\u05d5\u05d3\u05dc \u05d4\u05e0\u05d5\u05d9\u05e8\u05d5\u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05e9\u05dc StahlNeuro, \u05d0\u05d9\u05d6\u05d4 \u05ea\u05d4\u05dc\u05d9\u05da \u05de\u05d5\u05d7\u05d9 \u05de\u05e1\u05d1\u05d9\u05e8 \u05d0\u05ea \u05d4\u05de\u05e2\u05d1\u05e8 \u05de\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d0\u05d9\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05ea \u05dc\u05d4\u05e8\u05d2\u05dc \u05e7\u05d5\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9 \u05d3\u05de\u05d5\u05d9 \u05d4\u05ea\u05de\u05db\u05e8\u05d5\u05ea?",
      "answerOptions": [
        {
          "text": "\u05de\u05e2\u05d1\u05e8 \u05e9\u05dc \u05d4\u05e9\u05dc\u05d9\u05d8\u05d4 \u05d4\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea\u05d9\u05ea \u05de\u05de\u05e2\u05d2\u05dc \u05d4-ventral striatum \u05dc\u05de\u05e2\u05d2\u05dc \u05d4-dorsal striatum.",
          "isCorrect": true,
          "rationale": "\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05d9\u05d5\u05ea \u05d0\u05d9\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05d5\u05ea \u05de\u05d5\u05e0\u05e2\u05d5\u05ea \u05dc\u05e8\u05d5\u05d1 \u05de\u05d7\u05d9\u05e4\u05d5\u05e9 \u05ea\u05d2\u05de\u05d5\u05dc \u05d1\u05e1\u05d8\u05e8\u05d9\u05d0\u05d8\u05d5\u05dd \u05d4\u05d5\u05d5\u05e0\u05d8\u05e8\u05dc\u05d9, \u05d1\u05e2\u05d5\u05d3 \u05e9\u05e2\u05d9\u05e1\u05d5\u05e7 \u05d7\u05d6\u05e8\u05ea\u05d9 \u05de\u05d5\u05d1\u05d9\u05dc \u05dc\u05e0\u05d5\u05d9\u05e8\u05d5-\u05d0\u05d3\u05e4\u05d8\u05e6\u05d9\u05d4 \u05d5\u05d4\u05e2\u05d1\u05e8\u05ea \u05d4\u05e9\u05dc\u05d9\u05d8\u05d4 \u05dc\u05e1\u05d8\u05e8\u05d9\u05d0\u05d8\u05d5\u05dd \u05d4\u05d3\u05d5\u05e8\u05e1\u05dc\u05d9 \u05d4\u05d0\u05d7\u05e8\u05d0\u05d9 \u05e2\u05dc \u05d4\u05e8\u05d2\u05dc\u05d9\u05dd \u05e7\u05d5\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05d9\u05dd (StahlNeuro p.538-539, p.571)."
        },
        {
          "text": "\u05d9\u05e8\u05d9\u05d3\u05d4 \u05d1\u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05d4-mesolimbic pathway \u05d4\u05de\u05ea\u05d5\u05d5\u05db\u05ea \u05e2\u05dc \u05d9\u05d3\u05d9 dopamine.",
          "isCorrect": false,
          "rationale": "\u05d4\u05de\u05e2\u05d1\u05e8 \u05dc\u05d4\u05ea\u05de\u05db\u05e8\u05d5\u05ea \u05e7\u05e9\u05d5\u05e8 \u05d3\u05d5\u05d5\u05e7\u05d0 \u05dc\u05e9\u05d9\u05e0\u05d5\u05d9 \u05d1\u05de\u05d9\u05e7\u05d5\u05dd \u05d1\u05ea\u05d5\u05da \u05d4\u05e1\u05d8\u05e8\u05d9\u05d0\u05d8\u05d5\u05dd \u05d5\u05dc\u05d0\u05d5 \u05d3\u05d5\u05d5\u05e7\u05d0 \u05dc\u05d9\u05e8\u05d9\u05d3\u05d4 \u05db\u05dc\u05dc\u05d9\u05ea \u05d1\u05de\u05e1\u05dc\u05d5\u05dc \u05d4\u05de\u05d6\u05d5\u05dc\u05d9\u05de\u05d1\u05d9 (StahlNeuro p.538)."
        },
        {
          "text": "\u05d0\u05e7\u05d8\u05d9\u05d1\u05e6\u05d9\u05d4 \u05de\u05d5\u05d2\u05d1\u05e8\u05ea \u05e9\u05dc \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 5-HT2A \u05d1\u05e7\u05d5\u05e8\u05d8\u05e7\u05e1 \u05d4\u05e4\u05e8\u05d4-\u05e4\u05e8\u05d5\u05e0\u05d8\u05dc\u05d9.",
          "isCorrect": false,
          "rationale": "\u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 5-HT2A \u05e7\u05e9\u05d5\u05e8\u05d9\u05dd \u05d9\u05d5\u05ea\u05e8 \u05dc\u05de\u05e6\u05d1\u05d9\u05dd \u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9\u05d9\u05dd \u05d5\u05d4\u05d6\u05d9\u05d5\u05ea \u05de\u05d0\u05e9\u05e8 \u05dc\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05e7\u05d5\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05d5\u05ea \u05e9\u05dc \u05e4\u05d2\u05d9\u05e2\u05d4 \u05e2\u05e6\u05de\u05d9\u05ea (StahlNeuro p.133)."
        },
        {
          "text": "\u05d4\u05d9\u05e4\u05e8-\u05d0\u05e7\u05d8\u05d9\u05d1\u05d9\u05d5\u05ea \u05e9\u05dc glutamate \u05d1\u05de\u05e1\u05dc\u05d5\u05dc \u05d4-thalamo-cortical.",
          "isCorrect": false,
          "rationale": "\u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd \u05d1\u05d2\u05dc\u05d5\u05d8\u05de\u05d8 \u05e0\u05d7\u05e7\u05e8\u05d9\u05dd \u05d1\u05d4\u05e7\u05e9\u05e8 \u05e9\u05dc \u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d4 \u05d5-central sensitization \u05dc\u05db\u05d0\u05d1, \u05d0\u05da \u05d4\u05de\u05e2\u05d1\u05e8 \u05de\u05d4\u05e8\u05d2\u05dc \u05dc\u05d0\u05d9\u05de\u05e4\u05d5\u05dc\u05e1 \u05de\u05de\u05d5\u05e7\u05d3 \u05d1\u05de\u05e2\u05d2\u05dc\u05d9 \u05d4\u05e1\u05d8\u05e8\u05d9\u05d0\u05d8\u05d5\u05dd (StahlNeuro p.107, p.539)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05de\u05e2\u05d2\u05dc \u05d4\u05d0\u05d7\u05e8\u05d0\u05d9 \u05e2\u05dc \u05d4\u05e8\u05d2\u05dc\u05d9\u05dd (Habit loop) \u05dc\u05e2\u05d5\u05de\u05ea \u05d6\u05d4 \u05d4\u05d0\u05d7\u05e8\u05d0\u05d9 \u05e2\u05dc \u05d0\u05d9\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05d5\u05ea.",
      "imageUrls": []
