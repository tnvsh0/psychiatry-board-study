    {
      "type": "multiple_choice",
      "question": "\u05de\u05d8\u05d5\u05e4\u05dc\u05ea \u05d1\u05ea 17 \u05d4\u05de\u05d0\u05d5\u05d1\u05d7\u05e0\u05ea \u05e2\u05dd NSSI Disorder \u05de\u05d3\u05d5\u05d5\u05d7\u05ea \u05db\u05d9 \u05d4\u05e4\u05d2\u05d9\u05e2\u05d4 \u05d4\u05e2\u05e6\u05de\u05d9\u05ea \u05de\u05e2\u05e0\u05d9\u05e7\u05d4 \u05dc\u05d4 \u05ea\u05d7\u05d5\u05e9\u05ea \u05e8\u05d5\u05d2\u05e2 \u05d5\u05e9\u05dc\u05d5\u05d5\u05d4 '\u05db\u05de\u05d5 \u05e1\u05dd'. \u05dc\u05e4\u05d9 Dulcan, \u05d0\u05d9\u05d6\u05d4 \u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05e4\u05d9\u05d6\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05de\u05e1\u05d1\u05d9\u05e8 \u05d0\u05ea \u05ea\u05d7\u05d5\u05e9\u05ea \u05d4-soothing dissociation \u05d4\u05d6\u05d5?",
      "answerOptions": [
        {
          "text": "\u05e9\u05d7\u05e8\u05d5\u05e8 \u05e9\u05dc endogenous opiates (endorphins) \u05d4\u05de\u05d5\u05e4\u05e2\u05dc \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d2\u05d9\u05e8\u05d5\u05d9 \u05d4\u05db\u05d0\u05d1.",
          "isCorrect": true,
          "rationale": "\u05d2\u05d9\u05e8\u05d5\u05d9 \u05db\u05d0\u05d1 \u05de\u05e4\u05e2\u05d9\u05dc \u05d0\u05ea \u05d4\u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05d0\u05d5\u05e4\u05d9\u05d5\u05d0\u05d9\u05d3\u05d9\u05ea \u05d4\u05d0\u05e0\u05d3\u05d5\u05d2\u05e0\u05d9\u05ea, \u05de\u05d4 \u05e9\u05de\u05d1\u05d9\u05d0 \u05dc\u05d4\u05e7\u05dc\u05d4 \u05d1\u05de\u05e6\u05d5\u05e7\u05d4 \u05d4\u05e8\u05d2\u05e9\u05d9\u05ea \u05d5\u05dc\u05e2\u05d9\u05ea\u05d9\u05dd \u05dc\u05de\u05e6\u05d1 \u05d3\u05d9\u05e1\u05d5\u05e6\u05d9\u05d0\u05d8\u05d9\u05d1\u05d9 \u05de\u05e8\u05d2\u05d9\u05e2 (Dulcan p.525)."
        },
        {
          "text": "\u05e2\u05dc\u05d9\u05d9\u05d4 \u05d7\u05d3\u05d4 \u05d1\u05e8\u05de\u05d5\u05ea \u05d4-Norepinephrine \u05d1-locus coeruleus.",
          "isCorrect": false,
          "rationale": "\u05e0\u05d5\u05e8\u05d0\u05e4\u05d9\u05e0\u05e4\u05e8\u05d9\u05df \u05e7\u05e9\u05d5\u05e8 \u05d9\u05d5\u05ea\u05e8 \u05dc\u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05e2\u05d5\u05e8\u05e8\u05d5\u05ea (arousal) \u05d5\u05e4\u05d7\u05d5\u05ea \u05dc\u05ea\u05d7\u05d5\u05e9\u05ea \u05d4\u05e9\u05dc\u05d5\u05d5\u05d4 \u05d5\u05d4\u05d3\u05d9\u05e1\u05d5\u05e6\u05d9\u05d0\u05e6\u05d9\u05d4 \u05d4\u05de\u05e8\u05d2\u05d9\u05e2\u05d4 (StahlNeuro p.278)."
        },
        {
          "text": "\u05d7\u05e1\u05d9\u05de\u05d4 \u05e9\u05dc \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 NMDA \u05e2\u05dc \u05d9\u05d3\u05d9 glutamate.",
          "isCorrect": false,
          "rationale": "\u05d7\u05e1\u05d9\u05de\u05ea NMDA (\u05db\u05de\u05d5 \u05e2\u05dc \u05d9\u05d3\u05d9 ketamine) \u05d2\u05d5\u05e8\u05de\u05ea \u05dc\u05d3\u05d9\u05e1\u05d5\u05e6\u05d9\u05d0\u05e6\u05d9\u05d4, \u05d0\u05da \u05d4\u05d9\u05d0 \u05e7\u05e9\u05d5\u05e8\u05d4 \u05dc\u05de\u05d5\u05d3\u05dc \u05e9\u05dc \u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d4 \u05d5\u05dc\u05d0 \u05dc\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05d8\u05d1\u05e2\u05d9 \u05e9\u05dc \u05e9\u05d9\u05db\u05d5\u05da \u05d4\u05db\u05d0\u05d1 \u05d1-NSSI (StahlNeuro p.107)."
        },
        {
          "text": "\u05e2\u05dc\u05d9\u05d9\u05d4 \u05d1\u05e8\u05de\u05ea \u05d4-Dopamine \u05d1-nigrostriatal pathway.",
          "isCorrect": false,
          "rationale": "\u05de\u05e1\u05dc\u05d5\u05dc \u05d6\u05d4 \u05e7\u05e9\u05d5\u05e8 \u05d1\u05e2\u05d9\u05e7\u05e8 \u05dc\u05d1\u05e7\u05e8\u05d4 \u05de\u05d5\u05d8\u05d5\u05e8\u05d9\u05ea; \u05d4\u05de\u05e1\u05dc\u05d5\u05dc \u05d4\u05de\u05d6\u05d5\u05dc\u05d9\u05de\u05d1\u05d9 \u05d4\u05d5\u05d0 \u05d6\u05d4 \u05e9\u05e7\u05e9\u05d5\u05e8 \u05dc\u05ea\u05d2\u05de\u05d5\u05dc, \u05d0\u05da \u05d4\u05d0\u05e4\u05e7\u05d8 \u05d4\u05de\u05e8\u05d2\u05d9\u05e2 \u05d4\u05e1\u05e4\u05e6\u05d9\u05e4\u05d9 \u05d1-NSSI \u05de\u05d9\u05d5\u05d7\u05e1 \u05dc\u05d0\u05d5\u05e4\u05d9\u05d5\u05d0\u05d9\u05d3\u05d9\u05dd (StahlNeuro p.90, p.91)."
