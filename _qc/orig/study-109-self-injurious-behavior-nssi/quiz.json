    {
      "type": "multiple_choice",
      "question": "\u05d1\u05ea\u05db\u05e0\u05d5\u05df \u05d8\u05d9\u05e4\u05d5\u05dc \u05e4\u05e1\u05d9\u05db\u05d5\u05ea\u05e8\u05e4\u05d5\u05d9\u05d8\u05d9 \u05dc\u05de\u05ea\u05d1\u05d2\u05e8 \u05e2\u05dd \u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05de\u05d6'\u05d5\u05e8\u05d9 \u05d4\u05de\u05e6\u05d9\u05d2 \u05d0\u05e4\u05d9\u05d6\u05d5\u05d3\u05d5\u05ea \u05d7\u05d5\u05d6\u05e8\u05d5\u05ea \u05e9\u05dc NSSI \u05d5\u05e0\u05e1\u05d9\u05d5\u05e0\u05d5\u05ea \u05d0\u05d5\u05d1\u05d3\u05e0\u05d9\u05d9\u05dd, \u05de\u05d4\u05d5 \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05e9\u05e0\u05de\u05e6\u05d0 \u05d1\u05e2\u05dc \u05d4\u05e8\u05d0\u05d9\u05d5\u05ea \u05d4\u05d7\u05d6\u05e7\u05d5\u05ea \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05d4\u05e4\u05d7\u05ea\u05ea \u05e0\u05d9\u05e1\u05d9\u05d5\u05e0\u05d5\u05ea \u05d0\u05d5\u05d1\u05d3\u05e0\u05d9\u05d9\u05dd \u05d5-NSSI \u05d1\u05de\u05d7\u05e7\u05e8 RCT \u05e9\u05dc McCauley et al. (2018)?",
      "answerOptions": [
        {
          "text": "Dialectical Behavior Therapy (DBT).",
          "isCorrect": true,
          "rationale": "\u05de\u05d7\u05e7\u05e8 RCT \u05d4\u05e8\u05d0\u05d4 \u05d9\u05ea\u05e8\u05d5\u05e0\u05d5\u05ea \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05d9\u05dd \u05dc-DBT \u05e2\u05dc \u05e4\u05e0\u05d9 \u05d8\u05d9\u05e4\u05d5\u05dc \u05ea\u05de\u05d9\u05db\u05ea\u05d9 \u05d1\u05d4\u05e4\u05d7\u05ea\u05ea \u05e0\u05d9\u05e1\u05d9\u05d5\u05e0\u05d5\u05ea \u05d0\u05d5\u05d1\u05d3\u05e0\u05d9\u05d9\u05dd, NSSI \u05d5\u05d4\u05ea\u05de\u05d3\u05d4 \u05d1\u05d8\u05d9\u05e4\u05d5\u05dc (Dulcan p.557)."
        },
        {
          "text": "Mentalization-Based Treatment for Adolescents (MBT-A).",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05e9\u05d7\u05dc\u05e7 \u05de\u05d4\u05de\u05d7\u05e7\u05e8\u05d9\u05dd \u05d4\u05e8\u05d0\u05d5 \u05d9\u05e8\u05d9\u05d3\u05d4 \u05d1\u05e4\u05d2\u05d9\u05e2\u05d4 \u05e2\u05e6\u05de\u05d9\u05ea, \u05de\u05d7\u05e7\u05e8\u05d9\u05dd \u05e2\u05d3\u05db\u05e0\u05d9\u05d9\u05dd (Beck et al. 2020) \u05dc\u05d0 \u05de\u05e6\u05d0\u05d5 \u05d4\u05d1\u05d3\u05dc \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9 \u05de\u05d5\u05dc \u05d8\u05d9\u05e4\u05d5\u05dc \u05e8\u05d2\u05d9\u05dc (TAU) (Dulcan p.557)."
        },
        {
          "text": "Cognitive Behavioral Therapy for Suicide Prevention (CBT-SP).",
          "isCorrect": false,
          "rationale": "\u05d8\u05d9\u05e4\u05d5\u05dc \u05d6\u05d4 \u05d9\u05e2\u05d9\u05dc \u05dc\u05de\u05e0\u05d9\u05e2\u05ea \u05d0\u05d5\u05d1\u05d3\u05e0\u05d5\u05ea, \u05d0\u05da \u05d4-RCT \u05d4\u05e1\u05e4\u05e6\u05d9\u05e4\u05d9 \u05e9\u05dc McCauley \u05d4\u05e9\u05d5\u05d5\u05d4 DBT \u05de\u05d5\u05dc \u05d8\u05d9\u05e4\u05d5\u05dc \u05ea\u05de\u05d9\u05db\u05ea\u05d9 (Dulcan p.557, p.609)."
        },
        {
          "text": "\u05de\u05d5\u05e0\u05d5\u05d8\u05e8\u05e4\u05d9\u05d4 \u05d1\u05d0\u05de\u05e6\u05e2\u05d5\u05ea SSRI \u05e2\u05dd \u05e0\u05d9\u05d8\u05d5\u05e8 \u05d4\u05d3\u05d5\u05e7.",
          "isCorrect": false,
          "rationale": "\u05d8\u05d9\u05e4\u05d5\u05dc \u05ea\u05e8\u05d5\u05e4\u05ea\u05d9 \u05d1\u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05e2\u05e9\u05d5\u05d9 \u05dc\u05d0 \u05dc\u05d4\u05e1\u05e4\u05d9\u05e7 \u05dc\u05d4\u05e4\u05d7\u05ea\u05ea \u05e1\u05d9\u05db\u05d5\u05df \u05d0\u05d5\u05d1\u05d3\u05e0\u05d9, \u05d5\u05dc\u05e2\u05d9\u05ea\u05d9\u05dd \u05e0\u05d3\u05e8\u05e9 \u05d8\u05d9\u05e4\u05d5\u05dc \u05e4\u05e1\u05d9\u05db\u05d5\u05e1\u05d5\u05e6\u05d9\u05d0\u05dc\u05d9 \u05de\u05de\u05d5\u05e7\u05d3 \u05d1\u05d0\u05d5\u05d1\u05d3\u05e0\u05d5\u05ea (Dulcan p.556)."
