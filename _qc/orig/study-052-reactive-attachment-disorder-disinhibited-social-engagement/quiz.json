{
  "title": "Psychiatry Quiz",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\u05d9\u05dc\u05d3 \u05d1\u05df 4 \u05de\u05d5\u05d1\u05d0 \u05dc\u05d4\u05e2\u05e8\u05db\u05d4 \u05dc\u05d0\u05d7\u05e8 \u05e9\u05e2\u05d1\u05e8 \u05d1\u05d9\u05df 5 \u05de\u05e9\u05e4\u05d7\u05d5\u05ea \u05d0\u05d5\u05de\u05e0\u05d4 \u05d1\u05e9\u05e0\u05ea\u05d9\u05d9\u05dd \u05d4\u05d0\u05d7\u05e8\u05d5\u05e0\u05d5\u05ea \u05e2\u05e7\u05d1 \u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4 \u05e9\u05dc \u05d4\u05d6\u05e0\u05d7\u05d4 \u05d7\u05de\u05d5\u05e8\u05d4. \u05d4\u05de\u05d8\u05e4\u05dc\u05ea \u05d4\u05e0\u05d5\u05db\u05d7\u05d9\u05ea \u05de\u05d3\u05d5\u05d5\u05d7\u05ea \u05db\u05d9 \u05d4\u05d9\u05dc\u05d3 \u05e0\u05e8\u05d0\u05d4 \"\u05de\u05e8\u05d5\u05d7\u05e7 \u05e8\u05d2\u05e9\u05d9\u05ea\", \u05dc\u05e2\u05d9\u05ea\u05d9\u05dd \u05e0\u05d3\u05d9\u05e8\u05d5\u05ea \u05de\u05d7\u05e4\u05e9 \u05e0\u05d7\u05de\u05d4 \u05db\u05e9\u05d4\u05d5\u05d0 \u05e0\u05d5\u05e4\u05dc \u05d5\u05e0\u05e4\u05e6\u05e2, \u05d5\u05d2\u05dd \u05db\u05e9\u05de\u05e0\u05e1\u05d9\u05dd \u05dc\u05d4\u05e8\u05d2\u05d9\u05e2 \u05d0\u05d5\u05ea\u05d5 \u05d4\u05d5\u05d0 \u05e0\u05d5\u05ea\u05e8 \u05e0\u05d5\u05e7\u05e9\u05d4 \u05d5\u05d0\u05d9\u05e0\u05d5 \u05de\u05d2\u05d9\u05d1. \u05d1\u05d1\u05d3\u05d9\u05e7\u05d4 \u05dc\u05d0 \u05e0\u05de\u05e6\u05d0\u05d5 \u05e2\u05e7\u05d1\u05d5\u05ea \u05e9\u05dc Restricted/Repetitive Behaviors (RRBs) \u05d0\u05d5 \u05dc\u05d9\u05e7\u05d5\u05d9 \u05d1-Intentional Communication. \u05de\u05d4\u05d9 \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05e1\u05d1\u05d9\u05e8\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8?",
      "answerOptions": [
        {
          "text": "Reactive Attachment Disorder (RAD)",
          "isCorrect": true,
          "rationale": "\u05d4\u05ea\u05d9\u05d0\u05d5\u05e8 \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9 \u05e9\u05dc \u05e0\u05e1\u05d9\u05d2\u05d4 \u05e8\u05d2\u05e9\u05d9\u05ea, \u05d7\u05d5\u05e1\u05e8 \u05d7\u05d9\u05e4\u05d5\u05e9 \u05e0\u05d7\u05de\u05d4 \u05d5\u05d7\u05d5\u05e1\u05e8 \u05ea\u05d2\u05d5\u05d1\u05d4 \u05dc\u05e0\u05d7\u05de\u05d4 \u05d1\u05e2\u05e7\u05d1\u05d5\u05ea \u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4 \u05e9\u05dc \u05d4\u05d6\u05e0\u05d7\u05d4 (Pathogenic Care) \u05ea\u05d5\u05d0\u05dd \u05d0\u05ea \u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05dc-RAD; \u05d4\u05e2\u05d3\u05e8 RRBs \u05d5\u05ea\u05e7\u05e9\u05d5\u05e8\u05ea \u05db\u05d5\u05d5\u05e0\u05ea\u05d9\u05ea \u05ea\u05e7\u05d9\u05e0\u05d4 \u05e9\u05d5\u05dc\u05dc\u05d9\u05dd ASD (DSM p.295-298)."
        },
        {
          "text": "Autism Spectrum Disorder (ASD)",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05d4\u05dc\u05d9\u05e7\u05d5\u05d9\u05d9\u05dd \u05d4\u05d7\u05d1\u05e8\u05ea\u05d9\u05d9\u05dd, \u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc ASD \u05d3\u05d5\u05e8\u05e9\u05ea \u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05e9\u05dc \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05d9\u05d5\u05ea \u05d5\u05ea\u05d7\u05d5\u05de\u05d9 \u05e2\u05e0\u05d9\u05d9\u05df \u05de\u05d5\u05d2\u05d1\u05dc\u05d9\u05dd \u05d5\u05d7\u05d6\u05e8\u05ea\u05d9\u05d9\u05dd (RRBs), \u05e9\u05e6\u05d5\u05d9\u05df \u05db\u05d9 \u05d0\u05d9\u05e0\u05dd \u05e7\u05d9\u05d9\u05de\u05d9\u05dd \u05d1\u05de\u05e7\u05e8\u05d4 \u05d6\u05d4 (DSM p.298, Dulcan p.525)."
        },
        {
          "text": "Disinhibited Social Engagement Disorder (DSED)",
          "isCorrect": false,
          "rationale": "\u05d4\u05e4\u05e8\u05e2\u05d4 \u05d6\u05d5 \u05de\u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05ea \u05d1\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d7\u05d1\u05e8\u05ea\u05d9\u05ea \u05de\u05d5\u05e4\u05e8\u05d6\u05ea \u05d5\u05d7\u05e1\u05e8\u05ea \u05e2\u05db\u05d1\u05d5\u05ea \u05db\u05dc\u05e4\u05d9 \u05d6\u05e8\u05d9\u05dd, \u05d1\u05e0\u05d9\u05d2\u05d5\u05d3 \u05dc\u05d3\u05e4\u05d5\u05e1 \u05d4\u05e0\u05e1\u05d9\u05d2\u05d4 \u05d5\u05d4\u05e2\u05d9\u05db\u05d5\u05d1 \u05d4\u05e8\u05d2\u05e9\u05d9 \u05d4\u05de\u05ea\u05d5\u05d0\u05e8 \u05db\u05d0\u05df (DSM p.298, tmpykf9fm4t p.2)."
        },
        {
          "text": "Major Depressive Disorder (MDD)",
          "isCorrect": false,
          "rationale": "\u05d0\u05e3 \u05e2\u05dc \u05e4\u05d9 \u05e9\u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05d1\u05d2\u05d9\u05dc \u05d4\u05e8\u05da \u05d9\u05db\u05d5\u05dc \u05dc\u05d4\u05ea\u05d1\u05d8\u05d0 \u05d1\u05d0\u05e4\u05e7\u05d8 \u05de\u05e6\u05d5\u05de\u05e6\u05dd, \u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd MDD \u05dc\u05e8\u05d5\u05d1 \u05e2\u05d3\u05d9\u05d9\u05df \u05d9\u05d7\u05e4\u05e9\u05d5 \u05d5\u05d9\u05d2\u05d9\u05d1\u05d5 \u05dc\u05e0\u05d9\u05e1\u05d9\u05d5\u05e0\u05d5\u05ea \u05e0\u05d7\u05de\u05d4 \u05de\u05e6\u05d3 \u05d3\u05de\u05d5\u05d9\u05d5\u05ea \u05de\u05d8\u05e4\u05dc\u05d5\u05ea (DSM p.298)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05dc\u05d4\u05d1\u05d7\u05d9\u05df \u05d1\u05d9\u05df \u05d3\u05e4\u05d5\u05e1 \u05d4\u05e4\u05e0\u05de\u05ea\u05d9 (Internalizing) \u05dc\u05d1\u05d9\u05df \u05d3\u05e4\u05d5\u05e1 \u05d4\u05d7\u05e6\u05e0\u05ea\u05d9 (Externalizing) \u05d1\u05d4\u05e7\u05e9\u05e8 \u05e9\u05dc \u05d8\u05e8\u05d0\u05d5\u05de\u05d4 \u05d5\u05d4\u05d6\u05e0\u05d7\u05d4 \u05de\u05d5\u05e7\u05d3\u05de\u05ea."
    },
    {
      "type": "multiple_choice",
      "question": "\u05e2\u05dc \u05e4\u05d9 \u05de\u05d5\u05d3\u05dc \u05d4-StahlNeuro, \u05de\u05d4\u05d5 \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05de\u05d5\u05dc\u05e7\u05d5\u05dc\u05e8\u05d9 \u05d4\u05de\u05e1\u05d1\u05d9\u05e8 \u05db\u05d9\u05e6\u05d3 \u05e1\u05d8\u05e8\u05e1 \u05db\u05e8\u05d5\u05e0\u05d9 \u05d5\u05d4\u05d6\u05e0\u05d7\u05d4 \u05de\u05d5\u05e7\u05d3\u05de\u05ea \u05d1\u05e9\u05dc\u05d1\u05d9 \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea \u05e7\u05e8\u05d9\u05d8\u05d9\u05d9\u05dd \u05de\u05d5\u05d1\u05d9\u05dc\u05d9\u05dd \u05dc\u05e4\u05d2\u05d9\u05e2\u05d5\u05ea \u05e4\u05e1\u05d9\u05db\u05d5\u05e4\u05ea\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea \u05d0\u05e8\u05d5\u05db\u05ea \u05d8\u05d5\u05d5\u05d7 \u05d1\u05d0\u05de\u05e6\u05e2\u05d5\u05ea \u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd \u05d0\u05e4\u05d9\u05d2\u05e0\u05d8\u05d9\u05d9\u05dd?",
      "answerOptions": [
        {
          "text": "DNA Methylation \u05d5\u05de\u05d5\u05d3\u05d9\u05e4\u05d9\u05e7\u05e6\u05d9\u05d5\u05ea \u05e9\u05dc \u05d4\u05d9\u05e1\u05d8\u05d5\u05e0\u05d9\u05dd \u05d4\u05de\u05e9\u05ea\u05d9\u05e7\u05d9\u05dd \u05d2\u05e0\u05d9\u05dd \u05dc\u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 Glucocorticoids.",
          "isCorrect": true,
          "rationale": "\u05e1\u05d8\u05e8\u05e1 \u05de\u05d5\u05e7\u05d3\u05dd \u05d2\u05d5\u05e8\u05dd \u05dc\u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd \u05d0\u05e4\u05d9\u05d2\u05e0\u05d8\u05d9\u05d9\u05dd \u05db\u05de\u05d5 \u05de\u05ea\u05d9\u05dc\u05e6\u05d9\u05d4 \u05e9\u05dc \u05d4-DNA, \u05de\u05d4 \u05e9\u05de\u05d5\u05d1\u05d9\u05dc \u05dc\u05d4\u05e9\u05ea\u05e7\u05ea \u05d2\u05e0\u05d9\u05dd (Gene Silencing) \u05d4\u05d0\u05d7\u05e8\u05d0\u05d9\u05dd \u05e2\u05dc \u05d5\u05d9\u05e1\u05d5\u05ea \u05e6\u05d9\u05e8 \u05d4-HPA (StahlNeuro p.33, p.556-557)."
        },
        {
          "text": "\u05e2\u05dc\u05d9\u05d9\u05d4 \u05d1\u05e8\u05de\u05d5\u05ea \u05d4-Oxytocin \u05d1-CSF \u05d4\u05de\u05e2\u05db\u05d1\u05ea \u05d0\u05ea \u05d4-Synaptogenesis.",
          "isCorrect": false,
          "rationale": "\u05d4\u05d6\u05e0\u05d7\u05d4 \u05de\u05d5\u05e7\u05d3\u05de\u05ea \u05e7\u05e9\u05d5\u05e8\u05d4 \u05d3\u05d5\u05d5\u05e7\u05d0 \u05dc\u05d9\u05e8\u05d9\u05d3\u05d4 \u05d1\u05e8\u05de\u05d5\u05ea \u05d4-Oxytocin, \u05de\u05d4 \u05e9\u05e4\u05d5\u05d2\u05e2 \u05d1\u05d9\u05db\u05d5\u05dc\u05ea \u05dc\u05d9\u05e6\u05d5\u05e8 \u05e0\u05e7\u05e9\u05e8\u05d5\u05ea \u05e1\u05dc\u05e7\u05d8\u05d9\u05d1\u05d9\u05ea (Dulcan p.525)."
        },
        {
          "text": "\u05e2\u05d9\u05db\u05d5\u05d1 \u05de\u05d5\u05d7\u05dc\u05d8 \u05e9\u05dc \u05d4-Competitive Elimination \u05e9\u05dc \u05e1\u05d9\u05e0\u05e4\u05e1\u05d5\u05ea \u05d1\u05de\u05d4\u05dc\u05da \u05d2\u05d9\u05dc \u05d4\u05d4\u05ea\u05d1\u05d2\u05e8\u05d5\u05ea.",
          "isCorrect": false,
          "rationale": "\u05d4\u05d1\u05e2\u05d9\u05d4 \u05d4\u05d9\u05d0 \u05dc\u05e8\u05d5\u05d1 \u05d2\u05d9\u05d6\u05d5\u05dd (Pruning) \u05de\u05d5\u05e4\u05e8\u05d6 \u05d0\u05d5 \u05e9\u05d2\u05d5\u05d9 \u05e9\u05dc \u05e1\u05d9\u05e0\u05e4\u05e1\u05d5\u05ea \u05e9\u05dc\u05d0 \u05d7\u05d5\u05d6\u05e7\u05d5 \u05e2\u05e7\u05d1 \u05d7\u05d5\u05e1\u05e8 \u05d1\u05d2\u05d9\u05e8\u05d5\u05d9\u05d9\u05dd, \u05d5\u05dc\u05d0 \u05e2\u05d9\u05db\u05d5\u05d1 \u05d4\u05ea\u05d4\u05dc\u05d9\u05da (StahlNeuro p.151-153)."
        },
        {
          "text": "\u05d9\u05e8\u05d9\u05d3\u05d4 \u05d1\u05e8\u05de\u05d5\u05ea \u05d4-Glucocorticoids \u05d4\u05d2\u05d5\u05e8\u05de\u05ea \u05dc\u05d4\u05d9\u05e4\u05e8\u05d8\u05e8\u05d5\u05e4\u05d9\u05d4 \u05e9\u05dc \u05d4-Hippocampus.",
          "isCorrect": false,
          "rationale": "\u05e1\u05d8\u05e8\u05e1 \u05db\u05e8\u05d5\u05e0\u05d9 \u05de\u05d5\u05d1\u05d9\u05dc \u05dc\u05d4\u05d9\u05e4\u05e8-\u05d0\u05e7\u05d8\u05d9\u05d1\u05d9\u05d5\u05ea \u05e9\u05dc \u05e6\u05d9\u05e8 \u05d4-HPA \u05d5\u05e8\u05e2\u05d9\u05dc\u05d5\u05ea \u05d2\u05dc\u05d5\u05e7\u05d5\u05e7\u05d5\u05e8\u05d8\u05d9\u05e7\u05d5\u05d0\u05d9\u05d3\u05d9\u05ea \u05d4\u05d2\u05d5\u05e8\u05de\u05ea \u05dc\u05d0\u05d8\u05e8\u05d5\u05e4\u05d9\u05d4 (Atrophy) \u05d5\u05dc\u05d0 \u05dc\u05d4\u05d9\u05e4\u05e8\u05d8\u05e8\u05d5\u05e4\u05d9\u05d4 \u05e9\u05dc \u05d4\u05d4\u05d9\u05e4\u05d5\u05e7\u05de\u05e4\u05d5\u05e1 (StahlNeuro p.269, Dulcan p.524)."
        }
      ],
      "hint": "\u05d4\u05ea\u05de\u05e7\u05d3\u05d5 \u05d1\u05ea\u05d4\u05dc\u05d9\u05db\u05d9\u05dd \u05d4\u05de\u05e9\u05e0\u05d9\u05dd \u05d0\u05ea \u05d1\u05d9\u05d8\u05d5\u05d9 \u05d4\u05d2\u05e0\u05d9\u05dd \u05dc\u05dc\u05d0 \u05e9\u05d9\u05e0\u05d5\u05d9 \u05d1\u05e8\u05e6\u05e3 \u05d4-DNA \u05e2\u05e6\u05de\u05d5 \u05d1\u05ea\u05d2\u05d5\u05d1\u05d4 \u05dc\u05e1\u05d1\u05d9\u05d1\u05d4."
    },
    {
      "type": "multiple_select",
      "question": "\u05d9\u05dc\u05d3\u05d4 \u05d1\u05ea 5 \u05e2\u05dd \u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc DSED \u05d0\u05d5\u05de\u05e6\u05d4 \u05e2\u05dc \u05d9\u05d3\u05d9 \u05de\u05e9\u05e4\u05d7\u05d4 \u05de\u05e1\u05d5\u05e8\u05d4 \u05d4\u05de\u05e1\u05e4\u05e7\u05ea \u05e1\u05d1\u05d9\u05d1\u05d4 \u05d8\u05d9\u05e4\u05d5\u05dc\u05d9\u05ea \u05d0\u05d5\u05e4\u05d8\u05d9\u05de\u05dc\u05d9\u05ea (Enhanced Caregiving). \u05d0\u05d9\u05dc\u05d5 \u05de\u05d4\u05de\u05e1\u05e7\u05e0\u05d5\u05ea \u05d4\u05d1\u05d0\u05d5\u05ea \u05dc\u05d2\u05d1\u05d9 \u05d4\u05e4\u05e8\u05d5\u05d2\u05e0\u05d5\u05d6\u05d4 \u05d5\u05d4\u05de\u05d4\u05dc\u05da \u05d4\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9 \u05e9\u05dc\u05d4 \u05e0\u05ea\u05de\u05db\u05d5\u05ea \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d4-DSM-5-TR \u05d5\u05d4-Dulcan?",
      "answerOptions": [
        {
          "text": "\u05ea\u05e1\u05de\u05d9\u05e0\u05d9 \u05d4-DSED \u05e0\u05d5\u05d8\u05d9\u05dd \u05dc\u05d4\u05e4\u05d2\u05d9\u05df \u05d9\u05e6\u05d9\u05d1\u05d5\u05ea \u05e0\u05d9\u05db\u05e8\u05ea \u05d5\u05dc\u05d4\u05de\u05e9\u05d9\u05da \u05d2\u05dd \u05dc\u05d0\u05d7\u05e8 \u05d4\u05de\u05e2\u05d1\u05e8 \u05dc\u05e1\u05d1\u05d9\u05d1\u05d4 \u05de\u05d8\u05d9\u05d1\u05d4.",
          "isCorrect": true,
          "rationale": "\u05d1\u05e0\u05d9\u05d2\u05d5\u05d3 \u05dc-RAD, \u05d4\u05e4\u05e8\u05e2\u05ea DSED \u05e2\u05de\u05d9\u05d3\u05d4 \u05d9\u05d7\u05e1\u05d9\u05ea \u05dc\u05e9\u05d9\u05e4\u05d5\u05e8 \u05d1\u05d0\u05d9\u05db\u05d5\u05ea \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d5\u05e0\u05d5\u05d8\u05d4 \u05dc\u05d4\u05d9\u05e9\u05d0\u05e8 \u05db\u05e8\u05d5\u05e0\u05d9\u05ea (DSM p.300, tmpykf9fm4t p.3)."
        },
        {
          "text": "\u05d1\u05d2\u05d9\u05dc \u05d4\u05d4\u05ea\u05d1\u05d2\u05e8\u05d5\u05ea, \u05d4\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d4\u05d1\u05dc\u05ea\u05d9-\u05de\u05e1\u05d5\u05d9\u05d2\u05ea \u05e2\u05dc\u05d5\u05dc\u05d4 \u05dc\u05d4\u05ea\u05e8\u05d7\u05d1 \u05dc\u05e7\u05d1\u05d5\u05e6\u05ea \u05d4\u05e9\u05d5\u05d5\u05d9\u05dd (Peers) \u05d5\u05dc\u05d4\u05d5\u05d1\u05d9\u05dc \u05dc\u05e7\u05d5\u05e0\u05e4\u05dc\u05d9\u05e7\u05d8\u05d9\u05dd \u05d7\u05d1\u05e8\u05ea\u05d9\u05d9\u05dd.",
          "isCorrect": true,
          "rationale": "\u05d4\u05d1\u05d9\u05d8\u05d5\u05d9 \u05e9\u05dc DSED \u05de\u05e9\u05ea\u05e0\u05d4 \u05e2\u05dd \u05d4\u05d2\u05d9\u05dc; \u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd \u05de\u05e6\u05d9\u05d2\u05d9\u05dd \u05d9\u05d7\u05e1\u05d9\u05dd \u05e9\u05d8\u05d7\u05d9\u05d9\u05dd \u05d5\u05e7\u05d5\u05e0\u05e4\u05dc\u05d9\u05e7\u05d8\u05d9\u05dd \u05de\u05e8\u05d5\u05d1\u05d9\u05dd \u05e2\u05dd \u05d1\u05e0\u05d9 \u05d2\u05d9\u05dc\u05dd (DSM p.300)."
        },
        {
          "text": "\u05e0\u05e6\u05e4\u05d4 \u05dc\u05e9\u05d9\u05e4\u05d5\u05e8 \u05e7\u05dc\u05d9\u05e0\u05d9 \u05de\u05d4\u05d9\u05e8 \u05d5\u05e9\u05d9\u05e7\u05d5\u05dd \u05de\u05dc\u05d0 \u05e9\u05dc \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05d9\u05d5\u05ea \u05d4\u05e0\u05e7\u05e9\u05e8\u05d5\u05ea \u05d4\u05e1\u05dc\u05e7\u05d8\u05d9\u05d1\u05d9\u05d5\u05ea \u05ea\u05d5\u05da \u05e9\u05d1\u05d5\u05e2\u05d5\u05ea \u05de\u05d4\u05d0\u05d9\u05de\u05d5\u05e5.",
          "isCorrect": false,
          "rationale": "\u05e9\u05d9\u05e4\u05d5\u05e8 \u05de\u05d4\u05d9\u05e8 \u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05d9 \u05dc-RAD, \u05d1\u05e2\u05d5\u05d3 \u05e9-DSED \u05de\u05e8\u05d0\u05d4 \u05e2\u05de\u05d9\u05d3\u05d5\u05ea (DSM p.297, p.300)."
        },
        {
          "text": "\u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05e7\u05d9\u05d9\u05dd \u05e8\u05e7 \u05d0\u05dd \u05d4\u05d4\u05d6\u05e0\u05d7\u05d4 \u05d4\u05e8\u05d0\u05e9\u05d5\u05e0\u05d9\u05ea \u05d4\u05ea\u05e8\u05d7\u05e9\u05d4 \u05dc\u05d0\u05d7\u05e8 \u05d2\u05d9\u05dc \u05e9\u05e0\u05ea\u05d9\u05d9\u05dd.",
          "isCorrect": false,
          "rationale": "\u05d4\u05e4\u05e8\u05e2\u05ea DSED \u05dc\u05d0 \u05d6\u05d5\u05d4\u05ea\u05d4 \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05e9\u05d7\u05d5\u05d5 \u05d4\u05d6\u05e0\u05d7\u05d4 \u05dc\u05e8\u05d0\u05e9\u05d5\u05e0\u05d4 \u05dc\u05d0\u05d7\u05e8 \u05d2\u05d9\u05dc \u05e9\u05e0\u05ea\u05d9\u05d9\u05dd (DSM p.300)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d1\u05d5 \u05e2\u05dc \u05d4\u05d4\u05d1\u05d3\u05dc \u05d1\u05d9\u05df RAD \u05dc-DSED \u05d1\u05d9\u05db\u05d5\u05dc\u05ea \u05d4\u05ea\u05d2\u05d5\u05d1\u05d4 \u05dc\u05e9\u05d9\u05e7\u05d5\u05dd \u05d4\u05e1\u05d1\u05d9\u05d1\u05ea\u05d9 (Resilience vs Stability).",
      "hasAllOfTheAbove": false,
      "hasNoneOfTheAbove": false
    },
    {
      "type": "fill_in_the_blank",
      "question": "\u05e2\u05dc \u05e4\u05d9 \u05d4-DSM-5-TR, \u05db\u05d3\u05d9 \u05dc\u05e7\u05d1\u05d5\u05e2 \u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc Reactive Attachment Disorder \u05d0\u05d5 Disinhibited Social Engagement Disorder, \u05e2\u05dc \u05d4\u05d9\u05dc\u05d3 \u05dc\u05d4\u05d9\u05d5\u05ea \u05d1\u05e2\u05dc \u05d2\u05d9\u05dc \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9 (Developmental age) \u05e9\u05dc \u05dc\u05e4\u05d7\u05d5\u05ea ___ \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd.",
      "bestAnswer": "9",
      "acceptableAnswers": [
        "\u05ea\u05e9\u05e2\u05d4",
        "nine"
      ],
      "rationale": "\u05d4\u05d3\u05e8\u05d9\u05e9\u05d4 \u05dc\u05d2\u05d9\u05dc \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9 \u05e9\u05dc 9 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05e0\u05d5\u05d1\u05e2\u05ea \u05de\u05db\u05da \u05e9\u05dc\u05e4\u05e0\u05d9 \u05d2\u05d9\u05dc \u05d6\u05d4 \u05d9\u05dc\u05d3\u05d9\u05dd \u05d0\u05d9\u05e0\u05dd \u05de\u05e1\u05d5\u05d2\u05dc\u05d9\u05dd \u05de\u05d1\u05d7\u05d9\u05e0\u05d4 \u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9\u05ea \u05dc\u05d9\u05e6\u05d5\u05e8 \u05e0\u05e7\u05e9\u05e8\u05d5\u05ea \u05e1\u05dc\u05e7\u05d8\u05d9\u05d1\u05d9\u05ea (DSM p.296, p.299).",
      "hint": "\u05d6\u05d4\u05d5 \u05d4\u05d2\u05d9\u05dc \u05e9\u05d1\u05d5 \u05d9\u05dc\u05d3 \u05de\u05ea\u05d7\u05d9\u05dc \u05d1\u05d3\u05e8\u05da \u05db\u05dc\u05dc \u05dc\u05d4\u05e4\u05d2\u05d9\u05df \u05d4\u05e2\u05d3\u05e4\u05d4 \u05d1\u05e8\u05d5\u05e8\u05d4 \u05dc\u05de\u05d8\u05e4\u05dc \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9 \u05d5\u05d7\u05e8\u05d3\u05ea \u05d6\u05e8\u05d9\u05dd."
    },
    {
      "type": "multiple_choice",
      "question": "\u05d1\u05e0\u05d9\u05d4\u05d5\u05dc \u05e7\u05dc\u05d9\u05e0\u05d9 \u05e9\u05dc \u05d9\u05dc\u05d3 \u05d4\u05d2\u05d3\u05dc \u05d1\u05de\u05e1\u05d2\u05e8\u05ea \u05d0\u05d5\u05de\u05e0\u05d4 \u05d5\u05de\u05e6\u05d9\u05d2 \u05ea\u05e1\u05de\u05d9\u05e0\u05d9 ADHD \u05e7\u05e9\u05d9\u05dd \u05d9\u05d7\u05d3 \u05e2\u05dd \u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4 \u05e9\u05dc \u05d8\u05e8\u05d0\u05d5\u05de\u05d4 \u05d5\u05d4\u05d6\u05e0\u05d7\u05d4 \u05d7\u05de\u05d5\u05e8\u05d4, \u05de\u05d4\u05d9 \u05d4\u05d4\u05de\u05dc\u05e6\u05d4 \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc\u05d9\u05ea \u05e9\u05dc \u05d4-StahlKids \u05d5\u05d4-Dulcan \u05dc\u05e4\u05e0\u05d9 \u05ea\u05d7\u05d9\u05dc\u05ea \u05d8\u05d9\u05e4\u05d5\u05dc \u05ea\u05e8\u05d5\u05e4\u05ea\u05d9 \u05d1-Methylphenidate?",
      "answerOptions": [
        {
          "text": "\u05d1\u05d9\u05e1\u05d5\u05e1 \u05d3\u05de\u05d5\u05ea \u05e0\u05e7\u05e9\u05e8\u05d5\u05ea \u05d9\u05e6\u05d9\u05d1\u05d4 \u05d5\u05e9\u05d9\u05e4\u05d5\u05e8 \u05d4\u05e1\u05d1\u05d9\u05d1\u05d4 \u05d4\u05d7\u05d9\u05e0\u05d5\u05db\u05d9\u05ea \u05d5\u05d4\u05d1\u05d9\u05ea\u05d9\u05ea \u05dc\u05e6\u05de\u05e6\u05d5\u05dd \u05e1\u05d8\u05e8\u05e1 \u05d7\u05d5\u05d6\u05e8.",
          "isCorrect": true,
          "rationale": "\u05d1\u05d0\u05d5\u05db\u05dc\u05d5\u05e1\u05d9\u05d5\u05ea \u05e4\u05d2\u05d9\u05e2\u05d5\u05ea (Highly Vulnerable), \u05e9\u05d9\u05e4\u05d5\u05e8 \u05d4\u05e1\u05d1\u05d9\u05d1\u05d4 \u05d5\u05d4\u05e4\u05d7\u05ea\u05ea \u05d8\u05e8\u05d0\u05d5\u05de\u05d4 \u05e2\u05e9\u05d5\u05d9\u05d9\u05dd \u05dc\u05d4\u05d9\u05d5\u05ea \u05d0\u05e4\u05e7\u05d8\u05d9\u05d1\u05d9\u05d9\u05dd \u05d9\u05d5\u05ea\u05e8 \u05d0\u05d5 \u05dc\u05d4\u05d2\u05d1\u05d9\u05e8 \u05d0\u05ea \u05d9\u05e2\u05d9\u05dc\u05d5\u05ea \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05ea\u05e8\u05d5\u05e4\u05ea\u05d9 (StahlKids p.276, Dulcan p.530)."
        },
        {
          "text": "\u05d4\u05ea\u05d7\u05dc\u05ea \u05d8\u05d9\u05e4\u05d5\u05dc \u05de\u05d9\u05d9\u05d3\u05d9 \u05d1-Haloperidol \u05d1\u05de\u05d9\u05e0\u05d5\u05df \u05e0\u05de\u05d5\u05da \u05dc\u05e8\u05d9\u05e1\u05d5\u05df \u05d4\u05d9\u05e4\u05e8\u05d0\u05e7\u05d8\u05d9\u05d1\u05d9\u05d5\u05ea.",
          "isCorrect": false,
          "rationale": "\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05d0\u05e0\u05d8\u05d9-\u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9\u05d9\u05dd \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05e4\u05d2\u05d9\u05e2\u05d9\u05dd \u05dc\u05dc\u05d0 \u05d4\u05e2\u05e8\u05db\u05d4 \u05d0\u05d1\u05d7\u05e0\u05ea\u05d9\u05ea \u05de\u05e7\u05d9\u05e4\u05d4 \u05d5\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05de\u05d7\u05dc\u05ea \u05d4\u05d1\u05e1\u05d9\u05e1 \u05d4\u05d5\u05d0 \u05d0\u05e1\u05d5\u05e8 (Prohibited) (StahlKids p.240)."
        },
        {
          "text": "\u05de\u05ea\u05df \u05e7\u05d5 \u05e8\u05d0\u05e9\u05d5\u05df \u05e9\u05dc Lithium \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-DMDD \u05e7\u05d5\u05de\u05d5\u05e8\u05d1\u05d9\u05d3\u05d9.",
          "isCorrect": false,
          "rationale": "\u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc DMDD \u05e2\u05d3\u05d9\u05d9\u05df \u05de\u05ea\u05d1\u05d4\u05e8\u05ea, \u05d5\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1-Lithium \u05d1\u05d9\u05dc\u05d3\u05d9 \u05d0\u05d5\u05de\u05e0\u05d4 \u05d3\u05d5\u05e8\u05e9 \u05d6\u05d4\u05d9\u05e8\u05d5\u05ea \u05d5\u05d4\u05e2\u05e8\u05db\u05d4 \u05d9\u05e1\u05d5\u05d3\u05d9\u05ea \u05e9\u05dc \u05d4\u05e4\u05e8\u05e2\u05ea \u05d4\u05d1\u05e1\u05d9\u05e1 (StahlKids p.292)."
        },
        {
          "text": "\u05d4\u05d9\u05de\u05e0\u05e2\u05d5\u05ea \u05de\u05d5\u05d7\u05dc\u05d8\u05ea \u05de\u05d2\u05d9\u05e8\u05d5\u05d9\u05d9\u05dd (Stimulants) \u05e2\u05e7\u05d1 \u05d4\u05d7\u05e9\u05e9 \u05de\u05d7\u05d5\u05e1\u05e8 \u05e1\u05d1\u05d9\u05dc\u05d5\u05ea \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd DMDD.",
          "isCorrect": false,
          "rationale": "\u05e0\u05d9\u05ea\u05df \u05dc\u05e9\u05e7\u05d5\u05dc \u05e1\u05d8\u05d9\u05de\u05d5\u05dc\u05e0\u05d8\u05d9\u05dd \u05e2\u05d1\u05d5\u05e8 ADHD \u05e7\u05d5\u05de\u05d5\u05e8\u05d1\u05d9\u05d3\u05d9, \u05d0\u05da \u05d9\u05e9 \u05dc\u05e0\u05d8\u05e8 \u05d0\u05ea \u05d4\u05e1\u05d1\u05d9\u05dc\u05d5\u05ea (StahlKids p.177)."
        }
      ],
      "hint": "\u05d4\u05ea\u05de\u05e7\u05d3\u05d5 \u05d1\u05d2\u05d9\u05e9\u05d4 \u05d4-Bio-Psycho-Social \u05d4\u05e0\u05d3\u05e8\u05e9\u05ea \u05d1\u05d0\u05d5\u05db\u05dc\u05d5\u05e1\u05d9\u05d5\u05ea \u05d1\u05e1\u05d9\u05db\u05d5\u05df \u05d2\u05d1\u05d5\u05d4 (Vulnerable populations)."
    },
    {
      "type": "short_answer",
      "question": "\u05d4\u05e1\u05d1\u05d9\u05e8\u05d5 \u05d0\u05ea \u05d4\u05e7\u05e9\u05e8 \u05d1\u05d9\u05df \u05ea\u05d4\u05dc\u05d9\u05da \u05d4-Competitive Elimination (\u05d2\u05d9\u05d6\u05d5\u05dd \u05e1\u05d9\u05e0\u05e4\u05d8\u05d9) \u05dc\u05d1\u05d9\u05df \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea \u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05e9\u05dc Schizophrenia \u05d1\u05d2\u05d9\u05dc \u05d4\u05d4\u05ea\u05d1\u05d2\u05e8\u05d5\u05ea, \u05e2\u05dc \u05e4\u05d9 StahlNeuro.",
      "grading": {
        "modelAnswer": "\u05d1\u05de\u05d4\u05dc\u05da \u05d2\u05d9\u05dc \u05d4\u05d4\u05ea\u05d1\u05d2\u05e8\u05d5\u05ea \u05de\u05ea\u05e8\u05d7\u05e9 \u05ea\u05d4\u05dc\u05d9\u05da \u05e9\u05dc Competitive Elimination \u05e9\u05d1\u05d5 \u05e1\u05d9\u05e0\u05e4\u05e1\u05d5\u05ea '\u05d7\u05dc\u05e9\u05d5\u05ea' \u05de\u05d5\u05e1\u05e8\u05d5\u05ea \u05d5\u05e1\u05d9\u05e0\u05e4\u05e1\u05d5\u05ea '\u05d7\u05d6\u05e7\u05d5\u05ea' (\u05e2\u05dd NMDA/AMPA \u05d9\u05e2\u05d9\u05dc\u05d9\u05dd) \u05e9\u05d5\u05e8\u05d3\u05d5\u05ea. \u05d1\u05e1\u05db\u05d9\u05d6\u05d5\u05e4\u05e8\u05e0\u05d9\u05d4, \u05e7\u05d9\u05d9\u05de\u05ea \u05d4\u05d9\u05e4\u05d5\u05ea\u05d6\u05d4 \u05db\u05d9 \u05e1\u05d9\u05e0\u05e4\u05e1\u05d5\u05ea \u05e7\u05e8\u05d9\u05d8\u05d9\u05d5\u05ea \u05dc\u05d0 \u05d7\u05d5\u05d6\u05e7\u05d5 \u05db\u05e8\u05d0\u05d5\u05d9, \u05de\u05d4 \u05e9\u05de\u05d5\u05d1\u05d9\u05dc \u05dc\u05d2\u05d9\u05d6\u05d5\u05dd \u05de\u05d5\u05e4\u05e8\u05d6 \u05d5\u05e9\u05d2\u05d5\u05d9 \u05d4\u05d2\u05d5\u05e8\u05dd \u05dc-Dysconnectivity \u05d5\u05dc\u05d4\u05d5\u05e4\u05e2\u05ea \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9\u05d9\u05dd (Psychotic Breaks) \u05dc\u05d0\u05d7\u05e8 \u05e1\u05d9\u05d5\u05dd \u05ea\u05e7\u05d5\u05e4\u05ea \u05d4\u05e4\u05d9\u05e6\u05d5\u05d9 \u05e9\u05dc \u05d4\u05d9\u05dc\u05d3\u05d5\u05ea (StahlNeuro p.151-153).",
        "rationale": "\u05d4\u05d4\u05e1\u05d1\u05e8 \u05de\u05e7\u05e9\u05e8 \u05d1\u05d9\u05df \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea \u05de\u05d5\u05d7\u05d9\u05ea \u05e0\u05d5\u05e8\u05de\u05dc\u05d9\u05ea \u05dc\u05d1\u05d9\u05df \u05e1\u05d8\u05d9\u05d9\u05d4 \u05e4\u05ea\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea \u05d4\u05de\u05ea\u05d5\u05d5\u05db\u05ea \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d7\u05d5\u05e1\u05e8 \u05d1\u05d7\u05d9\u05d6\u05d5\u05e7 \u05e1\u05d9\u05e0\u05e4\u05d8\u05d9 \u05d5\u05d2\u05d9\u05d6\u05d5\u05dd \u05d9\u05ea\u05e8.",
        "requiredAttributes": [
          "\u05e6\u05d9\u05d5\u05df \u05d4\u05ea\u05d4\u05dc\u05d9\u05da \u05e9\u05dc Competitive Elimination \u05d0\u05d5 Synaptic Pruning.",
          "\u05d4\u05e1\u05d1\u05e8 \u05e9\u05d4\u05e1\u05d9\u05e0\u05e4\u05e1\u05d5\u05ea \u05d4\u05e0\u05d5\u05ea\u05e8\u05d5\u05ea \u05d4\u05df \u05d0\u05dc\u05d5 \u05e9\u05d7\u05d5\u05d6\u05e7\u05d5 (NMDA/AMPA).",
          "\u05e7\u05d9\u05e9\u05d5\u05e8 \u05dc-Dysconnectivity \u05db\u05ea\u05d5\u05e6\u05d0\u05d4 \u05de\u05d2\u05d9\u05d6\u05d5\u05dd \u05e9\u05d2\u05d5\u05d9 \u05d1\u05e1\u05db\u05d9\u05d6\u05d5\u05e4\u05e8\u05e0\u05d9\u05d4.",
          "\u05e6\u05d9\u05d5\u05df \u05d2\u05d9\u05dc \u05d4\u05d4\u05ea\u05d1\u05d2\u05e8\u05d5\u05ea \u05db\u05d6\u05de\u05df \u05d4\u05d5\u05e4\u05e2\u05ea \u05d4\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05e2\u05e7\u05d1 \u05e1\u05d9\u05d5\u05dd \u05d4\u05e4\u05d9\u05e6\u05d5\u05d9."
        ],
        "errors": {
          "misconceptions": [
            "\u05d8\u05e2\u05e0\u05d4 \u05e9\u05e1\u05db\u05d9\u05d6\u05d5\u05e4\u05e8\u05e0\u05d9\u05d4 \u05e0\u05d2\u05e8\u05de\u05ea \u05de\u05d7\u05d5\u05e1\u05e8 \u05de\u05d5\u05d7\u05dc\u05d8 \u05d1\u05e1\u05d9\u05e0\u05e4\u05e1\u05d5\u05ea \u05db\u05d1\u05e8 \u05d1\u05dc\u05d9\u05d3\u05d4.",
            "\u05d4\u05ea\u05e2\u05dc\u05de\u05d5\u05ea \u05de\u05d4\u05ea\u05e4\u05e7\u05d9\u05d3 \u05e9\u05dc \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 NMDA/AMPA \u05d1\u05d7\u05d5\u05d6\u05e7 \u05d4\u05e1\u05d9\u05e0\u05e4\u05d8\u05d9."
          ],
          "bluffs": [
            "\u05d3\u05d9\u05d1\u05d5\u05e8 \u05db\u05dc\u05dc\u05d9 \u05e2\u05dc '\u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd \u05d1\u05de\u05d5\u05d7' \u05dc\u05dc\u05d0 \u05e4\u05d9\u05e8\u05d5\u05d8 \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05e1\u05d9\u05e0\u05e4\u05d8\u05d9."
          ]
        }
      },
      "hint": "\u05d7\u05e9\u05d1\u05d5 \u05e2\u05dc \u05d4\u05e2\u05d9\u05e7\u05e8\u05d5\u05df \u05e9\u05dc 'Use it or lose it' \u05d5\u05d4\u05e9\u05dc\u05db\u05d5\u05ea\u05d9\u05d5 \u05e2\u05dc \u05d4\u05e7\u05d9\u05e9\u05d5\u05e8\u05d9\u05d5\u05ea \u05d4\u05de\u05d5\u05d7\u05d9\u05ea."
    },
    {
      "type": "multiple_choice",
      "question": "\u05d1\u05d1\u05d5\u05d0\u05e0\u05d5 \u05dc\u05d4\u05d1\u05d7\u05d9\u05df \u05d1\u05d9\u05df DSED \u05dc\u05d1\u05d9\u05df ADHD \u05d1\u05de\u05e7\u05e8\u05d4 \u05e9\u05dc \u05d9\u05dc\u05d3 \u05e2\u05dd \u05d0\u05d9\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05d5\u05ea \u05d7\u05d1\u05e8\u05ea\u05d9\u05ea \u05d1\u05d5\u05dc\u05d8\u05ea, \u05de\u05d4\u05d5 \u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df \u05d4\u05de\u05d1\u05d7\u05d9\u05df \u05d4\u05e2\u05d9\u05e7\u05e8\u05d9 \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR?",
      "answerOptions": [
        {
          "text": "\u05d1-DSED \u05d4\u05d0\u05d9\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05d5\u05ea \u05d4\u05d9\u05d0 \u05d7\u05d1\u05e8\u05ea\u05d9\u05ea \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05ea (Social Disinhibition), \u05d1\u05e2\u05d5\u05d3 \u05e9\u05d1-ADHD \u05d4\u05d9\u05d0 \u05dc\u05e8\u05d5\u05d1 \u05de\u05d5\u05d8\u05d5\u05e8\u05d9\u05ea \u05d5\u05db\u05dc\u05dc\u05d9\u05ea.",
          "isCorrect": true,
          "rationale": "\u05d4-DSM \u05de\u05d3\u05d2\u05d9\u05e9 \u05db\u05d9 \u05d4\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d1-DSED \u05d0\u05d9\u05e0\u05d4 \u05de\u05d5\u05d2\u05d1\u05dc\u05ea \u05e8\u05e7 \u05dc\u05d0\u05d9\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05d5\u05ea \u05e9\u05dc ADHD \u05d0\u05dc\u05d0 \u05db\u05d5\u05dc\u05dc\u05ea \u05d7\u05d5\u05e1\u05e8 \u05e2\u05db\u05d1\u05d5\u05ea \u05d7\u05d1\u05e8\u05ea\u05d9 (Socially Disinhibited Behavior) (DSM p.299, p.301)."
        },
        {
          "text": "\u05e8\u05e7 \u05d1-ADHD \u05e7\u05d9\u05d9\u05de\u05ea \u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4 \u05e9\u05dc \u05d4\u05d6\u05e0\u05d7\u05d4 \u05d7\u05d1\u05e8\u05ea\u05d9\u05ea \u05d5\u05e8\u05d2\u05e9\u05d9\u05ea \u05d7\u05de\u05d5\u05e8\u05d4.",
          "isCorrect": false,
          "rationale": "\u05d4\u05d4\u05e4\u05da \u05d4\u05d5\u05d0 \u05d4\u05e0\u05db\u05d5\u05df: \u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4 \u05e9\u05dc \u05d4\u05d6\u05e0\u05d7\u05d4 (Pathogenic Care) \u05d4\u05d9\u05d0 \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df \u05d4\u05db\u05e8\u05d7\u05d9 \u05dc-DSED \u05d0\u05da \u05dc\u05d0 \u05dc-ADHD (DSM p.299)."
        },
        {
          "text": "\u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc DSED \u05d3\u05d5\u05e8\u05e9\u05ea \u05dc\u05d9\u05e7\u05d5\u05d9\u05d9\u05dd \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05d9\u05dd \u05d1\u05e7\u05e9\u05d1 (Attention) \u05e9\u05d0\u05d9\u05e0\u05dd \u05e7\u05d9\u05d9\u05de\u05d9\u05dd \u05d1-ADHD.",
          "isCorrect": false,
          "rationale": "\u05d4\u05e4\u05e8\u05e2\u05ea DSED \u05d0\u05d9\u05e0\u05d4 \u05d3\u05d5\u05e8\u05e9\u05ea \u05dc\u05d9\u05e7\u05d5\u05d9 \u05e7\u05e9\u05d1\u05d9; \u05e7\u05e9\u05d9\u05d9 \u05e7\u05e9\u05d1 \u05d4\u05dd \u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05dd \u05d4\u05dc\u05d9\u05d1\u05d4 \u05e9\u05dc ADHD (DSM p.301)."
        },
        {
          "text": "\u05ea\u05e1\u05de\u05d9\u05e0\u05d9 ADHD \u05de\u05e9\u05ea\u05e4\u05e8\u05d9\u05dd \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05e2\u05dd \u05e9\u05d9\u05e4\u05d5\u05e8 \u05d4\u05e1\u05d1\u05d9\u05d1\u05d4 \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc\u05d9\u05ea, \u05d1\u05e2\u05d5\u05d3 \u05e9-DSED \u05dc\u05d0.",
          "isCorrect": false,
          "rationale": "\u05d4\u05d9\u05e6\u05d9\u05d1\u05d5\u05ea \u05d4\u05e1\u05d1\u05d9\u05d1\u05ea\u05d9\u05ea \u05de\u05e9\u05e4\u05d9\u05e2\u05d4 \u05d1\u05e2\u05d9\u05e7\u05e8 \u05e2\u05dc RAD; ADHD \u05d4\u05d9\u05d0 \u05d4\u05e4\u05e8\u05e2\u05d4 \u05e0\u05d5\u05d9\u05e8\u05d5-\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9\u05ea \u05e9\u05dc\u05e8\u05d5\u05d1 \u05d3\u05d5\u05e8\u05e9\u05ea \u05d8\u05d9\u05e4\u05d5\u05dc \u05de\u05e2\u05d1\u05e8 \u05dc\u05e9\u05d9\u05e4\u05d5\u05e8 \u05e1\u05d1\u05d9\u05d1\u05ea\u05d9 \u05d1\u05dc\u05d1\u05d3 (tmpykf9fm4t p.3)."
        }
      ],
      "hint": "\u05d4\u05ea\u05de\u05e7\u05d3\u05d5 \u05d1\u05d8\u05d9\u05d1 \u05d4\u05d0\u05d9\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05d5\u05ea (\u05d7\u05d1\u05e8\u05ea\u05d9\u05ea \u05de\u05d5\u05dc \u05ea\u05e4\u05e7\u05d5\u05d3\u05d9\u05ea/\u05de\u05d5\u05d8\u05d5\u05e8\u05d9\u05ea)."
    },
    {
      "type": "multiple_choice",
      "question": "\u05de\u05d4\u05d9 \u05d4\u05d7\u05e9\u05d9\u05d1\u05d5\u05ea \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05e9\u05dc \u05d1\u05d3\u05d9\u05e7\u05ea \u05d4-Oxytocin System \u05d1\u05de\u05d7\u05e7\u05e8\u05d9\u05dd \u05e2\u05dc \u05d9\u05dc\u05d3\u05d9\u05dd \u05e9\u05d7\u05d5\u05d5 \u05d4\u05ea\u05e2\u05dc\u05dc\u05d5\u05ea \u05d5\u05d4\u05d6\u05e0\u05d7\u05d4, \u05e2\u05dc \u05e4\u05d9 \u05d4-Dulcan?",
      "answerOptions": [
        {
          "text": "\u05e8\u05de\u05d5\u05ea \u05e0\u05de\u05d5\u05db\u05d5\u05ea \u05e9\u05dc Oxytocin \u05e7\u05e9\u05d5\u05e8\u05d5\u05ea \u05dc\u05e4\u05d2\u05d9\u05e2\u05d4 \u05d1\u05de\u05e2\u05d2\u05dc\u05d9\u05dd \u05d4\u05de\u05ea\u05d5\u05d5\u05db\u05d9\u05dd \u05d0\u05de\u05e4\u05ea\u05d9\u05d4 \u05d5\u05ea\u05d2\u05de\u05d5\u05dc \u05d7\u05d1\u05e8\u05ea\u05d9.",
          "isCorrect": true,
          "rationale": "\u05d4\u05d6\u05e0\u05d7\u05d4 \u05de\u05d5\u05e7\u05d3\u05de\u05ea \u05de\u05d5\u05d1\u05d9\u05dc\u05d4 \u05dc\u05d9\u05e8\u05d9\u05d3\u05d4 \u05d1\u05e8\u05de\u05d5\u05ea \u05d4\u05d0\u05d5\u05e7\u05e1\u05d9\u05d8\u05d5\u05e6\u05d9\u05df, \u05de\u05d4 \u05e9\u05de\u05e9\u05d1\u05e9 \u05d0\u05ea \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea \u05d4\u05de\u05e2\u05e8\u05db\u05d5\u05ea \u05d4\u05de\u05d5\u05d7\u05d9\u05d5\u05ea \u05d4\u05d0\u05d7\u05e8\u05d0\u05d9\u05d5\u05ea \u05e2\u05dc \u05e7\u05e9\u05e8\u05d9\u05dd \u05d7\u05d1\u05e8\u05ea\u05d9\u05d9\u05dd (Dulcan p.524-525)."
        },
        {
          "text": "\u05e2\u05dc\u05d9\u05d9\u05d4 \u05d1\u05e8\u05de\u05d5\u05ea \u05d4-Oxytocin \u05de\u05e9\u05de\u05e9\u05ea \u05db\u05e1\u05de\u05df (Biomarker) \u05dc\u05d0\u05d1\u05d7\u05e0\u05d4 \u05de\u05d1\u05d3\u05dc\u05ea \u05d1\u05d9\u05df RAD \u05dc-ASD.",
          "isCorrect": false,
          "rationale": "\u05d0\u05d9\u05df \u05e2\u05d3\u05d5\u05ea \u05dc\u05db\u05da \u05e9\u05d0\u05d5\u05e7\u05e1\u05d9\u05d8\u05d5\u05e6\u05d9\u05df \u05de\u05e9\u05de\u05e9 \u05db\u05db\u05dc\u05d9 \u05d0\u05d1\u05d7\u05e0\u05ea\u05d9 \u05de\u05d1\u05d3\u05dc \u05db\u05d6\u05d4 \u05d1\u05de\u05e8\u05e4\u05d0\u05d4; \u05e8\u05de\u05d5\u05ea\u05d9\u05d5 \u05dc\u05e8\u05d5\u05d1 \u05d9\u05d5\u05e8\u05d3\u05d5\u05ea \u05d1\u05d8\u05e8\u05d0\u05d5\u05de\u05d4 (Dulcan p.525)."
        },
        {
          "text": "Oxytocin \u05de\u05d2\u05df \u05e2\u05dc \u05d4-Hippocampus \u05de\u05e4\u05e0\u05d9 \u05e8\u05e2\u05d9\u05dc\u05d5\u05ea \u05e9\u05dc Glucocorticoids.",
          "isCorrect": false,
          "rationale": "\u05d4\u05d4\u05d2\u05e0\u05d4 \u05e2\u05dc \u05d4\u05d4\u05d9\u05e4\u05d5\u05e7\u05de\u05e4\u05d5\u05e1 \u05de\u05d9\u05d5\u05d7\u05e1\u05ea \u05dc\u05e8\u05d5\u05d1 \u05dc\u05e0\u05e7\u05e9\u05e8\u05d5\u05ea \u05d1\u05d8\u05d5\u05d7\u05d4 (Secure Attachment) \u05d4\u05de\u05de\u05ea\u05e0\u05ea \u05d0\u05ea \u05e6\u05d9\u05e8 \u05d4-HPA, \u05d0\u05da \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05d9\u05e9\u05d9\u05e8 \u05d0\u05d9\u05e0\u05d5 \u05de\u05d5\u05d2\u05d3\u05e8 \u05e8\u05e7 \u05d3\u05e8\u05da \u05d0\u05d5\u05e7\u05e1\u05d9\u05d8\u05d5\u05e6\u05d9\u05df (Dulcan p.525)."
        },
        {
          "text": "\u05d8\u05d9\u05e4\u05d5\u05dc \u05ea\u05e8\u05d5\u05e4\u05ea\u05d9 \u05d1\u05d0\u05d5\u05e7\u05e1\u05d9\u05d8\u05d5\u05e6\u05d9\u05df \u05d4\u05d5\u05db\u05d7 \u05db\u05e7\u05d5 \u05e8\u05d0\u05e9\u05d5\u05df \u05dc\u05e8\u05d9\u05e4\u05d5\u05d9 \u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05e9\u05dc DSED.",
          "isCorrect": false,
          "rationale": "\u05e0\u05db\u05d5\u05df \u05dc\u05d4\u05d9\u05d5\u05dd \u05d0\u05d9\u05df \u05d4\u05ea\u05d5\u05d5\u05d9\u05d4 \u05ea\u05e8\u05d5\u05e4\u05ea\u05d9\u05ea \u05de\u05d0\u05d5\u05e9\u05e8\u05ea \u05dc\u05d0\u05d5\u05e7\u05e1\u05d9\u05d8\u05d5\u05e6\u05d9\u05df \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-DSED (StahlKids p.502)."
