{
  "title": "Attachment Flashcards",
  "cards": [
    {
      "front": "\u05d1\u05d0\u05d9\u05d6\u05d4 \u05e4\u05e8\u05e7 \u05d1-DSM-5-TR \u05de\u05e7\u05d5\u05d1\u05e6\u05d5\u05ea \u05d4\u05d0\u05d1\u05d7\u05e0\u05d5\u05ea RAD \u05d5-DSED?",
      "back": "Trauma- and Stressor-Related Disorders (DSM p.295)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4-Developmental age \u05d4\u05de\u05d9\u05e0\u05d9\u05de\u05dc\u05d9 \u05d4\u05e0\u05d3\u05e8\u05e9 \u05dc\u05de\u05ea\u05df \u05d0\u05d1\u05d7\u05e0\u05ea RAD \u05d0\u05d5 DSED?",
      "back": "\u05dc\u05e4\u05d7\u05d5\u05ea 9 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd (DSM p.296, p.299)."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05de\u05d5\u05d2\u05d3\u05e8 \u05d4-Internalizing pattern \u05d1-Reactive Attachment Disorder (RAD)?",
      "back": "\u05e0\u05e1\u05d9\u05d2\u05d4 \u05e8\u05d2\u05e9\u05d9\u05ea \u05d5\u05e2\u05db\u05d1\u05d4 \u05d1\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05db\u05dc\u05e4\u05d9 \u05de\u05d8\u05e4\u05dc\u05d9\u05dd, \u05d4\u05de\u05ea\u05d1\u05d8\u05d0\u05ea \u05d1\u05d7\u05d9\u05e4\u05d5\u05e9 \u05d0\u05d5 \u05ea\u05d2\u05d5\u05d1\u05d4 \u05de\u05d6\u05e2\u05e8\u05d9\u05ea \u05dc\u05e0\u05d7\u05de\u05d4 \u05d1\u05e2\u05ea \u05de\u05e6\u05d5\u05e7\u05d4 (DSM p.295)."
    },
    {
      "front": "\u05de\u05d4\u05dd \u05e9\u05e0\u05d9 \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9\u05dd \u05e9\u05dc \u05d3\u05e4\u05d5\u05e1 \u05d4-Externalizing \u05d1-Disinhibited Social Engagement Disorder (DSED)?",
      "back": "\u05e4\u05e0\u05d9\u05d9\u05d4 \u05d5\u05d0\u05d9\u05e0\u05d8\u05e8\u05d0\u05e7\u05e6\u05d9\u05d4 \u05d1\u05dc\u05ea\u05d9-\u05de\u05e1\u05d5\u05d9\u05d2\u05ea \u05e2\u05dd \u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd \u05d6\u05e8\u05d9\u05dd \u05d5\u05d4\u05e2\u05d3\u05e8 \u05d2\u05d1\u05d5\u05dc\u05d5\u05ea \u05d7\u05d1\u05e8\u05ea\u05d9\u05d9\u05dd \u05ea\u05d5\u05d0\u05de\u05d9 \u05ea\u05e8\u05d1\u05d5\u05ea (DSM p.298)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05ea\u05e0\u05d0\u05d9 \u05d4\u05e1\u05e3 \u05d4\u05d0\u05d8\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 (Criterion C) \u05d4\u05de\u05e9\u05d5\u05ea\u05e3 \u05dc-RAD \u05d5-DSED?",
      "back": "\u05d3\u05e4\u05d5\u05e1 \u05e9\u05dc Extremes of insufficient care (\u05d4\u05d6\u05e0\u05d7\u05d4 \u05d7\u05d1\u05e8\u05ea\u05d9\u05ea, \u05d7\u05e1\u05da \u05e8\u05d2\u05e9\u05d9 \u05d0\u05d5 \u05d7\u05d9\u05dc\u05d5\u05e4\u05d9\u05dd \u05ea\u05db\u05d5\u05e4\u05d9\u05dd \u05e9\u05dc \u05de\u05d8\u05e4\u05dc\u05d9\u05dd) (DSM p.296, p.299)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05de\u05d1\u05d3\u05dc\u05ea \u05d4\u05e2\u05d9\u05e7\u05e8\u05d9\u05ea \u05d1\u05d9\u05df RAD \u05dc-Autism Spectrum Disorder (ASD)?",
      "back": "\u05d1-ASD \u05e7\u05d9\u05d9\u05de\u05d9\u05dd Restricted, repetitive patterns of behavior \u05d5\u05d0\u05d9\u05e0\u05d8\u05e8\u05e1\u05d9\u05dd \u05de\u05e7\u05d5\u05d1\u05e2\u05d9\u05dd, \u05e9\u05d0\u05d9\u05e0\u05dd \u05de\u05d5\u05e4\u05d9\u05e2\u05d9\u05dd \u05d1-RAD (DSM p.297)."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05e0\u05d9\u05ea\u05df \u05dc\u05d4\u05d1\u05d3\u05d9\u05dc \u05d1\u05d9\u05df DSED \u05dc\u05d1\u05d9\u05df ADHD \u05d4\u05de\u05dc\u05d5\u05d5\u05d4 \u05d1-Social impulsivity?",
      "back": "\u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd DSED \u05d0\u05d9\u05e0\u05dd \u05de\u05e8\u05d0\u05d9\u05dd \u05d1\u05d4\u05db\u05e8\u05d7 \u05e7\u05e9\u05d9\u05d9\u05dd \u05d1-Attention \u05d0\u05d5 Hyperactivity \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9\u05dd ADHD (DSM p.301)."
    },
    {
      "front": "\u05e0\u05db\u05d5\u05df \u05d0\u05d5 \u05dc\u05d0 \u05e0\u05db\u05d5\u05df: \u05ea\u05e1\u05de\u05d9\u05e0\u05d9 DSED \u05e0\u05d5\u05d8\u05d9\u05dd \u05dc\u05d4\u05e9\u05ea\u05e4\u05e8 \u05d1\u05de\u05d4\u05d9\u05e8\u05d5\u05ea \u05dc\u05d0\u05d7\u05e8 \u05de\u05e2\u05d1\u05e8 \u05dc\u05e1\u05d1\u05d9\u05d1\u05d4 \u05d8\u05d9\u05e4\u05d5\u05dc\u05d9\u05ea \u05de\u05d8\u05d9\u05d1\u05d4 (Enhanced caregiving).",
      "back": "\u05dc\u05d0 \u05e0\u05db\u05d5\u05df; \u05ea\u05e1\u05de\u05d9\u05e0\u05d9 DSED \u05de\u05e4\u05d2\u05d9\u05e0\u05d9\u05dd \u05d9\u05e6\u05d9\u05d1\u05d5\u05ea \u05d5\u05e2\u05dc\u05d5\u05dc\u05d9\u05dd \u05dc\u05d4\u05de\u05e9\u05d9\u05da \u05d2\u05dd \u05d1\u05e1\u05d1\u05d9\u05d1\u05d4 \u05e0\u05d5\u05e8\u05de\u05d8\u05d9\u05d1\u05d9\u05ea, \u05d1\u05e0\u05d9\u05d2\u05d5\u05d3 \u05dc-RAD \u05d4\u05de\u05d2\u05d9\u05d1\u05d4 \u05d4\u05d9\u05d8\u05d1 \u05dc\u05e9\u05d9\u05e7\u05d5\u05dd (DSM p.297, p.300)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05e9\u05d9\u05e0\u05d5\u05d9 \u05d4\u05e4\u05d9\u05d6\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d1\u05e6\u05d9\u05e8 \u05d4-HPA \u05e9\u05e0\u05de\u05e6\u05d0 \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05e9\u05d7\u05d5\u05d5 \u05d4\u05d6\u05e0\u05d7\u05d4 \u05de\u05d5\u05e7\u05d3\u05de\u05ea?",
      "back": "\u05d3\u05d9\u05e1\u05e8\u05e2\u05d2\u05d5\u05dc\u05e6\u05d9\u05d4 \u05d4\u05de\u05ea\u05d1\u05d8\u05d0\u05ea \u05d1\u05d4\u05e4\u05e8\u05e9\u05ea \u05e7\u05d5\u05e8\u05d8\u05d9\u05d6\u05d5\u05dc \u05d1\u05dc\u05ea\u05d9-\u05ea\u05e7\u05d9\u05e0\u05d4 (\u05e9\u05d8\u05d5\u05d7\u05d4 \u05d0\u05d5 \u05d4\u05d9\u05e4\u05e8\u05d0\u05e7\u05d8\u05d9\u05d1\u05d9\u05ea) \u05d5\u05e9\u05d9\u05d1\u05d5\u05e9 \u05d1\u05ea\u05d2\u05d5\u05d1\u05ea \u05d4\u05e1\u05d8\u05e8\u05e1 (Dulcan p.524, p.525)."
    },
    {
      "front": "\u05d0\u05d9\u05d6\u05d4 \u05e0\u05d5\u05d9\u05e8\u05d5\u05e4\u05e4\u05d8\u05d9\u05d3 \u05e7\u05e9\u05d5\u05e8 \u05dc\u05d1\u05d9\u05e1\u05d5\u05e1 \u05d4-Selective attachment \u05d5\u05e0\u05de\u05e6\u05d0 \u05d1\u05e8\u05de\u05d5\u05ea \u05e0\u05de\u05d5\u05db\u05d5\u05ea \u05d1\u05e0\u05e9\u05d9\u05dd \u05e9\u05d7\u05d5\u05d5 \u05d4\u05ea\u05e2\u05dc\u05dc\u05d5\u05ea \u05d1\u05d9\u05dc\u05d3\u05d5\u05ea?",
      "back": "Oxytocin (Dulcan p.524)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05de\u05de\u05e6\u05d0 \u05d4\u05de\u05d1\u05e0\u05d9 \u05d1-MRI \u05e9\u05e0\u05de\u05e6\u05d0 \u05d1\u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd \u05e2\u05dd PTSD \u05db\u05ea\u05d5\u05e6\u05d0\u05d4 \u05de\u05d4\u05ea\u05e2\u05dc\u05dc\u05d5\u05ea \u05db\u05e8\u05d5\u05e0\u05d9\u05ea \u05d1\u05d9\u05dc\u05d3\u05d5\u05ea?",
      "back": "\u05d9\u05e8\u05d9\u05d3\u05d4 \u05d1\u05e0\u05e4\u05d7 \u05d4-Hippocampus (Dulcan p.525)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05d2\u05d9\u05e9\u05d4 \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc\u05d9\u05ea \u05d4\u05e8\u05d0\u05e9\u05d5\u05e0\u05d4 (First-line) \u05d1\u05d9\u05dc\u05d3 \u05e2\u05dd \u05d0\u05d1\u05d7\u05e0\u05ea RAD?",
      "back": "\u05d4\u05d1\u05d8\u05d7\u05ea \u05e1\u05d1\u05d9\u05d1\u05d4 \u05d1\u05d8\u05d5\u05d7\u05d4 (Safety) \u05d5\u05d1\u05d9\u05e1\u05d5\u05e1 \u05d3\u05de\u05d5\u05ea \u05de\u05d8\u05e4\u05dc\u05ea \u05e7\u05d1\u05d5\u05e2\u05d4, \u05e8\u05d2\u05d9\u05e9\u05d4 \u05d5\u05de\u05d2\u05d9\u05d1\u05d4 (Dulcan p.530)."
    },
    {
      "front": "\u05d0\u05d9\u05d6\u05d4 \u05de\u05d5\u05d3\u05dc \u05d8\u05d9\u05e4\u05d5\u05dc\u05d9 \u05de\u05d1\u05d5\u05e1\u05e1 \u05e8\u05d0\u05d9\u05d5\u05ea (Evidence-based) \u05de\u05ea\u05de\u05e7\u05d3 \u05d1\u05e9\u05d9\u05e4\u05d5\u05e8 \u05d4\u05d0\u05d9\u05e0\u05d8\u05e8\u05d0\u05e7\u05e6\u05d9\u05d4 \u05d4\u05d3\u05d9\u05d0\u05d3\u05d9\u05ea \u05d5\u05d1\u05d9\u05e6\u05d9\u05e8\u05ea joint trauma narrative \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05e6\u05e2\u05d9\u05e8\u05d9\u05dd?",
      "back": "Child-Parent Psychotherapy (CPP) (Dulcan p.950)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05de\u05d8\u05e8\u05ea \u05d4\u05d4\u05ea\u05e2\u05e8\u05d1\u05d5\u05ea \u05d1\u05e9\u05d9\u05d8\u05ea Attachment and Biobehavioral Catch-up (ABC)?",
      "back": "\u05d0\u05d9\u05de\u05d5\u05df \u05de\u05d8\u05e4\u05dc\u05d9\u05dd (\u05d0\u05d5\u05de\u05e0\u05d4/\u05d0\u05d9\u05de\u05d5\u05e5) \u05dc\u05d4\u05d2\u05d9\u05d1 \u05d1\u05e8\u05d2\u05d9\u05e9\u05d5\u05ea \u05dc\u05d0\u05d5\u05ea\u05d5\u05ea \u05de\u05e6\u05d5\u05e7\u05d4 \u05e9\u05dc \u05d9\u05dc\u05d3\u05d9\u05dd \u05e9\u05d7\u05d5\u05d5 \u05d7\u05e1\u05da \u05de\u05d5\u05e7\u05d3\u05dd (\u05de\u05e7\u05d5\u05e8: \u05d4\u05e7\u05e9\u05e8 \u05e8\u05d7\u05d1)."
    },
    {
      "front": "\u05e2\u05d3 \u05d0\u05d9\u05d6\u05d4 \u05d2\u05d9\u05dc \u05d7\u05d9\u05d9\u05d1\u05ea \u05dc\u05d4\u05d5\u05e4\u05d9\u05e2 \u05d4\u05d4\u05e4\u05e8\u05e2\u05d4 \u05db\u05d3\u05d9 \u05dc\u05e2\u05de\u05d5\u05d3 \u05d1\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05e9\u05dc RAD?",
      "back": "\u05dc\u05e4\u05e0\u05d9 \u05d2\u05d9\u05dc 5 \u05e9\u05e0\u05d9\u05dd (DSM p.296)."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05de\u05ea\u05d1\u05d8\u05d0\u05ea DSED \u05d1\u05e9\u05dc\u05d1 \u05d4-Adolescence?",
      "back": "\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d1\u05dc\u05ea\u05d9-\u05de\u05e1\u05d5\u05d9\u05d2\u05ea \u05db\u05dc\u05e4\u05d9 \u05e7\u05d1\u05d5\u05e6\u05ea \u05d4\u05e9\u05d5\u05d5\u05d9\u05dd (Peers) \u05d5\u05d9\u05d7\u05e1\u05d9\u05dd \u05e9\u05d8\u05d7\u05d9\u05d9\u05dd \u05d4\u05de\u05dc\u05d5\u05d5\u05d9\u05dd \u05d1\u05e7\u05d5\u05e0\u05e4\u05dc\u05d9\u05e7\u05d8\u05d9\u05dd (DSM p.300)."
    },
    {
      "front": "\u05d0\u05d9\u05d6\u05d4 \u05dc\u05d9\u05e7\u05d5\u05d9 \u05e0\u05d5\u05d9\u05e8\u05d5\u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d1-DSED \u05e7\u05e9\u05d5\u05e8 \u05dc-Frontostriatal circuits?",
      "back": "\u05e9\u05d9\u05dc\u05d5\u05d1 \u05e9\u05dc Blunted reward sensitivity \u05d9\u05d7\u05d3 \u05e2\u05dd Decreased inhibitory control (DSM p.300)."
    },
    {
      "front": "\u05d1\u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd \u05dc\u05d0-\u05d5\u05e8\u05d1\u05dc\u05d9\u05d9\u05dd \u05e2\u05dd ASD \u05d0\u05d5 RAD, \u05d0\u05d9\u05dc\u05d5 \u05e1\u05d9\u05de\u05e0\u05d9\u05dd \u05e4\u05d9\u05d6\u05d9\u05d9\u05dd \u05e6\u05e8\u05d9\u05db\u05d9\u05dd \u05dc\u05e2\u05d5\u05e8\u05e8 \u05d4\u05e2\u05e8\u05db\u05d4 \u05dc\u05d3\u05d9\u05db\u05d0\u05d5\u05df, \u05d7\u05e8\u05d3\u05d4 \u05d0\u05d5 \u05db\u05d0\u05d1?",
      "back": "\u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd \u05d1\u05e9\u05d9\u05e0\u05d4 \u05d0\u05d5 \u05d1\u05d0\u05db\u05d9\u05dc\u05d4 \u05d5\u05e2\u05dc\u05d9\u05d9\u05d4 \u05d1-Challenging behavior (DSM p.61)."
    }
  ]
}