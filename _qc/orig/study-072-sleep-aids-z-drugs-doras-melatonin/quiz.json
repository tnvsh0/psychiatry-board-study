{
  "title": "Sleep Quiz",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\u05de\u05ea\u05d1\u05d2\u05e8 \u05d1\u05df 16 \u05e2\u05dd Insomnia Disorder \u05d5\u05e8\u05e7\u05e2 \u05e9\u05dc Sleepwalking \u05d1\u05d9\u05dc\u05d3\u05d5\u05ea \u05d4\u05de\u05d5\u05e7\u05d3\u05de\u05ea \u05de\u05d1\u05e7\u05e9 \u05d8\u05d9\u05e4\u05d5\u05dc \u05ea\u05e8\u05d5\u05e4\u05ea\u05d9 \u05e2\u05e7\u05d1 \u05e7\u05e9\u05d9\u05d9 \u05d4\u05d9\u05e8\u05d3\u05de\u05d5\u05ea \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05d9\u05dd \u05d4\u05e4\u05d5\u05d2\u05e2\u05d9\u05dd \u05d1\u05ea\u05e4\u05e7\u05d5\u05d3\u05d5 \u05d4\u05dc\u05d9\u05de\u05d5\u05d3\u05d9. \u05d1\u05d1\u05d5\u05d0\u05da \u05dc\u05d1\u05d7\u05d5\u05e8 \u05d8\u05d9\u05e4\u05d5\u05dc \u05e4\u05e8\u05de\u05e7\u05d5\u05dc\u05d5\u05d2\u05d9, \u05d0\u05d9\u05d6\u05d5 \u05de\u05d4\u05d0\u05e4\u05e9\u05e8\u05d5\u05d9\u05d5\u05ea \u05d4\u05d1\u05d0\u05d5\u05ea \u05d4\u05d9\u05d0 \u05d4\u05e0\u05d9\u05d4\u05d5\u05dc \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9 \u05d4\u05e0\u05db\u05d5\u05df \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d1\u05d4\u05ea\u05d1\u05e1\u05e1 \u05e2\u05dc \u05e4\u05e8\u05d5\u05e4\u05d9\u05dc \u05ea\u05d5\u05e4\u05e2\u05d5\u05ea \u05d4\u05dc\u05d5\u05d5\u05d0\u05d9 \u05d5\u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05de\u05d5\u05d7\u05d9?",
      "answerOptions": [
        {
          "text": "\u05de\u05ea\u05df Zolpidem \u05d1\u05de\u05d9\u05e0\u05d5\u05df \u05e0\u05de\u05d5\u05da \u05dc\u05e4\u05e0\u05d9 \u05d4\u05e9\u05d9\u05e0\u05d4, \u05ea\u05d5\u05da \u05de\u05e2\u05e7\u05d1 \u05d0\u05d7\u05e8 \u05d9\u05e2\u05d9\u05dc\u05d5\u05ea \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc.",
          "isCorrect": false,
          "rationale": "\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1-Z-drugs \u05db\u05d2\u05d5\u05df Zolpidem \u05e7\u05e9\u05d5\u05e8 \u05dc\u05e2\u05dc\u05d9\u05d9\u05d4 \u05d1\u05e1\u05d9\u05db\u05d5\u05df \u05dc-Parasomnias \u05db\u05de\u05d5 Sleepwalking \u05d5-Sleep-related eating, \u05d1\u05de\u05d9\u05d5\u05d7\u05d3 \u05d1\u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd \u05e2\u05dd \u05e0\u05d8\u05d9\u05d9\u05d4 \u05e7\u05d9\u05d9\u05de\u05ea (Dulcan p. 483, StahlNeuro p. 422)."
        },
        {
          "text": "\u05d4\u05e2\u05d3\u05e4\u05ea DORA (\u05db\u05d2\u05d5\u05df Suvorexant) \u05e2\u05dc \u05e4\u05e0\u05d9 Z-drugs \u05e2\u05e7\u05d1 \u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05de\u05e4\u05d7\u05d9\u05ea Arousal \u05dc\u05dc\u05d0 \u05d4\u05d2\u05d1\u05e8\u05ea \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05dc-Parasomnias \u05de\u05d5\u05e8\u05db\u05d1\u05d5\u05ea.",
          "isCorrect": true,
          "rationale": "\u05de\u05e2\u05db\u05d1\u05d9 Orexin (DORAs) \u05e4\u05d5\u05e2\u05dc\u05d9\u05dd \u05d3\u05e8\u05da \u05d4\u05e4\u05d7\u05ea\u05ea \u05d3\u05d7\u05e3 \u05d4\u05e2\u05d9\u05e8\u05d5\u05ea \u05d5\u05dc\u05d0 \u05d3\u05e8\u05da \u05de\u05d5\u05d3\u05d5\u05dc\u05e6\u05d9\u05d4 \u05e9\u05dc GABA-A, \u05d5\u05dc\u05db\u05df \u05d0\u05d9\u05e0\u05dd \u05de\u05d6\u05d5\u05d4\u05d9\u05dd \u05e2\u05dd \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05d4\u05de\u05d5\u05d2\u05d1\u05e8 \u05dc-Parasomnias \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05df Z-drugs \u05d5-Benzodiazepines (StahlNeuro p. 423-424)."
        },
        {
          "text": "\u05de\u05ea\u05df Clonazepam \u05db\u05de\u05e2\u05db\u05d1 Phasic inhibitory neurotransmission \u05dc\u05d4\u05e8\u05d2\u05e2\u05ea \u05d4\u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05dc\u05d9\u05de\u05d1\u05d9\u05ea.",
          "isCorrect": false,
          "rationale": "Benzodiazepines \u05d0\u05d9\u05e0\u05dd \u05e7\u05d5 \u05e8\u05d0\u05e9\u05d5\u05df \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05e7\u05d1 \u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05ea\u05dc\u05d5\u05ea, \u05e1\u05d1\u05d9\u05dc\u05d5\u05ea \u05d5\u05ea\u05d5\u05e4\u05e2\u05d5\u05ea \u05dc\u05d5\u05d5\u05d0\u05d9 \u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9\u05d5\u05ea, \u05d5\u05d4\u05dd \u05de\u05e9\u05e4\u05d9\u05e2\u05d9\u05dd \u05e2\u05dc Phasic inhibition \u05d0\u05da \u05e2\u05dc\u05d5\u05dc\u05d9\u05dd \u05dc\u05d4\u05d7\u05de\u05d9\u05e8 \u05d1\u05dc\u05d1\u05d5\u05dc \u05d1\u05e9\u05d9\u05e0\u05d4 (StahlNeuro p. 421-422, Dulcan p. 482)."
        },
        {
          "text": "\u05d4\u05d9\u05de\u05e0\u05e2\u05d5\u05ea \u05de\u05d8\u05d9\u05e4\u05d5\u05dc \u05ea\u05e8\u05d5\u05e4\u05ea\u05d9 \u05d5\u05de\u05ea\u05df \u05d4\u05de\u05dc\u05e6\u05d4 \u05dc-Sleep hygiene \u05d1\u05dc\u05d1\u05d3, \u05e9\u05db\u05df \u05d0\u05d9\u05df \u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05de\u05d0\u05d5\u05e9\u05e8\u05d5\u05ea FDA \u05dc\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd.",
          "isCorrect": false,
          "rationale": "\u05d0\u05de\u05e0\u05dd \u05d0\u05d9\u05df \u05d0\u05d9\u05e9\u05d5\u05e8 FDA \u05e4\u05d5\u05e8\u05de\u05dc\u05d9 \u05dc\u05e8\u05d5\u05d1 \u05d4\u05ea\u05e8\u05d5\u05e4\u05d5\u05ea, \u05d0\u05da \u05d1\u05de\u05e6\u05d1\u05d9 \u05e4\u05d2\u05d9\u05e2\u05d4 \u05ea\u05e4\u05e7\u05d5\u05d3\u05d9\u05ea \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05d9\u05e9 \u05de\u05e7\u05d5\u05dd \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc Off-label \u05dc\u05d0\u05d7\u05e8 \u05e0\u05d9\u05e1\u05d9\u05d5\u05df \u05d4\u05ea\u05e2\u05e8\u05d1\u05d5\u05ea \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea\u05d9\u05ea (Dulcan p. 481)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05e7\u05e9\u05e8 \u05d1\u05d9\u05df \u05d4\u05e1\u05dc\u05e7\u05d8\u05d9\u05d1\u05d9\u05d5\u05ea \u05dc\u05ea\u05ea-\u05d9\u05d7\u05d9\u05d3\u05d4 $\\alpha 1$ \u05e9\u05dc \u05e7\u05d5\u05dc\u05d8\u05df GABA-A \u05dc\u05d1\u05d9\u05df \u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d1\u05e9\u05d9\u05e0\u05d4.",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05e0\u05e2\u05e8\u05d4 \u05d1\u05ea 14 \u05d4\u05de\u05d0\u05d5\u05d1\u05d7\u05e0\u05ea \u05e2\u05dd Major Depressive Disorder (MDD) \u05de\u05d8\u05d5\u05e4\u05dc\u05ea \u05d1-Fluoxetine \u05d1\u05de\u05d9\u05e0\u05d5\u05df $20\\text{ mg}$. \u05d4\u05d9\u05d0 \u05de\u05d3\u05d5\u05d5\u05d7\u05ea \u05e2\u05dc \u05e9\u05d9\u05e4\u05d5\u05e8 \u05d1\u05de\u05e6\u05d1 \u05d4\u05e8\u05d5\u05d7 \u05d0\u05da \u05e1\u05d5\u05d1\u05dc\u05ea \u05de-Residual Insomnia \u05e7\u05e9\u05d4. \u05d4\u05d5\u05d7\u05dc\u05d8 \u05dc\u05d4\u05d5\u05e1\u05d9\u05e3 Trazodone \u05d1\u05de\u05d9\u05e0\u05d5\u05df $50\\text{ mg}$ \u05dc\u05e4\u05e0\u05d9 \u05d4\u05e9\u05d9\u05e0\u05d4. \u05de\u05d4\u05d5 \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05e4\u05e8\u05de\u05e7\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d4\u05e2\u05d9\u05e7\u05e8\u05d9 \u05d4\u05d0\u05d7\u05e8\u05d0\u05d9 \u05dc\u05d0\u05e4\u05e7\u05d8 \u05d4\u05d4\u05d9\u05e4\u05e0\u05d5\u05d8\u05d9 \u05d1\u05de\u05d9\u05e0\u05d5\u05df \u05d6\u05d4?",
      "answerOptions": [
        {
          "text": "\u05e2\u05d9\u05db\u05d5\u05d1 \u05d4-Serotonin Transporter (SERT) \u05d5\u05e2\u05dc\u05d9\u05d9\u05d4 \u05d1\u05e8\u05de\u05ea \u05d4\u05e1\u05e8\u05d5\u05d8\u05d5\u05e0\u05d9\u05df \u05d4\u05e1\u05d9\u05e0\u05e4\u05d8\u05d9.",
          "isCorrect": false,
          "rationale": "\u05e2\u05d9\u05db\u05d5\u05d1 SERT \u05d3\u05d5\u05e8\u05e9 \u05de\u05d9\u05e0\u05d5\u05e0\u05d9\u05dd \u05d2\u05d1\u05d5\u05d4\u05d9\u05dd \u05d1\u05d4\u05e8\u05d1\u05d4 ($150-600\\text{ mg}$); \u05d1\u05de\u05d9\u05e0\u05d5\u05df \u05e0\u05de\u05d5\u05da Trazodone \u05d0\u05d9\u05e0\u05d5 \u05de\u05d2\u05d9\u05e2 \u05dc\u05e1\u05e3 \u05d4\u05e8\u05d5\u05d5\u05d9\u05d4 \u05e9\u05dc \u05d4\u05d8\u05e8\u05e0\u05e1\u05e4\u05d5\u05e8\u05d8\u05e8 (StahlNeuro p. 314, StahlNeuro p. 425)."
        },
        {
          "text": "\u05d0\u05e0\u05d8\u05d2\u05d5\u05e0\u05d9\u05d6\u05dd \u05dc\u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 $5-HT_{2A}$, $H_{1}$ \u05d5-$\\alpha 1$ \u05d0\u05d3\u05e8\u05e0\u05e8\u05d2\u05d9\u05d9\u05dd.",
          "isCorrect": true,
          "rationale": "\u05d1\u05de\u05d9\u05e0\u05d5\u05e0\u05d9\u05dd \u05e0\u05de\u05d5\u05db\u05d9\u05dd ($25-150\\text{ mg}$), Trazodone \u05e4\u05d5\u05e2\u05dc \u05d1\u05d0\u05d5\u05e4\u05df \u05e8\u05d1-\u05de\u05e2\u05e8\u05db\u05ea\u05d9 \u05db\u05d7\u05d5\u05e1\u05dd \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 \u05e1\u05e8\u05d5\u05d8\u05d5\u05e0\u05d9\u05df, \u05d4\u05d9\u05e1\u05d8\u05de\u05d9\u05df \u05d5\u05d0\u05dc\u05e4\u05d0-1, \u05de\u05d4 \u05e9\u05de\u05e4\u05d7\u05d9\u05ea \u05d0\u05ea \u05d4-Arousal \u05d5\u05de\u05e7\u05d3\u05dd \u05e9\u05d9\u05e0\u05d4 (StahlNeuro p. 314, StahlNeuro p. 424)."
        },
        {
          "text": "\u05d0\u05d2\u05d5\u05e0\u05d9\u05d6\u05dd \u05d7\u05dc\u05e7\u05d9 \u05dc\u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 $5-HT_{1A}$ \u05d4\u05de\u05e4\u05d7\u05d9\u05ea \u05d7\u05e8\u05d3\u05d4.",
          "isCorrect": false,
          "rationale": "\u05d4\u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05e2\u05dc $5-HT_{1A}$ \u05e8\u05dc\u05d5\u05d5\u05e0\u05d8\u05d9\u05ea \u05d1\u05e2\u05d9\u05e7\u05e8 \u05d1\u05de\u05d9\u05e0\u05d5\u05e0\u05d9\u05dd \u05d4\u05d0\u05e0\u05d8\u05d9-\u05d3\u05e4\u05e8\u05e1\u05e0\u05d8\u05d9\u05d9\u05dd \u05d4\u05d2\u05d1\u05d5\u05d4\u05d9\u05dd \u05d5\u05dc\u05d0 \u05d1\u05de\u05d9\u05e0\u05d5\u05df \u05d4\u05d4\u05d9\u05e4\u05e0\u05d5\u05d8\u05d9 \u05d4\u05e0\u05de\u05d5\u05da (StahlNeuro p. 314)."
        },
        {
          "text": "\u05d0\u05e0\u05d8\u05d2\u05d5\u05e0\u05d9\u05d6\u05dd \u05dc\u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 $D_{2}$ \u05d1\u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05e8\u05d8\u05d9\u05e7\u05d5\u05dc\u05e8\u05d9\u05ea.",
          "isCorrect": false,
          "rationale": "\u05dc-Trazodone \u05d0\u05d9\u05df \u05d6\u05d9\u05e7\u05d4 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05dc\u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 $D_{2}$, \u05d5\u05dc\u05db\u05df \u05d6\u05d4 \u05d0\u05d9\u05e0\u05d5 \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05de\u05e9\u05e8\u05d4 \u05e9\u05d9\u05e0\u05d4 (StahlNeuro p. 314)."
        }
      ],
      "hint": "\u05d6\u05db\u05d5\u05e8 \u05db\u05d9 \u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 \u05e4\u05d5\u05e2\u05dc\u05ea \u05db-'Multifunctional drug' \u05d5\u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05e0\u05d9\u05dd \u05e9\u05dc\u05d4 \u05de\u05d2\u05d5\u05d9\u05e1\u05d9\u05dd \u05d1\u05d4\u05d3\u05e8\u05d2\u05d4 \u05dc\u05e4\u05d9 \u05d4\u05de\u05d9\u05e0\u05d5\u05df.",
      "imageUrls": []
    },
    {
      "type": "fill_in_the_blank",
      "question": "\u05d1\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1-Doxepin \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Insomnia Disorder, \u05e0\u05de\u05e6\u05d0 \u05db\u05d9 \u05d1\u05de\u05d9\u05e0\u05d5\u05e0\u05d9\u05dd \u05e0\u05de\u05d5\u05db\u05d9\u05dd \u05de\u05d0\u05d5\u05d3 \u05e9\u05dc $1-6\\text{ mg}$, \u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 \u05e4\u05d5\u05e2\u05dc\u05ea \u05d1\u05d0\u05d5\u05e4\u05df \u05e1\u05dc\u05e7\u05d8\u05d9\u05d1\u05d9 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05db\u05d0\u05e0\u05d8\u05d2\u05d5\u05e0\u05d9\u05e1\u05d8 \u05dc\u05e7\u05d5\u05dc\u05d8\u05df ___, \u05d1\u05e0\u05d9\u05d2\u05d5\u05d3 \u05dc\u05de\u05d9\u05e0\u05d5\u05e0\u05d9\u05dd \u05d4\u05d0\u05e0\u05d8\u05d9-\u05d3\u05e4\u05e8\u05e1\u05e0\u05d8\u05d9\u05d9\u05dd \u05d4\u05de\u05e2\u05e8\u05d1\u05d9\u05dd \u05de\u05e0\u05d2\u05e0\u05d5\u05e0\u05d9\u05dd \u05e0\u05d5\u05e1\u05e4\u05d9\u05dd (StahlNeuro p. 426).",
      "bestAnswer": "H1",
      "acceptableAnswers": [
        "Histamine 1",
        "H-1"
      ],
      "rationale": "Doxepin \u05d1\u05de\u05d9\u05e0\u05d5\u05df \u05e0\u05de\u05d5\u05da (Silenor) \u05d4\u05d5\u05d0 \u05d0\u05e0\u05d8\u05d2\u05d5\u05e0\u05d9\u05e1\u05d8 \u05d4\u05d9\u05e1\u05d8\u05de\u05d9\u05e0\u05e8\u05d2\u05d9 \u05e1\u05dc\u05e7\u05d8\u05d9\u05d1\u05d9 \u05d1\u05d9\u05d5\u05ea\u05e8, \u05de\u05d4 \u05e9\u05de\u05d0\u05e4\u05e9\u05e8 \u05d4\u05e9\u05e8\u05d0\u05d4 \u05d5\u05e9\u05d9\u05de\u05d5\u05e8 \u05e9\u05d9\u05e0\u05d4 \u05dc\u05dc\u05d0 \u05ea\u05d5\u05e4\u05e2\u05d5\u05ea \u05d4\u05dc\u05d5\u05d5\u05d0\u05d9 \u05d4\u05d0\u05e0\u05d8\u05d9-\u05db\u05d5\u05dc\u05d9\u05e0\u05e8\u05d2\u05d9\u05d5\u05ea \u05d0\u05d5 \u05d4\u05d0\u05e0\u05d8\u05d9-\u05e0\u05d5\u05e8\u05d0\u05d3\u05e8\u05e0\u05e8\u05d2\u05d9\u05d5\u05ea \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d5\u05ea TCAs \u05d1\u05de\u05d9\u05e0\u05d5\u05df \u05e8\u05d2\u05d9\u05dc (StahlNeuro p. 426).",
      "hint": "\u05d6\u05d4\u05d5 \u05e7\u05d5\u05dc\u05d8\u05df \u05d4\u05d0\u05d7\u05e8\u05d0\u05d9 \u05e2\u05dc \u05de\u05e2\u05e8\u05db\u05ea \u05d4-Arousal \u05d4\u05de\u05e8\u05db\u05d6\u05d9\u05ea, \u05d5\u05d7\u05e1\u05d9\u05de\u05ea\u05d5 \u05d2\u05d5\u05e8\u05de\u05ea \u05dc\u05e1\u05d3\u05e6\u05d9\u05d4 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea."
    },
    {
      "type": "short_answer",
      "question": "\u05d9\u05dc\u05d3 \u05d1\u05df 8 \u05e2\u05dd Intellectual Developmental Disorder (ID) \u05d5-Autism Spectrum Disorder (ASD) \u05e1\u05d5\u05d1\u05dc \u05de\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05e9\u05d9\u05e0\u05d4 \u05e7\u05e9\u05d5\u05ea \u05d4\u05de\u05dc\u05d5\u05d5\u05ea \u05d1\u05d4\u05d7\u05de\u05e8\u05d4 \u05d1-Behavioral disturbances \u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05d9\u05d5\u05dd, \u05db\u05d5\u05dc\u05dc \u05e4\u05d2\u05d9\u05e2\u05d4 \u05e2\u05e6\u05de\u05d9\u05ea (Self-injury). \u05db\u05d9\u05e6\u05d3 \u05e2\u05e9\u05d5\u05d9 \u05de\u05ea\u05df Melatonin \u05dc\u05d4\u05e9\u05e4\u05d9\u05e2 \u05e2\u05dc \u05d4\u05ea\u05de\u05d5\u05e0\u05d4 \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05d4\u05db\u05d5\u05dc\u05dc\u05ea \u05de\u05e2\u05d1\u05e8 \u05dc\u05e9\u05d9\u05e4\u05d5\u05e8 \u05d4\u05e9\u05d9\u05e0\u05d4?",
      "grading": {
        "modelAnswer": "\u05de\u05ea\u05df Melatonin (\u05d1\u05de\u05d9\u05e0\u05d5\u05df $0.5-9\\text{ mg}$) \u05d4\u05d5\u05db\u05d7 \u05d1\u05de\u05d7\u05e7\u05e8\u05d9\u05dd \u05db\u05de\u05e4\u05d7\u05d9\u05ea Sleep latency \u05d5\u05de\u05e2\u05e8\u05d9\u05da \u05d0\u05ea \u05de\u05e9\u05da \u05d4\u05e9\u05d9\u05e0\u05d4 \u05d4\u05db\u05d5\u05dc\u05dc \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd \u05de\u05d5\u05d2\u05d1\u05dc\u05d5\u05ea \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9\u05ea. \u05e9\u05d9\u05e4\u05d5\u05e8 \u05d0\u05d9\u05db\u05d5\u05ea \u05d5\u05de\u05e9\u05da \u05d4\u05e9\u05d9\u05e0\u05d4 \u05e2\u05e9\u05d5\u05d9 \u05dc\u05d4\u05d5\u05d1\u05d9\u05dc \u05d1\u05d0\u05d5\u05e4\u05df \u05de\u05e9\u05e0\u05d9 \u05dc\u05e9\u05d9\u05e4\u05d5\u05e8 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9 \u05d1\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea\u05d9\u05d5\u05ea \u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05d9\u05d5\u05dd, \u05db\u05d5\u05dc\u05dc \u05d4\u05e4\u05d7\u05ea\u05d4 \u05d1\u05e0\u05d8\u05d9\u05d9\u05d4 \u05dc\u05e4\u05d2\u05d9\u05e2\u05d4 \u05e2\u05e6\u05de\u05d9\u05ea (Dulcan p. 471).",
        "rationale": "\u05d4\u05e7\u05e9\u05e8 \u05d1\u05d9\u05df \u05d7\u05e1\u05da \u05e9\u05d9\u05e0\u05d4 \u05dc\u05d4\u05d7\u05de\u05e8\u05d4 \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea\u05d9\u05ea \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd ID \u05d4\u05d5\u05d0 \u05d4\u05d3\u05d5\u05e7, \u05d5\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05e9\u05d9\u05e0\u05d4 \u05de\u05d4\u05d5\u05d5\u05d4 \u05d4\u05ea\u05e2\u05e8\u05d1\u05d5\u05ea \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea\u05d9\u05ea \u05e2\u05e7\u05d9\u05e4\u05d4 (Dulcan p. 471).",
        "requiredAttributes": [
          "\u05e6\u05d9\u05d5\u05df \u05d4\u05d9\u05e2\u05d9\u05dc\u05d5\u05ea \u05d1\u05e9\u05d9\u05e4\u05d5\u05e8 \u05de\u05d3\u05d3\u05d9 \u05e9\u05d9\u05e0\u05d4 (Latency/Duration) \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd ID/ASD.",
          "\u05d4\u05e1\u05d1\u05e8 \u05db\u05d9 \u05e9\u05d9\u05e4\u05d5\u05e8 \u05d4\u05e9\u05d9\u05e0\u05d4 \u05de\u05d5\u05d1\u05d9\u05dc \u05dc\u05e9\u05d9\u05e4\u05d5\u05e8 \u05d1\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d1\u05d9\u05d5\u05dd (Behavioral disturbances).",
          "\u05d0\u05d6\u05db\u05d5\u05e8 \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9 \u05e9\u05dc \u05d4\u05e4\u05d7\u05ea\u05d4 \u05d1-Self-injury \u05db\u05ea\u05d5\u05e6\u05d0\u05d4 \u05de\u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05e9\u05d9\u05e0\u05d4."
