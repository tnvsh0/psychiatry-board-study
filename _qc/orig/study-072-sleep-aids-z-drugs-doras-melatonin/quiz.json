    {
      "type": "multiple_select",
      "question": "\u05d1\u05e0\u05d9\u05d4\u05d5\u05dc \u05e7\u05dc\u05d9\u05e0\u05d9 \u05e9\u05dc Insomnia \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d5\u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd \u05d4\u05de\u05d0\u05d5\u05d1\u05d7\u05e0\u05d9\u05dd \u05e2\u05dd Attention-Deficit/Hyperactivity Disorder (ADHD), \u05d0\u05d9\u05dc\u05d5 \u05de\u05d4\u05e7\u05d1\u05d9\u05e2\u05d5\u05ea \u05d4\u05d1\u05d0\u05d5\u05ea \u05e0\u05ea\u05de\u05db\u05d5\u05ea \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d4\u05e1\u05e4\u05e8\u05d5\u05ea \u05d4\u05de\u05e7\u05e6\u05d5\u05e2\u05d9\u05ea?",
      "answerOptions": [
        {
          "text": "\u05d9\u05e9 \u05dc\u05ea\u05e2\u05d3 \u05d3\u05e4\u05d5\u05e1\u05d9 \u05e9\u05d9\u05e0\u05d4 \u05d1\u05e1\u05d9\u05e1\u05d9\u05d9\u05dd (Baseline sleep patterns) \u05dc\u05e4\u05e0\u05d9 \u05d4\u05ea\u05d7\u05dc\u05ea \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Stimulants (StahlKids p. 313).",
          "isCorrect": true,
          "rationale": "\u05ea\u05d9\u05e2\u05d5\u05d3 \u05de\u05d5\u05e7\u05d3\u05dd \u05d7\u05d9\u05d5\u05e0\u05d9 \u05db\u05d3\u05d9 \u05dc\u05d4\u05d1\u05d7\u05d9\u05df \u05d1\u05d9\u05df \u05d4\u05e4\u05e8\u05e2\u05ea \u05e9\u05d9\u05e0\u05d4 \u05e8\u05d0\u05e9\u05d5\u05e0\u05d9\u05ea \u05dc\u05d1\u05d9\u05df \u05ea\u05d5\u05e4\u05e2\u05ea \u05dc\u05d5\u05d5\u05d0\u05d9 \u05e9\u05dc \u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 \u05d0\u05d5 Rebound effect (StahlKids p. 313)."
        },
        {
          "text": "\u05de\u05ea\u05df Eszopiclone \u05d1\u05de\u05d9\u05e0\u05d5\u05e0\u05d9\u05dd \u05e9\u05dc \u05e2\u05d3 $3\\text{ mg}$ \u05d4\u05d5\u05db\u05d7 \u05db\u05d9\u05e2\u05d9\u05dc \u05d1\u05d4\u05e4\u05d7\u05ea\u05ea Sleep onset latency \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd ADHD (Dulcan p. 483).",
          "isCorrect": false,
          "rationale": "\u05d1\u05e0\u05d9\u05e1\u05d5\u05d9\u05d9\u05dd \u05e7\u05dc\u05d9\u05e0\u05d9\u05d9\u05dd (\u05db\u05d2\u05d5\u05df Zammit et al. 2012), Eszopiclone \u05e0\u05db\u05e9\u05dc \u05d1\u05d4\u05e4\u05d7\u05ea\u05ea \u05d6\u05de\u05df \u05d4\u05d4\u05d9\u05e8\u05d3\u05de\u05d5\u05ea \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d5\u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd \u05e2\u05dd ADHD \u05dc\u05de\u05e8\u05d5\u05ea \u05e1\u05d1\u05d9\u05dc\u05d5\u05ea \u05d8\u05d5\u05d1\u05d4 (Dulcan p. 483)."
        },
        {
          "text": "\u05e0\u05d3\u05d5\u05d3\u05d9 \u05e9\u05d9\u05e0\u05d4 \u05d4\u05de\u05d5\u05e4\u05d9\u05e2\u05d9\u05dd \u05d1\u05e9\u05e2\u05d5\u05ea \u05d4\u05d1\u05d5\u05e7\u05e8 \u05d4\u05de\u05d5\u05e7\u05d3\u05de\u05d5\u05ea \u05e2\u05e9\u05d5\u05d9\u05d9\u05dd \u05dc\u05e0\u05d1\u05d5\u05e2 \u05de\u05e8\u05de\u05d5\u05ea \u05d3\u05dd \u05e0\u05de\u05d5\u05db\u05d5\u05ea \u05de\u05d3\u05d9 \u05e9\u05dc \u05d4-Stimulant (Withdrawal/Rebound) \u05d5\u05dc\u05d0\u05d5 \u05d3\u05d5\u05d5\u05e7\u05d0 \u05de\u05e2\u05d5\u05d3\u05e3 \u05e1\u05d8\u05d9\u05de\u05d5\u05dc\u05e6\u05d9\u05d4 (StahlKids p. 313).",
          "isCorrect": true,
          "rationale": "\u05d9\u05e8\u05d9\u05d3\u05d4 \u05d7\u05d3\u05d4 \u05d1\u05e8\u05de\u05d5\u05ea \u05d4\u05e1\u05d8\u05d9\u05de\u05d5\u05dc\u05e0\u05d8 \u05d1\u05d1\u05d5\u05e7\u05e8 \u05e2\u05dc\u05d5\u05dc\u05d4 \u05dc\u05d2\u05e8\u05d5\u05dd \u05dc-ADHD rebound \u05d4\u05de\u05e7\u05e9\u05d4 \u05e2\u05dc \u05d7\u05d6\u05e8\u05d4 \u05dc\u05e9\u05d9\u05e0\u05d4 (StahlKids p. 313)."
        },
        {
          "text": "Zolpidem \u05d1\u05de\u05d9\u05e0\u05d5\u05df $0.25\\text{ mg/kg}$ \u05e0\u05de\u05e6\u05d0 \u05db\u05d9\u05e2\u05d9\u05dc \u05d5\u05d1\u05d8\u05d5\u05d7 \u05dc\u05e9\u05d9\u05de\u05d5\u05e9 \u05d0\u05e8\u05d5\u05da \u05d8\u05d5\u05d5\u05d7 \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd ADHD (Dulcan p. 483).",
          "isCorrect": false,
          "rationale": "\u05d1\u05de\u05d7\u05e7\u05e8 \u05e9\u05dc Blumer et al. (2009), Zolpidem \u05e0\u05db\u05e9\u05dc \u05d1\u05e9\u05d9\u05e4\u05d5\u05e8 \u05de\u05d3\u05d3\u05d9 \u05e9\u05d9\u05e0\u05d4 \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd ADHD \u05de\u05e2\u05d1\u05e8 \u05dc\u05e4\u05dc\u05e6\u05d1\u05d5 (Dulcan p. 483)."
        }
      ],
      "hint": "\u05d1\u05d7\u05df \u05d0\u05ea \u05ea\u05d5\u05e6\u05d0\u05d5\u05ea \u05d4\u05e0\u05d9\u05e1\u05d5\u05d9\u05d9\u05dd \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9\u05d9\u05dd \u05d1-Z-drugs \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd ADHD \u05d5\u05d0\u05ea \u05d7\u05e9\u05d9\u05d1\u05d5\u05ea \u05d4-Baseline.",
      "hasAllOfTheAbove": false,
