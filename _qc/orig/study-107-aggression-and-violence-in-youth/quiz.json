    {
      "type": "multiple_choice",
      "question": "\u05dc\u05e4\u05d9 \u05d4-Dulcan (\u05e4\u05e8\u05e7 47), \u05de\u05d4\u05d5 \u05d4\u05e9\u05dc\u05d1 \u05d4\u05e8\u05d0\u05e9\u05d5\u05df \u05d5\u05d4\u05d7\u05e9\u05d5\u05d1 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d1\u05e4\u05e8\u05d5\u05d8\u05d5\u05e7\u05d5\u05dc \u05d4\u05e2\u05e8\u05db\u05ea \u05d0\u05d9\u05d5\u05dd (Threat Assessment) \u05d1\u05d1\u05d9\u05ea \u05d4\u05e1\u05e4\u05e8 \u05dc\u05d0\u05d7\u05e8 \u05e9\u05ea\u05dc\u05de\u05d9\u05d3 \u05d4\u05e9\u05de\u05d9\u05e2 \u05d0\u05d9\u05d5\u05dd?",
      "answerOptions": [
        {
          "text": "\u05d4\u05e2\u05e8\u05db\u05ea \u05d4\u05d0\u05d9\u05d5\u05dd \u05d1\u05d0\u05de\u05e6\u05e2\u05d5\u05ea \u05e8\u05d0\u05d9\u05d5\u05df \u05d4\u05de\u05e2\u05d5\u05e8\u05d1\u05d9\u05dd \u05db\u05d3\u05d9 \u05dc\u05d4\u05d1\u05d7\u05d9\u05df \u05d1\u05d9\u05df \u05d0\u05d9\u05d5\u05dd \u05d7\u05d5\u05dc\u05e3 (Transient) \u05dc\u05d0\u05d9\u05d5\u05dd \u05de\u05d4\u05d5\u05ea\u05d9 (Substantive).",
          "isCorrect": true,
          "rationale": "\u05e8\u05d5\u05d1 \u05d4\u05d0\u05d9\u05d5\u05de\u05d9\u05dd \u05d1\u05d1\u05d9\u05ea \u05d4\u05e1\u05e4\u05e8 \u05d4\u05dd \u05d7\u05d5\u05dc\u05e4\u05d9\u05dd (\u05d1\u05d9\u05d8\u05d5\u05d9 \u05dc\u05db\u05e2\u05e1 \u05dc\u05dc\u05d0 \u05db\u05d5\u05d5\u05e0\u05d4); \u05d6\u05d9\u05d4\u05d5\u05d9 \u05de\u05d5\u05e7\u05d3\u05dd \u05e9\u05dc\u05d4\u05dd \u05de\u05d5\u05e0\u05e2 \u05d4\u05e9\u05e2\u05d9\u05d5\u05ea \u05de\u05d9\u05d5\u05ea\u05e8\u05d5\u05ea (Dulcan p.1063)."
        },
        {
          "text": "\u05d4\u05e9\u05e2\u05d9\u05d4 \u05de\u05d9\u05d9\u05d3\u05d9\u05ea \u05e9\u05dc \u05d4\u05ea\u05dc\u05de\u05d9\u05d3 \u05d5\u05d3\u05d9\u05d5\u05d5\u05d7 \u05dc\u05de\u05e9\u05d8\u05e8\u05d4 \u05dc\u05dc\u05d0 \u05e7\u05e9\u05e8 \u05dc\u05e0\u05e1\u05d9\u05d1\u05d5\u05ea.",
          "isCorrect": false,
          "rationale": "\u05e4\u05e8\u05d5\u05d8\u05d5\u05e7\u05d5\u05dc \u05d4-Virginia Guidelines \u05de\u05de\u05dc\u05d9\u05e5 \u05e7\u05d5\u05d3\u05dd \u05dc\u05d4\u05e2\u05e8\u05d9\u05da \u05d0\u05ea \u05d4\u05db\u05d5\u05d5\u05e0\u05d4 \u05d5\u05d4\u05e0\u05e1\u05d9\u05d1\u05d5\u05ea \u05dc\u05e4\u05e0\u05d9 \u05e0\u05e7\u05d9\u05d8\u05ea \u05e6\u05e2\u05d3\u05d9 \u05e2\u05e0\u05d9\u05e9\u05d4 (Dulcan p.1063)."
        },
        {
          "text": "\u05d1\u05d9\u05e6\u05d5\u05e2 \u05de\u05d1\u05d7\u05e0\u05d9 \u05d0\u05d9\u05e9\u05d9\u05d5\u05ea \u05e4\u05e8\u05d5\u05d9\u05e7\u05d8\u05d9\u05d1\u05d9\u05d9\u05dd \u05dc\u05ea\u05dc\u05de\u05d9\u05d3 \u05d1\u05d9\u05d5\u05dd \u05d4\u05d0\u05d9\u05e8\u05d5\u05e2.",
          "isCorrect": false,
          "rationale": "\u05de\u05d1\u05d7\u05e0\u05d9\u05dd \u05e4\u05e8\u05d5\u05d9\u05e7\u05d8\u05d9\u05d1\u05d9\u05d9\u05dd \u05d0\u05d9\u05e0\u05dd \u05d7\u05dc\u05e7 \u05de\u05d4\u05e4\u05e8\u05d5\u05d8\u05d5\u05e7\u05d5\u05dc \u05d4\u05de\u05d9\u05d9\u05d3\u05d9 \u05dc\u05d4\u05e2\u05e8\u05db\u05ea \u05d0\u05d9\u05d5\u05dd \u05d1\u05d1\u05d9\u05ea \u05d4\u05e1\u05e4\u05e8 (Dulcan p.1063, p.1064)."
        },
        {
          "text": "\u05d4\u05e4\u05e0\u05d9\u05d9\u05d4 \u05de\u05d9\u05d9\u05d3\u05d9\u05ea \u05dc\u05d0\u05e9\u05e4\u05d5\u05d6 \u05d9\u05d5\u05dd \u05dc\u05d4\u05e2\u05e8\u05db\u05ea \u05de\u05e1\u05d5\u05db\u05e0\u05d5\u05ea.",
          "isCorrect": false,
          "rationale": "\u05d4\u05e2\u05e8\u05db\u05d4 \u05e8\u05d0\u05e9\u05d5\u05e0\u05d9\u05ea \u05de\u05ea\u05d1\u05e6\u05e2\u05ea \u05e2\u05dc \u05d9\u05d3\u05d9 \u05e6\u05d5\u05d5\u05ea \u05d1\u05d9\u05ea \u05d4\u05e1\u05e4\u05e8; \u05e8\u05e7 \u05d0\u05d9\u05d5\u05de\u05d9\u05dd \u05de\u05d4\u05d5\u05ea\u05d9\u05d9\u05dd \u05d5\u05e8\u05e6\u05d9\u05e0\u05d9\u05d9\u05dd \u05d3\u05d5\u05e8\u05e9\u05d9\u05dd \u05d4\u05e2\u05e8\u05db\u05ea \u05d1\u05d8\u05d9\u05d7\u05d5\u05ea \u05e0\u05e4\u05e9\u05d9\u05ea \u05de\u05e2\u05de\u05d9\u05e7\u05d4 (Dulcan p.1063)."
        }
      ],
      "hint": "\u05d4\u05d4\u05d1\u05d7\u05e0\u05d4 \u05d4\u05de\u05e8\u05db\u05d6\u05d9\u05ea \u05d4\u05d9\u05d0 \u05d1\u05d9\u05df \u05d0\u05d9\u05d5\u05dd \u05e9\u05d4\u05d5\u05d0 '\u05d1\u05d9\u05d8\u05d5\u05d9 \u05e9\u05dc \u05db\u05e2\u05e1' \u05dc\u05d1\u05d9\u05df \u05d0\u05d9\u05d5\u05dd \u05e2\u05dd '\u05db\u05d5\u05d5\u05e0\u05d4 \u05dc\u05e4\u05d2\u05d5\u05e2'.",
