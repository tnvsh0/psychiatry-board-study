    {
      "type": "multiple_select",
      "question": "\u05dc\u05e4\u05d9 \u05d4-DSM-5-TR, \u05de\u05d4\u05dd \u05d4\u05ea\u05e0\u05d0\u05d9\u05dd \u05d4\u05de\u05d1\u05d3\u05d9\u05dc\u05d9\u05dd \u05d1\u05d9\u05df \u05d0\u05d1\u05d7\u05e0\u05ea Disruptive Mood Dysregulation Disorder (DMDD) \u05dc\u05d1\u05d9\u05df Oppositional Defiant Disorder (ODD)?",
      "answerOptions": [
        {
          "text": "\u05d0\u05dd \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05e2\u05d5\u05e0\u05d4 \u05dc\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05e9\u05dc \u05e9\u05ea\u05d9 \u05d4\u05d0\u05d1\u05d7\u05e0\u05d5\u05ea, \u05ea\u05d9\u05e0\u05ea\u05df \u05e8\u05e7 \u05d0\u05d1\u05d7\u05e0\u05ea DMDD.",
          "isCorrect": true,
          "rationale": "\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df J \u05d1-DSM \u05e7\u05d5\u05d1\u05e2 \u05e9\u05d0\u05d1\u05d7\u05e0\u05ea DMDD \u05d2\u05d5\u05d1\u05e8\u05ea \u05e2\u05dc ODD \u05d1\u05de\u05e7\u05e8\u05d4 \u05e9\u05dc \u05d7\u05e4\u05d9\u05e4\u05d4 (DSM p.182)."
        },
        {
          "text": "DMDD \u05d3\u05d5\u05e8\u05e9\u05ea \u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05e9\u05dc \u05de\u05e6\u05d1 \u05e8\u05d5\u05d7 \u05d0\u05d9\u05e8\u05d9\u05d8\u05d1\u05d9\u05dc\u05d9 \u05e7\u05d1\u05d5\u05e2 \u05d1\u05d9\u05df \u05d4\u05ea\u05e4\u05e8\u05e6\u05d5\u05d9\u05d5\u05ea \u05d4\u05d6\u05e2\u05dd, \u05d1\u05e9\u05d5\u05e0\u05d4 \u05de-ODD.",
          "isCorrect": true,
          "rationale": "\u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05e9\u05dc DMDD \u05d4\u05d5\u05d0 \u05de\u05e6\u05d1 \u05e8\u05d5\u05d7 \u05db\u05e2\u05d5\u05e1/\u05d0\u05d9\u05e8\u05d9\u05d8\u05d1\u05d9\u05dc\u05d9 \u05e8\u05d5\u05d1 \u05d4\u05d9\u05d5\u05dd, \u05db\u05de\u05e2\u05d8 \u05db\u05dc \u05d9\u05d5\u05dd, \u05d1\u05d9\u05df \u05d4\u05d4\u05ea\u05e4\u05e8\u05e6\u05d5\u05d9\u05d5\u05ea (DSM p.182)."
        },
        {
          "text": "\u05d0\u05d1\u05d7\u05e0\u05ea DMDD \u05d0\u05d9\u05e0\u05d4 \u05d9\u05db\u05d5\u05dc\u05d4 \u05dc\u05d4\u05d9\u05e0\u05ea\u05df \u05d9\u05d7\u05d3 \u05e2\u05dd ADHD, \u05d1\u05e2\u05d5\u05d3 \u05e9-ODD \u05db\u05df.",
          "isCorrect": false,
          "rationale": "\u05e0\u05d9\u05ea\u05df \u05dc\u05ea\u05ea DMDD \u05db\u05e7\u05d5\u05de\u05d5\u05e8\u05d1\u05d9\u05d3\u05d9\u05d5\u05ea \u05e2\u05dd ADHD, Major Depressive Disorder \u05d5-Anxiety Disorders (DSM p.182)."
        },
        {
          "text": "\u05d4\u05ea\u05e4\u05e8\u05e6\u05d5\u05d9\u05d5\u05ea \u05d4\u05d6\u05e2\u05dd \u05d1-DMDD \u05d7\u05d9\u05d9\u05d1\u05d5\u05ea \u05dc\u05d4\u05ea\u05e8\u05d7\u05e9 \u05dc\u05e4\u05d7\u05d5\u05ea 3 \u05e4\u05e2\u05de\u05d9\u05dd \u05d1\u05e9\u05d1\u05d5\u05e2 \u05d1\u05de\u05de\u05d5\u05e6\u05e2.",
          "isCorrect": true,
          "rationale": "\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df C \u05d1-DMDD \u05d3\u05d5\u05e8\u05e9 \u05ea\u05d3\u05d9\u05e8\u05d5\u05ea \u05e9\u05dc 3 \u05e4\u05e2\u05de\u05d9\u05dd \u05d1\u05e9\u05d1\u05d5\u05e2 \u05d5\u05de\u05e2\u05dc\u05d4 (DSM p.182)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d1\u05d5 \u05e2\u05dc \u05db\u05dc\u05dc\u05d9 \u05d4'\u05d4\u05d9\u05e8\u05e8\u05db\u05d9\u05d4' \u05d4\u05d0\u05d1\u05d7\u05e0\u05ea\u05d9\u05ea \u05d5\u05e2\u05dc \u05de\u05e9\u05da \u05d5\u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9 \u05de\u05e6\u05d1 \u05d4\u05e8\u05d5\u05d7 \u05d1\u05d9\u05df \u05d4\u05d4\u05ea\u05e4\u05e8\u05e6\u05d5\u05d9\u05d5\u05ea.",
      "hasAllOfTheAbove": false,
      "hasNoneOfTheAbove": false
    },
    {
      "type": "fill_in_the_blank",
      "question": "\u05db\u05dc\u05d9 \u05d4\u05d4\u05e2\u05e8\u05db\u05d4 \u05d4\u05de\u05d5\u05d1\u05e0\u05d4 \u05d4\u05de\u05d5\u05de\u05dc\u05e5 \u05d1-Dulcan \u05dc\u05d4\u05e2\u05e8\u05db\u05ea \u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05d0\u05dc\u05d9\u05de\u05d5\u05ea \u05d1\u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd, \u05d4\u05de\u05e7\u05d9\u05e3 24 \u05d2\u05d5\u05e8\u05de\u05d9 \u05e1\u05d9\u05db\u05d5\u05df (\u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d9\u05dd, \u05d7\u05d1\u05e8\u05ea\u05d9\u05d9\u05dd \u05d5\u05d3\u05d9\u05e0\u05de\u05d9\u05d9\u05dd) \u05d5-6 \u05d2\u05d5\u05e8\u05de\u05d9 \u05d4\u05d2\u05e0\u05d4, \u05e0\u05e7\u05e8\u05d0 ___.",
      "bestAnswer": "SAVRY",
      "acceptableAnswers": [
        "Structured Assessment of Violence Risk in Youth"
      ],
      "rationale": "\u05d4-SAVRY \u05d4\u05d5\u05d0 \u05d4\u05de\u05d3\u05e8\u05d9\u05da \u05d4\u05de\u05d5\u05d1\u05e0\u05d4 \u05d4\u05de\u05d5\u05d1\u05d9\u05dc \u05dc\u05d4\u05e2\u05e8\u05db\u05ea \u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05d0\u05dc\u05d9\u05de\u05d5\u05ea \u05d1\u05e7\u05e8\u05d1 \u05e0\u05d5\u05e2\u05e8, \u05d4\u05de\u05e9\u05dc\u05d1 \u05d2\u05d5\u05e8\u05de\u05d9 \u05e1\u05d9\u05db\u05d5\u05df \u05d5\u05d4\u05d2\u05e0\u05d4 (Dulcan p.1065).",
      "hint": "\u05e8\u05d0\u05e9\u05d9 \u05ea\u05d9\u05d1\u05d5\u05ea \u05e9\u05dc Structured Assessment of Violence Risk in Youth."
    },
    {
      "type": "multiple_choice",
      "question": "\u05de\u05ea\u05d1\u05d2\u05e8\u05ea \u05e2\u05dd Conduct Disorder \u05de\u05e4\u05d2\u05d9\u05e0\u05d4 \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d0\u05d2\u05e8\u05e1\u05d9\u05d1\u05d9\u05ea \u05de\u05ea\u05d5\u05db\u05e0\u05e0\u05ea (Proactive Aggression) \u05d4\u05db\u05d5\u05dc\u05dc\u05ea \u05d1\u05e8\u05d9\u05d5\u05e0\u05d5\u05ea \u05db\u05dc\u05e4\u05d9 \u05ea\u05dc\u05de\u05d9\u05d3\u05d9\u05dd \u05e6\u05e2\u05d9\u05e8\u05d9\u05dd \u05dc\u05e9\u05dd \u05d4\u05e9\u05d2\u05ea \u05db\u05d5\u05d7 \u05d7\u05d1\u05e8\u05ea\u05d9. \u05dc\u05e4\u05d9 Dulcan, \u05de\u05d4\u05d9 \u05d4\u05d4\u05ea\u05e2\u05e8\u05d1\u05d5\u05ea \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc\u05d9\u05ea \u05d1\u05e2\u05dc\u05ea \u05d4\u05e4\u05e8\u05d5\u05d2\u05e0\u05d5\u05d6\u05d4 \u05d4\u05d8\u05d5\u05d1\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05de\u05e7\u05e8\u05d4 \u05d6\u05d4?",
      "answerOptions": [
        {
          "text": "\u05ea\u05d5\u05db\u05e0\u05d9\u05d5\u05ea \u05e8\u05d1-\u05de\u05e2\u05e8\u05db\u05ea\u05d9\u05d5\u05ea \u05db\u05de\u05d5 Multisystemic Therapy (MST) \u05d5\u05e9\u05d9\u05e0\u05d5\u05d9 \u05de\u05d1\u05e0\u05d9 \u05e1\u05d1\u05d9\u05d1\u05ea\u05d9.",
          "isCorrect": true,
          "rationale": "\u05d0\u05d2\u05e8\u05e1\u05d9\u05d4 \u05e4\u05e8\u05d5\u05d0\u05e7\u05d8\u05d9\u05d1\u05d9\u05ea \u05db\u05de\u05e2\u05d8 \u05d0\u05d9\u05e0\u05d4 \u05de\u05d2\u05d9\u05d1\u05d4 \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05ea\u05e8\u05d5\u05e4\u05ea\u05d9 \u05d5\u05d3\u05d5\u05e8\u05e9\u05ea \u05d4\u05ea\u05e2\u05e8\u05d1\u05d5\u05d9\u05d5\u05ea \u05d0\u05d9\u05e0\u05d8\u05e0\u05e1\u05d9\u05d1\u05d9\u05d5\u05ea \u05d1\u05de\u05e2\u05e8\u05db\u05d5\u05ea \u05d4\u05d7\u05d9\u05d9\u05dd \u05e9\u05dc \u05d4\u05e0\u05e2\u05e8 (Dulcan p.215, p.594)."
        },
        {
          "text": "\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Lithium Carbonate \u05dc\u05d4\u05e4\u05d7\u05ea\u05ea \u05d4\u05d0\u05d9\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05d5\u05ea.",
          "isCorrect": false,
          "rationale": "\u05dc\u05d9\u05ea\u05d9\u05d5\u05dd \u05d5\u05d8\u05d9\u05e4\u05d5\u05dc\u05d9\u05dd \u05ea\u05e8\u05d5\u05e4\u05ea\u05d9\u05d9\u05dd \u05d0\u05d7\u05e8\u05d9\u05dd \u05d9\u05e2\u05d9\u05dc\u05d9\u05dd \u05d1\u05e2\u05d9\u05e7\u05e8 \u05dc\u05d0\u05d2\u05e8\u05e1\u05d9\u05d4 \u05d0\u05d9\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05ea/\u05ea\u05d2\u05d5\u05d1\u05ea\u05d9\u05ea, \u05dc\u05d0 \u05e4\u05e8\u05d5\u05d0\u05e7\u05d8\u05d9\u05d1\u05d9\u05ea (Dulcan p.594, p.597)."
        },
        {
          "text": "\u05d8\u05d9\u05e4\u05d5\u05dc \u05e7\u05e6\u05e8 \u05de\u05d5\u05e2\u05d3 \u05d1\u05e1\u05d2\u05e0\u05d5\u05df 'Scared Straight' \u05dc\u05d4\u05e8\u05ea\u05e2\u05d4.",
          "isCorrect": false,
          "rationale": "\u05ea\u05d5\u05db\u05e0\u05d9\u05d5\u05ea \u05d4\u05e8\u05ea\u05e2\u05d4 \u05e7\u05e6\u05e8\u05d5\u05ea (\u05db\u05de\u05d5 'Shock') \u05d4\u05d5\u05db\u05d7\u05d5 \u05db\u05dc\u05d0 \u05d9\u05e2\u05d9\u05dc\u05d5\u05ea \u05d5\u05d0\u05e3 \u05e2\u05dc\u05d5\u05dc\u05d5\u05ea \u05dc\u05d4\u05d7\u05de\u05d9\u05e8 \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d0\u05e0\u05d8\u05d9\u05e1\u05d5\u05e6\u05d9\u05d0\u05dc\u05d9\u05ea (Dulcan p.215)."
        },
        {
          "text": "\u05de\u05ea\u05df \u05e1\u05d8\u05d9\u05de\u05d5\u05dc\u05e0\u05d8\u05d9\u05dd \u05d1\u05de\u05d9\u05e0\u05d5\u05df \u05d2\u05d1\u05d5\u05d4 \u05dc\u05e9\u05d9\u05e4\u05d5\u05e8 \u05d4\u05e8\u05d9\u05db\u05d5\u05d6 \u05d1\u05db\u05d9\u05ea\u05d4.",
          "isCorrect": false,
          "rationale": "\u05e1\u05d8\u05d9\u05de\u05d5\u05dc\u05e0\u05d8\u05d9\u05dd \u05e2\u05d5\u05d6\u05e8\u05d9\u05dd \u05dc\u05d0\u05d2\u05e8\u05e1\u05d9\u05d4 \u05d4\u05e7\u05e9\u05d5\u05e8\u05d4 \u05dc-ADHD, \u05d0\u05da \u05d0\u05d9\u05e0\u05dd \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05d1\u05d1\u05e8\u05d9\u05d5\u05e0\u05d5\u05ea \u05e4\u05e8\u05d5\u05d0\u05e7\u05d8\u05d9\u05d1\u05d9\u05ea \u05de\u05ea\u05d5\u05db\u05e0\u05e0\u05ea (Dulcan p.597)."
        }
      ],
      "hint": "\u05d6\u05db\u05e8\u05d5 \u05e9\u05e1\u05d5\u05d2 \u05d6\u05d4 \u05e9\u05dc \u05d0\u05d2\u05e8\u05e1\u05d9\u05d4 \u05d4\u05d5\u05d0 '\u05d7\u05e1\u05d9\u05df' \u05d9\u05d7\u05e1\u05d9\u05ea \u05dc\u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05d5\u05d3\u05d5\u05e8\u05e9 \u05de\u05e2\u05d8\u05e4\u05ea \u05e1\u05d1\u05d9\u05d1\u05ea\u05d9\u05ea \u05e8\u05d7\u05d1\u05d4.",
      "imageUrls": []
    },
    {
      "type": "short_answer",
      "question": "\u05ea\u05d0\u05e8 \u05d0\u05ea \u05d7\u05d5\u05d1\u05ea \u05d4\u05ea\u05d9\u05e2\u05d5\u05d3 \u05d5\u05d4\u05e0\u05d9\u05d8\u05d5\u05e8 \u05d4\u05e0\u05d3\u05e8\u05e9\u05ea \u05dc\u05e4\u05d9 Dulcan \u05d1\u05e2\u05ea \u05d1\u05d9\u05e6\u05d5\u05e2 \u05d4\u05d2\u05d1\u05dc\u05d4 \u05e4\u05d9\u05d6\u05d9\u05ea (Physical Restraint) \u05e9\u05dc \u05e7\u05d8\u05d9\u05df \u05d1\u05de\u05d7\u05dc\u05e7\u05d4 \u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9\u05ea.",
      "grading": {
        "modelAnswer": "\u05d7\u05d5\u05d1\u05ea \u05d4\u05ea\u05d9\u05e2\u05d5\u05d3 \u05db\u05d5\u05dc\u05dc\u05ea \u05d4\u05d5\u05e8\u05d0\u05d4 \u05e8\u05e4\u05d5\u05d0\u05d9\u05ea \u05de\u05d5\u05d2\u05d1\u05dc\u05ea \u05d1\u05d6\u05de\u05df, \u05d1\u05d3\u05d9\u05e7\u05d4 \u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05e4\u05e8\u05d5\u05e0\u05d8\u05dc\u05d9\u05ea \u05e9\u05dc \u05e8\u05d5\u05e4\u05d0 \u05ea\u05d5\u05da \u05d6\u05de\u05df \u05e7\u05e6\u05e8, \u05d5\u05e0\u05d9\u05d8\u05d5\u05e8 \u05e8\u05e6\u05d9\u05e3 \u05e9\u05dc \u05de\u05d3\u05d3\u05d9\u05dd \u05d7\u05d9\u05d5\u05e0\u05d9\u05d9\u05dd (\u05d3\u05d5\u05e4\u05e7, \u05e0\u05e9\u05d9\u05de\u05d4). \u05d1\u05e0\u05d5\u05e1\u05e3, \u05d9\u05e9 \u05dc\u05ea\u05e2\u05d3 \u05d0\u05ea \u05d4\u05e1\u05d9\u05d1\u05d5\u05ea \u05dc\u05d4\u05d2\u05d1\u05dc\u05d4, \u05d0\u05ea \u05e0\u05e1\u05d9\u05d5\u05e0\u05d5\u05ea \u05d4\u05d3\u05d4-\u05d0\u05e1\u05e7\u05dc\u05e6\u05d9\u05d4 \u05e9\u05e0\u05db\u05e9\u05dc\u05d5, \u05d5\u05dc\u05e1\u05e4\u05e7 \u05de\u05e2\u05e0\u05d4 \u05dc\u05e6\u05e8\u05db\u05d9\u05dd \u05d1\u05e1\u05d9\u05e1\u05d9\u05d9\u05dd \u05d1\u05d6\u05de\u05df \u05d4\u05d4\u05d2\u05d1\u05dc\u05d4.",
        "rationale": "\u05d4\u05d2\u05d1\u05dc\u05d4 \u05e4\u05d9\u05d6\u05d9\u05ea \u05d4\u05d9\u05d0 \u05de\u05d5\u05e6\u05d0 \u05d0\u05d7\u05e8\u05d5\u05df \u05d4\u05de\u05d7\u05d9\u05d9\u05d1 \u05e8\u05d2\u05d5\u05dc\u05e6\u05d9\u05d4 \u05de\u05d7\u05de\u05d9\u05e8\u05d4 (CMS/Joint Commission) \u05db\u05d3\u05d9 \u05dc\u05de\u05e0\u05d5\u05e2 \u05d8\u05e8\u05d0\u05d5\u05de\u05d4 \u05d5\u05e4\u05e6\u05d9\u05e2\u05d4 (Dulcan p.215, p.611).",
        "requiredAttributes": [
          "\u05e6\u05d9\u05d5\u05df \u05d1\u05d3\u05d9\u05e7\u05d4 \u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05e4\u05e8\u05d5\u05e0\u05d8\u05dc\u05d9\u05ea \u05e9\u05dc \u05e8\u05d5\u05e4\u05d0.",
          "\u05e0\u05d9\u05d8\u05d5\u05e8 \u05de\u05d3\u05d3\u05d9\u05dd \u05d7\u05d9\u05d5\u05e0\u05d9\u05d9\u05dd (\u05d3\u05d5\u05e4\u05e7/\u05e0\u05e9\u05d9\u05de\u05d4).",
          "\u05ea\u05d9\u05e2\u05d5\u05d3 \u05e0\u05e1\u05d9\u05d5\u05e0\u05d5\u05ea \u05d3\u05d4-\u05d0\u05e1\u05e7\u05dc\u05e6\u05d9\u05d4 \u05e7\u05d5\u05d3\u05de\u05d9\u05dd.",
          "\u05d4\u05d5\u05e8\u05d0\u05d4 \u05e8\u05e4\u05d5\u05d0\u05d9\u05ea \u05de\u05d5\u05d2\u05d1\u05dc\u05ea \u05d1\u05d6\u05de\u05df."
        ],
        "errors": {
          "misconceptions": [
            "\u05d4\u05e0\u05d7\u05d4 \u05e9\u05e0\u05d9\u05ea\u05df \u05dc\u05ea\u05ea \u05d4\u05d5\u05e8\u05d0\u05d4 \u05d8\u05dc\u05e4\u05d5\u05e0\u05d9\u05ea \u05dc\u05dc\u05d0 \u05d1\u05d3\u05d9\u05e7\u05d4 \u05e4\u05d9\u05d6\u05d9\u05ea \u05d1\u05e4\u05e8\u05e7 \u05d6\u05de\u05df \u05de\u05d5\u05d2\u05d3\u05e8.",
            "\u05d7\u05d5\u05e1\u05e8 \u05e6\u05d5\u05e8\u05da \u05d1\u05e0\u05d9\u05d8\u05d5\u05e8 \u05e0\u05e9\u05d9\u05de\u05ea\u05d9 \u05d1\u05d6\u05de\u05df \u05e8\u05d9\u05e1\u05d5\u05df."
          ],
          "bluffs": [
            "\u05d0\u05de\u05d9\u05e8\u05d5\u05ea \u05db\u05dc\u05dc\u05d9\u05d5\u05ea \u05e2\u05dc '\u05e9\u05de\u05d9\u05e8\u05d4 \u05e2\u05dc \u05d1\u05d8\u05d9\u05d7\u05d5\u05ea' \u05dc\u05dc\u05d0 \u05e4\u05d9\u05e8\u05d5\u05d8 \u05e4\u05e8\u05d5\u05d8\u05d5\u05e7\u05d5\u05dc \u05d4\u05e0\u05d9\u05d8\u05d5\u05e8."
          ]
        }
      },
      "hint": "\u05d4\u05ea\u05de\u05e7\u05d3\u05d5 \u05d1\u05d3\u05e8\u05d9\u05e9\u05d5\u05ea \u05d4\u05e8\u05d2\u05d5\u05dc\u05d8\u05d5\u05e8\u05d9\u05d5\u05ea \u05e9\u05dc \u05d4-CMS \u05d5\u05d4-Joint Commission \u05dc\u05d2\u05d1\u05d9 \u05e0\u05d9\u05d8\u05d5\u05e8 \u05d1\u05d6\u05de\u05df \u05d0\u05de\u05ea.",
