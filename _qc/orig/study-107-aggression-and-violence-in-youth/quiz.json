    {
      "type": "multiple_choice",
      "question": "\u05d1\u05e0\u05d9\u05d4\u05d5\u05dc \u05d0\u05e7\u05d5\u05d8\u05d9 \u05e9\u05dc \u05d0\u05d2'\u05d9\u05d8\u05e6\u05d9\u05d4 \u05d1\u05d7\u05d3\u05e8 \u05de\u05d9\u05d5\u05df, \u05de\u05d4\u05d9 \u05d4\u05d0\u05d6\u05d4\u05e8\u05d4 \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05d4\u05d7\u05e9\u05d5\u05d1\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05e9\u05de\u05d5\u05e4\u05d9\u05e2\u05d4 \u05d1-Dulcan \u05d5\u05d1-StahlKids \u05dc\u05d2\u05d1\u05d9 \u05e9\u05d9\u05de\u05d5\u05e9 \u05d1-Olanzapine \u05d5-Benzodiazepines?",
      "answerOptions": [
        {
          "text": "\u05d0\u05d9\u05df \u05dc\u05ea\u05ea Olanzapine \u05d5-Benzodiazepines \u05d1\u05d4\u05d6\u05e8\u05e7\u05d4 (Parenteral) \u05ea\u05d5\u05da \u05e4\u05d7\u05d5\u05ea \u05de\u05e9\u05e2\u05d4 \u05d6\u05d4 \u05de\u05d6\u05d4 \u05de\u05d7\u05e9\u05e9 \u05dc\u05d3\u05d9\u05db\u05d5\u05d9 \u05e0\u05e9\u05d9\u05de\u05ea\u05d9.",
          "isCorrect": true,
          "rationale": "\u05de\u05ea\u05df \u05de\u05e9\u05d5\u05dc\u05d1 \u05e9\u05dc \u05e9\u05ea\u05d9 \u05d4\u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05d1\u05e6\u05d5\u05e8\u05d4 \u05e4\u05e8\u05e0\u05d8\u05e8\u05dc\u05d9\u05ea \u05de\u05e2\u05dc\u05d4 \u05e1\u05d9\u05db\u05d5\u05df \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9 \u05dc\u05d3\u05d9\u05db\u05d5\u05d9 \u05e0\u05e9\u05d9\u05de\u05ea\u05d9 \u05d5\u05e1\u05d3\u05e6\u05d9\u05d4 \u05e2\u05de\u05d5\u05e7\u05d4 (Dulcan p.612; StahlKids p.333)."
        },
        {
          "text": "\u05d4\u05e9\u05d9\u05dc\u05d5\u05d1 \u05d2\u05d5\u05e8\u05dd \u05dc\u05e1\u05d9\u05db\u05d5\u05df \u05de\u05d5\u05d2\u05d1\u05e8 \u05dc-Akathisia \u05e7\u05e9\u05d4 \u05d4\u05de\u05e4\u05d5\u05e8\u05e9\u05ea \u05d1\u05d8\u05e2\u05d5\u05ea \u05db\u05d4\u05d7\u05de\u05e8\u05ea \u05d4\u05d0\u05d2'\u05d9\u05d8\u05e6\u05d9\u05d4.",
          "isCorrect": false,
          "rationale": "\u05d0\u05de\u05e0\u05dd \u05d0\u05e7\u05ea\u05d9\u05d6\u05d9\u05d4 \u05d4\u05d9\u05d0 \u05e1\u05d9\u05db\u05d5\u05df \u05d1\u05d0\u05e0\u05d8\u05d9\u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9\u05dd, \u05d0\u05da \u05d4\u05d0\u05d6\u05d4\u05e8\u05d4 \u05d4\u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05ea \u05dc\u05e9\u05d9\u05dc\u05d5\u05d1 \u05d4\u05d9\u05d0 \u05d3\u05d9\u05db\u05d5\u05d9 \u05e0\u05e9\u05d9\u05de\u05ea\u05d9 (Dulcan p.611, p.612)."
        },
        {
          "text": "\u05d4\u05e9\u05d9\u05dc\u05d5\u05d1 \u05de\u05d1\u05d8\u05dc \u05d0\u05ea \u05d4\u05d9\u05e2\u05d9\u05dc\u05d5\u05ea \u05d4\u05d0\u05e0\u05d8\u05d9-\u05d0\u05d2\u05e8\u05e1\u05d9\u05d1\u05d9\u05ea \u05e9\u05dc \u05d4-Olanzapine \u05e2\u05e7\u05d1 \u05d0\u05d9\u05e0\u05d8\u05e8\u05d0\u05e7\u05e6\u05d9\u05d4 \u05d1\u05e7\u05d5\u05dc\u05d8\u05df $GABA_{A}$.",
          "isCorrect": false,
          "rationale": "\u05d0\u05d9\u05df \u05d0\u05d9\u05e0\u05d8\u05e8\u05d0\u05e7\u05e6\u05d9\u05d4 \u05d4\u05de\u05d1\u05d8\u05dc\u05ea \u05d9\u05e2\u05d9\u05dc\u05d5\u05ea; \u05d4\u05d1\u05e2\u05d9\u05d4 \u05d4\u05d9\u05d0 \u05e1\u05d9\u05e0\u05e8\u05d2\u05d9\u05d4 \u05e9\u05dc \u05ea\u05d5\u05e4\u05e2\u05d5\u05ea \u05dc\u05d5\u05d5\u05d0\u05d9 \u05de\u05e1\u05d5\u05db\u05e0\u05d5\u05ea (StahlKids p.333)."
        },
        {
          "text": "\u05e9\u05d9\u05dc\u05d5\u05d1 \u05d6\u05d4 \u05de\u05d5\u05ea\u05e8 \u05e8\u05e7 \u05d1\u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05e9\u05dc Delirium \u05e2\u05e7\u05d1 \u05d4\u05e8\u05e2\u05dc\u05ea \u05d0\u05dc\u05db\u05d5\u05d4\u05d5\u05dc.",
          "isCorrect": false,
          "rationale": "\u05dc\u05d4\u05d9\u05e4\u05da, \u05d1\u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05d4\u05e8\u05e2\u05dc\u05ea \u05d0\u05dc\u05db\u05d5\u05d4\u05d5\u05dc \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05d3\u05d9\u05db\u05d5\u05d9 \u05e0\u05e9\u05d9\u05de\u05ea\u05d9 \u05d1\u05e9\u05d9\u05dc\u05d5\u05d1 \u05d6\u05d4 \u05d2\u05d1\u05d5\u05d4 \u05e2\u05d5\u05d3 \u05d9\u05d5\u05ea\u05e8 (Dulcan p.612)."
        }
      ],
      "hint": "\u05d4\u05ea\u05de\u05e7\u05d3\u05d5 \u05d1\u05d1\u05d8\u05d9\u05d7\u05d5\u05ea \u05d4\u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05e0\u05e9\u05d9\u05de\u05ea\u05d9\u05ea \u05d1\u05e2\u05ea \u05e9\u05d9\u05dc\u05d5\u05d1 \u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05de\u05e8\u05d2\u05d9\u05e2\u05d5\u05ea.",
      "imageUrls": []
