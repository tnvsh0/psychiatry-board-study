    {
      "type": "multiple_choice",
      "question": "\u05e2\u05dc \u05de\u05e0\u05ea \u05dc\u05e7\u05d1\u05d5\u05e2 \u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc Schizoaffective Disorder \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR, \u05d0\u05d9\u05d6\u05d4 \u05ea\u05e0\u05d0\u05d9 \u05d7\u05d9\u05d9\u05d1 \u05dc\u05d4\u05ea\u05e7\u05d9\u05d9\u05dd \u05d1\u05e0\u05d5\u05d2\u05e2 \u05dc\u05e7\u05e9\u05e8 \u05e9\u05d1\u05d9\u05df \u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d4\u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9\u05d9\u05dd \u05dc\u05ea\u05e1\u05de\u05d9\u05e0\u05d9 \u05de\u05e6\u05d1 \u05d4\u05e8\u05d5\u05d7?",
      "answerOptions": [
        {
          "text": "\u05e7\u05d9\u05d5\u05dd \u05e9\u05dc Delusions \u05d0\u05d5 Hallucinations \u05dc\u05de\u05e9\u05da \u05e9\u05d1\u05d5\u05e2\u05d9\u05d9\u05dd \u05dc\u05e4\u05d7\u05d5\u05ea \u05dc\u05dc\u05d0 Mood episode \u05d1\u05d5\u05dc\u05d8.",
          "isCorrect": true,
          "rationale": "\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df C \u05d3\u05d5\u05e8\u05e9 \u05e7\u05d9\u05d5\u05dd \u05e9\u05dc \u05de\u05d7\u05e9\u05d1\u05d5\u05ea \u05e9\u05d5\u05d5\u05d0 \u05d0\u05d5 \u05d4\u05d6\u05d9\u05d5\u05ea \u05d1\u05de\u05e9\u05da \u05e9\u05d1\u05d5\u05e2\u05d9\u05d9\u05dd \u05dc\u05e4\u05d7\u05d5\u05ea \u05d1\u05d4\u05d9\u05e2\u05d3\u05e8 Major depressive \u05d0\u05d5 Manic episode \u05d1\u05de\u05d4\u05dc\u05da \u05db\u05dc \u05ea\u05e7\u05d5\u05e4\u05ea \u05d4\u05de\u05d7\u05dc\u05d4 (DSM p.121)."
        },
        {
          "text": "\u05d4\u05d5\u05e4\u05e2\u05d4 \u05e9\u05dc \u05ea\u05e1\u05de\u05d9\u05e0\u05d9 \u05de\u05e6\u05d1 \u05e8\u05d5\u05d7 \u05e8\u05e7 \u05d1\u05de\u05d4\u05dc\u05da \u05d4-Prodromal phase \u05e9\u05dc \u05d4\u05e1\u05db\u05d9\u05d6\u05d5\u05e4\u05e8\u05e0\u05d9\u05d4.",
          "isCorrect": false,
          "rationale": "\u05ea\u05e1\u05de\u05d9\u05e0\u05d9 \u05de\u05e6\u05d1 \u05d4\u05e8\u05d5\u05d7 \u05d7\u05d9\u05d9\u05d1\u05d9\u05dd \u05dc\u05d4\u05d5\u05e4\u05d9\u05e2 \u05d1\u05de\u05e7\u05d1\u05d9\u05dc \u05dc\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d4\u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9\u05d9\u05dd \u05e9\u05dc \u05d4-Active phase (DSM p.121)."
        },
        {
          "text": "\u05ea\u05e1\u05de\u05d9\u05e0\u05d9 \u05de\u05e6\u05d1 \u05d4\u05e8\u05d5\u05d7 \u05d7\u05d9\u05d9\u05d1\u05d9\u05dd \u05dc\u05d4\u05d5\u05d5\u05ea \u05e4\u05d7\u05d5\u05ea \u05de-20% \u05de\u05de\u05e9\u05da \u05d4\u05de\u05d7\u05dc\u05d4 \u05d4\u05db\u05d5\u05dc\u05dc.",
          "isCorrect": false,
          "rationale": "\u05dc\u05d4\u05e4\u05da, \u05ea\u05e1\u05de\u05d9\u05e0\u05d9 \u05de\u05e6\u05d1 \u05d4\u05e8\u05d5\u05d7 \u05d7\u05d9\u05d9\u05d1\u05d9\u05dd \u05dc\u05d4\u05d9\u05d5\u05ea \u05e0\u05d5\u05db\u05d7\u05d9\u05dd \u05d1\u05de\u05e8\u05d1\u05d9\u05ea (Majority) \u05de\u05e9\u05da \u05d4\u05de\u05d7\u05dc\u05d4 \u05d4\u05e4\u05e2\u05d9\u05dc \u05d5\u05d4\u05e9\u05d0\u05e8\u05d9\u05ea\u05d9 (DSM p.121)."
        },
        {
          "text": "\u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d4\u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9\u05d9\u05dd \u05de\u05d5\u05e4\u05d9\u05e2\u05d9\u05dd \u05d0\u05da \u05d5\u05e8\u05e7 \u05d1\u05d6\u05de\u05df \u05e9\u05d9\u05d0 \u05e9\u05dc Mood episode.",
          "isCorrect": false,
          "rationale": "\u05de\u05e6\u05d1 \u05d6\u05d4 \u05d9\u05db\u05d5\u05d5\u05df \u05dc\u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc Mood disorder with psychotic features \u05d5\u05dc\u05d0 \u05dc\u05d4\u05e4\u05e8\u05e2\u05d4 \u05e1\u05db\u05d9\u05d6\u05d5\u05d0\u05e4\u05e7\u05d8\u05d9\u05d1\u05d9\u05ea (DSM p.121)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d3\u05e8\u05d9\u05e9\u05ea \u05d4-DSM \u05dc\u05d6\u05de\u05df \u05d4\u05de\u05d9\u05e0\u05d9\u05de\u05dc\u05d9 \u05e9\u05d1\u05d5 \u05d4\u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d4 \u05d7\u05d9\u05d9\u05d1\u05ea \u05dc\u05d4\u05d5\u05e4\u05d9\u05e2 '\u05d1\u05e0\u05e4\u05e8\u05d3' \u05de\u05de\u05e6\u05d1 \u05d4\u05e8\u05d5\u05d7.",
      "imageUrls": []
    },
    {
      "type": "fill_in_the_blank",
      "question": "\u05d1\u05e2\u05ea \u05de\u05ea\u05df \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-___ \u05e2\u05d1\u05d5\u05e8 Schizophrenia \u05d1\u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd, \u05d7\u05d5\u05d1\u05d4 \u05dc\u05d4\u05e0\u05d7\u05d5\u05ea \u05d0\u05ea \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05dc\u05d9\u05d8\u05d5\u05dc \u05d0\u05ea \u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 \u05e2\u05dd \u05d0\u05e8\u05d5\u05d7\u05d4 \u05d4\u05de\u05db\u05d9\u05dc\u05d4 \u05dc\u05e4\u05d7\u05d5\u05ea 350 \u05e7\u05dc\u05d5\u05e8\u05d9\u05d5\u05ea \u05db\u05d3\u05d9 \u05dc\u05d4\u05d1\u05d8\u05d9\u05d7 Bioavailability \u05ea\u05e7\u05d9\u05e0\u05d4 (StahlKids p.301).",
      "bestAnswer": "Lurasidone",
