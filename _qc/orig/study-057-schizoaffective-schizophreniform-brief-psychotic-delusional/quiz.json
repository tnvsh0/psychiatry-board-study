        },
        {
          "text": "\u05d4\u05d9\u05e8\u05d9\u05d3\u05d4 \u05d1\u05e8\u05de\u05d5\u05ea \u05d4\u05e4\u05e8\u05d5\u05dc\u05e7\u05d8\u05d9\u05df \u05ea\u05d7\u05ea \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Risperidone.",
