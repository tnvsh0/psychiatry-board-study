    {
      "type": "short_answer",
      "question": "\u05ea\u05d0\u05e8 \u05d0\u05ea \u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9 \u05d4\u05ea\u05e4\u05e7\u05d5\u05d3 \u05d4\u05e4\u05e1\u05d9\u05db\u05d5\u05e1\u05d5\u05e6\u05d9\u05d0\u05dc\u05d9 \u05d1-Delusional Disorder \u05dc\u05e2\u05d5\u05de\u05ea Schizophrenia \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR.",
      "grading": {
        "modelAnswer": "\u05d1-Delusional Disorder, \u05e4\u05e8\u05d8 \u05dc\u05de\u05d7\u05e9\u05d1\u05d5\u05ea \u05d4\u05e9\u05d5\u05d5\u05d0 \u05e2\u05e6\u05de\u05df, \u05d4\u05ea\u05e4\u05e7\u05d5\u05d3 \u05d4\u05e4\u05e1\u05d9\u05db\u05d5\u05e1\u05d5\u05e6\u05d9\u05d0\u05dc\u05d9 \u05d0\u05d9\u05e0\u05d5 \u05e0\u05e4\u05d2\u05e2 \u05d1\u05d0\u05d5\u05e4\u05df \u05e0\u05d9\u05db\u05e8 \u05d5\u05d4\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d0\u05d9\u05e0\u05d4 \u05de\u05d5\u05d6\u05e8\u05d4 \u05d0\u05d5 \u05d7\u05e8\u05d9\u05d2\u05d4 \u05d1\u05d0\u05d5\u05e4\u05df \u05d1\u05d5\u05dc\u05d8. \u05d6\u05d0\u05ea \u05d1\u05e0\u05d9\u05d2\u05d5\u05d3 \u05dc-Schizophrenia, \u05e9\u05d1\u05d4 \u05e0\u05d3\u05e8\u05e9\u05ea \u05d9\u05e8\u05d9\u05d3\u05d4 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05d1\u05ea\u05e4\u05e7\u05d5\u05d3 (\u05d7\u05d1\u05e8\u05ea\u05d9, \u05ea\u05e2\u05e1\u05d5\u05e7\u05ea\u05d9 \u05d0\u05d5 \u05dc\u05d9\u05de\u05d5\u05d3\u05d9) \u05d5\u05e7\u05d9\u05d9\u05de\u05d9\u05dd \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e0\u05d5\u05e1\u05e4\u05d9\u05dd \u05db\u05de\u05d5 \u05d7\u05d5\u05e1\u05e8 \u05d0\u05e8\u05d2\u05d5\u05df \u05d0\u05d5 \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e9\u05dc\u05d9\u05dc\u05d9\u05d9\u05dd \u05e9\u05de\u05e9\u05e4\u05d9\u05e2\u05d9\u05dd \u05e2\u05dc \u05d4\u05ea\u05e0\u05d4\u05dc\u05d5\u05ea \u05d4\u05d9\u05d5\u05de\u05d9\u05d5\u05dd.",
        "rationale": "\u05d4\u05d4\u05d1\u05d7\u05e0\u05d4 \u05d4\u05de\u05e8\u05db\u05d6\u05d9\u05ea \u05d4\u05d9\u05d0 \u05e9\u05d9\u05de\u05d5\u05e8 \u05d4\u05ea\u05e4\u05e7\u05d5\u05d3 \u05d1-Delusional Disorder \u05dc\u05de\u05e8\u05d5\u05ea \u05e7\u05d9\u05d5\u05dd \u05de\u05d7\u05e9\u05d1\u05d5\u05ea \u05d4\u05e9\u05d5\u05d5\u05d0 (DSM p.104, p.113).",
        "requiredAttributes": [
          "\u05e6\u05d9\u05d5\u05df \u05e9\u05d4\u05ea\u05e4\u05e7\u05d5\u05d3 \u05d1-Delusional Disorder \u05d0\u05d9\u05e0\u05d5 \u05e4\u05d2\u05d5\u05e2 \u05d1\u05d0\u05d5\u05e4\u05df \u05e0\u05d9\u05db\u05e8 (Not markedly impaired).",
          "\u05e6\u05d9\u05d5\u05df \u05e9\u05d4\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d0\u05d9\u05e0\u05d4 \u05de\u05d5\u05d6\u05e8\u05d4 \u05d1\u05d0\u05d5\u05e4\u05df \u05d1\u05d5\u05dc\u05d8 \u05d1-Delusional Disorder.",
          "\u05d4\u05e9\u05d5\u05d5\u05d0\u05d4 \u05dc\u05d9\u05e8\u05d9\u05d3\u05d4 \u05d1\u05ea\u05e4\u05e7\u05d5\u05d3 \u05d4\u05e0\u05d3\u05e8\u05e9\u05ea \u05d1\u05d0\u05d1\u05d7\u05e0\u05ea Schizophrenia."
        ],
        "errors": {
          "misconceptions": [
            "\u05de\u05d7\u05e9\u05d1\u05d4 \u05e9\u05db\u05dc \u05e1\u05d5\u05d2\u05d9 \u05d4\u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d4 \u05d3\u05d5\u05e8\u05e9\u05d9\u05dd \u05d9\u05e8\u05d9\u05d3\u05d4 \u05d1\u05ea\u05e4\u05e7\u05d5\u05d3 \u05dc\u05e6\u05d5\u05e8\u05da \u05d0\u05d1\u05d7\u05e0\u05d4."
          ],
          "bluffs": [
