{
  "title": "Psychiatry Quiz",
  "questions": [
    {
      "question": "\u05ea\u05d9\u05e0\u05d5\u05e7 \u05d1\u05df 6 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05e0\u05d1\u05d3\u05e7 \u05d1\u05de\u05e8\u05e4\u05d0\u05d4. \u05d1\u05de\u05d4\u05dc\u05da \u05ea\u05e6\u05e4\u05d9\u05ea \u05d0\u05d9\u05e0\u05d8\u05e8\u05d0\u05e7\u05e6\u05d9\u05d4 \u05de\u05e1\u05d5\u05d2 still-face, \u05d4\u05d0\u05dd \u05de\u05e4\u05e1\u05d9\u05e7\u05d4 \u05dc\u05d4\u05d2\u05d9\u05d1 \u05dc\u05ea\u05d9\u05e0\u05d5\u05e7 \u05d5\u05e9\u05d5\u05de\u05e8\u05ea \u05e2\u05dc \u05d4\u05d1\u05e2\u05d4 \u05e0\u05d9\u05d8\u05e8\u05dc\u05d9\u05ea. \u05d4\u05ea\u05d9\u05e0\u05d5\u05e7 \u05de\u05e0\u05e1\u05d4 \u05d1\u05ea\u05d7\u05d9\u05dc\u05d4 \u05dc\u05de\u05e9\u05d5\u05da \u05d0\u05ea \u05ea\u05e9\u05d5\u05de\u05ea \u05dc\u05d1\u05d4 \u05d1\u05d0\u05de\u05e6\u05e2\u05d5\u05ea \u05e7\u05d5\u05dc\u05d5\u05ea \u05d5\u05d7\u05d9\u05d5\u05db\u05d9\u05dd, \u05d0\u05da \u05dc\u05d0\u05d7\u05e8 \u05d6\u05de\u05df \u05e7\u05e6\u05e8 \u05d4\u05d5\u05d0 \u05e0\u05e1\u05d5\u05d2, \u05e0\u05e8\u05d0\u05d4 \u05d1\u05de\u05e6\u05d5\u05e7\u05d4 \u05d5\u05de\u05e1\u05d9\u05d8 \u05d0\u05ea \u05de\u05d1\u05d8\u05d5. \u05de\u05d4\u05d9 \u05d4\u05de\u05e9\u05de\u05e2\u05d5\u05ea \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05e9\u05dc \u05ea\u05e6\u05e4\u05d9\u05ea \u05d6\u05d5 \u05dc\u05e4\u05d9 \u05d4\u05e1\u05e4\u05e8\u05d5\u05ea \u05d1\u05de\u05d7\u05d1\u05e8\u05ea?",
      "answerOptions": [
        {
          "text": "\u05de\u05d3\u05d5\u05d1\u05e8 \u05d1\u05ea\u05d2\u05d5\u05d1\u05d4 \u05e0\u05d5\u05e8\u05de\u05d8\u05d9\u05d1\u05d9\u05ea \u05d4\u05de\u05e2\u05d9\u05d3\u05d4 \u05e2\u05dc \u05d9\u05db\u05d5\u05dc\u05d5\u05ea \u05d5\u05d9\u05e1\u05d5\u05ea \u05d4\u05d3\u05d3\u05d9\u05d5\u05ea (Mutual regulatory capacities) \u05d5\u05e0\u05d9\u05e1\u05d9\u05d5\u05df \u05dc\u05ea\u05d9\u05e7\u05d5\u05df \u05d4\u05d0\u05d9\u05e0\u05d8\u05e8\u05d0\u05e7\u05e6\u05d9\u05d4 (Dulcan p. 32).",
          "isCorrect": true,
          "rationale": "\u05d4\u05e4\u05e8\u05d5\u05e6\u05d3\u05d5\u05e8\u05d4 \u05d1\u05d5\u05d7\u05e0\u05ea \u05d5\u05d9\u05e1\u05d5\u05ea \u05e8\u05d2\u05e9\u05d9 \u05d3\u05d9\u05d0\u05d3\u05d9, \u05d5\u05ea\u05d2\u05d5\u05d1\u05ea \u05d4\u05ea\u05d9\u05e0\u05d5\u05e7 \u05dc\u05e9\u05d9\u05e0\u05d5\u05d9 \u05d1\u05e8\u05de\u05ea \u05d4-Engagement \u05e9\u05dc \u05d4\u05d4\u05d5\u05e8\u05d4 \u05de\u05e9\u05e7\u05e4\u05ea \u05d0\u05ea \u05d9\u05db\u05d5\u05dc\u05ea \u05d4\u05d5\u05d5\u05d9\u05e1\u05d5\u05ea \u05e9\u05dc\u05d5."
        },
        {
          "text": "\u05ea\u05d2\u05d5\u05d1\u05d4 \u05d6\u05d5 \u05de\u05e2\u05d9\u05d3\u05d4 \u05d1\u05d4\u05db\u05e8\u05d7 \u05e2\u05dc Maternal depression \u05d5\u05e2\u05dc \u05e1\u05d9\u05db\u05d5\u05df \u05d2\u05d1\u05d5\u05d4 \u05dc-Insecure attachment \u05d1\u05e2\u05ea\u05d9\u05d3 (Dulcan p. 32).",
          "isCorrect": false,
          "rationale": "\u05d0\u05e3 \u05e2\u05dc \u05e4\u05d9 \u05e9\u05d9\u05e9 \u05e7\u05e9\u05e8 \u05dc\u05d9\u05d9\u05e6\u05d5\u05d2\u05d9\u05dd \u05d0\u05d9\u05de\u05d4\u05d9\u05d9\u05dd, \u05d4\u05ea\u05d2\u05d5\u05d1\u05d4 \u05d4\u05de\u05ea\u05d5\u05d0\u05e8\u05ea \u05d4\u05d9\u05d0 \u05d7\u05dc\u05e7 \u05de\u05d4\u05e4\u05e8\u05d5\u05d8\u05d5\u05e7\u05d5\u05dc \u05d4\u05e0\u05d5\u05e8\u05de\u05d8\u05d9\u05d1\u05d9 \u05e9\u05dc \u05d4\u05e0\u05d9\u05e1\u05d5\u05d9 \u05d5\u05dc\u05d0 \u05d0\u05d1\u05d7\u05e0\u05d4 \u05e1\u05d5\u05e4\u05d9\u05ea \u05e9\u05dc \u05d3\u05d9\u05db\u05d0\u05d5\u05df."
        },
        {
          "text": "\u05d6\u05d5\u05d4\u05d9 \u05e2\u05d3\u05d5\u05ea \u05de\u05d5\u05e7\u05d3\u05de\u05ea \u05dc-Autism Spectrum Disorder \u05d1\u05e9\u05dc \u05d4\u05d9\u05e2\u05d3\u05e8 \u05d5\u05d9\u05e1\u05d5\u05ea \u05e2\u05e6\u05de\u05d9 \u05d0\u05dc \u05de\u05d5\u05dc \u05d2\u05d9\u05e8\u05d5\u05d9 \u05e0\u05d9\u05d8\u05e8\u05dc\u05d9 (Dulcan p. 32).",
          "isCorrect": false,
          "rationale": "\u05d4\u05e4\u05e8\u05d5\u05e6\u05d3\u05d5\u05e8\u05d4 \u05de\u05d9\u05d5\u05e2\u05d3\u05ea \u05dc\u05d4\u05e2\u05e8\u05db\u05ea \u05e7\u05e9\u05e8 \u05d5\u05e8\u05d2\u05e9 \u05d3\u05d9\u05d0\u05d3\u05d9, \u05d5\u05dc\u05d0 \u05db\u05db\u05dc\u05d9 \u05d0\u05d1\u05d7\u05e0\u05ea\u05d9 \u05e8\u05d0\u05e9\u05d5\u05e0\u05d9 \u05dc-ASD \u05d1\u05e9\u05dc\u05d1 \u05d6\u05d4."
        },
        {
          "text": "\u05e0\u05e1\u05d9\u05d2\u05ea \u05d4\u05ea\u05d9\u05e0\u05d5\u05e7 \u05de\u05e2\u05d9\u05d3\u05d4 \u05e2\u05dc \u05d8\u05de\u05e4\u05e8\u05de\u05e0\u05d8 \u05de\u05e1\u05d5\u05d2 Inhibition to novelty disorder \u05db\u05d1\u05e8 \u05d1\u05d2\u05d9\u05dc \u05d6\u05d4 (Dulcan p. 21).",
          "isCorrect": false,
          "rationale": "\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d6\u05d5 \u05d1-DC:0-5 \u05de\u05ea\u05d9\u05d9\u05d7\u05e1\u05ea \u05dc\u05ea\u05d2\u05d5\u05d1\u05d4 \u05dc\u05d2\u05d9\u05e8\u05d5\u05d9\u05d9\u05dd \u05d7\u05d3\u05e9\u05d9\u05dd \u05d5\u05dc\u05d0 \u05dc\u05d0\u05d5\u05d1\u05d3\u05df Engagement \u05d1\u05ea\u05d5\u05da \u05e7\u05e9\u05e8 \u05e7\u05d9\u05d9\u05dd."
        }
      ],
      "hint": "\u05d4\u05ea\u05de\u05e7\u05d3\u05d5 \u05d1\u05de\u05d5\u05e9\u05d2 \u05e9\u05dc \u05d5\u05d9\u05e1\u05d5\u05ea \u05e8\u05d2\u05e9\u05d9 \u05d4\u05d3\u05d3\u05d9 (Dyadic emotional regulation) \u05d5\u05d4\u05ea\u05d2\u05d5\u05d1\u05d4 \u05d4\u05de\u05e6\u05d5\u05e4\u05d4 \u05d1\u05ea\u05d9\u05e0\u05d5\u05e7\u05d5\u05ea \u05d1\u05e8\u05d9\u05d0\u05d9\u05dd \u05dc\u05de\u05e6\u05d1\u05d9 \u05dc\u05d7\u05e5 \u05e7\u05dc\u05d9\u05dd \u05d1\u05d0\u05d9\u05e0\u05d8\u05e8\u05d0\u05e7\u05e6\u05d9\u05d4."
    },
    {
      "question": "\u05e4\u05e2\u05d5\u05d8 \u05d1\u05df 22 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05de\u05d5\u05d1\u05d0 \u05dc\u05d4\u05e2\u05e8\u05db\u05d4 \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9\u05ea. \u05d1\u05d1\u05d3\u05d9\u05e7\u05d4 \u05e0\u05e6\u05e4\u05d4 \u05db\u05d9 \u05d4\u05d5\u05d0 \u05de\u05e9\u05d7\u05e7 \u05d1\u05e7\u05d5\u05d1\u05d9\u05d5\u05ea, \u05de\u05e2\u05de\u05d9\u05d3 \u05d0\u05d5\u05ea\u05df \u05d0\u05d7\u05ea \u05e2\u05dc \u05d4\u05e9\u05e0\u05d9\u05d9\u05d4 \u05db\u05e8\u05db\u05d1\u05ea \u05d5\u05de\u05e1\u05d9\u05e2 \u05d0\u05d5\u05ea\u05df \u05ea\u05d5\u05da \u05d4\u05e9\u05de\u05e2\u05ea \u05e7\u05d5\u05dc\u05d5\u05ea '\u05d8\u05d5-\u05d8\u05d5'. \u05db\u05d0\u05e9\u05e8 \u05de\u05e6\u05d9\u05e2\u05d9\u05dd \u05dc\u05d5 \u05d1\u05d5\u05d1\u05d4, \u05d4\u05d5\u05d0 \u05de\u05e0\u05e1\u05d4 '\u05dc\u05d4\u05d0\u05db\u05d9\u05dc' \u05d0\u05d5\u05ea\u05d4 \u05d1\u05e2\u05d6\u05e8\u05ea \u05db\u05e3 \u05e8\u05d9\u05e7\u05d4. \u05db\u05d9\u05e6\u05d3 \u05ea\u05e1\u05d5\u05d5\u05d2 \u05d0\u05ea \u05e1\u05d5\u05d2 \u05d4\u05de\u05e9\u05d7\u05e7 (Play type) \u05e9\u05dc \u05d4\u05e4\u05e2\u05d5\u05d8?",
      "answerOptions": [
        {
          "text": "Early symbolic play (Dulcan p. 43).",
          "isCorrect": true,
          "rationale": "\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05d7\u05e4\u05e5 \u05d0\u05d7\u05d3 \u05dc\u05d9\u05d9\u05e6\u05d5\u05d2 \u05d0\u05d7\u05e8 (\u05e7\u05d5\u05d1\u05d9\u05d4 \u05db\u05e8\u05db\u05d1\u05ea) \u05d5\u05d4\u05ea\u05d7\u05dc\u05ea \u05e4\u05e2\u05d5\u05dc\u05d5\u05ea '\u05db\u05d0\u05d9\u05dc\u05d5' \u05e2\u05dc \u05d0\u05d7\u05e8\u05d9\u05dd (\u05d4\u05d0\u05db\u05dc\u05ea \u05d1\u05d5\u05d1\u05d4) \u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9\u05dd \u05e9\u05dc\u05d1 \u05d6\u05d4 \u05e9\u05de\u05ea\u05d7\u05d9\u05dc \u05e1\u05d1\u05d9\u05d1 \u05d2\u05d9\u05dc 18 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd."
        },
        {
          "text": "Functional play (Dulcan p. 43).",
          "isCorrect": false,
          "rationale": "\u05de\u05e9\u05d7\u05e7 \u05e4\u05d5\u05e0\u05e7\u05e6\u05d9\u05d5\u05e0\u05dc\u05d9 \u05de\u05ea\u05de\u05e7\u05d3 \u05d1\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05d7\u05e4\u05e6\u05d9\u05dd \u05dc\u05de\u05d8\u05e8\u05ea\u05dd \u05d4\u05de\u05e7\u05d5\u05e8\u05d9\u05ea (\u05db\u05de\u05d5 \u05dc\u05d3\u05d7\u05d5\u05e3 \u05de\u05db\u05d5\u05e0\u05d9\u05ea), \u05d1\u05e2\u05d5\u05d3 \u05e9\u05db\u05d0\u05df \u05d9\u05e9 \u05d0\u05dc\u05de\u05e0\u05d8 \u05e9\u05dc \u05d9\u05d9\u05e6\u05d5\u05d2 \u05e1\u05d9\u05de\u05d1\u05d5\u05dc\u05d9."
        },
        {
          "text": "Complex symbolic play (Dulcan p. 43).",
          "isCorrect": false,
          "rationale": "\u05e9\u05dc\u05d1 \u05d6\u05d4 \u05de\u05d5\u05e4\u05d9\u05e2 \u05dc\u05e8\u05d5\u05d1 \u05de\u05d2\u05d9\u05dc 30 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05d5\u05de\u05e2\u05dc\u05d4 \u05d5\u05db\u05d5\u05dc\u05dc \u05e2\u05dc\u05d9\u05dc\u05d5\u05ea \u05de\u05d5\u05e8\u05db\u05d1\u05d5\u05ea \u05d5\u05d0\u05e8\u05d2\u05d5\u05df \u05dc\u05d5\u05d2\u05d9 \u05e2\u05de\u05d5\u05e7 \u05d9\u05d5\u05ea\u05e8 \u05e9\u05dc \u05ea\u05de\u05d5\u05ea \u05d4\u05de\u05e9\u05d7\u05e7."
        },
        {
          "text": "Sensorimotor play II (Dulcan p. 43).",
          "isCorrect": false,
          "rationale": "\u05e9\u05dc\u05d1 \u05d6\u05d4 \u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05d2\u05d9\u05dc\u05d0\u05d9 6-12 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05d5\u05de\u05ea\u05de\u05e7\u05d3 \u05d1\u05d7\u05e7\u05d9\u05e8\u05ea \u05ea\u05db\u05d5\u05e0\u05d5\u05ea \u05d4\u05d7\u05e4\u05e5 (\u05dc\u05d3\u05e4\u05d5\u05e7, \u05dc\u05d6\u05e8\u05d5\u05e7) \u05d5\u05dc\u05d0 \u05d1\u05d9\u05d9\u05e6\u05d5\u05d2 \u05de\u05e0\u05d8\u05dc\u05d9."
        }
      ],
      "hint": "\u05d7\u05e9\u05d1\u05d5 \u05e2\u05dc \u05d4\u05de\u05e2\u05d1\u05e8 \u05d1\u05d9\u05df \u05d7\u05e7\u05d9\u05e8\u05d4 \u05e4\u05d9\u05d6\u05d9\u05ea \u05e9\u05dc \u05d7\u05e4\u05e6\u05d9\u05dd \u05dc\u05d1\u05d9\u05df \u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05d4\u05dd \u05dc\u05d9\u05d9\u05e6\u05d5\u05d2 \u05e8\u05e2\u05d9\u05d5\u05e0\u05d5\u05ea \u05d0\u05d5 \u05e4\u05e2\u05d5\u05dc\u05d5\u05ea \u05de\u05d7\u05d9\u05d9 \u05d4\u05d9\u05d5\u05dd-\u05d9\u05d5\u05dd."
    },
    {
      "question": "\u05d1\u05d4\u05e2\u05e8\u05db\u05ea \u05ea\u05d9\u05e0\u05d5\u05e7 \u05d1\u05df 14 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd, \u05d4\u05d4\u05d5\u05e8\u05d9\u05dd \u05de\u05d3\u05d5\u05d5\u05d7\u05d9\u05dd \u05e2\u05dc '\u05d0\u05d9\u05d7\u05d5\u05e8 \u05e9\u05e4\u05ea\u05d9'. \u05d1\u05d1\u05d3\u05d9\u05e7\u05d4 \u05d4\u05e0\u05d5\u05d9\u05e8\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea \u05de\u05e6\u05d5\u05d9\u05df \u05db\u05d9 \u05e7\u05d9\u05d9\u05de\u05ea Hand dominance \u05d1\u05e8\u05d5\u05e8\u05d4 (\u05d4\u05e2\u05d3\u05e4\u05ea \u05d9\u05d3 \u05d9\u05de\u05d9\u05df). \u05dc\u05e4\u05d9 \u05d4-Dulcan Textbook, \u05de\u05d4\u05d9 \u05d4\u05de\u05e9\u05de\u05e2\u05d5\u05ea \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05e9\u05dc \u05de\u05de\u05e6\u05d0 \u05d6\u05d4 \u05d1\u05d2\u05d9\u05dc \u05d4\u05e0\u05d3\u05d5\u05df?",
      "answerOptions": [
        {
          "text": "\u05de\u05d3\u05d5\u05d1\u05e8 \u05d1\u05e1\u05d9\u05de\u05df \u05d0\u05d6\u05d4\u05e8\u05d4 (Red flag) \u05d4\u05e2\u05dc\u05d5\u05dc \u05dc\u05d4\u05e2\u05d9\u05d3 \u05e2\u05dc \u05d7\u05d5\u05dc\u05e9\u05d4 \u05e9\u05dc \u05d4\u05d2\u05e4\u05d4 \u05d4\u05e0\u05d2\u05d3\u05d9\u05ea (Contralateral extremity) (Dulcan p. 104).",
          "isCorrect": true,
          "rationale": "\u05d1\u05d9\u05e1\u05d5\u05e1 \u05d3\u05d5\u05de\u05d9\u05e0\u05e0\u05d8\u05d9\u05d5\u05ea \u05d9\u05d3\u05e0\u05d9\u05ea \u05dc\u05e4\u05e0\u05d9 \u05d2\u05d9\u05dc \u05e9\u05e0\u05d4 (\u05d0\u05d5 \u05d1\u05e9\u05dc\u05d1\u05d9\u05dd \u05de\u05d5\u05e7\u05d3\u05de\u05d9\u05dd \u05de\u05d0\u05d5\u05d3) \u05e0\u05d7\u05e9\u05d1 \u05dc\u05de\u05de\u05e6\u05d0 \u05d4\u05d3\u05d5\u05e8\u05e9 \u05d1\u05d9\u05e8\u05d5\u05e8 \u05dc\u05e9\u05dc\u05d9\u05dc\u05ea \u05d7\u05d5\u05dc\u05e9\u05d4 \u05de\u05d5\u05d8\u05d5\u05e8\u05d9\u05ea \u05e6\u05d3\u05d9\u05ea."
        },
        {
          "text": "\u05d6\u05d4\u05d5 \u05de\u05de\u05e6\u05d0 \u05e0\u05d5\u05e8\u05de\u05d8\u05d9\u05d1\u05d9 \u05d4\u05de\u05e6\u05d1\u05d9\u05e2 \u05e2\u05dc \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea \u05de\u05d5\u05d0\u05e6\u05ea \u05e9\u05dc \u05d4-Left hemisphere \u05d4\u05d0\u05d7\u05e8\u05d0\u05d9\u05ea \u05e2\u05dc \u05d4\u05e9\u05e4\u05d4 (Dulcan p. 29).",
          "isCorrect": false,
          "rationale": "\u05d3\u05d5\u05de\u05d9\u05e0\u05e0\u05d8\u05d9\u05d5\u05ea \u05d9\u05d3\u05e0\u05d9\u05ea \u05d0\u05d9\u05e0\u05d4 \u05e7\u05e9\u05d5\u05e8\u05d4 \u05d9\u05e9\u05d9\u05e8\u05d5\u05ea \u05dc\u05e7\u05e6\u05d1 \u05e8\u05db\u05d9\u05e9\u05ea \u05d4\u05e9\u05e4\u05d4 \u05d1\u05e9\u05dc\u05d1 \u05d6\u05d4 \u05d5\u05d0\u05d9\u05e0\u05d4 \u05e0\u05d7\u05e9\u05d1\u05ea \u05dc\u05d4\u05d9\u05e9\u05d2 \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9 \u05de\u05d5\u05e7\u05d3\u05dd \u05e8\u05e6\u05d5\u05d9."
        },
        {
          "text": "\u05de\u05de\u05e6\u05d0 \u05d6\u05d4 \u05de\u05d4\u05d5\u05d5\u05d4 \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df \u05d0\u05d1\u05d7\u05e0\u05ea\u05d9 \u05dc-Developmental Coordination Disorder (DCD) (DSM p. 85).",
          "isCorrect": false,
          "rationale": "\u05d0\u05d1\u05d7\u05e0\u05ea DCD \u05d3\u05d5\u05e8\u05e9\u05ea \u05e4\u05d2\u05d9\u05e2\u05d4 \u05d1\u05e8\u05db\u05d9\u05e9\u05ea \u05de\u05d9\u05d5\u05de\u05e0\u05d5\u05d9\u05d5\u05ea \u05de\u05d5\u05d8\u05d5\u05e8\u05d9\u05d5\u05ea \u05d5\u05dc\u05d0 \u05d4\u05e2\u05d3\u05e4\u05ea \u05e6\u05d3, \u05d5\u05d1\u05d3\u05e8\u05da \u05db\u05dc\u05dc \u05d0\u05d9\u05e0\u05d4 \u05de\u05d0\u05d5\u05d1\u05d7\u05e0\u05ea \u05d1\u05d2\u05d9\u05dc \u05db\u05d4 \u05e6\u05e2\u05d9\u05e8."
        },
        {
          "text": "\u05d6\u05d5\u05d4\u05d9 \u05ea\u05d5\u05e4\u05e2\u05d4 \u05e9\u05db\u05d9\u05d7\u05d4 \u05d1\u05ea\u05d9\u05e0\u05d5\u05e7\u05d5\u05ea \u05e2\u05dd Autism Spectrum Disorder \u05d4\u05e7\u05e9\u05d5\u05e8\u05d4 \u05dc\u05dc\u05d9\u05e7\u05d5\u05d9\u05d9 \u05d5\u05d9\u05e1\u05d5\u05ea (Dulcan p. 139).",
          "isCorrect": false,
          "rationale": "\u05d0\u05e3 \u05e9-ASD \u05db\u05d5\u05dc\u05dc \u05dc\u05d9\u05e7\u05d5\u05d9\u05d9\u05dd \u05de\u05d5\u05d8\u05d5\u05e8\u05d9\u05d9\u05dd, \u05d4\u05e2\u05d3\u05e4\u05ea \u05d9\u05d3 \u05de\u05d5\u05e7\u05d3\u05de\u05ea \u05d4\u05d9\u05d0 \u05e1\u05d9\u05de\u05df \u05e0\u05d5\u05d9\u05e8\u05d5\u05dc\u05d5\u05d2\u05d9 \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9 \u05d9\u05d5\u05ea\u05e8 \u05dc\u05d7\u05d5\u05dc\u05e9\u05d4 \u05d5\u05dc\u05d0 \u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05dc\u05d9\u05d1\u05d4 \u05e9\u05dc ASD."
        }
      ],
      "hint": "\u05d7\u05e9\u05d1\u05d5 \u05e2\u05dc \u05d4\u05e1\u05d9\u05de\u05d8\u05e8\u05d9\u05d4 \u05d4\u05de\u05e6\u05d5\u05e4\u05d4 \u05d1\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea \u05d4\u05de\u05d5\u05d8\u05d5\u05e8\u05d9\u05ea \u05d4\u05de\u05d5\u05e7\u05d3\u05de\u05ea \u05d5\u05de\u05d4 \u05d4\u05de\u05e9\u05de\u05e2\u05d5\u05ea \u05e9\u05dc \u05d0\u05e1\u05d9\u05de\u05d8\u05e8\u05d9\u05d4 \u05dc\u05e4\u05e0\u05d9 \u05e9\u05d4\u05de\u05e2\u05e8\u05db\u05ea \u05d0\u05de\u05d5\u05e8\u05d4 \u05dc\u05d4\u05d9\u05d5\u05ea \u05d1\u05e9\u05dc\u05d4 \u05dc\u05db\u05da."
    },
    {
      "question": "\u05d9\u05dc\u05d3 \u05d1\u05df 20 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05de\u05d5\u05d1\u05d0 \u05dc\u05d1\u05d3\u05d9\u05e7\u05d4 \u05d1\u05e9\u05dc \u05e7\u05e9\u05d9\u05d9 \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea. \u05d4\u05d5\u05d0 \u05d2\u05d3\u05dc \u05d1\u05de\u05d5\u05e1\u05d3\u05d5\u05ea \u05d1\u05e9\u05e0\u05d4 \u05d4\u05e8\u05d0\u05e9\u05d5\u05e0\u05d4 \u05dc\u05d7\u05d9\u05d9\u05d5 \u05d5\u05e2\u05d1\u05e8 \u05de\u05e1\u05e4\u05e8 \u05de\u05e9\u05e4\u05d7\u05d5\u05ea \u05d0\u05d5\u05de\u05e0\u05d4. \u05d4\u05de\u05d8\u05e4\u05dc\u05d9\u05dd \u05d4\u05e0\u05d5\u05db\u05d7\u05d9\u05d9\u05dd \u05de\u05d3\u05d5\u05d5\u05d7\u05d9\u05dd \u05db\u05d9 \u05d4\u05d5\u05d0 \u05e0\u05d9\u05d2\u05e9 \u05dc\u05d6\u05e8\u05d9\u05dd \u05de\u05d5\u05d7\u05dc\u05d8\u05d9\u05dd \u05dc\u05dc\u05d0 \u05db\u05dc \u05e8\u05ea\u05d9\u05e2\u05d4, \u05de\u05d7\u05d1\u05e7 \u05d0\u05d5\u05ea\u05dd \u05d5\u05de\u05d1\u05e7\u05e9 \u05de\u05d4\u05dd \u05dc\u05d4\u05e8\u05d9\u05de\u05d5. \u05d1\u05d1\u05d3\u05d9\u05e7\u05d4 \u05d4\u05d5\u05d0 \u05d0\u05d9\u05e0\u05d5 \u05d1\u05d5\u05d3\u05e7 \u05d0\u05ea \u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05d4\u05de\u05d8\u05e4\u05dc (Checking back) \u05d2\u05dd \u05d1\u05e1\u05d1\u05d9\u05d1\u05d4 \u05d6\u05e8\u05d4. \u05de\u05d4\u05d9 \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05e1\u05d1\u05d9\u05e8\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR?",
      "answerOptions": [
        {
          "text": "Disinhibited Social Engagement Disorder (DSED) (DSM p. 299).",
          "isCorrect": true,
          "rationale": "\u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4 \u05e9\u05dc \u05d4\u05d6\u05e0\u05d7\u05d4 \u05d7\u05d1\u05e8\u05ea\u05d9\u05ea, \u05d4\u05d9\u05e2\u05d3\u05e8 \u05e8\u05ea\u05d9\u05e2\u05d4 \u05de\u05d6\u05e8\u05d9\u05dd \u05d5\u05d4\u05d9\u05e2\u05d3\u05e8 Checking back \u05e2\u05dd \u05d4\u05de\u05d8\u05e4\u05dc \u05d4\u05dd \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9 \u05d4\u05dc\u05d9\u05d1\u05d4 \u05e9\u05dc DSED."
        },
        {
          "text": "Reactive Attachment Disorder (RAD) (DSM p. 295).",
          "isCorrect": false,
          "rationale": "RAD \u05de\u05ea\u05d0\u05e4\u05d9\u05d9\u05df \u05d1\u05e0\u05e1\u05d9\u05d2\u05d4 \u05e8\u05d2\u05e9\u05d9\u05ea \u05d5\u05d0\u05d9-\u05d7\u05d9\u05e4\u05d5\u05e9 \u05e0\u05d7\u05de\u05d4 \u05de\u05d4\u05de\u05d8\u05e4\u05dc, \u05d1\u05e0\u05d9\u05d2\u05d5\u05d3 \u05dc\u05de\u05d5\u05d7\u05e6\u05e0\u05d5\u05ea \u05d4\u05d7\u05d1\u05e8\u05ea\u05d9\u05ea \u05d4\u05d7\u05e8\u05d9\u05d2\u05d4 \u05d4\u05de\u05ea\u05d5\u05d0\u05e8\u05ea \u05db\u05d0\u05df."
        },
        {
          "text": "Attention-Deficit/Hyperactivity Disorder (ADHD), Predominantly Hyperactive/Impulsive Presentation (DSM p. 68).",
          "isCorrect": false,
          "rationale": "\u05d0\u05e3 \u05e9\u05d9\u05e9 \u05d0\u05dc\u05de\u05e0\u05d8 \u05e9\u05dc \u05d0\u05d9\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05d5\u05ea, \u05d4\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d4\u05de\u05ea\u05d5\u05d0\u05e8\u05ea \u05d4\u05d9\u05d0 \u05d7\u05d1\u05e8\u05ea\u05d9\u05ea-\u05d3\u05d9\u05e1\u05d0\u05d9\u05e0\u05d4\u05d9\u05d1\u05d9\u05d8\u05d5\u05e8\u05d9\u05ea \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05ea \u05d4\u05e0\u05d5\u05d1\u05e2\u05ea \u05de\u05d4\u05e7\u05e9\u05e8 \u05e9\u05dc \u05d4\u05d6\u05e0\u05d7\u05d4 \u05de\u05d5\u05e7\u05d3\u05de\u05ea."
        },
        {
          "text": "Autism Spectrum Disorder (ASD) (DSM p. 56).",
          "isCorrect": false,
          "rationale": "\u05d1-ASD \u05e0\u05e6\u05e4\u05d4 \u05d1\u05d3\u05e8\u05da \u05db\u05dc\u05dc \u05e7\u05d5\u05e9\u05d9 \u05d1\u05d9\u05e6\u05d9\u05e8\u05ea \u05e7\u05e9\u05e8 \u05d7\u05d1\u05e8\u05ea\u05d9 \u05d5\u05dc\u05d0 \u05e4\u05e0\u05d9\u05d9\u05d4 \u05de\u05d5\u05e4\u05e8\u05d6\u05ea \u05d5\u05d1\u05dc\u05ea\u05d9 \u05e1\u05dc\u05e7\u05d8\u05d9\u05d1\u05d9\u05ea \u05dc\u05d6\u05e8\u05d9\u05dd, \u05dc\u05e6\u05d3 \u05d3\u05e4\u05d5\u05e1\u05d9\u05dd \u05e8\u05e4\u05d8\u05d8\u05d9\u05d1\u05d9\u05d9\u05dd \u05e9\u05d0\u05d9\u05e0\u05dd \u05de\u05ea\u05d5\u05d0\u05e8\u05d9\u05dd \u05db\u05d0\u05df."
        }
      ],
      "hint": "\u05e9\u05d9\u05de\u05d5 \u05dc\u05d1 \u05dc\u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4 \u05e9\u05dc '\u05d8\u05d9\u05e4\u05d5\u05dc \u05d7\u05e1\u05e8' (Institutional care) \u05d5\u05dc\u05d3\u05e4\u05d5\u05e1 \u05d4\u05d7\u05d1\u05e8\u05ea\u05d9 \u05d4\u05d1\u05dc\u05ea\u05d9 \u05e1\u05dc\u05e7\u05d8\u05d9\u05d1\u05d9 \u05e9\u05d0\u05d9\u05e0\u05d5 \u05de\u05d5\u05d2\u05d1\u05dc \u05e8\u05e7 \u05dc\u05d0\u05d9\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05d5\u05ea \u05de\u05d5\u05d8\u05d5\u05e8\u05d9\u05ea."
    },
    {
      "question": "\u05dc\u05e4\u05d9 \u05d4\u05de\u05d5\u05d3\u05dc \u05e9\u05dc Bowlby \u05d5\u05d4\u05de\u05d7\u05e7\u05e8\u05d9\u05dd \u05d4\u05de\u05d5\u05e6\u05d2\u05d9\u05dd \u05d1-Dulcan, \u05de\u05d4\u05d5 \u05d4\u05de\u05de\u05e6\u05d0 \u05d4\u05de\u05e0\u05d1\u05d0 \u05d4\u05d7\u05d6\u05e7 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea \u05e8\u05d2\u05e9\u05d9\u05ea \u05ea\u05e7\u05d9\u05e0\u05d4 \u05d5\u05d7\u05d5\u05e1\u05df (Resilience) \u05d0\u05e6\u05dc \u05e4\u05e2\u05d5\u05d8\u05d5\u05ea \u05d0\u05dc \u05de\u05d5\u05dc \u05d2\u05d5\u05e8\u05de\u05d9 \u05d3\u05d7\u05e7?",
      "answerOptions": [
        {
          "text": "\u05d0\u05d9\u05db\u05d5\u05ea \u05d4\u05e7\u05e9\u05e8 \u05e2\u05dd \u05d4\u05de\u05d8\u05e4\u05dc \u05d4\u05e2\u05d9\u05e7\u05e8\u05d9 (Primary caregiving relationship) (Dulcan p. 18).",
          "isCorrect": true,
          "rationale": "\u05d4\u05e7\u05e9\u05e8 \u05d4\u05d3\u05d9\u05d0\u05d3\u05d9 \u05d5\u05d4-Secure attachment \u05d4\u05dd \u05d4\u05de\u05e0\u05d1\u05d0\u05d9\u05dd \u05d4\u05d7\u05d6\u05e7\u05d9\u05dd \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05ea\u05d5\u05e6\u05d0\u05d5\u05ea \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9\u05d5\u05ea \u05d7\u05d9\u05d5\u05d1\u05d9\u05d5\u05ea \u05d5\u05dc\u05d7\u05d5\u05e1\u05df \u05d1\u05e2\u05ea\u05d9\u05d3."
        },
        {
          "text": "\u05d4\u05d9\u05e9\u05d2\u05d9\u05dd \u05de\u05d5\u05d8\u05d5\u05e8\u05d9\u05d9\u05dd \u05de\u05d5\u05e7\u05d3\u05de\u05d9\u05dd, \u05db\u05d2\u05d5\u05df \u05d4\u05dc\u05d9\u05db\u05d4 \u05dc\u05e4\u05e0\u05d9 \u05d2\u05d9\u05dc 12 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd (Dulcan p. 29).",
          "isCorrect": false,
          "rationale": "\u05d4\u05d9\u05e9\u05d2\u05d9\u05dd \u05de\u05d5\u05d8\u05d5\u05e8\u05d9\u05d9\u05dd \u05de\u05e2\u05d9\u05d3\u05d9\u05dd \u05e2\u05dc \u05d4\u05d1\u05e9\u05dc\u05d4 \u05e0\u05d5\u05d9\u05e8\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea \u05d0\u05da \u05d0\u05d9\u05e0\u05dd \u05d4\u05de\u05e0\u05d1\u05d0 \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05dc\u05d7\u05d5\u05e1\u05df \u05e8\u05d2\u05e9\u05d9 \u05d0\u05d5 \u05d7\u05d1\u05e8\u05ea\u05d9."
        },
        {
          "text": "\u05d9\u05db\u05d5\u05dc\u05ea \u05d5\u05d9\u05e1\u05d5\u05ea \u05e2\u05e6\u05de\u05d9\u05ea (Self-regulation) \u05de\u05d5\u05dc\u05d3\u05ea \u05dc\u05dc\u05d0 \u05ea\u05dc\u05d5\u05ea \u05d1\u05ea\u05d2\u05d5\u05d1\u05ea \u05d4\u05e1\u05d1\u05d9\u05d1\u05d4 (Dulcan p. 25).",
          "isCorrect": false,
          "rationale": "\u05d5\u05d9\u05e1\u05d5\u05ea \u05e8\u05d2\u05e9\u05d9 \u05d1\u05d2\u05d9\u05dc \u05d4\u05e8\u05da \u05d4\u05d5\u05d0 \u05ea\u05d4\u05dc\u05d9\u05da \u05d3\u05d9\u05d0\u05d3\u05d9 \u05d1\u05e2\u05d9\u05e7\u05e8\u05d5 (Co-regulation), \u05d5\u05d4\u05ea\u05d9\u05e0\u05d5\u05e7 \u05ea\u05dc\u05d5\u05d9 \u05d1\u05de\u05d8\u05e4\u05dc \u05dc\u05e6\u05d5\u05e8\u05da \u05e8\u05db\u05d9\u05e9\u05ea \u05d9\u05db\u05d5\u05dc\u05d5\u05ea \u05d0\u05dc\u05d5."
        },
        {
          "text": "\u05d7\u05e9\u05d9\u05e4\u05d4 \u05de\u05d5\u05e7\u05d3\u05de\u05ea \u05dc\u05d2\u05d9\u05e8\u05d5\u05d9\u05d9\u05dd \u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9\u05d9\u05dd \u05de\u05e8\u05d5\u05d1\u05d9\u05dd \u05d1\u05d2\u05d9\u05dc 0-2 (Dulcan p. 17).",
          "isCorrect": false,
          "rationale": "\u05d1\u05e2\u05d5\u05d3 \u05e9\u05d2\u05d9\u05e8\u05d5\u05d9\u05d9\u05dd \u05d7\u05e9\u05d5\u05d1\u05d9\u05dd, \u05d4\u05e7\u05e9\u05e8 \u05d4\u05e8\u05d2\u05e9\u05d9 \u05d4\u05d5\u05d0 \u05d4\u05d1\u05e1\u05d9\u05e1 (Holding environment) \u05e9\u05d1\u05dc\u05e2\u05d3\u05d9\u05d5 \u05d4\u05d2\u05d9\u05e8\u05d5\u05d9\u05d9\u05dd \u05d0\u05d9\u05e0\u05dd \u05de\u05ea\u05d5\u05e8\u05d2\u05de\u05d9\u05dd \u05dc\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea \u05e8\u05d2\u05e9\u05d9\u05ea \u05d1\u05e8\u05d9\u05d0\u05d4."
        }
      ],
      "hint": "\u05d7\u05e9\u05d1\u05d5 \u05e2\u05dc \u05d4\u05ea\u05d9\u05d0\u05d5\u05e8\u05d9\u05d5\u05ea \u05d4\u05de\u05d3\u05d2\u05d9\u05e9\u05d5\u05ea \u05d0\u05ea \u05d4'\u05d9\u05d7\u05d9\u05d3\u05d4' (The dyad) \u05db\u05de\u05e8\u05db\u05d9\u05d1 \u05d4\u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d1\u05ea\u05e6\u05e4\u05d9\u05ea \u05d5\u05d1\u05d4\u05e2\u05e8\u05db\u05d4 \u05d1\u05d2\u05d9\u05dc \u05d4\u05e8\u05da."
    },
    {
      "question": "\u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05e2\u05e8\u05db\u05ea \u05e4\u05e2\u05d5\u05d8 \u05d1\u05df 30 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd, \u05d4\u05de\u05d8\u05e4\u05dc\u05d9\u05dd \u05de\u05d3\u05d5\u05d5\u05d7\u05d9\u05dd \u05db\u05d9 \u05d4\u05d5\u05d0 '\u05ea\u05de\u05d9\u05d3 \u05e2\u05e6\u05d1\u05e0\u05d9', \u05e1\u05d5\u05d1\u05dc \u05de\u05d4\u05ea\u05e4\u05e8\u05e6\u05d5\u05d9\u05d5\u05ea \u05d6\u05e2\u05dd \u05ea\u05db\u05d5\u05e4\u05d5\u05ea \u05d5\u05ea\u05d5\u05e7\u05e4\u05e0\u05d5\u05ea. \u05d1\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05de\u05e2\u05e8\u05db\u05ea \u05d4-DC:0-5 \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05e0\u05d9\u05ea\u05e0\u05ea \u05d4\u05d9\u05d0 Disorder of dysregulated anger and aggression of early childhood. \u05de\u05d4\u05d5 \u05d4-Crosswalk \u05d4\u05de\u05e7\u05d1\u05d9\u05dc \u05d1-DSM-5-TR (\u05dc\u05de\u05e8\u05d5\u05ea \u05de\u05d2\u05d1\u05dc\u05d5\u05ea \u05d4\u05d2\u05d9\u05dc)?",
      "answerOptions": [
        {
          "text": "Disruptive Mood Dysregulation Disorder (DMDD) (Dulcan p. 21, Table 2-1).",
          "isCorrect": true,
          "rationale": "\u05d4\u05d8\u05d1\u05dc\u05d4 \u05d1-Dulcan \u05de\u05e6\u05d9\u05d9\u05e0\u05ea \u05d1\u05de\u05e4\u05d5\u05e8\u05e9 \u05d0\u05ea DMDD \u05db\u05d4\u05e7\u05d1\u05dc\u05d4 \u05dc-Disorder of dysregulated anger \u05d1-DC:0-5."
        },
        {
          "text": "Oppositional Defiant Disorder (ODD) (DSM p. 522).",
          "isCorrect": false,
          "rationale": "\u05d0\u05e3 \u05e9\u05d9\u05e9 \u05d3\u05de\u05d9\u05d5\u05df \u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d8\u05d9, DMDD \u05de\u05ea\u05de\u05e7\u05d3 \u05d1\u05d5\u05d9\u05e1\u05d5\u05ea \u05d4\u05e8\u05d2\u05e9\u05d9 (Irritability) \u05d1\u05d3\u05d5\u05de\u05d4 \u05dc\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d1-DC:0-5."
        },
        {
          "text": "Intermittent Explosive Disorder (IED) (DSM p. 527).",
          "isCorrect": false,
          "rationale": "IED \u05de\u05d0\u05d5\u05e4\u05d9\u05d9\u05df \u05d1\u05d4\u05ea\u05e4\u05e8\u05e6\u05d5\u05d9\u05d5\u05ea \u05d3\u05d7\u05e4\u05d9\u05d5\u05ea \u05d0\u05e4\u05d9\u05d6\u05d5\u05d3\u05d9\u05d5\u05ea \u05d5\u05dc\u05d0 \u05d1\u05de\u05e6\u05d1 \u05e8\u05d5\u05d7 \u05e2\u05e6\u05d1\u05e0\u05d9 \u05db\u05e8\u05d5\u05e0\u05d9 \u05d5\u05de\u05ea\u05de\u05e9\u05da \u05d1\u05d9\u05df \u05d4\u05d4\u05ea\u05e4\u05e8\u05e6\u05d5\u05d9\u05d5\u05ea."
        },
        {
          "text": "Major Depressive Disorder (MDD) (DSM p. 183).",
          "isCorrect": false,
          "rationale": "MDD \u05d9\u05db\u05d5\u05dc \u05dc\u05db\u05dc\u05d5\u05dc \u05e2\u05e6\u05d1\u05e0\u05d5\u05ea \u05d0\u05e6\u05dc \u05d9\u05dc\u05d3\u05d9\u05dd, \u05d0\u05da \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05ea \u05dc\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05e9\u05dc \u05db\u05e2\u05e1 \u05d5\u05ea\u05d5\u05e7\u05e4\u05e0\u05d5\u05ea \u05d1\u05d9\u05dc\u05d3\u05d5\u05ea \u05d4\u05de\u05d5\u05e7\u05d3\u05de\u05ea \u05d1-DC:0-5 \u05de\u05e7\u05d1\u05d9\u05dc\u05d4 \u05dc-DMDD."
        }
      ],
      "hint": "\u05d7\u05e4\u05e9\u05d5 \u05d0\u05ea \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d1-DSM-5 \u05e9\u05d4\u05d5\u05db\u05e0\u05e1\u05d4 \u05d1\u05de\u05d8\u05e8\u05d4 \u05dc\u05ea\u05ea \u05de\u05e2\u05e0\u05d4 \u05dc\u05e2\u05e6\u05d1\u05e0\u05d5\u05ea \u05db\u05e8\u05d5\u05e0\u05d9\u05ea \u05d5\u05d4\u05ea\u05e4\u05e8\u05e6\u05d5\u05d9\u05d5\u05ea \u05d6\u05e2\u05dd \u05d0\u05e6\u05dc \u05d9\u05dc\u05d3\u05d9\u05dd."
    },
    {
      "question": "\u05de\u05d4\u05d9 \u05d0\u05d1\u05df \u05d4\u05d3\u05e8\u05da \u05d4\u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9\u05ea \u05d4\u05de\u05e6\u05d5\u05e4\u05d4 \u05de\u05ea\u05d9\u05e0\u05d5\u05e7 \u05e2\u05d3 \u05d2\u05d9\u05dc 12 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd, \u05d4\u05de\u05d4\u05d5\u05d5\u05d4 \u05d1\u05e1\u05d9\u05e1 \u05e7\u05e8\u05d9\u05d8\u05d9 \u05dc\u05d9\u05db\u05d5\u05dc\u05ea \u05dc\u05d9\u05e6\u05d5\u05e8 \u05d0\u05d9\u05e0\u05d8\u05e8\u05d0\u05e7\u05e6\u05d9\u05d4 \u05d7\u05d1\u05e8\u05ea\u05d9\u05ea \u05d5\u05e7\u05e9\u05e8 \u05e8\u05d2\u05e9\u05d9?",
      "answerOptions": [
        {
          "text": "\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea \u05d4-Joint attention (\u05e7\u05e9\u05d1 \u05de\u05e9\u05d5\u05ea\u05e3) (Dulcan p. 139).",
          "isCorrect": true,
          "rationale": "\u05e7\u05e9\u05d1 \u05de\u05e9\u05d5\u05ea\u05e3, \u05d4\u05db\u05d5\u05dc\u05dc \u05de\u05e2\u05e7\u05d1 \u05d0\u05d7\u05e8 \u05de\u05d1\u05d8 \u05d0\u05d5 \u05d4\u05e6\u05d1\u05e2\u05d4 \u05dc\u05e9\u05d9\u05ea\u05d5\u05e3 \u05e2\u05e0\u05d9\u05d9\u05df, \u05de\u05ea\u05e4\u05ea\u05d7 \u05dc\u05e7\u05e8\u05d0\u05ea \u05e1\u05d5\u05e3 \u05d4\u05e9\u05e0\u05d4 \u05d4\u05e8\u05d0\u05e9\u05d5\u05e0\u05d4 \u05d5\u05d4\u05d5\u05d0 \u05e7\u05e8\u05d9\u05d8\u05d9 \u05dc\u05ea\u05e7\u05e9\u05d5\u05e8\u05ea \u05d7\u05d1\u05e8\u05ea\u05d9\u05ea."
        },
        {
          "text": "\u05d4\u05d1\u05e0\u05ea \u05e9\u05d9\u05de\u05d5\u05e8 \u05d7\u05d5\u05de\u05e8 (Conservation) (Dulcan p. 1044, Table 4-2).",
          "isCorrect": false,
          "rationale": "\u05e9\u05d9\u05de\u05d5\u05e8 \u05d7\u05d5\u05de\u05e8 \u05d4\u05d5\u05d0 \u05de\u05d5\u05e9\u05d2 \u05e4\u05d9\u05d0\u05d6'\u05d8\u05d9\u05d0\u05e0\u05d9 \u05d4\u05e9\u05d9\u05d9\u05da \u05dc\u05e9\u05dc\u05d1 \u05d4\u05d0\u05d5\u05e4\u05e8\u05e6\u05d9\u05d5\u05ea \u05d4\u05e7\u05d5\u05e0\u05e7\u05e8\u05d8\u05d9\u05d5\u05ea \u05d1\u05d9\u05dc\u05d3\u05d5\u05ea \u05d4\u05de\u05d0\u05d5\u05d7\u05e8\u05ea \u05d9\u05d5\u05ea\u05e8."
        },
        {
          "text": "\u05d9\u05db\u05d5\u05dc\u05ea \u05d4\u05e4\u05e8\u05d3\u05d4 \u05d1\u05d9\u05df \u05e4\u05e0\u05d8\u05d6\u05d9\u05d4 \u05dc\u05de\u05e6\u05d9\u05d0\u05d5\u05ea (Dulcan p. 53).",
          "isCorrect": false,
          "rationale": "\u05d9\u05db\u05d5\u05dc\u05ea \u05d6\u05d5 \u05de\u05d5\u05d2\u05d1\u05dc\u05ea \u05de\u05d0\u05d5\u05d3 \u05d1\u05d2\u05d9\u05dc \u05d4\u05e8\u05da \u05d5\u05de\u05ea\u05e4\u05ea\u05d7\u05ea \u05e8\u05e7 \u05dc\u05e7\u05e8\u05d0\u05ea \u05e1\u05d5\u05e3 \u05d2\u05d9\u05dc \u05d4\u05d2\u05df."
        },
        {
          "text": "\u05e8\u05db\u05d9\u05e9\u05ea \u05e9\u05e4\u05ea \u05e1\u05d9\u05de\u05e0\u05d9\u05dd \u05d1\u05e1\u05d9\u05e1\u05d9\u05ea (Dulcan p. 154).",
          "isCorrect": false,
          "rationale": "\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05de\u05d7\u05d5\u05d5\u05ea \u05d4\u05d5\u05d0 \u05d0\u05d1\u05df \u05d3\u05e8\u05da, \u05d0\u05da \u05e7\u05e9\u05d1 \u05de\u05e9\u05d5\u05ea\u05e3 \u05d4\u05d5\u05d0 \u05d4\u05ea\u05d4\u05dc\u05d9\u05da \u05d4\u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9-\u05d7\u05d1\u05e8\u05ea\u05d9 \u05d4\u05e2\u05de\u05d5\u05e7 \u05d9\u05d5\u05ea\u05e8 \u05d4\u05de\u05d4\u05d5\u05d5\u05d4 \u05d1\u05e1\u05d9\u05e1 \u05dc\u05db\u05dc \u05ea\u05e7\u05e9\u05d5\u05e8\u05ea."
        }
      ],
      "hint": "\u05d7\u05e9\u05d1\u05d5 \u05e2\u05dc \u05d4\u05d9\u05db\u05d5\u05dc\u05ea \u05e9\u05dc \u05d4\u05ea\u05d9\u05e0\u05d5\u05e7 \u05dc\u05d2\u05d9\u05d9\u05e1 \u05d0\u05ea \u05d4\u05de\u05d1\u05d5\u05d2\u05e8 \u05dc\u05d4\u05ea\u05d1\u05d5\u05e0\u05df \u05d9\u05d7\u05d3 \u05d0\u05d9\u05ea\u05d5 \u05e2\u05dc \u05d0\u05d5\u05d1\u05d9\u05d9\u05e7\u05d8 \u05d7\u05d9\u05e6\u05d5\u05e0\u05d9."
    },
    {
      "question": "\u05ea\u05d9\u05e0\u05d5\u05e7 \u05d1\u05df 9 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05de\u05d5\u05d1\u05d0 \u05dc\u05d1\u05d3\u05d9\u05e7\u05d4. \u05d4\u05de\u05d8\u05e4\u05dc\u05ea \u05de\u05d3\u05d5\u05d5\u05d7\u05ea \u05db\u05d9 \u05db\u05d0\u05e9\u05e8 \u05d4\u05d9\u05d0 \u05de\u05e0\u05e1\u05d4 \u05dc\u05e0\u05d7\u05de\u05d5 \u05db\u05e9\u05d4\u05d5\u05d0 \u05d1\u05d5\u05db\u05d4, \u05d4\u05d5\u05d0 \u05d0\u05d9\u05e0\u05d5 \u05de\u05d2\u05d9\u05d1 \u05dc\u05e0\u05d9\u05e1\u05d9\u05d5\u05e0\u05d5\u05ea \u05d4\u05d4\u05e8\u05d2\u05e2\u05d4, \u05d0\u05d9\u05e0\u05d5 \u05de\u05d7\u05e4\u05e9 \u05e7\u05e9\u05e8 \u05e2\u05d9\u05df \u05d5\u05e0\u05e8\u05d0\u05d4 \u05d0\u05d3\u05d9\u05e9 \u05e8\u05d2\u05e9\u05d9\u05ea. \u05d4\u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4 \u05db\u05d5\u05dc\u05dc\u05ea \u05de\u05e2\u05d1\u05e8\u05d9\u05dd \u05de\u05e8\u05d5\u05d1\u05d9\u05dd \u05d1\u05d9\u05df \u05de\u05d8\u05e4\u05dc\u05d9\u05dd (Foster care). \u05de\u05d4\u05d9 \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05de\u05d1\u05d3\u05dc\u05ea \u05d4\u05d7\u05e9\u05d5\u05d1\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d1\u05d9\u05df Reactive Attachment Disorder (RAD) \u05dc\u05d1\u05d9\u05df Autism Spectrum Disorder (ASD) \u05d1\u05de\u05e7\u05e8\u05d4 \u05d6\u05d4?",
      "answerOptions": [
        {
          "text": "\u05d1-RAD \u05e7\u05d9\u05d9\u05de\u05ea \u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4 \u05e9\u05dc \u05d4\u05d6\u05e0\u05d7\u05d4 \u05d0\u05d5 \u05d8\u05d9\u05e4\u05d5\u05dc \u05d7\u05e1\u05e8 (Pathogenic care), \u05d5\u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e2\u05e9\u05d5\u05d9\u05d9\u05dd \u05dc\u05d4\u05e9\u05ea\u05e4\u05e8 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05d1\u05e1\u05d1\u05d9\u05d1\u05d4 \u05de\u05d8\u05e4\u05d7\u05ea (DSM p. 296).",
          "isCorrect": true,
          "rationale": "\u05d4\u05d4\u05d1\u05d7\u05e0\u05d4 \u05d4\u05de\u05e8\u05db\u05d6\u05d9\u05ea \u05e0\u05e9\u05e2\u05e0\u05ea \u05e2\u05dc \u05d4\u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4 \u05e9\u05dc \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d5\u05e2\u05dc \u05d4\u05e4\u05d5\u05d8\u05e0\u05e6\u05d9\u05d0\u05dc \u05dc\u05e9\u05d9\u05e4\u05d5\u05e8 \u05ea\u05d7\u05ea \u05d8\u05d9\u05e4\u05d5\u05dc \u05de\u05d8\u05d9\u05d1 \u05d1-RAD \u05dc\u05e2\u05d5\u05de\u05ea ASD."
        },
        {
          "text": "\u05e8\u05e7 \u05d1-ASD \u05e0\u05d9\u05ea\u05df \u05dc\u05d0\u05d1\u05d7\u05df \u05d0\u05d9\u05d7\u05d5\u05e8 \u05de\u05d5\u05d8\u05d5\u05e8\u05d9 \u05d5\u05e9\u05e4\u05ea\u05d9 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9 (DSM p. 60).",
          "isCorrect": false,
          "rationale": "\u05d2\u05dd \u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd RAD \u05e1\u05d5\u05d1\u05dc\u05d9\u05dd \u05dc\u05e2\u05d9\u05ea\u05d9\u05dd \u05e7\u05e8\u05d5\u05d1\u05d5\u05ea \u05de\u05d0\u05d9\u05d7\u05d5\u05e8\u05d9\u05dd \u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9\u05d9\u05dd \u05d5\u05e9\u05e4\u05ea\u05d9\u05d9\u05dd \u05e2\u05e7\u05d1 \u05d7\u05e1\u05da \u05e1\u05d1\u05d9\u05d1\u05ea\u05d9."
        },
        {
          "text": "RAD \u05de\u05d0\u05d5\u05d1\u05d7\u05df \u05e8\u05e7 \u05d0\u05dd \u05d4\u05ea\u05d9\u05e0\u05d5\u05e7 \u05de\u05e4\u05d2\u05d9\u05df \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05e8\u05e4\u05d8\u05d8\u05d9\u05d1\u05d9\u05ea \u05d5\u05e1\u05d8\u05e8\u05d9\u05d0\u05d5\u05d8\u05d9\u05e4\u05d9\u05ea (DSM p. 295).",
          "isCorrect": false,
          "rationale": "\u05d3\u05e4\u05d5\u05e1\u05d9\u05dd \u05e8\u05e4\u05d8\u05d8\u05d9\u05d1\u05d9\u05d9\u05dd \u05d4\u05dd \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df \u05dc\u05d9\u05d1\u05d4 \u05e9\u05dc ASD, \u05d1\u05e2\u05d5\u05d3 \u05e9\u05d1-RAD \u05d4\u05d3\u05d2\u05e9 \u05d4\u05d5\u05d0 \u05e2\u05dc \u05d4\u05d9\u05e2\u05d3\u05e8 \u05d7\u05d9\u05e4\u05d5\u05e9 \u05e0\u05d7\u05de\u05d4 \u05d5\u05e7\u05e9\u05e8 \u05e8\u05d2\u05e9\u05d9."
        },
        {
          "text": "\u05dc\u05d0 \u05e0\u05d9\u05ea\u05df \u05dc\u05d0\u05d1\u05d7\u05df RAD \u05dc\u05e4\u05e0\u05d9 \u05d2\u05d9\u05dc \u05e9\u05e0\u05ea\u05d9\u05d9\u05dd (DSM p. 296).",
          "isCorrect": false,
          "rationale": "\u05e0\u05d9\u05ea\u05df \u05dc\u05d0\u05d1\u05d7\u05df RAD \u05d4\u05d7\u05dc \u05de\u05d2\u05d9\u05dc \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9 \u05e9\u05dc 9 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd."
        }
      ],
      "hint": "\u05d4\u05ea\u05de\u05e7\u05d3\u05d5 \u05d1\u05d0\u05d8\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05d4 (Etiology) \u05e9\u05dc \u05d4\u05d4\u05e4\u05e8\u05e2\u05d4 \u05d5\u05d1\u05d0\u05d5\u05e4\u05df \u05e9\u05d1\u05d5 \u05d4\u05e1\u05d1\u05d9\u05d1\u05d4 \u05d4\u05e9\u05e4\u05d9\u05e2\u05d4 \u05e2\u05dc \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea \u05d4\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd."
    }
