{
  "title": "Developmental Flashcards",
  "cards": [
    {
      "front": "\u05d1\u05d0\u05d9\u05d6\u05d4 \u05d2\u05d9\u05dc \u05de\u05e6\u05d5\u05e4\u05d4 \u05de\u05e4\u05e2\u05d5\u05d8 \u05dc\u05dc\u05db\u05ea \u05d1\u05d0\u05d5\u05e4\u05df \u05e2\u05e6\u05de\u05d0\u05d9 (walking independently) \u05dc\u05e4\u05d9 \u05d0\u05d1\u05e0\u05d9 \u05d4\u05d3\u05e8\u05da \u05d4\u05de\u05d5\u05d8\u05d5\u05e8\u05d9\u05d5\u05ea?",
