      "answerOptions": [
        {
          "text": "\u05e0\u05d9\u05d8\u05d5\u05e8 \u05de\u05de\u05d5\u05e9\u05da \u05d1-Video-EEG; \u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05e9\u05dc \u05e2\u05e6\u05d9\u05de\u05ea \u05e2\u05d9\u05e0\u05d9\u05d9\u05dd \u05e2\u05e7\u05e9\u05e0\u05d9\u05ea (persistent eye closure) \u05d1\u05d6\u05de\u05df \u05d4\u05d0\u05d9\u05e8\u05d5\u05e2.",
          "isCorrect": true,
          "rationale": "Video-EEG \u05de\u05d0\u05e4\u05e9\u05e8 \u05e7\u05d5\u05e8\u05dc\u05e6\u05d9\u05d4 \u05d1\u05d9\u05df \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05dc\u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05d7\u05e9\u05de\u05dc\u05d9\u05ea. \u05e2\u05e6\u05d9\u05de\u05ea \u05e2\u05d9\u05e0\u05d9\u05d9\u05dd \u05e2\u05dd \u05d4\u05ea\u05e0\u05d2\u05d3\u05d5\u05ea \u05dc\u05e4\u05ea\u05d9\u05d7\u05d4 \u05d4\u05d9\u05d0 \u05e1\u05de\u05df \u05e7\u05dc\u05d9\u05e0\u05d9 \u05d7\u05d6\u05e7 \u05dc\u05d4\u05ea\u05e7\u05e3 \u05dc\u05d0-\u05d0\u05e4\u05d9\u05dc\u05e4\u05d8\u05d9 (dissociative/functional). (DSM p.361; Dulcan p.96)."
        },
        {
          "text": "\u05e8\u05d9\u05e9\u05d5\u05dd EEG \u05d1\u05d7\u05e1\u05da \u05e9\u05d9\u05e0\u05d4; \u05e7\u05d9\u05d5\u05dd \u05e9\u05dc \u05d0\u05d5\u05e8\u05d9\u05d0\u05d4 \u05d0\u05e4\u05d9\u05d2\u05e1\u05d8\u05e8\u05d9\u05ea \u05de\u05e7\u05d3\u05d9\u05de\u05d4.",
          "isCorrect": false,
          "rationale": "\u05d7\u05e1\u05da \u05e9\u05d9\u05e0\u05d4 \u05e0\u05d5\u05e2\u05d3 \u05dc\u05d4\u05e2\u05dc\u05d5\u05ea \u05e8\u05d2\u05d9\u05e9\u05d5\u05ea \u05dc\u05e4\u05e8\u05db\u05d5\u05e1\u05d9\u05dd \u05d0\u05e4\u05d9\u05dc\u05e4\u05d8\u05d9\u05d9\u05dd, \u05d5\u05d0\u05d9\u05dc\u05d5 \u05d0\u05d5\u05e8\u05d4 \u05d0\u05e4\u05d9\u05d2\u05e1\u05d8\u05e8\u05d9\u05ea \u05de\u05db\u05d5\u05d5\u05e0\u05ea \u05d3\u05d5\u05d5\u05e7\u05d0 \u05dc\u05de\u05e7\u05d5\u05e8 \u05d0\u05e4\u05d9\u05dc\u05e4\u05d8\u05d9 \u05d1-temporal lobe, \u05d5\u05dc\u05d0 \u05dc-PNES. (Dulcan p.95-96)."
        },
        {
          "text": "\u05d1\u05d3\u05d9\u05e7\u05ea Prolactin \u05e9\u05e2\u05d4 \u05dc\u05d0\u05d7\u05e8 \u05d4\u05d0\u05d9\u05e8\u05d5\u05e2; \u05d0\u05d5\u05d1\u05d3\u05df \u05e9\u05dc\u05d9\u05d8\u05d4 \u05e2\u05dc \u05e1\u05d5\u05d2\u05e8\u05d9\u05dd.",
          "isCorrect": false,
          "rationale": "\u05e8\u05de\u05d5\u05ea \u05e4\u05e8\u05d5\u05dc\u05e7\u05d8\u05d9\u05df \u05d0\u05d9\u05e0\u05df \u05de\u05d4\u05d5\u05d5\u05ea \u05de\u05d3\u05d3 \u05d0\u05d1\u05d7\u05e0\u05ea\u05d9 \u05de\u05d5\u05d7\u05dc\u05d8 (Gold Standard). \u05d0\u05d5\u05d1\u05d3\u05df \u05e9\u05dc\u05d9\u05d8\u05d4 \u05e2\u05dc \u05e1\u05d5\u05d2\u05e8\u05d9\u05dd \u05d9\u05db\u05d5\u05dc \u05dc\u05d4\u05ea\u05e8\u05d7\u05e9 \u05d1\u05e9\u05e0\u05d9 \u05d4\u05de\u05e6\u05d1\u05d9\u05dd \u05d5\u05d0\u05d9\u05e0\u05d5 \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9 \u05de\u05e1\u05e4\u05d9\u05e7. (Dulcan p.96)."
        },
        {
          "text": "\u05e6\u05d9\u05dc\u05d5\u05dd CT \u05de\u05d5\u05d7; \u05ea\u05e0\u05d5\u05e2\u05d5\u05ea \u05de\u05d5\u05d8\u05d5\u05e8\u05d9\u05d5\u05ea \u05e1\u05d9\u05de\u05d8\u05e8\u05d9\u05d5\u05ea \u05d5\u05e8\u05d9\u05ea\u05de\u05d9\u05d5\u05ea.",
          "isCorrect": false,
          "rationale": "CT \u05e0\u05d5\u05e2\u05d3 \u05dc\u05e9\u05dc\u05d9\u05dc\u05ea \u05e4\u05ea\u05d5\u05dc\u05d5\u05d2\u05d9\u05d4 \u05de\u05d1\u05e0\u05d9\u05ea \u05d5\u05dc\u05d0 \u05dc\u05d0\u05d1\u05d7\u05d5\u05df \u05d0\u05d5\u05e4\u05d9 \u05d4\u05e4\u05e8\u05db\u05d5\u05e1. \u05ea\u05e0\u05d5\u05e2\u05d5\u05ea \u05e1\u05d9\u05de\u05d8\u05e8\u05d9\u05d5\u05ea \u05d5\u05e8\u05d9\u05ea\u05de\u05d9\u05d5\u05ea \u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05d9\u05d5\u05ea \u05d3\u05d5\u05d5\u05e7\u05d0 \u05dc\u05e4\u05e8\u05db\u05d5\u05e1\u05d9\u05dd \u05d8\u05d5\u05e0\u05d9\u05d9\u05dd-\u05e7\u05dc\u05d5\u05e0\u05d9\u05d9\u05dd \u05de\u05db\u05dc\u05dc\u05d9\u05d9\u05dd. (Dulcan p.96)."
        }
      ],
      "hint": "\u05d7\u05e4\u05e9\u05d5 \u05d0\u05ea \u05d4\u05db\u05dc\u05d9 \u05d4\u05de\u05e9\u05dc\u05d1 \u05e6\u05d9\u05dc\u05d5\u05dd \u05d5\u05d9\u05d3\u05d0\u05d5 \u05e2\u05dd \u05e8\u05d9\u05e9\u05d5\u05dd \u05de\u05d5\u05d7\u05d9 \u05d5\u05d0\u05ea \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d4\u05e2\u05e4\u05e2\u05e4\u05d9\u05d9\u05dd \u05d4\u05d8\u05d9\u05e4\u05d5\u05e1\u05d9\u05ea."
    },
    {
      "type": "multiple_choice",
      "question": "\u05e2\u05dc \u05e4\u05d9 \u05d4\u05de\u05d5\u05d3\u05dc \u05d4\u05de\u05d5\u05e6\u05d2 \u05d1-StahlNeuro \u05dc\u05d2\u05d1\u05d9 \u05de\u05e2\u05d2\u05dc\u05d9 \u05d4-Cortico-Striato-Thalamo-Cortical (CSTC) Loops, \u05d0\u05d9\u05dc\u05d5 \u05de\u05d1\u05e0\u05d9\u05dd \u05d0\u05e0\u05d8\u05d5\u05de\u05d9\u05d9\u05dd \u05de\u05e2\u05d5\u05e8\u05d1\u05d9\u05dd \u05d1\u05d1\u05e7\u05e8\u05ea \u05d4\u05d1\u05d9\u05d8\u05d5\u05d9 \u05d4\u05de\u05d5\u05d8\u05d5\u05e8\u05d9 \u05d5\u05d4\u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9\u05d6\u05de\u05d9\u05dd \u05d1\u05d6\u05de\u05df \u05e4\u05e8\u05db\u05d5\u05e1, \u05d5\u05de\u05d4\u05d5 \u05ea\u05e4\u05e7\u05d9\u05d3 \u05d4-Nigrostriatal pathway \u05d1\u05d9\u05d9\u05e6\u05d5\u05e8 \u05ea\u05e0\u05d5\u05e2\u05d5\u05ea \u05d9\u05ea\u05e8 (\u05db\u05d2\u05d5\u05df tics \u05d0\u05d5 dyskinesias)? (StahlNeuro p.87-88; \u05d0\u05e0\u05d8\u05d5\u05de\u05d9\u05d4 p.1.4)",
      "answerOptions": [
        {
          "text": "\u05de\u05e2\u05d5\u05e8\u05d1\u05d5\u05ea \u05e9\u05dc \u05d4\u05e1\u05d8\u05e8\u05d9\u05d0\u05d8\u05d5\u05dd, thalamus \u05d5-globus pallidus; \u05e2\u05d5\u05d3\u05e3 \u05d3\u05d5\u05e4\u05de\u05d9\u05df \u05d1\u05de\u05e1\u05dc\u05d5\u05dc \u05d4\u05e0\u05d9\u05d2\u05e8\u05d5\u05e1\u05d8\u05e8\u05d9\u05d0\u05d8\u05dc\u05d9 \u05e7\u05e9\u05d5\u05e8 \u05dc\u05ea\u05e0\u05d5\u05e2\u05d5\u05ea hyperkinetic.",
          "isCorrect": true,
          "rationale": "\u05de\u05e2\u05d2\u05dc\u05d9 \u05d4-CSTC \u05de\u05d5\u05d5\u05e1\u05ea\u05d9\u05dd \u05e4\u05dc\u05d8 \u05de\u05d5\u05d8\u05d5\u05e8\u05d9 \u05d3\u05e8\u05da \u05d4\u05e1\u05d8\u05e8\u05d9\u05d0\u05d8\u05d5\u05dd \u05d5\u05d4\u05ea\u05dc\u05de\u05d5\u05e1. \u05e2\u05dc \u05e4\u05d9 StahlNeuro, \u05e2\u05d5\u05d3\u05e3 \u05d3\u05d5\u05e4\u05de\u05d9\u05df \u05d1\u05de\u05e1\u05dc\u05d5\u05dc \u05d6\u05d4 \u05de\u05e2\u05d5\u05e8\u05e8 \u05ea\u05e0\u05d5\u05e2\u05d5\u05ea \u05dc\u05d0 \u05e8\u05e6\u05d5\u05e0\u05d9\u05d5\u05ea \u05db\u05de\u05d5 \u05d8\u05d9\u05e7\u05d9\u05dd, \u05d1\u05e2\u05d5\u05d3 \u05d7\u05d5\u05e1\u05e8 \u05de\u05d5\u05d1\u05d9\u05dc \u05dc\u05e4\u05e8\u05e7\u05d9\u05e0\u05e1\u05d5\u05e0\u05d9\u05d6\u05dd. (StahlNeuro p.87-88; \u05d0\u05e0\u05d8\u05d5\u05de\u05d9\u05d4 p.1.4)."
        },
        {
          "text": "\u05de\u05e2\u05d5\u05e8\u05d1\u05d5\u05ea \u05e9\u05dc \u05d4-hippocampus \u05d5\u05d4-amygdala \u05d1\u05dc\u05d1\u05d3; \u05d4\u05de\u05e1\u05dc\u05d5\u05dc \u05d4\u05e0\u05d9\u05d2\u05e8\u05d5\u05e1\u05d8\u05e8\u05d9\u05d0\u05d8\u05dc\u05d9 \u05d0\u05d7\u05e8\u05d0\u05d9 \u05e8\u05e7 \u05e2\u05dc \u05dc\u05de\u05d9\u05d3\u05d4 \u05d5\u05d6\u05d9\u05db\u05e8\u05d5\u05df.",
          "isCorrect": false,
          "rationale": "\u05d4\u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05dc\u05d9\u05de\u05d1\u05d9\u05ea \u05de\u05e2\u05d5\u05e8\u05d1\u05ea \u05d1\u05e4\u05e8\u05db\u05d5\u05e1\u05d9\u05dd \u05de\u05d5\u05e7\u05d3\u05d9\u05d9\u05dd \u05de\u05d5\u05e8\u05db\u05d1\u05d9\u05dd (TLE), \u05d0\u05da \u05d1\u05e7\u05e8\u05ea \u05d4\u05e4\u05dc\u05d8 \u05d4\u05de\u05d5\u05d8\u05d5\u05e8\u05d9 \u05d5\u05d4\u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9\u05d6\u05de\u05d9\u05dd \u05de\u05e9\u05d5\u05d9\u05db\u05ea \u05dc\u05de\u05e2\u05d2\u05dc\u05d9 \u05d4-CSTC \u05d5\u05d4\u05d2\u05e8\u05e2\u05d9\u05e0\u05d9\u05dd \u05d4\u05d1\u05d6\u05dc\u05d9\u05d9\u05dd. (\u05d0\u05e0\u05d8\u05d5\u05de\u05d9\u05d4 p.1.4)."
        },
        {
          "text": "\u05de\u05e2\u05d5\u05e8\u05d1\u05d5\u05ea \u05e9\u05dc \u05d4-cerebellum \u05d5\u05d4-pons; \u05d3\u05d5\u05e4\u05de\u05d9\u05df \u05de\u05e2\u05db\u05d1 \u05ea\u05de\u05d9\u05d3 \u05d0\u05ea \u05d4\u05e4\u05dc\u05d8 \u05d4\u05de\u05d5\u05d8\u05d5\u05e8\u05d9 \u05d1\u05ea\u05dc\u05de\u05d5\u05e1.",
          "isCorrect": false,
          "rationale": "\u05d4\u05de\u05d5\u05d7 \u05d4\u05e7\u05d8\u05df \u05d0\u05d9\u05e0\u05d5 \u05d7\u05dc\u05e7 \u05de\u05dc\u05d9\u05d1\u05ea \u05de\u05e2\u05d2\u05dc\u05d9 \u05d4-CSTC. \u05d3\u05d5\u05e4\u05de\u05d9\u05df \u05e4\u05d5\u05e2\u05dc \u05d3\u05e8\u05da \u05de\u05e1\u05dc\u05d5\u05dc\u05d9\u05dd \u05d9\u05e9\u05d9\u05e8\u05d9\u05dd (D1 - go) \u05d5\u05e2\u05e7\u05d9\u05e4\u05d9\u05dd (D2 - stop) \u05dc\u05d5\u05d5\u05d9\u05e1\u05d5\u05ea \u05d4\u05ea\u05e0\u05d5\u05e2\u05d4, \u05d5\u05dc\u05d0 \u05e8\u05e7 \u05db\u05de\u05e2\u05db\u05d1. (StahlNeuro p.88)."
        },
        {
          "text": "\u05de\u05e2\u05d5\u05e8\u05d1\u05d5\u05ea \u05e9\u05dc \u05d4-Prefrontal Cortex \u05d1\u05dc\u05d1\u05d3; \u05d7\u05d5\u05e1\u05e8 \u05d3\u05d5\u05e4\u05de\u05d9\u05df \u05d4\u05d5\u05d0 \u05e9\u05d2\u05d5\u05e8\u05dd \u05dc\u05ea\u05e0\u05d5\u05e2\u05d5\u05ea \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9\u05d6\u05dd.",
          "isCorrect": false,
          "rationale": "\u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9\u05d6\u05de\u05d9\u05dd \u05d4\u05dd \u05ea\u05d5\u05e6\u05d0\u05d4 \u05e9\u05dc \u05e4\u05e8\u05d9\u05e7\u05d4 \u05d4\u05de\u05e2\u05e8\u05d1\u05ea \u05d0\u05ea \u05d4\u05d2\u05e8\u05e2\u05d9\u05e0\u05d9\u05dd \u05d4\u05d1\u05d6\u05dc\u05d9\u05d9\u05dd \u05d5\u05d4\u05ea\u05dc\u05de\u05d5\u05e1, \u05dc\u05d0 \u05e8\u05e7 \u05d0\u05ea \u05d4\u05e7\u05d5\u05e8\u05d8\u05e7\u05e1 \u05d4\u05e4\u05e8\u05d5\u05e0\u05d8\u05dc\u05d9. (\u05d0\u05e0\u05d8\u05d5\u05de\u05d9\u05d4 p.1.4)."
        }
      ],
      "hint": "\u05d4\u05ea\u05de\u05e7\u05d3\u05d5 \u05d1\u05de\u05d1\u05e0\u05d9\u05dd \u05d4\u05de\u05e8\u05db\u05d9\u05d1\u05d9\u05dd \u05d0\u05ea \u05d4\u05d2\u05e8\u05e2\u05d9\u05e0\u05d9\u05dd \u05d4\u05d1\u05d6\u05dc\u05d9\u05d9\u05dd \u05d5\u05d1\u05d4\u05e9\u05e4\u05e2\u05ea \u05d4\u05d3\u05d5\u05e4\u05de\u05d9\u05df \u05e2\u05dc \u05d4\u05de\u05e1\u05dc\u05d5\u05dc \u05d4\u05de\u05d5\u05d8\u05d5\u05e8\u05d9."
    },
    {
      "type": "multiple_choice",
      "question": "\u05de\u05d8\u05d5\u05e4\u05dc\u05ea \u05d1\u05ea 15 \u05e2\u05dd \u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc Bipolar I Disorder \u05e1\u05d5\u05d1\u05dc\u05ea \u05d2\u05dd \u05de\u05e4\u05e8\u05db\u05d5\u05e1\u05d9\u05dd \u05de\u05d9\u05d5\u05e7\u05dc\u05d5\u05e0\u05d9\u05d9\u05dd (JME). \u05d4\u05d5\u05d7\u05dc\u05d8 \u05dc\u05d4\u05ea\u05d7\u05d9\u05dc \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Valproic Acid (VPA). \u05de\u05d4\u05df \u05d4\u05d1\u05d3\u05d9\u05e7\u05d5\u05ea \u05e9\u05d9\u05e9 \u05dc\u05d1\u05e6\u05e2 \u05d1-baseline \u05d5\u05dc\u05d0\u05d5\u05e8\u05da \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc, \u05d5\u05d0\u05d9\u05d6\u05d5 \u05d0\u05d6\u05d4\u05e8\u05d4 \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05ea \u05e8\u05dc\u05d5\u05d5\u05e0\u05d8\u05d9\u05ea \u05dc\u05de\u05d8\u05d5\u05e4\u05dc\u05ea \u05d6\u05d5 \u05d1\u05e9\u05dc \u05de\u05d9\u05e0\u05d4? (Dulcan p.769, p.771; StahlKids p.489)",
      "answerOptions": [
        {
          "text": "\u05d1\u05d9\u05e6\u05d5\u05e2 \u05ea\u05e4\u05e7\u05d5\u05d3\u05d9 \u05db\u05d1\u05d3 (LFTs), \u05e1\u05e4\u05d9\u05e8\u05ea \u05d3\u05dd (CBC) \u05e2\u05dd \u05d8\u05e1\u05d9\u05d5\u05ea; \u05d0\u05d6\u05d4\u05e8\u05d4 \u05de\u05e4\u05e0\u05d9 Polycystic Ovary Syndrome (PCOS).",
          "isCorrect": true,
          "rationale": "VPA \u05e2\u05dc\u05d5\u05dc\u05d4 \u05dc\u05d2\u05e8\u05d5\u05dd \u05dc\u05e8\u05e2\u05d9\u05dc\u05d5\u05ea \u05db\u05d1\u05d3\u05d9\u05ea (hepatotoxicity) \u05d5\u05dc\u05ea\u05e8\u05d5\u05de\u05d1\u05d5\u05e6\u05d9\u05d8\u05d5\u05e4\u05e0\u05d9\u05d4. \u05d1\u05e0\u05e9\u05d9\u05dd \u05e6\u05e2\u05d9\u05e8\u05d5\u05ea \u05d9\u05e9 \u05e1\u05d9\u05db\u05d5\u05df \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9 \u05dc\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea PCOS \u05ea\u05d7\u05ea \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc. (Dulcan p.769, p.771; StahlKids p.489)."
        },
        {
          "text": "\u05d1\u05d9\u05e6\u05d5\u05e2 \u05d0\u05dc\u05e7\u05d8\u05e8\u05d5\u05dc\u05d9\u05d8\u05d9\u05dd (\u05e0\u05ea\u05e8\u05df); \u05d0\u05d6\u05d4\u05e8\u05d4 \u05de\u05e4\u05e0\u05d9 Stevens-Johnson Syndrome (SJS).",
          "isCorrect": false,
          "rationale": "\u05d4\u05d9\u05e4\u05d5\u05e0\u05ea\u05e8\u05de\u05d9\u05d4 \u05d5\u05d0\u05d6\u05d4\u05e8\u05ea SJS (\u05d1\u05de\u05d9\u05d5\u05d7\u05d3 \u05d1\u05e0\u05e9\u05d0\u05d9 HLA-B*1502) \u05e8\u05dc\u05d5\u05d5\u05e0\u05d8\u05d9\u05d5\u05ea \u05d9\u05d5\u05ea\u05e8 \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Carbamazepine \u05d0\u05d5 Oxcarbazepine. (Dulcan p.771)."
        },
        {
          "text": "\u05d1\u05d9\u05e6\u05d5\u05e2 \u05d1\u05d3\u05d9\u05e7\u05ea \u05e9\u05ea\u05df \u05dc\u05d7\u05dc\u05d1\u05d5\u05df; \u05d0\u05d6\u05d4\u05e8\u05d4 \u05de\u05e4\u05e0\u05d9 Nephrolithiasis (\u05d0\u05d1\u05e0\u05d9\u05dd \u05d1\u05db\u05dc\u05d9\u05d5\u05ea).",
          "isCorrect": false,
          "rationale": "\u05d0\u05d1\u05e0\u05d9\u05dd \u05d1\u05db\u05dc\u05d9\u05d5\u05ea \u05d4\u05df \u05ea\u05d5\u05e4\u05e2\u05ea \u05dc\u05d5\u05d5\u05d0\u05d9 \u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05d9\u05ea \u05dc-Topiramate \u05d1\u05e9\u05dc \u05e2\u05d9\u05db\u05d5\u05d1 \u05d4\u05d0\u05e0\u05d6\u05d9\u05dd Carbonic Anhydrase, \u05d5\u05dc\u05d0 \u05dc-VPA. (Dulcan p.777)."
        },
        {
          "text": "\u05e0\u05d9\u05d8\u05d5\u05e8 \u05dc\u05d7\u05e5 \u05d3\u05dd \u05d1\u05d9\u05e9\u05d9\u05d1\u05d4 \u05d5\u05e2\u05de\u05d9\u05d3\u05d4; \u05d0\u05d6\u05d4\u05e8\u05d4 \u05de\u05e4\u05e0\u05d9 Hypertension.",
          "isCorrect": false,
          "rationale": "\u05e0\u05d9\u05d8\u05d5\u05e8 \u05dc\u05d7\u05e5 \u05d3\u05dd \u05d7\u05d9\u05d5\u05e0\u05d9 \u05d1\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Stimulants \u05d0\u05d5 SNRIs, \u05d0\u05da VPA \u05d0\u05d9\u05e0\u05d4 \u05d2\u05d5\u05e8\u05de\u05ea \u05dc\u05d9\u05ea\u05e8 \u05dc\u05d7\u05e5 \u05d3\u05dd \u05db\u05e2\u05e0\u05d9\u05d9\u05df \u05e9\u05d1\u05e9\u05d2\u05e8\u05d4. (StahlKids p.139)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d1\u05d5 \u05e2\u05dc \u05d4\u05d0\u05d9\u05d1\u05e8\u05d9\u05dd \u05d4\u05e4\u05d2\u05d9\u05e2\u05d9\u05dd \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc-Valproate (\u05db\u05d1\u05d3 \u05d5\u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05d3\u05dd) \u05d5\u05e2\u05dc \u05d4\u05d4\u05e9\u05e4\u05e2\u05d4 \u05d4\u05d0\u05e0\u05d3\u05d5\u05e7\u05e8\u05d9\u05e0\u05d9\u05ea \u05d1\u05e0\u05e9\u05d9\u05dd."
    },
    {
      "type": "multiple_select",
      "question": "\u05e2\u05dc \u05e4\u05d9 \u05d4-Syllabus \u05d5-Dulcan, \u05d0\u05d9\u05dc\u05d5 \u05de\u05d4\u05de\u05e6\u05d1\u05d9\u05dd \u05d4\u05d1\u05d0\u05d9\u05dd \u05e0\u05db\u05dc\u05dc\u05d9\u05dd \u05d1\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05de\u05d1\u05d3\u05dc\u05ea \u05e9\u05dc \u05d0\u05d9\u05e8\u05d5\u05e2\u05d9\u05dd \u05e4\u05e8\u05d5\u05e7\u05e1\u05d9\u05d6\u05de\u05dc\u05d9\u05d9\u05dd \u05dc\u05d0-\u05d0\u05e4\u05d9\u05dc\u05e4\u05d8\u05d9\u05d9\u05dd (Paroxysmal non-epileptic events) \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d5\u05e0\u05d5\u05e2\u05e8? (Dulcan p.98, Table 6-3; Syllabus p.54)",
      "answerOptions": [
        {
          "text": "Breath-holding spells (\u05e2\u05e6\u05d9\u05e8\u05ea \u05e0\u05e9\u05d9\u05de\u05d4).",
          "isCorrect": true,
          "rationale": "\u05d0\u05d9\u05e8\u05d5\u05e2\u05d9\u05dd \u05d0\u05dc\u05d5 \u05e0\u05e4\u05d5\u05e6\u05d9\u05dd \u05d1\u05d9\u05dc\u05d3\u05d5\u05ea \u05d4\u05de\u05d5\u05e7\u05d3\u05de\u05ea \u05d5\u05e2\u05dc\u05d5\u05dc\u05d9\u05dd \u05dc\u05d4\u05d9\u05d7\u05e9\u05d1 \u05d1\u05d8\u05e2\u05d5\u05ea \u05dc\u05e4\u05e8\u05db\u05d5\u05e1\u05d9\u05dd \u05d1\u05e9\u05dc \u05d4\u05e6\u05d9\u05d0\u05e0\u05d5\u05d6\u05d4 \u05d5\u05d4\u05d4\u05ea\u05e7\u05e9\u05d7\u05d5\u05ea. (Syllabus p.54)."
        },
        {
          "text": "Night Terrors (\u05d1\u05d9\u05e2\u05d5\u05ea\u05d9 \u05dc\u05d9\u05dc\u05d4).",
          "isCorrect": true,
          "rationale": "\u05e4\u05e8\u05d0\u05e1\u05d5\u05de\u05e0\u05d9\u05d5\u05ea \u05e9\u05dc \u05e9\u05e0\u05ea NREM \u05db\u05d5\u05dc\u05dc\u05d5\u05ea \u05d0\u05d9\u05e8\u05d5\u05e2\u05d9 \u05d0\u05d9\u05de\u05d4 \u05d5\u05e8\u05e2\u05d3 \u05e9\u05e2\u05dc\u05d5\u05dc\u05d9\u05dd \u05dc\u05d3\u05de\u05d5\u05ea \u05e4\u05e8\u05db\u05d5\u05e1\u05d9\u05dd \u05dc\u05d9\u05dc\u05d9\u05d9\u05dd. (Dulcan p.98, Table 6-3)."
        },
        {
          "text": "Migraine equivalents (\u05d5\u05e8\u05d8\u05d9\u05d2\u05d5 \u05d0\u05d5 \u05db\u05d0\u05d1\u05d9 \u05d1\u05d8\u05df \u05d4\u05ea\u05e7\u05e4\u05d9\u05d9\u05dd).",
          "isCorrect": true,
          "rationale": "\u05de\u05d9\u05d2\u05e8\u05e0\u05d4 \u05d9\u05db\u05d5\u05dc\u05d4 \u05dc\u05d4\u05d5\u05e4\u05d9\u05e2 \u05db\u05d0\u05d9\u05e8\u05d5\u05e2\u05d9\u05dd \u05e4\u05e8\u05d5\u05e7\u05e1\u05d9\u05d6\u05de\u05dc\u05d9\u05d9\u05dd \u05e9\u05dc \u05e1\u05d7\u05e8\u05d7\u05d5\u05e8\u05ea \u05d0\u05d5 \u05d1\u05dc\u05d1\u05d5\u05dc \u05d4\u05d3\u05d5\u05de\u05d9\u05dd \u05dc\u05de\u05e6\u05d1 ictal/post-ictal. (Syllabus p.54; Dulcan p.98)."
        },
        {
          "text": "Syncope (vasovagal).",
          "isCorrect": true,
          "rationale": "\u05e2\u05d9\u05dc\u05e4\u05d5\u05df \u05db\u05e8\u05d5\u05da \u05d1\u05d0\u05d5\u05d1\u05d3\u05df \u05d4\u05db\u05e8\u05d4 \u05d5\u05d8\u05d5\u05e0\u05d5\u05e1, \u05d5\u05dc\u05e2\u05ea\u05d9\u05dd \u05db\u05d5\u05dc\u05dc \u05ea\u05e0\u05d5\u05e2\u05d5\u05ea \u05de\u05d9\u05d5\u05e7\u05dc\u05d5\u05e0\u05d9\u05d5\u05ea \u05e7\u05e6\u05e8\u05d5\u05ea (\"convulsive syncope\") \u05d4\u05de\u05d1\u05dc\u05d1\u05dc\u05d5\u05ea \u05e2\u05dd \u05d0\u05e4\u05d9\u05dc\u05e4\u05e1\u05d9\u05d4. (Dulcan p.98, Table 6-3)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d1\u05d5 \u05e2\u05dc \u05de\u05d2\u05d5\u05d5\u05df \u05d0\u05d9\u05e8\u05d5\u05e2\u05d9\u05dd \u05d4\u05ea\u05e7\u05e4\u05d9\u05d9\u05dd \u05e9\u05dc \u05d0\u05d5\u05d1\u05d3\u05df \u05d4\u05db\u05e8\u05d4, \u05ea\u05e0\u05d5\u05e2\u05d4 \u05d0\u05d5 \u05d4\u05e4\u05e8\u05e2\u05d4 \u05d1\u05e9\u05d9\u05e0\u05d4 \u05e9\u05d0\u05d9\u05e0\u05dd \u05e0\u05d5\u05d1\u05e2\u05d9\u05dd \u05de\u05e4\u05e8\u05d9\u05e7\u05d4 \u05d7\u05e9\u05de\u05dc\u05d9\u05ea \u05de\u05d5\u05d7\u05d9\u05ea.",
      "hasAllOfTheAbove": false,
      "hasNoneOfTheAbove": false
    }
  ]
}