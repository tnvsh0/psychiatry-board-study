          "text": "\u05d4\u05e6\u05d8\u05d1\u05e8\u05d5\u05ea \u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 \u05d1\u05e8\u05e7\u05de\u05ea \u05d4\u05e9\u05d5\u05de\u05df \u05d5\u05e9\u05d7\u05e8\u05d5\u05e8 \u05d0\u05d9\u05d8\u05d9 \u05dc\u05d0\u05d5\u05e8\u05da \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd.",
          "isCorrect": false,
          "rationale": "\u05d4\u05e1\u05d9\u05d1\u05d4 \u05d4\u05d9\u05d0 \u05d4\u05de\u05d8\u05d1\u05d5\u05dc\u05d9\u05d8\u05d9\u05dd \u05d4\u05e4\u05e2\u05d9\u05dc\u05d9\u05dd \u05d1\u05d3\u05dd, \u05dc\u05d0 \u05d0\u05d2\u05d9\u05e8\u05d4 \u05d1\u05e8\u05e7\u05de\u05ea \u05e9\u05d5\u05de\u05df (Dulcan p.787)."
        },
        {
          "text": "\u05d9\u05e6\u05d9\u05e8\u05ea \u05e7\u05e9\u05e8 \u05e7\u05d5\u05d5\u05dc\u05e0\u05d8\u05d9 \u05d1\u05dc\u05ea\u05d9 \u05d4\u05e4\u05d9\u05da \u05e2\u05dd \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 D3.",
          "isCorrect": false,
          "rationale": "\u05d4\u05e7\u05d9\u05e9\u05d5\u05e8 \u05dc\u05e7\u05d5\u05dc\u05d8\u05e0\u05d9\u05dd \u05d4\u05d5\u05d0 \u05d4\u05e4\u05d9\u05da \u05d5\u05ea\u05d7\u05e8\u05d5\u05ea\u05d9, \u05d0\u05da \u05d4\u05e8\u05d9\u05db\u05d5\u05d6 \u05d1\u05d3\u05dd \u05e0\u05e9\u05de\u05e8 \u05d1\u05d6\u05db\u05d5\u05ea \u05d4\u05de\u05d8\u05d1\u05d5\u05dc\u05d9\u05d8 (StahlNeuro p.344)."
        },
        {
          "text": "\u05d4\u05e9\u05e4\u05e2\u05d4 \u05d0\u05e4\u05d9\u05d2\u05e0\u05d8\u05d9\u05ea \u05e7\u05d1\u05d5\u05e2\u05d4 \u05e2\u05dc \u05d1\u05d9\u05d8\u05d5\u05d9 \u05d4\u05d2\u05e0\u05d9\u05dd \u05e9\u05dc \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 \u05d4\u05d3\u05d5\u05e4\u05de\u05d9\u05df.",
          "isCorrect": false,
          "rationale": "\u05d4\u05d4\u05e9\u05e4\u05e2\u05d4 \u05d4\u05d9\u05d0 \u05e4\u05e8\u05de\u05e7\u05d5\u05e7\u05d9\u05e0\u05d8\u05d9\u05ea (\u05d6\u05de\u05df \u05de\u05d7\u05e6\u05d9\u05ea \u05d7\u05d9\u05d9\u05dd) \u05d5\u05dc\u05d0 \u05d0\u05e4\u05d9\u05d2\u05e0\u05d8\u05d9\u05ea \u05e7\u05d1\u05d5\u05e2\u05d4 (StahlNeuro p.239)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05d4\u05d9\u05d9\u05d7\u05d5\u05d3\u05d9 \u05e9\u05dc \u05d4\u05de\u05d8\u05d1\u05d5\u05dc\u05d9\u05d6\u05dd \u05e9\u05dc \u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 \u05d4\u05d6\u05d5.",
      "imageUrls": []
    },
    {
      "type": "fill_in_the_blank",
      "question": "\u05d4\u05ea\u05db\u05d5\u05e0\u05d4 \u05d4\u05e4\u05e8\u05de\u05e7\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea \u05d4\u05de\u05d9\u05d9\u05d7\u05d3\u05ea \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d0\u05ea Cariprazine \u05d4\u05d9\u05d0 \u05d6\u05d9\u05e7\u05ea\u05d5 \u05dc\u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 \u05d3\u05d5\u05e4\u05de\u05d9\u05df \u05de\u05e1\u05d5\u05d2 ___ , \u05e9\u05d4\u05d9\u05d0 \u05d2\u05d1\u05d5\u05d4\u05d4 \u05e4\u05d9 1,000 \u05de\u05d6\u05d5 \u05e9\u05dc \u05d4\u05d3\u05d5\u05e4\u05de\u05d9\u05df \u05d4\u05d8\u05d1\u05e2\u05d9 \u05e2\u05e6\u05de\u05d5.",
      "bestAnswer": "D3",
      "acceptableAnswers": [
        "Dopamine 3",
        "D3 receptor"
      ],
      "rationale": "Cariprazine \u05d5\u05d1\u05dc\u05d5\u05e0\u05e0\u05e1\u05e8\u05d9\u05df \u05d4\u05df \u05d4\u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05d4\u05d9\u05d7\u05d9\u05d3\u05d5\u05ea \u05d1\u05e2\u05dc\u05d5\u05ea \u05d6\u05d9\u05e7\u05d4 \u05d2\u05d1\u05d5\u05d4\u05d4 \u05de\u05e1\u05e4\u05d9\u05e7 \u05db\u05d3\u05d9 \u05dc\u05d4\u05ea\u05d7\u05e8\u05d5\u05ea \u05d1\u05d3\u05d5\u05e4\u05de\u05d9\u05df \u05e2\u05dc \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 D3 \u05d1\u05de\u05d9\u05e0\u05d5\u05e0\u05d9\u05dd \u05e7\u05dc\u05d9\u05e0\u05d9\u05d9\u05dd (StahlNeuro p.343-344).",
      "hint": "\u05d6\u05d4\u05d5 \u05ea\u05ea-\u05e1\u05d5\u05d2 \u05e9\u05dc \u05e7\u05d5\u05dc\u05d8\u05df \u05d3\u05d5\u05e4\u05de\u05d9\u05df \u05d4\u05de\u05e8\u05d5\u05db\u05d6 \u05d1\u05d0\u05d6\u05d5\u05e8\u05d9\u05dd \u05dc\u05d9\u05de\u05d1\u05d9\u05d9\u05dd."
    },
    {
      "type": "short_answer",
      "question": "\u05d4\u05e1\u05d1\u05e8 \u05d1\u05e7\u05e6\u05e8\u05d4 \u05d0\u05ea \u05d4\u05de\u05d5\u05e9\u05d2 'Dopamine Stabilizer' \u05d1\u05d4\u05e7\u05e9\u05e8 \u05e9\u05dc \u05d0\u05d2\u05d5\u05e0\u05d9\u05e1\u05d8\u05d9\u05dd \u05d7\u05dc\u05e7\u05d9\u05d9\u05dd (Partial Agonists) \u05d5\u05ea\u05d0\u05e8 \u05db\u05d9\u05e6\u05d3 \u05d4\u05d5\u05d0 \u05de\u05e9\u05e4\u05d9\u05e2 \u05e2\u05dc \u05de\u05e6\u05d1\u05d9\u05dd \u05e9\u05dc \u05e2\u05d5\u05d3\u05e3 \u05d3\u05d5\u05e4\u05de\u05d9\u05df \u05dc\u05e2\u05d5\u05de\u05ea \u05d7\u05d5\u05e1\u05e8 \u05d3\u05d5\u05e4\u05de\u05d9\u05df.",
      "grading": {
        "modelAnswer": "\u05d0\u05d2\u05d5\u05e0\u05d9\u05e1\u05d8 \u05d7\u05dc\u05e7\u05d9 \u05e4\u05d5\u05e2\u05dc \u05db'\u05de\u05d9\u05d9\u05e6\u05d1' \u05db\u05d9\u05d5\u05d5\u05df \u05e9\u05d4\u05d5\u05d0 \u05de\u05e4\u05d7\u05d9\u05ea \u05d0\u05ea \u05d4\u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05d4\u05d3\u05d5\u05e4\u05de\u05d9\u05e0\u05e8\u05d2\u05d9\u05ea \u05db\u05d0\u05e9\u05e8 \u05d9\u05e9 \u05e2\u05d5\u05d3\u05e3 \u05d3\u05d5\u05e4\u05de\u05d9\u05df \u05d8\u05d1\u05e2\u05d9 (\u05de\u05ea\u05e4\u05e7\u05d3 \u05db\u05d0\u05e0\u05d8\u05d2\u05d5\u05e0\u05d9\u05e1\u05d8 \u05e0\u05d8\u05d5), \u05d5\u05de\u05d2\u05d1\u05d9\u05e8 \u05d0\u05d5\u05ea\u05d4 \u05db\u05d0\u05e9\u05e8 \u05d9\u05e9 \u05de\u05d7\u05e1\u05d5\u05e8 \u05d1\u05d3\u05d5\u05e4\u05de\u05d9\u05df \u05d8\u05d1\u05e2\u05d9 (\u05de\u05ea\u05e4\u05e7\u05d3 \u05db\u05d0\u05d2\u05d5\u05e0\u05d9\u05e1\u05d8 \u05e0\u05d8\u05d5). \u05d4\u05de\u05d8\u05e8\u05d4 \u05d4\u05d9\u05d0 \u05dc\u05d4\u05d1\u05d9\u05d0 \u05d0\u05ea \u05e8\u05de\u05ea \u05d4\u05e1\u05d9\u05d2\u05e0\u05dc \u05dc\u05de\u05e6\u05d1 \u05d0\u05d5\u05e4\u05d8\u05d9\u05de\u05dc\u05d9 (Goldilocks solution) \u05e9\u05d1\u05d9\u05df \u05d0\u05e4\u05e1 \u05dc\u05de\u05e7\u05e1\u05d9\u05de\u05d5\u05dd.",
        "rationale": "Partial agonists \u05de\u05ea\u05e0\u05d4\u05d2\u05d9\u05dd \u05d1\u05d4\u05ea\u05d0\u05dd \u05dc\u05e1\u05d1\u05d9\u05d1\u05d4 \u05d4\u05e0\u05d5\u05d9\u05e8\u05d5\u05db\u05d9\u05de\u05d9\u05ea: \u05d4\u05dd \u05d7\u05d5\u05e1\u05de\u05d9\u05dd \u05d2\u05d9\u05e8\u05d5\u05d9 \u05d9\u05ea\u05e8 \u05d5\u05de\u05e2\u05d5\u05e8\u05e8\u05d9\u05dd \u05e1\u05d9\u05d2\u05e0\u05dc \u05d7\u05dc\u05e9 \u05d1\u05de\u05e7\u05d5\u05de\u05d5\u05ea \u05d7\u05e1\u05e8\u05d9\u05dd (StahlNeuro p.43, p.190).",
        "requiredAttributes": [
          "\u05e6\u05d9\u05d5\u05df \u05e4\u05e2\u05d5\u05dc\u05d4 \u05db\u05d0\u05e0\u05d8\u05d2\u05d5\u05e0\u05d9\u05e1\u05d8 \u05d1\u05de\u05e6\u05d1\u05d9 \u05e2\u05d5\u05d3\u05e3.",
          "\u05e6\u05d9\u05d5\u05df \u05e4\u05e2\u05d5\u05dc\u05d4 \u05db\u05d0\u05d2\u05d5\u05e0\u05d9\u05e1\u05d8 \u05d1\u05de\u05e6\u05d1\u05d9 \u05d7\u05d5\u05e1\u05e8.",
          "\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05de\u05d5\u05e9\u05d2 '\u05d9\u05d9\u05e6\u05d5\u05d1' \u05d0\u05d5 '\u05d0\u05d9\u05d6\u05d5\u05df' (Stabilization)."
        ],
        "errors": {
          "misconceptions": [
            "\u05d4\u05e0\u05d7\u05d4 \u05e9\u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 \u05d7\u05d5\u05e1\u05de\u05ea \u05ea\u05de\u05d9\u05d3 \u05d0\u05ea \u05db\u05dc \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 \u05d4\u05d3\u05d5\u05e4\u05de\u05d9\u05df.",
            "\u05d4\u05e0\u05d7\u05d4 \u05e9\u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 \u05de\u05e2\u05dc\u05d4 \u05d3\u05d5\u05e4\u05de\u05d9\u05df \u05d1\u05db\u05dc \u05de\u05e7\u05e8\u05d4."
          ],
          "bluffs": [
            "\u05d4\u05e1\u05d1\u05e8\u05d9\u05dd \u05db\u05dc\u05dc\u05d9\u05d9\u05dd \u05e2\u05dc \u05d3\u05d5\u05e4\u05de\u05d9\u05df \u05d1\u05dc\u05d9 \u05dc\u05d4\u05ea\u05d9\u05d9\u05d7\u05e1 \u05dc\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4-Partial agonism."
          ]
        }
      },
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 \u05d1\u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05d0\u05d2\u05d5\u05e0\u05d9\u05e1\u05d8 \u05de\u05dc\u05d0 (\u05d3\u05d5\u05e4\u05de\u05d9\u05df) \u05dc\u05e2\u05d5\u05de\u05ea \u05d4\u05e2\u05d3\u05e8\u05d5."
    }
  ]
}