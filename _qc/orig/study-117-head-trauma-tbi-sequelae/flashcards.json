{
  "title": "TBI Flashcards",
  "cards": [
    {
      "front": "\u05de\u05d4\u05dd \u05d8\u05d5\u05d5\u05d7\u05d9 \u05d4-GCS (Glasgow Coma Scale) \u05d4\u05de\u05d2\u05d3\u05d9\u05e8\u05d9\u05dd TBI \u05e7\u05dc\u05d4, \u05d1\u05d9\u05e0\u05d5\u05e0\u05d9\u05ea \u05d5\u05d7\u05de\u05d5\u05e8\u05d4?",
      "back": "\u05e7\u05dc\u05d4 ($13$\u2013$15$), \u05d1\u05d9\u05e0\u05d5\u05e0\u05d9\u05ea ($9$\u2013$12$), \u05d5\u05d7\u05de\u05d5\u05e8\u05d4 ($3$\u2013$8$) (DSM p.708)."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05de\u05d5\u05d2\u05d3\u05e8 \u05d4\u05de\u05d5\u05e0\u05d7 Complicated Mild TBI \u05d5\u05de\u05d4\u05d9 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d5 \u05d4\u05e4\u05e8\u05d5\u05d2\u05e0\u05d5\u05e1\u05d8\u05d9\u05ea?",
      "back": "\u05e4\u05d2\u05d9\u05e2\u05d4 \u05d4\u05e2\u05d5\u05e0\u05d4 \u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05dc\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05e9\u05dc Mild TBI \u05d0\u05da \u05e2\u05dd \u05de\u05de\u05e6\u05d0 \u05e4\u05ea\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d1-CT/MRI; \u05d4\u05de\u05d4\u05dc\u05da \u05d3\u05d5\u05de\u05d4 \u05d9\u05d5\u05ea\u05e8 \u05dc-Moderate TBI (DSM p.707-708)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d8\u05d5\u05d5\u05d7 \u05d4\u05d6\u05de\u05df \u05d4\u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05d9 \u05dc\u05e8\u05d6\u05d5\u05dc\u05d5\u05e6\u05d9\u05d4 \u05de\u05dc\u05d0\u05d4 \u05e9\u05dc \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05dc\u05d0\u05d7\u05e8 Concussion (Uncomplicated mTBI)?",
      "back": "\u05e8\u05d5\u05d1 \u05d4\u05de\u05e7\u05e8\u05d9\u05dd \u05de\u05e9\u05ea\u05e4\u05e8\u05d9\u05dd \u05ea\u05d5\u05da \u05d9\u05de\u05d9\u05dd \u05e2\u05d3 \u05e9\u05d1\u05d5\u05e2\u05d5\u05ea, \u05e2\u05dd \u05d4\u05d7\u05dc\u05de\u05d4 \u05de\u05dc\u05d0\u05d4 \u05d1\u05ea\u05d5\u05da $3$\u2013$12$ \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd (DSM p.709)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05e4\u05ea\u05d5\u05e4\u05d9\u05d6\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05d1-CTE (Chronic Traumatic Encephalopathy) \u05d5\u05d0\u05d9\u05d6\u05d4 \u05d7\u05dc\u05d1\u05d5\u05df \u05de\u05e2\u05d5\u05e8\u05d1?",
      "back": "\u05e9\u05e7\u05d9\u05e2\u05d4 \u05e9\u05dc Tau protein \u05d4\u05d9\u05e4\u05e8-\u05e4\u05d5\u05e1\u05e4\u05d5\u05e8\u05d9\u05dc\u05d9\u05e8\u05d8\u05d9\u05d1\u05d9 (Tauopathy) \u05d1\u05e6\u05d5\u05e8\u05ea NFTs \u05d1\u05e2\u05d5\u05de\u05e7 \u05d4-cortical sulci (StahlNeuro p.576)."
    },
    {
      "front": "\u05d0\u05d9\u05d6\u05d4 \u05d0\u05d6\u05d5\u05e8 \u05de\u05d5\u05d7\u05d9 \u05e7\u05e9\u05d5\u05e8 \u05d1\u05d0\u05d5\u05e4\u05df \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9 \u05dc\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea Major Depressive Disorder \u05d0\u05e7\u05d5\u05d8\u05d9 \u05d1\u05d9\u05de\u05d9\u05dd \u05d4\u05e8\u05d0\u05e9\u05d5\u05e0\u05d9\u05dd \u05dc\u05d0\u05d7\u05e8 TBI \u05d0\u05d5 CVA?",
      "back": "\u05e0\u05d2\u05e2\u05d9\u05dd \u05d1\u05d0\u05d6\u05d5\u05e8 \u05d4-Left frontal (DSM p.208)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05e9\u05d9\u05e2\u05d5\u05e8 \u05d4-Suicidal ideation \u05d1\u05e7\u05e8\u05d1 \u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd \u05dc\u05d0\u05d7\u05e8 TBI \u05d1\u05de\u05d4\u05dc\u05da $20$ \u05d4\u05e9\u05e0\u05d9\u05dd \u05d4\u05e8\u05d0\u05e9\u05d5\u05e0\u05d5\u05ea \u05de\u05d4\u05e4\u05e6\u05d9\u05e2\u05d4?",
      "back": "\u05e9\u05d9\u05e2\u05d5\u05e8 \u05d4\u05de\u05d7\u05e9\u05d1\u05d5\u05ea \u05d4\u05d0\u05d5\u05d1\u05d3\u05e0\u05d9\u05d5\u05ea \u05e2\u05d5\u05de\u05d3 \u05e2\u05dc \u05db-$10\\%$ (DSM p.710)."
    },
    {
      "front": "\u05de\u05d4\u05dd \u05e9\u05dc\u05d5\u05e9\u05ea \u05d4-subtypes \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9\u05dd \u05e9\u05d9\u05e0\u05d5\u05d9 \u05d0\u05d9\u05e9\u05d9\u05d5\u05ea \u05e2\u05e7\u05d1 TBI \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR (F07.0)?",
      "back": "\u05e1\u05d5\u05d2 \u05d0\u05d3\u05d9\u05e9 (Apathetic), \u05d7\u05e1\u05e8 \u05e2\u05e7\u05d1\u05d5\u05ea (Disinhibited), \u05d5\u05d0\u05d2\u05e8\u05e1\u05d9\u05d1\u05d9 (Aggressive) (DSM p.707, p.777)."
    },
    {
      "front": "\u05d1\u05d0\u05d1\u05d7\u05e0\u05d4 \u05de\u05d1\u05d3\u05dc\u05ea \u05d1\u05d9\u05df PTSD \u05dc\u05d1\u05d9\u05df TBI, \u05d0\u05d9\u05dc\u05d5 \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9\u05d9\u05dd \u05d9\u05d9\u05d7\u05d5\u05d3\u05d9\u05d9\u05dd \u05d9\u05d5\u05ea\u05e8 \u05dc-TBI?",
      "back": "\u05d1\u05dc\u05d1\u05d5\u05dc (Confusion) \u05d5\u05d3\u05d9\u05e1\u05d0\u05d5\u05e8\u05d9\u05d9\u05e0\u05d8\u05e6\u05d9\u05d4 (Disorientation) \u05de\u05ea\u05de\u05e9\u05db\u05d9\u05dd (DSM p.312)."
    },
    {
      "front": "\u05d0\u05d9\u05dc\u05d5 \u05d3\u05d5\u05de\u05d9\u05d9\u05e0\u05d9\u05dd \u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9\u05d9\u05dd \u05d4\u05dd \u05d4\u05e4\u05d2\u05d9\u05e2\u05d9\u05dd \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d1-Neuropsychological testing \u05e9\u05dc \u05d7\u05d5\u05dc\u05d9 TBI?",
      "back": "\u05de\u05d4\u05d9\u05e8\u05d5\u05ea \u05e2\u05d9\u05d1\u05d5\u05d3 (Processing speed), \u05e7\u05e9\u05d1 \u05de\u05d5\u05e8\u05db\u05d1 (Complex attention), \u05d5\u05d6\u05d9\u05db\u05e8\u05d5\u05df \u05e2\u05d1\u05d5\u05d3\u05d4 (DSM p.708)."
    },
    {
      "front": "\u05e6\u05d9\u05d9\u05df $3$ \u05d2\u05d5\u05e8\u05de\u05d9 \u05e1\u05d9\u05db\u05d5\u05df (Risk factors) \u05dc\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea \u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05dc\u05d0\u05d7\u05e8 TBI.",
      "back": "\u05de\u05d9\u05df \u05e0\u05e7\u05d1\u05d4, \u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4 \u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9\u05ea \u05e7\u05d5\u05d3\u05de\u05ea, \u05d0\u05d1\u05d8\u05dc\u05d4, \u05d5\u05e0\u05e4\u05d7 \u05de\u05d5\u05d7 \u05e7\u05d8\u05df (DSM p.208)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05de\u05e9\u05da \u05d4-Posttraumatic amnesia (PTA) \u05d4\u05de\u05d2\u05d3\u05d9\u05e8 \u05e4\u05d2\u05d9\u05e2\u05d4 \u05db-Severe TBI?",
      "back": "\u05de\u05e9\u05da PTA \u05e9\u05dc $\\ge 7$ \u05d9\u05de\u05d9\u05dd (DSM p.708)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05d3\u05de\u05d9\u05d9\u05ea \u05d4\u05d1\u05d7\u05d9\u05e8\u05d4 (First choice) \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d5\u05e0\u05d5\u05e2\u05e8 \u05dc\u05d4\u05e2\u05e8\u05db\u05ea \u05e0\u05d6\u05e7 \u05de\u05d5\u05d7\u05d9 \u05de\u05d1\u05e0\u05d9 \u05dc\u05d0-\u05d3\u05d7\u05d5\u05e3, \u05d5\u05de\u05d3\u05d5\u05e2?",
      "back": "MRI, \u05d1\u05e9\u05dc \u05e8\u05d6\u05d5\u05dc\u05d5\u05e6\u05d9\u05d4 \u05d2\u05d1\u05d5\u05d4\u05d4 \u05e9\u05dc \u05d7\u05d5\u05de\u05e8 \u05dc\u05d1\u05df/\u05d0\u05e4\u05d5\u05e8 \u05d5\u05d4\u05d9\u05e2\u05d3\u05e8 \u05d7\u05e9\u05d9\u05e4\u05d4 \u05dc\u05e7\u05e8\u05d9\u05e0\u05d4 \u05de\u05d9\u05d9\u05e0\u05e0\u05ea (Dulcan p.98)."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05de\u05e9\u05e4\u05d9\u05e2 \u05e7\u05d9\u05d5\u05dd \u05e9\u05dc Substance use disorder \u05e2\u05dc \u05d4\u05de\u05d4\u05dc\u05da \u05e9\u05dc TBI?",
      "back": "\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05d7\u05d5\u05de\u05e8\u05d9\u05dd \u05de\u05d7\u05de\u05d9\u05e8 \u05d5\u05de\u05ea\u05d2\u05d1\u05e8 (compounds) \u05d0\u05ea \u05d4\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05d4\u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9\u05d5\u05ea \u05d4\u05e7\u05e9\u05d5\u05e8\u05d5\u05ea \u05dc\u05d7\u05d1\u05dc\u05d4 (DSM p.712)."
    },
    {
      "front": "\u05de\u05d4 \u05e2\u05e9\u05d5\u05d9\u05d4 \u05dc\u05d9\u05d9\u05e6\u05d2 \u05d4\u05dc\u05d9\u05db\u05d4 \u05e2\u05dc \u05d4\u05d1\u05d4\u05d5\u05e0\u05d5\u05ea (Toe walking) \u05d1\u05ea\u05e6\u05e4\u05d9\u05ea \u05d4-Gait \u05d1\u05d1\u05d3\u05d9\u05e7\u05d4 \u05e0\u05d5\u05d9\u05e8\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea \u05e9\u05dc \u05d9\u05dc\u05d3?",
      "back": "\u05e1\u05d9\u05de\u05df \u05d0\u05e4\u05e9\u05e8\u05d9 \u05dc-Lower-extremity spasticity (Dulcan p.92)."
    },
    {
      "front": "\u05de\u05d4\u05dd \u05e9\u05dc\u05d5\u05e9\u05ea \u05d0\u05e9\u05db\u05d5\u05dc\u05d5\u05ea \u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d4\u05de\u05d2\u05d3\u05d9\u05e8\u05d9\u05dd \u05d0\u05ea \u05d4-Post-concussion syndrome?",
      "back": "\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e1\u05d5\u05de\u05d8\u05d9\u05d9\u05dd (\u05db\u05d0\u05d1\u05d9 \u05e8\u05d0\u05e9), \u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9\u05d9\u05dd (\u05e8\u05d9\u05db\u05d5\u05d6), \u05d5\u05e8\u05d2\u05e9\u05d9\u05d9\u05dd (\u05e2\u05e6\u05d1\u05e0\u05d5\u05ea, \u05d7\u05e8\u05d3\u05d4) (DSM p.709)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05de\u05e9\u05da \u05d0\u05d5\u05d1\u05d3\u05df \u05d4\u05d4\u05db\u05e8\u05d4 (LOC) \u05d4\u05de\u05e7\u05e1\u05d9\u05de\u05dc\u05d9 \u05d4\u05de\u05d5\u05d2\u05d3\u05e8 \u05ea\u05d7\u05ea \u05d4\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4 \u05e9\u05dc Mild TBI?",
      "back": "\u05e2\u05d3 $30$ \u05d3\u05e7\u05d5\u05ea ($\\le 30$ min) (DSM p.708)."
    },
    {
      "front": "\u05dc\u05e4\u05d9 StahlNeuro, \u05de\u05d4\u05d9 \u05d4\u05d4\u05e9\u05dc\u05db\u05d4 \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05e9\u05dc \u05e2\u05d5\u05d3\u05e3 Dopamine \u05d1\u05de\u05e1\u05dc\u05d5\u05dc \u05d4-Nigrostriatal?",
      "back": "\u05d4\u05d5\u05e4\u05e2\u05ea \u05ea\u05e0\u05d5\u05e2\u05d5\u05ea \u05d4\u05d9\u05e4\u05e8\u05e7\u05d9\u05e0\u05d8\u05d9\u05d5\u05ea \u05db\u05d2\u05d5\u05df tics \u05d5-dyskinesias (StahlNeuro p.147)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05d4\u05d2\u05d3\u05e8\u05d4 \u05e9\u05dc Coma \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR?",
      "back": "\u05de\u05e6\u05d1 \u05e9\u05dc \u05d7\u05d5\u05e1\u05e8 \u05d4\u05db\u05e8\u05d4 \u05dc\u05dc\u05d0 \u05e7\u05d5\u05d2\u05e0\u05d9\u05e6\u05d9\u05d4 \u05d0\u05d5 \u05de\u05d7\u05d6\u05d5\u05e8 \u05e9\u05d9\u05e0\u05d4-\u05e2\u05e8\u05d5\u05ea, \u05d5\u05dc\u05dc\u05d0 \u05ea\u05d2\u05d5\u05d1\u05d4 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05dc\u05d2\u05d9\u05e8\u05d5\u05d9 \u05de\u05d9\u05dc\u05d5\u05dc\u05d9 \u05d0\u05d5 \u05e4\u05d9\u05d6\u05d9 (DSM p.676)."
    }
  ]
}