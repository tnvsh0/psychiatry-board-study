    {
      "type": "multiple_choice",
      "question": "\u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05e2\u05e8\u05db\u05ea ADHD, \u05d4\u05e7\u05dc\u05d9\u05e0\u05d0\u05d9 \u05de\u05d6\u05d4\u05d4 minor physical anomalies \u05db\u05de\u05d5 hypertelorism \u05d5-low-set ears. \u05e2\u05dc \u05e4\u05d9 \u05d4-DSM-5-TR, \u05de\u05d4\u05d9 \u05d4\u05de\u05e9\u05de\u05e2\u05d5\u05ea \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05e9\u05dc \u05de\u05de\u05e6\u05d0\u05d9\u05dd \u05d0\u05dc\u05d5 (DSM p. 71)?",
      "answerOptions": [
