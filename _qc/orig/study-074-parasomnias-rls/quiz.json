    {
      "type": "short_answer",
      "question": "\u05d4\u05e1\u05d1\u05d9\u05e8\u05d5 \u05d0\u05ea \u05d4\u05d4\u05d1\u05d3\u05dc \u05d4\u05e2\u05d9\u05e7\u05e8\u05d9 \u05d1\u05d9\u05df \u05d4\u05de\u05de\u05e6\u05d0\u05d9\u05dd \u05d1\u05d1\u05d3\u05d9\u05e7\u05ea Multiple Sleep Latency Test (MSLT) \u05d0\u05e6\u05dc \u05d7\u05d5\u05dc\u05d4 \u05e2\u05dd Narcolepsy \u05dc\u05e2\u05d5\u05de\u05ea \u05d7\u05d5\u05dc\u05d4 \u05e2\u05dd Idiopathic Hypersomnia \u05dc\u05e4\u05d9 \u05d4-StahlNeuro \u05d5\u05d4-Dulcan.",
      "grading": {
        "modelAnswer": "\u05d1-Narcolepsy, \u05d1\u05d3\u05d9\u05e7\u05ea \u05d4-MSLT \u05ea\u05d3\u05d2\u05d9\u05dd \u05d7\u05d1\u05d9\u05d5\u05df \u05e9\u05d9\u05e0\u05d4 \u05e7\u05e6\u05e8 (pathological sleepiness) \u05d9\u05d7\u05d3 \u05e2\u05dd \u05dc\u05e4\u05d7\u05d5\u05ea \u05e9\u05e0\u05d9 \u05e4\u05e8\u05e7\u05d9 \u05e9\u05d9\u05e0\u05d4 \u05d4\u05de\u05ea\u05d7\u05d9\u05dc\u05d9\u05dd \u05d1-REM (\u05d4\u05d9\u05d3\u05d5\u05e2\u05d9\u05dd \u05db-SOREMPs). \u05dc\u05e2\u05d5\u05de\u05ea \u05d6\u05d0\u05ea, \u05d1-Idiopathic Hypersomnia \u05e0\u05e8\u05d0\u05d4 \u05d7\u05d1\u05d9\u05d5\u05df \u05e9\u05d9\u05e0\u05d4 \u05e7\u05e6\u05e8 \u05d0\u05da \u05e2\u05dd \u05e4\u05d7\u05d5\u05ea \u05de\u05e9\u05e0\u05d9 SOREMPs. (StahlNeuro p.421, Dulcan p.484)",
        "rationale": "\u05d4\u05d4\u05d1\u05d3\u05dc \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05d1\u05de\u05e2\u05d1\u05d3\u05ea \u05d4\u05e9\u05d9\u05e0\u05d4 \u05d4\u05d5\u05d0 \u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05d0\u05d5 \u05d4\u05d9\u05e2\u05d3\u05e8 \u05e9\u05dc \u05db\u05e0\u05d9\u05e1\u05d4 \u05de\u05d4\u05d9\u05e8\u05d4 \u05dc\u05e9\u05e0\u05ea REM, \u05d4\u05de\u05e9\u05e7\u05e4\u05ea \u05d0\u05ea \u05d4\u05e4\u05ea\u05d5\u05e4\u05d9\u05d6\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05d4 \u05d4\u05e9\u05d5\u05e0\u05d4 \u05e9\u05dc \u05d4\u05de\u05d7\u05dc\u05d5\u05ea. (StahlNeuro p.421)",
        "requiredAttributes": [
          "\u05e6\u05d9\u05d5\u05df \u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05e9\u05dc 2 \u05d0\u05d5 \u05d9\u05d5\u05ea\u05e8 SOREMPs \u05d1\u05e0\u05e8\u05e7\u05d5\u05dc\u05e4\u05e1\u05d9\u05d4.",
          "\u05e6\u05d9\u05d5\u05df \u05d4\u05d9\u05e2\u05d3\u05e8 (\u05e4\u05d7\u05d5\u05ea \u05de-2) SOREMPs \u05d1-Idiopathic Hypersomnia.",
          "\u05d4\u05ea\u05d9\u05d9\u05d7\u05e1\u05d5\u05ea \u05dc\u05d7\u05d1\u05d9\u05d5\u05df \u05e9\u05d9\u05e0\u05d4 \u05e7\u05e6\u05e8 \u05d1\u05e9\u05e0\u05d9 \u05d4\u05de\u05e6\u05d1\u05d9\u05dd."
        ],
        "errors": {
          "misconceptions": [
            "\u05d4\u05e0\u05d7\u05d4 \u05e9\u05d1\u05e0\u05e8\u05e7\u05d5\u05dc\u05e4\u05e1\u05d9\u05d4 \u05d7\u05d1\u05d9\u05d5\u05df \u05d4\u05e9\u05d9\u05e0\u05d4 \u05d0\u05e8\u05d5\u05da \u05d9\u05d5\u05ea\u05e8.",
            "\u05d1\u05dc\u05d1\u05d5\u05dc \u05d1\u05d9\u05df SOREMPs \u05dc\u05d1\u05d9\u05df \u05d0\u05d8\u05d5\u05e0\u05d9\u05d4 \u05d1-RBD."
          ],
          "bluffs": [
            "\u05d3\u05d9\u05d1\u05d5\u05e8 \u05db\u05dc\u05dc\u05d9 \u05e2\u05dc \u05e2\u05d9\u05d9\u05e4\u05d5\u05ea \u05dc\u05dc\u05d0 \u05d4\u05ea\u05d9\u05d9\u05d7\u05e1\u05d5\u05ea \u05dc\u05de\u05de\u05e6\u05d0\u05d9 \u05d4-MSLT \u05d4\u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05d9\u05dd."
          ]
        }
      },
      "hint": "\u05d4\u05ea\u05de\u05e7\u05d3\u05d5 \u05d1\u05de\u05e1\u05e4\u05e8 \u05d4-Sleep Onset REM Periods (SOREMPs) \u05d4\u05de\u05d5\u05e4\u05d9\u05e2\u05d9\u05dd \u05d1\u05d1\u05d3\u05d9\u05e7\u05d4."
    },
    {
      "type": "multiple_choice",
      "question": "\u05d0\u05d9\u05d6\u05d5 \u05de\u05d4\u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05d4\u05d1\u05d0\u05d5\u05ea \u05e0\u05d7\u05e9\u05d1\u05ea \u05dc\u05d0\u05d5\u05e4\u05e6\u05d9\u05d4 \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Nightmare Disorder, \u05d1\u05de\u05d9\u05d5\u05d7\u05d3 \u05d1\u05de\u05e7\u05e8\u05d9\u05dd \u05d4\u05e7\u05e9\u05d5\u05e8\u05d9\u05dd \u05dc-PTSD, \u05d1\u05e9\u05dc \u05d4\u05e9\u05e4\u05e2\u05ea\u05d4 \u05e2\u05dc \u05d4\u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05d0\u05d3\u05e8\u05e0\u05e8\u05d2\u05d9\u05ea (\u05dc\u05e4\u05d9 \u05d4-Dulcan \u05d5\u05d4\u05e1\u05d9\u05dc\u05d1\u05d5\u05e1)?",
      "answerOptions": [
        {
          "text": "Prazosin.",
          "isCorrect": true,
          "rationale": "Prazosin \u05d4\u05d5\u05d0 $\\\\alpha_{1}$-blocker \u05d4\u05de\u05e4\u05d7\u05d9\u05ea \u05d0\u05ea \u05ea\u05d3\u05d9\u05e8\u05d5\u05ea \u05d4\u05e1\u05d9\u05d5\u05d8\u05d9\u05dd \u05d1-PTSD \u05d3\u05e8\u05da \u05d4\u05e4\u05d7\u05ea\u05ea \u05e2\u05d5\u05e8\u05e8\u05d5\u05ea \u05d9\u05ea\u05e8 \u05e1\u05d9\u05de\u05e4\u05ea\u05d8\u05d9\u05ea. (\u05de\u05e7\u05d5\u05e8: \u05d4\u05e7\u05e9\u05e8 \u05e8\u05d7\u05d1/\u05e1\u05d9\u05dc\u05d1\u05d5\u05e1, Dulcan p.495)"
        },
        {
          "text": "L-Dopa.",
          "isCorrect": false,
          "rationale": "L-Dopa \u05de\u05e9\u05de\u05e9 \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-RLS \u05d5\u05d1\u05e4\u05e8\u05e7\u05d9\u05e0\u05e1\u05d5\u05df, \u05d5\u05e2\u05dc\u05d5\u05dc \u05d3\u05d5\u05d5\u05e7\u05d0 \u05dc\u05d4\u05d7\u05de\u05d9\u05e8 \u05d7\u05dc\u05d5\u05de\u05d5\u05ea \u05d7\u05d9\u05d9\u05dd \u05d0\u05d5 \u05d4\u05d6\u05d9\u05d5\u05ea. (Dulcan p.486)"
        },
        {
          "text": "Modafinil.",
          "isCorrect": false,
          "rationale": "Modafinil \u05d4\u05d5\u05d0 \u05d7\u05d5\u05de\u05e8 \u05de\u05e2\u05d5\u05e8\u05e8 \u05d4\u05de\u05e9\u05de\u05e9 \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05e0\u05e8\u05e7\u05d5\u05dc\u05e4\u05e1\u05d9\u05d4 \u05d5\u05d0\u05d9\u05e0\u05d5 \u05de\u05d9\u05d5\u05e2\u05d3 \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05e1\u05d9\u05d5\u05d8\u05d9 \u05dc\u05d9\u05dc\u05d4. (Dulcan p.484)"
        },
        {
          "text": "Melatonin.",
          "isCorrect": false,
          "rationale": "\u05de\u05dc\u05d8\u05d5\u05e0\u05d9\u05df \u05de\u05e1\u05d9\u05d9\u05e2 \u05d1\u05e7\u05d9\u05e6\u05d5\u05e8 \u05d7\u05d1\u05d9\u05d5\u05df \u05d4\u05e9\u05d9\u05e0\u05d4 (SOL) \u05d0\u05da \u05d0\u05d9\u05e0\u05d5 \u05e0\u05d7\u05e9\u05d1 \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05d1\u05d7\u05d9\u05e8\u05d4 \u05d4\u05e1\u05e4\u05e6\u05d9\u05e4\u05d9 \u05dc\u05e1\u05d9\u05d5\u05d8\u05d9\u05dd \u05d4\u05e7\u05e9\u05d5\u05e8\u05d9\u05dd \u05dc\u05d8\u05e8\u05d0\u05d5\u05de\u05d4. (Dulcan p.482)"
        }
      ],
      "hint": "\u05d7\u05e4\u05e9\u05d5 \u05ea\u05e8\u05d5\u05e4\u05d4 \u05d4\u05e4\u05d5\u05e2\u05dc\u05ea \u05db\u05d7\u05e1\u05dd \u05dc\u05e7\u05d5\u05dc\u05d8\u05e0\u05d9\u05dd \u05d0\u05dc\u05e4\u05d0-\u05d0\u05d3\u05e8\u05e0\u05e8\u05d2\u05d9\u05d9\u05dd."
    },
    {
      "type": "multiple_choice",
      "question": "\u05de\u05ea\u05d1\u05d2\u05e8 \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05d1-Fluoxetine \u05d1\u05e9\u05dc \u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05de\u05d3\u05d5\u05d5\u05d7 \u05e2\u05dc \u05d4\u05d7\u05de\u05e8\u05d4 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05d1\u05ea\u05e1\u05de\u05d9\u05e0\u05d9 RLS \u05d5\u05e7\u05d5\u05e9\u05d9 \u05e8\u05d1 \u05dc\u05d4\u05d9\u05e8\u05d3\u05dd \u05d1\u05e9\u05dc \u05db\u05da. \u05de\u05d4\u05d5 \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05de\u05d5\u05e6\u05e2 \u05dc\u05d4\u05d7\u05de\u05e8\u05ea RLS \u05e2\u05dc \u05d9\u05d3\u05d9 \u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05de\u05e1\u05d5\u05d2 SSRI \u05dc\u05e4\u05d9 \u05d4-Dulcan?",
      "answerOptions": [
        {
          "text": "\u05e2\u05d9\u05db\u05d5\u05d1 \u05d4\u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05d3\u05d5\u05e4\u05de\u05d9\u05e0\u05e8\u05d2\u05d9\u05ea \u05db\u05ea\u05d5\u05e6\u05d0\u05d4 \u05de\u05e2\u05dc\u05d9\u05d9\u05d4 \u05d1\u05e8\u05de\u05d5\u05ea \u05d4\u05e1\u05e8\u05d5\u05d8\u05d5\u05e0\u05d9\u05df.",
          "isCorrect": true,
          "rationale": "\u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05de\u05e1\u05d5\u05d2 SSRI \u05e2\u05dc\u05d5\u05dc\u05d5\u05ea \u05dc\u05d4\u05d7\u05de\u05d9\u05e8 RLS \u05d1\u05e9\u05dc \u05d0\u05d9\u05e0\u05d8\u05e8\u05d0\u05e7\u05e6\u05d9\u05d4 \u05d1\u05d9\u05df \u05e1\u05e8\u05d5\u05d8\u05d5\u05e0\u05d9\u05df \u05dc\u05d3\u05d5\u05e4\u05de\u05d9\u05df, \u05d4\u05de\u05d5\u05d1\u05d9\u05dc\u05d4 \u05dc\u05e2\u05d9\u05db\u05d5\u05d1 \u05e2\u05e7\u05d9\u05e3 \u05e9\u05dc \u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05d3\u05d5\u05e4\u05de\u05d9\u05e0\u05e8\u05d2\u05d9\u05ea \u05d4\u05e0\u05d3\u05e8\u05e9\u05ea \u05dc\u05de\u05e0\u05d9\u05e2\u05ea \u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd. (Dulcan p.486)"
        },
        {
          "text": "\u05d7\u05e1\u05d9\u05de\u05d4 \u05d9\u05e9\u05d9\u05e8\u05d4 \u05e9\u05dc \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 D2 \u05d1-Striatum.",
          "isCorrect": false,
          "rationale": "\u05d7\u05e1\u05d9\u05de\u05d4 \u05d9\u05e9\u05d9\u05e8\u05d4 \u05e9\u05dc \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 D2 \u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05ea \u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05d0\u05e0\u05d8\u05d9-\u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9\u05d5\u05ea (Antipsychotics) \u05d5\u05dc\u05d0 SSRIs. (StahlNeuro p.147)"
        },
        {
          "text": "\u05d9\u05e8\u05d9\u05d3\u05d4 \u05d1\u05e8\u05de\u05d5\u05ea \u05d4\u05d1\u05e8\u05d6\u05dc (Ferritin) \u05d1\u05d3\u05dd.",
          "isCorrect": false,
          "rationale": "SSRIs \u05d0\u05d9\u05e0\u05dd \u05de\u05e9\u05e4\u05d9\u05e2\u05d9\u05dd \u05d9\u05e9\u05d9\u05e8\u05d5\u05ea \u05e2\u05dc \u05de\u05d0\u05d2\u05e8\u05d9 \u05d4\u05d1\u05e8\u05d6\u05dc \u05d1\u05d2\u05d5\u05e3. (Dulcan p.486)"
        },
        {
          "text": "\u05e2\u05dc\u05d9\u05d9\u05d4 \u05d1\u05dc\u05d7\u05e5 \u05d4\u05d3\u05dd \u05d4\u05dc\u05d9\u05dc\u05d9 \u05d4\u05d2\u05d5\u05e8\u05de\u05ea \u05dc-peripheral ischemia.",
          "isCorrect": false,
          "rationale": "\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d6\u05d4 \u05d0\u05d9\u05e0\u05d5 \u05e7\u05e9\u05d5\u05e8 \u05dc\u05e4\u05ea\u05d5\u05e4\u05d9\u05d6\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05d4 \u05d4\u05de\u05d5\u05db\u05e8\u05ea \u05e9\u05dc RLS \u05d0\u05d5 \u05dc\u05d4\u05e9\u05e4\u05e2\u05d4 \u05e9\u05dc Fluoxetine. (DSM p.467)"
        }
      ],
      "hint": "\u05d7\u05e9\u05d1\u05d5 \u05e2\u05dc \u05d4\u05d0\u05d9\u05d6\u05d5\u05df \u05d4\u05e2\u05d3\u05d9\u05df \u05d1\u05d9\u05df \u05d4\u05d5\u05dc\u05db\u05d4 \u05e1\u05e8\u05d5\u05d8\u05d5\u05e0\u05d9\u05e0\u05e8\u05d2\u05d9\u05ea \u05dc\u05d3\u05d5\u05e4\u05de\u05d9\u05e0\u05e8\u05d2\u05d9\u05ea \u05d1\u05de\u05d5\u05d7."
    }
  ]
}