{
  "title": "Psychiatry Quiz",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\u05de\u05d8\u05d5\u05e4\u05dc\u05ea \u05d1\u05ea 68, \u05d4\u05de\u05d0\u05d5\u05d1\u05d7\u05e0\u05ea \u05e2\u05dd Schizophrenia, \u05de\u05d8\u05d5\u05e4\u05dc\u05ea \u05d1-Haloperidol \u05d1\u05de\u05d9\u05e0\u05d5\u05df \u05e9\u05dc $5~mg/day$ \u05de\u05d6\u05d4 \u05db\u05d7\u05d5\u05d3\u05e9\u05d9\u05d9\u05dd. \u05d1\u05de\u05d4\u05dc\u05da \u05d1\u05d9\u05e7\u05d5\u05e8\u05ea \u05d1\u05de\u05e8\u05e4\u05d0\u05d4, \u05d4\u05e8\u05d5\u05e4\u05d0 \u05de\u05d1\u05d7\u05d9\u05df \u05d1\u05ea\u05e0\u05d5\u05e2\u05d5\u05ea \u05dc\u05e2\u05d9\u05e1\u05d4 \u05d1\u05dc\u05ea\u05d9 \u05e8\u05e6\u05d5\u05e0\u05d9\u05d5\u05ea (Chewing movements) \u05d5\u05e9\u05e8\u05d1\u05d5\u05d1 \u05e9\u05e4\u05ea\u05d9\u05d9\u05dd. \u05d4\u05de\u05d8\u05d5\u05e4\u05dc\u05ea \u05d0\u05d9\u05e0\u05d4 \u05de\u05ea\u05dc\u05d5\u05e0\u05e0\u05ea \u05e2\u05dc \u05d0\u05d9-\u05e9\u05e7\u05d8 \u05d0\u05d5 \u05e0\u05d5\u05e7\u05e9\u05d5\u05ea. \u05de\u05d4\u05d9 \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05e1\u05d1\u05d9\u05e8\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d5\u05de\u05d4\u05d5 \u05e1\u05e3 \u05de\u05e9\u05da \u05d4\u05d7\u05e9\u05d9\u05e4\u05d4 \u05d4\u05e0\u05d3\u05e8\u05e9 \u05dc\u05e7\u05d1\u05d9\u05e2\u05ea\u05d4 \u05d1\u05d0\u05d5\u05db\u05dc\u05d5\u05e1\u05d9\u05d9\u05d4 \u05d6\u05d5?",
      "answerOptions": [
        {
          "text": "Tardive Dyskinesia; \u05e0\u05d3\u05e8\u05e9 \u05d7\u05d5\u05d3\u05e9 \u05d0\u05d7\u05d3 \u05e9\u05dc \u05d7\u05e9\u05d9\u05e4\u05d4.",
          "isCorrect": true,
          "rationale": "\u05dc\u05e4\u05d9 \u05d4-DSM-5-TR, \u05e2\u05d1\u05d5\u05e8 \u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd \u05d1\u05e0\u05d9 60 \u05d5\u05de\u05e2\u05dc\u05d4, \u05e1\u05e3 \u05d4\u05d7\u05e9\u05d9\u05e4\u05d4 \u05d4\u05de\u05d9\u05e0\u05d9\u05de\u05dc\u05d9 \u05dc-DRBA \u05d4\u05e0\u05d3\u05e8\u05e9 \u05dc\u05d0\u05d1\u05d7\u05e0\u05ea TD \u05d4\u05d5\u05d0 \u05d7\u05d5\u05d3\u05e9 \u05d0\u05d7\u05d3 \u05d1\u05dc\u05d1\u05d3, \u05d1\u05e9\u05d5\u05e0\u05d4 \u05de-3 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05d1\u05e9\u05d0\u05e8 \u05d4\u05d0\u05d5\u05db\u05dc\u05d5\u05e1\u05d9\u05d9\u05d4 (DSM p.815)."
        },
        {
          "text": "Tardive Dyskinesia; \u05e0\u05d3\u05e8\u05e9\u05d9\u05dd \u05e9\u05dc\u05d5\u05e9\u05d4 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05e9\u05dc \u05d7\u05e9\u05d9\u05e4\u05d4.",
          "isCorrect": false,
          "rationale": "\u05d0\u05de\u05e0\u05dd 3 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05d4\u05d5\u05d0 \u05d4\u05e1\u05e3 \u05d4\u05e1\u05d8\u05e0\u05d3\u05e8\u05d8\u05d9, \u05d0\u05da \u05d1\u05e7\u05e8\u05d1 \u05e7\u05e9\u05d9\u05e9\u05d9\u05dd (\u05de\u05e2\u05dc \u05d2\u05d9\u05dc 60) \u05d4\u05e1\u05e3 \u05de\u05e7\u05d5\u05e6\u05e8 \u05e2\u05e7\u05d1 \u05e4\u05d2\u05d9\u05e2\u05d5\u05ea \u05de\u05d5\u05d2\u05d1\u05e8\u05ea \u05e9\u05dc \u05d4\u05de\u05d5\u05d7 (DSM p.815)."
        },
        {
          "text": "Medication-Induced Parkinsonism (DIP); \u05e0\u05d3\u05e8\u05e9\u05d9\u05dd \u05e9\u05d1\u05d5\u05e2\u05d9\u05d9\u05dd \u05e9\u05dc \u05d7\u05e9\u05d9\u05e4\u05d4.",
          "isCorrect": false,
          "rationale": "\u05d4\u05ea\u05de\u05d5\u05e0\u05d4 \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05de\u05ea\u05d0\u05e8\u05ea \u05ea\u05e0\u05d5\u05e2\u05d5\u05ea \u05d4\u05d9\u05e4\u05e8\u05e7\u05d9\u05e0\u05d8\u05d9\u05d5\u05ea \u05d0\u05d5\u05e8\u05d5\u05e4\u05e6\u05d9\u05d0\u05dc\u05d9\u05d5\u05ea \u05dc\u05dc\u05d0 \u05e0\u05d5\u05e7\u05e9\u05d5\u05ea \u05d0\u05d5 \u05e8\u05e2\u05d3 \u05e8\u05d9\u05ea\u05de\u05d9 \u05d1\u05de\u05e0\u05d5\u05d7\u05d4, \u05de\u05d4 \u05e9\u05de\u05ea\u05d0\u05d9\u05dd \u05dc-TD \u05d5\u05dc\u05d0 \u05dc-DIP (DSM p.815)."
        },
        {
          "text": "Acute Dystonia; \u05e0\u05d3\u05e8\u05e9\u05d9\u05dd \u05de\u05e1\u05e4\u05e8 \u05d9\u05de\u05d9\u05dd \u05e9\u05dc \u05d7\u05e9\u05d9\u05e4\u05d4.",
          "isCorrect": false,
          "rationale": "\u05d3\u05d9\u05e1\u05d8\u05d5\u05e0\u05d9\u05d4 \u05d0\u05e7\u05d5\u05d8\u05d9\u05ea \u05de\u05ea\u05d1\u05d8\u05d0\u05ea \u05d1\u05db\u05d9\u05d5\u05d5\u05e5 \u05e9\u05e8\u05d9\u05e8\u05d9\u05dd \u05de\u05de\u05d5\u05e9\u05da \u05d5\u05de\u05db\u05d0\u05d9\u05d1 \u05d4\u05de\u05d5\u05e4\u05d9\u05e2 \u05dc\u05e8\u05d5\u05d1 \u05d1\u05ea\u05d7\u05d9\u05dc\u05ea \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc, \u05d5\u05dc\u05d0 \u05d1\u05ea\u05e0\u05d5\u05e2\u05d5\u05ea \u05d3\u05d9\u05e1\u05e7\u05d9\u05e0\u05d8\u05d9\u05d5\u05ea \u05e7\u05e6\u05d1\u05d9\u05d5\u05ea \u05dc\u05d0\u05d7\u05e8 \u05d7\u05d5\u05d3\u05e9\u05d9\u05d9\u05dd (DSM p.812)."
        }
      ],
      "hint": "\u05e9\u05d9\u05de\u05d5 \u05dc\u05d1 \u05dc\u05d4\u05d1\u05d3\u05dc \u05d1\u05e1\u05e4\u05d9 \u05d4\u05d6\u05de\u05df \u05e9\u05e7\u05d5\u05d1\u05e2 \u05d4-DSM \u05d1\u05d9\u05df \u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd \u05e6\u05e2\u05d9\u05e8\u05d9\u05dd \u05dc\u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd \u05de\u05e2\u05dc \u05d2\u05d9\u05dc 60.",
      "metadata": {
        "source": "DSM p.815"
      }
    },
    {
      "type": "multiple_select",
      "question": "\u05d1\u05de\u05d4\u05dc\u05da \u05ea\u05db\u05e0\u05d5\u05df \u05e4\u05e8\u05d5\u05d8\u05d5\u05e7\u05d5\u05dc \u05e0\u05d9\u05d8\u05d5\u05e8 \u05d5\u05d1\u05d8\u05d9\u05d7\u05d5\u05ea \u05dc\u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd \u05d4\u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd \u05d1\u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05d7\u05d5\u05e1\u05de\u05d5\u05ea \u05d3\u05d5\u05e4\u05de\u05d9\u05df (DRBAs), \u05d0\u05d9\u05dc\u05d5 \u05de\u05d4\u05d1\u05d0\u05d9\u05dd \u05e0\u05d7\u05e9\u05d1\u05d9\u05dd \u05dc\u05d2\u05d5\u05e8\u05de\u05d9 \u05e1\u05d9\u05db\u05d5\u05df \u05de\u05d1\u05d5\u05e1\u05e1\u05d9\u05dd \u05dc\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea Tardive Dyskinesia?",
      "answerOptions": [
        {
          "text": "\u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc Major Depressive Disorder (MDD).",
          "isCorrect": true,
          "rationale": "\u05d4-DSM \u05de\u05e6\u05d9\u05d9\u05df \u05db\u05d9 \u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05e8\u05d5\u05d7, \u05d5\u05d1\u05de\u05d9\u05d5\u05d7\u05d3 MDD, \u05de\u05d4\u05d5\u05d5\u05ea \u05d2\u05d5\u05e8\u05dd \u05e1\u05d9\u05db\u05d5\u05df \u05e2\u05e6\u05de\u05d0\u05d9 \u05dc\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea TD (DSM p.815)."
        },
        {
          "text": "\u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05e9\u05dc Type 2 Diabetes Mellitus.",
          "isCorrect": true,
          "rationale": "\u05e1\u05d5\u05db\u05e8\u05ea \u05de\u05e1\u05d5\u05d2 2 \u05d6\u05d5\u05d4\u05ea\u05d4 \u05d1\u05de\u05d7\u05e7\u05e8\u05d9\u05dd \u05d0\u05e4\u05d9\u05d3\u05de\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05d9\u05dd \u05db\u05d2\u05d5\u05e8\u05dd \u05d4\u05de\u05e2\u05dc\u05d4 \u05d0\u05ea \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05d3\u05d9\u05e1\u05e7\u05d9\u05e0\u05d6\u05d9\u05d4 \u05de\u05d0\u05d5\u05d7\u05e8\u05ea (DSM p.815)."
        },
        {
          "text": "\u05d4\u05d5\u05e4\u05e2\u05d4 \u05de\u05d5\u05e7\u05d3\u05de\u05ea \u05e9\u05dc Extrapyramidal Side Effects (EPS) \u05d0\u05e7\u05d5\u05d8\u05d9\u05d9\u05dd.",
          "isCorrect": true,
          "rationale": "\u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd \u05d4\u05de\u05e4\u05ea\u05d7\u05d9\u05dd EPS \u05d0\u05e7\u05d5\u05d8\u05d9, \u05db\u05de\u05d5 DIP, \u05d1\u05ea\u05d7\u05d9\u05dc\u05ea \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05e0\u05de\u05e6\u05d0\u05d9\u05dd \u05d1\u05e1\u05d9\u05db\u05d5\u05df \u05d2\u05d1\u05d5\u05d4 \u05d9\u05d5\u05ea\u05e8 \u05dc\u05e4\u05ea\u05d7 TD \u05db\u05e8\u05d5\u05e0\u05d9 \u05d1\u05d4\u05de\u05e9\u05da (StahlNeuro p.173)."
        },
        {
          "text": "\u05d8\u05d9\u05e4\u05d5\u05dc \u05de\u05e9\u05dc\u05d9\u05dd \u05d1-Lithium \u05d1\u05de\u05d9\u05e0\u05d5\u05df \u05e0\u05de\u05d5\u05da.",
          "isCorrect": false,
          "rationale": "\u05dc\u05d9\u05ea\u05d9\u05d5\u05dd \u05d0\u05d9\u05e0\u05d5 \u05e0\u05d7\u05e9\u05d1 \u05dc\u05d2\u05d5\u05e8\u05dd \u05e1\u05d9\u05db\u05d5\u05df \u05de\u05d1\u05d5\u05e1\u05e1 \u05dc-TD; \u05dc\u05e2\u05d9\u05ea\u05d9\u05dd \u05d0\u05e3 \u05e0\u05d1\u05d7\u05df \u05db\u05d8\u05d9\u05e4\u05d5\u05dc, \u05d0\u05dd \u05db\u05d9 \u05dc\u05dc\u05d0 \u05d4\u05d5\u05db\u05d7\u05d5\u05ea \u05d7\u05d5\u05ea\u05db\u05d5\u05ea (DSM p.815)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d1\u05d5 \u05e2\u05dc \u05e7\u05d5\u05de\u05d5\u05e8\u05d1\u05d9\u05d3\u05d9\u05d5\u05ea \u05e8\u05e4\u05d5\u05d0\u05d9\u05ea \u05d5\u05e0\u05e4\u05e9\u05d9\u05ea \u05d5\u05e2\u05dc \u05d4\u05ea\u05d2\u05d5\u05d1\u05d4 \u05d4\u05e8\u05d0\u05e9\u05d5\u05e0\u05d9\u05ea \u05dc\u05ea\u05e8\u05d5\u05e4\u05d4.",
      "hasAllOfTheAbove": false,
      "hasNoneOfTheAbove": false,
      "metadata": {
        "source": "DSM p.815, StahlNeuro p.173"
      }
    },
    {
      "type": "short_answer",
      "question": "\u05d4\u05e1\u05d1\u05d9\u05e8\u05d5 \u05d0\u05ea \u05d4\u05d4\u05d1\u05d3\u05dc \u05d4\u05e4\u05ea\u05d5\u05e4\u05d9\u05d6\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d1\u05d9\u05df Medication-Induced Parkinsonism (DIP) \u05dc\u05d1\u05d9\u05df Tardive Dyskinesia (TD) \u05d1\u05de\u05d5\u05e0\u05d7\u05d9 \u05d4-Indirect Pathway ('STOP' Pathway) \u05dc\u05e4\u05d9 StahlNeuro.",
      "grading": {
        "modelAnswer": "DIP \u05e0\u05d5\u05d1\u05e2 \u05de\u05d7\u05e1\u05d9\u05de\u05d4 \u05d0\u05e7\u05d5\u05d8\u05d9\u05ea \u05e9\u05dc \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 $D_{2}$, \u05de\u05d4 \u05e9\u05de\u05d5\u05d1\u05d9\u05dc \u05dc\u05e2\u05d5\u05d3\u05e3 \u05d0\u05d9\u05ea\u05d5\u05ea 'STOP' \u05d1\u05de\u05e1\u05dc\u05d5\u05dc \u05d4\u05e2\u05e7\u05d9\u05e3 (Too much STOP). \u05dc\u05e2\u05d5\u05de\u05ea \u05d6\u05d0\u05ea, TD \u05e0\u05d5\u05d1\u05e2 \u05de-Upregulation \u05d5\u05e1\u05e0\u05e1\u05d9\u05d8\u05d9\u05d6\u05e6\u05d9\u05d4 \u05e9\u05dc \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 $D_{2}$ \u05dc\u05d0\u05d7\u05e8 \u05d7\u05e1\u05d9\u05de\u05d4 \u05db\u05e8\u05d5\u05e0\u05d9\u05ea, \u05de\u05d4 \u05e9\u05d2\u05d5\u05e8\u05dd \u05dc\u05e2\u05d9\u05db\u05d5\u05d1 \u05d9\u05ea\u05e8 \u05e9\u05dc \u05d4\u05de\u05e1\u05dc\u05d5\u05dc \u05d4\u05e2\u05e7\u05d9\u05e3 \u05d5\u05e4\u05e8\u05d9\u05e6\u05d4 \u05e9\u05dc \u05ea\u05e0\u05d5\u05e2\u05d5\u05ea 'GO' (Not enough STOP).",
        "rationale": "\u05d4\u05d4\u05d1\u05e0\u05d4 \u05d4\u05de\u05d5\u05d3\u05e8\u05e0\u05d9\u05ea \u05e9\u05dc StahlNeuro \u05de\u05d3\u05d2\u05d9\u05e9\u05d4 \u05d0\u05ea \u05d4\u05d0\u05d9\u05d6\u05d5\u05df \u05d4\u05de\u05e0\u05d5\u05d2\u05d3 \u05d1\u05de\u05e1\u05dc\u05d5\u05dc \u05d4-CSTC: \u05e2\u05d5\u05d3\u05e3 STOP \u05d1-DIP \u05de\u05d5\u05dc \u05d7\u05d5\u05e1\u05e8 \u05d1-STOP \u05d1-TD (StahlNeuro p.171-173).",
        "requiredAttributes": [
          "DIP \u05e7\u05e9\u05d5\u05e8 \u05dc\u05d7\u05e1\u05d9\u05de\u05d4 \u05d0\u05e7\u05d5\u05d8\u05d9\u05ea/\u05e2\u05d5\u05d3\u05e3 STOP.",
          "TD \u05e7\u05e9\u05d5\u05e8 \u05dc-Upregulation/\u05e1\u05e0\u05e1\u05d9\u05d8\u05d9\u05d6\u05e6\u05d9\u05d4 \u05e9\u05dc \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9\u05dd.",
          "TD \u05de\u05ea\u05d0\u05e4\u05d9\u05d9\u05df \u05d1\u05e2\u05d9\u05db\u05d5\u05d1 \u05d9\u05ea\u05e8 \u05e9\u05dc \u05d4\u05de\u05e1\u05dc\u05d5\u05dc \u05d4\u05e2\u05e7\u05d9\u05e3 (Not enough STOP)."
        ],
        "errors": {
          "misconceptions": [
            "\u05d8\u05e2\u05e0\u05d4 \u05e9\u05e9\u05e0\u05d9 \u05d4\u05de\u05e6\u05d1\u05d9\u05dd \u05e0\u05d5\u05d1\u05e2\u05d9\u05dd \u05de\u05d7\u05d5\u05e1\u05e8 \u05d3\u05d5\u05e4\u05de\u05d9\u05df \u05d1\u05e1\u05d9\u05e0\u05e4\u05e1\u05d4 \u05d1\u05dc\u05d1\u05d3 \u05dc\u05dc\u05d0 \u05d4\u05ea\u05d9\u05d9\u05d7\u05e1\u05d5\u05ea \u05dc\u05e9\u05d9\u05e0\u05d5\u05d9\u05d9 \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9\u05dd."
          ],
          "bluffs": [
