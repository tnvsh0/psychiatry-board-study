          "text": "\u05dc\u05de\u05d8\u05d5\u05e4\u05dc\u05d9 DID \u05d9\u05e9 \u05ea\u05de\u05d9\u05d3 \u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4 \u05e9\u05dc \u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d4 \u05d4\u05de\u05dc\u05d5\u05d5\u05d4 \u05d1-Auditory hallucinations.",
          "isCorrect": false,
          "rationale": "\u05de\u05d8\u05d5\u05e4\u05dc\u05d9 DID \u05e2\u05e9\u05d5\u05d9\u05d9\u05dd \u05dc\u05e9\u05de\u05d5\u05e2 \u05e7\u05d5\u05dc\u05d5\u05ea (command hallucinations), \u05d0\u05da \u05d0\u05dc\u05d5 \u05e0\u05d5\u05d1\u05e2\u05d9\u05dd \u05de\u05d4\u05d6\u05d4\u05d5\u05d9\u05d5\u05ea \u05d4\u05d7\u05dc\u05d5\u05e4\u05d9\u05d5\u05ea \u05d5\u05dc\u05d0 \u05de\u05de\u05d7\u05dc\u05d4 \u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9\u05ea (Dulcan p.527)."
        },
        {
          "text": "Malingering \u05de\u05ea\u05d0\u05e4\u05d9\u05d9\u05df \u05d1\u05d1\u05d9\u05e6\u05d5\u05e2 switching \u05e8\u05e7 \u05d1\u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05de\u05d8\u05e4\u05dc \u05de\u05e0\u05d5\u05e1\u05d4.",
          "isCorrect": false,
          "rationale": "\u05d4\u05de\u05ea\u05d7\u05d6\u05d9\u05dd \u05e0\u05d5\u05d8\u05d9\u05dd \u05dc\u05d4\u05e6\u05d9\u05d2 switching \u05d5\u05d3\u05d9\u05e1\u05d5\u05e6\u05d9\u05d0\u05e6\u05d9\u05d4 \u05d3\u05d5\u05d5\u05e7\u05d0 \u05db\u05e9\u05d4\u05dd \u05d9\u05d5\u05d3\u05e2\u05d9\u05dd \u05e9\u05e6\u05d5\u05e4\u05d9\u05dd \u05d1\u05d4\u05dd, \u05d1\u05e2\u05d5\u05d3 \u05d1-DID \u05d4\u05d0\u05de\u05d9\u05ea\u05d9 \u05d4\u05ea\u05d5\u05e4\u05e2\u05d4 \u05dc\u05e8\u05d5\u05d1 \u05de\u05d5\u05e1\u05ea\u05e8\u05ea (DSM p.336)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d1\u05d9 \u05e2\u05dc \u05d4\u05d9\u05d7\u05e1 \u05d4\u05e8\u05d2\u05e9\u05d9 \u05e9\u05dc \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05db\u05dc\u05e4\u05d9 \u05d4\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05e9\u05dc\u05d5 (\u05d1\u05d5\u05e9\u05d4 \u05de\u05d5\u05dc \u05d4\u05e0\u05d0\u05d4 \u05d0\u05d5 \u05e8\u05d5\u05d5\u05d7)."
    },
    {
      "type": "short_answer",
      "question": "\u05ea\u05d0\u05e8 \u05d0\u05ea \u05d4\u05d4\u05d1\u05d3\u05dc \u05d4\u05d0\u05e4\u05d9\u05d3\u05de\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d1\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05e9\u05dc DID \u05d1\u05d9\u05df \u05d9\u05dc\u05d3\u05d5\u05ea \u05de\u05d5\u05e7\u05d3\u05de\u05ea \u05dc\u05d1\u05d9\u05df \u05d2\u05d9\u05dc \u05d4\u05d4\u05ea\u05d1\u05d2\u05e8\u05d5\u05ea \u05d4\u05de\u05d0\u05d5\u05d7\u05e8\u05ea, \u05db\u05e4\u05d9 \u05e9\u05de\u05d5\u05e4\u05d9\u05e2 \u05d1-Synopsis.",
      "grading": {
        "modelAnswer": "\u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05d9\u05dc\u05d3\u05d5\u05ea \u05d4\u05de\u05d5\u05e7\u05d3\u05de\u05ea, \u05d4\u05d9\u05d7\u05e1 \u05d1\u05d9\u05df \u05d1\u05e0\u05d9\u05dd \u05dc\u05d1\u05e0\u05d5\u05ea \u05d4\u05e1\u05d5\u05d1\u05dc\u05d9\u05dd \u05de-DID \u05d4\u05d5\u05d0 \u05e7\u05e8\u05d5\u05d1 \u05dc-1:1. \u05e2\u05dd \u05d6\u05d0\u05ea, \u05dc\u05e7\u05e8\u05d0\u05ea \u05d2\u05d9\u05dc \u05d4\u05d4\u05ea\u05d1\u05d2\u05e8\u05d5\u05ea \u05d4\u05de\u05d0\u05d5\u05d7\u05e8\u05ea, \u05d7\u05dc \u05e9\u05d9\u05e0\u05d5\u05d9 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9 \u05d5\u05d4\u05d9\u05d7\u05e1 \u05e2\u05d5\u05dc\u05d4 \u05dc\u05d8\u05d5\u05d1\u05ea \u05e0\u05e7\u05d1\u05d5\u05ea, \u05e2\u05d3 \u05dc\u05e9\u05d9\u05e2\u05d5\u05e8 \u05e9\u05dc \u05db-8:1 \u05d1\u05de\u05d3\u05d2\u05de\u05d9\u05dd \u05d1\u05e6\u05e4\u05d5\u05df \u05d0\u05de\u05e8\u05d9\u05e7\u05d4.",
        "rationale": "\u05d4\u05e0\u05ea\u05d5\u05e0\u05d9\u05dd \u05d4\u05d0\u05e4\u05d9\u05d3\u05de\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05d9\u05dd \u05de\u05e6\u05d1\u05d9\u05e2\u05d9\u05dd \u05e2\u05dc \u05db\u05da \u05e9\u05d4\u05d4\u05e4\u05e8\u05e2\u05d4 \u05de\u05ea\u05e4\u05ea\u05d7\u05ea \u05d1\u05d0\u05d5\u05e4\u05df \u05e9\u05d5\u05d5\u05d4 \u05d0\u05e6\u05dc \u05e9\u05e0\u05d9 \u05d4\u05de\u05d9\u05e0\u05d9\u05dd \u05d1\u05d9\u05dc\u05d3\u05d5\u05ea, \u05d0\u05da \u05d1\u05e7\u05e8\u05d1 \u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd \u05d5\u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd \u05d9\u05e9\u05e0\u05d4 \u05d3\u05d5\u05de\u05d9\u05e0\u05e0\u05d8\u05d9\u05d5\u05ea \u05e0\u05e9\u05d9\u05ea \u05d1\u05d5\u05dc\u05d8\u05ea (Synopsis ch.11).",
        "requiredAttributes": [
          "\u05e6\u05d9\u05d5\u05df \u05d4\u05d9\u05d7\u05e1 \u05d1\u05d9\u05dc\u05d3\u05d5\u05ea (1:1).",
          "\u05e6\u05d9\u05d5\u05df \u05d4\u05e9\u05d9\u05e0\u05d5\u05d9 \u05d1\u05d2\u05d9\u05dc \u05d4\u05d4\u05ea\u05d1\u05d2\u05e8\u05d5\u05ea \u05dc\u05d8\u05d5\u05d1\u05ea \u05d1\u05e0\u05d5\u05ea/\u05e0\u05e7\u05d1\u05d5\u05ea.",
          "\u05e6\u05d9\u05d5\u05df \u05d4\u05d9\u05d7\u05e1 \u05d4\u05e1\u05d5\u05e4\u05d9 \u05d1\u05d2\u05d9\u05dc \u05d4\u05d4\u05ea\u05d1\u05d2\u05e8\u05d5\u05ea (\u05d1\u05e2\u05e8\u05da 8:1)."
        ],
        "errors": {
          "misconceptions": [
            "\u05d8\u05e2\u05e0\u05d4 \u05e9\u05d4\u05d4\u05e4\u05e8\u05e2\u05d4 \u05e9\u05db\u05d9\u05d7\u05d4 \u05d9\u05d5\u05ea\u05e8 \u05d0\u05e6\u05dc \u05d1\u05e0\u05d9\u05dd \u05d1\u05d9\u05dc\u05d3\u05d5\u05ea.",
            "\u05d8\u05e2\u05e0\u05d4 \u05e9\u05d4\u05d9\u05d7\u05e1 \u05e0\u05e9\u05d0\u05e8 \u05e7\u05d1\u05d5\u05e2 \u05dc\u05d0\u05d5\u05e8\u05da \u05db\u05dc \u05e9\u05dc\u05d1\u05d9 \u05d4\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea."
          ],
          "bluffs": [
            "\u05d0\u05de\u05d9\u05e8\u05d5\u05ea \u05db\u05dc\u05dc\u05d9\u05d5\u05ea \u05e2\u05dc \u05db\u05da \u05e9\u05d1\u05e0\u05d5\u05ea \u05e1\u05d5\u05d1\u05dc\u05d5\u05ea \u05d9\u05d5\u05ea\u05e8 \u05de\u05d8\u05e8\u05d0\u05d5\u05de\u05d4 \u05dc\u05dc\u05d0 \u05e6\u05d9\u05d5\u05df \u05d4\u05d9\u05d7\u05e1\u05d9\u05dd \u05d4\u05de\u05e1\u05e4\u05e8\u05d9\u05d9\u05dd."
          ]
        }
      },
      "hint": "\u05d4\u05ea\u05de\u05e7\u05d3\u05d9 \u05d1\u05e9\u05d9\u05e0\u05d5\u05d9 \u05d1\u05d9\u05d7\u05e1 \u05d1\u05d9\u05df \u05d4\u05de\u05d9\u05e0\u05d9\u05dd (sex ratio) \u05dc\u05d0\u05d5\u05e8\u05da \u05e6\u05d9\u05e8 \u05d4\u05d6\u05de\u05df \u05d4\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9."
    },
    {
      "type": "multiple_choice",
      "question": "\u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05e2\u05e8\u05db\u05ea \u05d9\u05dc\u05d3 \u05e2\u05dd \u05d7\u05e9\u05d3 \u05dc\u05d3\u05d9\u05e1\u05d5\u05e6\u05d9\u05d0\u05e6\u05d9\u05d4, \u05d4\u05de\u05d8\u05e4\u05dc \u05de\u05d6\u05d4\u05d4 \u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05e9\u05dc Functional Neurological Symptom Disorder (Conversion), \u05db\u05d2\u05d5\u05df nonepileptic seizures. \u05de\u05d4\u05d9 \u05d4\u05d2\u05d9\u05e9\u05d4 \u05d4\u05e0\u05db\u05d5\u05e0\u05d4 \u05dc\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d1\u05de\u05e7\u05e8\u05d4 \u05d6\u05d4 \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR?",
      "answerOptions": [
        {
          "text": "\u05d9\u05e9 \u05dc\u05ea\u05ea \u05d0\u05ea \u05e9\u05ea\u05d9 \u05d4\u05d0\u05d1\u05d7\u05e0\u05d5\u05ea \u05d1\u05de\u05e7\u05d1\u05d9\u05dc \u05d0\u05dd \u05e9\u05ea\u05d9\u05d4\u05df \u05e7\u05d9\u05d9\u05de\u05d5\u05ea.",
          "isCorrect": true,
          "rationale": "\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e0\u05d5\u05d9\u05e8\u05d5\u05dc\u05d5\u05d2\u05d9\u05d9\u05dd \u05ea\u05e4\u05e7\u05d5\u05d3\u05d9\u05d9\u05dd \u05e0\u05e4\u05d5\u05e6\u05d9\u05dd \u05de\u05d0\u05d5\u05d3 \u05d1\u05e7\u05e8\u05d1 \u05d4\u05e1\u05d5\u05d1\u05dc\u05d9\u05dd \u05de\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05d3\u05d9\u05e1\u05d5\u05e6\u05d9\u05d0\u05d8\u05d9\u05d1\u05d9\u05d5\u05ea, \u05d5\u05e0\u05d9\u05ea\u05df \u05dc\u05d0\u05d1\u05d7\u05df \u05d0\u05ea \u05e9\u05ea\u05d9\u05d4\u05df (DSM p.336; p.363)."
        },
        {
          "text": "\u05d3\u05d9\u05e1\u05d5\u05e6\u05d9\u05d0\u05e6\u05d9\u05d4 \u05d4\u05d9\u05d0 \u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05de\u05d5\u05e6\u05d9\u05d0\u05d4 (exclusion) \u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc Conversion.",
          "isCorrect": false,
          "rationale": "\u05d4\u05d4\u05e4\u05da \u05d4\u05d5\u05d0 \u05d4\u05e0\u05db\u05d5\u05df; \u05d4\u05df \u05e7\u05e9\u05d5\u05e8\u05d5\u05ea \u05e7\u05e9\u05e8 \u05d4\u05d3\u05d5\u05e7 \u05d5\u05dc\u05e2\u05d9\u05ea\u05d9\u05dd \u05e7\u05e8\u05d5\u05d1\u05d5\u05ea \u05de\u05d5\u05e4\u05d9\u05e2\u05d5\u05ea \u05d9\u05d7\u05d3 (DSM p.336)."
        },
        {
          "text": "\u05d9\u05e9 \u05dc\u05d4\u05e2\u05d3\u05d9\u05e3 \u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc Somatic Symptom Disorder \u05d1\u05e9\u05dc \u05d4\u05ea\u05dc\u05d5\u05e0\u05d5\u05ea \u05d4\u05d2\u05d5\u05e4\u05e0\u05d9\u05d5\u05ea.",
          "isCorrect": false,
          "rationale": "Conversion \u05de\u05ea\u05de\u05e7\u05d3 \u05d1\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e0\u05d5\u05d9\u05e8\u05d5\u05dc\u05d5\u05d2\u05d9\u05d9\u05dd \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05d9\u05dd \u05e9\u05d0\u05d9\u05e0\u05dd \u05ea\u05d5\u05d0\u05de\u05d9\u05dd \u05e4\u05ea\u05d5\u05e4\u05d9\u05d6\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05d4, \u05d1\u05e2\u05d5\u05d3 Somatic Symptom Disorder \u05de\u05ea\u05de\u05e7\u05d3 \u05d1\u05de\u05e6\u05d5\u05e7\u05d4 \u05e1\u05d1\u05d9\u05d1 \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d2\u05d5\u05e4\u05e0\u05d9\u05d9\u05dd (DSM p.363)."
        },
        {
          "text": "\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05e9\u05dc Conversion \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d4\u05dd \u05ea\u05de\u05d9\u05d3 \u05e2\u05d3\u05d5\u05ea \u05dc-Factitious Disorder Imposed on Self.",
          "isCorrect": false,
          "rationale": "Conversion \u05d0\u05d9\u05e0\u05d5 \u05db\u05e8\u05d5\u05da \u05d1\u05d6\u05d9\u05d5\u05e3 \u05de\u05db\u05d5\u05d5\u05df \u05e9\u05dc \u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05dc\u05e6\u05d5\u05e8\u05da \u05e8\u05d5\u05d5\u05d7 \u05de\u05e9\u05e0\u05d9 \u05d0\u05d5 \u05e4\u05e1\u05d9\u05db\u05d5\u05dc\u05d5\u05d2\u05d9, \u05d1\u05e0\u05d9\u05d2\u05d5\u05d3 \u05dc-Factitious Disorder (DSM p.363)."
        }
      ],
      "hint": "\u05d1\u05d3\u05e7\u05d9 \u05d4\u05d0\u05dd \u05d0\u05d1\u05d7\u05e0\u05d5\u05ea \u05d0\u05dc\u05d5 \u05d9\u05db\u05d5\u05dc\u05d5\u05ea \u05dc\u05d4\u05ea\u05e7\u05d9\u05d9\u05dd \u05d9\u05d7\u05d3 (comorbidity) \u05d0\u05d5 \u05e9\u05d4\u05df \u05e1\u05d5\u05ea\u05e8\u05d5\u05ea \u05d6\u05d5 \u05d0\u05ea \u05d6\u05d5."
    }
  ]
}