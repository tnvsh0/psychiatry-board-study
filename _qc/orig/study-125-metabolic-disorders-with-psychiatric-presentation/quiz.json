    {
      "type": "multiple_choice",
      "question": "\u05de\u05d8\u05d5\u05e4\u05dc \u05d1\u05df 19 \u05de\u05e6\u05d9\u05d2 \u05d0\u05e4\u05d9\u05d6\u05d5\u05d3\u05d4 \u05e1\u05d5\u05e2\u05e8\u05ea \u05e9\u05dc Acute confusion, \u05de\u05d7\u05e9\u05d1\u05d5\u05ea \u05e9\u05d5\u05d5\u05d0 \u05e8\u05d3\u05d9\u05e4\u05ea\u05d9\u05d5\u05ea, \u05d0\u05d9-\u05e9\u05e7\u05d8 \u05e4\u05e1\u05d9\u05db\u05d5\u05de\u05d5\u05d8\u05d5\u05e8\u05d9 \u05d5\u05db\u05d0\u05d1\u05d9 \u05d1\u05d8\u05df \u05e2\u05d6\u05d9\u05dd \u05e9\u05d0\u05d9\u05e0\u05dd \u05de\u05dc\u05d5\u05d5\u05d9\u05dd \u05d1\u05de\u05de\u05e6\u05d0\u05d9\u05dd \u05d1\u05de\u05d9\u05e9\u05d5\u05e9 \u05d4\u05d1\u05d8\u05df. \u05d4\u05d5\u05d0 \u05de\u05d3\u05d5\u05d5\u05d7 \u05db\u05d9 \u05d4\u05e9\u05ea\u05df \u05e9\u05dc\u05d5 \u05d4\u05e4\u05da \u05dc\u05db\u05d4\u05d4 \u05de\u05d0\u05d5\u05d3 \u05dc\u05d0\u05d7\u05e8 \u05e9\u05e2\u05de\u05d3 \u05d1\u05db\u05dc\u05d9. \u05de\u05d4\u05d9 \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05e1\u05d1\u05d9\u05e8\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8?",
      "answerOptions": [
        {
          "text": "Acute Intermittent Porphyria (AIP)",
          "isCorrect": true,
          "rationale": "\u05d4\u05d8\u05e8\u05d9\u05d0\u05d3\u05d4 \u05e9\u05dc \u05db\u05d0\u05d1\u05d9 \u05d1\u05d8\u05df, \u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d4/\u05d3\u05dc\u05d9\u05e8\u05d9\u05d5\u05dd \u05d5\u05e9\u05d9\u05e0\u05d5\u05d9 \u05d1\u05e6\u05d1\u05e2 \u05d4\u05e9\u05ea\u05df (Port-wine urine) \u05d4\u05d9\u05d0 \u05e7\u05dc\u05d0\u05e1\u05d9\u05ea \u05dc-AIP (DSM p.132)."
        },
        {
          "text": "Cushing's Psychosis",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05e9\u05e7\u05d5\u05e9\u05d9\u05e0\u05d2 \u05d2\u05d5\u05e8\u05dd \u05dc\u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d4 \u05d5\u05d3\u05dc\u05d9\u05e8\u05d9\u05d5\u05dd, \u05d4\u05d5\u05d0 \u05d0\u05d9\u05e0\u05d5 \u05de\u05d0\u05d5\u05e4\u05d9\u05d9\u05df \u05d1\u05db\u05d0\u05d1\u05d9 \u05d1\u05d8\u05df \u05d4\u05ea\u05e7\u05e4\u05d9\u05d9\u05dd \u05d0\u05d5 \u05d1\u05e9\u05d9\u05e0\u05d5\u05d9 \u05e6\u05d1\u05e2 \u05d4\u05e9\u05ea\u05df (DSM p.132, p.207)."
        },
        {
          "text": "Substance-induced Psychotic Disorder (Cannabis)",
          "isCorrect": false,
          "rationale": "\u05e7\u05e0\u05d0\u05d1\u05d9\u05e1 \u05d9\u05db\u05d5\u05dc \u05dc\u05d2\u05e8\u05d5\u05dd \u05dc\u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d4 \u05d5-Depersonalization, \u05d0\u05da \u05dc\u05d0 \u05dc\u05db\u05d0\u05d1\u05d9 \u05d1\u05d8\u05df \u05e2\u05d6\u05d9\u05dd \u05dc\u05dc\u05d0 \u05de\u05de\u05e6\u05d0 \u05e4\u05d9\u05d6\u05d9\u05e7\u05dc\u05d9 \u05d0\u05d5 \u05dc\u05e9\u05d9\u05e0\u05d5\u05d9 \u05e6\u05d1\u05e2 \u05d4\u05e9\u05ea\u05df \u05dc\u05d7\u05d5\u05dd-\u05d9\u05d9\u05df (DSM p.126, p.586)."
        },
        {
          "text": "Anticholinergic Toxicity",
          "isCorrect": false,
          "rationale": "\u05d4\u05e8\u05e2\u05dc\u05ea \u05d0\u05e0\u05d8\u05d9\u05db\u05d5\u05dc\u05d9\u05e0\u05e8\u05d2\u05d9\u05d9\u05dd \u05d2\u05d5\u05e8\u05de\u05ea \u05dc\u05d1\u05dc\u05d1\u05d5\u05dc \u05d5\u05d0\u05d9-\u05e9\u05e7\u05d8 ('Mad as a Hatter'), \u05d0\u05da \u05de\u05ea\u05d0\u05e4\u05d9\u05d9\u05e0\u05ea \u05d1\u05e2\u05e6\u05d9\u05e8\u05ea \u05e9\u05ea\u05df \u05d5\u05d1\u05d9\u05d5\u05d1\u05e9 \u05d1\u05e8\u05d9\u05e8\u05d9\u05d5\u05ea, \u05d5\u05dc\u05d0 \u05d1\u05e9\u05ea\u05df \u05db\u05d4\u05d4 \u05d0\u05d5 \u05db\u05d0\u05d1\u05d9 \u05d1\u05d8\u05df \u05de\u05e4\u05d5\u05e9\u05d8\u05d9\u05dd (\u05de\u05e7\u05d5\u05e8: \u05d4\u05e7\u05e9\u05e8 \u05e8\u05d7\u05d1)."
        }
      ],
      "hint": "\u05d4\u05ea\u05de\u05e7\u05d3 \u05d1\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05dd \u05d4\u05d9\u05d9\u05d7\u05d5\u05d3\u05d9 \u05e9\u05dc \u05d4\u05e9\u05ea\u05e0\u05d5\u05ea \u05e6\u05d1\u05e2 \u05d4\u05e9\u05ea\u05df \u05dc\u05d0\u05d7\u05e8 \u05d7\u05e9\u05d9\u05e4\u05d4 \u05dc\u05d0\u05d5\u05d5\u05d9\u05e8.",
      "imageUrls": []
    },
    {
      "type": "short_answer",
      "question": "\u05d4\u05e1\u05d1\u05e8 \u05d0\u05ea \u05d4\u05e8\u05e6\u05d9\u05d5\u05e0\u05dc \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9 \u05dc\u05e0\u05d9\u05d8\u05d5\u05e8 \u05ea\u05e4\u05e7\u05d5\u05d3\u05d9 \u05d1\u05dc\u05d5\u05d8\u05ea \u05d4\u05ea\u05e8\u05d9\u05e1 (TSH) \u05d1\u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd \u05d4\u05e0\u05d5\u05d8\u05dc\u05d9\u05dd Lithium, \u05d5\u05de\u05d4\u05d9 \u05ea\u05d3\u05d9\u05e8\u05d5\u05ea \u05d4\u05e0\u05d9\u05d8\u05d5\u05e8 \u05d4\u05de\u05d5\u05de\u05dc\u05e6\u05ea \u05dc\u05e4\u05d9 \u05d4-StahlKids?",
      "grading": {
        "modelAnswer": "Lithium \u05d9\u05db\u05d5\u05dc \u05dc\u05d2\u05e8\u05d5\u05dd \u05dc-Hypothyroidism \u05db\u05ea\u05d5\u05e6\u05d0\u05d4 \u05de\u05d4\u05e9\u05e4\u05e2\u05d4 \u05d9\u05e9\u05d9\u05e8\u05d4 \u05e2\u05dc \u05d1\u05dc\u05d5\u05d8\u05ea \u05d4\u05ea\u05e8\u05d9\u05e1. \u05dc\u05e4\u05d9 \u05d4-StahlKids, \u05d9\u05e9 \u05dc\u05d1\u05d3\u05d5\u05e7 \u05e8\u05de\u05ea TSH \u05d5-Free T4 \u05d1\u05d1\u05e1\u05d9\u05e1 (Baseline), \u05dc\u05d0\u05d7\u05e8 \u05de\u05db\u05df \u05db\u05dc 2-3 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05d1\u05d7\u05e6\u05d9 \u05e9\u05e0\u05d4 \u05d4\u05e8\u05d0\u05e9\u05d5\u05e0\u05d4, \u05d5\u05d1\u05d4\u05de\u05e9\u05da \u05db\u05dc 6 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05d0\u05d5 \u05db\u05d0\u05e9\u05e8 \u05de\u05d5\u05e4\u05d9\u05e2\u05d9\u05dd \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e7\u05dc\u05d9\u05e0\u05d9\u05d9\u05dd \u05d7\u05d3\u05e9\u05d9\u05dd \u05e9\u05dc \u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05d0\u05d5 \u05d4\u05d0\u05d8\u05d4 (StahlKids p.284, Dulcan p.766).",
        "rationale": "\u05dc\u05d9\u05ea\u05d9\u05d5\u05dd \u05e4\u05d5\u05d2\u05e2 \u05d1\u05d9\u05d9\u05e6\u05d5\u05e8 \u05d5\u05d4\u05e4\u05e8\u05e9\u05ea \u05d4\u05d5\u05e8\u05de\u05d5\u05e0\u05d9 \u05d4\u05ea\u05e8\u05d9\u05e1, \u05d5\u05dc\u05db\u05df \u05de\u05d7\u05d9\u05d9\u05d1 \u05e0\u05d9\u05d8\u05d5\u05e8 \u05e7\u05d1\u05d5\u05e2 \u05dc\u05de\u05e0\u05d9\u05e2\u05ea \u05ea\u05d5\u05e4\u05e2\u05d5\u05ea \u05dc\u05d5\u05d5\u05d0\u05d9 \u05d4\u05de\u05d3\u05de\u05d5\u05ea \u05d4\u05d7\u05de\u05e8\u05d4 \u05d1\u05d3\u05d9\u05db\u05d0\u05d5\u05df.",
        "requiredAttributes": [
          "\u05e6\u05d9\u05d5\u05df \u05d4\u05e2\u05d5\u05d1\u05d3\u05d4 \u05e9\u05dc\u05d9\u05ea\u05d9\u05d5\u05dd \u05d2\u05d5\u05e8\u05dd \u05dc-Hypothyroidism / \u05ea\u05ea-\u05e4\u05e2\u05d9\u05dc\u05d5\u05ea.",
          "\u05e6\u05d9\u05d5\u05df \u05d4\u05e6\u05d5\u05e8\u05da \u05d1\u05d1\u05d3\u05d9\u05e7\u05ea \u05d1\u05e1\u05d9\u05e1 (Baseline).",
          "\u05e6\u05d9\u05d5\u05df \u05ea\u05d3\u05d9\u05e8\u05d5\u05ea \u05d4\u05e0\u05d9\u05d8\u05d5\u05e8 (\u05db\u05dc 6 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05dc\u05e4\u05d9 StahlKids/Dulcan)."
        ],
        "errors": {
