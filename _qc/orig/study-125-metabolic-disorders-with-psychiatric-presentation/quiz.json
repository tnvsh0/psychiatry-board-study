      ],
      "rationale": "\u05d4\u05d3\u05d2\u05e9 \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9 \u05d1-DSM \u05d5\u05d1-Dulcan \u05d4\u05d5\u05d0 \u05e9\u05d4\u05e4\u05d2\u05d9\u05e2\u05d4 \u05d4\u05e0\u05d5\u05d9\u05e8\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea \u05d5\u05d4\u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9\u05ea \u05d1\u05d7\u05e1\u05e8 B12 \u05de\u05e7\u05d3\u05d9\u05de\u05d4 \u05dc\u05e2\u05d9\u05ea\u05d9\u05dd \u05e7\u05e8\u05d5\u05d1\u05d5\u05ea \u05d0\u05ea \u05d4\u05d1\u05d9\u05d8\u05d5\u05d9 \u05d4\u05d4\u05de\u05d8\u05d5\u05dc\u05d5\u05d2\u05d9 (DSM p.207, Dulcan p.326).",
      "hint": "\u05de\u05d3\u05d5\u05d1\u05e8 \u05d1\u05d7\u05e1\u05e8 \u05ea\u05d6\u05d5\u05e0\u05ea\u05d9 \u05d4\u05e7\u05e9\u05d5\u05e8 \u05dc-Megaloblastic anemia \u05d0\u05da \u05d1\u05e2\u05dc \u05d4\u05e9\u05e4\u05e2\u05d4 \u05e0\u05d5\u05d9\u05e8\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea \u05de\u05d5\u05e7\u05d3\u05de\u05ea.",
