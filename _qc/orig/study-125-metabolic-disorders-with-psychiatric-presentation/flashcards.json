{
  "title": "Psychiatry Flashcards",
  "cards": [
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05de\u05e6\u05d2 \u05d4\u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9 \u05d4\u05e7\u05dc\u05d0\u05e1\u05d9 (\u05d4-Apathetic Depression) \u05e9\u05dc Hypothyroidism \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d5\u05e0\u05d5\u05e2\u05e8?",
      "back": "\u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05d4\u05de\u05d0\u05d5\u05e4\u05d9\u05d9\u05df \u05d1-Psychomotor retardation \u05e7\u05e9\u05d4, \u05d0\u05e0\u05d4\u05d3\u05d5\u05e0\u05d9\u05d4, \u05d0\u05e4\u05ea\u05d9\u05d4 \u05d5\u05d0\u05d5\u05d1\u05d3\u05df \u05d9\u05d5\u05d6\u05de\u05d4 (DSM p.206, Dulcan p.250)."
    },
    {
      "front": "\u05d0\u05d9\u05dc\u05d5 \u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9\u05dd \u05d2\u05d5\u05e4\u05e0\u05d9\u05d9\u05dd \u05d4\u05e7\u05e9\u05d5\u05e8\u05d9\u05dd \u05dc\u05e4\u05d9\u05d6\u05d5\u05e8 \u05e9\u05d5\u05de\u05df \u05de\u05d2\u05d3\u05d9\u05e8\u05d9\u05dd \u05d0\u05ea \u05d4\u05de\u05e6\u05d2 \u05e9\u05dc Cushing's syndrome?",
      "back": "\u05d4\u05e9\u05de\u05e0\u05d4 \u05de\u05e8\u05db\u05d6\u05d9\u05ea (Central obesity), \u05e4\u05e0\u05d9 \u05d9\u05e8\u05d7 (Moon facies) \u05d5\u05e6\u05d1\u05d9\u05e8\u05ea \u05e9\u05d5\u05de\u05df \u05e2\u05d5\u05e8\u05e4\u05d9 (Buffalo hump) (DSM p.207, Dulcan p.325)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05e4\u05e8\u05d5\u05d8\u05d5\u05e7\u05d5\u05dc \u05e0\u05d9\u05d8\u05d5\u05e8 \u05d4-TSH \u05d4\u05de\u05d5\u05de\u05dc\u05e5 \u05d1\u05de\u05d4\u05dc\u05da \u05d8\u05d9\u05e4\u05d5\u05dc \u05db\u05e8\u05d5\u05e0\u05d9 \u05d1-Lithium?",
      "back": "\u05d1\u05d3\u05d9\u05e7\u05d4 \u05d1\u05e1\u05d9\u05e1\u05d9\u05ea \u05d8\u05e8\u05dd \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d5\u05e0\u05d9\u05d8\u05d5\u05e8 \u05db\u05dc 6 \u05e2\u05d3 12 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd, \u05d0\u05d5 \u05d1\u05e2\u05ea \u05d4\u05d5\u05e4\u05e2\u05ea \u05ea\u05e1\u05de\u05d9\u05e0\u05d9 \u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05d7\u05d3\u05e9\u05d9\u05dd (Dulcan p.766, StahlKids p.284)."
    },
    {
      "front": "\u05e0\u05db\u05d5\u05df \u05d0\u05d5 \u05dc\u05d0 \u05e0\u05db\u05d5\u05df: \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e0\u05d5\u05d9\u05e8\u05d5-\u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9\u05d9\u05dd \u05e9\u05dc $B_{12}$ deficiency \u05de\u05d5\u05e4\u05d9\u05e2\u05d9\u05dd \u05e8\u05e7 \u05dc\u05d0\u05d7\u05e8 \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea \u05d0\u05e0\u05de\u05d9\u05d4 \u05de\u05d2\u05dc\u05d5\u05d1\u05dc\u05e1\u05d8\u05d9\u05ea?",
      "back": "\u05dc\u05d0 \u05e0\u05db\u05d5\u05df; \u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d4\u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9\u05d9\u05dd \u05d9\u05db\u05d5\u05dc\u05d9\u05dd \u05dc\u05d4\u05d5\u05e4\u05d9\u05e2 \u05d8\u05e8\u05dd \u05d4\u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd \u05d4\u05d4\u05de\u05d8\u05d5\u05dc\u05d5\u05d2\u05d9\u05d9\u05dd (DSM p.207, Dulcan p.326)."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05e0\u05d9\u05ea\u05df \u05dc\u05d4\u05d1\u05d7\u05d9\u05df \u05d1\u05d9\u05df Addison's disease \u05dc-Anorexia Nervosa \u05d1\u05de\u05ea\u05d1\u05d2\u05e8\u05ea \u05e2\u05dd \u05d9\u05e8\u05d9\u05d3\u05d4 \u05d7\u05d3\u05d4 \u05d1\u05de\u05e9\u05e7\u05dc?",
      "back": "\u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05e9\u05dc Hyperpigmentation \u05d5-Salt craving \u05d1\u05d0\u05d3\u05d9\u05e1\u05d5\u05df, \u05dc\u05dc\u05d0 \u05d4\u05e4\u05e8\u05e2\u05ea \u05d3\u05d9\u05de\u05d5\u05d9 \u05d2\u05d5\u05e3 \u05d0\u05d5 \u05e4\u05d7\u05d3 \u05de\u05e2\u05dc\u05d9\u05d9\u05d4 \u05d1\u05de\u05e9\u05e7\u05dc (DSM p.386, Dulcan p.396)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05d8\u05e8\u05d9\u05d0\u05d3\u05d4 \u05d4\u05e7\u05dc\u05d0\u05e1\u05d9\u05ea \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05ea \u05d4\u05ea\u05e7\u05e3 \u05e9\u05dc Acute Intermittent Porphyria (AIP)?",
      "back": "\u05db\u05d0\u05d1\u05d9 \u05d1\u05d8\u05df \u05e2\u05d6\u05d9\u05dd, \u05e0\u05d5\u05d9\u05e8\u05d5\u05e4\u05ea\u05d9\u05d4 \u05de\u05d5\u05d8\u05d5\u05e8\u05d9\u05ea \u05d4\u05d9\u05e7\u05e4\u05d9\u05ea \u05d5\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9\u05d5\u05ea \u05d7\u05e8\u05d9\u05e4\u05d5\u05ea (DSM p.132)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d4\u05de\u05d5\u05e2\u05e8\u05db\u05ea \u05e9\u05dc Major Depressive Disorder \u05d1\u05e7\u05e8\u05d1 \u05d7\u05d5\u05dc\u05d9\u05dd \u05e2\u05dd Cushing's syndrome?",
      "back": "\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d2\u05d1\u05d5\u05d4\u05d4 \u05de\u05d0\u05d5\u05d3 \u05d4\u05e0\u05e2\u05d4 \u05d1\u05d9\u05df 50% \u05dc-70% \u05de\u05d4\u05d7\u05d5\u05dc\u05d9\u05dd (DSM p.206)."
    },
    {
      "front": "\u05dc\u05e4\u05d9 Dulcan, \u05de\u05ea\u05d9 \u05d9\u05e9 \u05dc\u05d4\u05e2\u05d3\u05d9\u05e3 Targeted screening \u05dc\u05ea\u05e4\u05e7\u05d5\u05d3\u05d9 \u05ea\u05e8\u05d9\u05e1 \u05e2\u05dc \u05e4\u05e0\u05d9 Universal screening \u05d1\u05d0\u05d5\u05db\u05dc\u05d5\u05e1\u05d9\u05d9\u05d4 \u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9\u05ea?",
      "back": "\u05d1\u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05d2\u05d5\u05e8\u05de\u05d9 \u05e1\u05d9\u05db\u05d5\u05df \u05d0\u05d5 \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d2\u05d5\u05e4\u05e0\u05d9\u05d9\u05dd \u05db\u05d2\u05d5\u05df \u05d1\u05e8\u05d3\u05d9\u05e7\u05e8\u05d3\u05d9\u05d4, \u05e2\u05e6\u05d9\u05e8\u05d5\u05ea \u05db\u05e8\u05d5\u05e0\u05d9\u05ea \u05d0\u05d5 \u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd \u05d1\u05d5\u05d5\u05e1\u05ea (Dulcan p.329)."
    },
    {
      "front": "\u05d0\u05d9\u05d6\u05d4 \u05e1\u05d9\u05de\u05df \u05d2\u05d5\u05e4\u05e0\u05d9 Pathognomonic \u05de\u05d5\u05e4\u05d9\u05e2 \u05d1-Addison's disease \u05d1\u05e7\u05e4\u05dc\u05d9 \u05d4\u05d9\u05d3\u05d9\u05d9\u05dd \u05d5\u05d1\u05e8\u05d9\u05e8\u05d9\u05ea \u05d4\u05e4\u05d4?",
      "back": "\u05d4\u05d9\u05e4\u05e8\u05e4\u05d9\u05d2\u05de\u05e0\u05d8\u05e6\u05d9\u05d4 (Hyperpigmentation) \u05e2\u05d5\u05e8\u05d9\u05ea \u05d5\u05e8\u05d9\u05e8\u05d9\u05ea (Dulcan p.396)."
    },
    {
      "front": "\u05d0\u05d9\u05dc\u05d5 \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9\u05d9\u05dd \u05d1-Hyperthyroidism \u05e2\u05e9\u05d5\u05d9\u05d9\u05dd \u05dc\u05d7\u05e7\u05d5\u05ea Mania \u05d0\u05d5 \u05d4\u05e4\u05e8\u05e2\u05ea \u05d7\u05e8\u05d3\u05d4?",
      "back": "\u05d0\u05d9-\u05e9\u05e7\u05d8, Psychomotor agitation, \u05d7\u05e8\u05d3\u05d4 \u05d5\u05ea\u05e0\u05d5\u05d3\u05d5\u05ea \u05d7\u05e8\u05d9\u05e4\u05d5\u05ea \u05d1\u05de\u05e6\u05d1 \u05d4\u05e8\u05d5\u05d7 (Dulcan p.325, DSM p.166)."
    },
    {
      "front": "\u05d0\u05d9\u05d6\u05d4 \u05e9\u05d9\u05e0\u05d5\u05d9 \u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05d9 \u05d1\u05e6\u05d1\u05e2 \u05d4\u05e9\u05ea\u05df \u05de\u05d5\u05e4\u05d9\u05e2 \u05d1-AIP \u05dc\u05d0\u05d7\u05e8 \u05d7\u05e9\u05d9\u05e4\u05d4 \u05dc\u05d0\u05d5\u05e8 \u05d5\u05dc\u05d0\u05d5\u05d5\u05d9\u05e8?",
      "back": "\u05d4\u05e9\u05ea\u05df \u05d4\u05d5\u05e4\u05da \u05dc\u05db\u05d4\u05d4 (\u05e6\u05d1\u05e2 \u05d9\u05d9\u05df \u05e4\u05d5\u05e8\u05d8) \u05e2\u05e7\u05d1 \u05d7\u05de\u05e6\u05d5\u05df PBG \u05dc\u05e4\u05d5\u05e8\u05e4\u05d5\u05d1\u05d9\u05dc\u05d9\u05df (DSM p.132)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05de\u05d9\u05d9\u05d3\u05d9 \u05d4\u05de\u05d5\u05de\u05dc\u05e5 \u05d1-Agitation \u05d0\u05d5 \u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d4 \u05d4\u05de\u05d5\u05e4\u05d9\u05e2\u05d9\u05dd \u05db\u05d7\u05dc\u05e7 \u05de-Delirium \u05e2\u05e7\u05d1 \u05de\u05e6\u05d1 \u05e8\u05e4\u05d5\u05d0\u05d9?",
      "back": "\u05e9\u05d9\u05de\u05d5\u05e9 \u05de\u05d5\u05e9\u05db\u05dc \u05d1-Antipsychotic medication \u05d1\u05de\u05e7\u05d1\u05d9\u05dc \u05dc\u05d1\u05d9\u05e8\u05d5\u05e8 \u05d5\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05d2\u05d5\u05e8\u05dd \u05d4\u05e8\u05e4\u05d5\u05d0\u05d9 \u05d4\u05d1\u05e1\u05d9\u05e1\u05d9 (Dulcan p.108)."
    },
    {
      "front": "\u05d0\u05d9\u05dc\u05d5 \u05d1\u05d9\u05d8\u05d5\u05d9\u05d9\u05dd \u05e9\u05dc Hypothyroidism \u05d1\u05ea\u05d9\u05e0\u05d5\u05e7\u05d5\u05ea \u05de\u05d7\u05d9\u05d9\u05d1\u05d9\u05dd \u05d4\u05ea\u05d9\u05d9\u05d7\u05e1\u05d5\u05ea \u05d0\u05e0\u05d3\u05d5\u05e7\u05e8\u05d9\u05e0\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea \u05d3\u05d7\u05d5\u05e4\u05d4 \u05dc\u05de\u05e0\u05d9\u05e2\u05ea \u05e4\u05d9\u05d2\u05d5\u05e8?",
      "back": "\u05e2\u05d9\u05db\u05d5\u05d1 \u05d1\u05d2\u05d3\u05d9\u05dc\u05d4 (Short stature) \u05d5\u05e2\u05d9\u05db\u05d5\u05d1 \u05d1\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea \u05d4\u05e2\u05e6\u05de\u05d5\u05ea (Dulcan p.325)."
    },
    {
      "front": "\u05de\u05d4\u05dd \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9\u05dd \u05d4\u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9\u05d9\u05dd \u05e9\u05dc 'Megaloblastic Dementia' \u05d4\u05e0\u05d2\u05e8\u05de\u05ea \u05de\u05d7\u05e1\u05e8 $B_{12}$?",
      "back": "\u05d0\u05d9\u05d8\u05d9\u05d5\u05ea \u05de\u05d7\u05e9\u05d1\u05ea\u05d9\u05ea, \u05e4\u05d2\u05d9\u05e2\u05d4 \u05d1\u05d6\u05d9\u05db\u05e8\u05d5\u05df \u05dc\u05d8\u05d5\u05d5\u05d7 \u05e7\u05e6\u05e8 \u05d5\u05dc\u05d9\u05e7\u05d5\u05d9 \u05d1-Executive functions (DSM p.685)."
    },
    {
      "front": "\u05d0\u05d9\u05dc\u05d5 \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05de\u05d0\u05e0\u05d9\u05d9\u05dd \u05e2\u05dc\u05d5\u05dc\u05d9\u05dd \u05dc\u05d4\u05d9\u05d2\u05e8\u05dd \u05de\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05de\u05d9\u05e0\u05d5\u05e0\u05d9\u05dd \u05d2\u05d1\u05d5\u05d4\u05d9\u05dd \u05e9\u05dc Corticosteroids?",
      "back": "\u05d0\u05d5\u05e4\u05d5\u05e8\u05d9\u05d4 \u05d0\u05d8\u05d9\u05e4\u05d9\u05ea, \u05d4\u05d9\u05e4\u05e8\u05d0\u05e7\u05d8\u05d9\u05d1\u05d9\u05d5\u05ea, \u05d5-Mania \u05de\u05dc\u05d0\u05d4 (DSM p.162, DSM p.167)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05e1\u05db\u05e0\u05d4 \u05d4\u05e0\u05d5\u05d9\u05e8\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea \u05d1-AIP \u05e9\u05e2\u05dc\u05d5\u05dc\u05d4 \u05dc\u05d4\u05d5\u05d1\u05d9\u05dc \u05dc\u05ea\u05de\u05d5\u05ea\u05d4 \u05d1\u05d4\u05d9\u05e2\u05d3\u05e8 \u05d8\u05d9\u05e4\u05d5\u05dc?",
      "back": "\u05d7\u05d5\u05dc\u05e9\u05ea \u05e9\u05e8\u05d9\u05e8\u05d9\u05dd \u05e4\u05e8\u05d5\u05e7\u05e1\u05d9\u05de\u05dc\u05d9\u05ea \u05e9\u05e2\u05dc\u05d5\u05dc\u05d4 \u05dc\u05d4\u05ea\u05e7\u05d3\u05dd \u05dc\u05e9\u05d9\u05ea\u05d5\u05e7 \u05e9\u05e8\u05d9\u05e8\u05d9 \u05d4\u05e0\u05e9\u05d9\u05de\u05d4 (DSM p.132)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d1\u05d3\u05d9\u05e7\u05ea \u05d4\u05de\u05e2\u05d1\u05d3\u05d4 \u05d4\u05e8\u05d0\u05e9\u05d5\u05e0\u05d9\u05ea \u05d4\u05de\u05d5\u05e2\u05d3\u05e4\u05ea (Screening tool) \u05dc\u05d0\u05d1\u05d7\u05d5\u05df Hypothyroidism \u05e8\u05d0\u05e9\u05d5\u05e0\u05d9?",
      "back": "\u05d1\u05d3\u05d9\u05e7\u05ea \u05e8\u05de\u05ea TSH (Thyroid-Stimulating Hormone) \u05d1\u05e0\u05e1\u05d9\u05d5\u05d1 (Dulcan p.325)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05de\u05d5\u05e0\u05d7 \u05d4\u05de\u05ea\u05d0\u05e8 \u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d4 \u05d7\u05e8\u05d9\u05e4\u05d4 \u05e2\u05dd Paranoid delusions \u05e2\u05e7\u05d1 \u05de\u05e6\u05d1 \u05e7\u05e9\u05d4 \u05e9\u05dc Hypothyroidism?",
      "back": "Myxedema Madness (DSM p.207)."
