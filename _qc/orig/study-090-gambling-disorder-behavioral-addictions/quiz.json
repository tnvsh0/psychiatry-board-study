          "rationale": "Dulcan \u05de\u05e6\u05d9\u05d9\u05df \u05db\u05d9 \u05de\u05d0\u05d7\u05e8 \u05e9\u05de\u05d5\u05d8\u05d9\u05d1\u05e6\u05d9\u05d4 \u05dc\u05d4\u05e4\u05e1\u05d9\u05e7 (Desist) \u05e2\u05dc\u05d5\u05dc\u05d4 \u05dc\u05d4\u05d9\u05d5\u05ea \u05d7\u05e1\u05e8\u05d4 \u05d1\u05e7\u05e8\u05d1 \u05d1\u05e0\u05d9 \u05e0\u05d5\u05e2\u05e8, MI \u05d0\u05d5 MET \u05d9\u05db\u05d5\u05dc\u05d9\u05dd \u05dc\u05e9\u05de\u05e9 \u05db\u05d4\u05db\u05e0\u05d4 (Lead-in) \u05d9\u05e2\u05d9\u05dc\u05d4 \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc (Dulcan p.239)."
        },
        {
          "text": "\u05db\u05d9\u05d5\u05d5\u05df \u05e9-MI \u05d4\u05d5\u05db\u05d7\u05d4 \u05db\u05d9\u05e2\u05d9\u05dc\u05d4 \u05d9\u05d5\u05ea\u05e8 \u05de-CBT \u05d1\u05d4\u05e9\u05d2\u05ea \u05d4\u05d9\u05de\u05e0\u05e2\u05d5\u05ea \u05d0\u05e8\u05d5\u05db\u05ea \u05d8\u05d5\u05d5\u05d7.",
          "isCorrect": false,
          "rationale": "Dulcan \u05dc\u05d0 \u05e7\u05d5\u05d1\u05e2 \u05e2\u05dc\u05d9\u05d5\u05e0\u05d5\u05ea \u05e9\u05dc MI \u05e2\u05dc CBT; CBT \u05e0\u05d7\u05e9\u05d1\u05ea \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05de\u05e8\u05db\u05d6\u05d9, \u05d1\u05e2\u05d5\u05d3 MI \u05de\u05e9\u05de\u05e9\u05ea \u05dc\u05e8\u05d5\u05d1 \u05db\u05e2\u05d6\u05e8 \u05d0\u05d5 \u05db\u05e9\u05dc\u05d1 \u05de\u05e7\u05d3\u05d9\u05dd (Dulcan p.239)."
        },
        {
          "text": "MI \u05d4\u05d9\u05d0 \u05d4\u05d3\u05e8\u05da \u05d4\u05d9\u05d7\u05d9\u05d3\u05d4 \u05dc\u05d8\u05e4\u05dc \u05d1-Conduct Disorder \u05e0\u05dc\u05d5\u05d5\u05d4.",
          "isCorrect": false,
          "rationale": "\u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-CD \u05e0\u05d3\u05e8\u05e9\u05d5\u05ea \u05d4\u05ea\u05e2\u05e8\u05d1\u05d5\u05d9\u05d5\u05ea \u05e8\u05d7\u05d1\u05d5\u05ea \u05d9\u05d5\u05ea\u05e8, \u05dc\u05e8\u05d5\u05d1 \u05de\u05e9\u05e4\u05d7\u05ea\u05d9\u05d5\u05ea \u05d5\u05e1\u05d1\u05d9\u05d1\u05ea\u05d9\u05d5\u05ea, \u05d5\u05dc\u05d0 \u05e8\u05e7 MI (Dulcan p.208)."
        },
        {
          "text": "\u05db\u05d3\u05d9 \u05dc\u05d4\u05d7\u05dc\u05d9\u05e3 \u05d0\u05ea \u05d4\u05e6\u05d5\u05e8\u05da \u05d1\u05d8\u05d9\u05e4\u05d5\u05dc \u05e7\u05d1\u05d5\u05e6\u05ea\u05d9 \u05d1-SUD Programs.",
          "isCorrect": false,
          "rationale": "\u05e0\u05d4\u05e4\u05d5\u05da \u05d4\u05d5\u05d0, Dulcan \u05de\u05d3\u05d2\u05d9\u05e9 \u05e9\u05d0\u05d9\u05df \u05dc\u05d8\u05e4\u05dc \u05d1\u05d1\u05e0\u05d9 \u05e0\u05d5\u05e2\u05e8 \u05e2\u05dd \u05d4\u05ea\u05de\u05db\u05e8\u05d5\u05ea \u05dc\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d1\u05ea\u05d5\u05da \u05ea\u05d5\u05db\u05e0\u05d9\u05d5\u05ea SUD \u05d0\u05dd \u05d0\u05d9\u05df \u05dc\u05d4\u05dd \u05d4\u05e4\u05e8\u05e2\u05ea \u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05d7\u05d5\u05de\u05e8\u05d9\u05dd (Dulcan p.239)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d1\u05d5 \u05e2\u05dc \u05d4\u05d2\u05d9\u05e9\u05d4 \u05dc\u05de\u05d8\u05d5\u05e4\u05dc \u05d4\u05e6\u05e2\u05d9\u05e8 \u05e9\u05d0\u05d9\u05e0\u05d5 \u05de\u05e2\u05d5\u05e0\u05d9\u05d9\u05df \u05d1\u05e9\u05d9\u05e0\u05d5\u05d9 \u05d1\u05e9\u05dc\u05d1 \u05d4\u05e8\u05d0\u05e9\u05d5\u05df.",
      "imageUrls": []
    },
    {
      "type": "short_answer",
      "question": "\u05d4\u05e1\u05d1\u05d9\u05e8\u05d5 \u05d0\u05ea \u05d4\u05d4\u05d1\u05d3\u05dc \u05d4\u05d0\u05d1\u05d7\u05e0\u05ea\u05d9 \u05d4\u05e2\u05d9\u05e7\u05e8\u05d9 \u05d1-DSM-5-TR \u05d1\u05d9\u05df Gambling Disorder \u05dc\u05d1\u05d9\u05df Internet Gaming Disorder.",
      "grading": {
        "modelAnswer": "Gambling Disorder \u05d4\u05d9\u05d0 \u05d0\u05d1\u05d7\u05e0\u05d4 \u05e8\u05e9\u05de\u05d9\u05ea \u05d1\u05e4\u05e8\u05e7 \u05e9\u05dc Substance-Related and Addictive Disorders (Section II), \u05d1\u05e2\u05d5\u05d3 Internet Gaming Disorder \u05de\u05d5\u05e4\u05d9\u05e2\u05d4 \u05d1-Section III \u05db\u05ea\u05e0\u05d0\u05d9 \u05dc\u05de\u05d7\u05e7\u05e8 \u05e0\u05d5\u05e1\u05e3. \u05d1\u05e0\u05d5\u05e1\u05e3, Gambling Disorder \u05e2\u05d5\u05e1\u05e7\u05ea \u05d1\u05e1\u05d9\u05db\u05d5\u05df \u05e9\u05dc \u05db\u05e1\u05e3 \u05d0\u05d5 \u05e2\u05e8\u05da, \u05d1\u05e2\u05d5\u05d3 Internet Gaming Disorder \u05de\u05ea\u05de\u05e7\u05d3\u05ea \u05d1\u05de\u05e9\u05d7\u05e7\u05d9\u05dd \u05de\u05e7\u05d5\u05d5\u05e0\u05d9\u05dd (\u05dc\u05e8\u05d5\u05d1 \u05dc\u05dc\u05d0 \u05d4\u05d9\u05de\u05d5\u05e8\u05d9\u05dd \u05db\u05e1\u05e4\u05d9\u05d9\u05dd) \u05d5\u05d0\u05d9\u05e0\u05d4 \u05db\u05d5\u05dc\u05dc\u05ea \u05d4\u05d9\u05de\u05d5\u05e8\u05d9\u05dd \u05d1\u05d0\u05d9\u05e0\u05d8\u05e8\u05e0\u05d8.",
        "rationale": "\u05d4-DSM-5-TR \u05de\u05d1\u05d7\u05d9\u05df \u05d1\u05d9\u05df \u05d4\u05e4\u05e8\u05e2\u05d4 \u05de\u05d1\u05d5\u05e1\u05e1\u05ea \u05e8\u05d0\u05d9\u05d5\u05ea (\u05d4\u05d9\u05de\u05d5\u05e8\u05d9\u05dd) \u05dc\u05d1\u05d9\u05df \u05de\u05e6\u05d1 \u05d4\u05d3\u05d5\u05e8\u05e9 \u05de\u05d7\u05e7\u05e8 \u05e0\u05d5\u05e1\u05e3 (\u05de\u05e9\u05d7\u05e7\u05d9 \u05d0\u05d9\u05e0\u05d8\u05e8\u05e0\u05d8), \u05d5\u05db\u05df \u05de\u05d3\u05d2\u05d9\u05e9 \u05e9\u05d4\u05d9\u05de\u05d5\u05e8\u05d9 \u05d0\u05d9\u05e0\u05d8\u05e8\u05e0\u05d8 \u05e9\u05d9\u05d9\u05db\u05d9\u05dd \u05dc\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d9\u05ea \u05d4\u05d4\u05d9\u05de\u05d5\u05e8\u05d9\u05dd.",
        "requiredAttributes": [
          "\u05e6\u05d9\u05dc\u05d5\u05dd \u05e9-Gambling Disorder \u05d4\u05d9\u05d0 \u05d1-Section II (\u05d0\u05d5 \u05d0\u05d1\u05d7\u05e0\u05d4 \u05e8\u05e9\u05de\u05d9\u05ea) \u05d5-Internet Gaming Disorder \u05d4\u05d9\u05d0 \u05d1-Section III (\u05d0\u05d5 \u05d3\u05d5\u05e8\u05e9\u05ea \u05de\u05d7\u05e7\u05e8 \u05e0\u05d5\u05e1\u05e3).",
          "\u05d4\u05d1\u05d7\u05e0\u05d4 \u05e9\u05d4\u05d9\u05de\u05d5\u05e8\u05d9 \u05d0\u05d9\u05e0\u05d8\u05e8\u05e0\u05d8 \u05e0\u05db\u05dc\u05dc\u05d9\u05dd \u05ea\u05d7\u05ea Gambling Disorder \u05d5\u05dc\u05d0 Internet Gaming Disorder.",
          "\u05e6\u05d9\u05d5\u05df \u05d4\u05d4\u05d1\u05d3\u05dc \u05d1\u05ea\u05d5\u05db\u05df (\u05d4\u05d9\u05de\u05d5\u05e8\u05d9\u05dd \u05e2\u05dc \u05db\u05e1\u05e3/\u05e2\u05e8\u05da \u05de\u05d5\u05dc \u05de\u05e9\u05d7\u05e7\u05d9 \u05de\u05d7\u05e9\u05d1/\u05d0\u05d9\u05e0\u05d8\u05e8\u05e0\u05d8)."
        ],
        "errors": {
          "misconceptions": [
            "\u05de\u05d7\u05e9\u05d1\u05d4 \u05e9\u05d4\u05d9\u05de\u05d5\u05e8\u05d9 \u05d0\u05d9\u05e0\u05d8\u05e8\u05e0\u05d8 \u05db\u05e1\u05e4\u05d9\u05d9\u05dd \u05de\u05d0\u05d5\u05d1\u05d7\u05e0\u05d9\u05dd \u05db-Internet Gaming Disorder.",
            "\u05e7\u05d1\u05d9\u05e2\u05d4 \u05e9-Internet Gaming Disorder \u05d4\u05d9\u05d0 \u05d0\u05d1\u05d7\u05e0\u05d4 \u05e1\u05d5\u05e4\u05d9\u05ea \u05d1-Section II."
          ],
          "bluffs": [
            "\u05d0\u05de\u05d9\u05e8\u05d4 \u05db\u05dc\u05dc\u05d9\u05ea \u05e9\u05e9\u05e0\u05d9\u05d4\u05dd \u05e1\u05d5\u05d2\u05d9\u05dd \u05e9\u05dc \u05d4\u05ea\u05de\u05db\u05e8\u05d5\u05ea \u05dc\u05dc\u05d0 \u05d4\u05d1\u05d7\u05e0\u05d4 \u05d1\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05d0\u05d1\u05d7\u05e0\u05ea\u05d9 \u05d1-DSM."
          ]
        }
      },
      "hint": "\u05d4\u05ea\u05d9\u05d9\u05d7\u05e1\u05d5 \u05dc\u05de\u05d9\u05e7\u05d5\u05dd \u05e9\u05dc \u05db\u05dc \u05d4\u05e4\u05e8\u05e2\u05d4 \u05d1\u05ea\u05d5\u05da \u05de\u05d3\u05e8\u05d9\u05da \u05d4-DSM \u05d5\u05dc\u05e9\u05d0\u05dc\u05d4 \u05d4\u05d0\u05dd \u05db\u05e1\u05e3 \u05de\u05e2\u05d5\u05e8\u05d1.",
