{
  "title": "Gambling Flashcards",
  "cards": [
    {
      "front": "\u05de\u05d4\u05d5 \u05d4-Threshold \u05d4\u05de\u05d9\u05e0\u05d9\u05de\u05dc\u05d9 \u05dc\u05d0\u05d1\u05d7\u05e0\u05ea Gambling Disorder \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR, \u05d5\u05d1\u05d0\u05d9\u05d6\u05d5 \u05de\u05e1\u05d2\u05e8\u05ea \u05d6\u05de\u05df?",
      "back": "\u05e7\u05d9\u05d5\u05dd \u05e9\u05dc \u05dc\u05e4\u05d7\u05d5\u05ea 4 \u05de\u05ea\u05d5\u05da 9 \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05d1\u05ea\u05d5\u05da \u05ea\u05e7\u05d5\u05e4\u05d4 \u05e9\u05dc 12 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd (DSM p.661)."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05de\u05d5\u05d2\u05d3\u05e8 \u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df 'Chasing losses' (A6) \u05d1\u05d0\u05d1\u05d7\u05e0\u05ea \u05d4\u05d9\u05de\u05d5\u05e8\u05d9\u05dd?",
      "back": "\u05d7\u05d6\u05e8\u05d4 \u05dc\u05d4\u05de\u05e8 \u05d1\u05d9\u05d5\u05dd \u05d0\u05d7\u05e8 (\u05d0\u05d5 \u05dc\u05e2\u05d9\u05ea\u05d9\u05dd \u05e7\u05e8\u05d5\u05d1\u05d5\u05ea) \u05de\u05ea\u05d5\u05da \u05e6\u05d5\u05e8\u05da \u05d3\u05d7\u05d5\u05e3 \u05dc\u05d4\u05d7\u05d6\u05d9\u05e8 \u05d4\u05e4\u05e1\u05d3\u05d9\u05dd \u05db\u05e1\u05e4\u05d9\u05d9\u05dd \u05e7\u05d5\u05d3\u05de\u05d9\u05dd (DSM p.662)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05d4\u05d2\u05d3\u05e8\u05d4 \u05e9\u05dc \u05d7\u05d5\u05de\u05e8\u05d4 \u05de\u05e1\u05d5\u05d2 Severe \u05d1-Gambling Disorder?",
      "back": "\u05e2\u05de\u05d9\u05d3\u05d4 \u05d1-8 \u05e2\u05d3 9 \u05de\u05ea\u05d5\u05da \u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05d4\u05d0\u05d1\u05d7\u05e0\u05ea\u05d9\u05d9\u05dd (DSM p.662)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05ea\u05e0\u05d0\u05d9 \u05d4\u05d4\u05db\u05e8\u05d7\u05d9 \u05dc\u05e9\u05dc\u05d9\u05dc\u05ea \u05d0\u05d1\u05d7\u05e0\u05ea Gambling Disorder \u05d1\u05d4\u05e7\u05e9\u05e8 \u05e9\u05dc \u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05de\u05e6\u05d1 \u05e8\u05d5\u05d7?",
      "back": "\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d4\u05d4\u05d9\u05de\u05d5\u05e8\u05d9\u05dd \u05d0\u05d9\u05e0\u05d4 \u05de\u05d5\u05e1\u05d1\u05e8\u05ea \u05d8\u05d5\u05d1 \u05d9\u05d5\u05ea\u05e8 \u05e2\u05dc \u05d9\u05d3\u05d9 Manic episode (DSM p.662)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05de\u05e1\u05dc\u05d5\u05dc \u05d4\u05de\u05d5\u05d7\u05d9 \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05d4\u05de\u05d4\u05d5\u05d5\u05d4 \u05d0\u05ea \u05d4-Final common pathway \u05e9\u05dc \u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05d2\u05de\u05d5\u05dc \u05d5\u05d4\u05ea\u05de\u05db\u05e8\u05d5\u05ea?",
      "back": "\u05d4\u05de\u05e1\u05dc\u05d5\u05dc \u05d4-Mesolimbic \u05d4\u05de\u05e7\u05e9\u05e8 \u05d1\u05d9\u05df \u05d4-VTA \u05dc-Nucleus accumbens (StahlNeuro p.541)."
    },
    {
      "front": "\u05d1\u05de\u05e2\u05d1\u05e8 \u05de\u05d0\u05d9\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05d5\u05ea \u05dc\u05e7\u05d5\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05d5\u05ea \u05d1\u05d4\u05ea\u05de\u05db\u05e8\u05d5\u05ea, \u05dc\u05d0\u05d9\u05d6\u05d4 \u05d0\u05d6\u05d5\u05e8 \u05d1-Striatum \u05e0\u05d5\u05d3\u05d3\u05ea \u05d4\u05e9\u05dc\u05d9\u05d8\u05d4?",
      "back": "\u05de\u05d4-Ventral striatum (\u05de\u05e2\u05d2\u05dc \u05d4\u05d2\u05de\u05d5\u05dc) \u05d0\u05dc \u05d4-Dorsal striatum (\u05de\u05e2\u05d2\u05dc \u05d4\u05d4\u05e8\u05d2\u05dc\u05d9\u05dd) (StahlNeuro p.543)."
    },
    {
      "front": "\u05dc\u05e4\u05d9 StahlNeuro, \u05d0\u05d9\u05d6\u05d4 \u05ea\u05d4\u05dc\u05d9\u05da \u05e0\u05d5\u05d9\u05e8\u05d5\u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05de\u05ea\u05d5\u05d5\u05da \u05e2\u05dc \u05d9\u05d3\u05d9 Dopamine \u05d1\u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05d2\u05de\u05d5\u05dc?",
      "back": "\u05ea\u05d4\u05dc\u05d9\u05da \u05d4-'Wanting' (\u05d4\u05d9\u05d3\u05d9\u05e2\u05d4 \u05d5\u05d4\u05e6\u05d9\u05e4\u05d9\u05d9\u05d4 \u05dc\u05d2\u05de\u05d5\u05dc), \u05dc\u05d4\u05d1\u05d3\u05d9\u05dc \u05de-'Liking' \u05d4\u05de\u05ea\u05d5\u05d5\u05da \u05e2\u05dc \u05d9\u05d3\u05d9 Opioids (StahlNeuro p.571)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05de\u05d5\u05e9\u05d2 'Telescoping' \u05d1\u05d4\u05e7\u05e9\u05e8 \u05e9\u05dc \u05d4\u05d1\u05d3\u05dc\u05d9\u05dd \u05d1\u05d9\u05df \u05d4\u05de\u05d9\u05e0\u05d9\u05dd \u05d1-Gambling Disorder?",
      "back": "\u05d4\u05ea\u05e7\u05d3\u05de\u05d5\u05ea \u05de\u05d4\u05d9\u05e8\u05d4 \u05d9\u05d5\u05ea\u05e8 \u05e9\u05dc \u05d4\u05d4\u05e4\u05e8\u05e2\u05d4 \u05de\u05e8\u05d2\u05e2 \u05d4\u05d5\u05e4\u05e2\u05ea \u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd, \u05d4\u05e0\u05e4\u05d5\u05e6\u05d4 \u05d9\u05d5\u05ea\u05e8 \u05d1\u05e7\u05e8\u05d1 \u05e0\u05e9\u05d9\u05dd (DSM p.664)."
    },
    {
      "front": "\u05d0\u05d9\u05d6\u05d5 \u05e9\u05d9\u05d8\u05ea \u05d8\u05d9\u05e4\u05d5\u05dc \u05e4\u05e1\u05d9\u05db\u05d5\u05ea\u05e8\u05e4\u05d5\u05d9\u05d8\u05d9\u05ea \u05e0\u05d7\u05e9\u05d1\u05ea \u05dc\u05e7\u05d5 \u05e8\u05d0\u05e9\u05d5\u05df \u05d5\u05d1\u05e2\u05dc\u05ea \u05e8\u05d0\u05d9\u05d5\u05ea \u05dc\u05d9\u05e2\u05d9\u05dc\u05d5\u05ea \u05d1\u05d4\u05e4\u05d7\u05ea\u05ea \u05d7\u05d5\u05de\u05e8\u05ea \u05d4\u05d4\u05ea\u05de\u05db\u05e8\u05d5\u05ea \u05dc\u05d4\u05d9\u05de\u05d5\u05e8\u05d9\u05dd?",
      "back": "CBT (Cognitive-Behavioral Therapy) (Dulcan p.239)."
    },
    {
      "front": "\u05d0\u05d9\u05d6\u05d5 \u05ea\u05e8\u05d5\u05e4\u05d4 (Off-label) \u05de\u05de\u05e9\u05e4\u05d7\u05ea \u05d4-Opioid antagonists \u05e0\u05de\u05e6\u05d0\u05d4 \u05d9\u05e2\u05d9\u05dc\u05d4 \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05d3\u05d7\u05e4\u05d9\u05dd \u05dc\u05d4\u05d9\u05de\u05d5\u05e8\u05d9\u05dd?",
      "back": "Naltrexone (StahlNeuro p.574)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d7\u05d5\u05e1\u05e8 \u05d4\u05d0\u05d9\u05d6\u05d5\u05df \u05d4\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9 \u05d1\u05de\u05d5\u05d7 \u05e9\u05dc \u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd \u05d4\u05de\u05d2\u05d1\u05d9\u05e8 \u05d0\u05ea \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05dc-SUD \u05d5-Behavioral addictions?",
      "back": "\u05d4\u05d1\u05e9\u05dc\u05d4 \u05de\u05d5\u05e7\u05d3\u05de\u05ea \u05e9\u05dc \u05de\u05e2\u05e8\u05db\u05d5\u05ea 'Bottom-up' \u05e1\u05d5\u05d1-\u05e7\u05d5\u05e8\u05d8\u05d9\u05e7\u05dc\u05d9\u05d5\u05ea (\u05d2\u05de\u05d5\u05dc) \u05de\u05d5\u05dc \u05d4\u05d1\u05e9\u05dc\u05d4 \u05de\u05d0\u05d5\u05d7\u05e8\u05ea \u05e9\u05dc \u05de\u05e2\u05e8\u05db\u05d5\u05ea 'Top-down' \u05e4\u05e8\u05d4-\u05e4\u05e8\u05d5\u05e0\u05d8\u05dc\u05d9\u05d5\u05ea (Dulcan p.226)."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05de\u05d5\u05d2\u05d3\u05e8 \u05de\u05e6\u05d1 \u05e9\u05dc Early Remission \u05d1-Gambling Disorder?",
      "back": "\u05d0\u05d9-\u05e2\u05de\u05d9\u05d3\u05d4 \u05d1\u05d0\u05e3 \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df \u05dc\u05de\u05e9\u05da \u05dc\u05e4\u05d7\u05d5\u05ea 3 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05d0\u05da \u05e4\u05d7\u05d5\u05ea \u05de-12 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd (DSM p.662)."
    },
    {
      "front": "\u05d0\u05d9\u05dc\u05d5 \u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05e2\u05dc\u05d5\u05dc\u05d5\u05ea \u05dc\u05d4\u05e9\u05e8\u05d5\u05ea \u05d3\u05d7\u05e4\u05d9\u05dd \u05dc\u05d4\u05d9\u05de\u05d5\u05e8\u05d9\u05dd \u05db\u05ea\u05d5\u05e6\u05d0\u05d4 \u05de\u05d4\u05e9\u05e4\u05e2\u05d4 \u05e4\u05d9\u05d6\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea \u05d9\u05e9\u05d9\u05e8\u05d4 \u05e2\u05dc \u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05d2\u05de\u05d5\u05dc?",
      "back": "\u05ea\u05e8\u05d5\u05e4\u05d5\u05ea Dopaminergic agonists (\u05db\u05d2\u05d5\u05df \u05d0\u05dc\u05d5 \u05d4\u05de\u05e9\u05de\u05e9\u05d5\u05ea \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Parkinson's disease) (DSM p.665)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d4\u05de\u05d5\u05e2\u05e8\u05db\u05ea \u05e9\u05dc \u05d1\u05e2\u05d9\u05d5\u05ea \u05d4\u05d9\u05de\u05d5\u05e8\u05d9\u05dd \u05d7\u05de\u05d5\u05e8\u05d5\u05ea \u05d1\u05e7\u05e8\u05d1 \u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd?",
      "back": "$3\\%-8\\%$ \u05de\u05d4\u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd, \u05db\u05d0\u05e9\u05e8 \u05e2\u05d5\u05d3 $10\\%-15\\%$ \u05e0\u05de\u05e6\u05d0\u05d9\u05dd \u05d1\u05e1\u05d9\u05db\u05d5\u05df (Dulcan p.225)."
    },
    {
      "front": "\u05de\u05d4 \u05db\u05d5\u05dc\u05dc \u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df 'Preoccupation' (A4) \u05d1-Gambling Disorder?",
      "back": "\u05e2\u05d9\u05e1\u05d5\u05e7 \u05de\u05d7\u05e9\u05d1\u05ea\u05d9 \u05de\u05ea\u05de\u05d9\u05d3 \u05d1\u05d7\u05d5\u05d5\u05d9\u05d5\u05ea \u05d4\u05d9\u05de\u05d5\u05e8 \u05e2\u05d1\u05e8, \u05ea\u05db\u05e0\u05d5\u05df \u05d4\u05d4\u05d9\u05de\u05d5\u05e8 \u05d4\u05d1\u05d0 \u05d0\u05d5 \u05de\u05d7\u05e9\u05d1\u05d4 \u05e2\u05dc \u05d3\u05e8\u05db\u05d9\u05dd \u05dc\u05d4\u05e9\u05d9\u05d2 \u05db\u05e1\u05e3 \u05dc\u05d4\u05d9\u05de\u05d5\u05e8\u05d9\u05dd (DSM p.661)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05de\u05d3\u05d3 \u05dc\u05d4\u05d1\u05d3\u05dc\u05d4 \u05d1\u05d9\u05df \u05d4\u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05d9\u05e8 Episodic \u05dc-Persistent \u05d1-Gambling Disorder?",
      "back": "\u05e7\u05d9\u05d5\u05dd \u05d4\u05e4\u05d5\u05d2\u05d4 \u05d1\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e9\u05dc \u05de\u05e1\u05e4\u05e8 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05dc\u05e4\u05d7\u05d5\u05ea \u05d1\u05d9\u05df \u05ea\u05e7\u05d5\u05e4\u05d5\u05ea \u05e9\u05dc \u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05d4\u05d4\u05e4\u05e8\u05e2\u05d4 (DSM p.662)."
    },
    {
      "front": "\u05de\u05d4 \u05d9\u05d3\u05d5\u05e2 \u05e2\u05dc \u05d4\u05d2\u05d5\u05e8\u05de\u05d9\u05dd \u05d4\u05d2\u05e0\u05d8\u05d9\u05d9\u05dd \u05d5\u05d4\u05de\u05e9\u05e4\u05d7\u05ea\u05d9\u05d9\u05dd \u05d1-Gambling Disorder?",
      "back": "\u05d4\u05e4\u05e8\u05e2\u05d4 \u05e9\u05db\u05d9\u05d7\u05d4 \u05d9\u05d5\u05ea\u05e8 \u05d1\u05e7\u05e8\u05d5\u05d1\u05d9 \u05de\u05e9\u05e4\u05d7\u05d4 \u05de\u05d3\u05e8\u05d2\u05d4 \u05e8\u05d0\u05e9\u05d5\u05e0\u05d4 \u05e9\u05dc \u05d0\u05e0\u05e9\u05d9\u05dd \u05e2\u05dd Moderate to severe Alcohol use disorder (DSM p.664)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05d4\u05d0\u05d5\u05d1\u05d3\u05e0\u05d9 (Suicide mortality rate) \u05d1\u05e7\u05e8\u05d1 \u05d0\u05e0\u05e9\u05d9\u05dd \u05e2\u05dd Gambling Disorder \u05d1\u05d4\u05e9\u05d5\u05d5\u05d0\u05d4 \u05dc\u05d0\u05d5\u05db\u05dc\u05d5\u05e1\u05d9\u05d9\u05d4 \u05d4\u05db\u05dc\u05dc\u05d9\u05ea?",
      "back": "\u05e2\u05dc\u05d9\u05d9\u05d4 \u05e9\u05dc \u05e4\u05d9 15 \u05d1\u05e9\u05d9\u05e2\u05d5\u05e8 \u05d4\u05ea\u05de\u05d5\u05ea\u05d4 \u05de\u05d4\u05ea\u05d0\u05d1\u05d3\u05d5\u05ea (DSM p.665)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df \u05d4-'Bailout' (A9) \u05d1\u05d0\u05d1\u05d7\u05e0\u05ea \u05d4\u05d9\u05de\u05d5\u05e8\u05d9\u05dd?",
      "back": "\u05d4\u05e1\u05ea\u05de\u05db\u05d5\u05ea \u05e2\u05dc \u05d0\u05d7\u05e8\u05d9\u05dd (\u05de\u05e9\u05e4\u05d7\u05d4/\u05d7\u05d1\u05e8\u05d9\u05dd) \u05dc\u05e6\u05d5\u05e8\u05da \u05d0\u05e1\u05e4\u05e7\u05ea \u05db\u05e1\u05e3 \u05dc\u05e4\u05ea\u05e8\u05d5\u05df \u05de\u05e6\u05d1 \u05db\u05dc\u05db\u05dc\u05d9 \u05e0\u05d5\u05d0\u05e9 \u05e9\u05e0\u05d2\u05e8\u05dd \u05de\u05d4\u05d9\u05de\u05d5\u05e8\u05d9\u05dd (DSM p.662)."
    },
    {
