    {
      "type": "multiple_choice",
      "question": "\u05dc\u05e4\u05d9 \u05d4-$DSM-5-TR$, \u05ea\u05d7\u05ea \u05d0\u05d9\u05d6\u05d5 \u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4 \u05d0\u05d1\u05d7\u05e0\u05ea\u05d9\u05ea \u05d9\u05e9 \u05dc\u05e1\u05d5\u05d5\u05d2 \u05de\u05e7\u05e8\u05d4 \u05e9\u05dc $OCD$ \u05d7\u05e8\u05d9\u05e3 \u05e9\u05d4\u05ea\u05e4\u05ea\u05d7 \u05e2\u05dc \u05e8\u05e7\u05e2 \u05de\u05d7\u05dc\u05d4 \u05e8\u05e4\u05d5\u05d0\u05d9\u05ea \u05d0\u05d5\u05d8\u05d5\u05d0\u05d9\u05de\u05d5\u05e0\u05d9\u05ea \u05de\u05d5\u05db\u05d7\u05ea (\u05db\u05d2\u05d5\u05df $PANS$)?",
      "answerOptions": [
        {
          "text": "$Obsessive-Compulsive~and~Related~Disorder~Due~to~Another~Medical~Condition$.",
          "isCorrect": true,
          "rationale": "\u05d4-$DSM-5-TR$ \u05d0\u05d9\u05e0\u05d5 \u05de\u05db\u05d9\u05e8 \u05d1-$PANDAS/PANS$ \u05db\u05d9\u05e9\u05d5\u05ea \u05e0\u05e4\u05e8\u05d3\u05ea \u05d5\u05de\u05e0\u05d7\u05d4 \u05dc\u05e7\u05d5\u05d3\u05d3 \u05de\u05e7\u05e8\u05d9\u05dd \u05d0\u05dc\u05d5 \u05ea\u05d7\u05ea \u05d4\u05e4\u05e8\u05e2\u05d4 \u05d8\u05d5\u05e8\u05d3\u05e0\u05d9\u05ea-\u05db\u05e4\u05d9\u05d9\u05ea\u05d9\u05ea \u05d4\u05e0\u05d5\u05d1\u05e2\u05ea \u05de\u05de\u05e6\u05d1 \u05e8\u05e4\u05d5\u05d0\u05d9 (DSM p.292)."
        },
        {
          "text": "$Pediatric~Autoimmune~Neuropsychiatric~Disorder$.",
          "isCorrect": false,
          "rationale": "\u05d6\u05d5\u05d4\u05d9 \u05d4\u05e6\u05e2\u05d4 \u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05d0\u05da \u05d4\u05d9\u05d0 \u05d0\u05d9\u05e0\u05d4 \u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4 \u05e8\u05e9\u05de\u05d9\u05ea \u05d1-$DSM-5-TR$ (DSM p.292)."
        },
        {
          "text": "$Other~Specified~Anxiety~Disorder$.",
          "isCorrect": false,
          "rationale": "\u05db\u05e9\u05d9\u05e9 \u05d0\u05d8\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05d4 \u05e8\u05e4\u05d5\u05d0\u05d9\u05ea \u05d1\u05e8\u05d5\u05e8\u05d4 \u05d5\u05ea\u05e1\u05de\u05d9\u05e0\u05d9 $OCD$ \u05d3\u05d5\u05de\u05d9\u05e0\u05e0\u05d8\u05d9\u05d9\u05dd, \u05d4\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4 \u05d4\u05d9\u05d9\u05e2\u05d5\u05d3\u05d9\u05ea \u05dc\u05de\u05e6\u05d1\u05d9\u05dd \u05e8\u05e4\u05d5\u05d0\u05d9\u05d9\u05dd \u05e2\u05d3\u05d9\u05e4\u05d4 (DSM p.292)."
        },
        {
          "text": "$Adjustment~Disorder~with~mixed~anxiety~and~depressed~mood$.",
          "isCorrect": false,
          "rationale": "\u05d4\u05e4\u05e8\u05e2\u05ea \u05d4\u05e1\u05ea\u05d2\u05dc\u05d5\u05ea \u05d0\u05d9\u05e0\u05d4 \u05de\u05ea\u05d0\u05d9\u05de\u05d4 \u05dc\u05de\u05e6\u05d1 \u05e9\u05d1\u05d5 \u05d9\u05e9 \u05e4\u05ea\u05d5\u05e4\u05d9\u05d6\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05d4 \u05e8\u05e4\u05d5\u05d0\u05d9\u05ea \u05d9\u05e9\u05d9\u05e8\u05d4 \u05d4\u05d2\u05d5\u05e8\u05de\u05ea \u05dc\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd (DSM p.319)."
        }
      ],
      "hint": "\u05d7\u05e4\u05e9 \u05d0\u05ea \u05d4\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4 \u05e9\u05de\u05e9\u05e7\u05e4\u05ea \u05e7\u05e9\u05e8 \u05e1\u05d9\u05d1\u05ea\u05d9 \u05d1\u05d9\u05df \u05de\u05d7\u05dc\u05d4 \u05d2\u05d5\u05e4\u05e0\u05d9\u05ea \u05dc\u05ea\u05e1\u05de\u05d9\u05e0\u05d9 $OCD$.",
