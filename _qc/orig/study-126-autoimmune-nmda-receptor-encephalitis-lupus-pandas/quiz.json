          "text": "\u05d4\u05df \u05de\u05d5\u05e8\u05d9\u05d3\u05d5\u05ea \u05d0\u05ea \u05e1\u05e3 \u05d4\u05e4\u05e8\u05db\u05d5\u05e1 \u05d1\u05d0\u05d5\u05e4\u05df \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9 \u05d9\u05d5\u05ea\u05e8 \u05d1\u05d7\u05d5\u05dc\u05d9\u05dd \u05d0\u05dc\u05d5 \u05de\u05d0\u05e9\u05e8 \u05d1\u05d0\u05d5\u05db\u05dc\u05d5\u05e1\u05d9\u05d9\u05d4 \u05d4\u05db\u05dc\u05dc\u05d9\u05ea.",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05e9\u05d4\u05df \u05de\u05d5\u05e8\u05d9\u05d3\u05d5\u05ea \u05e1\u05e3 \u05e4\u05e8\u05db\u05d5\u05e1, \u05d4\u05e1\u05db\u05e0\u05d4 \u05d4\u05e2\u05d9\u05e7\u05e8\u05d9\u05ea \u05d5\u05d4\u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05ea \u05d4\u05de\u05d5\u05d3\u05d2\u05e9\u05ea \u05d1\u05de\u05e7\u05d5\u05e8\u05d5\u05ea \u05d4\u05d9\u05d0 \u05d4-$Extreme~neuroleptic~sensitivity$ (DSM p.810, Dulcan p.398)."
        },
        {
          "text": "\u05d0\u05e0\u05d8\u05d9-\u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9\u05d9\u05dd \u05d7\u05d5\u05e1\u05de\u05d9\u05dd \u05d0\u05ea \u05d4\u05e7\u05d9\u05e9\u05d5\u05e8 \u05e9\u05dc \u05d4-$IVIG$ \u05dc\u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 \u05d4-$NMDA$.",
          "isCorrect": false,
          "rationale": "\u05d0\u05d9\u05df \u05d0\u05d9\u05e0\u05d8\u05e8\u05d0\u05e7\u05e6\u05d9\u05d4 \u05de\u05e0\u05d2\u05e0\u05d5\u05e0\u05d9\u05ea \u05db\u05d6\u05d5; $IVIG$ \u05e4\u05d5\u05e2\u05dc \u05d1\u05d3\u05e8\u05db\u05d9\u05dd \u05d0\u05d9\u05de\u05d5\u05e0\u05d5\u05dc\u05d5\u05d2\u05d9\u05d5\u05ea \u05e9\u05d5\u05e0\u05d5\u05ea (\u05de\u05e7\u05d5\u05e8: \u05d4\u05e7\u05e9\u05e8 \u05e8\u05d7\u05d1)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05e1\u05d9\u05d1\u05d5\u05da \u05d4\u05de\u05d5\u05d8\u05d5\u05e8\u05d9-\u05d0\u05d5\u05d8\u05d5\u05e0\u05d5\u05de\u05d9 \u05d4\u05d7\u05de\u05d5\u05e8 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05e9\u05e7\u05e9\u05d5\u05e8 \u05dc\u05d7\u05e1\u05d9\u05de\u05ea \u05e8\u05e6\u05e4\u05d8\u05d5\u05e8\u05d9\u05dd \u05d3\u05d5\u05e4\u05de\u05d9\u05e0\u05e8\u05d2\u05d9\u05d9\u05dd.",
      "imageUrls": []
    },
    {
      "type": "short_answer",
      "question": "\u05ea\u05d0\u05e8 \u05d0\u05ea \u05d4\u05e4\u05ea\u05d5\u05e4\u05d9\u05d6\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05d4 \u05e9\u05dc $Molecular~Mimicry$ \u05d1\u05d4\u05e7\u05e9\u05e8 \u05e9\u05dc \u05ea\u05e1\u05de\u05d5\u05e0\u05ea $PANDAS$. \u05d0\u05d9\u05dc\u05d5 \u05de\u05d1\u05e0\u05d9\u05dd \u05de\u05d5\u05d7\u05d9\u05d9\u05dd \u05de\u05e2\u05d5\u05e8\u05d1\u05d9\u05dd \u05d5\u05de\u05d4\u05df \u05de\u05d8\u05e8\u05d5\u05ea \u05d4\u05e0\u05d5\u05d2\u05d3\u05e0\u05d9\u05dd?",
      "grading": {
        "modelAnswer": "\u05d4\u05e4\u05ea\u05d5\u05e4\u05d9\u05d6\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05d4 \u05e9\u05dc $PANDAS$ \u05de\u05d1\u05d5\u05e1\u05e1\u05ea \u05e2\u05dc \u05ea\u05d2\u05d5\u05d1\u05d4 \u05d7\u05d9\u05e1\u05d5\u05e0\u05d9\u05ea \u05dc\u05d6\u05d9\u05d4\u05d5\u05dd \u05d1\u05e1\u05d8\u05e8\u05d0\u05e4\u05d8\u05d5\u05e7\u05d5\u05e7 ($GABHS$), \u05e9\u05d1\u05d4 \u05e0\u05d5\u05e6\u05e8\u05d9\u05dd \u05e0\u05d5\u05d2\u05d3\u05e0\u05d9\u05dd \u05d4\u05ea\u05d5\u05e7\u05e4\u05d9\u05dd \u05d1\u05d8\u05e2\u05d5\u05ea \u05d0\u05ea \u05d2\u05e8\u05e2\u05d9\u05e0\u05d9 \u05d4\u05d1\u05e1\u05d9\u05e1 ($Basal~Ganglia$) \u05d1\u05e9\u05dc \u05d3\u05de\u05d9\u05d5\u05df \u05de\u05d1\u05e0\u05d9 \u05d1\u05d9\u05df \u05d0\u05e0\u05d8\u05d9\u05d2\u05e0\u05d9\u05dd \u05e9\u05dc \u05d4\u05d7\u05d9\u05d9\u05d3\u05e7 \u05dc\u05d0\u05e0\u05d8\u05d9\u05d2\u05e0\u05d9\u05dd \u05e2\u05e6\u05de\u05d9\u05d9\u05dd. \u05d4\u05e0\u05d5\u05d2\u05d3\u05e0\u05d9\u05dd ($Anti-basal~ganglia~antibodies$) \u05e0\u05e7\u05e9\u05e8\u05d9\u05dd \u05dc\u05de\u05d8\u05e8\u05d5\u05ea \u05db\u05de\u05d5 \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 $D_2$, $Tubulin$, \u05d5-$Lysoganglioside~GM1$, \u05de\u05d4 \u05e9\u05de\u05d5\u05d1\u05d9\u05dc \u05dc\u05d4\u05e4\u05e2\u05dc\u05d4 \u05e9\u05dc $CaMKII$ \u05d5\u05dc\u05d4\u05e4\u05e8\u05e9\u05d4 \u05de\u05d5\u05d2\u05d1\u05e8\u05ea \u05e9\u05dc \u05d3\u05d5\u05e4\u05de\u05d9\u05df.",
        "rationale": "\u05d4\u05d1\u05e0\u05ea \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05d0\u05d9\u05de\u05d5\u05e0\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d4\u05de\u05de\u05d5\u05e7\u05d3 \u05d1\u05d2\u05e8\u05e2\u05d9\u05e0\u05d9 \u05d4\u05d1\u05e1\u05d9\u05e1 \u05d7\u05d9\u05d5\u05e0\u05d9\u05ea \u05dc\u05d4\u05d1\u05e0\u05ea \u05d4\u05e7\u05e9\u05e8 \u05d1\u05d9\u05df \u05d6\u05d9\u05d4\u05d5\u05dd \u05dc\u05d1\u05d9\u05df \u05d4\u05d5\u05e4\u05e2\u05ea \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d7\u05d5\u05d6\u05e8\u05d9\u05dd \u05d5\u05d8\u05d9\u05e7\u05d9\u05dd (Dulcan p.367, p.371).",
        "requiredAttributes": [
          "\u05e6\u05d9\u05d5\u05df \u05d4\u05e7\u05e9\u05e8 \u05dc\u05d6\u05d9\u05d4\u05d5\u05dd \u05d1-$GABHS$ \u05d0\u05d5 \u05e1\u05d8\u05e8\u05d0\u05e4\u05d8\u05d5\u05e7\u05d5\u05e7.",
          "\u05d6\u05d9\u05d4\u05d5\u05d9 \u05d4\u05de\u05d1\u05e0\u05d4 \u05d4\u05de\u05d5\u05d7\u05d9 \u05d4\u05de\u05e2\u05d5\u05e8\u05d1 \u05db\u05d2\u05e8\u05e2\u05d9\u05e0\u05d9 \u05d4\u05d1\u05e1\u05d9\u05e1 ($Basal~Ganglia$) \u05d0\u05d5 $Striatum$.",
          "\u05e6\u05d9\u05d5\u05df \u05d4\u05de\u05d5\u05e0\u05d7 $Molecular~mimicry$ \u05d0\u05d5 \u05ea\u05d2\u05d5\u05d1\u05ea\u05d9\u05d5\u05ea \u05de\u05d5\u05e6\u05dc\u05d1\u05ea \u05e9\u05dc \u05e0\u05d5\u05d2\u05d3\u05e0\u05d9\u05dd.",
          "\u05d0\u05d6\u05db\u05d5\u05e8 \u05e9\u05dc \u05de\u05d8\u05e8\u05d5\u05ea \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05d5\u05ea \u05db\u05de\u05d5 \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 \u05d3\u05d5\u05e4\u05de\u05d9\u05df \u05d0\u05d5 $CaMKII$."
        ],
        "errors": {
          "misconceptions": [
            "\u05d8\u05e2\u05d5\u05ea \u05d1\u05d6\u05d9\u05d4\u05d5\u05d9 \u05d4\u05de\u05d1\u05e0\u05d4 \u05d4\u05de\u05d5\u05d7\u05d9 (\u05dc\u05de\u05e9\u05dc \u05d4\u05d9\u05e4\u05d5\u05e7\u05de\u05e4\u05d5\u05e1 \u05d1\u05de\u05e7\u05d5\u05dd \u05d2\u05e8\u05e2\u05d9\u05e0\u05d9 \u05d1\u05e1\u05d9\u05e1).",
            "\u05d8\u05e2\u05e0\u05d4 \u05e9\u05d4\u05e0\u05d5\u05d2\u05d3\u05e0\u05d9\u05dd \u05ea\u05d5\u05e7\u05e4\u05d9\u05dd \u05d9\u05e9\u05d9\u05e8\u05d5\u05ea \u05d0\u05ea \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 \u05d4-$NMDA$ (\u05d6\u05d4 \u05e7\u05d5\u05e8\u05d4 \u05d1\u05d0\u05e0\u05e6\u05e4\u05dc\u05d9\u05d8\u05d9\u05e1 \u05d0\u05d7\u05e8\u05ea)."
          ],
          "bluffs": [
            "\u05d4\u05e1\u05d1\u05e8 \u05db\u05dc\u05dc\u05d9 \u05e2\u05dc \u05d3\u05dc\u05e7\u05ea \u05d1\u05de\u05d5\u05d7 \u05dc\u05dc\u05d0 \u05e4\u05d9\u05e8\u05d5\u05d8 \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05d0\u05d9\u05de\u05d5\u05e0\u05d5-\u05db\u05d9\u05de\u05d9."
          ]
        }
      },
      "hint": "\u05d4\u05ea\u05de\u05e7\u05d3 \u05d1\u05e7\u05e9\u05e8 \u05e9\u05d1\u05d9\u05df \u05d3\u05d5\u05e4\u05df \u05d4\u05d7\u05d9\u05d9\u05d3\u05e7 \u05dc\u05d1\u05d9\u05df \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 \u05d4\u05d3\u05d5\u05e4\u05de\u05d9\u05df \u05d1\u05d2\u05e8\u05e2\u05d9\u05e0\u05d9\u05dd \u05d4\u05d0\u05d7\u05e8\u05d0\u05d9\u05dd \u05e2\u05dc \u05ea\u05e0\u05d5\u05e2\u05d4 \u05d5\u05d1\u05e7\u05e8\u05ea \u05d3\u05d7\u05e4\u05d9\u05dd.",
      "imageUrls": []
