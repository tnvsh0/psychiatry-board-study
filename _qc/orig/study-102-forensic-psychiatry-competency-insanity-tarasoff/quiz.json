      "hint": "\u05d7\u05e9\u05d1\u05d5 \u05e2\u05dc \u05d0\u05dc\u05d9\u05de\u05d5\u05ea '\u05d7\u05de\u05ea \u05de\u05d6\u05d2' \u05e9\u05de\u05ea\u05e4\u05e8\u05e6\u05ea \u05d1\u05e8\u05d2\u05e2 \u05e9\u05dc \u05db\u05e2\u05e1."
    },
    {
      "type": "multiple_choice",
      "question": "\u05e0\u05e2\u05e8 \u05e2\u05dd Intellectual Developmental Disorder (ID) \u05e0\u05e2\u05e6\u05e8 \u05d1\u05d7\u05e9\u05d3 \u05dc\u05de\u05e2\u05d5\u05e8\u05d1\u05d5\u05ea \u05d1\u05e9\u05d5\u05d3. \u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05d7\u05e7\u05d9\u05e8\u05d4, \u05d4\u05d5\u05d0 \u05de\u05d5\u05d3\u05d4 \u05d1\u05d1\u05d9\u05e6\u05d5\u05e2 \u05d4\u05de\u05e2\u05e9\u05d4 \u05dc\u05de\u05e8\u05d5\u05ea \u05e9\u05e9\u05d4\u05d4 \u05d1\u05d1\u05d9\u05ea\u05d5 \u05d1\u05d0\u05d5\u05ea\u05d4 \u05e2\u05ea. \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR, \u05d0\u05d9\u05d6\u05d4 \u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05d0\u05d9\u05e9\u05d9\u05d5\u05ea\u05d9 \u05ea\u05d5\u05e8\u05dd \u05dc\u05e1\u05d9\u05db\u05d5\u05df \u05d4\u05de\u05d5\u05d2\u05d1\u05e8 \u05e9\u05dc \u05d0\u05d5\u05db\u05dc\u05d5\u05e1\u05d9\u05d9\u05d4 \u05d6\u05d5 \u05dc\u05de\u05ea\u05df False confessions?",
      "answerOptions": [
        {
          "text": "Gullibility and suggestibility",
          "isCorrect": true,
          "rationale": "\u05d0\u05e0\u05e9\u05d9\u05dd \u05e2\u05dd \u05de\u05d5\u05d2\u05d1\u05dc\u05d5\u05ea \u05e9\u05db\u05dc\u05d9\u05ea \u05de\u05ea\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9\u05dd \u05d1\u05e0\u05d0\u05d9\u05d1\u05d9\u05d5\u05ea \u05d5\u05d1\u05e0\u05d8\u05d9\u05d9\u05d4 \u05dc\u05d4\u05d9\u05d5\u05ea \u05de\u05d5\u05d1\u05dc\u05d9\u05dd \u05d1\u05e7\u05dc\u05d5\u05ea, \u05de\u05d4 \u05e9\u05de\u05e2\u05dc\u05d4 \u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05e0\u05d9\u05e6\u05d5\u05dc \u05d5\u05dc\u05d4\u05d5\u05d3\u05d0\u05d5\u05ea \u05e9\u05d5\u05d5\u05d0 \u05ea\u05d7\u05ea \u05dc\u05d7\u05e5 (DSM p.44)."
        },
        {
          "text": "Callous-unemotional traits",
          "isCorrect": false,
          "rationale": "\u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9\u05dd \u05d0\u05dc\u05d5 \u05e7\u05e9\u05d5\u05e8\u05d9\u05dd \u05dc-Conduct Disorder \u05e2\u05dd \u05e8\u05d2\u05e9\u05d5\u05ea \u05e4\u05e8\u05d5-\u05e1\u05d5\u05e6\u05d9\u05d0\u05dc\u05d9\u05d9\u05dd \u05de\u05d5\u05d2\u05d1\u05dc\u05d9\u05dd \u05d5\u05dc\u05d0 \u05dc\u05de\u05d5\u05d2\u05d1\u05dc\u05d5\u05ea \u05e9\u05db\u05dc\u05d9\u05ea (DSM p.531)."
        },
        {
          "text": "Hypervigilance to threat",
          "isCorrect": false,
          "rationale": "\u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05d6\u05d4 \u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05d9 \u05dc-PTSD \u05d0\u05d5 \u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05d7\u05e8\u05d3\u05d4 \u05d5\u05dc\u05d0 \u05e0\u05d7\u05e9\u05d1 \u05dc\u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05dc\u05d9\u05d1\u05d4 \u05e9\u05dc \u05de\u05d5\u05d2\u05d1\u05dc\u05d5\u05ea \u05e9\u05db\u05dc\u05d9\u05ea (DSM p.310)."
        },
        {
          "text": "Psychomotor agitation",
          "isCorrect": false,
          "rationale": "\u05d6\u05d4\u05d5 \u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05dd \u05e9\u05dc \u05d0\u05e4\u05d9\u05d6\u05d5\u05d3\u05d4 \u05de\u05e6\u05d1\u05d9\u05ea (\u05db\u05de\u05d5 Mania \u05d0\u05d5 Depression) \u05d5\u05d0\u05d9\u05e0\u05d5 \u05de\u05e1\u05d1\u05d9\u05e8 \u05d0\u05ea \u05d4\u05e0\u05d8\u05d9\u05d9\u05d4 \u05dc\u05de\u05ea\u05df \u05d4\u05d5\u05d3\u05d0\u05d5\u05ea \u05e9\u05d5\u05d5\u05d0 (DSM p.140)."
        }
      ],
      "hint": "\u05d7\u05e4\u05e9\u05d5 \u05d0\u05ea \u05d4\u05de\u05d5\u05e9\u05d2 \u05d4\u05de\u05ea\u05d0\u05e8 \u05e4\u05d2\u05d9\u05e2\u05d5\u05ea \u05dc\u05d4\u05e9\u05e4\u05e2\u05d4 \u05d7\u05d9\u05e6\u05d5\u05e0\u05d9\u05ea \u05d5\u05d7\u05d5\u05e1\u05e8 \u05d1\u05d9\u05e7\u05d5\u05e8\u05ea\u05d9\u05d5\u05ea."
    },
    {
      "type": "multiple_choice",
      "question": "\u05d4\u05d5\u05e8\u05d9\u05dd \u05d2\u05e8\u05d5\u05e9\u05d9\u05dd \u05e0\u05de\u05e6\u05d0\u05d9\u05dd \u05d1-Custody dispute \u05d7\u05e8\u05d9\u05e3. \u05d4\u05d0\u05dd, \u05d4\u05de\u05d5\u05d2\u05d3\u05e8\u05ea \u05db\u05d1\u05e2\u05dc\u05ea Physical custody, \u05de\u05e2\u05d5\u05e0\u05d9\u05d9\u05e0\u05ea \u05dc\u05d4\u05ea\u05d7\u05d9\u05dc \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Methylphenidate \u05e2\u05d1\u05d5\u05e8 \u05d1\u05e0\u05dd \u05d4\u05de\u05d0\u05d5\u05d1\u05d7\u05df \u05e2\u05dd ADHD. \u05d4\u05d0\u05d1, \u05d1\u05e2\u05dc Joint legal custody, \u05de\u05ea\u05e0\u05d2\u05d3 \u05e0\u05d7\u05e8\u05e6\u05d5\u05ea \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05ea\u05e8\u05d5\u05e4\u05ea\u05d9. \u05de\u05d4\u05d9 \u05d4\u05d2\u05d9\u05e9\u05d4 \u05d4\u05de\u05d5\u05de\u05dc\u05e6\u05ea \u05dc\u05e4\u05d9 StahlKids \u05d5-Dulcan?",
      "answerOptions": [
        {
          "text": "Obtain consent from both legal guardians before starting medication",
          "isCorrect": true,
          "rationale": "\u05d1\u05de\u05e7\u05e8\u05d9\u05dd \u05e9\u05dc \u05de\u05e9\u05de\u05d5\u05e8\u05ea \u05de\u05e9\u05e4\u05d8\u05d9\u05ea \u05de\u05e9\u05d5\u05ea\u05e4\u05ea (Joint legal custody), \u05d4\u05d7\u05dc\u05d8\u05d5\u05ea \u05d8\u05d9\u05e4\u05d5\u05dc\u05d9\u05d5\u05ea \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05d5\u05ea \u05d3\u05d5\u05e8\u05e9\u05d5\u05ea \u05d4\u05e1\u05db\u05de\u05d4 \u05e9\u05dc \u05e9\u05e0\u05d9 \u05d4\u05d4\u05d5\u05e8\u05d9\u05dd (Dulcan p.646, StahlKids p.16)."
        },
        {
          "text": "Follow the mother's wishes since she has physical custody",
          "isCorrect": false,
          "rationale": "\u05de\u05e9\u05de\u05d5\u05e8\u05ea \u05e4\u05d9\u05d6\u05d9\u05ea \u05d0\u05d9\u05e0\u05d4 \u05de\u05e2\u05e0\u05d9\u05e7\u05d4 \u05d6\u05db\u05d5\u05ea \u05d1\u05dc\u05e2\u05d3\u05d9\u05ea \u05dc\u05e7\u05d1\u05dc\u05ea \u05d4\u05d7\u05dc\u05d8\u05d5\u05ea \u05e8\u05e4\u05d5\u05d0\u05d9\u05d5\u05ea \u05db\u05d0\u05e9\u05e8 \u05e7\u05d9\u05d9\u05de\u05ea \u05de\u05e9\u05de\u05d5\u05e8\u05ea \u05de\u05e9\u05e4\u05d8\u05d9\u05ea \u05de\u05e9\u05d5\u05ea\u05e4\u05ea (Dulcan p.646)."
        },
        {
          "text": "Start the medication anyway as it is in the child's best interest",
          "isCorrect": false,
          "rationale": "\u05d4\u05ea\u05e2\u05dc\u05de\u05d5\u05ea \u05de\u05d4\u05ea\u05e0\u05d2\u05d3\u05d5\u05ea \u05e9\u05dc \u05d0\u05e4\u05d5\u05d8\u05e8\u05d5\u05e4\u05d5\u05e1 \u05d7\u05d5\u05e7\u05d9 \u05dc\u05dc\u05d0 \u05e6\u05d5 \u05d1\u05d9\u05ea \u05de\u05e9\u05e4\u05d8 \u05de\u05d4\u05d5\u05d5\u05d4 \u05d4\u05e4\u05e8\u05d4 \u05e9\u05dc \u05db\u05dc\u05dc\u05d9 \u05d4\u05d4\u05e1\u05db\u05de\u05d4 \u05de\u05d3\u05e2\u05ea (Informed consent) (Dulcan p.641)."
        },
        {
          "text": "Rely on the child's assent only if he is over age 12",
          "isCorrect": false,
          "rationale": "Assent \u05e9\u05dc \u05e7\u05d8\u05d9\u05df \u05d4\u05d5\u05d0 \u05d7\u05e9\u05d5\u05d1 \u05d0\u05da \u05d0\u05d9\u05e0\u05d5 \u05de\u05d4\u05d5\u05d5\u05d4 \u05ea\u05d7\u05dc\u05d9\u05e3 \u05de\u05e9\u05e4\u05d8\u05d9 \u05dc\u05d4\u05e1\u05db\u05de\u05d4 (Consent) \u05e9\u05dc \u05d4\u05d0\u05e4\u05d5\u05d8\u05e8\u05d5\u05e4\u05d5\u05e1\u05d9\u05dd \u05d4\u05d7\u05d5\u05e7\u05d9\u05d9\u05dd (StahlKids p.16)."
        }
      ],
      "hint": "\u05d1\u05d7\u05e0\u05d5 \u05d0\u05ea \u05d4\u05de\u05e9\u05de\u05e2\u05d5\u05ea \u05d4\u05de\u05e9\u05e4\u05d8\u05d9\u05ea \u05e9\u05dc \u05d4\u05de\u05d5\u05e9\u05d2 'Joint legal custody' \u05dc\u05d2\u05d1\u05d9 \u05e7\u05d1\u05dc\u05ea \u05d4\u05d7\u05dc\u05d8\u05d5\u05ea \u05e8\u05e4\u05d5\u05d0\u05d9\u05d5\u05ea."
