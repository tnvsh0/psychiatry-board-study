    },
    {
      "type": "multiple_choice",
      "question": "\u05dc\u05e4\u05d9 \u05d4\u05de\u05d5\u05d3\u05dc \u05d4\u05de\u05d5\u05e6\u05d2 \u05d1-StahlNeuro, \u05d0\u05dc\u05d9\u05de\u05d5\u05ea \u05d4\u05de\u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05ea \u05d1\u05e8\u05de\u05ea Autonomic arousal \u05d2\u05d1\u05d5\u05d4\u05d4, \u05e9\u05de\u05ea\u05e8\u05d7\u05e9\u05ea \u05db\u05ea\u05d2\u05d5\u05d1\u05d4 \u05dc-Provocation \u05d0\u05d5 \u05ea\u05e1\u05db\u05d5\u05dc, \u05d5\u05de\u05dc\u05d5\u05d5\u05d4 \u05d1\u05e8\u05d2\u05e9\u05d5\u05ea \u05e9\u05dc \u05db\u05e2\u05e1 \u05d0\u05d5 \u05e4\u05d7\u05d3, \u05de\u05e1\u05d5\u05d5\u05d2\u05ea \u05db:",
      "answerOptions": [
