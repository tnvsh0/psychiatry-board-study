        "oxytocin"
      ],
      "rationale": "Oxytocin \u05d4\u05d5\u05d0 \u05d4\u05d5\u05e8\u05de\u05d5\u05df \u05d4\u05e7\u05e9\u05d5\u05e8 \u05dc\u05e7\u05d9\u05e9\u05d5\u05e8 \u05d7\u05d1\u05e8\u05ea\u05d9 \u05d5\u05d0\u05de\u05d5\u05df; \u05e8\u05de\u05d5\u05ea \u05e0\u05de\u05d5\u05db\u05d5\u05ea \u05e9\u05dc\u05d5 \u05d1-BPD \u05e2\u05e9\u05d5\u05d9\u05d5\u05ea \u05dc\u05d4\u05e1\u05d1\u05d9\u05e8 \u05d0\u05ea \u05d4\u05e8\u05d2\u05d9\u05e9\u05d5\u05ea \u05d4\u05d1\u05d9\u05e0\u05d0\u05d9\u05e9\u05d9\u05ea \u05d5\u05d4\u05e7\u05d5\u05e9\u05d9 \u05d1\u05d1\u05d9\u05d8\u05d7\u05d5\u05df \u05d1\u05e7\u05e9\u05e8 (Dulcan p.535).",
      "hint": "\u05de\u05d3\u05d5\u05d1\u05e8 \u05d1\u05e0\u05d5\u05e8\u05d5\u05d4\u05d5\u05e8\u05de\u05d5\u05df \u05d4\u05de\u05db\u05d5\u05e0\u05d4 \u05dc\u05e2\u05d9\u05ea\u05d9\u05dd \"\u05d4\u05d5\u05e8\u05de\u05d5\u05df \u05d4\u05d0\u05d4\u05d1\u05d4\" \u05d0\u05d5 \"\u05d4\u05d5\u05e8\u05de\u05d5\u05df \u05d4\u05e0\u05e7\u05e9\u05e8\u05d5\u05ea\"."
    },
    {
      "type": "short_answer",
      "question": "\u05d4\u05e1\u05d1\u05e8 \u05d0\u05ea \u05d4\u05de\u05d5\u05e9\u05d2 Mentalization (\u05de\u05e0\u05d8\u05dc\u05d9\u05d6\u05e6\u05d9\u05d4) \u05d1\u05d4\u05e7\u05e9\u05e8 \u05e9\u05dc \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-BPD, \u05d5\u05db\u05d9\u05e6\u05d3 \u05e4\u05d2\u05d9\u05e2\u05d4 \u05d1\u05d9\u05db\u05d5\u05dc\u05ea \u05d6\u05d5 \u05ea\u05d5\u05e8\u05de\u05ea \u05dc\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd.",
      "grading": {
        "modelAnswer": "\u05de\u05e0\u05d8\u05dc\u05d9\u05d6\u05e6\u05d9\u05d4 \u05d4\u05d9\u05d0 \u05d4\u05d9\u05db\u05d5\u05dc\u05ea \u05dc\u05d4\u05d1\u05d9\u05df \u05d0\u05ea \u05d4\u05de\u05e6\u05d1\u05d9\u05dd \u05d4\u05de\u05e0\u05d8\u05dc\u05d9\u05d9\u05dd (\u05e8\u05d2\u05e9\u05d5\u05ea, \u05de\u05d7\u05e9\u05d1\u05d5\u05ea, \u05db\u05d5\u05d5\u05e0\u05d5\u05ea) \u05e9\u05dc \u05d4\u05e2\u05e6\u05de\u05d9 \u05d5\u05e9\u05dc \u05d4\u05d0\u05d7\u05e8. \u05d1\u05de\u05d8\u05d5\u05e4\u05dc\u05d9 BPD \u05e7\u05d9\u05d9\u05de\u05ea \u05d9\u05e8\u05d9\u05d3\u05d4 \u05d1\u05d9\u05db\u05d5\u05dc\u05ea \u05d6\u05d5 \u05ea\u05d7\u05ea \u05d3\u05d7\u05e7 \u05d1\u05d9\u05e0\u05d0\u05d9\u05e9\u05d9, \u05de\u05d4 \u05e9\u05de\u05d5\u05d1\u05d9\u05dc \u05dc\u05e4\u05d9\u05e8\u05d5\u05e9 \u05e9\u05d2\u05d5\u05d9 \u05e9\u05dc \u05db\u05d5\u05d5\u05e0\u05d5\u05ea \u05d4\u05d0\u05d7\u05e8 (\u05dc\u05de\u05e9\u05dc, \u05ea\u05e4\u05d9\u05e1\u05ea \u05e0\u05d9\u05d8\u05e8\u05dc\u05d9\u05d5\u05ea \u05db\u05e0\u05d8\u05d9\u05e9\u05d4) \u05d5\u05dc\u05ea\u05d2\u05d5\u05d1\u05d5\u05ea \u05e8\u05d2\u05e9\u05d9\u05d5\u05ea \u05d5\u05d0\u05d9\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05d5\u05ea \u05d1\u05dc\u05ea\u05d9 \u05de\u05d5\u05d5\u05e1\u05ea\u05d5\u05ea.",
        "rationale": "\u05de\u05e0\u05d8\u05dc\u05d9\u05d6\u05e6\u05d9\u05d4 \u05d4\u05d9\u05d0 \u05d4\u05d1\u05e1\u05d9\u05e1 \u05dc-MBT; \u05d4\u05d9\u05d0 \u05de\u05d0\u05e4\u05e9\u05e8\u05ea \u05d5\u05d9\u05e1\u05d5\u05ea \u05e8\u05d2\u05e9\u05d9 \u05d3\u05e8\u05da \u05d4\u05d1\u05e0\u05d4 \u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9\u05ea \u05e9\u05dc \u05d7\u05d5\u05d5\u05d9\u05d5\u05ea \u05e4\u05e0\u05d9\u05de\u05d9\u05d5\u05ea (Synopsis ch.19 Personality Disorders).",
        "requiredAttributes": [
          "\u05d4\u05d2\u05d3\u05e8\u05d4 \u05e9\u05dc \u05de\u05e0\u05d8\u05dc\u05d9\u05d6\u05e6\u05d9\u05d4 \u05db\u05d9\u05db\u05d5\u05dc\u05ea \u05dc\u05d4\u05d1\u05d9\u05df \u05de\u05e6\u05d1\u05d9\u05dd \u05de\u05e0\u05d8\u05dc\u05d9\u05d9\u05dd \u05e9\u05dc \u05d4\u05e2\u05e6\u05de\u05d9 \u05d5\u05d4\u05d0\u05d7\u05e8.",
