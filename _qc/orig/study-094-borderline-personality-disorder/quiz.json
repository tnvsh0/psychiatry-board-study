{
  "title": "Borderline Quiz",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\u05de\u05ea\u05d1\u05d2\u05e8\u05ea \u05d1\u05ea 16 \u05de\u05d5\u05e4\u05e0\u05d9\u05ea \u05dc\u05d4\u05e2\u05e8\u05db\u05d4 \u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9\u05ea \u05dc\u05d0\u05d7\u05e8 \u05e9\u05d1\u05de\u05d4\u05dc\u05da \u05d8\u05d9\u05e4\u05d5\u05dc \u05e4\u05e1\u05d9\u05db\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d4\u05d1\u05d9\u05e2\u05d4 \u05db\u05e2\u05e1 \u05e7\u05d9\u05e6\u05d5\u05e0\u05d9 \u05e2\u05dc \u05d4\u05de\u05d8\u05e4\u05dc \u05d1\u05e9\u05dc \u05d0\u05d9\u05d7\u05d5\u05e8 \u05e9\u05dc 5 \u05d3\u05e7\u05d5\u05ea, \u05ea\u05d5\u05da \u05e9\u05d4\u05d9\u05d0 \u05de\u05db\u05e0\u05d4 \u05d0\u05d5\u05ea\u05d5 \"\u05e8\u05e9\u05e2 \u05d5\u05de\u05ea\u05e2\u05dc\u05dc\" \u05dc\u05de\u05e8\u05d5\u05ea \u05e9\u05e2\u05d3 \u05db\u05d4 \u05ea\u05d9\u05d0\u05e8\u05d4 \u05d0\u05d5\u05ea\u05d5 \u05db\"\u05de\u05e6\u05d9\u05dc \u05d4\u05d9\u05d7\u05d9\u05d3 \u05e9\u05dc\u05d9\". \u05d1\u05e8\u05e7\u05e2: \u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4 \u05e9\u05dc \u05e4\u05e6\u05d9\u05e2\u05d4 \u05e2\u05e6\u05de\u05d9\u05ea (cutting) \u05d1\u05e2\u05ea \u05ea\u05d7\u05d5\u05e9\u05ea \u05d1\u05d3\u05d9\u05d3\u05d5\u05ea, \u05d9\u05d7\u05e1\u05d9 \u05de\u05d9\u05df \u05de\u05d6\u05d3\u05de\u05e0\u05d9\u05dd \u05dc\u05d0 \u05de\u05d5\u05d2\u05e0\u05d9\u05dd \u05d5\u05ea\u05d7\u05d5\u05e9\u05ea \u05e8\u05d9\u05e7\u05e0\u05d5\u05ea \u05db\u05e8\u05d5\u05e0\u05d9\u05ea. \u05de\u05d4\u05d5 \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05d4\u05d2\u05e0\u05ea\u05d9 \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05d4\u05de\u05ea\u05d1\u05d8\u05d0 \u05d1\u05ea\u05d9\u05d0\u05d5\u05e8 \u05d6\u05d4?",
      "answerOptions": [
        {
          "text": "Splitting (\u05e4\u05d9\u05e6\u05d5\u05dc)",
          "isCorrect": true,
          "rationale": "\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4-Splitting \u05de\u05d0\u05d5\u05e4\u05d9\u05d9\u05df \u05d1\u05d7\u05dc\u05d5\u05e7\u05ea \u05d0\u05d5\u05d1\u05d9\u05d9\u05e7\u05d8\u05d9\u05dd \u05dc\"\u05d8\u05d5\u05d1\u05d9\u05dd \u05de\u05d5\u05d7\u05dc\u05d8\u05d9\u05dd\" \u05d0\u05d5 \"\u05e8\u05e2\u05d9\u05dd \u05de\u05d5\u05d7\u05dc\u05d8\u05d9\u05dd\", \u05dc\u05dc\u05d0 \u05d9\u05db\u05d5\u05dc\u05ea \u05dc\u05d0\u05d9\u05e0\u05d8\u05d2\u05e8\u05e6\u05d9\u05d4, \u05db\u05e4\u05d9 \u05e9\u05de\u05ea\u05d1\u05d8\u05d0 \u05d1\u05de\u05e2\u05d1\u05e8 \u05d4\u05e7\u05d9\u05e6\u05d5\u05e0\u05d9 \u05e9\u05dc \u05d4\u05de\u05d8\u05d5\u05e4\u05dc\u05ea \u05d1\u05d9\u05df \u05d0\u05d9\u05d3\u05d9\u05d0\u05dc\u05d9\u05d6\u05e6\u05d9\u05d4 \u05dc\u05d3\u05d4-\u05d5\u05d5\u05d0\u05dc\u05d5\u05d0\u05e6\u05d9\u05d4 (Synopsis ch.19 Personality Disorders)."
        },
        {
          "text": "Projective Identification (\u05d4\u05d6\u05d3\u05d4\u05d5\u05ea \u05d4\u05e9\u05dc\u05db\u05ea\u05d9\u05ea)",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05e9\u05d6\u05d4\u05d5 \u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05e0\u05e4\u05d5\u05e5 \u05d1-BPD, \u05d4\u05d5\u05d0 \u05db\u05d5\u05dc\u05dc \u05d4\u05e9\u05dc\u05db\u05d4 \u05e9\u05dc \u05d7\u05dc\u05e7 \u05de\u05d4\u05e2\u05e6\u05de\u05d9 \u05e2\u05dc \u05d4\u05d0\u05d7\u05e8 \u05d5\u05e0\u05d9\u05e1\u05d9\u05d5\u05df \u05d0\u05e7\u05d8\u05d9\u05d1\u05d9 \u05dc\u05d2\u05e8\u05d5\u05dd \u05dc\u05d0\u05d7\u05e8 \u05dc\u05d7\u05d5\u05e9 \u05d0\u05ea \u05d4\u05e8\u05d2\u05e9 \u05d4\u05de\u05d5\u05e9\u05dc\u05da, \u05d5\u05dc\u05d0 \u05e8\u05e7 \u05ea\u05e4\u05d9\u05e1\u05d4 \u05d3\u05d9\u05db\u05d5\u05d8\u05d5\u05de\u05d9\u05ea \u05e9\u05dc \u05d8\u05d5\u05d1 \u05d5\u05e8\u05e2 (Synopsis ch.19 Personality Disorders)."
        },
        {
          "text": "Isolation (\u05d1\u05d9\u05d3\u05d5\u05d3)",
          "isCorrect": false,
          "rationale": "\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d6\u05d4 \u05de\u05d0\u05d5\u05e4\u05d9\u05d9\u05df \u05d1\u05d4\u05e4\u05e8\u05d3\u05ea \u05d4\u05e8\u05e2\u05d9\u05d5\u05df \u05de\u05d4\u05e8\u05d2\u05e9 \u05d4\u05e0\u05dc\u05d5\u05d5\u05d4 \u05d0\u05dc\u05d9\u05d5, \u05d5\u05e0\u05e4\u05d5\u05e5 \u05d9\u05d5\u05ea\u05e8 \u05d1\u05d4\u05e4\u05e8\u05e2\u05ea \u05d0\u05d9\u05e9\u05d9\u05d5\u05ea \u05d0\u05d5\u05d1\u05e1\u05e1\u05d9\u05d1\u05d9\u05ea-\u05e7\u05d5\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05ea \u05d5\u05dc\u05d0 \u05d1-BPD (Synopsis ch.19 Personality Disorders)."
        },
        {
          "text": "Dissociation (\u05d3\u05d9\u05e1\u05d5\u05e6\u05d9\u05d0\u05e6\u05d9\u05d4)",
          "isCorrect": false,
          "rationale": "\u05d3\u05d9\u05e1\u05d5\u05e6\u05d9\u05d0\u05e6\u05d9\u05d4 \u05d4\u05d9\u05d0 \u05e0\u05d9\u05ea\u05d5\u05e7 \u05e9\u05dc \u05ea\u05d4\u05dc\u05d9\u05da \u05de\u05e0\u05d8\u05dc\u05d9 \u05d0\u05d5 \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea\u05d9 \u05de\u05d9\u05ea\u05e8 \u05d4\u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05d4\u05e0\u05e4\u05e9\u05d9\u05ea, \u05d4\u05de\u05d5\u05e4\u05d9\u05e2\u05d4 \u05d1-BPD \u05dc\u05e8\u05d5\u05d1 \u05ea\u05d7\u05ea \u05d3\u05d7\u05e7 \u05e7\u05d9\u05e6\u05d5\u05e0\u05d9, \u05d0\u05da \u05d0\u05d9\u05e0\u05d4 \u05de\u05e1\u05d1\u05d9\u05e8\u05d4 \u05d0\u05ea \u05d4\u05ea\u05e0\u05d5\u05d3\u05d4 \u05d4\u05d1\u05d9\u05e0\u05d0\u05d9\u05e9\u05d9\u05ea \u05d4\u05de\u05ea\u05d5\u05d0\u05e8\u05ea (Synopsis ch.19 Personality Disorders)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d1\u05d5 \u05e2\u05dc \u05d4\u05d3\u05e8\u05da \u05e9\u05d1\u05d4 \u05d4\u05de\u05d8\u05d5\u05e4\u05dc\u05ea \u05ea\u05d5\u05e4\u05e1\u05ea \u05d0\u05ea \u05d4\u05d3\u05de\u05d5\u05d9\u05d5\u05ea \u05d4\u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05d5\u05ea \u05d1\u05d7\u05d9\u05d9\u05d4 \u05d1\u05d0\u05d5\u05e4\u05df \u05e7\u05d9\u05e6\u05d5\u05e0\u05d9 \u05d5\u05d1\u05dc\u05ea\u05d9 \u05d9\u05e6\u05d9\u05d1."
    },
    {
      "type": "multiple_choice",
      "question": "\u05e2\u05dc \u05e4\u05d9 \u05d4\u05de\u05d5\u05d3\u05dc \u05d4\u05d1\u05d9\u05d5-\u05e1\u05d5\u05e6\u05d9\u05d0\u05dc\u05d9 \u05e9\u05dc Linehan, \u05de\u05d4\u05d5 \u05d4\u05e9\u05d9\u05dc\u05d5\u05d1 \u05d4\u05e7\u05e8\u05d9\u05d8\u05d9 \u05d4\u05de\u05d5\u05d1\u05d9\u05dc \u05dc\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea \u05d4\u05e4\u05e8\u05e2\u05ea \u05d0\u05d9\u05e9\u05d9\u05d5\u05ea \u05d2\u05d1\u05d5\u05dc\u05d9\u05ea?",
      "answerOptions": [
        {
          "text": "\u05e4\u05d2\u05d9\u05e2\u05d5\u05ea \u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea \u05dc\u05d5\u05d5\u05d9\u05e1\u05d5\u05ea \u05e8\u05d2\u05e9\u05d9 \u05d1\u05e9\u05d9\u05dc\u05d5\u05d1 \u05e2\u05dd \u05e1\u05d1\u05d9\u05d1\u05d4 \u05de\u05d1\u05d8\u05dc\u05ea (Invalidating environment).",
          "isCorrect": true,
          "rationale": "\u05d4\u05de\u05d5\u05d3\u05dc \u05de\u05d3\u05d2\u05d9\u05e9 \u05d0\u05d9\u05e0\u05d8\u05e8\u05d0\u05e7\u05e6\u05d9\u05d4 \u05d1\u05d9\u05df \u05e8\u05d2\u05d9\u05e9\u05d5\u05ea \u05e8\u05d2\u05e9\u05d9\u05ea \u05de\u05d5\u05dc\u05d3\u05ea (\u05d8\u05de\u05e4\u05e8\u05de\u05e0\u05d8) \u05dc\u05d1\u05d9\u05df \u05e1\u05d1\u05d9\u05d1\u05d4 \u05e9\u05d0\u05d9\u05e0\u05d4 \u05e0\u05d5\u05ea\u05e0\u05ea \u05ea\u05d5\u05e7\u05e3 \u05dc\u05d7\u05d5\u05d5\u05d9\u05d5\u05ea \u05d4\u05e4\u05e0\u05d9\u05de\u05d9\u05d5\u05ea \u05e9\u05dc \u05d4\u05d9\u05dc\u05d3, \u05de\u05d4 \u05e9\u05de\u05d5\u05e0\u05e2 \u05dc\u05de\u05d9\u05d3\u05d4 \u05e9\u05dc \u05d5\u05d9\u05e1\u05d5\u05ea \u05e8\u05d2\u05e9\u05d9 (Synopsis ch.19 Personality Disorders)."
        },
        {
          "text": "\u05dc\u05d9\u05e7\u05d5\u05d9 \u05e0\u05d5\u05d9\u05e8\u05d5\u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d1\u05de\u05e2\u05e8\u05db\u05ea \u05d4-Dopamine \u05d1\u05e9\u05d9\u05dc\u05d5\u05d1 \u05e2\u05dd \u05d8\u05e8\u05d0\u05d5\u05de\u05d4 \u05e4\u05d9\u05d6\u05d9\u05ea \u05de\u05d5\u05e7\u05d3\u05de\u05ea.",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05e9\u05d8\u05e8\u05d0\u05d5\u05de\u05d4 \u05d4\u05d9\u05d0 \u05d2\u05d5\u05e8\u05dd \u05e1\u05d9\u05db\u05d5\u05df, \u05d4\u05de\u05d5\u05d3\u05dc \u05e9\u05dc Linehan \u05de\u05ea\u05de\u05e7\u05d3 \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05ea \u05d1\u05e1\u05d1\u05d9\u05d1\u05d4 \u05d4\u05de\u05d1\u05d8\u05dc\u05ea (Invalidating) \u05d5\u05d1\u05e4\u05d2\u05d9\u05e2\u05d5\u05ea \u05d1\u05d5\u05d5\u05d9\u05e1\u05d5\u05ea \u05d4\u05e8\u05d2\u05e9\u05d9 \u05d5\u05dc\u05d0 \u05e8\u05e7 \u05d1-Dopamine (Synopsis ch.19 Personality Disorders)."
        },
        {
          "text": "\u05d7\u05d5\u05e1\u05e8 \u05d0\u05d9\u05d6\u05d5\u05df \u05d1\u05e8\u05de\u05d5\u05ea \u05d4-Oxytocin \u05d1\u05e9\u05d9\u05dc\u05d5\u05d1 \u05e2\u05dd \u05e7\u05d5\u05e0\u05e4\u05dc\u05d9\u05e7\u05d8 \u05d0\u05d3\u05d9\u05e4\u05dc\u05d9 \u05dc\u05d0 \u05e4\u05ea\u05d5\u05e8.",
          "isCorrect": false,
          "rationale": "\u05e8\u05de\u05d5\u05ea Oxytocin \u05e0\u05de\u05d5\u05db\u05d5\u05ea \u05d0\u05db\u05df \u05e0\u05de\u05e6\u05d0\u05d5 \u05d1-BPD, \u05d0\u05da \u05d4\u05de\u05d5\u05d3\u05dc \u05d4\u05d3\u05d9\u05d0\u05dc\u05e7\u05d8\u05d9-\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea\u05d9 \u05e9\u05dc Linehan \u05d0\u05d9\u05e0\u05d5 \u05de\u05d1\u05d5\u05e1\u05e1 \u05e2\u05dc \u05de\u05d5\u05e9\u05d2\u05d9\u05dd \u05e4\u05e1\u05d9\u05db\u05d5\u05d0\u05e0\u05dc\u05d9\u05d8\u05d9\u05d9\u05dd \u05e7\u05dc\u05d0\u05e1\u05d9\u05d9\u05dd \u05db\u05de\u05d5 \u05d4\u05e7\u05d5\u05e0\u05e4\u05dc\u05d9\u05e7\u05d8 \u05d4\u05d0\u05d3\u05d9\u05e4\u05dc\u05d9 (Dulcan p.535)."
        },
        {
          "text": "\u05d3\u05d9\u05e1\u05e4\u05d5\u05e0\u05e7\u05e6\u05d9\u05d4 \u05e9\u05dc \u05d4-Prefrontal Cortex \u05d1\u05e9\u05d9\u05dc\u05d5\u05d1 \u05e2\u05dd \u05d4\u05d5\u05e8\u05d5\u05ea \u05de\u05ea\u05d9\u05e8\u05e0\u05d9\u05ea \u05de\u05d3\u05d9.",
          "isCorrect": false,
          "rationale": "\u05d4\u05de\u05d5\u05d3\u05dc \u05de\u05ea\u05de\u05e7\u05d3 \u05d1\u05e1\u05d1\u05d9\u05d1\u05d4 \u05de\u05e2\u05e0\u05d9\u05e9\u05d4, \u05de\u05d1\u05d8\u05dc\u05ea \u05d0\u05d5 \u05de\u05ea\u05e2\u05dc\u05de\u05ea (Invalidating), \u05d5\u05dc\u05d0\u05d5 \u05d3\u05d5\u05d5\u05e7\u05d0 \u05d1\u05d4\u05d5\u05e8\u05d5\u05ea \u05de\u05ea\u05d9\u05e8\u05e0\u05d9\u05ea, \u05db\u05d2\u05d5\u05e8\u05dd \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05dc\u05d7\u05d5\u05e1\u05e8 \u05d4\u05d5\u05d5\u05d9\u05e1\u05d5\u05ea (Synopsis ch.19 Personality Disorders)."
        }
      ],
      "hint": "\u05d4\u05ea\u05de\u05e7\u05d3\u05d5 \u05d1\u05d0\u05d9\u05e0\u05d8\u05e8\u05d0\u05e7\u05e6\u05d9\u05d4 \u05e9\u05d1\u05d9\u05df \u05d4\u05de\u05d6\u05d2 \u05d4\u05de\u05d5\u05dc\u05d3 \u05dc\u05d1\u05d9\u05df \u05d4\u05ea\u05d2\u05d5\u05d1\u05d4 \u05d4\u05e1\u05d1\u05d9\u05d1\u05ea\u05d9\u05ea \u05dc\u05e8\u05d2\u05e9\u05d5\u05ea \u05d4\u05de\u05d8\u05d5\u05e4\u05dc."
    },
    {
      "type": "multiple_choice",
      "question": "\u05d1\u05d1\u05d5\u05d0\u05e0\u05d5 \u05dc\u05d8\u05e4\u05dc \u05ea\u05e8\u05d5\u05e4\u05ea\u05d9\u05ea \u05d1\u05ea\u05e1\u05de\u05d9\u05e0\u05d9 \u05d7\u05e8\u05d3\u05d4 \u05d0\u05d5 \u05d0\u05d9-\u05e9\u05e7\u05d8 \u05e7\u05d9\u05e6\u05d5\u05e0\u05d9 \u05d1\u05de\u05d8\u05d5\u05e4\u05dc \u05e2\u05dd BPD, \u05de\u05d3\u05d5\u05e2 \u05e7\u05d9\u05d9\u05de\u05ea \u05d0\u05d6\u05d4\u05e8\u05d4 \u05d7\u05de\u05d5\u05e8\u05d4 \u05db\u05e0\u05d2\u05d3 \u05e9\u05d9\u05de\u05d5\u05e9 \u05d1-Benzodiazepines?",
      "answerOptions": [
        {
          "text": "\u05d4\u05dd \u05e2\u05dc\u05d5\u05dc\u05d9\u05dd \u05dc\u05d2\u05e8\u05d5\u05dd \u05dc-Disinhibition (\u05d3\u05d9\u05e1-\u05d0\u05d9\u05e0\u05d4\u05d9\u05d1\u05d9\u05e6\u05d9\u05d4) \u05d5\u05dc\u05d4\u05d7\u05de\u05d9\u05e8 \u05d0\u05d9\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05d5\u05ea \u05d5\u05ea\u05d5\u05e7\u05e4\u05e0\u05d5\u05ea.",
          "isCorrect": true,
          "rationale": "\u05d1\u05e9\u05dc \u05d7\u05d5\u05e1\u05e8 \u05d4\u05d9\u05e6\u05d9\u05d1\u05d5\u05ea \u05d4\u05d1\u05e1\u05d9\u05e1\u05d9, Benzodiazepines \u05e2\u05dc\u05d5\u05dc\u05d9\u05dd \u05dc\u05d4\u05e1\u05d9\u05e8 \u05e2\u05db\u05d1\u05d5\u05ea \u05d5\u05dc\u05d4\u05d5\u05d1\u05d9\u05dc \u05dc\u05d4\u05ea\u05e4\u05e8\u05e6\u05d5\u05d9\u05d5\u05ea \u05d6\u05e2\u05dd \u05d0\u05d5 \u05e4\u05d2\u05d9\u05e2\u05d4 \u05e2\u05e6\u05de\u05d9\u05ea, \u05d1\u05e0\u05d5\u05e1\u05e3 \u05dc\u05e1\u05d9\u05db\u05d5\u05df \u05d4\u05d2\u05d1\u05d5\u05d4 \u05dc\u05d4\u05ea\u05de\u05db\u05e8\u05d5\u05ea (Synopsis ch.19 Personality Disorders)."
        },
        {
          "text": "\u05d4\u05dd \u05de\u05e2\u05dc\u05d9\u05dd \u05d0\u05ea \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05dc-Agranulocytosis \u05d1\u05e9\u05d9\u05dc\u05d5\u05d1 \u05e2\u05dd SSRI.",
          "isCorrect": false,
          "rationale": "\u05e1\u05d9\u05db\u05d5\u05df \u05d6\u05d4 \u05e8\u05dc\u05d5\u05d5\u05e0\u05d8\u05d9 \u05dc-Clozapine \u05d5\u05dc\u05d0 \u05dc-Benzodiazepines; \u05d0\u05d9\u05df \u05d0\u05d9\u05e0\u05d8\u05e8\u05d0\u05e7\u05e6\u05d9\u05d4 \u05d9\u05d3\u05d5\u05e2\u05d4 \u05db\u05d6\u05d5 \u05e2\u05dd SSRI (StahlKids p.166)."
        },
        {
          "text": "\u05d4\u05dd \u05d2\u05d5\u05e8\u05de\u05d9\u05dd \u05dc\u05d9\u05e8\u05d9\u05d3\u05d4 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05d1\u05e1\u05e3 \u05d4\u05e4\u05e8\u05db\u05d5\u05e1 (Seizure threshold) \u05d1\u05de\u05d8\u05d5\u05e4\u05dc\u05d9 BPD.",
          "isCorrect": false,
          "rationale": " Benzodiazepines \u05d4\u05dd \u05d3\u05d5\u05d5\u05e7\u05d0 \u05e0\u05d5\u05d2\u05d3\u05d9 \u05e4\u05e8\u05db\u05d5\u05e1\u05d9\u05dd; \u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05db\u05de\u05d5 Bupropion \u05d0\u05d5 Clozapine \u05d4\u05df \u05d0\u05dc\u05d5 \u05e9\u05de\u05d5\u05e8\u05d9\u05d3\u05d5\u05ea \u05d0\u05ea \u05e1\u05e3 \u05d4\u05e4\u05e8\u05db\u05d5\u05e1 (Dulcan p.1096)."
        },
        {
          "text": "\u05d4\u05dd \u05d2\u05d5\u05e8\u05de\u05d9\u05dd \u05dc\u05d3\u05d9\u05db\u05d5\u05d9 \u05e0\u05e9\u05d9\u05de\u05ea\u05d9 \u05de\u05e1\u05d5\u05db\u05df \u05d1\u05e9\u05d9\u05dc\u05d5\u05d1 \u05e2\u05dd Lithium.",
          "isCorrect": false,
          "rationale": "\u05d3\u05d9\u05db\u05d5\u05d9 \u05e0\u05e9\u05d9\u05de\u05ea\u05d9 \u05d4\u05d5\u05d0 \u05ea\u05d5\u05e4\u05e2\u05ea \u05dc\u05d5\u05d5\u05d0\u05d9 \u05e9\u05dc Benzodiazepines \u05d1\u05de\u05d9\u05e0\u05d5\u05df \u05d2\u05d1\u05d5\u05d4 \u05d0\u05d5 \u05d1\u05e9\u05d9\u05dc\u05d5\u05d1 \u05e2\u05dd \u05d0\u05dc\u05db\u05d5\u05d4\u05d5\u05dc/\u05d0\u05d5\u05e4\u05d9\u05d0\u05d8\u05d9\u05dd, \u05d0\u05da \u05d0\u05d9\u05df \u05e7\u05e9\u05e8 \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9 \u05dc-Lithium \u05d0\u05d5 \u05dc\u05d4\u05ea\u05d5\u05d5\u05d9\u05d9\u05ea \u05e0\u05d2\u05d3 \u05de\u05d5\u05d7\u05dc\u05d8\u05ea \u05d1-BPD \u05de\u05d4\u05d9\u05d1\u05d8 \u05d6\u05d4 (Dulcan p.1095)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d1\u05d5 \u05e2\u05dc \u05d4\u05d4\u05e9\u05e4\u05e2\u05d4 \u05e9\u05dc \u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05de\u05e8\u05d2\u05d9\u05e2\u05d5\u05ea \u05e2\u05dc \u05de\u05e0\u05d2\u05e0\u05d5\u05e0\u05d9 \u05d4\u05d1\u05e7\u05e8\u05d4 \u05d4\u05e2\u05e6\u05de\u05d9\u05ea \u05e9\u05dc \u05d0\u05d3\u05dd \u05d0\u05d9\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9."
    },
    {
      "type": "multiple_choice",
      "question": "\u05de\u05d4\u05d5 \u05d4\u05d1\u05e1\u05d9\u05e1 \u05d4\u05e0\u05d5\u05d9\u05e8\u05d5\u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d4\u05de\u05d5\u05e6\u05e2 \u05d1-StahlNeuro \u05dc\u05d7\u05d5\u05e1\u05e8 \u05d4\u05d5\u05d5\u05d9\u05e1\u05d5\u05ea \u05d4\u05e8\u05d2\u05e9\u05d9 \u05d5\u05d4\u05d0\u05d9\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05d5\u05ea \u05d1-BPD?",
      "answerOptions": [
        {
          "text": "\u05d7\u05d5\u05e1\u05e8 \u05d0\u05d9\u05d6\u05d5\u05df \u05d1\u05d9\u05df \u05d1\u05e7\u05e8\u05d4 \"Top-down\" \u05e9\u05dc \u05d4\u05e7\u05d5\u05e8\u05d8\u05e7\u05e1 \u05d4\u05e4\u05e8\u05e4\u05e8\u05d5\u05e0\u05d8\u05dc\u05d9 \u05dc\u05d1\u05d9\u05df \u05d3\u05d7\u05e4\u05d9\u05dd \u05de\u05d4\u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05dc\u05d9\u05de\u05d1\u05d9\u05ea.",
          "isCorrect": true,
          "rationale": "\u05d4\u05de\u05d5\u05d3\u05dc \u05de\u05e6\u05d9\u05e2 \u05db\u05e9\u05dc \u05d1\u05d1\u05e7\u05e8\u05d4 \u05d4\u05de\u05e2\u05db\u05d1\u05ea \u05e9\u05dc \u05d0\u05d6\u05d5\u05e8\u05d9\u05dd \u05db\u05de\u05d5 \u05d4-VMPFC \u05d5\u05d4-OFC \u05e2\u05dc \u05d4\u05d0\u05de\u05d9\u05d2\u05d3\u05dc\u05d4, \u05de\u05d4 \u05e9\u05de\u05d0\u05e4\u05e9\u05e8 \u05dc\u05e8\u05d2\u05e9\u05d5\u05ea \u05d5\u05d3\u05d7\u05e4\u05d9\u05dd \u05dc\u05e4\u05e2\u05d5\u05dc \u05dc\u05dc\u05d0 \u05d5\u05d9\u05e1\u05d5\u05ea (StahlNeuro p.527)."
        },
        {
          "text": "\u05d4\u05d9\u05e4\u05e8-\u05d3\u05d5\u05e4\u05de\u05d9\u05e0\u05e8\u05d2\u05d9\u05d4 \u05d1\u05de\u05e1\u05dc\u05d5\u05dc \u05d4-Mesocortical \u05d4\u05de\u05d5\u05d1\u05d9\u05dc\u05d4 \u05dc\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d7\u05d9\u05d5\u05d1\u05d9\u05d9\u05dd.",
          "isCorrect": false,
          "rationale": "\u05d4\u05d9\u05e4\u05e8-\u05d3\u05d5\u05e4\u05de\u05d9\u05e0\u05e8\u05d2\u05d9\u05d4 \u05d1\u05de\u05e1\u05dc\u05d5\u05dc \u05d4-Mesolimbic (\u05d5\u05dc\u05d0 Mesocortical) \u05e7\u05e9\u05d5\u05e8\u05d4 \u05dc\u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d4; \u05d1-BPD \u05d4\u05d1\u05e2\u05d9\u05d4 \u05d4\u05d9\u05d0 \u05d1\u05d1\u05e7\u05e8\u05d4 \u05d4\u05e4\u05e8\u05d5\u05e0\u05d8\u05dc\u05d9\u05ea \u05e2\u05dc \u05d4\u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05dc\u05d9\u05de\u05d1\u05d9\u05ea (StahlNeuro p.90)."
        },
        {
          "text": "\u05d4\u05d9\u05e4\u05d5-\u05e4\u05d5\u05e0\u05e7\u05e6\u05d9\u05d5\u05e0\u05dc\u05d9\u05d5\u05ea \u05e9\u05dc \u05e8\u05e6\u05e4\u05d8\u05d5\u05e8\u05d9 $NMDA$ \u05e2\u05dc \u05d0\u05d9\u05e0\u05d8\u05e8\u05e0\u05d5\u05d9\u05e8\u05d5\u05e0\u05d9\u05dd \u05e9\u05dc GABA \u05d1-VTA.",
          "isCorrect": false,
          "rationale": "\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d6\u05d4 \u05de\u05d5\u05e6\u05e2 \u05db\u05d1\u05e1\u05d9\u05e1 \u05dc\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d4\u05e9\u05dc\u05d9\u05dc\u05d9\u05d9\u05dd \u05e9\u05dc Schizophrenia, \u05d5\u05dc\u05d0 \u05db\u05d4\u05e1\u05d1\u05e8 \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05dc\u05d0\u05d9\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05d5\u05ea \u05d1-BPD (StahlNeuro p.113)."
        },
        {
          "text": "\u05d7\u05e1\u05d9\u05de\u05d4 \u05e9\u05dc \u05e8\u05e6\u05e4\u05d8\u05d5\u05e8\u05d9 $D_2$ \u05d1-Dorsal Striatum \u05d4\u05d2\u05d5\u05e8\u05de\u05ea \u05dc-Akathisia \u05e8\u05d2\u05e9\u05d9\u05ea.",
          "isCorrect": false,
          "rationale": "\u05d7\u05e1\u05d9\u05de\u05ea $D_2$ \u05d1\u05e1\u05d8\u05e8\u05d9\u05d0\u05d8\u05d5\u05dd \u05e7\u05e9\u05d5\u05e8\u05d4 \u05dc\u05ea\u05d5\u05e4\u05e2\u05d5\u05ea \u05dc\u05d5\u05d5\u05d0\u05d9 \u05de\u05d5\u05d8\u05d5\u05e8\u05d9\u05d5\u05ea (EPS) \u05e9\u05dc \u05d0\u05e0\u05d8\u05d9-\u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9\u05d9\u05dd, \u05d5\u05dc\u05d0 \u05dc\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05d0\u05d8\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05e9\u05dc BPD (StahlNeuro p.92)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d1\u05d5 \u05e2\u05dc \u05d4\u05ea\u05e7\u05e9\u05d5\u05e8\u05ea \u05d1\u05d9\u05df \u05d4\"\u05d1\u05dc\u05de\u05d9\u05dd\" \u05d4\u05e7\u05d3\u05de\u05d9\u05d9\u05dd \u05e9\u05dc \u05d4\u05de\u05d5\u05d7 \u05dc\u05d1\u05d9\u05df \u05de\u05e8\u05db\u05d6 \u05d4\u05e8\u05d2\u05e9\u05d5\u05ea \u05d5\u05d4\u05d3\u05d7\u05e4\u05d9\u05dd."
    },
    {
      "type": "multiple_choice",
      "question": "\u05de\u05ea\u05d1\u05d2\u05e8 \u05d1\u05df 15 \u05e2\u05dd \u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc BPD \u05e1\u05d5\u05d1\u05dc \u05de\u05d4\u05ea\u05e4\u05e8\u05e6\u05d5\u05d9\u05d5\u05ea \u05d6\u05e2\u05dd \u05ea\u05d3\u05d9\u05e8\u05d5\u05ea, \u05ea\u05d5\u05e7\u05e4\u05e0\u05d5\u05ea \u05d0\u05d9\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05ea \u05d5\u05d7\u05d5\u05e1\u05e8 \u05d9\u05e6\u05d9\u05d1\u05d5\u05ea \u05d0\u05e4\u05e7\u05d8\u05d9\u05d1\u05d9\u05ea \u05e7\u05e9\u05d4 \u05e9\u05dc\u05d0 \u05d4\u05d2\u05d9\u05d1\u05d5 \u05dc\u05d4\u05ea\u05e2\u05e8\u05d1\u05d5\u05d9\u05d5\u05ea \u05e4\u05e1\u05d9\u05db\u05d5\u05ea\u05e8\u05e4\u05d9\u05d5\u05ea \u05e8\u05d0\u05e9\u05d5\u05e0\u05d9\u05d5\u05ea. \u05e2\u05dc \u05e4\u05d9 \u05d4-StahlKids, \u05d0\u05d9\u05d6\u05d4 \u05d8\u05d9\u05e4\u05d5\u05dc \u05ea\u05e8\u05d5\u05e4\u05ea\u05d9 \u05e2\u05e9\u05d5\u05d9 \u05dc\u05e1\u05d9\u05d9\u05e2 \u05d1\u05e9\u05dc\u05d9\u05d8\u05d4 \u05d1\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d0\u05dc\u05d5?",
      "answerOptions": [
        {
          "text": "Atypical Antipsychotics \u05d1\u05de\u05d9\u05e0\u05d5\u05df \u05e0\u05de\u05d5\u05da (\u05db\u05de\u05d5 Aripiprazole \u05d0\u05d5 Risperidone).",
          "isCorrect": true,
          "rationale": "\u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05d0\u05dc\u05d5 \u05d4\u05d5\u05db\u05d7\u05d5 \u05db\u05d9\u05e2\u05d9\u05dc\u05d5\u05ea \u05d1\u05e9\u05d9\u05e4\u05d5\u05e8 \u05d4\u05d5\u05d5\u05d9\u05e1\u05d5\u05ea \u05d4\u05d0\u05e4\u05e7\u05d8\u05d9\u05d1\u05d9, \u05d4\u05e4\u05d7\u05ea\u05ea \u05db\u05e2\u05e1 \u05d5\u05ea\u05d5\u05e7\u05e4\u05e0\u05d5\u05ea \u05d0\u05d9\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05ea \u05d1\u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd \u05e2\u05dd \u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d5\u05d0\u05d9\u05e9\u05d9\u05d5\u05ea (StahlKids p.36-41, 412)."
        },
        {
          "text": "Stimulants (\u05db\u05de\u05d5 Methylphenidate) \u05d1\u05de\u05d9\u05e0\u05d5\u05df \u05d2\u05d1\u05d5\u05d4 \u05dc\u05e9\u05d9\u05e4\u05d5\u05e8 \u05d4\u05e8\u05d9\u05db\u05d5\u05d6.",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05e9\u05e7\u05d9\u05d9\u05de\u05ea \u05e7\u05d5\u05de\u05d5\u05e8\u05d1\u05d9\u05d3\u05d9\u05d5\u05ea \u05e2\u05dd ADHD, Stimulants \u05e2\u05dc\u05d5\u05dc\u05d9\u05dd \u05dc\u05d4\u05d7\u05de\u05d9\u05e8 \u05d0\u05d2\u05d9\u05d8\u05e6\u05d9\u05d4 \u05d0\u05d5 \u05d0\u05d9-\u05e9\u05e7\u05d8 \u05d1\u05de\u05d8\u05d5\u05e4\u05dc \u05e2\u05dd \u05d7\u05d5\u05e1\u05e8 \u05d9\u05e6\u05d9\u05d1\u05d5\u05ea \u05e8\u05d2\u05e9\u05d9\u05ea \u05e7\u05e9\u05d4 \u05dc\u05dc\u05d0 \u05d9\u05d9\u05e6\u05d5\u05d1 \u05e7\u05d5\u05d3\u05dd (StahlKids p.291)."
        },
        {
          "text": "Tricyclic Antidepressants (TCAs) \u05d1\u05e9\u05dc \u05d4\u05e9\u05e4\u05e2\u05ea\u05dd \u05d4\u05d0\u05e0\u05dc\u05d2\u05d8\u05d9\u05ea \u05e2\u05dc \"\u05db\u05d0\u05d1 \u05e0\u05e4\u05e9\u05d9\".",
          "isCorrect": false,
          "rationale": "TCAs \u05d0\u05d9\u05e0\u05dd \u05e7\u05d5 \u05e8\u05d0\u05e9\u05d5\u05df \u05d1\u05e9\u05dc \u05e8\u05e2\u05d9\u05dc\u05d5\u05ea\u05dd \u05d1\u05de\u05d9\u05e0\u05d5\u05df \u05d9\u05ea\u05e8 (\u05e1\u05db\u05e0\u05d4 \u05d0\u05d5\u05d1\u05d3\u05e0\u05d9\u05ea \u05d1-BPD) \u05d5\u05ea\u05d5\u05e4\u05e2\u05d5\u05ea \u05dc\u05d5\u05d5\u05d0\u05d9 \u05de\u05e8\u05d5\u05d1\u05d5\u05ea; SSRI \u05de\u05d5\u05e2\u05d3\u05e4\u05d9\u05dd \u05d0\u05dd \u05e0\u05d3\u05e8\u05e9 \u05e0\u05d5\u05d2\u05d3 \u05d3\u05d9\u05db\u05d0\u05d5\u05df (Dulcan p.1096)."
        },
        {
          "text": "High-dose Benzodiazepines \u05dc\u05e9\u05d9\u05de\u05d5\u05e9 \u05e7\u05d1\u05d5\u05e2 \u05dc\u05e6\u05d5\u05e8\u05da \u05d4\u05e8\u05d2\u05e2\u05d4.",
          "isCorrect": false,
          "rationale": "\u05db\u05e4\u05d9 \u05e9\u05e6\u05d5\u05d9\u05df, Benzodiazepines \u05d0\u05d9\u05e0\u05dd \u05de\u05d5\u05de\u05dc\u05e6\u05d9\u05dd \u05d1-BPD \u05d1\u05e9\u05dc \u05e1\u05db\u05e0\u05ea \u05d4-Disinhibition \u05d5\u05d4\u05ea\u05dc\u05d5\u05ea (Synopsis ch.19 Personality Disorders)."
        }
      ],
      "hint": "\u05d7\u05e4\u05e9\u05d5 \u05e7\u05d1\u05d5\u05e6\u05ea \u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05d4\u05e4\u05d5\u05e2\u05dc\u05ea \u05e2\u05dc \u05d5\u05d9\u05e1\u05d5\u05ea \u05d3\u05d5\u05e4\u05de\u05d9\u05df \u05d5\u05e1\u05e8\u05d5\u05d8\u05d5\u05e0\u05d9\u05df \u05dc\u05e9\u05d9\u05e4\u05d5\u05e8 \u05e9\u05dc\u05d9\u05d8\u05d4 \u05d1\u05d3\u05d7\u05e4\u05d9\u05dd."
    },
    {
      "type": "multiple_choice",
      "question": "\u05de\u05d4\u05d5 \u05d4\u05d4\u05d1\u05d3\u05dc \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05d1\u05d9\u05df \u05d7\u05d5\u05e1\u05e8 \u05d4\u05d9\u05e6\u05d9\u05d1\u05d5\u05ea \u05d4\u05d0\u05e4\u05e7\u05d8\u05d9\u05d1\u05d9\u05ea \u05d1-BPD \u05dc\u05d1\u05d9\u05df \u05d4\u05e4\u05e8\u05e2\u05d4 \u05d1\u05d9\u05e4\u05d5\u05dc\u05d0\u05e8\u05d9\u05ea (Bipolar Disorder) \u05e2\u05dc \u05e4\u05d9 \u05d4-DSM-5-TR?",
      "answerOptions": [
        {
          "text": "\u05d1-BPD \u05d4\u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd \u05d1\u05de\u05e6\u05d1 \u05d4\u05e8\u05d5\u05d7 \u05d4\u05dd \u05ea\u05d2\u05d5\u05d1\u05ea\u05d9\u05d9\u05dd (reactive) \u05dc\u05dc\u05d7\u05e5 \u05d1\u05d9\u05e0\u05d0\u05d9\u05e9\u05d9 \u05d5\u05e0\u05de\u05e9\u05db\u05d9\u05dd \u05dc\u05e8\u05d5\u05d1 \u05e9\u05e2\u05d5\u05ea \u05e1\u05e4\u05d5\u05e8\u05d5\u05ea.",
          "isCorrect": true,
          "rationale": "\u05d4\u05d0\u05e4\u05e7\u05d8 \u05d1-BPD \u05de\u05d0\u05d5\u05e4\u05d9\u05d9\u05df \u05d1\u05ea\u05d2\u05d5\u05d1\u05ea\u05d9\u05d5\u05ea \u05d7\u05e8\u05d9\u05e4\u05d4 \u05dc\u05d2\u05d9\u05e8\u05d5\u05d9\u05d9\u05dd \u05e1\u05d1\u05d9\u05d1\u05ea\u05d9\u05d9\u05dd (\u05d1\u05e2\u05d9\u05e7\u05e8 \u05e0\u05d8\u05d9\u05e9\u05d4), \u05d1\u05e2\u05d5\u05d3 \u05e9\u05d1\u05d4\u05e4\u05e8\u05e2\u05d4 \u05d1\u05d9\u05e4\u05d5\u05dc\u05d0\u05e8\u05d9\u05ea \u05de\u05e6\u05d1\u05d9 \u05d4\u05e8\u05d5\u05d7 \u05d9\u05e6\u05d9\u05d1\u05d9\u05dd \u05d9\u05d5\u05ea\u05e8 \u05dc\u05d0\u05d5\u05e8\u05da \u05d9\u05de\u05d9\u05dd \u05d0\u05d5 \u05e9\u05d1\u05d5\u05e2\u05d5\u05ea \u05d5\u05e4\u05d7\u05d5\u05ea \u05ea\u05dc\u05d5\u05d9\u05d9 \u05e1\u05d9\u05d8\u05d5\u05d0\u05e6\u05d9\u05d4 (DSM p.756)."
        },
        {
          "text": "\u05e8\u05e7 \u05d1-BPD \u05de\u05d5\u05e4\u05d9\u05e2\u05d9\u05dd \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9\u05d9\u05dd \u05d1\u05de\u05d4\u05dc\u05da \u05d0\u05e4\u05d9\u05d6\u05d5\u05d3\u05d4 \u05e9\u05dc \u05d3\u05d9\u05db\u05d0\u05d5\u05df.",
          "isCorrect": false,
          "rationale": "\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9\u05d9\u05dd \u05d9\u05db\u05d5\u05dc\u05d9\u05dd \u05dc\u05d4\u05d5\u05e4\u05d9\u05e2 \u05d1\u05e9\u05ea\u05d9 \u05d4\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea (\u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9 \u05d1\u05d1\u05d9\u05e4\u05d5\u05dc\u05d0\u05e8 \u05dc\u05e2\u05d5\u05de\u05ea \u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d4 \u05d7\u05d5\u05dc\u05e4\u05ea \u05ea\u05dc\u05d5\u05d9\u05ea \u05dc\u05d7\u05e5 \u05d1-BPD) (DSM p.186, 754)."
        },
        {
          "text": "\u05d4\u05e4\u05e8\u05e2\u05d4 \u05d1\u05d9\u05e4\u05d5\u05dc\u05d0\u05e8\u05d9\u05ea \u05ea\u05de\u05d9\u05d3 \u05de\u05ea\u05d7\u05d9\u05dc\u05d4 \u05dc\u05e4\u05e0\u05d9 \u05d2\u05d9\u05dc 12, \u05d1\u05e2\u05d5\u05d3 BPD \u05d4\u05d9\u05d0 \u05d0\u05d1\u05d7\u05e0\u05d4 \u05dc\u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd \u05d1\u05dc\u05d1\u05d3.",
          "isCorrect": false,
          "rationale": "\u05d4\u05e4\u05e8\u05e2\u05d4 \u05d1\u05d9\u05e4\u05d5\u05dc\u05d0\u05e8\u05d9\u05ea \u05dc\u05e4\u05e0\u05d9 \u05d2\u05d9\u05dc 12 \u05d4\u05d9\u05d0 \u05e0\u05d3\u05d9\u05e8\u05d4, \u05d5-BPD \u05d9\u05db\u05d5\u05dc\u05d4 \u05dc\u05d4\u05d9\u05d5\u05ea \u05de\u05d0\u05d5\u05d1\u05d7\u05e0\u05ea \u05d2\u05dd \u05d1\u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd \u05d0\u05dd \u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05de\u05ea\u05e7\u05d9\u05d9\u05de\u05d9\u05dd \u05de\u05e2\u05dc \u05e9\u05e0\u05d4 (Dulcan p.72, DSM p.755)."
        },
        {
          "text": "\u05d1-BPD \u05e7\u05d9\u05d9\u05de\u05ea \u05ea\u05de\u05d9\u05d3 \u05ea\u05d2\u05d5\u05d1\u05d4 \u05d7\u05d9\u05d5\u05d1\u05d9\u05ea \u05dc-Lithium, \u05d1\u05e2\u05d5\u05d3 \u05d1\u05d1\u05d9\u05e4\u05d5\u05dc\u05d0\u05e8 \u05d4\u05ea\u05d2\u05d5\u05d1\u05d4 \u05d7\u05dc\u05e7\u05d9\u05ea.",
          "isCorrect": false,
          "rationale": "\u05d4\u05d4\u05e4\u05da \u05d4\u05d5\u05d0 \u05d4\u05e0\u05db\u05d5\u05df; Lithium \u05d4\u05d5\u05d0 \u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05d1\u05d7\u05d9\u05e8\u05d4 (Gold Standard) \u05dc\u05d1\u05d9\u05e4\u05d5\u05dc\u05d0\u05e8, \u05d1\u05e2\u05d5\u05d3 \u05e9\u05d1-BPD \u05d4\u05d5\u05d0 \u05de\u05e9\u05de\u05e9 \u05e8\u05e7 \u05db\u05ea\u05d5\u05e1\u05e4\u05ea \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05ea\u05d5\u05e7\u05e4\u05e0\u05d5\u05ea \u05d0\u05d9\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05ea (StahlKids p.291)."
        }
      ],
      "hint": "\u05e9\u05d9\u05de\u05d5 \u05dc\u05d1 \u05dc\u05de\u05e9\u05da \u05d4\u05d6\u05de\u05df \u05e9\u05dc \u05de\u05e6\u05d1\u05d9 \u05d4\u05e8\u05d5\u05d7 \u05d5\u05dc\u05de\u05d4 \u05e9\u05de\u05e2\u05d5\u05e8\u05e8 \u05d0\u05d5\u05ea\u05dd."
    },
    {
      "type": "multiple_select",
      "question": "\u05d0\u05d9\u05dc\u05d5 \u05de\u05d4\u05de\u05e8\u05db\u05d9\u05d1\u05d9\u05dd \u05d4\u05d1\u05d0\u05d9\u05dd \u05d4\u05dd \u05d7\u05dc\u05e7 \u05de\u05de\u05d1\u05e0\u05d4 \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Dialectical Behavior Therapy (DBT) \u05db\u05e4\u05d9 \u05e9\u05de\u05ea\u05d5\u05d0\u05e8 \u05d1\u05de\u05e7\u05d5\u05e8\u05d5\u05ea?",
      "answerOptions": [
        {
          "text": "\u05e7\u05d1\u05d5\u05e6\u05ea \u05e8\u05db\u05d9\u05e9\u05ea \u05de\u05d9\u05d5\u05de\u05e0\u05d5\u05d9\u05d5\u05ea (Skills Training Group) \u05e9\u05d1\u05d5\u05e2\u05d9\u05ea.",
          "isCorrect": true,
          "rationale": "\u05d6\u05d4\u05d5 \u05e0\u05d3\u05d1\u05da \u05de\u05e8\u05db\u05d6\u05d9 \u05d4\u05db\u05d5\u05dc\u05dc \u05dc\u05d9\u05de\u05d5\u05d3 \u05de\u05d9\u05d5\u05de\u05e0\u05d5\u05d9\u05d5\u05ea \u05de\u05d9\u05d9\u05e0\u05d3\u05e4\u05d5\u05dc\u05e0\u05e1, \u05d5\u05d9\u05e1\u05d5\u05ea \u05e8\u05d2\u05e9\u05d9, \u05d9\u05e2\u05d9\u05dc\u05d5\u05ea \u05d1\u05d9\u05e0\u05d0\u05d9\u05e9\u05d9\u05ea \u05d5\u05e2\u05de\u05d9\u05d3\u05d5\u05ea \u05d1\u05de\u05e6\u05d5\u05e7\u05d4 (Synopsis ch.19 Personality Disorders)."
        },
        {
          "text": "\u05d8\u05d9\u05e4\u05d5\u05dc \u05e4\u05e8\u05d8\u05e0\u05d9 \u05e9\u05d1\u05d5\u05e2\u05d9 \u05d4\u05de\u05de\u05d5\u05e7\u05d3 \u05d1\u05e4\u05ea\u05e8\u05d5\u05df \u05d1\u05e2\u05d9\u05d5\u05ea \u05d5\u05d4\u05d9\u05e8\u05e8\u05db\u05d9\u05d9\u05ea \u05de\u05d8\u05e8\u05d5\u05ea.",
          "isCorrect": true,
          "rationale": "\u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05e4\u05e8\u05d8\u05e0\u05d9 \u05d1-DBT \u05de\u05ea\u05de\u05e7\u05d3 \u05e7\u05d5\u05d3\u05dd \u05db\u05dc \u05d1\u05d4\u05e4\u05d7\u05ea\u05ea \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05d9\u05d5\u05ea \u05de\u05e1\u05db\u05e0\u05d5\u05ea \u05d7\u05d9\u05d9\u05dd \u05d5\u05dc\u05d0\u05d7\u05e8 \u05de\u05db\u05df \u05d1\u05de\u05d8\u05e8\u05d5\u05ea \u05d8\u05d9\u05e4\u05d5\u05dc\u05d9\u05d5\u05ea \u05d0\u05d7\u05e8\u05d5\u05ea (Synopsis ch.19 Personality Disorders)."
        },
        {
          "text": "\u05d9\u05d9\u05e2\u05d5\u05e5 \u05d8\u05dc\u05e4\u05d5\u05e0\u05d9 (Phone Coaching) \u05dc\u05de\u05d8\u05d5\u05e4\u05dc \u05d1\u05d6\u05de\u05df \u05d0\u05de\u05ea.",
          "isCorrect": true,
          "rationale": "\u05d4\u05d9\u05d9\u05e2\u05d5\u05e5 \u05d4\u05d8\u05dc\u05e4\u05d5\u05e0\u05d9 \u05e0\u05d5\u05e2\u05d3 \u05dc\u05e2\u05d6\u05d5\u05e8 \u05dc\u05de\u05d8\u05d5\u05e4\u05dc \u05dc\u05d9\u05d9\u05e9\u05dd \u05de\u05d9\u05d5\u05de\u05e0\u05d5\u05d9\u05d5\u05ea \u05d1\u05e1\u05d9\u05d8\u05d5\u05d0\u05e6\u05d9\u05d5\u05ea \u05e9\u05dc \u05de\u05e9\u05d1\u05e8 \u05d1\u05d7\u05d9\u05d9\u05dd \u05d4\u05d0\u05de\u05d9\u05ea\u05d9\u05d9\u05dd (Synopsis ch.19 Personality Disorders)."
        },
        {
          "text": "\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1-Interpretations (\u05e4\u05e8\u05e9\u05e0\u05d5\u05d9\u05d5\u05ea) \u05de\u05e2\u05de\u05d9\u05e7\u05d5\u05ea \u05e9\u05dc \u05d4\u05e7\u05d5\u05e0\u05e4\u05dc\u05d9\u05e7\u05d8 \u05d4\u05dc\u05d0-\u05de\u05d5\u05d3\u05e2.",
          "isCorrect": false,
          "rationale": "DBT \u05d4\u05d5\u05d0 \u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea\u05d9-\u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9 \u05d1\u05de\u05d4\u05d5\u05ea\u05d5; \u05e4\u05e8\u05e9\u05e0\u05d5\u05d9\u05d5\u05ea \u05e9\u05dc \u05d4\u05dc\u05d0-\u05de\u05d5\u05d3\u05e2 \u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d5\u05ea \u05e4\u05e1\u05d9\u05db\u05d5\u05ea\u05e8\u05e4\u05d9\u05d4 \u05d3\u05d9\u05e0\u05de\u05d9\u05ea \u05d5\u05dc\u05d0 DBT (Synopsis ch.19 Personality Disorders)."
