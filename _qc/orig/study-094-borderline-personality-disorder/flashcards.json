{
  "title": "BPD Flashcards",
  "cards": [
    {
      "front": "\u05e2\u05dc \u05e4\u05d9 \u05d4-DSM-5-TR, \u05de\u05d4\u05d5 \u05de\u05e1\u05e4\u05e8 \u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05d4\u05de\u05d9\u05e0\u05d9\u05de\u05dc\u05d9 \u05d4\u05e0\u05d3\u05e8\u05e9 \u05dc\u05d0\u05d1\u05d7\u05e0\u05ea Borderline Personality Disorder?",
      "back": "\u05d9\u05e9 \u05e6\u05d5\u05e8\u05da \u05d1-5 \u05de\u05ea\u05d5\u05da 9 \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd (DSM p.752)."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05de\u05e9\u05ea\u05e0\u05d4 \u05d9\u05d7\u05e1 \u05d4\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d1\u05d9\u05df \u05d4\u05de\u05d9\u05e0\u05d9\u05dd \u05d1-BPD \u05d1\u05de\u05d3\u05d2\u05de\u05d9\u05dd \u05e7\u05dc\u05d9\u05e0\u05d9\u05d9\u05dd \u05dc\u05e2\u05d5\u05de\u05ea \u05de\u05d3\u05d2\u05de\u05d9\u05dd \u05d1\u05e7\u05d4\u05d9\u05dc\u05d4?",
      "back": "\u05d1\u05de\u05d3\u05d2\u05de\u05d9\u05dd \u05e7\u05dc\u05d9\u05e0\u05d9\u05d9\u05dd \u05d9\u05e9 \u05e8\u05d5\u05d1 \u05e0\u05e9\u05d9 \u05de\u05d5\u05d1\u05d4\u05e7 (\u05e2\u05d3 75%), \u05d0\u05da \u05d1\u05de\u05d3\u05d2\u05de\u05d9\u05dd \u05e7\u05d4\u05d9\u05dc\u05ea\u05d9\u05d9\u05dd \u05d0\u05d9\u05df \u05d4\u05d1\u05d3\u05dc \u05d1\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d1\u05d9\u05df \u05e0\u05e9\u05d9\u05dd \u05dc\u05d2\u05d1\u05e8\u05d9\u05dd (DSM p.755-756)."
    },
    {
      "front": "\u05de\u05d4\u05dd \u05e9\u05e0\u05d9 \u05d4\u05de\u05e8\u05db\u05d9\u05d1\u05d9\u05dd \u05d4\u05de\u05e8\u05db\u05d6\u05d9\u05d9\u05dd \u05d1-Linehan's Biosocial Theory \u05dc\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea BPD?",
      "back": "\u05d0\u05d9\u05e0\u05d8\u05e8\u05d0\u05e7\u05e6\u05d9\u05d4 \u05d1\u05d9\u05df \u05e4\u05d2\u05d9\u05e2\u05d5\u05ea \u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea \u05dc\u05d5\u05d5\u05d9\u05e1\u05d5\u05ea \u05e8\u05d2\u05e9\u05d9 (Emotional Dysregulation) \u05dc\u05d1\u05d9\u05df \u05e1\u05d1\u05d9\u05d1\u05d4 \u05de\u05d1\u05d8\u05dc\u05ea (Invalidating environment) (\u05de\u05e7\u05d5\u05e8: \u05d7\u05d5\u05de\u05e8 \u05dc\u05d9\u05de\u05d5\u05d3 \u05de\u05e7\u05d9\u05e3)."
    },
    {
      "front": "\u05e2\u05dc \u05e4\u05d9 \u05d4-DSM-5-TR, \u05dc\u05db\u05de\u05d4 \u05d6\u05de\u05df \u05e0\u05de\u05e9\u05db\u05ea \u05d1\u05d3\u05e8\u05da \u05db\u05dc\u05dc \u05d4-Affective instability \u05d1-BPD?",
      "back": "\u05d4\u05ea\u05e0\u05d5\u05d3\u05d5\u05ea \u05d1\u05de\u05e6\u05d1 \u05d4\u05e8\u05d5\u05d7 \u05e0\u05de\u05e9\u05db\u05d5\u05ea \u05d1\u05d3\u05e8\u05da \u05db\u05dc\u05dc \u05de\u05e1\u05e4\u05e8 \u05e9\u05e2\u05d5\u05ea \u05d5\u05e8\u05e7 \u05dc\u05e2\u05d9\u05ea\u05d9\u05dd \u05e8\u05d7\u05d5\u05e7\u05d5\u05ea \u05d9\u05d5\u05ea\u05e8 \u05de\u05de\u05e1\u05e4\u05e8 \u05d9\u05de\u05d9\u05dd (DSM p.753)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05d4\u05d2\u05e0\u05d4 \u05d4\u05de\u05e2\u05e8\u05d1 \u05d4\u05e9\u05dc\u05db\u05d4 \u05e9\u05dc \u05d4\u05d9\u05d1\u05d8 \u05e2\u05e6\u05de\u05d9 \u05e2\u05dc \u05d4\u05d0\u05d7\u05e8 \u05d5\u05e0\u05d9\u05e1\u05d9\u05d5\u05df \u05dc\u05d0\u05dc\u05e5 \u05d0\u05ea \u05d4\u05d0\u05d7\u05e8 \u05dc\u05d4\u05d6\u05d3\u05d4\u05d5\u05ea \u05e2\u05dd \u05d4\u05d4\u05e9\u05dc\u05db\u05d4?",
      "back": "Projective Identification (Synopsis ch.19 Personality Disorders)."
    },
    {
      "front": "\u05e2\u05dc \u05e4\u05d9 \u05d4-StahlNeuro, \u05d0\u05d9\u05d6\u05d4 \u05db\u05e9\u05dc \u05de\u05e2\u05d2\u05dc\u05d9 \u05d1\u05de\u05d5\u05d7 \u05e2\u05d5\u05de\u05d3 \u05d1\u05d1\u05e1\u05d9\u05e1 \u05d7\u05d5\u05e1\u05e8 \u05d4\u05d9\u05db\u05d5\u05dc\u05ea \u05dc\u05d3\u05db\u05d0 \u05ea\u05d2\u05d5\u05d1\u05d5\u05ea \u05e8\u05d2\u05e9\u05d9\u05d5\u05ea \u05de\u05d5\u05e6\u05e4\u05d5\u05ea \u05d1-BPD?",
      "back": "\u05db\u05e9\u05dc \u05d1\u05d1\u05e7\u05e8\u05ea Top-down \u05e9\u05dc \u05d4-Prefrontal cortex (VMPFC, OFC, ACC) \u05e2\u05dc \u05d4-Amygdala \u05d5\u05d4\u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05dc\u05d9\u05de\u05d1\u05d9\u05ea (StahlNeuro p.453)."
    },
    {
      "front": "\u05d0\u05d9\u05dc\u05d5 \u05ea\u05d7\u05d5\u05e9\u05d5\u05ea \u05db\u05e8\u05d5\u05e0\u05d9\u05d5\u05ea \u05d1-BPD \u05e7\u05e9\u05d5\u05e8\u05d5\u05ea \u05dc\u05e8\u05d5\u05d1 \u05dc\u05d7\u05d5\u05e1\u05e8 \u05d1\u05d6\u05d4\u05d5\u05ea \u05e2\u05e7\u05d1\u05d9\u05ea (Identity diffusion)?",
      "back": "\u05ea\u05d7\u05d5\u05e9\u05d5\u05ea \u05db\u05e8\u05d5\u05e0\u05d9\u05d5\u05ea \u05e9\u05dc \u05e8\u05d9\u05e7\u05e0\u05d5\u05ea (Emptiness) \u05d5\u05e9\u05e2\u05de\u05d5\u05dd (DSM p.753, Synopsis ch.19)."
    },
    {
      "front": "\u05de\u05d3\u05d5\u05e2 \u05de\u05d5\u05de\u05dc\u05e5 \u05dc\u05d4\u05d9\u05de\u05e0\u05e2 \u05db\u05db\u05dc \u05d4\u05e0\u05d9\u05ea\u05df \u05de\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1-Benzodiazepines \u05d1\u05e7\u05e8\u05d1 \u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd \u05e2\u05dd BPD?",
      "back": "\u05d1\u05e9\u05dc \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05d2\u05e8\u05d9\u05de\u05ea Disinhibition \u05e9\u05e2\u05dc\u05d5\u05dc\u05d4 \u05dc\u05d4\u05d7\u05de\u05d9\u05e8 \u05d0\u05d9\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05d5\u05ea, \u05d4\u05ea\u05e4\u05e8\u05e6\u05d5\u05d9\u05d5\u05ea \u05d6\u05e2\u05dd \u05d5\u05e4\u05e6\u05d9\u05e2\u05d4 \u05e2\u05e6\u05de\u05d9\u05ea (Synopsis ch.19, \u05de\u05e7\u05d5\u05e8: \u05d7\u05d5\u05de\u05e8 \u05dc\u05d9\u05de\u05d5\u05d3 \u05de\u05e7\u05d9\u05e3)."
    },
    {
      "front": "\u05d0\u05d9\u05d6\u05d5 \u05ea\u05e8\u05d5\u05e4\u05d4 \u05de\u05de\u05e9\u05e4\u05d7\u05ea \u05d4-Atypical Antipsychotics \u05de\u05d5\u05de\u05dc\u05e6\u05ea \u05d1-StahlKids \u05dc\u05e9\u05dc\u05d9\u05d8\u05d4 \u05d1\u05d0\u05d9\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05d5\u05ea \u05d5\u05ea\u05d5\u05e7\u05e4\u05e0\u05d5\u05ea \u05d1\u05de\u05d9\u05e0\u05d5\u05e0\u05d9\u05dd \u05e9\u05dc $2-15$ mg/day?",
      "back": "Aripiprazole (StahlKids p.36-41)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05e9\u05d9\u05e2\u05d5\u05e8 \u05d4\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05e9\u05dc BPD \u05d1\u05e7\u05e8\u05d1 \u05de\u05d0\u05d5\u05e9\u05e4\u05d6\u05d9\u05dd \u05d1\u05de\u05d7\u05dc\u05e7\u05d5\u05ea \u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9\u05d5\u05ea \u05e2\u05dc \u05e4\u05d9 \u05d4-DSM-5-TR?",
      "back": "\u05db-20% \u05de\u05db\u05dc\u05dc \u05d4\u05de\u05d0\u05d5\u05e9\u05e4\u05d6\u05d9\u05dd (DSM p.755)."
    },
    {
      "front": "\u05d1\u05de\u05e1\u05d2\u05e8\u05ea \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05de\u05d1\u05d3\u05dc\u05ea, \u05db\u05d9\u05e6\u05d3 \u05e0\u05d1\u05d3\u05dc\u05ea BPD \u05de\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05de\u05e6\u05d1 \u05e8\u05d5\u05d7 \u05d1\u05e0\u05d5\u05d2\u05e2 \u05dc\u05d9\u05d7\u05e1\u05d9\u05dd \u05d1\u05d9\u05e0\u05d0\u05d9\u05e9\u05d9\u05d9\u05dd?",
      "back": "\u05d1-BPD \u05e7\u05d9\u05d9\u05de\u05ea \u05d3\u05e4\u05d5\u05e1 \u05e7\u05d1\u05d5\u05e2 \u05e9\u05dc Tumultuous interpersonal relationships \u05d5\u05e4\u05d7\u05d3 \u05de\u05e0\u05d8\u05d9\u05e9\u05d4 \u05e9\u05d0\u05d9\u05e0\u05dd \u05de\u05d5\u05d2\u05d1\u05dc\u05d9\u05dd \u05dc\u05d0\u05e4\u05d9\u05d6\u05d5\u05d3\u05d4 \u05e9\u05dc \u05de\u05e6\u05d1 \u05e8\u05d5\u05d7 (Synopsis ch.19, DSM p.753)."
    },
    {
      "front": "\u05d0\u05d9\u05d6\u05d4 \u05de\u05de\u05e6\u05d0 \u05d1-Cerebrospinal fluid (CSF) \u05e0\u05de\u05e6\u05d0 \u05d1\u05de\u05ea\u05d0\u05dd \u05d4\u05e4\u05d5\u05da \u05dc\u05de\u05d3\u05d3\u05d9\u05dd \u05e9\u05dc \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d0\u05d2\u05e8\u05e1\u05d9\u05d1\u05d9\u05ea \u05d5\u05d0\u05d9\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05ea?",
      "back": "\u05e8\u05de\u05d5\u05ea \u05e0\u05de\u05d5\u05db\u05d5\u05ea \u05e9\u05dc \u05d4\u05de\u05d8\u05d1\u05d5\u05dc\u05d9\u05d8 \u05d4\u05e1\u05e8\u05d5\u05d8\u05d5\u05e0\u05e8\u05d2\u05d9 5-HIAA (Dulcan p.594)."
    },
    {
      "front": "\u05d0\u05d9\u05d6\u05d5 \u05e9\u05d9\u05d8\u05ea \u05e4\u05e1\u05d9\u05db\u05d5\u05ea\u05e8\u05e4\u05d9\u05d4 \u05de\u05ea\u05de\u05e7\u05d3\u05ea \u05d1\u05e9\u05d9\u05e4\u05d5\u05e8 \u05d4\u05d9\u05db\u05d5\u05dc\u05ea \u05dc\u05d4\u05d1\u05d9\u05df \u05d0\u05ea \u05d4\u05de\u05e6\u05d1\u05d9\u05dd \u05d4\u05de\u05e0\u05d8\u05dc\u05d9\u05d9\u05dd \u05e9\u05dc \u05d4\u05e2\u05e6\u05de\u05d9 \u05d5\u05e9\u05dc \u05d4\u05d0\u05d7\u05e8 \u05db\u05d3\u05d9 \u05dc\u05d5\u05d5\u05e1\u05ea \u05e8\u05d2\u05e9\u05d5\u05ea?",
      "back": "Mentalization-Based Treatment (MBT) (Synopsis ch.19 Personality Disorders)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05d4\u05de\u05d5\u05d2\u05d1\u05e8 \u05dc\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea BPD \u05d1\u05e7\u05e8\u05d1 \u05e7\u05e8\u05d5\u05d1\u05d9 \u05de\u05e9\u05e4\u05d7\u05d4 \u05de\u05d3\u05e8\u05d2\u05d4 \u05e8\u05d0\u05e9\u05d5\u05e0\u05d4 \u05d1\u05d4\u05e9\u05d5\u05d5\u05d0\u05d4 \u05dc\u05d0\u05d5\u05db\u05dc\u05d5\u05e1\u05d9\u05d9\u05d4 \u05d4\u05db\u05dc\u05dc\u05d9\u05ea?",
      "back": "\u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05d2\u05d1\u05d5\u05d4 \u05e4\u05d9 5 \u05d1\u05e7\u05e8\u05d1 \u05e7\u05e8\u05d5\u05d1\u05d9 \u05de\u05e9\u05e4\u05d7\u05d4 \u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05d9\u05dd (DSM p.755)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d0\u05d6\u05d4\u05e8\u05ea \u05d4-FDA \u05d4\u05de\u05e8\u05db\u05d6\u05d9\u05ea \u05e9\u05d9\u05e9 \u05dc\u05e0\u05d8\u05e8 \u05d1\u05e7\u05e8\u05d1 \u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd \u05e2\u05dd BPD \u05d1\u05ea\u05d7\u05d9\u05dc\u05ea \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-SSRIs?",
      "back": "Black Box Warning \u05e2\u05dc \u05e1\u05d9\u05db\u05d5\u05df \u05de\u05d5\u05d2\u05d1\u05e8 \u05dc\u05de\u05d7\u05e9\u05d1\u05d5\u05ea \u05d5\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d0\u05d5\u05d1\u05d3\u05e0\u05d9\u05ea (StahlKids p.219)."
    },
    {
      "front": "\u05d0\u05d9\u05dc\u05d5 \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9\u05d9\u05dd \u05e2\u05e9\u05d5\u05d9\u05d9\u05dd \u05dc\u05d4\u05d5\u05e4\u05d9\u05e2 \u05ea\u05d7\u05ea \u05d3\u05d7\u05e7 \u05e7\u05d9\u05e6\u05d5\u05e0\u05d9 \u05d1-BPD \u05d0\u05da \u05d0\u05d9\u05e0\u05dd \u05de\u05e6\u05d3\u05d9\u05e7\u05d9\u05dd \u05d0\u05d1\u05d7\u05e0\u05d4 \u05e0\u05d5\u05e1\u05e4\u05ea \u05dc\u05e8\u05d5\u05d1?",
      "back": "Transient, stress-related paranoid ideation or severe dissociative symptoms (DSM p.753)."
    },
    {
      "front": "\u05e2\u05dc \u05e4\u05d9 \u05d4-StahlNeuro, \u05db\u05d9\u05e6\u05d3 \u05de\u05d2\u05d9\u05d1\u05d4 \u05d4-Amygdala \u05e9\u05dc \u05de\u05d8\u05d5\u05e4\u05dc\u05d9 BPD \u05dc\u05d4\u05d1\u05e2\u05d5\u05ea \u05e4\u05e0\u05d9\u05dd \u05e0\u05d9\u05d8\u05e8\u05dc\u05d9\u05d5\u05ea?",
      "back": "\u05d4\u05d9\u05d0 \u05de\u05e6\u05d9\u05d2\u05d4 Hyper-reactivity \u05d5\u05ea\u05d5\u05e4\u05e1\u05ea \u05d0\u05d5\u05ea\u05df \u05d1\u05d0\u05d5\u05e4\u05df \u05de\u05d5\u05d8\u05d4 \u05db\u05de\u05d0\u05d9\u05d9\u05de\u05d5\u05ea \u05d0\u05d5 \u05d3\u05d5\u05d7\u05d5\u05ea (StahlNeuro p.453)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05e9\u05d9\u05e2\u05d5\u05e8 \u05d4\u05ea\u05de\u05d5\u05ea\u05d4 \u05de\u05d4\u05ea\u05d0\u05d1\u05d3\u05d5\u05ea \u05dc\u05d0\u05d5\u05e8\u05da \u05d4\u05d7\u05d9\u05d9\u05dd (Lifetime mortality) \u05d1\u05e7\u05e8\u05d1 \u05d4\u05e1\u05d5\u05d1\u05dc\u05d9\u05dd \u05de-BPD?",
      "back": "\u05d1\u05e1\u05d1\u05d9\u05d1\u05d5\u05ea 6% (DSM p.756)."
    }
  ]
}