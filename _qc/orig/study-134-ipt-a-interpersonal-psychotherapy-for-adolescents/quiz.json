          "text": "\u05de\u05e2\u05d5\u05e8\u05d1\u05d5\u05ea \u05d4\u05d5\u05e8\u05d9\u05dd \u05d1-IPT-A \u05d0\u05d9\u05e0\u05d4 \u05d0\u05e4\u05e9\u05e8\u05d9\u05ea \u05d1\u05de\u05e7\u05e8\u05d9 ASD.",
          "isCorrect": false,
          "rationale": "\u05de\u05e2\u05d5\u05e8\u05d1\u05d5\u05ea \u05d4\u05d5\u05e8\u05d9\u05dd \u05de\u05d5\u05de\u05dc\u05e6\u05ea \u05d1-IPT-A \u05d5\u05d9\u05db\u05d5\u05dc\u05d4 \u05dc\u05e1\u05d9\u05d9\u05e2 \u05d1\u05db\u05dc \u05d0\u05d1\u05d7\u05e0\u05d4, \u05db\u05d5\u05dc\u05dc ASD (Dulcan p.956)."
        },
        {
          "text": "\u05d1-ASD \u05e7\u05d9\u05d9\u05dd \u05d0\u05d9\u05e1\u05d5\u05e8 \u05de\u05d5\u05d7\u05dc\u05d8 \u05e2\u05dc \u05e9\u05d9\u05dc\u05d5\u05d1 \u05d8\u05d9\u05e4\u05d5\u05dc \u05e4\u05e1\u05d9\u05db\u05d5\u05ea\u05e8\u05e4\u05d9 \u05d3\u05d9\u05e0\u05de\u05d9.",
          "isCorrect": false,
          "rationale": "IPT-A \u05d0\u05d9\u05e0\u05d5 \u05d8\u05d9\u05e4\u05d5\u05dc \u05e4\u05e1\u05d9\u05db\u05d5\u05d3\u05d9\u05e0\u05de\u05d9 \u05e7\u05dc\u05d0\u05e1\u05d9 \u05d0\u05dc\u05d0 \u05de\u05de\u05d5\u05e7\u05d3 \u05ea\u05e7\u05e9\u05d5\u05e8\u05ea, \u05d5\u05d4\u05d5\u05d0 \u05d0\u05d9\u05e0\u05d5 '\u05d0\u05e1\u05d5\u05e8' \u05d0\u05dc\u05d0 \u05e4\u05e9\u05d5\u05d8 \u05e4\u05d7\u05d5\u05ea \u05de\u05d5\u05ea\u05d0\u05dd \u05dc\u05d7\u05e1\u05db\u05d9\u05dd \u05e8\u05d0\u05e9\u05d5\u05e0\u05d9\u05d9\u05dd \u05e2\u05de\u05d5\u05e7\u05d9\u05dd (Dulcan p.955, p.959)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d1\u05d5 \u05e2\u05dc \u05de\u05e9\u05da \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05e7\u05e6\u05e8 \u05d5\u05d4\u05d4\u05e0\u05d7\u05d4 \u05dc\u05d2\u05d1\u05d9 \u05d4\u05de\u05e7\u05d5\u05e8 \u05e9\u05dc \u05d4\u05dc\u05e7\u05d5\u05ea \u05d4\u05d7\u05d1\u05e8\u05ea\u05d9\u05ea.",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05de\u05d8\u05e4\u05dc \u05d1-IPT-A \u05de\u05ea\u05d7\u05d9\u05dc \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Fluoxetine \u05e2\u05d1\u05d5\u05e8 \u05de\u05ea\u05d1\u05d2\u05e8 \u05d1\u05de\u05e7\u05d1\u05d9\u05dc \u05dc\u05e9\u05d9\u05d7\u05d5\u05ea \u05d4\u05e9\u05d1\u05d5\u05e2\u05d9\u05d5\u05ea. \u05e2\u05dc \u05e4\u05d9 \u05d4-StahlKids \u05d5\u05d4\u05e0\u05d7\u05d9\u05d5\u05ea \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd, \u05d0\u05d9\u05d6\u05d4 \u05e2\u05d9\u05e7\u05e8\u05d5\u05df \u05d4\u05e2\u05e8\u05db\u05d4 \u05d4\u05d5\u05d0 \u05e7\u05e8\u05d9\u05d8\u05d9 \u05dc\u05e0\u05d9\u05d8\u05d5\u05e8 \u05d4\u05ea\u05d2\u05d5\u05d1\u05d4 \u05d5\u05d4\u05e1\u05d9\u05db\u05d5\u05e0\u05d9\u05dd (\u05db\u05d2\u05d5\u05df \u05d0\u05e7\u05d8\u05d9\u05d1\u05e6\u05d9\u05d4) \u05d1\u05de\u05e7\u05e8\u05d4 \u05d6\u05d4?",
      "answerOptions": [
        {
          "text": "Triangulation of information",
          "isCorrect": true,
          "rationale": "\u05d9\u05e9 \u05e6\u05d5\u05e8\u05da \u05d1\u05d4\u05e6\u05dc\u05d1\u05ea \u05d3\u05d9\u05d5\u05d5\u05d7\u05d9\u05dd \u05de\u05d4\u05de\u05ea\u05d1\u05d2\u05e8, \u05de\u05d4\u05d4\u05d5\u05e8\u05d9\u05dd \u05d5\u05de\u05d4\u05de\u05d5\u05e8\u05d4 \u05db\u05d3\u05d9 \u05dc\u05d4\u05e2\u05e8\u05d9\u05da \u05e0\u05db\u05d5\u05e0\u05d4 \u05d0\u05ea \u05e9\u05d9\u05e0\u05d5\u05d9\u05d9 \u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d5\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea (StahlKids p.182)."
        },
        {
          "text": "\u05de\u05d5\u05e0\u05d5\u05ea\u05e8\u05e4\u05d9\u05d4 \u05e4\u05e1\u05d9\u05db\u05d5\u05ea\u05e8\u05e4\u05d9\u05d9\u05ea\u05d9\u05ea \u05d1\u05dc\u05d1\u05d3 \u05dc\u05de\u05e9\u05da 12 \u05e9\u05d1\u05d5\u05e2\u05d5\u05ea.",
          "isCorrect": false,
          "rationale": "\u05d1\u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05d1\u05d9\u05e0\u05d5\u05e0\u05d9-\u05e7\u05e9\u05d4 \u05e9\u05d9\u05dc\u05d5\u05d1 \u05ea\u05e8\u05d5\u05e4\u05ea\u05d9 \u05de\u05d5\u05de\u05dc\u05e5 \u05dc\u05e9\u05d9\u05e4\u05d5\u05e8 \u05d4\u05ea\u05d5\u05e6\u05d0\u05d5\u05ea \u05d5\u05dc\u05d0 \u05e0\u05d7\u05e9\u05d1 \u05dc\u05d8\u05e2\u05d5\u05ea (Dulcan p.260)."
        },
        {
          "text": "\u05d4\u05e2\u05e8\u05db\u05d4 \u05e2\u05e6\u05de\u05d9\u05ea \u05d1\u05dc\u05d1\u05d3 \u05e9\u05dc \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05d1\u05d0\u05de\u05e6\u05e2\u05d5\u05ea \u05d4-PHQ-9.",
          "isCorrect": false,
          "rationale": "\u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d5\u05e0\u05d5\u05e2\u05e8, \u05d3\u05d9\u05d5\u05d5\u05d7 \u05e2\u05e6\u05de\u05d9 \u05d1\u05dc\u05d1\u05d3 \u05d0\u05d9\u05e0\u05d5 \u05de\u05e1\u05e4\u05d9\u05e7 \u05d5\u05d9\u05e9 \u05dc\u05d4\u05e9\u05ea\u05de\u05e9 \u05d1\u05e9\u05d9\u05dc\u05d5\u05e9 \u05de\u05d9\u05d3\u05e2 (StahlKids p.182)."
        },
        {
          "text": "\u05d4\u05ea\u05de\u05e7\u05d3\u05d5\u05ea \u05d1\u05dc\u05e2\u05d3\u05d9\u05ea \u05d1\u05ea\u05d5\u05e4\u05e2\u05d5\u05ea \u05dc\u05d5\u05d5\u05d0\u05d9 \u05e4\u05d9\u05d6\u05d9\u05d5\u05ea (\u05db\u05d2\u05d5\u05df \u05d1\u05d7\u05d9\u05dc\u05d4) \u05dc\u05dc\u05d0 \u05e6\u05d5\u05e8\u05da \u05d1\u05e0\u05d9\u05d8\u05d5\u05e8 \u05de\u05e6\u05d1 \u05e8\u05d5\u05d7.",
          "isCorrect": false,
          "rationale": "\u05e0\u05d9\u05d8\u05d5\u05e8 \u05de\u05e6\u05d1 \u05d4\u05e8\u05d5\u05d7 \u05d5\u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05d4\u05d0\u05d5\u05d1\u05d3\u05e0\u05d9 \u05d4\u05d5\u05d0 \u05e7\u05e8\u05d9\u05d8\u05d9 \u05d1\u05e2\u05ea \u05ea\u05d7\u05d9\u05dc\u05ea SSRIs \u05d1\u05e0\u05d5\u05e2\u05e8 \u05e2\u05e7\u05d1 \u05d0\u05d6\u05d4\u05e8\u05ea \u05d4-Black Box (StahlKids p.202)."
        }
      ],
      "hint": "\u05d6\u05d4\u05d5 \u05e2\u05d9\u05e7\u05e8\u05d5\u05df \u05d4\u05de\u05e2\u05e8\u05d1 \u05de\u05e1\u05e4\u05e8 \u05de\u05e7\u05d5\u05e8\u05d5\u05ea \u05de\u05d9\u05d3\u05e2 \u05dc\u05d4\u05e2\u05e8\u05db\u05d4 \u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05d0\u05d5\u05d1\u05d9\u05d9\u05e7\u05d8\u05d9\u05d1\u05d9\u05ea.",
      "imageUrls": []
    },
    {
      "type": "fill_in_the_blank",
      "question": "\u05d4\u05db\u05dc\u05d9 \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05e9\u05d1\u05d5 \u05de\u05e9\u05ea\u05de\u05e9 \u05d4\u05de\u05d8\u05e4\u05dc \u05d1\u05de\u05d4\u05dc\u05da \u05d4-Interpersonal Inventory \u05d1\u05e9\u05dc\u05d1 \u05d4-Initial Phase \u05db\u05d3\u05d9 \u05dc\u05d6\u05d4\u05d5\u05ea \u05d0\u05ea \u05de\u05e2\u05e8\u05db\u05d5\u05ea \u05d4\u05d9\u05d7\u05e1\u05d9\u05dd \u05d4\u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05d5\u05ea \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d1\u05d7\u05d9\u05d9 \u05d4\u05de\u05ea\u05d1\u05d2\u05e8 \u05e0\u05e7\u05e8\u05d0 ___ (Closeness Circle).",
      "bestAnswer": "\u05de\u05e2\u05d2\u05dc \u05d4\u05e7\u05e8\u05d1\u05d4",
      "acceptableAnswers": [
        "Closeness Circle",
        "\u05de\u05e2\u05d2\u05dc \u05e7\u05e8\u05d1\u05d4"
      ],
      "rationale": "\u05de\u05e2\u05d2\u05dc \u05d4\u05e7\u05e8\u05d1\u05d4 \u05d4\u05d5\u05d0 \u05db\u05dc\u05d9 \u05d5\u05d9\u05d6\u05d5\u05d0\u05dc\u05d9 \u05e9\u05dc \u05d0\u05e8\u05d1\u05e2\u05d4 \u05de\u05e2\u05d2\u05dc\u05d9\u05dd \u05e8\u05d9\u05db\u05d5\u05d6\u05d9\u05d9\u05dd \u05d4\u05de\u05e9\u05de\u05e9 \u05dc\u05de\u05d9\u05e4\u05d5\u05d9 \u05d4\u05d3\u05de\u05d5\u05d9\u05d5\u05ea \u05d4\u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05d5\u05ea \u05d5\u05d4\u05e7\u05e9\u05e8 \u05e9\u05dc\u05d4\u05df \u05dc\u05de\u05e6\u05d1 \u05d4\u05e8\u05d5\u05d7 \u05e9\u05dc \u05d4\u05de\u05d8\u05d5\u05e4\u05dc (Dulcan p.957).",
      "hint": "\u05d6\u05d4\u05d5 \u05db\u05dc\u05d9 \u05d7\u05d6\u05d5\u05ea\u05d9 \u05d4\u05d3\u05d5\u05de\u05d4 \u05dc\u05dc\u05d5\u05d7 \u05de\u05d8\u05e8\u05d4 (bull's-eye) \u05dc\u05de\u05d9\u05e4\u05d5\u05d9 \u05e7\u05e9\u05e8\u05d9\u05dd \u05d7\u05d1\u05e8\u05ea\u05d9\u05d9\u05dd."
    },
    {
      "type": "short_answer",
      "question": "\u05d4\u05e1\u05d1\u05e8 \u05d1\u05e7\u05e6\u05e8\u05d4 \u05d0\u05ea \u05ea\u05e4\u05e7\u05d9\u05d3 \u05d4\u05de\u05d8\u05e4\u05dc \u05d1\u05e9\u05dc\u05d1 \u05d4-Termination Phase (\u05de\u05e4\u05d2\u05e9\u05d9\u05dd 10\u201312) \u05e9\u05dc \u05d8\u05d9\u05e4\u05d5\u05dc IPT-A.",
      "grading": {
        "modelAnswer": "\u05d4\u05de\u05d8\u05e4\u05dc \u05e1\u05d5\u05e7\u05e8 \u05d0\u05ea \u05d4\u05e9\u05d9\u05e4\u05d5\u05e8 \u05d1\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd, \u05de\u05e7\u05e9\u05e8 \u05d0\u05d5\u05ea\u05d5 \u05dc\u05de\u05d9\u05d5\u05de\u05e0\u05d5\u05d9\u05d5\u05ea \u05d4\u05d1\u05d9\u05df-\u05d0\u05d9\u05e9\u05d9\u05d5\u05ea \u05e9\u05e0\u05e8\u05db\u05e9\u05d5, \u05de\u05d6\u05d4\u05d4 \u05d9\u05d7\u05d3 \u05e2\u05dd \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05e1\u05d9\u05de\u05e0\u05d9 \u05d0\u05d6\u05d4\u05e8\u05d4 \u05de\u05d5\u05e7\u05d3\u05de\u05d9\u05dd \u05dc\u05d4\u05d9\u05e9\u05e0\u05d5\u05ea (warning signs), \u05d5\u05d1\u05d5\u05e0\u05d4 \u05ea\u05d5\u05db\u05e0\u05d9\u05ea \u05dc\u05de\u05e0\u05d9\u05e2\u05ea \u05d4\u05d9\u05e9\u05e0\u05d5\u05ea \u05d4\u05db\u05d5\u05dc\u05dc\u05ea \u05de\u05e2\u05d5\u05e8\u05d1\u05d5\u05ea \u05e9\u05dc \u05d4\u05d4\u05d5\u05e8\u05d9\u05dd.",
        "rationale": "\u05e9\u05dc\u05d1 \u05d4\u05e1\u05d9\u05d5\u05dd \u05de\u05ea\u05de\u05e7\u05d3 \u05d1\u05e9\u05d9\u05de\u05d5\u05e8 \u05d4\u05d4\u05d9\u05e9\u05d2\u05d9\u05dd, \u05d4\u05e2\u05e6\u05de\u05ea \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05d3\u05e8\u05da \u05d4\u05db\u05e8\u05d4 \u05d1\u05d9\u05db\u05d5\u05dc\u05d5\u05ea\u05d9\u05d5 \u05d4\u05d7\u05d3\u05e9\u05d5\u05ea \u05d5\u05d4\u05db\u05e0\u05d4 \u05dc\u05de\u05e0\u05d9\u05e2\u05ea \u05d7\u05d6\u05e8\u05ea \u05d4\u05d3\u05d9\u05db\u05d0\u05d5\u05df (Dulcan p.962).",
        "requiredAttributes": [
          "\u05e7\u05d9\u05e9\u05d5\u05e8 \u05d4\u05e9\u05d9\u05e4\u05d5\u05e8 \u05d1\u05de\u05e6\u05d1 \u05d4\u05e8\u05d5\u05d7 \u05dc\u05de\u05d9\u05d5\u05de\u05e0\u05d5\u05d9\u05d5\u05ea \u05e9\u05e0\u05e8\u05db\u05e9\u05d5.",
          "\u05d6\u05d9\u05d4\u05d5\u05d9 \u05e1\u05d9\u05de\u05e0\u05d9 \u05d0\u05d6\u05d4\u05e8\u05d4 \u05dc\u05d4\u05d9\u05e9\u05e0\u05d5\u05ea (warning signs).",
          "\u05ea\u05db\u05e0\u05d5\u05df \u05d0\u05e1\u05d8\u05e8\u05d8\u05d2\u05d9\u05d5\u05ea \u05dc\u05de\u05e0\u05d9\u05e2\u05ea \u05d4\u05d9\u05e9\u05e0\u05d5\u05ea/\u05d7\u05d6\u05e8\u05d4 \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc.",
          "\u05e2\u05d9\u05d1\u05d5\u05d3 \u05e8\u05d2\u05e9\u05d5\u05ea \u05d4\u05e1\u05d9\u05d5\u05dd."
        ],
        "errors": {
          "misconceptions": [
            "\u05d4\u05ea\u05de\u05e7\u05d3\u05d5\u05ea \u05e8\u05e7 \u05d1\u05e4\u05e8\u05d9\u05d3\u05d4 \u05d4\u05e8\u05d2\u05e9\u05d9\u05ea \u05dc\u05dc\u05d0 \u05de\u05e8\u05db\u05d9\u05d1 \u05e9\u05dc \u05de\u05e0\u05d9\u05e2\u05ea \u05d4\u05d9\u05e9\u05e0\u05d5\u05ea."
          ],
          "bluffs": [
            "\u05d0\u05de\u05d9\u05e8\u05d5\u05ea \u05db\u05dc\u05dc\u05d9\u05d5\u05ea \u05e2\u05dc '\u05e1\u05d9\u05d5\u05dd \u05d4\u05e7\u05e9\u05e8' \u05dc\u05dc\u05d0 \u05d4\u05ea\u05d9\u05d9\u05d7\u05e1\u05d5\u05ea \u05dc\u05e1\u05d9\u05de\u05e0\u05d9 \u05d0\u05d6\u05d4\u05e8\u05d4 \u05e7\u05dc\u05d9\u05e0\u05d9\u05d9\u05dd."
          ]
        }
      },
      "hint": "\u05d7\u05e9\u05d1\u05d5 \u05e2\u05dc \u05d4\u05de\u05e9\u05d9\u05de\u05d4 \u05e9\u05dc \u05de\u05e0\u05d9\u05e2\u05ea \u05d4\u05d9\u05e9\u05e0\u05d5\u05ea (Recurrence Prevention) \u05d5\u05d6\u05d9\u05d4\u05d5\u05d9 \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d7\u05d5\u05d6\u05e8\u05d9\u05dd.",
      "imageUrls": []
