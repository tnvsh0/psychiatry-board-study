{
  "title": "IPT-A Quiz",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\u05de\u05ea\u05d1\u05d2\u05e8 \u05d1\u05df 15 \u05d4\u05de\u05d0\u05d5\u05d1\u05d7\u05df \u05e2\u05dd Major Depressive Disorder (MDD) \u05de\u05d2\u05d9\u05e2 \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc IPT-A \u05e2\u05dd \u05d4\u05d5\u05e8\u05d9\u05d5. \u05d4\u05d4\u05d5\u05e8\u05d9\u05dd \u05de\u05ea\u05dc\u05d5\u05e0\u05e0\u05d9\u05dd \u05db\u05d9 \u05d4\u05d5\u05d0 \"\u05e2\u05e6\u05dc\u05df\" \u05de\u05e9\u05d5\u05dd \u05e9\u05e6\u05d9\u05d5\u05e0\u05d9\u05d5 \u05d9\u05e8\u05d3\u05d5 \u05d5\u05d4\u05d5\u05d0 \u05d0\u05d9\u05e0\u05d5 \u05de\u05d1\u05e6\u05e2 \u05d0\u05ea \u05de\u05d8\u05dc\u05d5\u05ea \u05d4\u05d1\u05d9\u05ea \u05db\u05d1\u05e2\u05d1\u05e8. \u05de\u05d4\u05d9 \u05d4\u05d4\u05ea\u05e2\u05e8\u05d1\u05d5\u05ea \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc\u05d9\u05ea \u05d4\u05de\u05d3\u05d5\u05d9\u05e7\u05ea \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05e9\u05dc\u05d1 \u05d4-Initial Phase \u05d1\u05de\u05e7\u05e8\u05d4 \u05d6\u05d4?",
      "answerOptions": [
        {
          "text": "\u05d4\u05e7\u05e6\u05d0\u05ea \u05d4-limited sick role \u05dc\u05de\u05ea\u05d1\u05d2\u05e8.",
          "isCorrect": true,
          "rationale": "\u05d4\u05de\u05e9\u05d2\u05ea \u05d4\u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05db\u05db\u05dc \u05de\u05d7\u05dc\u05d4 \u05e8\u05e4\u05d5\u05d0\u05d9\u05ea \u05d4\u05de\u05d5\u05e0\u05e2\u05ea \u05ea\u05e4\u05e7\u05d5\u05d3 \u05de\u05dc\u05d0 \u05de\u05e4\u05d7\u05d9\u05ea\u05d4 \u05d0\u05e9\u05de\u05d4 \u05e2\u05e6\u05de\u05d9\u05ea \u05d5\u05e1\u05d8\u05d9\u05d2\u05de\u05d4 \u05de\u05e9\u05e4\u05d7\u05ea\u05d9\u05ea (Dulcan p.957)."
        },
        {
          "text": "\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1-Communication Analysis (CA) \u05db\u05d3\u05d9 \u05dc\u05e4\u05ea\u05d5\u05e8 \u05d0\u05ea \u05d4\u05e7\u05d5\u05e0\u05e4\u05dc\u05d9\u05e7\u05d8 \u05de\u05d5\u05dc \u05d4\u05d4\u05d5\u05e8\u05d9\u05dd.",
          "isCorrect": false,
          "rationale": "\u05d8\u05db\u05e0\u05d9\u05e7\u05d4 \u05d6\u05d5 \u05e9\u05d9\u05d9\u05db\u05ea \u05dc\u05e9\u05dc\u05d1 \u05d4-Middle Phase \u05d5\u05d0\u05d9\u05e0\u05d4 \u05de\u05ea\u05d0\u05d9\u05de\u05d4 \u05dc\u05d4\u05de\u05e9\u05d2\u05d4 \u05d4\u05e8\u05d0\u05e9\u05d5\u05e0\u05d9\u05ea \u05e9\u05dc \u05d4\u05de\u05d7\u05dc\u05d4 (Dulcan p.960)."
        },
        {
          "text": "\u05d4\u05e4\u05e0\u05d9\u05d4 \u05de\u05d9\u05d9\u05d3\u05d9\u05ea \u05dc\u05d4\u05e2\u05e8\u05db\u05ea \u05e4\u05e1\u05d9\u05db\u05d5\u05e4\u05e8\u05de\u05e7\u05d5\u05dc\u05d5\u05d2\u05d9\u05d4 \u05d1-SSRI.",
          "isCorrect": false,
          "rationale": "\u05d0\u05e3 \u05e9\u05e0\u05d9\u05ea\u05df \u05dc\u05e9\u05dc\u05d1 \u05d8\u05d9\u05e4\u05d5\u05dc \u05ea\u05e8\u05d5\u05e4\u05ea\u05d9, \u05d4\u05e6\u05e2\u05d3 \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc\u05d9 \u05d4\u05e1\u05e4\u05e6\u05d9\u05e4\u05d9 \u05d1\u05de\u05d5\u05d3\u05dc \u05d4-IPT-A \u05d1\u05e9\u05dc\u05d1 \u05d6\u05d4 \u05d4\u05d5\u05d0 \u05d4\u05e4\u05e1\u05d9\u05db\u05d5-\u05d7\u05d9\u05e0\u05d5\u05da \u05dc\u05d2\u05d1\u05d9 \u05ea\u05e4\u05e7\u05d9\u05d3 \u05d4\u05d7\u05d5\u05dc\u05d4 (Dulcan p.957)."
        },
        {
          "text": "\u05d4\u05d2\u05d3\u05e8\u05ea \u05d4\u05de\u05e6\u05d1 \u05db-Interpersonal Deficits.",
          "isCorrect": false,
          "rationale": "\u05ea\u05d7\u05d5\u05dd \u05d1\u05e2\u05d9\u05d4 \u05d6\u05d4 \u05de\u05ea\u05d9\u05d9\u05d7\u05e1 \u05dc\u05d7\u05d5\u05e1\u05e8 \u05de\u05d9\u05d5\u05de\u05e0\u05d5\u05d9\u05d5\u05ea \u05d7\u05d1\u05e8\u05ea\u05d9\u05d5\u05ea \u05d1\u05e1\u05d9\u05e1\u05d9\u05d5\u05ea \u05d5\u05dc\u05d0 \u05dc\u05d0\u05d5\u05e4\u05df \u05e9\u05d1\u05d5 \u05d4\u05de\u05d7\u05dc\u05d4 \u05d4\u05d3\u05d9\u05db\u05d0\u05d5\u05e0\u05d9\u05ea \u05e0\u05ea\u05e4\u05e1\u05ea \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d4\u05de\u05e9\u05e4\u05d7\u05d4 (Dulcan p.958)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d1\u05d5 \u05e2\u05dc \u05d4\u05de\u05d5\u05d3\u05dc \u05d4\u05e8\u05e4\u05d5\u05d0\u05d9 \u05e9\u05d1\u05d5 \u05de\u05e9\u05ea\u05de\u05e9 \u05d4\u05de\u05d8\u05e4\u05dc \u05db\u05d3\u05d9 \u05dc\u05d4\u05d5\u05e8\u05d9\u05d3 \u05d0\u05ea \u05e8\u05de\u05ea \u05d4\u05d0\u05e9\u05de\u05d4 \u05e9\u05dc \u05d4\u05de\u05ea\u05d1\u05d2\u05e8 \u05d5\u05de\u05e9\u05e4\u05d7\u05ea\u05d5.",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05e0\u05e2\u05e8\u05d4 \u05d1\u05ea 14 \u05e2\u05d1\u05e8\u05d4 \u05dc\u05d1\u05d9\u05ea \u05e1\u05e4\u05e8 \u05d7\u05d3\u05e9 \u05dc\u05e4\u05e0\u05d9 \u05db-6 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05d1\u05e2\u05e7\u05d1\u05d5\u05ea \u05d2\u05d9\u05e8\u05d5\u05e9\u05d9 \u05d4\u05d5\u05e8\u05d9\u05d4. \u05d4\u05d9\u05d0 \u05de\u05d3\u05d5\u05d5\u05d7\u05ea \u05e2\u05dc \u05e2\u05e6\u05d1, \u05d7\u05d5\u05e1\u05e8 \u05e2\u05e0\u05d9\u05d9\u05df \u05d5\u05d2\u05e2\u05d2\u05d5\u05e2 \u05e2\u05d6 \u05dc\u05d7\u05d1\u05e8\u05d5\u05ea\u05d9\u05d4 \u05de\u05d4\u05e2\u05d9\u05e8 \u05d4\u05e7\u05d5\u05d3\u05de\u05ea. \u05d4\u05d9\u05d0 \u05de\u05ea\u05e7\u05e9\u05d4 \u05dc\u05d4\u05e1\u05ea\u05d2\u05dc \u05dc\u05d3\u05e8\u05d9\u05e9\u05d5\u05ea \u05d4\u05dc\u05d9\u05de\u05d5\u05d3\u05d9\u05d5\u05ea \u05d4\u05d7\u05d3\u05e9\u05d5\u05ea \u05d5\u05de\u05e8\u05d2\u05d9\u05e9\u05d4 \u05e9\u05d0\u05d9\u05e0\u05d4 \u05de\u05ea\u05d0\u05d9\u05de\u05d4 \u05dc\u05de\u05e2\u05de\u05d3 \u05d4\u05d7\u05d1\u05e8\u05ea\u05d9 \u05d4\u05e0\u05d5\u05db\u05d7\u05d9. \u05de\u05d4\u05d5 \u05d4-Interpersonal Problem Area \u05d4\u05de\u05ea\u05d0\u05d9\u05dd \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d1-IPT-A?",
      "answerOptions": [
        {
          "text": "Interpersonal Role Transition",
          "isCorrect": true,
          "rationale": "\u05ea\u05d7\u05d5\u05dd \u05d6\u05d4 \u05de\u05ea\u05de\u05e7\u05d3 \u05d1\u05e7\u05e9\u05d9\u05d9\u05dd \u05d4\u05e0\u05d5\u05d1\u05e2\u05d9\u05dd \u05de\u05e9\u05d9\u05e0\u05d5\u05d9\u05d9 \u05d7\u05d9\u05d9\u05dd \u05d4\u05d3\u05d5\u05e8\u05e9\u05d9\u05dd \u05de\u05e2\u05d1\u05e8 \u05de\u05ea\u05e4\u05e7\u05d9\u05d3 \u05d9\u05e9\u05df \u05d5\u05de\u05d5\u05db\u05e8 \u05dc\u05ea\u05e4\u05e7\u05d9\u05d3 \u05d7\u05d3\u05e9 \u05d5\u05de\u05d0\u05ea\u05d2\u05e8 (Dulcan p.958)."
        },
        {
          "text": "Interpersonal Deficits",
          "isCorrect": false,
          "rationale": "\u05d7\u05e1\u05db\u05d9\u05dd \u05d0\u05dc\u05d5 \u05de\u05ea\u05d9\u05d9\u05d7\u05e1\u05d9\u05dd \u05dc\u05d1\u05d9\u05d3\u05d5\u05d3 \u05d7\u05d1\u05e8\u05ea\u05d9 \u05d4\u05e0\u05d5\u05d1\u05e2 \u05de\u05de\u05d9\u05d5\u05de\u05e0\u05d5\u05d9\u05d5\u05ea \u05ea\u05e7\u05e9\u05d5\u05e8\u05ea \u05dc\u05e7\u05d5\u05d9\u05d5\u05ea \u05dc\u05d0\u05d5\u05e8\u05da \u05d6\u05de\u05df, \u05d5\u05dc\u05d0 \u05de\u05e9\u05d9\u05e0\u05d5\u05d9 \u05e0\u05e1\u05d9\u05d1\u05ea\u05d9 \u05d1\u05d7\u05d9\u05d9\u05dd (Dulcan p.958)."
        },
        {
          "text": "Interpersonal Role Dispute",
          "isCorrect": false,
          "rationale": "\u05de\u05d7\u05dc\u05d5\u05e7\u05ea \u05d1\u05ea\u05e4\u05e7\u05d9\u05d3 \u05d3\u05d5\u05e8\u05e9\u05ea \u05e7\u05d5\u05e0\u05e4\u05dc\u05d9\u05e7\u05d8 \u05d2\u05dc\u05d5\u05d9 \u05d0\u05d5 \u05e1\u05de\u05d5\u05d9 \u05e2\u05dd \u05d3\u05de\u05d5\u05ea \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05dc\u05d2\u05d1\u05d9 \u05e6\u05d9\u05e4\u05d9\u05d5\u05ea \u05d4\u05d3\u05d3\u05d9\u05d5\u05ea, \u05de\u05d4 \u05e9\u05dc\u05d0 \u05ea\u05d5\u05d0\u05e8 \u05d1\u05de\u05e7\u05e8\u05d4 \u05d6\u05d4 (Dulcan p.958)."
        },
        {
          "text": "Grief due to death",
          "isCorrect": false,
          "rationale": "\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4 \u05d6\u05d5 \u05e9\u05de\u05d5\u05e8\u05d4 \u05d0\u05da \u05d5\u05e8\u05e7 \u05dc\u05d0\u05d1\u05dc \u05d1\u05e2\u05e7\u05d1\u05d5\u05ea \u05de\u05d5\u05d5\u05ea \u05e9\u05dc \u05d0\u05d3\u05dd \u05e7\u05e8\u05d5\u05d1 \u05d5\u05dc\u05d0 \u05dc\u05d0\u05d5\u05d1\u05d3\u05df \u05e9\u05dc \u05de\u05e2\u05de\u05d3 \u05d7\u05d1\u05e8\u05ea\u05d9 (Dulcan p.958)."
        }
      ],
      "hint": "\u05d4\u05ea\u05de\u05e7\u05d3\u05d5 \u05d1\u05e9\u05d9\u05e0\u05d5\u05d9 \u05d4\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d5\u05d4\u05e0\u05e1\u05d9\u05d1\u05d5\u05ea \u05e9\u05dc \u05d4\u05e0\u05e2\u05e8\u05d4 \u05d4\u05d3\u05d5\u05e8\u05e9\u05d9\u05dd \u05d4\u05e1\u05ea\u05d2\u05dc\u05d5\u05ea \u05dc\u05de\u05e6\u05d9\u05d0\u05d5\u05ea \u05d7\u05d3\u05e9\u05d4.",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05de\u05d8\u05e4\u05dc \u05d1-IPT-A \u05de\u05d1\u05e7\u05e9 \u05de\u05de\u05d8\u05d5\u05e4\u05dc \u05dc\u05ea\u05d0\u05e8 \u05d1\u05e4\u05d9\u05e8\u05d5\u05d8 \u05de\u05d3\u05d5\u05d9\u05e7 \u05e9\u05d9\u05d7\u05d4 \u05e7\u05e9\u05d4 \u05e9\u05d4\u05ea\u05e7\u05d9\u05d9\u05de\u05d4 \u05e2\u05dd \u05d7\u05d1\u05e8\u05d5 \u05d4\u05d8\u05d5\u05d1: \"\u05de\u05d4 \u05d1\u05d3\u05d9\u05d5\u05e7 \u05d0\u05de\u05e8\u05ea?\", \"\u05de\u05d4 \u05d4\u05d5\u05d0 \u05e2\u05e0\u05d4?\", \"\u05d0\u05d9\u05e4\u05d4 \u05d6\u05d4 \u05e7\u05e8\u05d4?\" \u05d5-\"\u05d0\u05d9\u05da \u05d4\u05e8\u05d2\u05e9\u05ea \u05d1\u05d0\u05d5\u05ea\u05d5 \u05e8\u05d2\u05e2?\". \u05d1\u05d0\u05d9\u05d6\u05d5 \u05d8\u05db\u05e0\u05d9\u05e7\u05d4 \u05de\u05e8\u05db\u05d6\u05d9\u05ea \u05e9\u05dc \u05d4-Middle Phase \u05de\u05e9\u05ea\u05de\u05e9 \u05d4\u05de\u05d8\u05e4\u05dc?",
      "answerOptions": [
        {
          "text": "Communication Analysis (CA)",
          "isCorrect": true,
          "rationale": "\u05d8\u05db\u05e0\u05d9\u05e7\u05d4 \u05d6\u05d5 \u05e0\u05d5\u05e2\u05d3\u05d4 \u05dc\u05e0\u05ea\u05d7 \u05d0\u05d9\u05e0\u05d8\u05e8\u05d0\u05e7\u05e6\u05d9\u05d5\u05ea \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05d5\u05ea \u05db\u05d3\u05d9 \u05dc\u05d6\u05d4\u05d5\u05ea \u05e9\u05d9\u05d1\u05d5\u05e9\u05d9\u05dd \u05d1\u05ea\u05e7\u05e9\u05d5\u05e8\u05ea \u05d5\u05dc\u05dc\u05de\u05d3 \u05d0\u05dc\u05d8\u05e8\u05e0\u05d8\u05d9\u05d1\u05d5\u05ea \u05d9\u05e2\u05d9\u05dc\u05d5\u05ea (Dulcan p.960)."
        },
        {
          "text": "Decision Analysis",
          "isCorrect": false,
          "rationale": "\u05e0\u05d9\u05ea\u05d5\u05d7 \u05d4\u05d7\u05dc\u05d8\u05d5\u05ea \u05de\u05ea\u05de\u05e7\u05d3 \u05d1\u05d1\u05d7\u05d9\u05e8\u05ea \u05e4\u05ea\u05e8\u05d5\u05e0\u05d5\u05ea \u05dc\u05d1\u05e2\u05d9\u05d4 \u05d5\u05dc\u05d0 \u05d1\u05e9\u05d7\u05d6\u05d5\u05e8 \u05de\u05e4\u05d5\u05e8\u05d8 \u05e9\u05dc \u05d3\u05d9\u05d0\u05dc\u05d5\u05d2 \u05e9\u05db\u05d1\u05e8 \u05d4\u05ea\u05e7\u05d9\u05d9\u05dd (Dulcan p.960)."
        },
        {
          "text": "Role-playing",
          "isCorrect": false,
          "rationale": "\u05de\u05e9\u05d7\u05e7 \u05ea\u05e4\u05e7\u05d9\u05d3\u05d9\u05dd \u05d4\u05d5\u05d0 \u05ea\u05e8\u05d2\u05d5\u05dc \u05e9\u05dc \u05ea\u05e7\u05e9\u05d5\u05e8\u05ea \u05e2\u05ea\u05d9\u05d3\u05d9\u05ea \u05d1\u05ea\u05d5\u05da \u05d4\u05d7\u05d3\u05e8, \u05d5\u05dc\u05d0 \u05e9\u05d7\u05d6\u05d5\u05e8 \u05e8\u05d8\u05e8\u05d5\u05e1\u05e4\u05e7\u05d8\u05d9\u05d1\u05d9 \u05e9\u05dc \u05d0\u05d9\u05e8\u05d5\u05e2 (Dulcan p.960)."
        },
        {
          "text": "Encouragement of Affect",
          "isCorrect": false,
          "rationale": "\u05d0\u05e3 \u05e9\u05d4\u05de\u05d8\u05e4\u05dc \u05e9\u05d5\u05d0\u05dc \u05e2\u05dc \u05e8\u05d2\u05e9\u05d5\u05ea, \u05d4\u05de\u05d9\u05e7\u05d5\u05d3 \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05db\u05d0\u05df \u05d4\u05d5\u05d0 \u05e2\u05dc \u05d4\u05de\u05d1\u05e0\u05d4 \u05d5\u05d4\u05ea\u05d5\u05db\u05df \u05e9\u05dc \u05d4\u05d0\u05d9\u05e0\u05d8\u05e8\u05d0\u05e7\u05e6\u05d9\u05d4 \u05d4\u05d1\u05d9\u05df-\u05d0\u05d9\u05e9\u05d9\u05ea (Dulcan p.959)."
        }
