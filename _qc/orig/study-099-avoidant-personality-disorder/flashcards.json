{
  "title": "Avoidant Flashcards",
  "cards": [
    {
      "front": "\u05de\u05d4\u05d5 \u05d4-Essential Feature \u05e9\u05dc \u05d4\u05e4\u05e8\u05e2\u05ea \u05d0\u05d9\u05e9\u05d9\u05d5\u05ea \u05e0\u05de\u05e0\u05e2\u05ea (AvPD) \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR?",
      "back": "\u05d3\u05e4\u05d5\u05e1 \u05e0\u05e8\u05d7\u05d1 \u05e9\u05dc \u05e2\u05db\u05d1\u05d4 \u05d7\u05d1\u05e8\u05ea\u05d9\u05ea, \u05ea\u05d7\u05d5\u05e9\u05d5\u05ea \u05d7\u05d5\u05e1\u05e8 \u05db\u05e9\u05d9\u05e8\u05d5\u05ea \u05d5\u05e8\u05d2\u05d9\u05e9\u05d5\u05ea \u05d9\u05ea\u05e8\u05d4 \u05dc\u05d4\u05e2\u05e8\u05db\u05d4 \u05e9\u05dc\u05d9\u05dc\u05d9\u05ea (DSM p.765)."
    },
    {
      "front": "\u05db\u05de\u05d4 \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05de\u05ea\u05d5\u05da \u05d4-7 \u05e0\u05d3\u05e8\u05e9\u05d9\u05dd \u05db\u05d3\u05d9 \u05dc\u05d0\u05d1\u05d7\u05df AvPD \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR?",
      "back": "\u05dc\u05e4\u05d7\u05d5\u05ea 4 \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05d4\u05de\u05d5\u05e4\u05d9\u05e2\u05d9\u05dd \u05e2\u05d3 \u05d4\u05d1\u05d2\u05e8\u05d5\u05ea \u05d4\u05de\u05d5\u05e7\u05d3\u05de\u05ea \u05d1\u05de\u05d2\u05d5\u05d5\u05df \u05d4\u05e7\u05e9\u05e8\u05d9\u05dd (DSM p.765)."
    },
    {
      "front": "\u05e2\u05dc \u05e4\u05d9 \u05d4-DSM-5-TR, \u05de\u05d4\u05d9 \u05d4\u05e1\u05d9\u05d1\u05d4 \u05dc\u05d4\u05d9\u05de\u05e0\u05e2\u05d5\u05ea \u05de\u05e4\u05e2\u05d9\u05dc\u05d5\u05d9\u05d5\u05ea \u05ea\u05e2\u05e1\u05d5\u05e7\u05ea\u05d9\u05d5\u05ea \u05d1-AvPD?",
      "back": "\u05e4\u05d7\u05d3 \u05de\u05d1\u05d9\u05e7\u05d5\u05e8\u05ea, \u05d0\u05d9-\u05d0\u05d9\u05e9\u05d5\u05e8 (disapproval) \u05d0\u05d5 \u05d3\u05d7\u05d9\u05d9\u05d4 (DSM p.765)."
    },
    {
      "front": "\u05d1\u05d0\u05d9\u05d6\u05d4 \u05ea\u05e0\u05d0\u05d9 \u05d0\u05d3\u05dd \u05e2\u05dd AvPD \u05d9\u05d4\u05d9\u05d4 \u05de\u05d5\u05db\u05df \u05dc\u05d4\u05e1\u05ea\u05d1\u05da (get involved) \u05e2\u05dd \u05d0\u05e0\u05e9\u05d9\u05dd \u05d0\u05d7\u05e8\u05d9\u05dd?",
      "back": "\u05e8\u05e7 \u05db\u05d0\u05e9\u05e8 \u05d4\u05d5\u05d0 \u05d1\u05d8\u05d5\u05d7 \u05d1-100% \u05e9\u05d9\u05d4\u05d9\u05d4 \u05d0\u05d4\u05d5\u05d1/\u05e8\u05e6\u05d5\u05d9 (certain of being liked) (DSM p.765)."
    },
    {
      "front": "\u05de\u05d3\u05d5\u05e2 \u05d0\u05e0\u05e9\u05d9\u05dd \u05e2\u05dd AvPD \u05de\u05e8\u05d0\u05d9\u05dd \u05d0\u05d9\u05e4\u05d5\u05e7 (restraint) \u05d1\u05ea\u05d5\u05da \u05de\u05e2\u05e8\u05db\u05d5\u05ea \u05d9\u05d7\u05e1\u05d9\u05dd \u05d0\u05d9\u05e0\u05d8\u05d9\u05de\u05d9\u05d5\u05ea?",
      "back": "\u05d1\u05e9\u05dc \u05d4\u05e4\u05d7\u05d3 \u05e9\u05d9\u05e2\u05d1\u05e8\u05d5 \u05d4\u05e9\u05e4\u05dc\u05d4 \u05d0\u05d5 \u05dc\u05e2\u05d2 (fear of being shamed or ridiculed) (DSM p.765)."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05ea\u05d5\u05e4\u05e1 \u05d0\u05ea \u05e2\u05e6\u05de\u05d5 (Self-view) \u05d0\u05d3\u05dd \u05d4\u05e1\u05d5\u05d1\u05dc \u05de-AvPD \u05de\u05d1\u05d7\u05d9\u05e0\u05d4 \u05d7\u05d1\u05e8\u05ea\u05d9\u05ea?",
      "back": "\u05db\u05d0\u05d3\u05dd \u05d7\u05e1\u05e8 \u05db\u05d9\u05e9\u05d5\u05e8\u05d9\u05dd \u05d7\u05d1\u05e8\u05ea\u05d9\u05d9\u05dd (socially inept), \u05dc\u05d0 \u05de\u05d5\u05e9\u05da \u05d0\u05d9\u05e9\u05d9\u05ea \u05d0\u05d5 \u05e0\u05d7\u05d5\u05ea \u05de\u05d0\u05d7\u05e8\u05d9\u05dd (DSM p.765)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d4-Prevalence \u05e9\u05dc AvPD \u05dc\u05e4\u05d9 \u05de\u05d7\u05e7\u05e8 \u05d4-NESARC \u05d4\u05de\u05e6\u05d5\u05d8\u05d8 \u05d1-DSM-5-TR?",
      "back": "\u05db-2.4% \u05d1\u05d0\u05d5\u05db\u05dc\u05d5\u05e1\u05d9\u05d9\u05d4 \u05d4\u05db\u05dc\u05dc\u05d9\u05ea (DSM p.766)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05d4\u05d1\u05d3\u05dc \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05d1\u05d9\u05df AvPD \u05dc\u05d1\u05d9\u05df \u05d4\u05e4\u05e8\u05e2\u05ea \u05d0\u05d9\u05e9\u05d9\u05d5\u05ea \u05e1\u05db\u05d9\u05d6\u05d5\u05d0\u05d9\u05d3\u05d9\u05ea (Schizoid PD)?",
      "back": "\u05d1-AvPD \u05d9\u05e9 \u05e8\u05e6\u05d5\u05df \u05e2\u05d6 \u05dc\u05e7\u05e9\u05e8\u05d9\u05dd \u05d5\u05e7\u05d9\u05d9\u05de\u05ea \u05d1\u05d3\u05d9\u05d3\u05d5\u05ea, \u05d1\u05e2\u05d5\u05d3 \u05e9\u05d1-Schizoid PD \u05d9\u05e9 \u05d7\u05d5\u05e1\u05e8 \u05e2\u05e0\u05d9\u05d9\u05df \u05d5\u05d4\u05e2\u05d3\u05e4\u05d4 \u05dc\u05d1\u05d9\u05d3\u05d5\u05d3 (DSM p.768)."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05e0\u05d9\u05ea\u05df \u05dc\u05d4\u05d1\u05d7\u05d9\u05df \u05d1\u05d9\u05df AvPD \u05dc\u05d1\u05d9\u05df Social Anxiety Disorder (SAD) \u05de\u05d1\u05d7\u05d9\u05e0\u05ea \u05d9\u05e6\u05d9\u05d1\u05d5\u05ea \u05d4\u05d3\u05d9\u05de\u05d5\u05d9 \u05d4\u05e2\u05e6\u05de\u05d9?",
      "back": "\u05d1-AvPD \u05d4\u05d3\u05d9\u05de\u05d5\u05d9 \u05d4\u05e2\u05e6\u05de\u05d9 \u05d4\u05e0\u05de\u05d5\u05da \u05d4\u05d5\u05d0 \u05de\u05d5\u05e9\u05e8\u05e9, \u05db\u05e8\u05d5\u05e0\u05d9 \u05d5\u05d2\u05dc\u05d5\u05d1\u05dc\u05d9 \u05d9\u05d5\u05ea\u05e8 \u05de\u05d0\u05e9\u05e8 \u05d1-SAD (DSM p.767)."
    },
    {
      "front": "\u05de\u05d4 \u05de\u05d1\u05d7\u05d9\u05df \u05d1\u05d9\u05df \u05d4\u05d4\u05d9\u05de\u05e0\u05e2\u05d5\u05ea \u05d1-Agoraphobia \u05dc\u05d1\u05d9\u05df \u05d4\u05d4\u05d9\u05de\u05e0\u05e2\u05d5\u05ea \u05d1-AvPD?",
      "back": "\u05d1\u05d0\u05d2\u05d5\u05e8\u05e4\u05d5\u05d1\u05d9\u05d4 \u05d4\u05de\u05e0\u05d9\u05e2 \u05d4\u05d5\u05d0 \u05e4\u05d7\u05d3 \u05de\u05d4\u05ea\u05e7\u05e4\u05d9 \u05e4\u05d0\u05e0\u05d9\u05e7\u05d4 \u05d0\u05d5 \u05d7\u05d5\u05e1\u05e8 \u05e2\u05d6\u05e8\u05d4, \u05d5\u05d1-AvPD \u05d4\u05de\u05e0\u05d9\u05e2 \u05d4\u05d5\u05d0 \u05e4\u05d7\u05d3 \u05de\u05d1\u05d9\u05e7\u05d5\u05e8\u05ea \u05d5\u05d3\u05d7\u05d9\u05d9\u05d4 (DSM p.767)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05d2\u05d9\u05e9\u05d4 \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc\u05d9\u05ea \u05d4\u05e0\u05d7\u05e9\u05d1\u05ea \u05db\u05e7\u05d5 \u05e8\u05d0\u05e9\u05d5\u05df (treatment_first_line) \u05dc-AvPD?",
      "back": "\u05e4\u05e1\u05d9\u05db\u05d5\u05ea\u05e8\u05e4\u05d9\u05d4, \u05d1\u05d3\u05d2\u05e9 \u05e2\u05dc CBT, \u05d0\u05d9\u05de\u05d5\u05df \u05de\u05d9\u05d5\u05de\u05e0\u05d5\u05d9\u05d5\u05ea \u05d7\u05d1\u05e8\u05ea\u05d9\u05d5\u05ea \u05d5\u05d8\u05d9\u05e4\u05d5\u05dc \u05e7\u05d1\u05d5\u05e6\u05ea\u05d9 (Synopsis ch.19 Personality Disorders)."
    },
    {
      "front": "\u05d1\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1-Group Therapy \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-AvPD, \u05de\u05d4\u05d5 \u05d4\u05d9\u05ea\u05e8\u05d5\u05df \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05dc\u05de\u05d8\u05d5\u05e4\u05dc?",
      "back": "\u05d4\u05d1\u05e0\u05ea \u05d4\u05e9\u05e4\u05e2\u05ea \u05d4\u05e8\u05d2\u05d9\u05e9\u05d5\u05ea \u05e9\u05dc\u05d5 \u05dc\u05d3\u05d7\u05d9\u05d9\u05d4 \u05e2\u05dc \u05d0\u05d7\u05e8\u05d9\u05dd \u05d5\u05ea\u05e8\u05d2\u05d5\u05dc \u05de\u05d9\u05d5\u05de\u05e0\u05d5\u05d9\u05d5\u05ea \u05d7\u05d1\u05e8\u05ea\u05d9\u05d5\u05ea \u05d1\u05e1\u05d1\u05d9\u05d1\u05d4 \u05d1\u05d8\u05d5\u05d7\u05d4 (Synopsis ch.19 Personality Disorders)."
    },
    {
      "front": "\u05d0\u05d9\u05d6\u05d5 \u05d0\u05d6\u05d4\u05e8\u05d4 \u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05e7\u05d9\u05d9\u05de\u05ea \u05dc\u05d2\u05d1\u05d9 \u05de\u05ea\u05df \u05de\u05e9\u05d9\u05de\u05d5\u05ea \u05d7\u05e9\u05d9\u05e4\u05d4 (Exposure) \u05dc\u05de\u05d8\u05d5\u05e4\u05dc \u05e2\u05dd AvPD?",
      "back": "\u05db\u05d9\u05e9\u05dc\u05d5\u05df \u05d1\u05de\u05e9\u05d9\u05de\u05d4 \u05e2\u05dc\u05d5\u05dc \u05dc\u05d7\u05d6\u05e7 \u05d0\u05ea \u05d4\u05d3\u05d9\u05de\u05d5\u05d9 \u05d4\u05e2\u05e6\u05de\u05d9 \u05d4\u05e0\u05de\u05d5\u05da; \u05d9\u05e9 \u05dc\u05d1\u05e6\u05e2 \u05d7\u05e9\u05d9\u05e4\u05d4 \u05d4\u05d3\u05e8\u05d2\u05ea\u05d9\u05ea \u05d5\u05de\u05d1\u05d5\u05e7\u05e8\u05ea \u05de\u05d0\u05d5\u05d3 (Synopsis ch.19 Personality Disorders)."
    },
    {
      "front": "\u05d0\u05d9\u05dc\u05d5 \u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05e2\u05e9\u05d5\u05d9\u05d5\u05ea \u05dc\u05e2\u05d6\u05d5\u05e8 \u05d1\u05e0\u05d9\u05d4\u05d5\u05dc \u05ea\u05e1\u05de\u05d9\u05e0\u05d9 Rejection Sensitivity \u05d1-AvPD?",
      "back": "\u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05de\u05de\u05e9\u05e4\u05d7\u05ea \u05d4-SSRI (Synopsis ch.19 Personality Disorders)."
    },
    {
      "front": "\u05dc\u05e9\u05dd \u05de\u05d4 \u05e0\u05e9\u05ea\u05de\u05e9 \u05d1-$\\beta$-adrenergic receptor antagonists (\u05db\u05d2\u05d5\u05df Atenolol) \u05d1\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-AvPD?",
      "back": "\u05dc\u05e0\u05d9\u05d4\u05d5\u05dc \u05ea\u05d2\u05d5\u05d1\u05d5\u05ea \u05d9\u05ea\u05e8 \u05e9\u05dc \u05d4\u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05d0\u05d5\u05d8\u05d5\u05e0\u05d5\u05de\u05d9\u05ea (\u05db\u05de\u05d5 \u05d3\u05d5\u05e4\u05e7 \u05de\u05d4\u05d9\u05e8) \u05d1\u05e2\u05ea \u05d4\u05ea\u05e7\u05e8\u05d1\u05d5\u05ea \u05dc\u05de\u05e6\u05d1\u05d9\u05dd \u05de\u05e2\u05d5\u05e8\u05e8\u05d9 \u05d7\u05e8\u05d3\u05d4 (Synopsis ch.19 Personality Disorders)."
    },
    {
      "front": "\u05d1\u05de\u05d5\u05d3\u05dc \u05d4\u05d0\u05dc\u05d8\u05e8\u05e0\u05d8\u05d9\u05d1\u05d9 (Section III), \u05de\u05d4\u05d5 \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05e9\u05dc \u05ea\u05d7\u05d5\u05dd \u05d4-Empathy \u05d1-AvPD?",
      "back": "\u05e2\u05d9\u05e1\u05d5\u05e7-\u05d9\u05ea\u05e8 \u05d5\u05e8\u05d2\u05d9\u05e9\u05d5\u05ea \u05dc\u05d1\u05d9\u05e7\u05d5\u05e8\u05ea \u05d4\u05de\u05d5\u05d1\u05d9\u05dc\u05d9\u05dd \u05dc\u05e2\u05d9\u05d5\u05d5\u05ea \u05d1\u05ea\u05e4\u05d9\u05e1\u05ea \u05e4\u05e8\u05e1\u05e4\u05e7\u05d8\u05d9\u05d1\u05ea \u05d4\u05d0\u05d7\u05e8 \u05db\u05e0\u05d2\u05d8\u05d9\u05d1\u05d9\u05ea (DSM p.885)."
    },
    {
      "front": "\u05d1-Alternative Model \u05e9\u05dc \u05d4-DSM-5-TR, \u05d0\u05d9\u05d6\u05d5 \u05ea\u05db\u05d5\u05e0\u05d4 \u05e4\u05ea\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea (Trait) \u05d4\u05d9\u05d0 \u05d7\u05d5\u05d1\u05d4 \u05dc\u05d0\u05d1\u05d7\u05e0\u05ea AvPD?",
      "back": "\u05d7\u05e8\u05d3\u05ea\u05d9\u05d5\u05ea (Anxiousness) \u05de\u05ea\u05d7\u05d5\u05dd \u05d4-Negative Affectivity (DSM p.885)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05de\u05d1\u05d3\u05dc\u05ea \u05d1\u05d9\u05df AvPD \u05dc\u05d1\u05d9\u05df \u05d4\u05e4\u05e8\u05e2\u05ea \u05d0\u05d9\u05e9\u05d9\u05d5\u05ea \u05ea\u05dc\u05d5\u05ea\u05d9\u05ea (Dependent PD) \u05de\u05d1\u05d7\u05d9\u05e0\u05ea \u05d4\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d1\u05d9\u05d7\u05e1\u05d9\u05dd?",
      "back": "\u05d1-AvPD \u05d9\u05e9 \u05d4\u05d9\u05de\u05e0\u05e2\u05d5\u05ea \u05de\u05e7\u05e8\u05d1\u05d4 (Avoidance of proximity), \u05d1\u05e2\u05d5\u05d3 \u05e9\u05d1-Dependent PD \u05d9\u05e9 \u05d7\u05d9\u05e4\u05d5\u05e9 \u05e7\u05e8\u05d1\u05d4 (Proximity-seeking) (DSM p.768)."
    }
  ]
}