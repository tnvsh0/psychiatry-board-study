    {
      "type": "multiple_select",
      "question": "\u05d0\u05d9\u05dc\u05d5 \u05de\u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05d4\u05d1\u05d0\u05d9\u05dd \u05e0\u05db\u05dc\u05dc\u05d9\u05dd \u05d1-DSM-5-TR \u05dc\u05d0\u05d1\u05d7\u05e0\u05ea Avoidant Personality Disorder (\u05d9\u05e9 \u05dc\u05d1\u05d7\u05d5\u05e8 \u05d0\u05ea \u05db\u05dc \u05d4\u05ea\u05e9\u05d5\u05d1\u05d5\u05ea \u05d4\u05e0\u05db\u05d5\u05e0\u05d5\u05ea)?",
      "answerOptions": [
        {
          "text": "\u05d4\u05d9\u05de\u05e0\u05e2\u05d5\u05ea \u05de\u05e4\u05e2\u05d9\u05dc\u05d5\u05d9\u05d5\u05ea \u05ea\u05e2\u05e1\u05d5\u05e7\u05ea\u05d9\u05d5\u05ea \u05d4\u05db\u05e8\u05d5\u05db\u05d5\u05ea \u05d1\u05de\u05d2\u05e2 \u05d1\u05d9\u05df-\u05d0\u05d9\u05e9\u05d9 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9 \u05d1\u05e9\u05dc \u05e4\u05d7\u05d3 \u05de\u05d1\u05d9\u05e7\u05d5\u05e8\u05ea.",
          "isCorrect": true,
