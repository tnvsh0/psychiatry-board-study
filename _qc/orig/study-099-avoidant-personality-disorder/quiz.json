    },
    {
      "type": "multiple_choice",
      "question": "\u05de\u05d8\u05d5\u05e4\u05dc \u05e2\u05dd Avoidant Personality Disorder \u05de\u05ea\u05d7\u05d9\u05dc \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Cognitive Behavioral Therapy (CBT). \u05d4\u05de\u05d8\u05e4\u05dc \u05e9\u05d5\u05e7\u05dc \u05dc\u05ea\u05ea \u05dc\u05de\u05d8\u05d5\u05e4\u05dc \u05de\u05d8\u05dc\u05d5\u05ea \u05dc\u05ea\u05e8\u05d2\u05d5\u05dc \u05de\u05d9\u05d5\u05de\u05e0\u05d5\u05d9\u05d5\u05ea \u05d7\u05d1\u05e8\u05ea\u05d9\u05d5\u05ea \u05de\u05d7\u05d5\u05e5 \u05dc\u05e4\u05d2\u05d9\u05e9\u05d5\u05ea. \u05e2\u05dc \u05e4\u05d9 \u05d4-Synopsis, \u05de\u05d3\u05d5\u05e2 \u05e2\u05dc \u05d4\u05de\u05d8\u05e4\u05dc \u05dc\u05e0\u05d4\u05d5\u05d2 \u05d1\u05d6\u05d4\u05d9\u05e8\u05d5\u05ea \u05e8\u05d1\u05d4 \u05d1\u05de\u05ea\u05df \u05de\u05d8\u05dc\u05d5\u05ea \u05d0\u05dc\u05d5?",
      "answerOptions": [
        {
          "text": "\u05db\u05d9 \u05db\u05d9\u05e9\u05dc\u05d5\u05df \u05d1\u05de\u05d8\u05dc\u05d4 \u05e2\u05dc\u05d5\u05dc \u05dc\u05d7\u05d6\u05e7 \u05d0\u05ea \u05d4\u05d4\u05e2\u05e8\u05db\u05d4 \u05d4\u05e2\u05e6\u05de\u05d9\u05ea \u05d4\u05d9\u05e8\u05d5\u05d3\u05d4 \u05e9\u05dc \u05d4\u05de\u05d8\u05d5\u05e4\u05dc.",
          "isCorrect": true,
          "rationale": "\u05d1\u05e9\u05dc \u05d4\u05e8\u05d2\u05d9\u05e9\u05d5\u05ea \u05d4\u05e7\u05d9\u05e6\u05d5\u05e0\u05d9\u05ea \u05e9\u05dc \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05dc\u05d1\u05d9\u05e7\u05d5\u05e8\u05ea \u05d5\u05d3\u05d7\u05d9\u05d9\u05d4, \u05db\u05d9\u05e9\u05dc\u05d5\u05df \u05d1\u05de\u05e9\u05d9\u05de\u05d4 \u05d7\u05d1\u05e8\u05ea\u05d9\u05ea \u05de\u05d7\u05d5\u05e5 \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05e2\u05dc\u05d5\u05dc \u05dc\u05d4\u05d5\u05d1\u05d9\u05dc \u05dc\u05e0\u05e1\u05d9\u05d2\u05d4 \u05d5\u05dc\u05d4\u05d7\u05de\u05e8\u05ea \u05ea\u05d7\u05d5\u05e9\u05ea \u05d4\u05e0\u05d7\u05d9\u05ea\u05d5\u05ea (Synopsis ch.19 Personality Disorders)."
