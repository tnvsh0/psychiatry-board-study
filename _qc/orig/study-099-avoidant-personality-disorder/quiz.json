{
  "title": "Avoidant Quiz",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\u05de\u05d8\u05d5\u05e4\u05dc\u05ea \u05d1\u05ea 19 \u05e4\u05d5\u05e0\u05d4 \u05dc\u05d9\u05d9\u05e2\u05d5\u05e5 \u05d1\u05e9\u05dc \u05d1\u05d9\u05d3\u05d5\u05d3 \u05d7\u05d1\u05e8\u05ea\u05d9 \u05e2\u05de\u05d5\u05e7. \u05d4\u05d9\u05d0 \u05de\u05ea\u05d0\u05e8\u05ea \u05db\u05d9 \u05d4\u05d9\u05d0 \u05e0\u05de\u05e0\u05e2\u05ea \u05d1\u05d0\u05d5\u05e4\u05df \u05e2\u05e7\u05d1\u05d9 \u05de\u05de\u05e4\u05d2\u05e9\u05d9\u05dd \u05e1\u05d8\u05d5\u05d3\u05e0\u05d8\u05d9\u05d0\u05dc\u05d9\u05d9\u05dd \u05d5\u05de\u05e2\u05d1\u05d5\u05d3\u05d5\u05ea \u05e6\u05d5\u05d5\u05ea, \u05e9\u05db\u05df \u05d4\u05d9\u05d0 \u05d7\u05e9\u05d4 \"\u05e0\u05d7\u05d5\u05ea\u05d4 \u05d7\u05d1\u05e8\u05ea\u05d9\u05ea\" \u05d5\u05d7\u05e1\u05e8\u05ea \u05e2\u05e8\u05da \u05d1\u05d4\u05e9\u05d5\u05d5\u05d0\u05d4 \u05dc\u05d0\u05d7\u05e8\u05d9\u05dd. \u05d1\u05e0\u05d9\u05d2\u05d5\u05d3 \u05dc\u05de\u05e7\u05e8\u05d9\u05dd \u05d0\u05d7\u05e8\u05d9\u05dd \u05e9\u05dc \u05e0\u05e1\u05d9\u05d2\u05d4 \u05d7\u05d1\u05e8\u05ea\u05d9\u05ea, \u05d4\u05d9\u05d0 \u05de\u05d1\u05d8\u05d0\u05ea \u05db\u05de\u05d9\u05d4\u05d4 \u05e2\u05d6\u05d4 \u05dc\u05d7\u05d1\u05e8\u05d5\u05d9\u05d5\u05ea \u05d5\u05d1\u05d5\u05db\u05d4 \u05e2\u05dc \u05d1\u05d3\u05d9\u05d3\u05d5\u05ea\u05d4, \u05d0\u05da \u05de\u05e6\u05d9\u05d9\u05e0\u05ea \u05db\u05d9 \u05d0\u05d9\u05e0\u05d4 \u05de\u05e1\u05d5\u05d2\u05dc\u05ea \u05dc\u05d9\u05e6\u05d5\u05e8 \u05e7\u05e9\u05e8 \u05d0\u05dc\u05d0 \u05d0\u05dd \u05d4\u05d9\u05d0 \u05d1\u05d8\u05d5\u05d7\u05d4 \u05d1-100% \u05e9\u05d9\u05d4\u05d9\u05d4 \"\u05d0\u05d9\u05e9\u05d5\u05e8 \u05de\u05d5\u05d7\u05dc\u05d8 \u05d5\u05e0\u05d8\u05d5\u05dc \u05d1\u05d9\u05e7\u05d5\u05e8\u05ea\" \u05de\u05e6\u05d3 \u05d4\u05e6\u05d3 \u05d4\u05e9\u05e0\u05d9. \u05e2\u05dc \u05e4\u05d9 \u05d4-DSM-5-TR, \u05de\u05d4\u05d9 \u05d4\u05e0\u05e7\u05d5\u05d3\u05d4 \u05d4\u05e2\u05d9\u05e7\u05e8\u05d9\u05ea \u05d4\u05de\u05d1\u05d3\u05d9\u05dc\u05d4 \u05d1\u05d9\u05df \u05de\u05e6\u05d1 \u05d6\u05d4 \u05dc\u05d1\u05d9\u05df Schizoid Personality Disorder?",
      "answerOptions": [
        {
          "text": "\u05d4\u05db\u05de\u05d9\u05d4\u05d4 \u05dc\u05e7\u05e9\u05e8\u05d9\u05dd \u05d7\u05d1\u05e8\u05ea\u05d9\u05d9\u05dd \u05d5\u05d4\u05e1\u05d1\u05dc \u05de\u05d4\u05d1\u05d3\u05d9\u05d3\u05d5\u05ea.",
          "isCorrect": true,
          "rationale": "\u05d1\u05e2\u05d5\u05d3 \u05e9\u05d7\u05d5\u05dc\u05d9\u05dd \u05e2\u05dd Schizoid Personality Disorder \u05de\u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05d9\u05dd \u05d1\u05d0\u05d3\u05d9\u05e9\u05d5\u05ea \u05dc\u05e7\u05e9\u05e8\u05d9\u05dd \u05d7\u05d1\u05e8\u05ea\u05d9\u05d9\u05dd \u05d5\u05d7\u05d5\u05e1\u05e8 \u05e2\u05e0\u05d9\u05d9\u05df \u05d1\u05d0\u05d9\u05e0\u05d8\u05d9\u05de\u05d9\u05d5\u05ea, \u05d7\u05d5\u05dc\u05d9 AvPD \u05de\u05e2\u05d5\u05e0\u05d9\u05d9\u05e0\u05d9\u05dd \u05de\u05d0\u05d5\u05d3 \u05d1\u05e7\u05e9\u05e8\u05d9\u05dd \u05d0\u05da \u05e0\u05de\u05e0\u05e2\u05d9\u05dd \u05de\u05d4\u05dd \u05d1\u05e9\u05dc \u05e4\u05d7\u05d3 \u05de\u05d3\u05d7\u05d9\u05d9\u05d4 \u05d5\u05d1\u05d9\u05e7\u05d5\u05e8\u05ea (DSM p.768, Synopsis ch.19 Personality Disorders)."
        },
        {
          "text": "\u05d7\u05d5\u05de\u05e8\u05ea \u05d4\u05dc\u05d9\u05e7\u05d5\u05d9 \u05d1\u05ea\u05e4\u05e7\u05d5\u05d3 \u05d4\u05ea\u05e2\u05e1\u05d5\u05e7\u05ea\u05d9 \u05d5\u05d4\u05d0\u05e7\u05d3\u05de\u05d9.",
          "isCorrect": false,
          "rationale": "\u05dc\u05d9\u05e7\u05d5\u05d9 \u05ea\u05e4\u05e7\u05d5\u05d3\u05d9 \u05d9\u05db\u05d5\u05dc \u05dc\u05d4\u05d5\u05e4\u05d9\u05e2 \u05d1\u05e9\u05ea\u05d9 \u05d4\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05d5\u05d0\u05d9\u05e0\u05d5 \u05de\u05d4\u05d5\u05d5\u05d4 \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df \u05de\u05d1\u05d7\u05d9\u05df \u05de\u05e8\u05db\u05d6\u05d9 \u05d1\u05d9\u05e0\u05d9\u05d4\u05df (DSM p.766)."
        },
        {
          "text": "\u05d4\u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05e9\u05dc \u05d7\u05e8\u05d3\u05d4 \u05d0\u05d5\u05d8\u05d5\u05e0\u05d5\u05de\u05d9\u05ea \u05d1\u05de\u05e6\u05d1\u05d9\u05dd \u05d7\u05d1\u05e8\u05ea\u05d9\u05d9\u05dd.",
          "isCorrect": false,
          "rationale": "\u05d7\u05e8\u05d3\u05d4 \u05e2\u05e9\u05d5\u05d9\u05d4 \u05dc\u05d4\u05d5\u05e4\u05d9\u05e2 \u05d1\u05e9\u05ea\u05d9 \u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05d4\u05d0\u05d9\u05e9\u05d9\u05d5\u05ea, \u05d0\u05da \u05d4\u05de\u05e0\u05d9\u05e2 \u05d4\u05e4\u05e0\u05d9\u05de\u05d9 - \u05d7\u05d5\u05e1\u05e8 \u05e2\u05e0\u05d9\u05d9\u05df \u05dc\u05e2\u05d5\u05de\u05ea \u05e4\u05d7\u05d3 \u05de\u05d3\u05d7\u05d9\u05d9\u05d4 - \u05d4\u05d5\u05d0 \u05d4\u05de\u05e4\u05ea\u05d7 \u05dc\u05d4\u05d1\u05d7\u05e0\u05d4 (Synopsis ch.19 Personality Disorders)."
        },
        {
          "text": "\u05d4\u05d2\u05d9\u05dc \u05d1\u05d5 \u05d4\u05d7\u05dc\u05d5 \u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05dc\u05d4\u05d5\u05e4\u05d9\u05e2.",
          "isCorrect": false,
          "rationale": "\u05e9\u05ea\u05d9 \u05d4\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05de\u05ea\u05d7\u05d9\u05dc\u05d5\u05ea \u05d1\u05d3\u05e8\u05da \u05db\u05dc\u05dc \u05d1\u05d1\u05d2\u05e8\u05d5\u05ea \u05d4\u05de\u05d5\u05e7\u05d3\u05de\u05ea \u05d5\u05de\u05ea\u05d0\u05e4\u05d9\u05d9\u05e0\u05d5\u05ea \u05d1\u05d3\u05e4\u05d5\u05e1 \u05de\u05ea\u05de\u05e9\u05da, \u05d5\u05dc\u05db\u05df \u05d4\u05d2\u05d9\u05dc \u05d0\u05d9\u05e0\u05d5 \u05db\u05dc\u05d9 \u05de\u05d1\u05d7\u05d9\u05df (DSM p.765)."
        }
      ],
      "hint": "\u05d4\u05ea\u05de\u05e7\u05d3 \u05d1\u05de\u05d5\u05d8\u05d9\u05d1\u05e6\u05d9\u05d4 \u05d4\u05e4\u05e0\u05d9\u05de\u05d9\u05ea \u05d5\u05d1\u05d2\u05d9\u05e9\u05d4 \u05d4\u05e8\u05d2\u05e9\u05d9\u05ea \u05db\u05dc\u05e4\u05d9 \u05d4\u05e6\u05d5\u05e8\u05da \u05d1\u05e7\u05e9\u05e8\u05d9\u05dd \u05d1\u05d9\u05df-\u05d0\u05d9\u05e9\u05d9\u05d9\u05dd.",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05e7\u05dc\u05d9\u05e0\u05d0\u05d9 \u05de\u05e0\u05e1\u05d4 \u05dc\u05d4\u05d1\u05d7\u05d9\u05df \u05d1\u05d9\u05df Avoidant Personality Disorder (AvPD) \u05dc\u05d1\u05d9\u05df Social Anxiety Disorder (SAD) \u05d0\u05e6\u05dc \u05de\u05d8\u05d5\u05e4\u05dc \u05d1\u05df 25. \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05de\u05e6\u05d9\u05d2 \u05d4\u05d9\u05de\u05e0\u05e2\u05d5\u05ea \u05e0\u05e8\u05d7\u05d1\u05ea, \u05d0\u05da \u05de\u05d3\u05d2\u05d9\u05e9 \u05db\u05d9 \u05d4\u05d3\u05d9\u05de\u05d5\u05d9 \u05d4\u05e2\u05e6\u05de\u05d9 \u05e9\u05dc\u05d5 \u05db\"\u05dc\u05d0 \u05de\u05d5\u05e6\u05dc\u05d7 \u05d7\u05d1\u05e8\u05ea\u05d9\u05ea\" (Socially inept) \u05d5\"\u05e0\u05d7\u05d5\u05ea\" \u05d4\u05d5\u05d0 \u05ea\u05e4\u05d9\u05e1\u05d4 \u05d9\u05e6\u05d9\u05d1\u05d4 \u05d5\u05de\u05d5\u05e9\u05e8\u05e9\u05ea \u05d4\u05de\u05dc\u05d5\u05d5\u05d4 \u05d0\u05d5\u05ea\u05d5 \u05de\u05d9\u05dc\u05d3\u05d5\u05ea \u05de\u05d5\u05e7\u05d3\u05de\u05ea \u05d1\u05db\u05dc \u05d0\u05d9\u05e0\u05d8\u05e8\u05d0\u05e7\u05e6\u05d9\u05d4, \u05dc\u05dc\u05d0 \u05e7\u05e9\u05e8 \u05dc\u05e1\u05d9\u05d8\u05d5\u05d0\u05e6\u05d9\u05d4 \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05ea. \u05d0\u05d9\u05d6\u05d4 \u05de\u05de\u05e6\u05d0 \u05ea\u05d5\u05de\u05da \u05d9\u05d5\u05ea\u05e8 \u05d1\u05d0\u05d1\u05d7\u05e0\u05ea AvPD \u05e2\u05dc \u05e4\u05e0\u05d9 SAD \u05e2\u05dc \u05e4\u05d9 \u05d4-DSM-5-TR?",
      "answerOptions": [
        {
          "text": "\u05d3\u05d9\u05de\u05d5\u05d9 \u05e2\u05e6\u05de\u05d9 \u05e9\u05dc\u05d9\u05dc\u05d9 (Self-concept) \u05de\u05d5\u05e9\u05e8\u05e9, \u05d2\u05dc\u05d5\u05d1\u05dc\u05d9 \u05d5\u05e7\u05d1\u05d5\u05e2 \u05e9\u05dc \u05e0\u05d7\u05d9\u05ea\u05d5\u05ea.",
          "isCorrect": true,
          "rationale": "\u05d1-AvPD \u05d4\u05d3\u05d9\u05de\u05d5\u05d9 \u05d4\u05e2\u05e6\u05de\u05d9 \u05d4\u05e9\u05dc\u05d9\u05dc\u05d9 \u05d4\u05d5\u05d0 \u05de\u05e8\u05db\u05d6\u05d9, entrenched \u05d5\u05e4\u05d7\u05d5\u05ea \u05ea\u05dc\u05d5\u05d9 \u05e1\u05d9\u05d8\u05d5\u05d0\u05e6\u05d9\u05d4 \u05d1\u05d4\u05e9\u05d5\u05d5\u05d0\u05d4 \u05dc-SAD, \u05e9\u05dd \u05d4\u05d7\u05e8\u05d3\u05d4 \u05e2\u05e9\u05d5\u05d9\u05d4 \u05dc\u05d4\u05d9\u05d5\u05ea \u05de\u05de\u05d5\u05e7\u05d3\u05ea \u05d9\u05d5\u05ea\u05e8 \u05d1\u05d1\u05d9\u05e6\u05d5\u05e2 \u05d0\u05d5 \u05d1\u05e1\u05d9\u05d8\u05d5\u05d0\u05e6\u05d9\u05d5\u05ea \u05d7\u05d1\u05e8\u05ea\u05d9\u05d5\u05ea \u05de\u05e1\u05d5\u05d9\u05de\u05d5\u05ea (DSM p.767)."
        },
        {
          "text": "\u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05e9\u05dc \u05d4\u05ea\u05e7\u05e4\u05d9 \u05e4\u05d0\u05e0\u05d9\u05e7\u05d4 (Panic attacks) \u05d1\u05de\u05e6\u05d1\u05d9 \u05d3\u05d7\u05e7 \u05d7\u05d1\u05e8\u05ea\u05d9\u05d9\u05dd.",
          "isCorrect": false,
          "rationale": "\u05d4\u05ea\u05e7\u05e4\u05d9 \u05e4\u05d0\u05e0\u05d9\u05e7\u05d4 \u05d9\u05db\u05d5\u05dc\u05d9\u05dd \u05dc\u05d4\u05ea\u05e8\u05d7\u05e9 \u05d1-SAD \u05d1\u05ea\u05d2\u05d5\u05d1\u05d4 \u05dc\u05e1\u05d9\u05d8\u05d5\u05d0\u05e6\u05d9\u05d5\u05ea \u05d7\u05d1\u05e8\u05ea\u05d9\u05d5\u05ea, \u05d0\u05da \u05d0\u05d9\u05e0\u05dd \u05de\u05d2\u05d3\u05d9\u05e8\u05d9\u05dd AvPD (DSM p.234)."
        },
        {
          "text": "\u05d4\u05d9\u05de\u05e0\u05e2\u05d5\u05ea \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05ea \u05de\u05d3\u05d9\u05d1\u05d5\u05e8 \u05d1\u05e4\u05d5\u05de\u05d1\u05d9 \u05d0\u05d5 \u05d4\u05d5\u05e4\u05e2\u05d4 \u05de\u05d5\u05dc \u05e7\u05d4\u05dc.",
          "isCorrect": false,
          "rationale": "\u05d4\u05d9\u05de\u05e0\u05e2\u05d5\u05ea \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05ea \u05de\u05d1\u05d9\u05e6\u05d5\u05e2 (Performance only) \u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05ea \u05ea\u05ea-\u05e1\u05d5\u05d2 \u05e9\u05dc SAD \u05d5\u05dc\u05d0 \u05d0\u05ea \u05d3\u05e4\u05d5\u05e1 \u05d4\u05d0\u05d9\u05e9\u05d9\u05d5\u05ea \u05d4\u05e0\u05e8\u05d7\u05d1 \u05e9\u05dc AvPD (DSM p.229)."
        },
        {
          "text": "\u05d4\u05d9\u05e2\u05d3\u05e8 \u05e8\u05e6\u05d5\u05df \u05de\u05d5\u05d7\u05dc\u05d8 \u05dc\u05d9\u05e6\u05d9\u05e8\u05ea \u05e7\u05e9\u05e8\u05d9\u05dd \u05d0\u05d9\u05e0\u05d8\u05d9\u05de\u05d9\u05d9\u05dd.",
          "isCorrect": false,
          "rationale": "\u05e0\u05ea\u05d5\u05df \u05d6\u05d4 \u05e9\u05d5\u05dc\u05dc \u05dc\u05de\u05e2\u05e9\u05d4 AvPD, \u05e9\u05db\u05df \u05d7\u05d5\u05dc\u05d9\u05dd \u05d0\u05dc\u05d5 \u05db\u05de\u05d4\u05d9\u05dd \u05dc\u05e7\u05e9\u05e8\u05d9\u05dd \u05dc\u05de\u05e8\u05d5\u05ea \u05d4\u05e4\u05d7\u05d3 (Synopsis ch.19 Personality Disorders)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05de\u05d9\u05d3\u05ea \u05d4\u05d7\u05d3\u05d9\u05e8\u05d5\u05ea \u05e9\u05dc \u05d4\u05d3\u05d9\u05de\u05d5\u05d9 \u05d4\u05e2\u05e6\u05de\u05d9 \u05d4\u05e9\u05dc\u05d9\u05dc\u05d9 \u05dc\u05db\u05dc \u05ea\u05d7\u05d5\u05de\u05d9 \u05d4\u05d7\u05d9\u05d9\u05dd.",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05d1\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Avoidant Personality Disorder, \u05dc\u05e2\u05d9\u05ea\u05d9\u05dd \u05e0\u05e2\u05e9\u05d4 \u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05e4\u05e8\u05de\u05e7\u05d5\u05ea\u05e8\u05e4\u05d9\u05d4 \u05db\u05e2\u05d6\u05e8 \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05e4\u05e1\u05d9\u05db\u05d5\u05ea\u05e8\u05e4\u05d9. \u05e2\u05dc \u05e4\u05d9 \u05d4-Synopsis, \u05d0\u05d9\u05d6\u05d4 \u05e1\u05d5\u05d2 \u05e9\u05dc \u05d8\u05d9\u05e4\u05d5\u05dc \u05ea\u05e8\u05d5\u05e4\u05ea\u05d9 \u05e2\u05e9\u05d5\u05d9 \u05dc\u05e1\u05d9\u05d9\u05e2 \u05d1\u05d0\u05d5\u05e4\u05df \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9 \u05d1\u05e0\u05d9\u05d4\u05d5\u05dc \u05d4-Rejection sensitivity (\u05e8\u05d2\u05d9\u05e9\u05d5\u05ea \u05dc\u05d3\u05d7\u05d9\u05d9\u05d4) \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05ea \u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd \u05d0\u05dc\u05d5?",
      "answerOptions": [
        {
          "text": "\u05ea\u05db\u05e9\u05d9\u05e8\u05d9\u05dd \u05e1\u05e8\u05d5\u05d8\u05d5\u05e0\u05e8\u05d2\u05d9\u05d9\u05dd \u05db\u05d2\u05d5\u05df SSRI.",
          "isCorrect": true,
