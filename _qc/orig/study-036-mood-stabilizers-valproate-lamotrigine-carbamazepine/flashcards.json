{
  "title": "Psychiatry Flashcards",
  "cards": [
    {
      "front": "\u05de\u05d4\u05dd \u05e9\u05dc\u05d5\u05e9\u05ea \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05e0\u05d9\u05dd \u05d4\u05de\u05e9\u05d5\u05e2\u05e8\u05d9\u05dd \u05e9\u05dc Valproate \u05d1\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-$Bipolar\\ Disorder$?",
      "back": "\u05e2\u05d9\u05db\u05d5\u05d1 $VSSCs$, \u05d4\u05d2\u05d1\u05e8\u05ea \u05e4\u05e2\u05d9\u05dc\u05d5\u05ea $GABA$ \u05d5\u05d5\u05d9\u05e1\u05d5\u05ea \u05e9\u05e8\u05e9\u05e8\u05d0\u05d5\u05ea \u05d4\u05e2\u05d1\u05e8\u05ea \u05d0\u05d5\u05ea\u05d5\u05ea ($signal\\ transduction\\ cascades$) (StahlNeuro p.347)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05de\u05d9\u05e0\u05d5\u05df \u05d4\u05d4\u05ea\u05d7\u05dc\u05ea\u05d9 \u05d4\u05de\u05d5\u05de\u05dc\u05e5 \u05dc-Divalproex sodium \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d5\u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd?",
      "back": "$15~mg/kg/day$ \u05d4\u05de\u05d7\u05d5\u05dc\u05e7\u05d9\u05dd \u05dc-2-3 \u05de\u05e0\u05d5\u05ea \u05d1\u05d9\u05d5\u05dd (Dulcan p.770)."
    },
    {
      "front": "\u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05dc-$Hepatotoxicity$ \u05e7\u05d8\u05dc\u05e0\u05d9\u05ea \u05ea\u05d7\u05ea \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Valproate \u05d4\u05d5\u05d0 \u05d4\u05d2\u05d1\u05d5\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05de\u05ea\u05d7\u05ea \u05dc\u05d2\u05d9\u05dc _____ (StahlKids p.473).",
      "back": "\u05e9\u05e0\u05ea\u05d9\u05d9\u05dd (2)"
    },
    {
      "front": "\u05de\u05d4\u05dd \u05ea\u05e1\u05de\u05d9\u05e0\u05d9 \u05d4-$PCOS$ (Polycystic Ovary Syndrome) \u05e9\u05d9\u05e9 \u05dc\u05e0\u05d8\u05e8 \u05d1\u05e0\u05e9\u05d9\u05dd \u05e6\u05e2\u05d9\u05e8\u05d5\u05ea \u05d4\u05e0\u05d5\u05d8\u05dc\u05d5\u05ea Valproate?",
      "back": "\u05d0\u05dc-\u05d5\u05d5\u05e1\u05ea ($Amenorrhea$), \u05e9\u05d9\u05e2\u05d5\u05e8 \u05d9\u05ea\u05e8 ($Hirsutism$), \u05d0\u05e7\u05e0\u05d4 ($Acne$) \u05d5\u05d4\u05e9\u05de\u05e0\u05d4 (Dulcan p.769)."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05de\u05ea\u05d1\u05d8\u05d0\u05ea $Hyperammonemia$ \u05d4\u05e0\u05d2\u05e8\u05de\u05ea \u05de-Valproate \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d5\u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd?",
      "back": "$Lethargy$, \u05d3\u05d9\u05e1\u05d0\u05d5\u05e8\u05d9\u05d9\u05e0\u05d8\u05e6\u05d9\u05d4, \u05d5\u05d9\u05e8\u05d9\u05d3\u05d4 \u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9\u05ea \u05d4\u05e4\u05d9\u05db\u05d4 \u05e9\u05e2\u05dc\u05d5\u05dc\u05d4 \u05dc\u05d4\u05d9\u05d3\u05e8\u05d3\u05e8 \u05dc-$Coma$ (Dulcan p.769)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05e0\u05d9\u05d8\u05d5\u05e8 \u05d4\u05de\u05e2\u05d1\u05d3\u05ea\u05d9 \u05d4\u05e9\u05d2\u05e8\u05ea\u05d9 \u05d4\u05e0\u05d3\u05e8\u05e9 \u05d0\u05d7\u05ea \u05dc-6 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05d1\u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd \u05d4\u05e0\u05d5\u05d8\u05dc\u05d9\u05dd Valproate?",
      "back": "$CBC$ \u05e2\u05dd \u05e1\u05e4\u05d9\u05e8\u05ea \u05d8\u05e1\u05d9\u05d5\u05ea, \u05ea\u05e4\u05e7\u05d5\u05d3\u05d9 \u05db\u05d1\u05d3 ($LFTs$) \u05d5\u05e8\u05de\u05ea $Trough$ \u05e9\u05dc \u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 \u05d1\u05d3\u05dd (Dulcan p.769)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05d9\u05d9\u05d7\u05d5\u05d3\u05d9 \u05e9\u05dc Lamotrigine \u05d1\u05de\u05e2\u05e8\u05db\u05ea \u05d4-$Glutamate$ \u05d4\u05ea\u05d5\u05e8\u05dd \u05dc\u05d9\u05e2\u05d9\u05dc\u05d5\u05ea\u05d5 \u05d1\u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05d1\u05d9\u05e4\u05d5\u05dc\u05e8\u05d9?",
      "back": "\u05d4\u05e4\u05d7\u05ea\u05ea \u05d4\u05e9\u05d7\u05e8\u05d5\u05e8 \u05e9\u05dc \u05d4\u05de\u05d5\u05dc\u05d9\u05da \u05d4\u05e2\u05e6\u05d1\u05d9 \u05d4\u05de\u05e2\u05d5\u05e8\u05e8 $Glutamate$ (StahlNeuro p.351)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05d4\u05ea\u05d5\u05d5\u05d9\u05d4 \u05d4\u05de\u05d0\u05d5\u05e9\u05e8\u05ea \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d4-FDA \u05e2\u05d1\u05d5\u05e8 Lamotrigine \u05db-$Mood\\ Stabilizer$?",
      "back": "\u05d8\u05d9\u05e4\u05d5\u05dc \u05d0\u05d7\u05d6\u05e7\u05d4 ($Maintenance$) \u05dc\u05de\u05e0\u05d9\u05e2\u05ea \u05d4\u05d9\u05e9\u05e0\u05d5\u05ea \u05e9\u05dc \u05de\u05d0\u05e0\u05d9\u05d4 \u05d5\u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05d1-$Bipolar\\ I\\ Disorder$ (StahlNeuro p.350)."
    },
    {
      "front": "\u05de\u05d3\u05d5\u05e2 \u05d7\u05d5\u05d1\u05d4 \u05dc\u05d1\u05e6\u05e2 $Titration$ \u05d0\u05d9\u05d8\u05d9\u05ea \u05d1\u05de\u05d9\u05d5\u05d7\u05d3 \u05d1\u05e2\u05ea \u05ea\u05d7\u05d9\u05dc\u05ea \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Lamotrigine?",
      "back": "\u05db\u05d3\u05d9 \u05dc\u05d4\u05e4\u05d7\u05d9\u05ea \u05d0\u05ea \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05e4\u05e8\u05d9\u05d7\u05d5\u05ea \u05d7\u05de\u05d5\u05e8\u05d5\u05ea \u05d5\u05de\u05e1\u05db\u05e0\u05d5\u05ea \u05d7\u05d9\u05d9\u05dd \u05de\u05e1\u05d5\u05d2 $SJS$ \u05d0\u05d5 $TEN$ (StahlNeuro p.351)."
    },
    {
      "front": "\u05e9\u05d9\u05dc\u05d5\u05d1 \u05e9\u05dc Valproate \u05e2\u05dd Lamotrigine \u05de\u05e2\u05dc\u05d4 \u05e4\u05d9 _____ \u05d0\u05ea \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05dc-$SJS$, \u05d5\u05dc\u05db\u05df \u05de\u05d7\u05d9\u05d9\u05d1 \u05d4\u05e4\u05d7\u05ea\u05ea \u05de\u05d9\u05e0\u05d5\u05df \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea (Dulcan p.769).",
      "back": "\u05e9\u05dc\u05d5\u05e9 (3)"
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4-_____ \u05e9\u05e0\u05d5\u05db\u05d7\u05d5\u05ea\u05d5 \u05d1\u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd \u05de\u05de\u05d5\u05e6\u05d0 \u05d0\u05e1\u05d9\u05d9\u05ea\u05d9 \u05de\u05d4\u05d5\u05d5\u05d4 \u05d2\u05d5\u05e8\u05dd \u05e1\u05d9\u05db\u05d5\u05df \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9 \u05dc-$SJS$ \u05ea\u05d7\u05ea Carbamazepine?",
      "back": "$HLA-B*1502$ allele (Dulcan p.783)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05ea\u05d5\u05e4\u05e2\u05d4 \u05d4\u05e4\u05e8\u05de\u05e7\u05d5\u05e7\u05d9\u05e0\u05d8\u05d9\u05ea \u05e9\u05d1\u05d4 Carbamazepine \u05de\u05d0\u05d9\u05e6\u05d4 \u05d0\u05ea \u05d4\u05de\u05d8\u05d1\u05d5\u05dc\u05d9\u05d6\u05dd \u05e9\u05dc \u05e2\u05e6\u05de\u05d4?",
      "back": "\u05d0\u05d9\u05e0\u05d3\u05d5\u05e7\u05e6\u05d9\u05d4 \u05e2\u05e6\u05de\u05d9\u05ea ($Auto-induction$) \u05e9\u05dc \u05d0\u05e0\u05d6\u05d9\u05de\u05d9 $CYP450$ (Dulcan p.770)."
    },
    {
      "front": "\u05d0\u05d9\u05d6\u05d5 \u05ea\u05d5\u05e4\u05e2\u05ea \u05dc\u05d5\u05d5\u05d0\u05d9 \u05d0\u05dc\u05e7\u05d8\u05e8\u05d5\u05dc\u05d9\u05d8\u05e8\u05d9\u05ea \u05e9\u05db\u05d9\u05d7\u05d4 \u05d9\u05d5\u05ea\u05e8 \u05d1\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1-Oxcarbazepine \u05d1\u05d4\u05e9\u05d5\u05d5\u05d0\u05d4 \u05dc-Carbamazepine?",
      "back": "\u05d4\u05d9\u05e4\u05d5\u05e0\u05ea\u05e8\u05de\u05d9\u05d4 ($Hyponatremia$) \u05de\u05e9\u05e0\u05d9\u05ea \u05dc-$SIADH$ (Dulcan p.783)."
    },
    {
      "front": "\u05e2\u05d1\u05d5\u05e8 \u05d0\u05d9\u05dc\u05d5 \u05de\u05e6\u05d1\u05d9\u05dd \u05d1-$Bipolar\\ Disorder$ \u05de\u05d0\u05d5\u05e9\u05e8 Lithium \u05dc\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05de\u05d2\u05d9\u05dc 7 \u05d5\u05de\u05e2\u05dc\u05d4?",
      "back": "\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05d0\u05e4\u05d9\u05d6\u05d5\u05d3\u05d5\u05ea \u05de\u05d0\u05e0\u05d9\u05d5\u05ea \u05d0\u05d5 \u05de\u05e2\u05d5\u05e8\u05d1\u05d5\u05ea ($Acute\\ Manic/Mixed$) \u05d5\u05d8\u05d9\u05e4\u05d5\u05dc \u05d0\u05d7\u05d6\u05e7\u05d4 (Dulcan p.763)."
    },
    {
      "front": "\u05de\u05d4\u05dd \u05d1\u05d3\u05d9\u05e7\u05d5\u05ea \u05d4\u05de\u05e2\u05d1\u05d3\u05d4 \u05d4\u05e0\u05d3\u05e8\u05e9\u05d5\u05ea \u05db-$Baseline$ \u05dc\u05e4\u05e0\u05d9 \u05ea\u05d7\u05d9\u05dc\u05ea \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Lithium?",
      "back": "\u05ea\u05e4\u05e7\u05d5\u05d3\u05d9 \u05db\u05dc\u05d9\u05d4 ($Creatinine$), \u05ea\u05e4\u05e7\u05d5\u05d3\u05d9 \u05ea\u05e8\u05d9\u05e1 ($TSH$), \u05d0\u05dc\u05e7\u05d8\u05e8\u05d5\u05dc\u05d9\u05d8\u05d9\u05dd, $CBC$, $ECG$ \u05d5\u05d1\u05d3\u05d9\u05e7\u05ea \u05d4\u05d9\u05e8\u05d9\u05d5\u05df (StahlKids p.295)."
    },
    {
      "front": "\u05de\u05d4\u05dd \u05d4\u05e1\u05d9\u05de\u05e0\u05d9\u05dd \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9\u05d9\u05dd \u05d4\u05de\u05d5\u05e7\u05d3\u05de\u05d9\u05dd \u05dc-$Lithium\\ Toxicity$ \u05db\u05d0\u05e9\u05e8 \u05d4\u05e8\u05de\u05d4 \u05d1\u05d3\u05dd \u05e2\u05d5\u05dc\u05d4 \u05de\u05e2\u05dc \u05dc\u05d8\u05d5\u05d5\u05d7 \u05d4\u05ea\u05e8\u05e4\u05d5\u05d9\u05d8\u05d9?",
      "back": "$Nausea$, $Vomiting$, \u05d3\u05d9\u05d1\u05d5\u05e8 \u05de\u05d8\u05d5\u05e9\u05d8\u05e9 ($Slurred\\ speech$) \u05d5\u05d7\u05d5\u05e1\u05e8 \u05e7\u05d5\u05d0\u05d5\u05e8\u05d3\u05d9\u05e0\u05e6\u05d9\u05d4 (Dulcan p.763)."
    },
    {
      "front": "\u05de\u05d4 \u05d4\u05d9\u05d9\u05ea\u05d4 \u05d4\u05de\u05d8\u05e8\u05d4 \u05d4\u05de\u05e8\u05db\u05d6\u05d9\u05ea \u05d1\u05d4\u05db\u05e0\u05e1\u05ea \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc $DMDD$ \u05dc-DSM-5 \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd?",
      "back": "\u05de\u05ea\u05df \u05de\u05e2\u05e0\u05d4 \u05d0\u05d1\u05d7\u05e0\u05ea\u05d9 \u05dc\u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd \u05e8\u05d2\u05d6\u05e0\u05d5\u05ea \u05db\u05e8\u05d5\u05e0\u05d9\u05ea \u05d5\u05e6\u05de\u05e6\u05d5\u05dd \u05d0\u05d1\u05d7\u05d5\u05df \u05d9\u05ea\u05e8 \u05e9\u05dc $Bipolar\\ Disorder$ (Dulcan p.687)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05d1\u05de\u05ea\u05df $Antidepressants$ \u05dc\u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd \u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4 \u05de\u05e9\u05e4\u05d7\u05ea\u05d9\u05ea \u05e9\u05dc $Bipolar\\ Disorder$?",
      "back": "\u05d4\u05e9\u05e8\u05d0\u05d4 \u05e9\u05dc $Manic/Hypomanic\\ episode$ (\u05d4\u05de\u05db\u05d5\u05e0\u05d4 \"switching\") \u05d0\u05d5 $Activation$ (Dulcan p.689)."
    }
  ]
}