{
  "title": "Psychopharmacology Quiz",
  "questions": [
    {
      "question": "\u05de\u05ea\u05d1\u05d2\u05e8\u05ea \u05d1\u05ea 17 \u05d4\u05de\u05d8\u05d5\u05e4\u05dc\u05ea \u05d1-Valproate \u05d1\u05e9\u05dc Bipolar I Disorder \u05de\u05e6\u05d9\u05d2\u05d4 \u05d0\u05e4\u05d9\u05d6\u05d5\u05d3\u05d4 \u05d3\u05db\u05d0\u05d5\u05e0\u05d9\u05ea \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea. \u05d4\u05d5\u05d7\u05dc\u05d8 \u05dc\u05d4\u05d5\u05e1\u05d9\u05e3 Lamotrigine \u05db\u05d8\u05d9\u05e4\u05d5\u05dc \u05de\u05e9\u05dc\u05d9\u05dd. \u05d1\u05d4\u05ea\u05d7\u05e9\u05d1 \u05d1\u05d0\u05d9\u05e0\u05d8\u05e8\u05d0\u05e7\u05e6\u05d9\u05d4 \u05d4\u05e4\u05e8\u05de\u05e7\u05d5\u05e7\u05d9\u05e0\u05d8\u05d9\u05ea \u05d1\u05d9\u05df \u05d4\u05e9\u05ea\u05d9\u05d9\u05dd, \u05de\u05d4\u05d9 \u05d0\u05e1\u05d8\u05e8\u05d8\u05d2\u05d9\u05d9\u05ea \u05d4\u05de\u05d9\u05e0\u05d5\u05df \u05d4\u05e0\u05db\u05d5\u05e0\u05d4 \u05dc\u05ea\u05d7\u05d9\u05dc\u05ea \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc?",
      "answerOptions": [
        {
          "text": "\u05de\u05ea\u05df \u05de\u05d9\u05e0\u05d5\u05df \u05d4\u05ea\u05d7\u05dc\u05ea\u05d9 \u05e9\u05dc $25\\ mg$ \u05d9\u05d5\u05dd \u05db\u05df \u05d9\u05d5\u05dd \u05dc\u05d0 \u05dc\u05de\u05e9\u05da \u05e9\u05d1\u05d5\u05e2\u05d9\u05d9\u05dd.",
          "isCorrect": true,
          "rationale": "\u05d4\u05e9\u05d9\u05dc\u05d5\u05d1 \u05e2\u05dd Valproate \u05de\u05e2\u05db\u05d1 \u05d0\u05ea \u05d4\u05de\u05d8\u05d1\u05d5\u05dc\u05d9\u05d6\u05dd \u05e9\u05dc Lamotrigine \u05d5\u05de\u05db\u05e4\u05d9\u05dc \u05d0\u05ea \u05e8\u05de\u05ea\u05d4 \u05d1\u05d3\u05dd, \u05dc\u05db\u05df \u05d9\u05e9 \u05dc\u05d4\u05e9\u05ea\u05de\u05e9 \u05d1\u05d7\u05e6\u05d9 \u05de\u05d4\u05de\u05d9\u05e0\u05d5\u05df \u05d4\u05e8\u05d2\u05d9\u05dc \u05d5\u05d1\u05d8\u05d9\u05d8\u05e8\u05e6\u05d9\u05d4 \u05d0\u05d9\u05d8\u05d9\u05ea \u05de\u05d0\u05d5\u05d3 \u05dc\u05de\u05e0\u05d9\u05e2\u05ea SJS (StahlKids p.774-775)."
        },
        {
          "text": "\u05d4\u05ea\u05d7\u05dc\u05d4 \u05d1\u05de\u05d9\u05e0\u05d5\u05df \u05e1\u05d8\u05e0\u05d3\u05e8\u05d8\u05d9 \u05e9\u05dc $25\\ mg$ \u05dc\u05d9\u05d5\u05dd \u05dc\u05de\u05e9\u05da \u05e9\u05d1\u05d5\u05e2\u05d9\u05d9\u05dd.",
          "isCorrect": false,
          "rationale": "\u05d6\u05d4\u05d5 \u05d4\u05de\u05d9\u05e0\u05d5\u05df \u05d4\u05de\u05d5\u05de\u05dc\u05e5 \u05dc\u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd \u05e9\u05d0\u05d9\u05e0\u05dd \u05e0\u05d5\u05d8\u05dc\u05d9\u05dd Valproate; \u05d1\u05e0\u05d5\u05db\u05d7\u05d5\u05ea Valproate, \u05de\u05d9\u05e0\u05d5\u05df \u05d6\u05d4 \u05de\u05e2\u05dc\u05d4 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05d0\u05ea \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05ea\u05e4\u05e8\u05d7\u05ea \u05de\u05e1\u05db\u05e0\u05ea \u05d7\u05d9\u05d9\u05dd (StahlKids p.775)."
        },
        {
          "text": "\u05d4\u05ea\u05d7\u05dc\u05d4 \u05d1\u05de\u05d9\u05e0\u05d5\u05df \u05e9\u05dc $50\\ mg$ \u05dc\u05d9\u05d5\u05dd \u05db\u05d3\u05d9 \u05dc\u05d4\u05d2\u05d9\u05e2 \u05dc\u05d0\u05e4\u05e7\u05d8 \u05d0\u05e0\u05d8\u05d9-\u05d3\u05db\u05d0\u05d5\u05e0\u05d9 \u05de\u05d4\u05d9\u05e8.",
          "isCorrect": false,
          "rationale": "\u05d8\u05d9\u05d8\u05e8\u05e6\u05d9\u05d4 \u05de\u05d4\u05d9\u05e8\u05d4 \u05de\u05d3\u05d9 \u05e9\u05dc Lamotrigine, \u05d1\u05de\u05d9\u05d5\u05d7\u05d3 \u05d1\u05e9\u05d9\u05dc\u05d5\u05d1 \u05e2\u05dd Valproate, \u05e7\u05e9\u05d5\u05e8\u05d4 \u05dc\u05e2\u05dc\u05d9\u05d9\u05d4 \u05e9\u05dc \u05e4\u05d9 3 \u05d1\u05e1\u05d9\u05db\u05d5\u05df \u05dc-SJS \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d5\u05e0\u05d5\u05e2\u05e8 (StahlKids p.774)."
        },
        {
          "text": "\u05d0\u05d9\u05df \u05e6\u05d5\u05e8\u05da \u05d1\u05d4\u05ea\u05d0\u05de\u05ea \u05de\u05d9\u05e0\u05d5\u05df \u05de\u05d9\u05d5\u05d7\u05d3\u05ea, \u05d0\u05da \u05d9\u05e9 \u05dc\u05e0\u05d8\u05e8 \u05e8\u05de\u05d5\u05ea Valproate \u05d1\u05d3\u05dd.",
          "isCorrect": false,
          "rationale": "\u05d4\u05d0\u05d9\u05e0\u05d8\u05e8\u05d0\u05e7\u05e6\u05d9\u05d4 \u05d4\u05e7\u05e8\u05d9\u05d8\u05d9\u05ea \u05d4\u05d9\u05d0 \u05d4\u05e9\u05e4\u05e2\u05ea Valproate \u05e2\u05dc Lamotrigine \u05d3\u05e8\u05da \u05e2\u05d9\u05db\u05d5\u05d1 \u05d2\u05dc\u05d5\u05e7\u05d5\u05e8\u05d5\u05e0\u05d9\u05d3\u05e6\u05d9\u05d4, \u05de\u05d4 \u05e9\u05de\u05d7\u05d9\u05d9\u05d1 \u05d4\u05e4\u05d7\u05ea\u05ea \u05de\u05d9\u05e0\u05d5\u05df \u05d4-Lamotrigine (StahlNeuro p.352)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05e9\u05e4\u05e2\u05ea \u05d4-Valproate \u05e2\u05dc \u05ea\u05d4\u05dc\u05d9\u05da \u05d4-Glucuronidation \u05e9\u05dc \u05d4-Lamotrigine."
    },
    {
      "question": "\u05de\u05d8\u05d5\u05e4\u05dc \u05d1\u05df 15 \u05de\u05de\u05d5\u05e6\u05d0 \u05d0\u05e1\u05d9\u05d0\u05ea\u05d9 \u05de\u05d9\u05d5\u05e2\u05d3 \u05dc\u05d4\u05ea\u05d7\u05dc\u05ea \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Carbamazepine \u05d1\u05e9\u05dc \u05d0\u05e4\u05d9\u05d6\u05d5\u05d3\u05d4 \u05de\u05d0\u05e0\u05d9\u05ea \u05e9\u05d0\u05d9\u05e0\u05d4 \u05de\u05d2\u05d9\u05d1\u05d4 \u05dc-Lithium. \u05e2\u05dc \u05e4\u05d9 \u05d4-FDA \u05d5\u05d4\u05e0\u05d7\u05d9\u05d5\u05ea \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05de\u05e7\u05d5\u05d1\u05dc\u05d5\u05ea, \u05d0\u05d9\u05d6\u05d5 \u05d1\u05d3\u05d9\u05e7\u05d4 \u05d4\u05d9\u05d0 \u05d4\u05e7\u05e8\u05d9\u05d8\u05d9\u05ea \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d8\u05e8\u05dd \u05ea\u05d7\u05d9\u05dc\u05ea \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc?",
      "answerOptions": [
        {
          "text": "\u05d1\u05d3\u05d9\u05e7\u05ea \u05d2\u05e0\u05d5\u05d8\u05d9\u05e4 \u05dc\u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05d4\u05d0\u05dc\u05dc $HLA-B*1502$.",
          "isCorrect": true,
          "rationale": "\u05d1\u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd \u05de\u05de\u05d5\u05e6\u05d0 \u05d0\u05e1\u05d9\u05d0\u05ea\u05d9 \u05e7\u05d9\u05d9\u05dd \u05e7\u05e9\u05e8 \u05d7\u05d6\u05e7 \u05d1\u05d9\u05df \u05d0\u05dc\u05dc \u05d6\u05d4 \u05dc\u05d1\u05d9\u05df \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea \u05ea\u05e1\u05de\u05d5\u05e0\u05d5\u05ea \u05e2\u05d5\u05e8\u05d9\u05d5\u05ea \u05e7\u05d8\u05dc\u05e0\u05d9\u05d5\u05ea \u05db\u05de\u05d5 SJS \u05d5-TEN \u05ea\u05d7\u05ea \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Carbamazepine (StahlKids p.771)."
        },
        {
          "text": "\u05d1\u05d3\u05d9\u05e7\u05ea \u05ea\u05e4\u05e7\u05d5\u05d3\u05d9 \u05db\u05d1\u05d3 (LFTs) \u05d1\u05dc\u05d1\u05d3.",
          "isCorrect": false,
          "rationale": "\u05d0\u05e3 \u05e9\u05ea\u05e4\u05e7\u05d5\u05d3\u05d9 \u05db\u05d1\u05d3 \u05d7\u05e9\u05d5\u05d1\u05d9\u05dd, \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05d4\u05d0\u05d9\u05de\u05d5\u05e0\u05d5-\u05d2\u05e0\u05d8\u05d9 \u05dc\u05ea\u05d2\u05d5\u05d1\u05d4 \u05e2\u05d5\u05e8\u05d9\u05ea \u05e7\u05d8\u05dc\u05e0\u05d9\u05ea \u05d1\u05d0\u05d5\u05db\u05dc\u05d5\u05e1\u05d9\u05d9\u05d4 \u05d6\u05d5 \u05d4\u05d5\u05d0 \u05d1\u05e2\u05dc \u05e2\u05d3\u05d9\u05e4\u05d5\u05ea \u05e2\u05dc\u05d9\u05d5\u05e0\u05d4 \u05dc\u05e1\u05d9\u05e0\u05d5\u05df (StahlKids p.771)."
        },
        {
          "text": "\u05d1\u05d3\u05d9\u05e7\u05ea \u05e8\u05de\u05ea Na \u05d1\u05e0\u05e1\u05d9\u05d5\u05d1 \u05dc\u05de\u05e0\u05d9\u05e2\u05ea SIADH.",
          "isCorrect": false,
          "rationale": "\u05d4\u05d9\u05e4\u05d5\u05e0\u05ea\u05e8\u05de\u05d9\u05d4 \u05d4\u05d9\u05d0 \u05ea\u05d5\u05e4\u05e2\u05ea \u05dc\u05d5\u05d5\u05d0\u05d9 \u05d0\u05e4\u05e9\u05e8\u05d9\u05ea, \u05d0\u05da \u05d4\u05d9\u05d0 \u05e9\u05db\u05d9\u05d7\u05d4 \u05d9\u05d5\u05ea\u05e8 \u05d1-Oxcarbazepine \u05d5\u05d0\u05d9\u05e0\u05d4 \u05de\u05d4\u05d5\u05d5\u05d4 \u05d4\u05ea\u05d5\u05d5\u05d9\u05d9\u05ea \u05e0\u05d2\u05d3 \u05d2\u05e0\u05d8\u05d9\u05ea \u05de\u05d5\u05d7\u05dc\u05d8\u05ea \u05db\u05de\u05d5 \u05d4-HLA (StahlKids p.771-772)."
        },
