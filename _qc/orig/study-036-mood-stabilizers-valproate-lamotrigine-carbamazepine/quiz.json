      ],
      "hint": "\u05d4\u05ea\u05de\u05e7\u05d3 \u05d1\u05e1\u05d9\u05db\u05d5\u05e0\u05d9\u05dd \u05e2\u05d5\u05e8\u05d9\u05d9\u05dd \u05d7\u05de\u05d5\u05e8\u05d9\u05dd \u05d4\u05e7\u05e9\u05d5\u05e8\u05d9\u05dd \u05dc\u05e8\u05e7\u05e2 \u05d0\u05ea\u05e0\u05d9 \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9."
    },
    {
      "question": "\u05de\u05d8\u05d5\u05e4\u05dc \u05d1\u05df 10 \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05d1-Carbamazepine \u05de\u05d6\u05d4 \u05d7\u05d5\u05d3\u05e9 \u05d5\u05d7\u05e6\u05d9 \u05de\u05e6\u05d9\u05d2 \u05d9\u05e8\u05d9\u05d3\u05d4 \u05d1\u05d9\u05e2\u05d9\u05dc\u05d5\u05ea \u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 \u05dc\u05de\u05e8\u05d5\u05ea \u05d4\u05d9\u05e2\u05e0\u05d5\u05ea \u05de\u05dc\u05d0\u05d4. \u05d4\u05e8\u05d5\u05e4\u05d0 \u05d4\u05de\u05d8\u05e4\u05dc \u05de\u05e1\u05d1\u05d9\u05e8 \u05dc\u05d4\u05d5\u05e8\u05d9\u05dd \u05db\u05d9 \u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 \u05d2\u05d5\u05e8\u05de\u05ea \u05dc-Auto-induction. \u05de\u05d4\u05d9 \u05d4\u05de\u05e9\u05de\u05e2\u05d5\u05ea \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05e9\u05dc \u05ea\u05d5\u05e4\u05e2\u05d4 \u05d6\u05d5?",
      "answerOptions": [
        {
          "text": "\u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 \u05de\u05d0\u05d9\u05e6\u05d4 \u05d0\u05ea \u05d4\u05de\u05d8\u05d1\u05d5\u05dc\u05d9\u05d6\u05dd \u05e9\u05dc \u05e2\u05e6\u05de\u05d4 \u05d3\u05e8\u05da \u05de\u05e2\u05e8\u05db\u05ea \u05d4-CYP3A4, \u05de\u05d4 \u05e9\u05de\u05d5\u05e8\u05d9\u05d3 \u05d0\u05ea \u05e8\u05de\u05ea\u05d4 \u05d1\u05d3\u05dd.",
          "isCorrect": true,
          "rationale": "\u05ea\u05d4\u05dc\u05d9\u05da \u05d4-Auto-induction \u05de\u05d5\u05e9\u05dc\u05dd \u05ea\u05d5\u05da 3-5 \u05e9\u05d1\u05d5\u05e2\u05d5\u05ea \u05dc\u05d0\u05d7\u05e8 \u05d4\u05d2\u05e2\u05d4 \u05dc\u05de\u05d9\u05e0\u05d5\u05df \u05e7\u05d1\u05d5\u05e2 \u05d5\u05dc\u05e2\u05d9\u05ea\u05d9\u05dd \u05de\u05d7\u05d9\u05d9\u05d1 \u05d4\u05e2\u05dc\u05d0\u05ea \u05de\u05d9\u05e0\u05d5\u05df \u05db\u05d3\u05d9 \u05dc\u05e9\u05de\u05d5\u05e8 \u05e2\u05dc \u05e8\u05de\u05d4 \u05ea\u05e8\u05e4\u05d5\u05d9\u05d8\u05d9\u05ea (StahlKids p.771)."
        },
        {
          "text": "\u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 \u05de\u05e2\u05db\u05d1\u05ea \u05d0\u05ea \u05d4\u05e4\u05d9\u05e0\u05d5\u05d9 \u05d4\u05db\u05dc\u05d9\u05d9\u05ea\u05d9 \u05e9\u05dc Lithium, \u05de\u05d4 \u05e9\u05d2\u05d5\u05e8\u05dd \u05dc\u05e8\u05e2\u05d9\u05dc\u05d5\u05ea.",
          "isCorrect": false,
          "rationale": "\u05d0\u05e3 \u05e9-Carbamazepine \u05de\u05e9\u05e4\u05d9\u05e2\u05d4 \u05e2\u05dc \u05e4\u05d9\u05e0\u05d5\u05d9 Lithium, \u05d0\u05d9\u05df \u05d6\u05d5 \u05d4\u05de\u05e9\u05de\u05e2\u05d5\u05ea \u05e9\u05dc \u05d4\u05de\u05d5\u05e9\u05d2 Auto-induction (StahlKids p.772)."
        },
        {
          "text": "\u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 \u05d2\u05d5\u05e8\u05de\u05ea \u05dc\u05d9\u05e8\u05d9\u05d3\u05d4 \u05d6\u05de\u05e0\u05d9\u05ea \u05d1\u05e1\u05e4\u05d9\u05e8\u05ea \u05d4\u05db\u05d3\u05d5\u05e8\u05d9\u05d5\u05ea \u05d4\u05dc\u05d1\u05e0\u05d5\u05ea.",
          "isCorrect": false,
          "rationale": "\u05d3\u05d9\u05db\u05d5\u05d9 \u05de\u05d7 \u05e2\u05e6\u05dd \u05d4\u05d5\u05d0 \u05ea\u05d5\u05e4\u05e2\u05ea \u05dc\u05d5\u05d5\u05d0\u05d9 \u05d9\u05d3\u05d5\u05e2\u05d4, \u05d0\u05da \u05d4\u05d5\u05d0 \u05d0\u05d9\u05e0\u05d5 \u05e7\u05e9\u05d5\u05e8 \u05dc\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05d0\u05d9\u05e0\u05d3\u05d5\u05e7\u05e6\u05d9\u05d4 \u05d4\u05d0\u05e0\u05d6\u05d9\u05de\u05d8\u05d9\u05ea \u05d4\u05e2\u05e6\u05de\u05d9\u05ea (StahlNeuro p.350)."
        },
        {
          "text": "\u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 \u05de\u05d2\u05d1\u05d9\u05e8\u05d4 \u05d0\u05ea \u05d4\u05e8\u05d2\u05d9\u05e9\u05d5\u05ea \u05e9\u05dc \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 \u05d4-GABA \u05d1\u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05dc\u05d9\u05de\u05d1\u05d9\u05ea.",
          "isCorrect": false,
          "rationale": "\u05d6\u05d4\u05d5 \u05d7\u05dc\u05e7 \u05de\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05e4\u05e2\u05d5\u05dc\u05d4 \u05d4\u05de\u05e9\u05d5\u05e2\u05e8, \u05d0\u05da \u05d4\u05de\u05d5\u05e9\u05d2 Auto-induction \u05de\u05ea\u05d9\u05d9\u05d7\u05e1 \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05ea \u05dc\u05e4\u05d9\u05e8\u05d5\u05e7 \u05d4\u05de\u05d8\u05d1\u05d5\u05dc\u05d9 \u05e9\u05dc \u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 \u05d1\u05db\u05d1\u05d3 (StahlNeuro p.350)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05d0\u05d5\u05e4\u05df \u05e9\u05d1\u05d5 \u05d4\u05db\u05d1\u05d3 \u05de\u05d2\u05d9\u05d1 \u05dc\u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 \u05dc\u05d0\u05d5\u05e8\u05da \u05d6\u05de\u05df."
    },
    {
      "question": "\u05de\u05d4\u05d5 \u05d4\u05d4\u05e1\u05d1\u05e8 \u05d4\u05e4\u05e8\u05de\u05e7\u05d5\u05e7\u05d9\u05e0\u05d8\u05d9 \u05d4\u05e2\u05d9\u05e7\u05e8\u05d9 \u05dc\u05db\u05da \u05e9\u05d9\u05dc\u05d3\u05d9\u05dd (Prepubescent) \u05d6\u05e7\u05d5\u05e7\u05d9\u05dd \u05dc\u05e2\u05d9\u05ea\u05d9\u05dd \u05e7\u05e8\u05d5\u05d1\u05d5\u05ea \u05dc\u05de\u05d9\u05e0\u05d5\u05df \u05d2\u05d1\u05d5\u05d4 \u05d9\u05d5\u05ea\u05e8 \u05e9\u05dc Valproate \u05dc\u05d9\u05d7\u05d9\u05d3\u05ea \u05de\u05e9\u05e7\u05dc ($mg/kg$) \u05d1\u05d4\u05e9\u05d5\u05d5\u05d0\u05d4 \u05dc\u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd?",
      "answerOptions": [
        {
          "text": "\u05dc\u05d9\u05dc\u05d3\u05d9\u05dd \u05d9\u05e9 \u05de\u05e1\u05ea \u05db\u05d1\u05d3 \u05d2\u05d3\u05d5\u05dc\u05d4 \u05d9\u05d5\u05ea\u05e8 \u05d1\u05d9\u05d7\u05e1 \u05dc\u05de\u05e9\u05e7\u05dc \u05d2\u05d5\u05e4\u05dd, \u05de\u05d4 \u05e9\u05de\u05d5\u05d1\u05d9\u05dc \u05dc\u05de\u05d8\u05d1\u05d5\u05dc\u05d9\u05d6\u05dd \u05d4\u05e4\u05d8\u05d9 \u05de\u05d4\u05d9\u05e8 \u05d9\u05d5\u05ea\u05e8.",
          "isCorrect": true,
          "rationale": "\u05d1\u05d9\u05dc\u05d3\u05d9\u05dd, \u05d4\u05de\u05d8\u05d1\u05d5\u05dc\u05d9\u05d6\u05dd \u05d4\u05db\u05d1\u05d3\u05d9 \u05d5\u05d4\u05e4\u05d9\u05e0\u05d5\u05d9 \u05d4\u05db\u05dc\u05d9\u05d9\u05ea\u05d9 \u05de\u05d4\u05d9\u05e8\u05d9\u05dd \u05d9\u05d5\u05ea\u05e8, \u05d5\u05dc\u05db\u05df \u05d4\u05dd \u05d6\u05e7\u05d5\u05e7\u05d9\u05dd \u05dc\u05de\u05d9\u05e0\u05d5\u05e0\u05d9\u05dd \u05d2\u05d1\u05d5\u05d4\u05d9\u05dd \u05d9\u05d5\u05ea\u05e8 \u05db\u05d3\u05d9 \u05dc\u05d4\u05d2\u05d9\u05e2 \u05dc\u05e8\u05de\u05d5\u05ea \u05d9\u05e6\u05d9\u05d1\u05d5\u05ea \u05d1\u05d3\u05dd (Dulcan p.693, StahlKids p.468)."
        },
        {
          "text": "\u05dc\u05d9\u05dc\u05d3\u05d9\u05dd \u05d9\u05e9 \u05d0\u05d7\u05d5\u05d6 \u05e9\u05d5\u05de\u05df \u05d2\u05d1\u05d5\u05d4 \u05d9\u05d5\u05ea\u05e8 \u05d4\u05de\u05d0\u05d7\u05e1\u05df \u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05dc\u05d9\u05e4\u05d5\u05e4\u05d9\u05dc\u05d9\u05d5\u05ea.",
          "isCorrect": false,
          "rationale": "\u05dc\u05d4\u05e4\u05da, \u05dc\u05d9\u05dc\u05d3\u05d9\u05dd \u05dc\u05e4\u05e0\u05d9 \u05d2\u05d9\u05dc \u05d4\u05d4\u05ea\u05d1\u05d2\u05e8\u05d5\u05ea \u05d9\u05e9 \u05dc\u05e8\u05d5\u05d1 \u05e4\u05d7\u05d5\u05ea \u05e8\u05e7\u05de\u05ea \u05e9\u05d5\u05de\u05df \u05d5\u05d9\u05d5\u05ea\u05e8 \u05de\u05d9\u05dd \u05d1\u05d2\u05d5\u05e3 \u05d1\u05d4\u05e9\u05d5\u05d5\u05d0\u05d4 \u05dc\u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd (Dulcan p.693, StahlKids p.285)."
        },
        {
          "text": "\u05d4\u05e1\u05e4\u05d9\u05d2\u05d4 \u05d1\u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05e2\u05d9\u05db\u05d5\u05dc \u05e9\u05dc \u05d9\u05dc\u05d3\u05d9\u05dd \u05d4\u05d9\u05d0 \u05e4\u05d7\u05d5\u05ea \u05d9\u05e2\u05d9\u05dc\u05d4.",
          "isCorrect": false,
          "rationale": "\u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05e2\u05d9\u05db\u05d5\u05dc \u05de\u05d2\u05d9\u05e2\u05d4 \u05dc\u05d1\u05e9\u05dc\u05d5\u05ea \u05de\u05dc\u05d0\u05d4 \u05e1\u05d1\u05d9\u05d1 \u05d2\u05d9\u05dc 10-12, \u05d0\u05da \u05d4\u05e9\u05d9\u05e0\u05d5\u05d9 \u05d4\u05e2\u05d9\u05e7\u05e8\u05d9 \u05d1\u05e6\u05d5\u05e8\u05da \u05d1\u05de\u05d9\u05e0\u05d5\u05df \u05e0\u05d5\u05d1\u05e2 \u05de\u05d4\u05e4\u05d9\u05e0\u05d5\u05d9 (Elimination) \u05d5\u05dc\u05d0 \u05de\u05d4\u05e1\u05e4\u05d9\u05d2\u05d4 (Dulcan p.693)."
        },
        {
          "text": "\u05e8\u05de\u05ea \u05d4\u05d7\u05dc\u05d1\u05d5\u05e0\u05d9\u05dd \u05d4\u05e7\u05d5\u05e9\u05e8\u05d9\u05dd \u05ea\u05e8\u05d5\u05e4\u05d5\u05ea (Protein binding) \u05d2\u05d1\u05d5\u05d4\u05d4 \u05d9\u05d5\u05ea\u05e8 \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd.",
          "isCorrect": false,
          "rationale": "\u05d1\u05e4\u05d5\u05e2\u05dc, \u05dc\u05d9\u05dc\u05d3\u05d9\u05dd \u05d9\u05e9 \u05dc\u05e2\u05d9\u05ea\u05d9\u05dd \u05e4\u05d7\u05d5\u05ea \u05e7\u05d9\u05e9\u05d5\u05e8 \u05dc\u05d7\u05dc\u05d1\u05d5\u05e0\u05d9\u05dd, \u05de\u05d4 \u05e9\u05de\u05d5\u05ea\u05d9\u05e8 \u05d9\u05d5\u05ea\u05e8 \u05ea\u05e8\u05d5\u05e4\u05d4 \u05d7\u05d5\u05e4\u05e9\u05d9\u05ea \u05d5\u05e4\u05e2\u05d9\u05dc\u05d4, \u05d0\u05da \u05d4\u05de\u05d8\u05d1\u05d5\u05dc\u05d9\u05d6\u05dd \u05d4\u05de\u05d4\u05d9\u05e8 \u05d4\u05d5\u05d0 \u05d4\u05d2\u05d5\u05e8\u05dd \u05d4\u05de\u05db\u05e8\u05d9\u05e2 \u05dc\u05e6\u05d5\u05e8\u05da \u05d1\u05de\u05d9\u05e0\u05d5\u05df \u05d2\u05d1\u05d5\u05d4 (StahlKids p.285)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05d9\u05d7\u05e1 \u05d1\u05d9\u05df \u05d2\u05d5\u05d3\u05dc \u05d4\u05d0\u05d9\u05d1\u05e8\u05d9\u05dd \u05d4\u05de\u05d8\u05d1\u05d5\u05dc\u05d9\u05d9\u05dd \u05dc\u05d1\u05d9\u05df \u05de\u05e9\u05e7\u05dc \u05d4\u05d2\u05d5\u05e3 \u05d4\u05db\u05d5\u05dc\u05dc \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd."
    },
    {
      "question": "\u05e2\u05dc \u05e4\u05d9 \u05d4-StahlNeuro, \u05de\u05d4\u05d5 \u05d0\u05d7\u05d3 \u05de\u05de\u05e0\u05d2\u05e0\u05d5\u05e0\u05d9 \u05d4\u05e4\u05e2\u05d5\u05dc\u05d4 \u05d4\u05de\u05d5\u05dc\u05e7\u05d5\u05dc\u05e8\u05d9\u05d9\u05dd \u05d4\u05d9\u05d9\u05d7\u05d5\u05d3\u05d9\u05d9\u05dd \u05e9\u05dc Valproate \u05e9\u05e2\u05e9\u05d5\u05d9 \u05dc\u05d4\u05e1\u05d1\u05d9\u05e8 \u05d0\u05ea \u05d4\u05e9\u05e4\u05e2\u05d5\u05ea\u05d9\u05d5 \u05d0\u05e8\u05d5\u05db\u05d5\u05ea \u05d4\u05d8\u05d5\u05d5\u05d7 \u05db-Mood Stabilizer \u05de\u05e2\u05d1\u05e8 \u05dc\u05d7\u05e1\u05d9\u05de\u05ea \u05ea\u05e2\u05dc\u05d5\u05ea \u05e0\u05ea\u05e8\u05df?",
      "answerOptions": [
        {
          "text": "\u05e2\u05d9\u05db\u05d5\u05d1 \u05d4\u05d0\u05e0\u05d6\u05d9\u05dd $GSK-3$ (Glycogen Synthase Kinase 3) \u05d5\u05d5\u05d9\u05e1\u05d5\u05ea \u05de\u05e1\u05dc\u05d5\u05dc\u05d9 \u05d4\u05e2\u05d1\u05e8\u05ea \u05d0\u05d5\u05ea\u05d5\u05ea.",
          "isCorrect": true,
          "rationale": "Valproate \u05de\u05e9\u05e4\u05d9\u05e2 \u05e2\u05dc \u05de\u05e4\u05dc \u05d0\u05d5\u05ea\u05d5\u05ea \u05ea\u05d5\u05da-\u05ea\u05d0\u05d9 \u05d4\u05db\u05d5\u05dc\u05dc \u05e2\u05d9\u05db\u05d5\u05d1 $GSK-3$ \u05d5\u05d4\u05e4\u05e2\u05dc\u05ea \u05de\u05e1\u05dc\u05d5\u05dc\u05d9 \u05d4\u05d9\u05e9\u05e8\u05d3\u05d5\u05ea \u05ea\u05d0\u05d9\u05ea \u05db\u05de\u05d5 $ERK$, \u05de\u05d4 \u05e9\u05ea\u05d5\u05e8\u05dd \u05dc\u05e0\u05d5\u05d9\u05e8\u05d5-\u05e4\u05e8\u05d5\u05d8\u05e7\u05e6\u05d9\u05d4 (StahlNeuro p.349)."
        },
        {
          "text": "\u05d7\u05e1\u05d9\u05de\u05d4 \u05e1\u05dc\u05e7\u05d8\u05d9\u05d1\u05d9\u05ea \u05e9\u05dc \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 $5-HT2A$ \u05d1\u05e7\u05d5\u05e8\u05d8\u05e7\u05e1 \u05d4\u05e4\u05e8\u05d4-\u05e4\u05e8\u05d5\u05e0\u05d8\u05dc\u05d9.",
          "isCorrect": false,
          "rationale": "\u05d7\u05e1\u05d9\u05de\u05ea \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 $5-HT2A$ \u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05ea \u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05d0\u05e0\u05d8\u05d9-\u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9\u05d5\u05ea \u05dc\u05d0 \u05d8\u05d9\u05e4\u05d5\u05e1\u05d9\u05d5\u05ea (SGAs) \u05d5\u05dc\u05d0 \u05d0\u05ea \u05d4-Valproate (StahlNeuro p.113)."
        },
        {
          "text": "\u05d0\u05d2\u05d5\u05e0\u05d9\u05d6\u05dd \u05d9\u05e9\u05d9\u05e8 \u05dc\u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 $GABA-B$ \u05d1\u05de\u05d5\u05d7 \u05d4\u05d1\u05d9\u05e0\u05d9\u05d9\u05dd.",
          "isCorrect": false,
          "rationale": "Valproate \u05de\u05e2\u05dc\u05d4 \u05e8\u05de\u05d5\u05ea GABA \u05d1\u05d0\u05d5\u05e4\u05df \u05e2\u05e7\u05d9\u05e3 (\u05e2\u05d9\u05db\u05d5\u05d1 \u05e4\u05d9\u05e8\u05d5\u05e7 \u05d0\u05d5 \u05d4\u05d2\u05d1\u05e8\u05ea \u05e9\u05d7\u05e8\u05d5\u05e8), \u05d0\u05da \u05d0\u05d9\u05e0\u05d5 \u05e4\u05d5\u05e2\u05dc \u05db\u05d0\u05d2\u05d5\u05e0\u05d9\u05d6\u05dd \u05d9\u05e9\u05d9\u05e8 \u05dc\u05e7\u05d5\u05dc\u05d8\u05df $GABA-B$ (StahlNeuro p.348)."
        },
        {
          "text": "\u05d7\u05e1\u05d9\u05de\u05ea \u05ea\u05e2\u05dc\u05d5\u05ea \u05e1\u05d9\u05d3\u05df \u05de\u05e1\u05d5\u05d2 $L-type$ \u05d1\u05dc\u05d1\u05d3.",
          "isCorrect": false,
          "rationale": "\u05d0\u05e3 \u05e9\u05d9\u05d9\u05ea\u05db\u05df \u05e9-Valproate \u05de\u05e9\u05e4\u05d9\u05e2 \u05e2\u05dc \u05ea\u05e2\u05dc\u05d5\u05ea \u05e1\u05d9\u05d3\u05df, \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05e2\u05d9\u05e7\u05e8\u05d9 \u05d4\u05de\u05d9\u05d5\u05d7\u05e1 \u05dc\u05d5 \u05d4\u05d5\u05d0 \u05d4\u05e9\u05e4\u05e2\u05d4 \u05e2\u05dc \u05ea\u05e2\u05dc\u05d5\u05ea \u05e0\u05ea\u05e8\u05df ($VSSCs$) \u05d5\u05de\u05e2\u05e8\u05db\u05ea \u05d4-GABA (StahlNeuro p.347)."
        }
      ],
      "hint": "\u05d7\u05e4\u05e9 \u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05de\u05e9\u05e4\u05d9\u05e2 \u05e2\u05dc \u05d2\u05e0\u05d5\u05dd \u05d4\u05ea\u05d0 \u05d5\u05e2\u05dc \u05de\u05e1\u05dc\u05d5\u05dc\u05d9 \u05d4\u05d9\u05e9\u05e8\u05d3\u05d5\u05ea \u05ea\u05d0\u05d9\u05d9\u05dd."
    },
    {
      "question": "\u05de\u05ea\u05d1\u05d2\u05e8\u05ea \u05d1\u05ea 16 \u05d4\u05de\u05d8\u05d5\u05e4\u05dc\u05ea \u05d1-Valproate \u05de\u05d3\u05d5\u05d5\u05d7\u05ea \u05e2\u05dc \u05e2\u05dc\u05d9\u05d9\u05d4 \u05d1\u05de\u05e9\u05e7\u05dc, \u05d4\u05d5\u05e4\u05e2\u05ea \u05d0\u05e7\u05e0\u05d4 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9 \u05d5\u05de\u05d7\u05d6\u05d5\u05e8\u05d9\u05dd \u05dc\u05d0 \u05e1\u05d3\u05d9\u05e8\u05d9\u05dd (Oligomenorrhea). \u05de\u05d4\u05d5 \u05d4\u05e1\u05d9\u05d1\u05d5\u05da \u05d4\u05d0\u05e0\u05d3\u05d5\u05e7\u05e8\u05d9\u05e0\u05d9 \u05e9\u05d9\u05e9 \u05dc\u05d7\u05e9\u05d5\u05d3 \u05d1\u05d5?",
      "answerOptions": [
        {
          "text": "\u05ea\u05e1\u05de\u05d5\u05e0\u05ea \u05d4\u05e9\u05d7\u05dc\u05d5\u05ea \u05d4\u05e4\u05d5\u05dc\u05d9\u05e6\u05d9\u05e1\u05d8\u05d9\u05d5\u05ea (PCOS).",
          "isCorrect": true,
          "rationale": "\u05e7\u05d9\u05d9\u05dd \u05e7\u05e9\u05e8 \u05e9\u05e0\u05d5\u05d9 \u05d1\u05de\u05d7\u05dc\u05d5\u05e7\u05ea \u05d0\u05da \u05de\u05ea\u05d5\u05e2\u05d3 \u05d1\u05d9\u05df Valproate \u05dc\u05d1\u05d9\u05df \u05e1\u05d9\u05db\u05d5\u05df \u05de\u05d5\u05d2\u05d1\u05e8 \u05dc-PCOS \u05d1\u05e0\u05e9\u05d9\u05dd \u05e6\u05e2\u05d9\u05e8\u05d5\u05ea, \u05d4\u05de\u05ea\u05d1\u05d8\u05d0 \u05d1\u05e9\u05d9\u05e2\u05d5\u05e8 \u05d9\u05ea\u05e8, \u05d0\u05e7\u05e0\u05d4 \u05d5\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05d1\u05de\u05d7\u05d6\u05d5\u05e8 (StahlKids p.466, StahlNeuro p.350)."
        },
        {
          "text": "\u05d4\u05d9\u05e4\u05d5\u05ea\u05d9\u05e8\u05d5\u05d0\u05d9\u05d3\u05d9\u05d6\u05dd (Hypothyroidism).",
          "isCorrect": false,
          "rationale": "\u05d4\u05d9\u05e4\u05d5\u05ea\u05d9\u05e8\u05d5\u05d0\u05d9\u05d3\u05d9\u05d6\u05dd \u05d4\u05d5\u05d0 \u05e1\u05d9\u05d1\u05d5\u05da \u05e9\u05db\u05d9\u05d7 \u05d5\u05de\u05d5\u05db\u05e8 \u05d9\u05d5\u05ea\u05e8 \u05e9\u05dc Lithium, \u05dc\u05d0 \u05e9\u05dc Valproate (StahlKids p.295)."
        },
        {
          "text": "\u05e1\u05d5\u05db\u05e8\u05ea \u05de\u05e1\u05d5\u05d2 2 (Type 2 Diabetes).",
          "isCorrect": false,
          "rationale": "\u05d0\u05e3 \u05e9-Valproate \u05d2\u05d5\u05e8\u05dd \u05dc\u05e2\u05dc\u05d9\u05d9\u05d4 \u05d1\u05de\u05e9\u05e7\u05dc \u05d5\u05dc\u05e2\u05de\u05d9\u05d3\u05d5\u05ea \u05dc\u05d0\u05d9\u05e0\u05e1\u05d5\u05dc\u05d9\u05df, \u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d4\u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05d9\u05dd \u05e9\u05dc \u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05de\u05d7\u05d6\u05d5\u05e8 \u05d5\u05d0\u05e7\u05e0\u05d4 \u05de\u05db\u05d5\u05d5\u05e0\u05d9\u05dd \u05d9\u05d5\u05ea\u05e8 \u05dc-PCOS (StahlKids p.466)."
        },
        {
          "text": "\u05d4\u05d9\u05e4\u05e8\u05e4\u05e8\u05ea\u05d9\u05e8\u05d5\u05d0\u05d9\u05d3\u05d9\u05d6\u05dd (Hyperparathyroidism).",
          "isCorrect": false,
          "rationale": "\u05e1\u05d9\u05d1\u05d5\u05da \u05d6\u05d4 \u05d0\u05d9\u05e0\u05d5 \u05e7\u05e9\u05d5\u05e8 \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Valproate; \u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 \u05e7\u05e9\u05d5\u05e8\u05d4 \u05d3\u05d5\u05d5\u05e7\u05d0 \u05dc\u05d9\u05e8\u05d9\u05d3\u05d4 \u05d1\u05e6\u05e4\u05d9\u05e4\u05d5\u05ea \u05e2\u05e6\u05dd (StahlKids p.466)."
        }
      ],
      "hint": "\u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05de\u05e9\u05dc\u05d1\u05d9\u05dd \u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05de\u05d8\u05d1\u05d5\u05dc\u05d9\u05d5\u05ea \u05e2\u05dd \u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05d1\u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05e8\u05d1\u05d9\u05d9\u05d4 \u05d4\u05e0\u05e9\u05d9\u05ea."
    },
    {
      "question": "\u05d1\u05d1\u05d3\u05d9\u05e7\u05ea \u05de\u05e2\u05d1\u05d3\u05d4 \u05e9\u05dc \u05d9\u05dc\u05d3 \u05d1\u05df 8 \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05d1-Valproate \u05d1\u05e9\u05dc \u05d4\u05e4\u05e8\u05e2\u05ea \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05e7\u05e9\u05d4 \u05d5\u05ea\u05e0\u05d5\u05d3\u05d5\u05ea \u05d1\u05de\u05e6\u05d1 \u05d4\u05e8\u05d5\u05d7, \u05e0\u05de\u05e6\u05d0\u05d4 \u05e8\u05de\u05d4 \u05de\u05d5\u05d2\u05d1\u05e8\u05ea \u05e9\u05dc Ammonia (Hyperammonemia). \u05d4\u05d9\u05dc\u05d3 \u05e0\u05e8\u05d0\u05d4 \u05dc\u05ea\u05e8\u05d2\u05d9 \u05d5\u05d9\u05e9\u05e0\u05d5\u05e0\u05d9. \u05de\u05d4\u05d5 \u05d4\u05d4\u05e1\u05d1\u05e8 \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9 \u05d4\u05e1\u05d1\u05d9\u05e8 \u05d1\u05d9\u05d5\u05ea\u05e8?",
      "answerOptions": [
        {
          "text": "Valproate-induced hyperammonemic encephalopathy, \u05e9\u05e2\u05dc\u05d5\u05dc \u05dc\u05d4\u05ea\u05e8\u05d7\u05e9 \u05d2\u05dd \u05dc\u05dc\u05d0 \u05e4\u05d2\u05d9\u05e2\u05d4 \u05d1\u05ea\u05e4\u05e7\u05d5\u05d3\u05d9 \u05db\u05d1\u05d3.",
          "isCorrect": true,
          "rationale": "\u05ea\u05d5\u05e4\u05e2\u05d4 \u05d6\u05d5 \u05e2\u05dc\u05d5\u05dc\u05d4 \u05dc\u05e0\u05d1\u05d5\u05e2 \u05de\u05d4\u05e4\u05e8\u05e2\u05d4 \u05d1\u05de\u05e2\u05d2\u05dc \u05d4\u05d0\u05d5\u05e8\u05d9\u05d0\u05d4 \u05d5\u05e2\u05dc\u05d5\u05dc\u05d4 \u05dc\u05d4\u05d5\u05d1\u05d9\u05dc \u05dc\u05e9\u05d9\u05e0\u05d5\u05d9 \u05d1\u05de\u05e6\u05d1 \u05d4\u05db\u05e8\u05d4 \u05dc\u05dc\u05d0 \u05e2\u05dc\u05d9\u05d9\u05d4 \u05d1\u05d0\u05e0\u05d6\u05d9\u05de\u05d9 \u05db\u05d1\u05d3 (StahlKids p.467, StahlNeuro p.350)."
        },
        {
          "text": "\u05db\u05e9\u05dc \u05db\u05d1\u05d3\u05d9 \u05d7\u05e8\u05d9\u05e3 (Acute liver failure).",
          "isCorrect": false,
          "rationale": "\u05d0\u05e3 \u05e9-Valproate \u05e2\u05dc\u05d5\u05dc \u05dc\u05d2\u05e8\u05d5\u05dd \u05dc\u05e8\u05e2\u05d9\u05dc\u05d5\u05ea \u05db\u05d1\u05d3\u05d9\u05ea, Hyperammonemia \u05d9\u05db\u05d5\u05dc\u05d4 \u05dc\u05d4\u05d5\u05e4\u05d9\u05e2 \u05d1\u05d0\u05d5\u05e4\u05df \u05de\u05d1\u05d5\u05d3\u05d3 \u05db\u05ea\u05d5\u05e6\u05d0\u05d4 \u05de\u05d4\u05e4\u05e8\u05e2\u05d4 \u05de\u05d8\u05d1\u05d5\u05dc\u05d9\u05ea \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05ea (StahlKids p.467)."
        },
        {
          "text": "\u05d0\u05d9\u05e0\u05d8\u05e8\u05d0\u05e7\u05e6\u05d9\u05d4 \u05ea\u05e8\u05d5\u05e4\u05ea\u05d9\u05ea \u05e2\u05dd Stimulants \u05d4\u05de\u05d2\u05d1\u05d9\u05e8\u05d4 \u05d0\u05ea \u05d4\u05e4\u05d9\u05e8\u05d5\u05e7 \u05d4\u05d7\u05dc\u05d1\u05d5\u05e0\u05d9.",
          "isCorrect": false,
          "rationale": "\u05d0\u05d9\u05df \u05e2\u05d3\u05d5\u05ea \u05dc\u05db\u05da \u05e9\u05d0\u05d9\u05e0\u05d8\u05e8\u05d0\u05e7\u05e6\u05d9\u05d4 \u05db\u05d6\u05d5 \u05d2\u05d5\u05e8\u05de\u05ea \u05dc\u05d4\u05d9\u05e4\u05e8\u05d0\u05de\u05d5\u05e0\u05de\u05d9\u05d4; \u05d4\u05d2\u05d5\u05e8\u05dd \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05d4\u05d5\u05d0 \u05d4\u05e9\u05e4\u05e2\u05ea \u05d4-Valproate \u05e2\u05dc \u05de\u05e2\u05d2\u05dc \u05d4\u05d0\u05d5\u05e8\u05d9\u05d0\u05d4 (StahlKids p.467)."
        },
        {
          "text": "\u05ea\u05d2\u05d5\u05d1\u05d4 \u05e0\u05d5\u05e8\u05de\u05dc\u05d9\u05ea \u05dc\u05ea\u05e8\u05d5\u05e4\u05d4 \u05e9\u05d0\u05d9\u05e0\u05d4 \u05d3\u05d5\u05e8\u05e9\u05ea \u05d4\u05ea\u05e2\u05e8\u05d1\u05d5\u05ea.",
          "isCorrect": false,
          "rationale": "\u05d4\u05d9\u05e4\u05e8\u05d0\u05de\u05d5\u05e0\u05de\u05d9\u05d4 \u05d0\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d8\u05d9\u05ea \u05d4\u05d9\u05d0 \u05e9\u05db\u05d9\u05d7\u05d4, \u05d0\u05da \u05d4\u05d5\u05e4\u05e2\u05ea \u05dc\u05ea\u05e8\u05d2\u05d9\u05d4 \u05d5\u05d9\u05e9\u05e0\u05d5\u05e0\u05d9\u05d5\u05ea \u05de\u05d7\u05d9\u05d9\u05d1\u05ea \u05d4\u05ea\u05d9\u05d9\u05d7\u05e1\u05d5\u05ea \u05de\u05d9\u05d9\u05d3\u05d9\u05ea \u05db-Encephalopathy (StahlKids p.467)."
        }
