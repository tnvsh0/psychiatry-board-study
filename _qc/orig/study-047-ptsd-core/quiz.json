      ],
      "rationale": "\u05d4\u05e4\u05e8\u05e2\u05ea \u05d4\u05e1\u05ea\u05d2\u05dc\u05d5\u05ea (Adjustment Disorder) \u05de\u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05ea \u05d1\u05ea\u05d2\u05d5\u05d1\u05d4 \u05e8\u05d2\u05e9\u05d9\u05ea \u05d0\u05d5 \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea\u05d9\u05ea \u05dc\u05e1\u05d8\u05e8\u05e1\u05d5\u05e8 \u05de\u05d6\u05d5\u05d4\u05d4, \u05e2\u05dd \u05d2\u05d1\u05d5\u05dc\u05d5\u05ea \u05d6\u05de\u05df \u05de\u05d5\u05d2\u05d3\u05e8\u05d9\u05dd \u05e9\u05dc \u05d4\u05d5\u05e4\u05e2\u05d4 \u05d5\u05de\u05e9\u05da (Synopsis ch.10, DSM p.319).",
      "hint": "\u05d6\u05d5\u05d4\u05d9 \u05d4\u05e4\u05e8\u05e2\u05d4 \u05d4\u05e7\u05e9\u05d5\u05e8\u05d4 \u05dc\u05e1\u05d8\u05e8\u05e1\u05d5\u05e8 \u05e9\u05d0\u05d9\u05e0\u05d5 \u05d1\u05d4\u05db\u05e8\u05d7 '\u05d8\u05e8\u05d0\u05d5\u05de\u05d8\u05d9' \u05d1\u05de\u05d5\u05d1\u05df \u05e9\u05dc Criterion A."
    },
    {
      "type": "multiple_select",
      "question": "\u05d1\u05d0\u05d9\u05dc\u05d5 \u05de\u05e7\u05e8\u05d9\u05dd, \u05dc\u05e4\u05d9 \u05d4-Dulcan, \u05e2\u05e9\u05d5\u05d9\u05d4 \u05dc\u05d4\u05d9\u05d5\u05ea \u05d4\u05e6\u05d3\u05e7\u05d4 \u05dc\u05d4\u05ea\u05d7\u05dc\u05ea \u05d8\u05d9\u05e4\u05d5\u05dc \u05ea\u05e8\u05d5\u05e4\u05ea\u05d9 \u05d1-PTSD \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d1\u05de\u05e7\u05d1\u05d9\u05dc \u05d0\u05d5 \u05dc\u05e4\u05e0\u05d9 \u05e4\u05e1\u05d9\u05db\u05d5\u05ea\u05e8\u05e4\u05d9\u05d4?",
      "answerOptions": [
        {
          "text": "\u05db\u05d0\u05e9\u05e8 \u05e7\u05d9\u05d9\u05de\u05ea \u05ea\u05d7\u05dc\u05d5\u05d0\u05d4 \u05e0\u05dc\u05d5\u05d5\u05d9\u05ea (Comorbidity) \u05e2\u05d1\u05d5\u05e8\u05d4 \u05e7\u05d9\u05d9\u05dd \u05d8\u05d9\u05e4\u05d5\u05dc \u05ea\u05e8\u05d5\u05e4\u05ea\u05d9 \u05de\u05d5\u05db\u05d7.",
          "isCorrect": true,
          "rationale": "\u05e7\u05d9\u05d5\u05dd \u05d4\u05e4\u05e8\u05e2\u05d4 \u05e0\u05d5\u05e1\u05e4\u05ea \u05e2\u05dd \u05d8\u05d9\u05e4\u05d5\u05dc \u05de\u05d5\u05db\u05d7 \u05de\u05e6\u05d3\u05d9\u05e7 \u05d4\u05ea\u05e2\u05e8\u05d1\u05d5\u05ea \u05e4\u05e8\u05de\u05e7\u05dc\u05d5\u05d2\u05d9\u05ea (Dulcan p.356)."
        },
        {
          "text": "\u05db\u05d0\u05e9\u05e8 \u05d4\u05d9\u05dc\u05d3 \u05e0\u05de\u05e6\u05d0 \u05d1\u05de\u05e6\u05d1 \u05e9\u05dc \u05de\u05e1\u05d5\u05db\u05e0\u05d5\u05ea \u05de\u05d9\u05d9\u05d3\u05d9\u05ea \u05dc\u05e2\u05e6\u05de\u05d5 \u05d0\u05d5 \u05dc\u05d0\u05d7\u05e8\u05d9\u05dd \u05e2\u05e7\u05d1 \u05d7\u05d5\u05e1\u05e8 \u05d5\u05d9\u05e1\u05d5\u05ea \u05e7\u05d9\u05e6\u05d5\u05e0\u05d9.",
          "isCorrect": true,
          "rationale": "\u05d1\u05de\u05e6\u05d1\u05d9 \u05d7\u05d9\u05e8\u05d5\u05dd \u05d1\u05d8\u05d9\u05d7\u05d5\u05ea\u05d9\u05d9\u05dd, \u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05e2\u05e9\u05d5\u05d9\u05d5\u05ea \u05dc\u05d4\u05d9\u05d3\u05e8\u05e9 \u05dc\u05d9\u05d9\u05e6\u05d5\u05d1 \u05de\u05d4\u05d9\u05e8 (Dulcan p.356)."
        },
        {
          "text": "\u05db\u05d0\u05e9\u05e8 \u05e7\u05d9\u05d9\u05de\u05ea \u05e4\u05d2\u05d9\u05e2\u05d4 \u05e7\u05e9\u05d4 \u05de\u05d0\u05d5\u05d3 \u05d1\u05ea\u05e4\u05e7\u05d5\u05d3, \u05db\u05d2\u05d5\u05df \u05dc\u05d9\u05e7\u05d5\u05d9 \u05d7\u05de\u05d5\u05e8 \u05d1\u05e9\u05d9\u05e0\u05d4 \u05e9\u05d0\u05d9\u05e0\u05d5 \u05de\u05d2\u05d9\u05d1 \u05dc\u05d4\u05ea\u05e2\u05e8\u05d1\u05d5\u05ea \u05e4\u05e1\u05d9\u05db\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea.",
          "isCorrect": true,
          "rationale": "\u05d7\u05d5\u05e1\u05e8 \u05ea\u05d2\u05d5\u05d1\u05d4 \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05e4\u05e1\u05d9\u05db\u05d5\u05e1\u05d5\u05e6\u05d9\u05d0\u05dc\u05d9 \u05d1\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05de\u05e2\u05d9\u05e7\u05d9\u05dd \u05d1\u05de\u05d9\u05d5\u05d7\u05d3 \u05de\u05d4\u05d5\u05d5\u05d4 \u05d4\u05e6\u05d3\u05e7\u05d4 (Dulcan p.356)."
        },
        {
          "text": "\u05db\u05d8\u05d9\u05e4\u05d5\u05dc \u05de\u05e0\u05d9\u05e2\u05ea\u05d9 \u05e1\u05d8\u05e0\u05d3\u05e8\u05d8\u05d9 \u05dc\u05db\u05dc \u05d9\u05dc\u05d3 \u05e9\u05e0\u05d7\u05e9\u05e3 \u05dc\u05d0\u05d9\u05e8\u05d5\u05e2 \u05d4\u05de\u05d5\u05d2\u05d3\u05e8 \u05d1-Criterion A.",
          "isCorrect": false,
          "rationale": "\u05d0\u05d9\u05df \u05d4\u05de\u05dc\u05e6\u05d4 \u05dc\u05de\u05ea\u05df \u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05db\u05d8\u05d9\u05e4\u05d5\u05dc \u05de\u05e0\u05d9\u05e2\u05ea\u05d9 \u05d2\u05d5\u05e8\u05e3 \u05dc\u05db\u05dc \u05d9\u05dc\u05d3 \u05e9\u05e0\u05d7\u05e9\u05e3 \u05dc\u05d8\u05e8\u05d0\u05d5\u05de\u05d4 (Dulcan p.353)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d1\u05d5 \u05e2\u05dc \u05de\u05e6\u05d1\u05d9\u05dd \u05e9\u05d1\u05d4\u05dd \u05e4\u05e1\u05d9\u05db\u05d5\u05ea\u05e8\u05e4\u05d9\u05d4 \u05dc\u05d1\u05d3\u05d4 \u05d0\u05d9\u05e0\u05d4 \u05de\u05e1\u05e4\u05e7\u05ea \u05d0\u05d5 \u05d0\u05d9\u05e0\u05d4 \u05d1\u05d8\u05d5\u05d7\u05d4.",
      "hasAllOfTheAbove": false,
      "hasNoneOfTheAbove": false
    },
    {
      "type": "short_answer",
      "question": "\u05d4\u05e1\u05d1\u05d9\u05e8\u05d5 \u05d1\u05e7\u05e6\u05e8\u05d4 \u05d0\u05ea \u05d4\u05e8\u05e6\u05d9\u05d5\u05e0\u05dc \u05de\u05d0\u05d7\u05d5\u05e8\u05d9 \u05d4\u05de\u05dc\u05e6\u05ea \u05d4-Dulcan \u05dc\u05d1\u05d9\u05e6\u05d5\u05e2 \u05d1\u05d3\u05d9\u05e7\u05ea TSH '\u05de\u05de\u05d5\u05e7\u05d3\u05ea' (Targeted) \u05d5\u05dc\u05d0 '\u05d0\u05d5\u05e0\u05d9\u05d1\u05e8\u05e1\u05dc\u05d9\u05ea' \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd \u05ea\u05e1\u05de\u05d9\u05e0\u05d9 \u05d7\u05e8\u05d3\u05d4.",
      "grading": {
        "modelAnswer": "\u05d1\u05d3\u05d9\u05e7\u05ea TSH \u05d0\u05d5\u05e0\u05d9\u05d1\u05e8\u05e1\u05dc\u05d9\u05ea \u05d4\u05d9\u05d0 \u05d1\u05e2\u05dc\u05ea \u05ea\u05e4\u05d5\u05e7\u05d4 (Yield) \u05e0\u05de\u05d5\u05db\u05d4, \u05e9\u05db\u05df \u05de\u05d7\u05dc\u05d5\u05ea \u05d1\u05dc\u05d5\u05d8\u05ea \u05d4\u05ea\u05e8\u05d9\u05e1 \u05e0\u05de\u05e6\u05d0\u05d5 \u05d1\u05e4\u05d7\u05d5\u05ea \u05de-1% \u05de\u05d4\u05d9\u05dc\u05d3\u05d9\u05dd \u05d4\u05de\u05d0\u05d5\u05e9\u05e4\u05d6\u05d9\u05dd \u05e2\u05dd \u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05d7\u05e8\u05d3\u05d4. \u05dc\u05db\u05df, \u05de\u05d5\u05de\u05dc\u05e5 \u05dc\u05d1\u05e6\u05e2 \u05d1\u05d3\u05d9\u05e7\u05d4 \u05e8\u05e7 \u05db\u05d0\u05e9\u05e8 \u05d9\u05e9 \u05e8\u05de\u05d6\u05d9\u05dd \u05e7\u05dc\u05d9\u05e0\u05d9\u05d9\u05dd \u05d1\u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4 (\u05db\u05de\u05d5 \u05e9\u05d9\u05e0\u05d5\u05d9\u05d9 \u05de\u05e9\u05e7\u05dc) \u05d0\u05d5 \u05d1\u05d1\u05d3\u05d9\u05e7\u05d4 \u05d2\u05d5\u05e4\u05e0\u05d9\u05ea.",
        "rationale": "\u05d4\u05de\u05d7\u05e7\u05e8 \u05de\u05e8\u05d0\u05d4 \u05e9\u05e1\u05e7\u05e8 \u05d0\u05d5\u05e0\u05d9\u05d1\u05e8\u05e1\u05dc\u05d9 \u05d0\u05d9\u05e0\u05d5 \u05d9\u05e2\u05d9\u05dc \u05db\u05dc\u05db\u05dc\u05d9\u05ea \u05d0\u05d5 \u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05dc\u05dc\u05d0 \u05d2\u05d5\u05e8\u05de\u05d9 \u05e1\u05d9\u05db\u05d5\u05df \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05d9\u05dd (Dulcan p.330).",
        "requiredAttributes": [
          "\u05e6\u05d9\u05d5\u05df \u05d4\u05ea\u05e4\u05d5\u05e7\u05d4 \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05d4\u05e0\u05de\u05d5\u05db\u05d4 \u05e9\u05dc \u05d4\u05d1\u05d3\u05d9\u05e7\u05d4 \u05d4\u05d0\u05d5\u05e0\u05d9\u05d1\u05e8\u05e1\u05dc\u05d9\u05ea.",
          "\u05d4\u05ea\u05d1\u05e1\u05e1\u05d5\u05ea \u05e2\u05dc \u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4 \u05e8\u05e4\u05d5\u05d0\u05d9\u05ea \u05d0\u05d5 \u05d2\u05d5\u05e8\u05de\u05d9 \u05e1\u05d9\u05db\u05d5\u05df (\u05db\u05d2\u05d5\u05df \u05e9\u05d9\u05e0\u05d5\u05d9\u05d9 \u05de\u05e9\u05e7\u05dc)."
        ],
        "errors": {
          "misconceptions": [
            "\u05d4\u05e0\u05d7\u05d4 \u05e9\u05de\u05d7\u05dc\u05d5\u05ea \u05d1\u05dc\u05d5\u05d8\u05ea \u05d4\u05ea\u05e8\u05d9\u05e1 \u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05db\u05d2\u05d5\u05e8\u05dd \u05dc\u05d7\u05e8\u05d3\u05d4 \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd."
          ],
          "bluffs": [
            "\u05d0\u05de\u05d9\u05e8\u05d4 \u05db\u05dc\u05dc\u05d9\u05ea \u05e9\u05d1\u05d3\u05d9\u05e7\u05d5\u05ea \u05d3\u05dd \u05d0\u05d9\u05e0\u05df \u05e0\u05d7\u05d5\u05e6\u05d5\u05ea \u05d1\u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9\u05d4."
          ]
