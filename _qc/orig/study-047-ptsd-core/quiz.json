        }
      ],
      "hint": "\u05d7\u05e4\u05e9\u05d5 \u05de\u05d5\u05e9\u05d2 \u05d4\u05de\u05ea\u05d0\u05e8 '\u05d8\u05e8\u05d0\u05d5\u05de\u05d4 \u05de\u05d5\u05e8\u05db\u05d1\u05ea' \u05de\u05e2\u05d1\u05e8 \u05dc-PTSD \u05d4\u05e7\u05dc\u05d0\u05e1\u05d9.",
      "imageUrls": []
    },
    {
      "type": "fill_in_the_blank",
      "question": "\u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05de\u05d1\u05d3\u05dc\u05ea \u05d1\u05d9\u05df PTSD \u05dc\u05d1\u05d9\u05df ___ Disorder \u05de\u05ea\u05d1\u05e1\u05e1\u05ea \u05d1\u05e2\u05d9\u05e7\u05e8 \u05e2\u05dc \u05e6\u05d9\u05e8 \u05d4\u05d6\u05de\u05df, \u05e9\u05db\u05df \u05d1\u05d0\u05d7\u05e8\u05d5\u05e0\u05d4 \u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d7\u05d9\u05d9\u05d1\u05d9\u05dd \u05dc\u05d4\u05d5\u05e4\u05d9\u05e2 \u05ea\u05d5\u05da 3 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05de\u05d4\u05e1\u05d8\u05e8\u05e1\u05d5\u05e8 \u05d5\u05dc\u05d4\u05d9\u05de\u05e9\u05da \u05dc\u05d0 \u05d9\u05d5\u05ea\u05e8 \u05de-6 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05dc\u05d0\u05d7\u05e8 \u05e1\u05d9\u05d5\u05dd \u05d4\u05e1\u05d8\u05e8\u05e1\u05d5\u05e8 \u05d0\u05d5 \u05d4\u05e9\u05dc\u05db\u05d5\u05ea\u05d9\u05d5.",
      "bestAnswer": "Adjustment",
      "acceptableAnswers": [
        "Adjustment Disorder",
