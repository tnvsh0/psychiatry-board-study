{
  "title": "PTSD Quiz",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\u05d9\u05dc\u05d3 \u05d1\u05df 5 \u05de\u05d5\u05d1\u05d0 \u05dc\u05d4\u05e2\u05e8\u05db\u05d4 \u05dc\u05d0\u05d7\u05e8 \u05e9\u05e6\u05e4\u05d4 \u05d1\u05e1\u05e8\u05d8\u05d5\u05df YouTube \u05d5\u05d9\u05e8\u05d0\u05dc\u05d9 \u05d5\u05d2\u05e8\u05e4\u05d9 \u05de\u05d0\u05d5\u05d3 \u05d4\u05de\u05ea\u05d0\u05e8 \u05ea\u05d0\u05d5\u05e0\u05ea \u05d3\u05e8\u05db\u05d9\u05dd \u05e7\u05d8\u05dc\u05e0\u05d9\u05ea. \u05de\u05d0\u05d6, \u05d4\u05d5\u05d0 \u05de\u05e1\u05e8\u05d1 \u05dc\u05e9\u05d7\u05e7 \u05d1\u05de\u05db\u05d5\u05e0\u05d9\u05d5\u05ea \u05e6\u05e2\u05e6\u05d5\u05e2, \u05e1\u05d5\u05d1\u05dc \u05de\u05e1\u05d9\u05d5\u05d8\u05d9\u05dd \u05e2\u05dc \u05ea\u05d0\u05d5\u05e0\u05d5\u05ea \u05d5\u05de\u05e4\u05d2\u05d9\u05df \u05e8\u05d2\u05d6\u05e0\u05d5\u05ea \u05e7\u05e9\u05d4. \u05d4\u05d0\u05dd \u05d0\u05d9\u05e8\u05d5\u05e2 \u05d6\u05d4 \u05e2\u05d5\u05e0\u05d4 \u05e2\u05dc Criterion A \u05e2\u05d1\u05d5\u05e8 \u05d0\u05d1\u05d7\u05e0\u05ea PTSD \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d1\u05d2\u05d9\u05dc \u05d4\u05e8\u05da (Preschool Subtype)?",
      "answerOptions": [
        {
          "text": "\u05dc\u05d0, \u05de\u05db\u05d9\u05d5\u05d5\u05df \u05e9\u05d7\u05e9\u05d9\u05e4\u05d4 \u05d1\u05d0\u05de\u05e6\u05e2\u05d5\u05ea \u05de\u05d3\u05d9\u05d4 \u05d0\u05dc\u05e7\u05d8\u05e8\u05d5\u05e0\u05d9\u05ea \u05d0\u05d9\u05e0\u05d4 \u05e2\u05d5\u05e0\u05d4 \u05e2\u05dc \u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d1\u05d2\u05d9\u05dc \u05d6\u05d4, \u05d0\u05dc\u05d0 \u05d0\u05dd \u05d4\u05d9\u05d0 \u05e7\u05e9\u05d5\u05e8\u05d4 \u05dc\u05e2\u05d1\u05d5\u05d3\u05d4.",
          "isCorrect": true,
          "rationale": "\u05dc\u05e4\u05d9 \u05d4-DSM, \u05e2\u05d1\u05d5\u05e8 \u05d9\u05dc\u05d3\u05d9\u05dd \u05d1\u05e0\u05d9 6 \u05d5\u05de\u05d8\u05d4, \u05d7\u05e9\u05d9\u05e4\u05d4 \u05dc\u05d0\u05d9\u05e8\u05d5\u05e2 \u05d8\u05e8\u05d0\u05d5\u05de\u05d8\u05d9 \u05d0\u05d9\u05e0\u05d4 \u05db\u05d5\u05dc\u05dc\u05ea \u05d0\u05d9\u05e8\u05d5\u05e2\u05d9\u05dd \u05e9\u05e0\u05e6\u05e4\u05d5 \u05d0\u05da \u05d5\u05e8\u05e7 \u05d1\u05de\u05d3\u05d9\u05d4 \u05d0\u05dc\u05e7\u05d8\u05e8\u05d5\u05e0\u05d9\u05ea, \u05d8\u05dc\u05d5\u05d5\u05d9\u05d6\u05d9\u05d4 \u05d0\u05d5 \u05ea\u05de\u05d5\u05e0\u05d5\u05ea (DSM p.304)."
        },
        {
          "text": "\u05db\u05df, \u05e9\u05db\u05df \u05de\u05d3\u05d5\u05d1\u05e8 \u05d1\u05d7\u05e9\u05d9\u05e4\u05d4 \u05e2\u05e7\u05d9\u05e4\u05d4 \u05dc\u05d0\u05d9\u05e8\u05d5\u05e2 \u05d4\u05db\u05d5\u05dc\u05dc \u05de\u05d5\u05d5\u05ea \u05d1\u05e4\u05d5\u05e2\u05dc \u05e9\u05d2\u05e8\u05dd \u05dc\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e7\u05dc\u05d9\u05e0\u05d9\u05d9\u05dd \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05d9\u05dd.",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05e9\u05d4\u05d9\u05dc\u05d3 \u05de\u05e4\u05d2\u05d9\u05df \u05de\u05e6\u05d5\u05e7\u05d4, \u05d4-DSM \u05de\u05d7\u05e8\u05d9\u05d2 \u05d1\u05de\u05e4\u05d5\u05e8\u05e9 \u05e6\u05e4\u05d9\u05d9\u05d4 \u05d1\u05de\u05d3\u05d9\u05d4 \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05de\u05ea\u05d7\u05ea \u05dc\u05d2\u05d9\u05dc 6 \u05db\u05d7\u05dc\u05e7 \u05de-Criterion A (DSM p.304)."
        },
        {
          "text": "\u05db\u05df, \u05d1\u05ea\u05e0\u05d0\u05d9 \u05e9\u05d4\u05d9\u05dc\u05d3 \u05ea\u05d5\u05e4\u05e1 \u05d0\u05ea \u05d4\u05d0\u05d9\u05e8\u05d5\u05e2 \u05db\u05de\u05d0\u05d9\u05d9\u05dd \u05e2\u05dc \u05d7\u05d9\u05d9\u05d5 \u05d0\u05d5 \u05e2\u05dc \u05e9\u05dc\u05de\u05d5\u05ea\u05d5 \u05d4\u05d2\u05d5\u05e4\u05e0\u05d9\u05ea.",
          "isCorrect": false,
          "rationale": "\u05d4\u05ea\u05e4\u05d9\u05e1\u05d4 \u05d4\u05e1\u05d5\u05d1\u05d9\u05d9\u05e7\u05d8\u05d9\u05d1\u05d9\u05ea \u05d0\u05d9\u05e0\u05d4 \u05de\u05d7\u05dc\u05d9\u05e4\u05d4 \u05d0\u05ea \u05d4\u05e6\u05d5\u05e8\u05da \u05d1\u05e2\u05de\u05d9\u05d3\u05d4 \u05d1\u05ea\u05e0\u05d0\u05d9 \u05d4\u05d7\u05e9\u05d9\u05e4\u05d4 \u05d4\u05d0\u05d5\u05d1\u05d9\u05d9\u05e7\u05d8\u05d9\u05d1\u05d9\u05d9\u05dd \u05d4\u05de\u05d5\u05d2\u05d3\u05e8\u05d9\u05dd \u05d1-Criterion A (DSM p.301)."
        },
        {
          "text": "\u05dc\u05d0, \u05de\u05db\u05d9\u05d5\u05d5\u05df \u05e9\u05e0\u05d3\u05e8\u05e9\u05ea \u05e2\u05d3\u05d5\u05ea \u05d9\u05e9\u05d9\u05e8\u05d4 (In person) \u05dc\u05d0\u05d9\u05e8\u05d5\u05e2 \u05e9\u05d4\u05ea\u05e8\u05d7\u05e9 \u05dc\u05d0\u05d3\u05dd \u05e7\u05e8\u05d5\u05d1 \u05d1\u05dc\u05d1\u05d3.",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05e9\u05d7\u05e9\u05d9\u05e4\u05d4 \u05dc\u05d0\u05d9\u05e8\u05d5\u05e2 \u05e9\u05dc \u05d3\u05de\u05d5\u05ea \u05de\u05d8\u05e4\u05dc\u05ea \u05d4\u05d9\u05d0 \u05d3\u05e8\u05da \u05d0\u05d7\u05ea, \u05d7\u05e9\u05d9\u05e4\u05d4 \u05d9\u05e9\u05d9\u05e8\u05d4 \u05dc\u05d0\u05d9\u05e8\u05d5\u05e2 \u05e9\u05e7\u05e8\u05d4 \u05dc\u05d0\u05d7\u05e8\u05d9\u05dd \u05d4\u05d9\u05d0 \u05d2\u05dd \u05d3\u05e8\u05da \u05ea\u05e7\u05e4\u05d4, \u05d0\u05da \u05d4\u05d4\u05d7\u05e8\u05d2\u05d4 \u05db\u05d0\u05df \u05d4\u05d9\u05d0 \u05e2\u05dc \u05d0\u05d5\u05e4\u05df \u05d4\u05d7\u05e9\u05d9\u05e4\u05d4 (\u05de\u05d3\u05d9\u05d4) (DSM p.304)."
        }
      ],
      "hint": "\u05d1\u05d3\u05e7\u05d5 \u05d0\u05ea \u05d4\u05d4\u05e2\u05e8\u05d5\u05ea \u05d4\u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05d5\u05ea \u05d1-DSM \u05dc\u05d2\u05d1\u05d9 \u05d7\u05e9\u05d9\u05e4\u05d4 \u05dc\u05de\u05d3\u05d9\u05d4 \u05d0\u05dc\u05e7\u05d8\u05e8\u05d5\u05e0\u05d9\u05ea \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05e6\u05e2\u05d9\u05e8\u05d9\u05dd.",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05e0\u05e2\u05e8 \u05d1\u05df 16 \u05d4\u05de\u05d0\u05d5\u05d1\u05d7\u05df \u05e2\u05dd PTSD \u05de\u05d3\u05d5\u05d5\u05d7 \u05e2\u05dc \u05e0\u05d4\u05d9\u05d2\u05d4 \u05d1\u05de\u05d4\u05d9\u05e8\u05d5\u05ea \u05de\u05d5\u05e4\u05e8\u05d6\u05ea \u05de\u05d0\u05d5\u05d3 \u05d5\u05e9\u05d9\u05de\u05d5\u05e9 \u05de\u05d5\u05d2\u05d1\u05e8 \u05d1-Alcohol \u05de\u05d0\u05d6 \u05d4\u05d0\u05d9\u05e8\u05d5\u05e2 \u05d4\u05d8\u05e8\u05d0\u05d5\u05de\u05d8\u05d9. \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d0\u05dc\u05d5 \u05e9\u05d9\u05d9\u05db\u05d9\u05dd \u05dc\u05d0\u05d9\u05d6\u05d4 Cluster \u05d0\u05d1\u05d7\u05e0\u05ea\u05d9?",
      "answerOptions": [
        {
          "text": "Cluster E: Alterations in arousal and reactivity",
          "isCorrect": true,
          "rationale": "\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df E2 \u05db\u05d5\u05dc\u05dc \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05e4\u05d6\u05d9\u05d6\u05d4 (Reckless) \u05d0\u05d5 \u05d4\u05e8\u05e1\u05e0\u05d9\u05ea \u05e2\u05e6\u05de\u05d9\u05ea, \u05db\u05d2\u05d5\u05df \u05e0\u05d4\u05d9\u05d2\u05d4 \u05de\u05e1\u05d5\u05db\u05e0\u05ea \u05d0\u05d5 \u05e9\u05d9\u05de\u05d5\u05e9 \u05de\u05d5\u05e4\u05e8\u05d6 \u05d1\u05d7\u05d5\u05de\u05e8\u05d9\u05dd (DSM p.303, StahlNeuro p.401)."
        },
        {
          "text": "Cluster C: Avoidance",
          "isCorrect": false,
          "rationale": "Cluster C \u05de\u05ea\u05de\u05e7\u05d3 \u05d1\u05d4\u05d9\u05de\u05e0\u05e2\u05d5\u05ea \u05de\u05d2\u05d9\u05e8\u05d5\u05d9\u05d9\u05dd, \u05d6\u05d9\u05db\u05e8\u05d5\u05e0\u05d5\u05ea \u05d0\u05d5 \u05ea\u05d6\u05db\u05d5\u05e8\u05d5\u05ea \u05d7\u05d9\u05e6\u05d5\u05e0\u05d9\u05d5\u05ea \u05dc\u05d8\u05e8\u05d0\u05d5\u05de\u05d4, \u05d5\u05dc\u05d0 \u05d1\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d0\u05e7\u05d8\u05d9\u05d1\u05d9\u05ea \u05e4\u05d6\u05d9\u05d6\u05d4 (DSM p.303)."
        },
        {
          "text": "Cluster D: Negative alterations in cognitions and mood",
          "isCorrect": false,
          "rationale": "Cluster D \u05e2\u05d5\u05e1\u05e7 \u05d1\u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd \u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9\u05d9\u05dd \u05d5\u05e8\u05d2\u05e9\u05d9\u05d9\u05dd \u05db\u05de\u05d5 \u05d0\u05e0\u05d4\u05d3\u05d5\u05e0\u05d9\u05d4, \u05d0\u05e9\u05de\u05d4 \u05d0\u05d5 \u05d6\u05d9\u05db\u05e8\u05d5\u05df \u05dc\u05e7\u05d5\u05d9, \u05d5\u05dc\u05d0 \u05d1\u05ea\u05d2\u05d5\u05d1\u05ea\u05d9\u05d5\u05ea \u05e4\u05d9\u05d6\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea \u05d0\u05d5 \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea\u05d9\u05ea (DSM p.303)."
        },
        {
          "text": "Cluster B: Intrusion symptoms",
          "isCorrect": false,
          "rationale": "Cluster B \u05de\u05ea\u05d9\u05d9\u05d7\u05e1 \u05dc\u05d7\u05d5\u05d5\u05d9\u05d4 \u05de\u05d7\u05d3\u05e9 \u05e9\u05dc \u05d4\u05d0\u05d9\u05e8\u05d5\u05e2 \u05d3\u05e8\u05da \u05e4\u05dc\u05d0\u05e9\u05d1\u05e7\u05d9\u05dd, \u05d7\u05dc\u05d5\u05de\u05d5\u05ea \u05d0\u05d5 \u05d6\u05d9\u05db\u05e8\u05d5\u05e0\u05d5\u05ea \u05d7\u05d5\u05d3\u05e8\u05e0\u05d9\u05d9\u05dd (DSM p.302)."
        }
      ],
      "hint": "\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d4\u05de\u05d1\u05d8\u05d0\u05ea \u05d7\u05d5\u05e1\u05e8 \u05d4\u05ea\u05d7\u05e9\u05d1\u05d5\u05ea \u05d1\u05d1\u05d8\u05d9\u05d7\u05d5\u05ea \u05d4\u05e2\u05e6\u05de\u05d9\u05ea \u05de\u05e1\u05d5\u05d5\u05d2\u05ea \u05ea\u05d7\u05ea \u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd \u05d1\u05e2\u05d5\u05e8\u05e8\u05d5\u05ea \u05d5\u05ea\u05d2\u05d5\u05d1\u05ea\u05d9\u05d5\u05ea.",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05d1\u05ea\u05d4\u05dc\u05d9\u05da \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05de\u05d1\u05d3\u05dc\u05ea \u05d1\u05d9\u05df ADHD \u05dc\u05d1\u05d9\u05df PTSD \u05d1\u05d9\u05dc\u05d3 \u05d1\u05df 8 \u05d4\u05de\u05e6\u05d9\u05d2 \u05e7\u05e9\u05d9\u05d9 \u05e8\u05d9\u05db\u05d5\u05d6, \u05d7\u05d5\u05e1\u05e8 \u05e9\u05e7\u05d8 \u05d5\u05d0\u05d9 \u05e9\u05e7\u05d8 \u05de\u05d5\u05d8\u05d5\u05e8\u05d9, \u05de\u05d4\u05d5 \u05d4\u05de\u05e4\u05ea\u05d7 \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9 \u05d4\u05d7\u05e9\u05d5\u05d1 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05e4\u05d9 \u05d4\u05e1\u05e4\u05e8\u05d5\u05ea?",
      "answerOptions": [
        {
          "text": "\u05d1\u05d3\u05d9\u05e7\u05d4 \u05e7\u05e4\u05d3\u05e0\u05d9\u05ea \u05e9\u05dc \u05e6\u05d9\u05e8 \u05d4\u05d6\u05de\u05df (Timing) \u05e9\u05dc \u05d4\u05d5\u05e4\u05e2\u05ea \u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d0\u05d5 \u05d4\u05d7\u05de\u05e8\u05ea\u05dd \u05d1\u05d9\u05d7\u05e1 \u05dc\u05d7\u05e9\u05d9\u05e4\u05d4 \u05dc\u05d8\u05e8\u05d0\u05d5\u05de\u05d4.",
          "isCorrect": true,
          "rationale": "\u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4 \u05de\u05d3\u05d5\u05d9\u05e7\u05ea \u05e9\u05dc \u05de\u05d5\u05e2\u05d3 \u05d4\u05d5\u05e4\u05e2\u05ea \u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e7\u05e8\u05d9\u05d8\u05d9\u05ea \u05dc\u05d4\u05d1\u05d3\u05dc\u05d4, \u05e9\u05db\u05df \u05ea\u05e1\u05de\u05d9\u05e0\u05d9 \u05e2\u05d5\u05e8\u05e8\u05d5\u05ea \u05d1-PTSD \u05d9\u05db\u05d5\u05dc\u05d9\u05dd \u05dc\u05d7\u05e7\u05d5\u05ea ADHD \u05d1\u05de\u05d3\u05d5\u05d9\u05e7 (Dulcan p.355)."
        },
        {
          "text": "\u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05e9\u05dc Hypervigilance, \u05d4\u05de\u05d5\u05e4\u05d9\u05e2\u05d4 \u05e8\u05e7 \u05d1-ADHD \u05db\u05d7\u05dc\u05e7 \u05de\u05d4\u05de\u05d5\u05e1\u05d7\u05d5\u05ea \u05d4\u05e1\u05d1\u05d9\u05d1\u05ea\u05d9\u05ea.",
          "isCorrect": false,
          "rationale": "\u05dc\u05d4\u05d9\u05e4\u05da, Hypervigilance \u05d4\u05d9\u05d0 \u05ea\u05e1\u05de\u05d9\u05df \u05dc\u05d9\u05d1\u05d4 \u05e9\u05dc PTSD (Cluster E) \u05d5\u05dc\u05d0 \u05e9\u05dc ADHD (DSM p.303)."
        },
        {
