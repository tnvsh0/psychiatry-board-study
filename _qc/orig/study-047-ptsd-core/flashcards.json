{
  "title": "PTSD Flashcards",
  "cards": [
    {
      "front": "\u05de\u05d4\u05df 4 \u05d4\u05d3\u05e8\u05db\u05d9\u05dd \u05e9\u05d1\u05d4\u05df \u05d0\u05d3\u05dd \u05d9\u05db\u05d5\u05dc \u05dc\u05d4\u05d9\u05d7\u05e9\u05e3 \u05dc\u05de\u05d5\u05d5\u05ea, \u05e4\u05e6\u05d9\u05e2\u05d4 \u05d0\u05d5 \u05d0\u05dc\u05d9\u05de\u05d5\u05ea \u05de\u05d9\u05e0\u05d9\u05ea \u05dc\u05e4\u05d9 Criterion A \u05d1-DSM-5-TR?",
      "back": "\u05d7\u05d5\u05d5\u05d9\u05d4 \u05d9\u05e9\u05d9\u05e8\u05d4, \u05e6\u05e4\u05d9\u05d9\u05d4 \u05d9\u05e9\u05d9\u05e8\u05d4, \u05dc\u05de\u05d9\u05d3\u05d4 \u05e2\u05dc \u05d0\u05d9\u05e8\u05d5\u05e2 \u05e9\u05e7\u05e8\u05d4 \u05dc\u05e7\u05e8\u05d5\u05d1 \u05de\u05e9\u05e4\u05d7\u05d4/\u05d7\u05d1\u05e8 (\u05d0\u05dc\u05d9\u05dd/\u05ea\u05d0\u05d5\u05e0\u05ea\u05d9), \u05d0\u05d5 \u05d7\u05e9\u05d9\u05e4\u05d4 \u05ea\u05e2\u05e1\u05d5\u05e7\u05ea\u05d9\u05ea \u05d7\u05d5\u05d6\u05e8\u05ea \u05dc\u05e4\u05e8\u05d8\u05d9\u05dd (DSM p.301)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05de\u05e9\u05da \u05d4\u05d6\u05de\u05df \u05d4\u05de\u05d9\u05e0\u05d9\u05de\u05dc\u05d9 \u05e9\u05dc \u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd (\u05d0\u05e9\u05db\u05d5\u05dc\u05d5\u05ea B, C, D, E) \u05d4\u05e0\u05d3\u05e8\u05e9 \u05dc\u05e6\u05d5\u05e8\u05da \u05d0\u05d1\u05d7\u05e0\u05ea PTSD?",
      "back": "\u05d9\u05d5\u05ea\u05e8 \u05de\u05d7\u05d5\u05d3\u05e9 \u05d0\u05d7\u05d3 (Criterion F) (DSM p.303)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d8\u05d5\u05d5\u05d7 \u05d4\u05d2\u05d9\u05dc\u05d9\u05dd \u05e9\u05d1\u05d5 \u05e0\u05e2\u05e9\u05d4 \u05e9\u05d9\u05de\u05d5\u05e9 \u05d1-Preschool subtype \u05d4\u05d9\u05d9\u05e2\u05d5\u05d3\u05d9 \u05e9\u05dc PTSD \u05d1-DSM-5-TR?",
      "back": "\u05d9\u05dc\u05d3\u05d9\u05dd \u05d1\u05d2\u05d9\u05dc 6 \u05e9\u05e0\u05d9\u05dd \u05d5\u05de\u05d8\u05d4 (Children 6 years and younger) (DSM p.303)."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05e2\u05e9\u05d5\u05d9\u05d9\u05dd \u05ea\u05e1\u05de\u05d9\u05e0\u05d9 \u05e4\u05d5\u05dc\u05e9\u05e0\u05d5\u05ea (Cluster B) \u05dc\u05d4\u05ea\u05d1\u05d8\u05d0 \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05e6\u05e2\u05d9\u05e8\u05d9\u05dd \u05d1\u05d3\u05e8\u05db\u05d9\u05dd \u05e9\u05d0\u05d9\u05e0\u05df \u05de\u05d9\u05dc\u05d5\u05dc\u05d9\u05d5\u05ea?",
      "back": "\u05d3\u05e8\u05da \u05de\u05e9\u05d7\u05e7 \u05d7\u05d5\u05d6\u05e8 (Play reenactment) \u05d4\u05de\u05d1\u05d8\u05d0 \u05ea\u05de\u05d5\u05ea \u05e9\u05dc \u05d4\u05d8\u05e8\u05d0\u05d5\u05de\u05d4 \u05d0\u05d5 \u05d7\u05dc\u05d5\u05de\u05d5\u05ea \u05de\u05e4\u05d7\u05d9\u05d3\u05d9\u05dd \u05dc\u05dc\u05d0 \u05ea\u05d5\u05db\u05df \u05de\u05d6\u05d5\u05d4\u05d4 (DSM p.302, 304)."
    },
    {
      "front": "\u05de\u05e0\u05d4 3 \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05de\u05ea\u05d5\u05da Cluster D (\u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd \u05e9\u05dc\u05d9\u05dc\u05d9\u05d9\u05dd \u05d1\u05e7\u05d5\u05d2\u05e0\u05d9\u05e6\u05d9\u05d4 \u05d5\u05d1\u05de\u05e6\u05d1 \u05d4\u05e8\u05d5\u05d7) \u05d1-PTSD.",
      "back": "\u05d0\u05de\u05e0\u05d6\u05d9\u05d4 \u05d3\u05d9\u05e1\u05d5\u05e6\u05d9\u05d0\u05d8\u05d9\u05d1\u05d9\u05ea, \u05d0\u05de\u05d5\u05e0\u05d5\u05ea \u05e9\u05dc\u05d9\u05dc\u05d9\u05d5\u05ea \u05de\u05d5\u05d2\u05d6\u05de\u05d5\u05ea \u05e2\u05dc \u05d4\u05e2\u05e6\u05de\u05d9/\u05e2\u05d5\u05dc\u05dd, \u05e2\u05d9\u05d5\u05d5\u05ea \u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9 \u05dc\u05d2\u05d1\u05d9 \u05d4\u05d0\u05e9\u05de\u05d4, \u05de\u05e6\u05d1 \u05e8\u05d2\u05e9\u05d9 \u05e9\u05dc\u05d9\u05dc\u05d9, \u05d0\u05e0\u05d4\u05d3\u05d5\u05e0\u05d9\u05d4, \u05d5\u05e0\u05d9\u05ea\u05d5\u05e7 \u05de\u05d0\u05d7\u05e8\u05d9\u05dd (DSM p.302)."
    },
    {
      "front": "\u05d0\u05d9\u05dc\u05d5 \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e0\u05db\u05dc\u05dc\u05d9\u05dd \u05d1-Cluster E (\u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd \u05d1\u05e2\u05d5\u05e8\u05e8\u05d5\u05ea \u05d5\u05d1\u05ea\u05d2\u05d5\u05d1\u05ea\u05d9\u05d5\u05ea) \u05d1\u05d0\u05d1\u05d7\u05e0\u05ea PTSD?",
      "back": "\u05e2\u05e6\u05d1\u05e0\u05d5\u05ea \u05d5\u05d4\u05ea\u05e4\u05e8\u05e6\u05d5\u05d9\u05d5\u05ea \u05db\u05e2\u05e1, \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea Reckless, Hypervigilance, \u05ea\u05d2\u05d5\u05d1\u05ea \u05d1\u05d4\u05dc\u05d4 \u05de\u05d5\u05d2\u05d6\u05de\u05ea, \u05e7\u05e9\u05d9\u05d9 \u05e8\u05d9\u05db\u05d5\u05d6 \u05d5\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05e9\u05d9\u05e0\u05d4 (DSM p.302)."
    },
    {
      "front": "\u05d4\u05d2\u05d3\u05e8 \u05d0\u05ea \u05d4\u05de\u05d5\u05e0\u05d7 Depersonalization \u05d1\u05de\u05e1\u05d2\u05e8\u05ea \u05d4-Dissociative symptoms specifier.",
      "back": "\u05d7\u05d5\u05d5\u05d9\u05d5\u05ea \u05de\u05ea\u05de\u05e9\u05db\u05d5\u05ea \u05e9\u05dc \u05ea\u05d7\u05d5\u05e9\u05ea \u05e0\u05d9\u05ea\u05d5\u05e7 \u05de\u05d4\u05d2\u05d5\u05e3 \u05d0\u05d5 \u05de\u05d4\u05ea\u05d4\u05dc\u05d9\u05db\u05d9\u05dd \u05d4\u05de\u05e0\u05d8\u05dc\u05d9\u05d9\u05dd, \u05db\u05d0\u05d9\u05dc\u05d5 \u05d4\u05d0\u05d3\u05dd \u05d4\u05d5\u05d0 \u05e6\u05d5\u05e4\u05d4 \u05d7\u05d9\u05e6\u05d5\u05e0\u05d9 (DSM p.303)."
    },
    {
      "front": "\u05d4\u05d2\u05d3\u05e8 \u05d0\u05ea \u05d4\u05de\u05d5\u05e0\u05d7 Derealization \u05d1\u05de\u05e1\u05d2\u05e8\u05ea \u05d4-Dissociative symptoms specifier.",
      "back": "\u05d7\u05d5\u05d5\u05d9\u05d5\u05ea \u05de\u05ea\u05de\u05e9\u05db\u05d5\u05ea \u05e9\u05dc \u05ea\u05d7\u05d5\u05e9\u05ea \u05d0\u05d9-\u05de\u05e6\u05d9\u05d0\u05d5\u05ea \u05d0\u05d5 \u05e0\u05d9\u05ea\u05d5\u05e7 \u05de\u05d4\u05e1\u05d1\u05d9\u05d1\u05d4 (\u05d4\u05e2\u05d5\u05dc\u05dd \u05e0\u05e8\u05d0\u05d4 \u05db\u05dc\u05d0 \u05d0\u05de\u05d9\u05ea\u05d9, \u05d7\u05dc\u05d5\u05de\u05d9 \u05d0\u05d5 \u05de\u05e2\u05d5\u05d5\u05ea) (DSM p.303)."
    },
    {
      "front": "\u05de\u05ea\u05d9 \u05e0\u05e9\u05ea\u05de\u05e9 \u05d1-specifier \u05e9\u05dc With delayed expression \u05d1\u05d0\u05d1\u05d7\u05e0\u05ea PTSD?",
      "back": "\u05db\u05d0\u05e9\u05e8 \u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05d4\u05d0\u05d1\u05d7\u05e0\u05ea\u05d9\u05d9\u05dd \u05d4\u05de\u05dc\u05d0\u05d9\u05dd \u05d0\u05d9\u05e0\u05dd \u05de\u05ea\u05de\u05dc\u05d0\u05d9\u05dd \u05d0\u05dc\u05d0 \u05dc\u05e4\u05d7\u05d5\u05ea 6 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05dc\u05d0\u05d7\u05e8 \u05d4\u05d0\u05d9\u05e8\u05d5\u05e2 (DSM p.303)."
    },
    {
      "front": "\u05d1-Preschool subtype, \u05de\u05d4\u05d5 \u05e1\u05e3 \u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d4\u05e0\u05d3\u05e8\u05e9 \u05de\u05ea\u05d5\u05da \u05e8\u05e9\u05d9\u05de\u05ea \u05d4-Avoidance \u05d5\u05d4-Negative Cognitions \u05d4\u05de\u05e9\u05d5\u05dc\u05d1\u05ea?",
      "back": "\u05e0\u05d3\u05e8\u05e9 \u05dc\u05e4\u05d7\u05d5\u05ea \u05ea\u05e1\u05de\u05d9\u05df \u05d0\u05d7\u05d3 (1) \u05de\u05ea\u05d5\u05da \u05e8\u05e9\u05d9\u05de\u05d4 \u05d4\u05db\u05d5\u05dc\u05dc\u05ea \u05d4\u05d9\u05de\u05e0\u05e2\u05d5\u05ea \u05d0\u05d5 \u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd \u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9\u05d9\u05dd/\u05e8\u05d2\u05e9\u05d9\u05d9\u05dd (DSM p.304)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4-Assessment tool \u05d4\u05de\u05e9\u05de\u05e9 \u05dc\u05d8\u05e8\u05d9\u05d0\u05d6' \u05de\u05d4\u05d9\u05e8 \u05d1\u05d0\u05e1\u05d5\u05e0\u05d5\u05ea \u05d4\u05de\u05d5\u05e0\u05d9\u05d9\u05dd \u05dc\u05d4\u05e2\u05e8\u05db\u05ea \u05e1\u05d9\u05db\u05d5\u05df \u05dc-PTSD \u05d5\u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd?",
      "back": "PsySTART (\u05db\u05dc\u05d9 \u05d1\u05df 13 \u05e9\u05d0\u05dc\u05d5\u05ea \u05d4\u05de\u05e2\u05e8\u05d9\u05da \u05d7\u05d5\u05d5\u05d9\u05d5\u05ea \u05d5\u05dc\u05d0 \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd) (Dulcan p.353)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05e8\u05d0\u05d9\u05d5\u05df \u05d4-Assessment \u05d4\u05de\u05d5\u05d1\u05e0\u05d4 \u05d4\u05de\u05e7\u05d9\u05e3 \u05dc\u05d4\u05d5\u05e8\u05d9\u05dd \u05d4\u05de\u05db\u05e1\u05d4 \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9\u05d9\u05dd \u05d1\u05d2\u05d9\u05dc \u05d4\u05e8\u05da?",
      "back": "Preschool Age Psychiatric Assessment (PAPA) (Dulcan p.36)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05de\u05e9\u05da \u05d4\u05d6\u05de\u05df \u05d4\u05de\u05d5\u05d2\u05d3\u05e8 \u05dc\u05d0\u05d1\u05d7\u05e0\u05ea Acute Stress Disorder (ASD) \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR?",
      "back": "\u05de-3 \u05d9\u05de\u05d9\u05dd \u05d5\u05e2\u05d3 \u05d7\u05d5\u05d3\u05e9 \u05d0\u05d7\u05d3 \u05dc\u05db\u05dc \u05d4\u05d9\u05d5\u05ea\u05e8 \u05dc\u05d0\u05d7\u05e8 \u05d4\u05d7\u05e9\u05d9\u05e4\u05d4 \u05dc\u05d8\u05e8\u05d0\u05d5\u05de\u05d4 (DSM p.313)."
    },
    {
      "front": "\u05d1\u05d0\u05d9\u05dc\u05d5 \u05ea\u05e0\u05d0\u05d9\u05dd \u05d7\u05e9\u05d9\u05e4\u05d4 \u05dc\u05e4\u05e8\u05d8\u05d9\u05dd \u05e7\u05e9\u05d9\u05dd \u05d3\u05e8\u05da \u05de\u05d3\u05d9\u05d4 \u05d0\u05dc\u05e7\u05d8\u05e8\u05d5\u05e0\u05d9\u05ea (\u05db\u05d2\u05d5\u05df \u05e1\u05e8\u05d8\u05d5\u05e0\u05d9\u05dd) \u05e0\u05d7\u05e9\u05d1\u05ea \u05dc-Criterion A4?",
      "back": "\u05e8\u05e7 \u05db\u05d0\u05e9\u05e8 \u05d4\u05d7\u05e9\u05d9\u05e4\u05d4 \u05d4\u05d9\u05d0 \u05d7\u05dc\u05e7 \u05de\u05d7\u05d5\u05d1\u05d5\u05ea \u05d4\u05e2\u05d1\u05d5\u05d3\u05d4 (Work related), \u05db\u05d2\u05d5\u05df \u05d0\u05e6\u05dc \u05de\u05e9\u05d9\u05d1\u05d9 \u05e2\u05d6\u05e8\u05d4 \u05e8\u05d0\u05e9\u05d5\u05e0\u05d4 \u05d0\u05d5 \u05e9\u05d5\u05d8\u05e8\u05d9\u05dd (DSM p.301)."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 PTSD \u05de\u05d5\u05d2\u05d3\u05e8\u05ea \u05de\u05d1\u05d7\u05d9\u05e0\u05d4 \u05e0\u05d5\u05d9\u05e8\u05d5\u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea \u05dc\u05e4\u05d9 \u05d4-StahlNeuro?",
      "back": "\u05db\u05d4\u05e4\u05e8\u05e2\u05d4 \u05e9\u05dc Hyperarousal (StahlNeuro p.147)."
    },
    {
      "front": "\u05de\u05ea\u05d9 \u05ea\u05d9\u05e0\u05ea\u05df \u05d0\u05d1\u05d7\u05e0\u05ea Adjustment Disorder \u05d1\u05ea\u05d2\u05d5\u05d1\u05d4 \u05dc\u05d0\u05d9\u05e8\u05d5\u05e2 \u05d8\u05e8\u05d0\u05d5\u05de\u05d8\u05d9 \u05d1\u05de\u05e7\u05d5\u05dd PTSD?",
      "back": "\u05db\u05d0\u05e9\u05e8 \u05d4\u05ea\u05d2\u05d5\u05d1\u05d4 \u05d0\u05d9\u05e0\u05d4 \u05e2\u05d5\u05de\u05d3\u05ea \u05d1\u05e1\u05e3 \u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e9\u05dc PTSD/ASD, \u05d0\u05d5 \u05db\u05e9\u05d2\u05d5\u05e8\u05dd \u05d4\u05d3\u05d7\u05e7 \u05d0\u05d9\u05e0\u05d5 \u05e2\u05d5\u05de\u05d3 \u05d1-Criterion A (DSM p.319-321)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05e9\u05d9\u05e0\u05d5\u05d9 \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05d1-DSM-5 \u05dc\u05d2\u05d1\u05d9 \u05ea\u05d2\u05d5\u05d1\u05ea \u05d4\u05d0\u05d3\u05dd \u05d1\u05d6\u05de\u05df \u05d4\u05d0\u05d9\u05e8\u05d5\u05e2 (Criterion A2 \u05dc\u05e9\u05e2\u05d1\u05e8)?",
      "back": "\u05d1\u05d5\u05d8\u05dc\u05d4 \u05d4\u05d3\u05e8\u05d9\u05e9\u05d4 \u05e9\u05d4\u05d0\u05d3\u05dd \u05d9\u05d2\u05d9\u05d1 \u05dc\u05e4\u05d7\u05d3 \u05e2\u05d6, \u05d7\u05d5\u05e1\u05e8 \u05d0\u05d5\u05e0\u05d9\u05dd \u05d0\u05d5 \u05d0\u05d9\u05de\u05d4 \u05d1\u05d6\u05de\u05df \u05d4\u05d7\u05e9\u05d9\u05e4\u05d4 (Dulcan p.350)."
    },
    {
