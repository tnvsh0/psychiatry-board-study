      ],
      "hint": "\u05d4\u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05d4\u05dc\u05dc\u05d5 \u05e0\u05e7\u05e8\u05d0\u05d5\u05ea \u05dc\u05e2\u05d9\u05ea\u05d9\u05dd 'Neuroleptics' \u05d1\u05e9\u05dc \u05d9\u05db\u05d5\u05dc\u05ea\u05df \u05dc\u05d7\u05e1\u05d5\u05dd \u05de\u05e1\u05dc\u05d5\u05dc \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9 \u05d4\u05e7\u05e9\u05d5\u05e8 \u05dc\u05ea\u05d2\u05de\u05d5\u05dc \u05d5\u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d4.",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05d1\u05de\u05d4\u05dc\u05da \u05d1\u05d9\u05e7\u05d5\u05e8 \u05d1\u05de\u05d9\u05d5\u05df, \u05de\u05ea\u05d1\u05d2\u05e8 \u05d4\u05e1\u05d5\u05d1\u05dc \u05de-Psychosis \u05de\u05d8\u05d5\u05e4\u05dc \u05d1\u05de\u05e0\u05d4 \u05d7\u05e8\u05d9\u05e4\u05d4 \u05e9\u05dc Chlorpromazine (FGA \u05d1\u05e2\u05dc Potency \u05e0\u05de\u05d5\u05da). \u05d1\u05e2\u05ea \u05d4\u05e7\u05d9\u05de\u05d4 \u05de\u05d4\u05de\u05d9\u05d8\u05d4 \u05d4\u05d5\u05d0 \u05de\u05ea\u05dc\u05d5\u05e0\u05df \u05e2\u05dc \u05e1\u05d7\u05e8\u05d7\u05d5\u05e8\u05ea \u05e7\u05e9\u05d4 \u05d5\u05de\u05ea\u05e2\u05dc\u05e3 (Syncope). \u05de\u05d4\u05d5 \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05e1\u05d1\u05d9\u05e8 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05ea\u05d5\u05e4\u05e2\u05d4 \u05d6\u05d5?",
      "answerOptions": [
        {
          "text": "\u05d7\u05e1\u05d9\u05de\u05ea \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 $\\alpha_1$-adrenergic.",
          "isCorrect": true,
          "rationale": "\u05ea\u05e8\u05d5\u05e4\u05d5\u05ea Low potency \u05db\u05de\u05d5 Chlorpromazine \u05d7\u05d5\u05e1\u05de\u05d5\u05ea \u05d1\u05e2\u05d5\u05e6\u05de\u05d4 \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 $\\alpha_1$, \u05de\u05d4 \u05e9\u05de\u05d5\u05d1\u05d9\u05dc \u05dc-Vasodilation \u05d5-Orthostatic hypotension (StahlNeuro p.201, p.204)."
        },
        {
          "text": "\u05d7\u05e1\u05d9\u05de\u05ea \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 Muscarinic $M_1$.",
          "isCorrect": false,
          "rationale": "\u05d7\u05e1\u05d9\u05de\u05d4 \u05db\u05d5\u05dc\u05d9\u05e0\u05e8\u05d2\u05d9\u05ea \u05d2\u05d5\u05e8\u05de\u05ea \u05dc\u05d9\u05d5\u05d1\u05e9 \u05d1\u05e4\u05d4, \u05e2\u05e6\u05d9\u05e8\u05d5\u05ea \u05d5\u05d8\u05e9\u05d8\u05d5\u05e9 \u05e8\u05d0\u05d9\u05d9\u05d4, \u05d0\u05da \u05dc\u05d0 \u05dc\u05d9\u05e8\u05d9\u05d3\u05ea \u05dc\u05d7\u05e5 \u05d3\u05dd \u05ea\u05e0\u05d5\u05d7\u05ea\u05d9\u05ea (StahlNeuro p.166)."
        },
        {
          "text": "\u05d7\u05e1\u05d9\u05de\u05ea \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 $H_1$ (Histamine).",
          "isCorrect": false,
          "rationale": "\u05d7\u05e1\u05d9\u05de\u05ea \u05d4\u05d9\u05e1\u05d8\u05de\u05d9\u05df \u05d2\u05d5\u05e8\u05de\u05ea \u05d1\u05e2\u05d9\u05e7\u05e8 \u05dc\u05e1\u05d3\u05e6\u05d9\u05d4 (Sedation) \u05d5\u05e2\u05dc\u05d9\u05d9\u05d4 \u05d1\u05de\u05e9\u05e7\u05dc (StahlNeuro p.202)."
        },
        {
          "text": "\u05e2\u05dc\u05d9\u05d9\u05d4 \u05d7\u05e8\u05d9\u05e4\u05d4 \u05d1\u05e8\u05de\u05ea \u05d4-Prolactin.",
          "isCorrect": false,
          "rationale": "\u05e2\u05dc\u05d9\u05d9\u05ea \u05e4\u05e8\u05d5\u05dc\u05e7\u05d8\u05d9\u05df \u05de\u05e9\u05e4\u05d9\u05e2\u05d4 \u05e2\u05dc \u05ea\u05e4\u05e7\u05d5\u05d3 \u05de\u05d9\u05e0\u05d9 \u05d5\u05d2\u05e0\u05d9\u05e7\u05d5\u05de\u05e1\u05d8\u05d9\u05d4, \u05d0\u05da \u05d0\u05d9\u05e0\u05d4 \u05d2\u05d5\u05e8\u05de\u05ea \u05dc\u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd \u05d4\u05de\u05d5\u05d3\u05d9\u05e0\u05de\u05d9\u05d9\u05dd \u05de\u05d9\u05d9\u05d3\u05d9\u05d9\u05dd (StahlNeuro p.195)."
        }
      ],
      "hint": "\u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05d1\u05e2\u05dc\u05d5\u05ea \u05e4\u05d5\u05d8\u05e0\u05d8\u05d9\u05d5\u05ea \u05e0\u05de\u05d5\u05db\u05d4 \u05de\u05e9\u05e4\u05d9\u05e2\u05d5\u05ea \u05d9\u05d5\u05ea\u05e8 \u05e2\u05dc \u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05dc\u05d7\u05e5 \u05d4\u05d3\u05dd \u05d4\u05d0\u05d5\u05d8\u05d5\u05e0\u05d5\u05de\u05d9\u05ea.",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05d4\u05d5\u05e8\u05d9\u05dd \u05dc\u05d9\u05dc\u05d3 \u05d1\u05df 8 \u05d4\u05e1\u05d5\u05d1\u05dc \u05de-ADHD \u05e2\u05dd Conduct Disorder \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9 \u05de\u05d1\u05e7\u05e9\u05d9\u05dd \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Chlorpromazine \u05dc\"\u05e9\u05dc\u05d9\u05d8\u05d4 \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea\u05d9\u05ea\". \u05de\u05d4\u05d9 \u05d4\u05e2\u05de\u05d3\u05d4 \u05d4\u05e2\u05d3\u05db\u05e0\u05d9\u05ea \u05e9\u05dc \u05d4\u05e4\u05e1\u05d9\u05db\u05d5\u05e4\u05e8\u05de\u05e7\u05d5\u05dc\u05d5\u05d2\u05d9\u05d4 \u05d4\u05de\u05d5\u05d3\u05e8\u05e0\u05d9\u05ea \u05dc\u05d2\u05d1\u05d9 \u05e9\u05d9\u05de\u05d5\u05e9 \u05d6\u05d4?",
      "answerOptions": [
        {
          "text": "\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1-FGA \u05dc\u05e9\u05dc\u05d9\u05d8\u05d4 \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea\u05d9\u05ea \u05dc\u05dc\u05d0 \u05d0\u05d1\u05d7\u05e0\u05d4 \u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9\u05ea \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05ea \u05e0\u05d7\u05e9\u05d1 \u05dc-Misuse \u05d5\u05d0\u05d9\u05e0\u05d5 \u05de\u05d5\u05de\u05dc\u05e5 (Best practice).",
          "isCorrect": true,
          "rationale": "\u05d1\u05e2\u05d1\u05e8 \u05d0\u05d5\u05e9\u05e8 \u05d4\u05e9\u05d9\u05de\u05d5\u05e9 \u05dc\"\u05d1\u05e2\u05d9\u05d5\u05ea \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05e7\u05e9\u05d5\u05ea\", \u05d0\u05da \u05db\u05d9\u05d5\u05dd \u05d4\u05d2\u05d9\u05e9\u05d4 \u05de\u05d7\u05d9\u05d9\u05d1\u05ea \u05d0\u05d1\u05d7\u05e0\u05d4 \u05de\u05d3\u05d5\u05d9\u05e7\u05ea \u05d5\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05e9\u05dc \u05d4\u05de\u05d7\u05dc\u05d4 \u05d4\u05d1\u05e1\u05d9\u05e1\u05d9\u05ea, \u05de\u05d7\u05e9\u05e9 \u05dc\u05d9\u05e6\u05d9\u05e8\u05ea \"Chemical straightjackets\" (StahlKids p.105, p.403)."
        },
        {
          "text": "\u05d6\u05d4\u05d5 \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05de\u05d5\u05e2\u05d3\u05e3 \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd \u05d4\u05ea\u05e4\u05e8\u05e6\u05d5\u05d9\u05d5\u05ea \u05d0\u05d2\u05e8\u05e1\u05d9\u05d1\u05d9\u05d5\u05ea \u05d1\u05e9\u05dc \u05d4\u05d9\u05e2\u05d9\u05dc\u05d5\u05ea \u05d4\u05de\u05d5\u05db\u05d7\u05ea.",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05d9\u05e2\u05d9\u05dc\u05d5\u05ea \u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05ea, \u05ea\u05d5\u05e4\u05e2\u05d5\u05ea \u05d4\u05dc\u05d5\u05d5\u05d0\u05d9 (EPS, TD) \u05d5\u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05e1\u05d3\u05e6\u05d9\u05d4 \u05d4\u05d5\u05e4\u05db\u05d9\u05dd \u05d0\u05ea \u05d4-FGAs \u05dc\u05e7\u05d5 \u05e9\u05e0\u05d9 \u05d0\u05d5 \u05e9\u05dc\u05d9\u05e9\u05d9 (StahlKids p.108)."
        },
        {
          "text": "Chlorpromazine \u05d1\u05d8\u05d5\u05d7 \u05d9\u05d5\u05ea\u05e8 \u05de-Stimulants \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-ADHD \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05e6\u05e2\u05d9\u05e8\u05d9\u05dd.",
          "isCorrect": false,
          "rationale": "\u05de\u05de\u05e8\u05d9\u05e6\u05d9\u05dd \u05d4\u05dd \u05e7\u05d5 \u05e8\u05d0\u05e9\u05d5\u05df \u05dc-ADHD. Chlorpromazine \u05d0\u05d9\u05e0\u05d5 \u05de\u05d8\u05e4\u05dc \u05d1\u05dc\u05d9\u05d1\u05ea \u05d4\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05e9\u05dc ADHD \u05d5\u05d8\u05d5\u05de\u05df \u05d1\u05d7\u05d5\u05d1\u05d5 \u05e1\u05d9\u05db\u05d5\u05e0\u05d9\u05dd \u05e0\u05d5\u05d9\u05e8\u05d5\u05dc\u05d5\u05d2\u05d9\u05d9\u05dd \u05d0\u05e8\u05d5\u05db\u05d9 \u05d8\u05d5\u05d5\u05d7 (StahlKids p.105)."
        },
        {
          "text": "\u05e0\u05d9\u05ea\u05df \u05dc\u05d4\u05e9\u05ea\u05de\u05e9 \u05d1\u05ea\u05e8\u05d5\u05e4\u05d4 \u05d1\u05d0\u05d5\u05e4\u05df \u05d7\u05d5\u05e4\u05e9\u05d9 \u05d0\u05dd \u05d4\u05d9\u05dc\u05d3 \u05e0\u05de\u05e6\u05d0 \u05d1\u05de\u05e1\u05d2\u05e8\u05ea \u05e9\u05dc \u05e4\u05e0\u05d9\u05de\u05d9\u05d9\u05d4 \u05d0\u05d5 \u05d0\u05d5\u05de\u05e0\u05d4.",
          "isCorrect": false,
          "rationale": "\u05d9\u05dc\u05d3\u05d9\u05dd \u05d1\u05de\u05e2\u05e8\u05db\u05d5\u05ea \u05d0\u05d5\u05de\u05e0\u05d4 (Foster care) \u05e0\u05d7\u05e9\u05d1\u05d9\u05dd \u05dc\u05d0\u05d5\u05db\u05dc\u05d5\u05e1\u05d9\u05d9\u05d4 \u05e4\u05d2\u05d9\u05e2\u05d4 \u05d1\u05de\u05d9\u05d5\u05d7\u05d3, \u05d5\u05d4\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05d0\u05dc\u05d5 \u05dc\u05dc\u05d0 \u05d0\u05d1\u05d7\u05e0\u05d4 \u05de\u05d3\u05d5\u05d9\u05e7\u05ea \u05d0\u05e1\u05d5\u05e8 \u05d0\u05d5 \u05de\u05d5\u05d2\u05d1\u05dc \u05de\u05d0\u05d5\u05d3 (StahlKids p.105, p.404)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05d0\u05ea\u05d9\u05e7\u05d4 \u05e9\u05dc '\u05e8\u05d9\u05e1\u05d5\u05df \u05db\u05d9\u05de\u05d9' \u05de\u05d5\u05dc \u05d8\u05d9\u05e4\u05d5\u05dc \u05de\u05de\u05d5\u05e7\u05d3 \u05d0\u05d1\u05d7\u05e0\u05d4.",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05de\u05d8\u05d5\u05e4\u05dc \u05de\u05e4\u05ea\u05d7 \u05ea\u05d2\u05d5\u05d1\u05d4 \u05e9\u05dc Acute Laryngeal Dystonia \u05d6\u05de\u05df \u05e7\u05e6\u05e8 \u05dc\u05d0\u05d7\u05e8 \u05ea\u05d7\u05d9\u05dc\u05ea \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Haloperidol. \u05de\u05d4\u05d5 \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05d4\u05de\u05d9\u05d9\u05d3\u05d9 \u05d5\u05de\u05d4\u05d5 \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05e0\u05d3\u05e8\u05e9?",
      "answerOptions": [
        {
          "text": "\u05d7\u05e1\u05d9\u05de\u05ea \u05d3\u05e8\u05db\u05d9 \u05e0\u05e9\u05d9\u05de\u05d4 (Airway obstruction); \u05d8\u05d9\u05e4\u05d5\u05dc \u05de\u05d9\u05d9\u05d3\u05d9 \u05d1-IM/IV Benztropine.",
          "isCorrect": true,
          "rationale": "\u05d3\u05d9\u05e1\u05d8\u05d5\u05e0\u05d9\u05d4 \u05e9\u05dc \u05e9\u05e8\u05d9\u05e8\u05d9 \u05d4\u05dc\u05e8\u05d9\u05e0\u05e7\u05e1 \u05d4\u05d9\u05d0 \u05de\u05e6\u05d1 \u05d7\u05d9\u05e8\u05d5\u05dd \u05de\u05e1\u05db\u05df \u05d7\u05d9\u05d9\u05dd \u05e9\u05e2\u05dc\u05d5\u05dc \u05dc\u05d4\u05d5\u05d1\u05d9\u05dc \u05dc\u05d7\u05e0\u05e7, \u05d5\u05de\u05d7\u05d9\u05d9\u05d1 \u05d8\u05d9\u05e4\u05d5\u05dc \u05d0\u05e0\u05d8\u05d9-\u05db\u05d5\u05dc\u05d9\u05e0\u05e8\u05d2\u05d9 \u05de\u05d4\u05d9\u05e8 (DSM p.812)."
        },
        {
          "text": "\u05e9\u05d0\u05d9\u05e4\u05ea \u05de\u05d6\u05d5\u05df (Aspiration); \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05e4\u05d9\u05d6\u05d9\u05d5\u05ea\u05e8\u05e4\u05d9\u05d4 \u05e0\u05e9\u05d9\u05de\u05ea\u05d9\u05ea.",
          "isCorrect": false,
          "rationale": "\u05d1\u05e2\u05d5\u05d3 \u05e9\u05d3\u05d9\u05e1\u05e4\u05d0\u05d2\u05d9\u05d4 (\u05d4\u05e4\u05e8\u05e2\u05ea \u05d1\u05dc\u05d9\u05e2\u05d4) \u05e7\u05d9\u05d9\u05de\u05ea \u05d1\u05d3\u05d9\u05e1\u05d8\u05d5\u05e0\u05d9\u05d4 \u05d0\u05d5\u05e8\u05d5\u05e4\u05e8\u05d9\u05e0\u05d2\u05d9\u05d0\u05dc\u05d9\u05ea, \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05d4\u05de\u05d9\u05d9\u05d3\u05d9 \u05d1\u05dc\u05e8\u05d9\u05e0\u05d2\u05d5\u05e1\u05e4\u05d0\u05d6\u05dd \u05d4\u05d5\u05d0 \u05d7\u05e1\u05d9\u05de\u05ea \u05e0\u05ea\u05d9\u05d1 \u05d4\u05d0\u05d5\u05d5\u05d9\u05e8 \u05e2\u05e6\u05de\u05d5 (DSM p.812)."
        },
        {
          "text": "\u05e4\u05e8\u05db\u05d5\u05e1 \u05de\u05e1\u05d5\u05d2 Tonic-clonic; \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Diazepam.",
          "isCorrect": false,
          "rationale": "\u05d3\u05d9\u05e1\u05d8\u05d5\u05e0\u05d9\u05d4 \u05d4\u05d9\u05d0 \u05d4\u05e4\u05e8\u05e2\u05ea \u05ea\u05e0\u05d5\u05e2\u05d4 \u05d7\u05d5\u05e5-\u05e4\u05d9\u05e8\u05de\u05d9\u05d3\u05dc\u05d9\u05ea (EPS) \u05d5\u05dc\u05d0 \u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05d0\u05e4\u05d9\u05dc\u05e4\u05d8\u05d9\u05ea, \u05d5\u05dc\u05db\u05df \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05d1\u05e0\u05d6\u05d5\u05d3\u05d9\u05d0\u05d6\u05e4\u05d9\u05e0\u05d9\u05dd \u05d1\u05dc\u05d1\u05d3 \u05d0\u05d9\u05e0\u05d5 \u05d4\u05e7\u05d5 \u05d4\u05e8\u05d0\u05e9\u05d5\u05df (StahlNeuro p.169)."
        },
        {
          "text": "\u05ea\u05d2\u05d5\u05d1\u05d4 \u05d0\u05e0\u05e4\u05d9\u05dc\u05e7\u05d8\u05d9\u05ea; \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Epinephrine.",
          "isCorrect": false,
          "rationale": "\u05d4\u05ea\u05d5\u05e4\u05e2\u05d4 \u05e0\u05d5\u05d1\u05e2\u05ea \u05de\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d3\u05d5\u05e4\u05de\u05d9\u05e0\u05e8\u05d2\u05d9-\u05db\u05d5\u05dc\u05d9\u05e0\u05e8\u05d2\u05d9 \u05d5\u05dc\u05d0 \u05de\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d0\u05dc\u05e8\u05d2\u05d9 \u05e9\u05dc IgE (DSM p.813)."
        }
      ],
      "hint": "\u05de\u05d3\u05d5\u05d1\u05e8 \u05d1\u05de\u05e7\u05e8\u05d4 \u05d7\u05d9\u05e8\u05d5\u05dd \u05e9\u05dc \u05e0\u05ea\u05d9\u05d1 \u05d0\u05d5\u05d5\u05d9\u05e8 \u05d4\u05e0\u05d2\u05e8\u05dd \u05de\u05d4\u05ea\u05db\u05d5\u05d5\u05e6\u05d5\u05ea \u05e9\u05e8\u05d9\u05e8\u05d9\u05dd.",
