        {
          "text": "\u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05de\u05d0\u05d5\u05e9\u05e8 \u05d4\u05d9\u05d7\u05d9\u05d3 \u05d4\u05d5\u05d0 \u05d4\u05d5\u05e1\u05e4\u05ea Benzodiazepines.",
          "isCorrect": false,
          "rationale": "\u05d1\u05e2\u05d5\u05d3 \u05e9\u05d1\u05e0\u05d6\u05d5\u05d3\u05d9\u05d0\u05d6\u05e4\u05d9\u05e0\u05d9\u05dd \u05e2\u05e9\u05d5\u05d9\u05d9\u05dd \u05dc\u05e2\u05d6\u05d5\u05e8 \u05de\u05e2\u05d8, \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05de\u05d0\u05d5\u05e9\u05e8 \u05d5\u05d4\u05d9\u05d9\u05e2\u05d5\u05d3\u05d9 \u05db\u05d9\u05d5\u05dd \u05d4\u05d5\u05d0 \u05de\u05e2\u05db\u05d1\u05d9 VMAT2 (StahlNeuro p.173, DSM p.816)."
        }
      ],
      "hint": "\u05de\u05d3\u05d5\u05d1\u05e8 \u05d1\u05ea\u05d5\u05e4\u05e2\u05d4 \u05de\u05d0\u05d5\u05d7\u05e8\u05ea (Tardive) \u05d4\u05e0\u05d5\u05d1\u05e2\u05ea \u05de\u05e8\u05d2\u05d9\u05e9\u05d5\u05ea-\u05d9\u05ea\u05e8 \u05e9\u05dc \u05e8\u05e6\u05e4\u05d8\u05d5\u05e8\u05d9\u05dd \u05d3\u05d5\u05e4\u05de\u05d9\u05e0\u05e8\u05d2\u05d9\u05d9\u05dd.",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05de\u05d4\u05d5 \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05e0\u05d5\u05d9\u05e8\u05d5\u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d4\u05e2\u05d9\u05e7\u05e8\u05d9 \u05d4\u05e2\u05d5\u05de\u05d3 \u05d1\u05d1\u05e1\u05d9\u05e1 \u05d4-Antipsychotic action \u05e9\u05dc \u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05de\u05d4\u05d3\u05d5\u05e8 \u05d4\u05e8\u05d0\u05e9\u05d5\u05df (FGA)?",
      "answerOptions": [
