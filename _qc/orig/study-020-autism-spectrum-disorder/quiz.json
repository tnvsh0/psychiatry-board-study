{
  "title": "Autism Quiz",
  "questions": [
    {
      "question": "\u05d1\u05df 4 \u05de\u05d5\u05e4\u05e0\u05d4 \u05dc\u05d4\u05e2\u05e8\u05db\u05d4 \u05e2\u05e7\u05d1 \u05d0\u05d9\u05d7\u05d5\u05e8 \u05e9\u05e4\u05ea\u05d9. \u05d1\u05d1\u05d3\u05d9\u05e7\u05d4 \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05e2\u05d5\u05dc\u05d4 \u05db\u05d9 \u05d4\u05d5\u05d0 \u05de\u05ea\u05e7\u05e9\u05d4 \u05d1\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05e9\u05e4\u05d4 \u05dc\u05de\u05d8\u05e8\u05d5\u05ea \u05d7\u05d1\u05e8\u05ea\u05d9\u05d5\u05ea, \u05d0\u05d9\u05e0\u05d5 \u05de\u05d2\u05d9\u05d1 \u05dc\u05e7\u05e8\u05d9\u05d0\u05ea \u05e9\u05de\u05d5 \u05dc\u05e2\u05d9\u05ea\u05d9\u05dd \u05e7\u05e8\u05d5\u05d1\u05d5\u05ea, \u05d5\u05de\u05ea\u05e7\u05e9\u05d4 \u05d1\u05d4\u05d1\u05e0\u05ea \u05de\u05d7\u05d5\u05d5\u05ea \u05d2\u05d5\u05e4\u05e0\u05d9\u05d5\u05ea. \u05e2\u05dd \u05d6\u05d0\u05ea, \u05d4\u05d4\u05d5\u05e8\u05d9\u05dd \u05e9\u05d5\u05dc\u05dc\u05d9\u05dd \u05d3\u05e4\u05d5\u05e1\u05d9 \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05e1\u05d8\u05e8\u05d9\u05d0\u05d5\u05d8\u05d9\u05e4\u05d9\u05d9\u05dd \u05d0\u05d5 \u05ea\u05d7\u05d5\u05de\u05d9 \u05e2\u05e0\u05d9\u05d9\u05df \u05de\u05e6\u05d5\u05de\u05e6\u05de\u05d9\u05dd \u05d5\u05e0\u05d5\u05e7\u05e9\u05d9\u05dd, \u05d5\u05d2\u05dd \u05d1\u05ea\u05e6\u05e4\u05d9\u05ea \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05dc\u05d0 \u05e0\u05e6\u05e4\u05d5 \u05db\u05d0\u05dc\u05d5. \u05de\u05d4\u05d9 \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05de\u05ea\u05d0\u05d9\u05de\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR?",
      "answerOptions": [
        {
          "text": "Social (Pragmatic) Communication Disorder (SPCD)",
          "isCorrect": true,
          "rationale": "\u05d0\u05d1\u05d7\u05e0\u05ea SPCD \u05e0\u05d9\u05ea\u05e0\u05ea \u05db\u05d0\u05e9\u05e8 \u05e7\u05d9\u05d9\u05de\u05d9\u05dd \u05dc\u05d9\u05e7\u05d5\u05d9\u05d9\u05dd \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05d9\u05dd \u05d1\u05ea\u05e7\u05e9\u05d5\u05e8\u05ea \u05d7\u05d1\u05e8\u05ea\u05d9\u05ea, \u05d0\u05da \u05d0\u05d9\u05df \u05e2\u05d3\u05d5\u05ea (\u05d1\u05d4\u05d5\u05d5\u05d4 \u05d0\u05d5 \u05d1\u05e2\u05d1\u05e8) \u05dc\u05e7\u05d9\u05d5\u05dd \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df B \u05e9\u05dc ASD, \u05e7\u05e8\u05d9 \u05d3\u05e4\u05d5\u05e1\u05d9\u05dd \u05d7\u05d6\u05e8\u05ea\u05d9\u05d9\u05dd \u05d5\u05de\u05e6\u05d5\u05de\u05e6\u05de\u05d9\u05dd \u05e9\u05dc \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d0\u05d5 \u05ea\u05d7\u05d5\u05de\u05d9 \u05e2\u05e0\u05d9\u05d9\u05df."
        },
        {
          "text": "Autism Spectrum Disorder (ASD)",
          "isCorrect": false,
          "rationale": "\u05dc\u05e4\u05d9 \u05d4-DSM-5-TR, \u05d0\u05d1\u05d7\u05e0\u05ea ASD \u05de\u05d7\u05d9\u05d9\u05d1\u05ea \u05e2\u05d3\u05d5\u05ea \u05dc\u05e7\u05d9\u05d5\u05dd \u05d3\u05e4\u05d5\u05e1\u05d9\u05dd \u05d7\u05d6\u05e8\u05ea\u05d9\u05d9\u05dd \u05d5\u05de\u05e6\u05d5\u05de\u05e6\u05de\u05d9\u05dd (Criterion B) \u05d1\u05d4\u05d5\u05d5\u05d4 \u05d0\u05d5 \u05d1\u05e2\u05d1\u05e8, \u05de\u05d4 \u05e9\u05d0\u05d9\u05e0\u05d5 \u05de\u05ea\u05e7\u05d9\u05d9\u05dd \u05d1\u05de\u05e7\u05e8\u05d4 \u05d6\u05d4."
        },
        {
          "text": "Intellectual Developmental Disorder (ID)",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05e9-ID \u05d9\u05db\u05d5\u05dc \u05dc\u05d4\u05d5\u05d1\u05d9\u05dc \u05dc\u05d0\u05d9\u05d7\u05d5\u05e8 \u05e9\u05e4\u05ea\u05d9, \u05d4\u05e4\u05e8\u05d5\u05e4\u05d9\u05dc \u05d4\u05de\u05ea\u05d5\u05d0\u05e8 \u05de\u05ea\u05de\u05e7\u05d3 \u05d1\u05dc\u05d9\u05e7\u05d5\u05d9 \u05d0\u05d9\u05db\u05d5\u05ea\u05d9 \u05d1\u05ea\u05e7\u05e9\u05d5\u05e8\u05ea \u05d7\u05d1\u05e8\u05ea\u05d9\u05ea \u05dc\u05dc\u05d0 \u05e2\u05d3\u05d5\u05ea \u05dc\u05e4\u05d2\u05d9\u05e2\u05d4 \u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9\u05ea \u05d2\u05dc\u05d5\u05d1\u05dc\u05d9\u05ea."
        },
        {
          "text": "Stereotypic Movement Disorder",
          "isCorrect": false,
          "rationale": "\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d6\u05d5 \u05d0\u05d9\u05e0\u05d4 \u05de\u05ea\u05d0\u05d9\u05de\u05d4 \u05e9\u05db\u05df \u05d4\u05de\u05e7\u05e8\u05d4 \u05de\u05ea\u05de\u05e7\u05d3 \u05d1\u05dc\u05d9\u05e7\u05d5\u05d9\u05d9 \u05ea\u05e7\u05e9\u05d5\u05e8\u05ea \u05d5\u05d1\u05d0\u05d5\u05e4\u05df \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9 \u05e6\u05d5\u05d9\u05df \u05db\u05d9 \u05d0\u05d9\u05df \u05ea\u05e0\u05d5\u05e2\u05d5\u05ea \u05e1\u05d8\u05e8\u05d9\u05d0\u05d5\u05d8\u05d9\u05e4\u05d9\u05d5\u05ea."
        }
      ],
      "hint": "\u05d4\u05ea\u05de\u05e7\u05d3 \u05d1\u05d4\u05d1\u05d3\u05dc \u05d4\u05e2\u05d9\u05e7\u05e8\u05d9 \u05d1\u05d9\u05df \u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05d1\u05e1\u05e4\u05e7\u05d8\u05e8\u05d5\u05dd \u05d4\u05d0\u05d5\u05d8\u05d9\u05e1\u05d8\u05d9 \u05dc\u05d1\u05d9\u05df \u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05ea\u05e7\u05e9\u05d5\u05e8\u05ea \u05d7\u05d1\u05e8\u05ea\u05d9\u05d5\u05ea \u05d0\u05d7\u05e8\u05d5\u05ea.",
      "citation": "(DSM p.57, p.67)"
    },
    {
      "question": "\u05d9\u05dc\u05d3 \u05d1\u05df 5 \u05e2\u05dd \u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc ASD \u05de\u05e6\u05d9\u05d2 \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05e0\u05d5\u05e7\u05e9\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8, \u05e7\u05d5\u05e9\u05d9 \u05e7\u05d9\u05e6\u05d5\u05e0\u05d9 \u05d1\u05de\u05e2\u05d1\u05e8\u05d9\u05dd \u05d1\u05d9\u05df \u05e4\u05e2\u05d9\u05dc\u05d5\u05d9\u05d5\u05ea, \u05d5\u05de\u05e6\u05d5\u05e7\u05d4 \u05e8\u05d1\u05d4 \u05d1\u05e2\u05ea \u05e9\u05d9\u05e0\u05d5\u05d9 \u05e7\u05d8\u05df \u05d1\u05e9\u05d2\u05e8\u05d4 (\u05db\u05d2\u05d5\u05df \u05de\u05e1\u05dc\u05d5\u05dc \u05e0\u05e1\u05d9\u05e2\u05d4 \u05e9\u05d5\u05e0\u05d4). \u05e7\u05e9\u05d9\u05d9\u05dd \u05d0\u05dc\u05d5 \u05de\u05e4\u05e8\u05d9\u05e2\u05d9\u05dd \u05d1\u05d0\u05d5\u05e4\u05df \u05e0\u05d9\u05db\u05e8 \u05dc\u05ea\u05e4\u05e7\u05d5\u05d3\u05d5 \u05d1\u05db\u05dc \u05ea\u05d7\u05d5\u05de\u05d9 \u05d4\u05d7\u05d9\u05d9\u05dd. \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR, \u05d0\u05d9\u05d6\u05d4 severity level \u05de\u05ea\u05d0\u05e8 \u05d1\u05e6\u05d5\u05e8\u05d4 \u05d4\u05d8\u05d5\u05d1\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d0\u05ea \u05d4-Restricted, repetitive behaviors \u05e9\u05dc\u05d5?",
      "answerOptions": [
        {
          "text": "Level 1 (Requiring support)",
          "isCorrect": false,
          "rationale": "\u05d1\u05e8\u05de\u05d4 1 \u05d4\u05e0\u05d5\u05e7\u05e9\u05d5\u05ea \u05d2\u05d5\u05e8\u05de\u05ea \u05dc\u05d4\u05e4\u05e8\u05e2\u05d4 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05d1\u05ea\u05e4\u05e7\u05d5\u05d3 \u05d1\u05d4\u05e7\u05e9\u05e8 \u05d0\u05d7\u05d3 \u05d0\u05d5 \u05d9\u05d5\u05ea\u05e8, \u05d0\u05da \u05dc\u05d0 \u05dc\u05e8\u05de\u05d4 \u05e9\u05dc \u05de\u05e6\u05d5\u05e7\u05d4 \u05e7\u05d9\u05e6\u05d5\u05e0\u05d9\u05ea \u05d5\u05d4\u05e4\u05e8\u05e2\u05d4 \u05d2\u05dc\u05d5\u05d1\u05dc\u05d9\u05ea \u05d1\u05db\u05dc \u05d4\u05ea\u05d7\u05d5\u05de\u05d9\u05dd."
        },
        {
          "text": "Level 2 (Requiring substantial support)",
          "isCorrect": false,
          "rationale": "\u05d1\u05e8\u05de\u05d4 2 \u05d4\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05d9\u05d5\u05ea \u05d4\u05d7\u05d6\u05e8\u05ea\u05d9\u05d5\u05ea \u05de\u05d5\u05e4\u05d9\u05e2\u05d5\u05ea \u05d1\u05ea\u05d3\u05d9\u05e8\u05d5\u05ea \u05d2\u05d1\u05d5\u05d4\u05d4 \u05d5\u05e0\u05d9\u05db\u05e8\u05d5\u05ea \u05dc\u05e6\u05d5\u05e4\u05d4 \u05de\u05d6\u05d3\u05de\u05df, \u05d0\u05da \u05d4\u05de\u05e6\u05d5\u05e7\u05d4 \u05d5\u05d4\u05d4\u05e4\u05e8\u05e2\u05d4 \u05e4\u05d7\u05d5\u05ea \u05e7\u05d9\u05e6\u05d5\u05e0\u05d9\u05d5\u05ea \u05de\u05d4\u05de\u05ea\u05d5\u05d0\u05e8."
        },
        {
          "text": "Level 3 (Requiring very substantial support)",
          "isCorrect": true,
          "rationale": "\u05e8\u05de\u05d4 3 \u05de\u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05ea \u05d1\u05e0\u05d5\u05e7\u05e9\u05d5\u05ea \u05e7\u05d9\u05e6\u05d5\u05e0\u05d9\u05ea, \u05e7\u05d5\u05e9\u05d9 \u05e8\u05d1 \u05d1\u05d4\u05ea\u05de\u05d5\u05d3\u05d3\u05d5\u05ea \u05e2\u05dd \u05e9\u05d9\u05e0\u05d5\u05d9, \u05d5\u05de\u05e6\u05d5\u05e7\u05d4 \u05e8\u05d1\u05d4 \u05d1\u05e9\u05d9\u05e0\u05d5\u05d9 \u05de\u05d5\u05e7\u05d3 \u05d4\u05e4\u05e2\u05d9\u05dc\u05d5\u05ea, \u05d4\u05de\u05e4\u05e8\u05d9\u05e2\u05d9\u05dd \u05dc\u05ea\u05e4\u05e7\u05d5\u05d3 \u05d1\u05db\u05dc \u05d4\u05ea\u05d7\u05d5\u05de\u05d9\u05dd (All spheres)."
        },
        {
          "text": "Level 4 (Requiring intensive clinical intervention)",
          "isCorrect": false,
          "rationale": "\u05d3\u05d9\u05e8\u05d5\u05d2 \u05d4\u05d7\u05d5\u05de\u05e8\u05d4 \u05d1-DSM-5-TR \u05e2\u05d1\u05d5\u05e8 ASD \u05e0\u05e2 \u05d1\u05d9\u05df \u05e8\u05de\u05d5\u05ea 1 \u05dc-3 \u05d1\u05dc\u05d1\u05d3."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05de\u05d9\u05d3\u05ea \u05d4\u05d4\u05e4\u05e8\u05e2\u05d4 \u05d4\u05ea\u05e4\u05e7\u05d5\u05d3\u05d9\u05ea \u05d4\u05d2\u05dc\u05d5\u05d1\u05dc\u05d9\u05ea \u05d5\u05d4\u05de\u05e6\u05d5\u05e7\u05d4 \u05e9\u05d7\u05d5\u05d5\u05d4 \u05d4\u05d9\u05dc\u05d3 \u05e1\u05d1\u05d9\u05d1 \u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd.",
      "citation": "(DSM p.58)"
    },
    {
      "question": "\u05d1\u05ea\u05d4\u05dc\u05d9\u05da \u05d4\u05e2\u05e8\u05db\u05d4 \u05e8\u05d1-\u05ea\u05d7\u05d5\u05de\u05d9 \u05e9\u05dc \u05d9\u05dc\u05d3\u05d4 \u05d1\u05ea 3 \u05e2\u05dd \u05d7\u05e9\u05d3 \u05dc-ASD, \u05d0\u05d9\u05d6\u05d4 \u05e9\u05d9\u05dc\u05d5\u05d1 \u05e9\u05dc \u05db\u05dc\u05d9 \u05d4\u05e2\u05e8\u05db\u05d4 \u05e0\u05d7\u05e9\u05d1 \u05dc-\"gold standard\" \u05d1\u05de\u05d7\u05e7\u05e8 \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9 \u05dc\u05e6\u05d5\u05e8\u05da \u05e7\u05d1\u05d9\u05e2\u05ea \u05d0\u05d1\u05d7\u05e0\u05d4?",
      "answerOptions": [
        {
          "text": "M-CHAT-R/F \u05d5-SCQ",
          "isCorrect": false,
          "rationale": "\u05db\u05dc\u05d9\u05dd \u05d0\u05dc\u05d5 \u05d4\u05dd \u05db\u05dc\u05d9 \u05e1\u05e7\u05d9\u05e8\u05d4 (Screening) \u05d5\u05dc\u05d0 \u05db\u05dc\u05d9\u05dd \u05d0\u05d1\u05d7\u05e0\u05ea\u05d9\u05d9\u05dd \u05de\u05e2\u05de\u05d9\u05e7\u05d9\u05dd \u05d4\u05de\u05d4\u05d5\u05d5\u05d9\u05dd \u05d0\u05ea \u05d4\u05e1\u05d8\u05e0\u05d3\u05e8\u05d8 \u05d4\u05de\u05d7\u05e7\u05e8\u05d9."
        },
        {
          "text": "ADOS-2 \u05d5-ADI-R",
          "isCorrect": true,
          "rationale": "\u05e9\u05d9\u05dc\u05d5\u05d1 \u05e9\u05dc \u05ea\u05e6\u05e4\u05d9\u05ea \u05de\u05d5\u05d1\u05e0\u05d9\u05ea (ADOS-2) \u05d5\u05e8\u05d0\u05d9\u05d5\u05df \u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9 \u05de\u05e2\u05de\u05d9\u05e7 \u05e2\u05dd \u05d4\u05de\u05d8\u05e4\u05dc (ADI-R) \u05e0\u05d7\u05e9\u05d1 \u05dc\u05e1\u05d8\u05e0\u05d3\u05e8\u05d8 \u05d4\u05d6\u05d4\u05d1 \u05dc\u05d0\u05d1\u05d7\u05d5\u05df ASD \u05d1\u05de\u05d7\u05e7\u05e8."
        },
        {
          "text": "CARS-2 \u05d5-Vineland-3",
          "isCorrect": false,
          "rationale": "\u05d1\u05e2\u05d5\u05d3 \u05e9-CARS-2 \u05d4\u05d5\u05d0 \u05db\u05dc\u05d9 \u05d3\u05d9\u05e8\u05d5\u05d2 \u05e7\u05dc\u05d9\u05e0\u05d9 \u05d5-Vineland-3 \u05de\u05e2\u05e8\u05d9\u05da \u05ea\u05e4\u05e7\u05d5\u05d3 \u05d0\u05d3\u05e4\u05d8\u05d9\u05d1\u05d9, \u05d4\u05dd \u05d0\u05d9\u05e0\u05dd \u05de\u05d4\u05d5\u05d5\u05d9\u05dd \u05d0\u05ea \u05d4\u05e9\u05d9\u05dc\u05d5\u05d1 \u05d4\u05de\u05db\u05d5\u05e0\u05d4 '\u05e1\u05d8\u05e0\u05d3\u05e8\u05d8 \u05d4\u05d6\u05d4\u05d1'."
        },
        {
          "text": "CBCL \u05d5-BASC-3",
          "isCorrect": false,
          "rationale": "\u05d0\u05dc\u05d5 \u05d4\u05dd \u05e9\u05d0\u05dc\u05d5\u05e0\u05d9\u05dd \u05e8\u05d7\u05d1\u05d9 \u05d8\u05d5\u05d5\u05d7 \u05dc\u05d4\u05e2\u05e8\u05db\u05ea \u05e4\u05e1\u05d9\u05db\u05d5\u05e4\u05ea\u05d5\u05dc\u05d5\u05d2\u05d9\u05d4 \u05db\u05dc\u05dc\u05d9\u05ea \u05d5\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea, \u05d5\u05dc\u05d0 \u05db\u05dc\u05d9\u05dd \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05d9\u05dd \u05dc\u05d0\u05d1\u05d7\u05d5\u05df \u05dc\u05d9\u05d1\u05ea \u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e9\u05dc ASD."
        }
      ],
      "hint": "\u05d7\u05e4\u05e9 \u05d0\u05ea \u05d4\u05db\u05dc\u05d9\u05dd \u05d4\u05de\u05e9\u05dc\u05d1\u05d9\u05dd \u05ea\u05e6\u05e4\u05d9\u05ea \u05d9\u05e9\u05d9\u05e8\u05d4 \u05e9\u05dc \u05d4\u05e7\u05dc\u05d9\u05e0\u05d0\u05d9 \u05d5\u05e8\u05d0\u05d9\u05d5\u05df \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9 \u05de\u05d5\u05d1\u05e0\u05d4 \u05e2\u05dd \u05d4\u05d4\u05d5\u05e8\u05d4.",
      "citation": "(Dulcan p.146)"
    },
    {
      "question": "\u05d1\u05df 7 \u05e2\u05dd ASD \u05e1\u05d5\u05d1\u05dc \u05de\u05d0\u05d9-\u05e9\u05e7\u05d8 \u05e7\u05d9\u05e6\u05d5\u05e0\u05d9, \u05d4\u05ea\u05e4\u05e8\u05e6\u05d5\u05d9\u05d5\u05ea \u05d6\u05e2\u05dd \u05d5\u05ea\u05d5\u05e7\u05e4\u05e0\u05d5\u05ea \u05db\u05dc\u05e4\u05d9 \u05d0\u05d7\u05e8\u05d9\u05dd \u05e9\u05d0\u05d9\u05e0\u05dd \u05de\u05d2\u05d9\u05d1\u05d9\u05dd \u05dc\u05d4\u05ea\u05e2\u05e8\u05d1\u05d5\u05d9\u05d5\u05ea \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea\u05d9\u05d5\u05ea (ABA). \u05d4\u05d4\u05d5\u05e8\u05d9\u05dd \u05de\u05e2\u05d5\u05e0\u05d9\u05d9\u05e0\u05d9\u05dd \u05d1\u05d8\u05d9\u05e4\u05d5\u05dc \u05ea\u05e8\u05d5\u05e4\u05ea\u05d9. \u05de\u05d4\u05df \u05d4\u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05d4\u05de\u05d0\u05d5\u05e9\u05e8\u05d5\u05ea \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d4-FDA \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Irritability \u05d4\u05e7\u05e9\u05d5\u05e8 \u05dc-ASD \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd?",
      "answerOptions": [
        {
          "text": "Methylphenidate \u05d5-Guanfacine",
          "isCorrect": false,
          "rationale": "\u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05d0\u05dc\u05d5 \u05de\u05d9\u05d5\u05e2\u05d3\u05d5\u05ea \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05e9\u05dc ADHD \u05e7\u05d5\u05de\u05d5\u05e8\u05d1\u05d9\u05d3\u05d9 \u05d1-ASD, \u05d0\u05da \u05d0\u05d9\u05e0\u05df \u05de\u05d0\u05d5\u05e9\u05e8\u05d5\u05ea FDA \u05e2\u05d1\u05d5\u05e8 Irritability."
        },
        {
          "text": "Fluoxetine \u05d5-Sertraline",
          "isCorrect": false,
          "rationale": "\u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05de\u05de\u05e9\u05e4\u05d7\u05ea \u05d4-SSRI \u05d0\u05d9\u05e0\u05df \u05de\u05d0\u05d5\u05e9\u05e8\u05d5\u05ea \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05d4\u05dc\u05d9\u05d1\u05ea\u05d9\u05d9\u05dd \u05d0\u05d5 \u05d1-Irritability \u05d1-ASD \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd, \u05d5\u05dc\u05e2\u05d9\u05ea\u05d9\u05dd \u05d0\u05e3 \u05d9\u05e9 \u05e2\u05d3\u05d5\u05ea \u05dc\u05d9\u05e2\u05d9\u05dc\u05d5\u05ea \u05de\u05d5\u05d2\u05d1\u05dc\u05ea."
        },
        {
          "text": "Risperidone \u05d5-Aripiprazole",
          "isCorrect": true,
          "rationale": "\u05d0\u05dc\u05d5 \u05d4\u05df \u05e9\u05ea\u05d9 \u05d4\u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05d4\u05d9\u05d7\u05d9\u05d3\u05d5\u05ea \u05d4\u05de\u05d0\u05d5\u05e9\u05e8\u05d5\u05ea \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d4-FDA \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Irritability (\u05db\u05d5\u05dc\u05dc \u05ea\u05d5\u05e7\u05e4\u05e0\u05d5\u05ea \u05d5\u05e4\u05d2\u05d9\u05e2\u05d4 \u05e2\u05e6\u05de\u05d9\u05ea) \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd \u05d0\u05d5\u05d8\u05d9\u05d6\u05dd."
        },
        {
          "text": "Haloperidol \u05d5-Olanzapine",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05e9\u05d9\u05e9 \u05e2\u05d3\u05d5\u05ea \u05de\u05e1\u05d5\u05d9\u05de\u05ea \u05dc\u05d9\u05e2\u05d9\u05dc\u05d5\u05ea\u05df, \u05d4\u05df \u05d0\u05d9\u05e0\u05df \u05de\u05d7\u05d6\u05d9\u05e7\u05d5\u05ea \u05d1\u05d0\u05d9\u05e9\u05d5\u05e8 FDA \u05e8\u05e9\u05de\u05d9 \u05dc\u05d4\u05ea\u05d5\u05d5\u05d9\u05d4 \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05ea \u05d6\u05d5 \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd ASD."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05e7\u05d1\u05d5\u05e6\u05ea \u05d4-Atypical Antipsychotics \u05d5\u05d4\u05ea\u05d5\u05d5\u05d9\u05d5\u05ea \u05d4-FDA \u05d4\u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05d5\u05ea \u05dc\u05d2\u05d9\u05dc \u05d4\u05e6\u05e2\u05d9\u05e8.",
      "citation": "(Dulcan p.150, StahlKids p.17)"
    },
    {
      "question": "\u05de\u05d1\u05d7\u05d9\u05e0\u05d4 \u05e0\u05d5\u05d9\u05e8\u05d5\u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea \u05d5\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05e4\u05e2\u05d5\u05dc\u05d4 (\u05dc\u05e4\u05d9 StahlNeuro), \u05db\u05d9\u05e6\u05d3 \u05e4\u05d5\u05e2\u05dc\u05ea \u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 Aripiprazole \u05d1\u05d4\u05e7\u05e9\u05e8 \u05e9\u05dc \u05d4\u05e7\u05d5\u05dc\u05d8\u05df $D_2$?",
      "answerOptions": [
        {
          "text": "Full Antagonist",
          "isCorrect": false,
          "rationale": "Aripiprazole \u05d0\u05d9\u05e0\u05d5 \u05d7\u05d5\u05e1\u05dd \u05d0\u05ea \u05d4\u05e7\u05d5\u05dc\u05d8\u05df \u05d1\u05d0\u05d5\u05e4\u05df \u05de\u05dc\u05d0 \u05d0\u05dc\u05d0 \u05e4\u05d5\u05e2\u05dc \u05db\u05de\u05d0\u05d6\u05df (Stabilizer) \u05d1\u05ea\u05e0\u05d0\u05d9 \u05d3\u05d5\u05e4\u05de\u05d9\u05df \u05e9\u05d5\u05e0\u05d9\u05dd."
        },
        {
          "text": "Partial Agonist",
          "isCorrect": true,
          "rationale": "\u05dc\u05e4\u05d9 StahlNeuro, \u05d4-Aripiprazole \u05d4\u05d5\u05d0 \u05d0\u05d2\u05d5\u05e0\u05d9\u05e1\u05d8 \u05d7\u05dc\u05e7\u05d9 \u05dc\u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 $D_2$, \u05de\u05d4 \u05e9\u05de\u05d0\u05e4\u05e9\u05e8 \u05d4\u05e4\u05d7\u05ea\u05ea \u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05d3\u05d5\u05e4\u05de\u05d9\u05e0\u05e8\u05d2\u05d9\u05ea \u05e2\u05d5\u05d3\u05e4\u05ea \u05d1\u05de\u05e1\u05dc\u05d5\u05dc \u05d4\u05de\u05d6\u05d5\u05dc\u05d9\u05de\u05d1\u05d9 \u05ea\u05d5\u05da \u05e9\u05de\u05d9\u05e8\u05d4 \u05e2\u05dc \u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05de\u05e1\u05d5\u05d9\u05de\u05ea."
        },
        {
          "text": "Inverse Agonist",
          "isCorrect": false,
          "rationale": "\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d6\u05d4 \u05d0\u05d9\u05e0\u05d5 \u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05d0\u05ea \u05d4\u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05d4\u05e2\u05d9\u05e7\u05e8\u05d9\u05ea \u05e9\u05dc Aripiprazole \u05e2\u05dc \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 $D_2$."
        },
        {
          "text": "Positive Allosteric Modulator",
          "isCorrect": false,
          "rationale": "Aripiprazole \u05e0\u05e7\u05e9\u05e8 \u05d9\u05e9\u05d9\u05e8\u05d5\u05ea \u05dc\u05d0\u05ea\u05e8 \u05d4\u05e7\u05d9\u05e9\u05d5\u05e8 \u05e9\u05dc \u05d4\u05d3\u05d5\u05e4\u05de\u05d9\u05df (Orthosteric) \u05d5\u05dc\u05d0 \u05dc\u05d0\u05ea\u05e8 \u05d0\u05dc\u05d5\u05e1\u05d8\u05e8\u05d9."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05de\u05d5\u05e9\u05d2 'Stabilizer' \u05d5\u05d4\u05d9\u05db\u05d5\u05dc\u05ea \u05e9\u05dc \u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 \u05dc\u05e4\u05e2\u05d5\u05dc \u05d2\u05dd \u05db\u05d0\u05d2\u05d5\u05e0\u05d9\u05e1\u05d8 \u05d5\u05d2\u05dd \u05db\u05d0\u05e0\u05d8\u05d2\u05d5\u05e0\u05d9\u05e1\u05d8 \u05ea\u05dc\u05d5\u05d9 \u05e8\u05d9\u05db\u05d5\u05d6 \u05d4\u05d3\u05d5\u05e4\u05de\u05d9\u05df.",
      "citation": "(StahlNeuro p.234)"
    },
    {
      "question": "\u05de\u05d4\u05d5 \u05e9\u05d9\u05e2\u05d5\u05e8 \u05d4\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d4\u05de\u05e9\u05d5\u05e2\u05e8 \u05e9\u05dc \u05de\u05d5\u05d2\u05d1\u05dc\u05d5\u05ea \u05e9\u05db\u05dc\u05d9\u05ea \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9\u05ea (ID) \u05d1\u05e7\u05e8\u05d1 \u05d0\u05e0\u05e9\u05d9\u05dd \u05d4\u05de\u05d0\u05d5\u05d1\u05d7\u05e0\u05d9\u05dd \u05e2\u05dd ASD, \u05d5\u05de\u05d4\u05d5 \u05d4\u05e7\u05e9\u05e8 \u05d1\u05d9\u05df \u05de\u05d2\u05d3\u05e8 \u05dc\u05d1\u05d9\u05df \u05e9\u05db\u05d9\u05d7\u05d5\u05ea ID \u05d1\u05d0\u05d5\u05db\u05dc\u05d5\u05e1\u05d9\u05d9\u05d4 \u05d6\u05d5 (\u05dc\u05e4\u05d9 Dulcan)?",
      "answerOptions": [
        {
          "text": "\u05db-10%, \u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d2\u05d1\u05d5\u05d4\u05d4 \u05d9\u05d5\u05ea\u05e8 \u05d1\u05d1\u05e0\u05d9\u05dd.",
          "isCorrect": false,
          "rationale": "\u05e0\u05ea\u05d5\u05df \u05d6\u05d4 \u05e0\u05de\u05d5\u05da \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05de\u05d4\u05de\u05e6\u05d9\u05d0\u05d5\u05ea \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05d4\u05de\u05d3\u05d5\u05d5\u05d7\u05ea \u05d1\u05e1\u05e4\u05e8\u05d5\u05ea."
        },
        {
          "text": "\u05db-70%, \u05dc\u05dc\u05d0 \u05d4\u05d1\u05d3\u05dc \u05de\u05d2\u05d3\u05e8\u05d9.",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05e9\u05d1\u05e2\u05d1\u05e8 \u05e1\u05d1\u05e8\u05d5 \u05e9\u05d4\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d2\u05d1\u05d5\u05d4\u05d4 \u05de\u05d0\u05d5\u05d3, \u05d4\u05e0\u05ea\u05d5\u05e0\u05d9\u05dd \u05d4\u05e2\u05d3\u05db\u05e0\u05d9\u05d9\u05dd \u05de\u05e8\u05d0\u05d9\u05dd \u05e9\u05d9\u05e2\u05d5\u05e8\u05d9\u05dd \u05e0\u05de\u05d5\u05db\u05d9\u05dd \u05d9\u05d5\u05ea\u05e8 \u05d5\u05d9\u05e9\u05e0\u05d5 \u05d4\u05d1\u05d3\u05dc \u05de\u05d2\u05d3\u05e8\u05d9 \u05d1\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d4-ID."
        },
        {
          "text": "\u05db-30% \u05e2\u05d3 40%, \u05db\u05d0\u05e9\u05e8 ID \u05e9\u05db\u05d9\u05d7 \u05d9\u05d5\u05ea\u05e8 \u05d1\u05d1\u05e0\u05d5\u05ea \u05e2\u05dd ASD.",
          "isCorrect": true,
          "rationale": "\u05dc\u05e4\u05d9 Dulcan \u05d5-Lord et al., \u05e9\u05d9\u05e2\u05d5\u05e8\u05d9 \u05d4-ID \u05e0\u05e2\u05d9\u05dd \u05e1\u05d1\u05d9\u05d1 \u05e9\u05dc\u05d9\u05e9 \u05de\u05d4\u05de\u05e7\u05e8\u05d9\u05dd, \u05d5\u05d4\u05dd \u05e0\u05d5\u05d8\u05d9\u05dd \u05dc\u05d4\u05d9\u05d5\u05ea \u05e9\u05db\u05d9\u05d7\u05d9\u05dd \u05d9\u05d5\u05ea\u05e8 \u05d1\u05e7\u05e8\u05d1 \u05d1\u05e0\u05d5\u05ea \u05d4\u05de\u05d0\u05d5\u05d1\u05d7\u05e0\u05d5\u05ea \u05e2\u05dd ASD."
        },
        {
          "text": "\u05db-50%, \u05db\u05d0\u05e9\u05e8 ID \u05e9\u05db\u05d9\u05d7 \u05d9\u05d5\u05ea\u05e8 \u05d1\u05d1\u05e0\u05d9\u05dd \u05e2\u05dd ASD.",
          "isCorrect": false,
          "rationale": "\u05d1\u05e2\u05d5\u05d3 \u05e9-ASD \u05e9\u05db\u05d9\u05d7 \u05d9\u05d5\u05ea\u05e8 \u05d1\u05d1\u05e0\u05d9\u05dd, \u05db\u05e9\u05d9\u05e9 \u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc ASD \u05d1\u05d1\u05e0\u05d5\u05ea, \u05d4\u05e1\u05d9\u05db\u05d5\u05d9 \u05dc\u05de\u05d5\u05d2\u05d1\u05dc\u05d5\u05ea \u05e9\u05db\u05dc\u05d9\u05ea \u05e0\u05dc\u05d5\u05d5\u05d9\u05ea \u05d4\u05d5\u05d0 \u05d2\u05d1\u05d5\u05d4 \u05d9\u05d5\u05ea\u05e8."
        }
      ],
      "hint": "\u05e9\u05d9\u05dd \u05dc\u05d1 \u05dc\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d4\u05de\u05d5\u05d2\u05d1\u05dc\u05d5\u05ea \u05d4\u05e9\u05db\u05dc\u05d9\u05ea \u05d1\u05e7\u05e8\u05d1 \u05d1\u05e0\u05d5\u05ea \u05d4\u05de\u05d0\u05d5\u05d1\u05d7\u05e0\u05d5\u05ea \u05d1-ASD \u05dc\u05e2\u05d5\u05de\u05ea \u05d1\u05e0\u05d9\u05dd.",
      "citation": "(Dulcan p.140, p.144)"
    },
    {
      "question": "\u05e0\u05e2\u05e8 \u05d1\u05df 15 \u05e2\u05dd ASD \u05de\u05d5\u05e4\u05e0\u05d4 \u05dc\u05d4\u05e2\u05e8\u05db\u05d4 \u05d3\u05d7\u05d5\u05e4\u05d4 \u05e2\u05e7\u05d1 \u05e9\u05d9\u05e0\u05d5\u05d9 \u05d7\u05d3 \u05d1\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d4\u05db\u05d5\u05dc\u05dc \u05d4\u05e1\u05ea\u05d2\u05e8\u05d5\u05ea \u05e0\u05d5\u05e1\u05e4\u05ea, \u05de\u05dc\u05de\u05d5\u05dc \u05dc\u05e2\u05e6\u05de\u05d5 \u05e9\u05e0\u05e8\u05d0\u05d4 \u05db\u05de\u05e2\u05e0\u05d4 \u05dc\u05e7\u05d5\u05dc\u05d5\u05ea, \u05d5\u05d9\u05e8\u05d9\u05d3\u05d4 \u05d7\u05d3\u05d4 \u05d1\u05ea\u05e4\u05e7\u05d5\u05d3. \u05db\u05d9\u05e6\u05d3 \u05e0\u05d9\u05ea\u05df \u05dc\u05d4\u05d1\u05d3\u05d9\u05dc \u05d1\u05d9\u05df Schizophrenia \u05dc\u05d1\u05d9\u05df \u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d4\u05dc\u05d9\u05d1\u05ea\u05d9\u05d9\u05dd \u05e9\u05dc ASD \u05d1\u05de\u05e7\u05e8\u05d4 \u05d6\u05d4?",
      "answerOptions": [
        {
          "text": "\u05d1-ASD \u05d0\u05d9\u05df \u05dc\u05e2\u05d5\u05dc\u05dd \u05d4\u05d3\u05e8\u05d3\u05e8\u05d5\u05ea \u05ea\u05e4\u05e7\u05d5\u05d3\u05d9\u05ea \u05d1\u05d2\u05d9\u05dc \u05d4\u05d4\u05ea\u05d1\u05d2\u05e8\u05d5\u05ea.",
          "isCorrect": false,
          "rationale": "\u05d4\u05d3\u05e8\u05d3\u05e8\u05d5\u05ea \u05ea\u05e4\u05e7\u05d5\u05d3\u05d9\u05ea \u05d9\u05db\u05d5\u05dc\u05d4 \u05dc\u05d4\u05ea\u05e8\u05d7\u05e9 \u05d1-ASD, \u05d0\u05da \u05d4\u05d9\u05d0 \u05d0\u05d9\u05e0\u05d4 \u05de\u05e2\u05d9\u05d3\u05d4 \u05db\u05e9\u05dc\u05e2\u05e6\u05de\u05d4 \u05e2\u05dc \u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d4."
        },
        {
          "text": "\u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05e9\u05dc \u05d4\u05dc\u05d5\u05e6\u05d9\u05e0\u05e6\u05d9\u05d5\u05ea \u05d5\u05d3\u05dc\u05d5\u05d6\u05d9\u05d5\u05ea \u05d1\u05e8\u05d5\u05e8\u05d5\u05ea \u05d4\u05d9\u05d0 \u05d4\u05de\u05e4\u05ea\u05d7 \u05dc\u05d0\u05d1\u05d7\u05e0\u05ea Schizophrenia.",
          "isCorrect": true,
          "rationale": "\u05dc\u05e4\u05d9 \u05d4-DSM-5-TR, \u05d4\u05dc\u05d5\u05e6\u05d9\u05e0\u05e6\u05d9\u05d5\u05ea \u05d5\u05d3\u05dc\u05d5\u05d6\u05d9\u05d5\u05ea \u05d4\u05df \u05e1\u05d9\u05de\u05e0\u05d9 \u05d4\u05d9\u05db\u05e8 \u05e9\u05dc \u05e1\u05db\u05d9\u05d6\u05d5\u05e4\u05e8\u05e0\u05d9\u05d4 \u05d5\u05d0\u05d9\u05e0\u05df \u05d7\u05dc\u05e7 \u05de\u05d4\u05e7\u05dc\u05d9\u05e0\u05d9\u05e7\u05d4 \u05e9\u05dc ASD, \u05d0\u05dd \u05db\u05d9 \u05d9\u05e9 \u05dc\u05d4\u05d9\u05d6\u05d4\u05e8 \u05de\u05e4\u05e8\u05e9\u05e0\u05d5\u05ea \u05e7\u05d5\u05e0\u05e7\u05e8\u05d8\u05d9\u05ea \u05e9\u05dc \u05d4\u05e9\u05d0\u05dc\u05d5\u05ea \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d4\u05de\u05d8\u05d5\u05e4\u05dc."
        },
        {
          "text": "\u05d3\u05d9\u05d1\u05d5\u05e8 \u05d1\u05d9\u05d6\u05d0\u05e8\u05d9 \u05d1-ASD \u05ea\u05de\u05d9\u05d3 \u05de\u05e2\u05d9\u05d3 \u05e2\u05dc \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea \u05e1\u05db\u05d9\u05d6\u05d5\u05e4\u05e8\u05e0\u05d9\u05d4.",
          "isCorrect": false,
          "rationale": "\u05d3\u05d9\u05d1\u05d5\u05e8 \u05d1\u05d9\u05d6\u05d0\u05e8\u05d9 \u05d0\u05d5 \u05d0\u05e7\u05d5\u05dc\u05dc\u05d9\u05d4 \u05d4\u05dd \u05d7\u05dc\u05e7 \u05de-ASD (Criterion B) \u05d5\u05d0\u05d9\u05e0\u05dd \u05de\u05e2\u05d9\u05d3\u05d9\u05dd \u05d1\u05d4\u05db\u05e8\u05d7 \u05e2\u05dc \u05e1\u05db\u05d9\u05d6\u05d5\u05e4\u05e8\u05e0\u05d9\u05d4."
        },
        {
          "text": "\u05dc\u05d0 \u05e0\u05d9\u05ea\u05df \u05dc\u05d0\u05d1\u05d7\u05df \u05e1\u05db\u05d9\u05d6\u05d5\u05e4\u05e8\u05e0\u05d9\u05d4 \u05d1\u05de\u05d9 \u05e9\u05db\u05d1\u05e8 \u05de\u05d0\u05d5\u05d1\u05d7\u05df \u05e2\u05dd ASD.",
          "isCorrect": false,
          "rationale": "\u05e0\u05d9\u05ea\u05df \u05dc\u05d0\u05d1\u05d7\u05df \u05e7\u05d5\u05de\u05d5\u05e8\u05d1\u05d9\u05d3\u05d9\u05d5\u05ea \u05e9\u05dc \u05e9\u05ea\u05d9 \u05d4\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05d1\u05de\u05d9\u05d3\u05d4 \u05d5\u05e7\u05d9\u05d9\u05de\u05d9\u05dd \u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9\u05d9\u05dd \u05d1\u05d5\u05dc\u05d8\u05d9\u05dd \u05dc\u05de\u05e9\u05da \u05d7\u05d5\u05d3\u05e9 \u05dc\u05e4\u05d7\u05d5\u05ea."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05d4\u05e4\u05d5\u05d6\u05d9\u05d8\u05d9\u05d1\u05d9\u05d9\u05dd \u05d4\u05de\u05d2\u05d3\u05d9\u05e8\u05d9\u05dd \u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d4 \u05d5\u05d0\u05d9\u05e0\u05dd \u05de\u05d5\u05e4\u05d9\u05e2\u05d9\u05dd \u05d1-ASD.",
      "citation": "(DSM p.67, Dulcan p.399)"
    },
    {
      "question": "\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4-ABA (Applied Behavior Analysis) \u05d4\u05e7\u05dc\u05d0\u05e1\u05d9 \u05e2\u05d1\u05e8 \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05d9\u05d5\u05ea. \u05de\u05d5\u05d3\u05dc \u05d4-ESDM (Early Start Denver Model) \u05e0\u05d7\u05e9\u05d1 \u05dc\u05d9\u05d9\u05d7\u05d5\u05d3\u05d9 \u05de\u05db\u05d9\u05d5\u05d5\u05df \u05e9\u05d4\u05d5\u05d0:",
      "answerOptions": [
        {
          "text": "\u05de\u05ea\u05de\u05e7\u05d3 \u05d0\u05da \u05d5\u05e8\u05e7 \u05d1\u05d1\u05e0\u05d9 \u05e0\u05d5\u05e2\u05e8 \u05e2\u05dd ASD \u05d1\u05ea\u05e4\u05e7\u05d5\u05d3 \u05d2\u05d1\u05d5\u05d4.",
          "isCorrect": false,
          "rationale": "ESDM \u05de\u05d9\u05d5\u05e2\u05d3 \u05dc\u05d9\u05dc\u05d3\u05d9\u05dd \u05e6\u05e2\u05d9\u05e8\u05d9\u05dd \u05de\u05d0\u05d5\u05d3 (\u05d2\u05d9\u05dc\u05d0\u05d9 1-4) \u05d5\u05dc\u05d0 \u05dc\u05d1\u05e0\u05d9 \u05e0\u05d5\u05e2\u05e8."
        },
        {
          "text": "\u05de\u05e9\u05dc\u05d1 \u05e2\u05e7\u05e8\u05d5\u05e0\u05d5\u05ea \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea\u05d9\u05d9\u05dd (ABA) \u05e2\u05dd \u05d2\u05d9\u05e9\u05d5\u05ea \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9\u05d5\u05ea \u05d5\u05e8\u05d2\u05e9\u05d9\u05d5\u05ea \u05de\u05d1\u05d5\u05e1\u05e1\u05d5\u05ea \u05de\u05e9\u05d7\u05e7.",
          "isCorrect": true,
          "rationale": "\u05dc\u05e4\u05d9 Dulcan, \u05de\u05d5\u05d3\u05dc \u05d4-ESDM \u05de\u05e9\u05dc\u05d1 \u05d0\u05ea \u05d4-ABA \u05e2\u05dd \u05d2\u05d9\u05e9\u05d5\u05ea \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9\u05d5\u05ea \u05d5\u05e8\u05d2\u05e9\u05d9\u05d5\u05ea \u05d1\u05ea\u05d5\u05da \u05de\u05e1\u05d2\u05e8\u05ea \u05e9\u05dc \u05de\u05e9\u05d7\u05e7 \u05d5\u05d0\u05d9\u05e0\u05d8\u05e8\u05d0\u05e7\u05e6\u05d9\u05d4 \u05d9\u05d5\u05de\u05d9\u05d5\u05de\u05d9\u05ea."
        },
        {
          "text": "\u05d4\u05d5\u05d0 \u05d8\u05d9\u05e4\u05d5\u05dc \u05ea\u05e8\u05d5\u05e4\u05ea\u05d9 \u05e0\u05d9\u05e1\u05d9\u05d5\u05e0\u05d9 \u05dc\u05e9\u05d9\u05e4\u05d5\u05e8 \u05d0\u05d9\u05e0\u05d8\u05e8\u05d0\u05e7\u05e6\u05d9\u05d4 \u05d7\u05d1\u05e8\u05ea\u05d9\u05ea.",
          "isCorrect": false,
          "rationale": "ESDM \u05d4\u05d5\u05d0 \u05d4\u05ea\u05e2\u05e8\u05d1\u05d5\u05ea \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea\u05d9\u05ea-\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9\u05ea \u05d5\u05dc\u05d0 \u05d8\u05d9\u05e4\u05d5\u05dc \u05ea\u05e8\u05d5\u05e4\u05ea\u05d9."
        },
        {
          "text": "\u05de\u05d1\u05d5\u05e1\u05e1 \u05e2\u05dc \u05d4\u05d9\u05de\u05e0\u05e2\u05d5\u05ea \u05de\u05d5\u05d7\u05dc\u05d8\u05ea \u05de\u05d7\u05d9\u05d6\u05d5\u05e7\u05d9\u05dd \u05d7\u05d9\u05d5\u05d1\u05d9\u05d9\u05dd.",
          "isCorrect": false,
          "rationale": "\u05e0\u05d4\u05e4\u05d5\u05da \u05d4\u05d5\u05d0, \u05d4\u05de\u05d5\u05d3\u05dc \u05de\u05e9\u05ea\u05de\u05e9 \u05d1\u05d7\u05d9\u05d6\u05d5\u05e7\u05d9\u05dd \u05d5\u05d1\u05de\u05d5\u05d8\u05d9\u05d1\u05e6\u05d9\u05d4 \u05e9\u05dc \u05d4\u05d9\u05dc\u05d3 \u05d1\u05ea\u05d5\u05da \u05d4\u05de\u05e9\u05d7\u05e7."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05e9\u05d9\u05dc\u05d5\u05d1 \u05d1\u05d9\u05df \u05de\u05d3\u05e2 \u05d4\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05dc\u05d1\u05d9\u05df \u05e9\u05dc\u05d1\u05d9 \u05d4\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea \u05d4\u05d8\u05d1\u05e2\u05d9\u05d9\u05dd \u05e9\u05dc \u05d4\u05d9\u05dc\u05d3.",
      "citation": "(Dulcan p.147)"
    },
    {
      "question": "\u05de\u05d4\u05d5 \u05d4\u05de\u05de\u05e6\u05d0 \u05d4\u05e4\u05e8\u05d5\u05d2\u05e0\u05d5\u05e1\u05d8\u05d9 \u05d4\u05d7\u05e9\u05d5\u05d1 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05e2\u05e6\u05de\u05d0\u05d5\u05ea \u05d1\u05d1\u05d2\u05e8\u05d5\u05ea \u05e2\u05d1\u05d5\u05e8 \u05d9\u05dc\u05d3 \u05d4\u05de\u05d0\u05d5\u05d1\u05d7\u05df \u05e2\u05dd ASD?",
      "answerOptions": [
        {
          "text": "\u05d4\u05d9\u05e2\u05d3\u05e8 \u05de\u05d5\u05d7\u05dc\u05d8 \u05e9\u05dc \u05ea\u05e0\u05d5\u05e2\u05d5\u05ea \u05e1\u05d8\u05e8\u05d9\u05d0\u05d5\u05d8\u05d9\u05e4\u05d9\u05d5\u05ea \u05d1\u05d2\u05d9\u05dc 5.",
          "isCorrect": false,
          "rationale": "\u05ea\u05e0\u05d5\u05e2\u05d5\u05ea \u05e1\u05d8\u05e8\u05d9\u05d0\u05d5\u05d8\u05d9\u05e4\u05d9\u05d5\u05ea \u05e7\u05d9\u05d9\u05de\u05d5\u05ea \u05d0\u05e6\u05dc \u05e8\u05d1\u05d9\u05dd \u05d5\u05d0\u05d9\u05e0\u05df \u05d4\u05de\u05e0\u05d1\u05d0 \u05d4\u05e2\u05d9\u05e7\u05e8\u05d9 \u05dc\u05e2\u05e6\u05de\u05d0\u05d5\u05ea \u05ea\u05e4\u05e7\u05d5\u05d3\u05d9\u05ea."
        },
        {
          "text": "\u05e8\u05de\u05ea \u05d4-Restricted interests \u05d1\u05d2\u05d9\u05dc \u05d1\u05d9\u05ea \u05d4\u05e1\u05e4\u05e8.",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05d4\u05e9\u05e4\u05e2\u05ea\u05dd \u05e2\u05dc \u05d4\u05ea\u05e4\u05e7\u05d5\u05d3, \u05d4\u05dd \u05d0\u05d9\u05e0\u05dd \u05d4\u05de\u05e0\u05d1\u05d0 \u05d4\u05d7\u05d6\u05e7 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05e9\u05e0\u05de\u05e6\u05d0 \u05d1\u05de\u05d7\u05e7\u05e8\u05d9\u05dd."
        },
        {
          "text": "\u05d9\u05db\u05d5\u05dc\u05ea \u05e9\u05e4\u05ea\u05d9\u05ea (\u05d3\u05d9\u05d1\u05d5\u05e8 \u05d1\u05e4\u05e8\u05d6\u05d5\u05ea) \u05e2\u05d3 \u05d2\u05d9\u05dc 6 \u05d5\u05d4\u05d9\u05e2\u05d3\u05e8 \u05de\u05d5\u05d2\u05d1\u05dc\u05d5\u05ea \u05e9\u05db\u05dc\u05d9\u05ea (ID).",
          "isCorrect": true,
          "rationale": "\u05dc\u05e4\u05d9 Dulcan, \u05d2\u05d5\u05e8\u05de\u05d9\u05dd \u05e4\u05e8\u05d5\u05d2\u05e0\u05d5\u05e1\u05d8\u05d9\u05d9\u05dd \u05d7\u05d9\u05d5\u05d1\u05d9\u05d9\u05dd \u05db\u05d5\u05dc\u05dc\u05d9\u05dd \u05e8\u05db\u05d9\u05e9\u05ea \u05e9\u05e4\u05d4 (\u05e4\u05e8\u05d6\u05d5\u05ea) \u05e2\u05d3 \u05d2\u05d9\u05dc 6, \u05de\u05e0\u05ea \u05de\u05e9\u05db\u05dc \u05ea\u05e7\u05d9\u05e0\u05d4, \u05d5\u05db\u05d9\u05e9\u05d5\u05e8\u05d9\u05dd \u05d0\u05d3\u05e4\u05d8\u05d9\u05d1\u05d9\u05d9\u05dd \u05d7\u05d6\u05e7\u05d9\u05dd."
        },
        {
          "text": "\u05e9\u05d9\u05de\u05d5\u05e9 \u05de\u05d5\u05e7\u05d3\u05dd \u05d1-Melatonin \u05dc\u05e1\u05d9\u05d3\u05d5\u05e8 \u05d4\u05e9\u05d9\u05e0\u05d4.",
          "isCorrect": false,
          "rationale": "\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05e9\u05d9\u05e0\u05d4 \u05de\u05e9\u05e4\u05e8 \u05d0\u05d9\u05db\u05d5\u05ea \u05d7\u05d9\u05d9\u05dd \u05d0\u05da \u05d0\u05d9\u05e0\u05d5 \u05e0\u05d7\u05e9\u05d1 \u05dc\u05de\u05e0\u05d1\u05d0 \u05e4\u05e8\u05d5\u05d2\u05e0\u05d5\u05e1\u05d8\u05d9 \u05de\u05e8\u05db\u05d6\u05d9 \u05dc\u05e2\u05e6\u05de\u05d0\u05d5\u05ea \u05ea\u05e4\u05e7\u05d5\u05d3\u05d9\u05ea \u05d0\u05e8\u05d5\u05db\u05ea \u05d8\u05d5\u05d5\u05d7."
