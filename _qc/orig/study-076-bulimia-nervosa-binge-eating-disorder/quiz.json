    {
      "type": "multiple_choice",
      "question": "\u05de\u05d8\u05d5\u05e4\u05dc\u05ea \u05d1\u05ea 19 \u05e2\u05dd \u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc Bulimia Nervosa \u05de\u05d8\u05d5\u05e4\u05dc\u05ea \u05d1-Fluoxetine \u05d1\u05de\u05d9\u05e0\u05d5\u05df \u05e9\u05dc $20 \\text{ mg/day}$ \u05d1\u05de\u05e9\u05da 4 \u05e9\u05d1\u05d5\u05e2\u05d5\u05ea. \u05d4\u05d9\u05d0 \u05de\u05d3\u05d5\u05d5\u05d7\u05ea \u05e2\u05dc \u05e9\u05d9\u05e4\u05d5\u05e8 \u05e7\u05dc \u05d1\u05dc\u05d1\u05d3 \u05d1\u05ea\u05d3\u05d9\u05e8\u05d5\u05ea \u05d4\u05d1\u05d5\u05dc\u05de\u05d5\u05e1\u05d9\u05dd. \u05de\u05d4\u05d5 \u05d4\u05e6\u05e2\u05d3 \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc\u05d9 \u05d4\u05d1\u05d0 \u05d4\u05de\u05d5\u05de\u05dc\u05e5 \u05dc\u05e4\u05d9 \u05d4-StahlKids?",
      "answerOptions": [
        {
          "text": "\u05d4\u05e2\u05dc\u05d0\u05ea \u05d4\u05de\u05d9\u05e0\u05d5\u05df \u05dc-$60 \\text{ mg/day}$ \u05d1\u05d0\u05d5\u05e4\u05df \u05d4\u05d3\u05e8\u05d2\u05ea\u05d9",
          "isCorrect": true,
          "rationale": "\u05d1\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Bulimia Nervosa, \u05de\u05d9\u05e0\u05d5\u05df \u05d4\u05de\u05d8\u05e8\u05d4 \u05e9\u05dc Fluoxetine \u05d4\u05d5\u05d0 \u05dc\u05e8\u05d5\u05d1 \u05d2\u05d1\u05d5\u05d4 \u05d9\u05d5\u05ea\u05e8 \u05de\u05d0\u05e9\u05e8 \u05d1\u05d3\u05d9\u05db\u05d0\u05d5\u05df, \u05db\u05d0\u05e9\u05e8 $60 \\text{ mg}$ \u05e0\u05d7\u05e9\u05d1 \u05dc\u05de\u05d9\u05e0\u05d5\u05df \u05d4\u05d0\u05d5\u05e4\u05d8\u05d9\u05de\u05dc\u05d9 \u05dc\u05d4\u05e4\u05d7\u05ea\u05ea \u05d1\u05d5\u05dc\u05de\u05d5\u05e1\u05d9\u05dd (StahlKids p.207)."
        },
        {
          "text": "\u05d4\u05d7\u05dc\u05e4\u05ea \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05dc-Sertraline \u05d1\u05e9\u05dc \u05d4\u05d9\u05e2\u05d3\u05e8 \u05ea\u05d2\u05d5\u05d1\u05d4",
          "isCorrect": false,
          "rationale": "Fluoxetine \u05d4\u05d9\u05d0 \u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 \u05d4\u05d9\u05d7\u05d9\u05d3\u05d4 \u05d4\u05de\u05d0\u05d5\u05e9\u05e8\u05ea \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d4-FDA \u05dc-Bulimia Nervosa, \u05d5\u05d9\u05e9 \u05dc\u05de\u05e6\u05d5\u05ea \u05d0\u05ea \u05d4\u05de\u05d9\u05e0\u05d5\u05df \u05e9\u05dc\u05d4 \u05dc\u05e4\u05e0\u05d9 \u05d4\u05d7\u05dc\u05e4\u05d4 (StahlKids p.207)."
        },
        {
          "text": "\u05d4\u05d5\u05e1\u05e4\u05ea Bupropion \u05dc\u05d7\u05d9\u05d6\u05d5\u05e7 \u05d4\u05d0\u05e4\u05e7\u05d8 \u05d4\u05d0\u05e0\u05d8\u05d9-\u05d1\u05d5\u05dc\u05de\u05d5\u05e1\u05d9",
          "isCorrect": false,
          "rationale": "Bupropion \u05d0\u05e1\u05d5\u05e8\u05d4 \u05dc\u05e9\u05d9\u05de\u05d5\u05e9 (contraindicated) \u05d1\u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd \u05e2\u05dd \u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05d0\u05db\u05d9\u05dc\u05d4 \u05d1\u05e9\u05dc \u05e1\u05d9\u05db\u05d5\u05df \u05de\u05d5\u05d2\u05d1\u05e8 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05dc\u05e4\u05e8\u05db\u05d5\u05e1\u05d9\u05dd (StahlKids p.96)."
        },
        {
          "text": "\u05d4\u05e4\u05e1\u05e7\u05ea \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05ea\u05e8\u05d5\u05e4\u05ea\u05d9 \u05d5\u05d4\u05ea\u05de\u05e7\u05d3\u05d5\u05ea \u05d1-Interpersonal Therapy (IPT) \u05d1\u05dc\u05d1\u05d3",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05e9\u05e4\u05e1\u05d9\u05db\u05d5\u05ea\u05e8\u05e4\u05d9\u05d4 \u05d7\u05e9\u05d5\u05d1\u05d4, \u05d4\u05e6\u05e2\u05d3 \u05d4\u05ea\u05e8\u05d5\u05e4\u05ea\u05d9 \u05d4\u05e0\u05db\u05d5\u05df \u05d4\u05d5\u05d0 \u05d4\u05d2\u05e2\u05d4 \u05dc\u05de\u05d9\u05e0\u05d5\u05df \u05d9\u05e2\u05d9\u05dc \u05e9\u05dc \u05d4-SSRI \u05d4\u05de\u05d0\u05d5\u05e9\u05e8 (StahlKids p.207)."
        }
