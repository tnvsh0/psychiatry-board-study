      "hint": "\u05d7\u05e9\u05d1\u05d5 \u05e2\u05dc \u05d4\u05de\u05d9\u05e0\u05d5\u05df \u05d4\u05de\u05e7\u05d5\u05d1\u05dc \u05d1-Bulimia Nervosa \u05d1\u05d4\u05e9\u05d5\u05d5\u05d0\u05d4 \u05dc\u05de\u05d9\u05e0\u05d5\u05df \u05d4\u05de\u05e7\u05d5\u05d1\u05dc \u05d1-MDD.",
      "imageUrls": []
    },
    {
      "type": "short_answer",
      "question": "\u05d4\u05e1\u05d1\u05e8 \u05d0\u05ea \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05e0\u05d5\u05d9\u05e8\u05d5\u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d4\u05de\u05d5\u05e6\u05e2 \u05d1-StahlNeuro \u05e9\u05d3\u05e8\u05db\u05d5 Lisdexamfetamine \u05de\u05e1\u05d9\u05d9\u05e2\u05ea \u05d1\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Binge Eating Disorder (BED), \u05de\u05e2\u05d1\u05e8 \u05dc\u05d3\u05d9\u05db\u05d5\u05d9 \u05ea\u05d9\u05d0\u05d1\u05d5\u05df.",
      "grading": {
        "modelAnswer": "\u05dc\u05e4\u05d9 \u05d4-StahlNeuro, \u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 \u05e4\u05d5\u05e2\u05dc\u05ea \u05d3\u05e8\u05da \u05d4\u05e9\u05e8\u05d0\u05ea \u05e0\u05d5\u05d9\u05e8\u05d5\u05e4\u05dc\u05d0\u05e1\u05d8\u05d9\u05d5\u05ea \u05e1\u05d8\u05e8\u05d9\u05d0\u05d8\u05dc\u05d9\u05ea (striatal neuroplasticity). \u05ea\u05d4\u05dc\u05d9\u05da \u05d6\u05d4 \u05de\u05e1\u05d9\u05d9\u05e2 \u05dc\u05d4\u05d7\u05d6\u05d9\u05e8 \u05d0\u05ea \u05d4\u05e9\u05dc\u05d9\u05d8\u05d4 \u05d4\u05e2\u05e6\u05d1\u05d9\u05ea \u05de\u05d4\u05de\u05e2\u05d2\u05dc \u05d4\u05e1\u05d8\u05e8\u05d9\u05d0\u05d8\u05dc\u05d9 \u05d4\u05d2\u05d1\u05d9 (dorsal striatum), \u05d4\u05d0\u05d7\u05e8\u05d0\u05d9 \u05e2\u05dc \u05d4\u05e8\u05d2\u05dc\u05d9\u05dd \u05d5\u05db\u05e4\u05d9\u05d9\u05ea\u05d9\u05d5\u05ea, \u05d0\u05dc \u05d4\u05de\u05e2\u05d2\u05dc \u05d4\u05d5\u05d5\u05e0\u05d8\u05e8\u05dc\u05d9 \u05d4\u05e7\u05d5\u05e8\u05d8\u05d9\u05e7\u05dc\u05d9 (ventral control), \u05d5\u05d1\u05db\u05da \u05de\u05e4\u05d7\u05d9\u05ea \u05d0\u05ea \u05d4\u05d0\u05d5\u05e4\u05d9 \u05d4\u05d0\u05d9\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9-\u05e7\u05d5\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9 \u05e9\u05dc \u05d4\u05d0\u05db\u05d9\u05dc\u05d4 (StahlNeuro p.574-575).",
        "rationale": "\u05d4\u05d4\u05e1\u05d1\u05e8 \u05de\u05d3\u05d2\u05d9\u05e9 \u05d0\u05ea \u05d4\u05e9\u05d9\u05e0\u05d5\u05d9 \u05d1\u05d1\u05e7\u05e8\u05d4 \u05d4\u05de\u05d5\u05d7\u05d9\u05ea \u05d5\u05dc\u05d0 \u05e8\u05e7 \u05d0\u05ea \u05d4\u05d0\u05e4\u05e7\u05d8 \u05d4\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d8\u05d9 \u05e9\u05dc \u05d3\u05d9\u05db\u05d5\u05d9 \u05d4\u05ea\u05d9\u05d0\u05d1\u05d5\u05df.",
        "requiredAttributes": [
          "\u05d0\u05d6\u05db\u05d5\u05e8 \u05d4\u05de\u05d5\u05e9\u05d2 striatal neuroplasticity",
          "\u05d4\u05ea\u05d9\u05d9\u05d7\u05e1\u05d5\u05ea \u05dc\u05de\u05e2\u05d1\u05e8 \u05de\u05e9\u05dc\u05d9\u05d8\u05d4 \u05d3\u05d5\u05e8\u05e1\u05dc\u05d9\u05ea (dorsal/compulsive) \u05dc\u05e9\u05dc\u05d9\u05d8\u05d4 \u05d5\u05e0\u05d8\u05e8\u05dc\u05d9\u05ea (ventral/cortical control)"
        ],
        "errors": {
          "misconceptions": [
            "\u05d4\u05ea\u05de\u05e7\u05d3\u05d5\u05ea \u05d1\u05dc\u05e2\u05d3\u05d9\u05ea \u05d1\u05d3\u05d9\u05db\u05d5\u05d9 \u05de\u05e8\u05db\u05d6 \u05d4\u05e8\u05e2\u05d1 \u05d1\u05d4\u05d9\u05e4\u05d5\u05ea\u05dc\u05de\u05d5\u05e1 \u05dc\u05dc\u05d0 \u05d0\u05d6\u05db\u05d5\u05e8 \u05d4\u05de\u05e2\u05d2\u05dc\u05d9\u05dd \u05d4\u05e1\u05d8\u05e8\u05d9\u05d0\u05d8\u05dc\u05d9\u05d9\u05dd."
          ],
          "bluffs": [
            "\u05d0\u05de\u05d9\u05e8\u05d4 \u05db\u05dc\u05dc\u05d9\u05ea \u05e9\u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 \u05de\u05e2\u05dc\u05d4 \u05d3\u05d5\u05e4\u05de\u05d9\u05df \u05d5\u05d6\u05d4 \u05d2\u05d5\u05e8\u05dd \u05dc\u05d4\u05e0\u05d0\u05d4 \u05d1\u05de\u05e7\u05d5\u05dd \u05d0\u05d5\u05db\u05dc."
          ]
