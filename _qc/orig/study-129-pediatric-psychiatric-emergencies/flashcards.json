{
  "title": "Psychiatry Flashcards",
  "cards": [
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05de\u05d5\u05e7\u05d3 \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9 \u05d4\u05e2\u05d9\u05e7\u05e8\u05d9 \u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05e2\u05e8\u05db\u05d4 \u05d1-Emergency Department (ED) \u05e2\u05d1\u05d5\u05e8 \u05d9\u05dc\u05d3\u05d9\u05dd \u05d5\u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd?",
      "back": "\u05d4\u05de\u05d5\u05e7\u05d3 \u05d4\u05d5\u05d0 acute safety concerns (\u05e1\u05d9\u05db\u05d5\u05df \u05d0\u05d5\u05d1\u05d3\u05e0\u05d9, \u05e8\u05e6\u05d7\u05e0\u05d9 \u05d0\u05d5 \u05d0\u05d2\u05e8\u05e1\u05d9\u05d1\u05d9\u05d5\u05ea), \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e8\u05e4\u05d5\u05d0\u05d9\u05d9\u05dd \u05d5\u05e7\u05d1\u05d9\u05e2\u05ea \u05d4-disposition \u05d4\u05de\u05ea\u05d0\u05d9\u05dd (Dulcan p.25)."
    },
    {
      "front": "\u05d0\u05d9\u05dc\u05d5 \u05e9\u05e0\u05d9 \u05db\u05dc\u05d9 \u05e1\u05e8\u05d9\u05e7\u05d4 (screening tools) \u05dc\u05e1\u05d9\u05db\u05d5\u05df \u05d0\u05d5\u05d1\u05d3\u05e0\u05d9 \u05ea\u05d5\u05e7\u05e4\u05d5 \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05ea \u05dc\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1-pediatric ED setting?",
      "back": "\u05d4\u05db\u05dc\u05d9\u05dd \u05d4\u05dd \u05d4-Ask Suicide-Screening Questions (ASQ) \u05d5\u05d4-Risk for Suicide Questionnaire (Dulcan p.607)."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05de\u05d5\u05d2\u05d3\u05e8 Suicide attempt \u05dc\u05e4\u05d9 \u05d4-Columbia Classification Algorithm for Suicide Assessment (C-CASA)?",
      "back": "\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05e2\u05dd \u05e4\u05d5\u05d8\u05e0\u05e6\u05d9\u05d0\u05dc \u05dc\u05e0\u05d6\u05e7 \u05e2\u05e6\u05de\u05d9 (self-injurious) \u05db\u05d0\u05e9\u05e8 \u05d9\u05e9\u05e0\u05d4 \u05e2\u05d3\u05d5\u05ea \u05db\u05dc\u05e9\u05d4\u05d9 \u05dc-intent \u05dc\u05de\u05d5\u05ea (Dulcan p.557)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05e6\u05e2\u05d3 \u05d4\u05e8\u05d0\u05e9\u05d5\u05df \u05d1\u05e0\u05d9\u05d4\u05d5\u05dc (management) \u05e9\u05dc \u05d9\u05dc\u05d3 \u05d0\u05d2\u05d9\u05d8\u05d8\u05d9\u05d1\u05d9 \u05d0\u05d5 \u05d0\u05d2\u05e8\u05e1\u05d9\u05d1\u05d9 \u05d1\u05d7\u05d3\u05e8 \u05d4\u05de\u05d9\u05d5\u05df \u05dc\u05e4\u05e0\u05d9 \u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05ea\u05e8\u05d5\u05e4\u05d5\u05ea?",
      "back": "\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05d8\u05db\u05e0\u05d9\u05e7\u05d5\u05ea \u05e9\u05dc verbal de-escalation, \u05d4\u05e4\u05d7\u05ea\u05ea \u05d2\u05d9\u05e8\u05d5\u05d9\u05d9\u05dd \u05e1\u05d1\u05d9\u05d1\u05ea\u05d9\u05d9\u05dd (\u05d3\u05d9\u05de\u05d5\u05dd \u05d0\u05d5\u05e8\u05d5\u05ea) \u05d5\u05d4\u05e6\u05e2\u05ea \u05d0\u05e4\u05e9\u05e8\u05d5\u05d9\u05d5\u05ea \u05d1\u05d7\u05d9\u05e8\u05d4 \u05dc\u05de\u05d8\u05d5\u05e4\u05dc (Dulcan p.611)."
    },
    {
      "front": "\u05de\u05d3\u05d5\u05e2 \u05e9\u05d9\u05de\u05d5\u05e9 \u05d1-Lorazepam \u05e2\u05e9\u05d5\u05d9 \u05dc\u05d4\u05d9\u05d5\u05ea \u05e2\u05d3\u05d9\u05e3 \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-agitation \u05d1\u05de\u05e6\u05d1 \u05e9\u05dc intoxication \u05de\u05de\u05e7\u05d5\u05e8 \u05dc\u05d0 \u05d9\u05d3\u05d5\u05e2?",
      "back": "\u05de\u05db\u05d9\u05d5\u05d5\u05df \u05e9\u05d4\u05d9\u05d0 \u05d9\u05e2\u05d9\u05dc\u05d4 \u05d1\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05d0\u05d2\u05d9\u05d8\u05e6\u05d9\u05d4 \u05d1\u05d6\u05de\u05df \u05d4\u05e8\u05e2\u05dc\u05d4, \u05d0\u05dd \u05db\u05d9 \u05d9\u05e9 \u05dc\u05d4\u05d9\u05de\u05e0\u05e2 \u05de\u05de\u05e0\u05d4 \u05db\u05d0\u05e9\u05e8 \u05d9\u05e9 \u05d7\u05e9\u05d3 \u05dc-delirium (Dulcan p.612)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05e1\u05db\u05e0\u05d4 \u05d4\u05e4\u05d5\u05d8\u05e0\u05e6\u05d9\u05d0\u05dc\u05d9\u05ea \u05d1\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1-Diphenhydramine \u05dc\u05e0\u05d9\u05d4\u05d5\u05dc agitation \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05e6\u05e2\u05d9\u05e8\u05d9\u05dd?",
      "back": "\u05d4\u05d9\u05d0 \u05e2\u05dc\u05d5\u05dc\u05d4 \u05dc\u05d2\u05e8\u05d5\u05dd \u05dc-paradoxical reactions \u05d4\u05db\u05d5\u05dc\u05dc\u05d5\u05ea \u05d4\u05d7\u05de\u05e8\u05d4 \u05d1\u05d0\u05d2\u05d9\u05d8\u05e6\u05d9\u05d4, disinhibition \u05d5-delirium (Dulcan p.612)."
    },
    {
      "front": "\u05d0\u05d9\u05dc\u05d5 \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e7\u05dc\u05d9\u05e0\u05d9\u05d9\u05dd \u05d1\u05d5\u05dc\u05d8\u05d9\u05dd \u05de\u05e2\u05d5\u05e8\u05e8\u05d9\u05dd \u05d7\u05e9\u05d3 \u05dc-Delirium \u05d1\u05d9\u05dc\u05d3 \u05d4\u05de\u05d2\u05d9\u05e2 \u05dc\u05de\u05d9\u05d5\u05df \u05e2\u05dd \u05e9\u05d9\u05e0\u05d5\u05d9 \u05d0\u05e7\u05d5\u05d8\u05d9 \u05d1\u05de\u05e6\u05d1 \u05d4\u05de\u05e0\u05d8\u05dc\u05d9?",
      "back": "\u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05db\u05d5\u05dc\u05dc\u05d9\u05dd disorientation, irritability, inattention, memory loss \u05d5\u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd \u05e4\u05dc\u05d5\u05e7\u05d8\u05d5\u05d0\u05d8\u05d9\u05d1\u05d9\u05d9\u05dd \u05d1\u05de\u05e6\u05d1 \u05d4\u05d4\u05db\u05e8\u05d4 (Dulcan p.616)."
    },
    {
      "front": "\u05de\u05d3\u05d5\u05e2 \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d5\u05e0\u05d5\u05e2\u05e8 \u05d4-medical lethality \u05e9\u05dc \u05e0\u05d9\u05e1\u05d9\u05d5\u05df \u05d0\u05d5\u05d1\u05d3\u05e0\u05d9 \u05d0\u05d9\u05e0\u05d4 \u05de\u05d4\u05d5\u05d5\u05d4 \u05de\u05d3\u05d3 \u05d0\u05de\u05d9\u05df \u05dc-suicidal intent?",
      "back": "\u05de\u05db\u05d9\u05d5\u05d5\u05df \u05e9\u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd \u05e6\u05e2\u05d9\u05e8\u05d9\u05dd \u05e0\u05d5\u05d8\u05d9\u05dd \u05dc\u05d4\u05e2\u05e8\u05db\u05ea \u05d7\u05e1\u05e8 \u05d0\u05d5 \u05d4\u05e2\u05e8\u05db\u05ea \u05d9\u05ea\u05e8 \u05e9\u05dc \u05de\u05d9\u05d3\u05ea \u05d4\u05e7\u05d8\u05dc\u05e0\u05d9\u05d5\u05ea \u05e9\u05dc \u05d4\u05e9\u05d9\u05d8\u05d4 \u05d1\u05d4 \u05d1\u05d7\u05e8\u05d5 (Dulcan p.608)."
    },
    {
      "front": "\u05de\u05d4\u05df \u05e9\u05ea\u05d9 \u05d4\u05d0\u05d9\u05e0\u05d3\u05d9\u05e7\u05e6\u05d9\u05d5\u05ea \u05d4\u05de\u05e8\u05db\u05d6\u05d9\u05d5\u05ea \u05dc\u05d4\u05de\u05dc\u05e6\u05d4 \u05e2\u05dc \u05d0\u05e9\u05e4\u05d5\u05d6 \u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9 (Psychiatric Hospitalization) \u05dc\u05d0\u05d7\u05e8 \u05d4\u05e2\u05e8\u05db\u05d4 \u05d1\u05de\u05d9\u05d5\u05df?",
      "back": "\u05e2\u05d3\u05d5\u05ea \u05dc-strong suicidal intent (\u05db\u05de\u05d5 \u05ea\u05db\u05e0\u05d9\u05ea \u05d1\u05e8\u05ea \u05d1\u05d9\u05e6\u05d5\u05e2) \u05d5\u05d4\u05e2\u05d3\u05e8 \u05ea\u05de\u05d9\u05db\u05d4 \u05d7\u05d1\u05e8\u05ea\u05d9\u05ea \u05de\u05e1\u05e4\u05e7\u05ea \u05dc\u05d4\u05d1\u05d8\u05d7\u05ea \u05d1\u05d8\u05d9\u05d7\u05d5\u05ea \u05d4\u05de\u05d8\u05d5\u05e4\u05dc (Dulcan p.608)."
    },
    {
      "front": "\u05de\u05d4\u05dd \u05d0\u05e8\u05d1\u05e2\u05ea \u05d4\u05de\u05e8\u05db\u05d9\u05d1\u05d9\u05dd \u05d4\u05d1\u05e1\u05d9\u05e1\u05d9\u05d9\u05dd \u05e9\u05d9\u05e9 \u05dc\u05db\u05dc\u05d5\u05dc \u05d1-Safety Plan \u05e2\u05d1\u05d5\u05e8 \u05d9\u05dc\u05d3 \u05d4\u05de\u05e9\u05ea\u05d7\u05e8\u05e8 \u05dc\u05d1\u05d9\u05ea\u05d5 \u05dc\u05d0\u05d7\u05e8 \u05de\u05e9\u05d1\u05e8 \u05d0\u05d5\u05d1\u05d3\u05e0\u05d9?",
      "back": "\u05d6\u05d9\u05d4\u05d5\u05d9 warning signs, \u05d0\u05e1\u05d8\u05e8\u05d8\u05d2\u05d9\u05d5\u05ea \u05d4\u05ea\u05de\u05d5\u05d3\u05d3\u05d5\u05ea (coping), \u05d0\u05e0\u05e9\u05d9 \u05e7\u05e9\u05e8 \u05dc\u05ea\u05de\u05d9\u05db\u05d4 \u05d5\u05d4\u05d2\u05d1\u05dc\u05ea \u05e0\u05d2\u05d9\u05e9\u05d5\u05ea \u05dc\u05d0\u05de\u05e6\u05e2\u05d9\u05dd \u05e7\u05d8\u05dc\u05e0\u05d9\u05d9\u05dd (means restriction) (Dulcan p.609)."
    },
    {
      "front": "\u05d0\u05d9\u05d6\u05d5 \u05d1\u05d3\u05d9\u05e7\u05ea \u05e2\u05d6\u05e8 \u05de\u05d5\u05de\u05dc\u05e6\u05ea \u05dc\u05e9\u05dc\u05d9\u05dc\u05ea CNS disorders \u05d1\u05de\u05e7\u05e8\u05d4 \u05e9\u05dc first-episode psychosis \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd?",
      "back": "\u05de\u05d5\u05de\u05dc\u05e5 \u05dc\u05d1\u05e6\u05e2 \u05d1\u05d3\u05d9\u05e7\u05ea MRI (Dulcan p.150)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4-ICD-10-CM code \u05e2\u05d1\u05d5\u05e8 \u05d0\u05d1\u05d7\u05e0\u05ea Catatonia Associated With Another Mental Disorder \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR?",
      "back": "\u05d4\u05e7\u05d5\u05d3 \u05d4\u05d5\u05d0 F06.1 (DSM p.135)."
    },
    {
      "front": "\u05d0\u05d9\u05dc\u05d5 \u05de\u05e6\u05d1\u05d9\u05dd \u05e8\u05e4\u05d5\u05d0\u05d9\u05d9\u05dd \u05e1\u05d9\u05e1\u05d8\u05de\u05d9\u05d9\u05dd \u05d9\u05e9 \u05dc\u05e9\u05dc\u05d5\u05dc \u05d1\u05d9\u05dc\u05d3 \u05d4\u05de\u05e6\u05d9\u05d2 \u05d0\u05d2\u05e8\u05e1\u05d9\u05d1\u05d9\u05d5\u05ea \u05e4\u05ea\u05d0\u05d5\u05de\u05d9\u05ea \u05d0\u05d5 delirium?",
      "back": "\u05d9\u05e9 \u05dc\u05e9\u05dc\u05d5\u05dc \u05d7\u05e9\u05d9\u05e4\u05d4 \u05dc\u05d8\u05d5\u05e7\u05e1\u05d9\u05e0\u05d9\u05dd, seizure disorders (\u05de\u05e6\u05d1 \u05d0\u05d9\u05e7\u05d8\u05dc\u05d9 \u05d0\u05d5 \u05d0\u05d9\u05e0\u05d8\u05e8-\u05d0\u05d9\u05e7\u05d8\u05dc\u05d9), \u05d6\u05d9\u05d4\u05d5\u05de\u05d9\u05dd \u05d5\u05d8\u05e8\u05d0\u05d5\u05de\u05ea \u05e8\u05d0\u05e9 (Dulcan p.594)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05de\u05d9\u05e0\u05d5\u05df \u05d4-oral \u05d4\u05d4\u05ea\u05d7\u05dc\u05ea\u05d9 \u05d4\u05de\u05d5\u05de\u05dc\u05e5 \u05e9\u05dc Chlorpromazine \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-severe behavioral problems \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd?",
      "back": "\u05d4\u05de\u05d9\u05e0\u05d5\u05df \u05d4\u05d5\u05d0 $0.55 \\text{ mg/kg}$ \u05db\u05dc 4-6 \u05e9\u05e2\u05d5\u05ea \u05dc\u05e4\u05d9 \u05d4\u05e6\u05d5\u05e8\u05da (StahlKids p.101)."
    },
    {
      "front": "\u05de\u05d4 \u05d9\u05e9 \u05dc\u05e0\u05d8\u05e8 \u05d1\u05d0\u05d5\u05e4\u05df \u05e7\u05d1\u05d5\u05e2 \u05d1\u05e2\u05ea \u05de\u05ea\u05df $\\alpha_{2}$-Adrenergic receptor agonists (\u05db\u05d2\u05d5\u05df Clonidine) \u05d1\u05d7\u05d9\u05e8\u05d5\u05dd?",
      "back": "\u05d9\u05e9 \u05dc\u05e0\u05d8\u05e8 \u05dc\u05d7\u05e5 \u05d3\u05dd (blood pressure) \u05d1\u05e9\u05dc \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05dc-hypotension (Dulcan p.612)."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05de\u05e9\u05ea\u05e0\u05d4 \u05d4\u05de\u05d8\u05d1\u05d5\u05dc\u05d9\u05d6\u05dd \u05e9\u05dc \u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05e8\u05d5\u05e4\u05d9\u05d5\u05ea \u05d1\u05de\u05e2\u05d1\u05e8 \u05de\u05d9\u05dc\u05d3\u05d5\u05ea \u05dc\u05d2\u05d9\u05dc \u05d4\u05d4\u05ea\u05d1\u05d2\u05e8\u05d5\u05ea (puberty)?",
      "back": "\u05d4\u05de\u05d8\u05d1\u05d5\u05dc\u05d9\u05d6\u05dd \u05d4\u05d5\u05e4\u05da \u05dc\u05d9\u05d5\u05ea\u05e8 \u05d3\u05d5\u05de\u05d4 \u05dc\u05d6\u05d4 \u05e9\u05dc \u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd, \u05db\u05dc\u05d5\u05de\u05e8 \u05d4\u05d5\u05d0 \u05e0\u05d4\u05d9\u05d4 \u05d0\u05d9\u05d8\u05d9 \u05d9\u05d5\u05ea\u05e8 \u05d1\u05d4\u05e9\u05d5\u05d5\u05d0\u05d4 \u05dc\u05d9\u05dc\u05d3\u05d9\u05dd \u05e6\u05e2\u05d9\u05e8\u05d9\u05dd (StahlKids p.275)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05d4\u05e0\u05d7\u05d9\u05d4 \u05d4\u05de\u05e8\u05db\u05d6\u05d9\u05ea \u05dc\u05d4\u05d5\u05e8\u05d9\u05dd \u05dc\u05d2\u05d1\u05d9 means restriction \u05d1\u05d1\u05d9\u05ea \u05e9\u05d1\u05d5 \u05e0\u05de\u05e6\u05d0 \u05de\u05ea\u05d1\u05d2\u05e8 \u05d0\u05d5\u05d1\u05d3\u05e0\u05d9?",
      "back": "\u05d9\u05e9 \u05dc\u05d4\u05d5\u05e6\u05d9\u05d0 \u05db\u05dc\u05d9 \u05e0\u05e9\u05e7 (firearms) \u05de\u05d4\u05d1\u05d9\u05ea \u05d5\u05dc\u05d4\u05d2\u05d1\u05d9\u05dc \u05d2\u05d9\u05e9\u05d4 \u05dc\u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05d5\u05d7\u05e4\u05e6\u05d9\u05dd \u05d7\u05d3\u05d9\u05dd (Dulcan p.609)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05d2\u05d9\u05e9\u05d4 \u05d4\u05de\u05d5\u05de\u05dc\u05e6\u05ea \u05dc\u05ea\u05e7\u05e9\u05d5\u05e8\u05ea \u05e2\u05dd \u05d9\u05dc\u05d3 \u05e2\u05dd ASD \u05d1\u05de\u05d4\u05dc\u05da \u05d1\u05d3\u05d9\u05e7\u05d4 \u05d1\u05d7\u05d3\u05e8 \u05de\u05d9\u05d5\u05df?",
      "back": "\u05d9\u05e9 \u05dc\u05ea\u05e7\u05e9\u05e8 \u05d1\u05d0\u05de\u05e6\u05e2\u05d5\u05ea \u05d4-primary caregiver \u05d1\u05de\u05d9\u05d3\u05ea \u05d4\u05d0\u05e4\u05e9\u05e8 \u05d5\u05dc\u05d4\u05e9\u05ea\u05de\u05e9 \u05d1\u05e9\u05e4\u05d4 \u05e4\u05e9\u05d5\u05d8\u05d4 \u05d5\u05e2\u05d6\u05e8\u05d9\u05dd \u05d5\u05d9\u05d6\u05d5\u05d0\u05dc\u05d9\u05d9\u05dd (Dulcan p.616)."
    },
    {
      "front": "\u05de\u05ea\u05d9 \u05de\u05d5\u05de\u05dc\u05e5 \u05dc\u05d1\u05e6\u05e2 \u05d1\u05d3\u05d9\u05e7\u05ea TSH \u05de\u05db\u05d5\u05d5\u05e0\u05ea (targeted screening) \u05d1\u05de\u05ea\u05d1\u05d2\u05e8 \u05e2\u05dd \u05ea\u05e1\u05de\u05d9\u05e0\u05d9 \u05d7\u05e8\u05d3\u05d4?",
      "back": "\u05db\u05d0\u05e9\u05e8 \u05d9\u05e9 \u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4 \u05e9\u05dc \u05e2\u05dc\u05d9\u05d9\u05d4 \u05dc\u05d0\u05d7\u05e8\u05d5\u05e0\u05d4 \u05d1\u05de\u05e9\u05e7\u05dc, menometrorrhagia \u05d0\u05d5 \u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05d4\u05de\u05e9\u05e4\u05d9\u05e2\u05d5\u05ea \u05e2\u05dc \u05d4\u05ea\u05d9\u05e8\u05d5\u05d0\u05d9\u05d3 (Dulcan p.371)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05e9\u05dc untreated psychiatric illnesses \u05e9\u05d9\u05e9 \u05dc\u05e9\u05e7\u05d5\u05dc \u05de\u05d5\u05dc \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05d1\u05d8\u05d9\u05e4\u05d5\u05dc \u05ea\u05e8\u05d5\u05e4\u05ea\u05d9?",
      "back": "\u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05db\u05d5\u05dc\u05dc \u05e4\u05d2\u05d9\u05e2\u05d4 \u05d1\u05ea\u05e4\u05e7\u05d5\u05d3 \u05d4\u05d9\u05d5\u05de\u05d9\u05d5\u05de\u05d9 \u05d5\u05d4\u05d7\u05de\u05e8\u05d4 \u05d1\u05e1\u05d9\u05db\u05d5\u05df \u05d4\u05d0\u05d5\u05d1\u05d3\u05e0\u05d9, \u05d4\u05de\u05d4\u05d5\u05d5\u05d4 \u05d2\u05d5\u05e8\u05dd \u05de\u05d5\u05d5\u05ea \u05de\u05d5\u05d1\u05d9\u05dc \u05d1\u05e7\u05d1\u05d5\u05e6\u05ea \u05d2\u05d9\u05dc \u05d6\u05d5 (StahlKids p.30, p.291)."
    }
  ]
}