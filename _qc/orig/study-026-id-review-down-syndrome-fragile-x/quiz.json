{
  "title": "Neurodevelopmental Quiz",
  "questions": [
    {
      "question": "\u05d9\u05dc\u05d3 \u05d1\u05df 8 \u05de\u05d5\u05e4\u05e0\u05d4 \u05dc\u05d4\u05e2\u05e8\u05db\u05d4 \u05d1\u05e9\u05dc \u05e7\u05e9\u05d9\u05d9\u05dd \u05dc\u05d9\u05de\u05d5\u05d3\u05d9\u05d9\u05dd. \u05d1\u05d1\u05d3\u05d9\u05e7\u05d4 \u05e4\u05e1\u05d9\u05db\u05d5\u05de\u05d8\u05e8\u05d9\u05ea \u05e1\u05d8\u05e0\u05d3\u05e8\u05d8\u05d9\u05ea \u05de\u05ea\u05e7\u05d1\u05dc \u05e6\u05d9\u05d5\u05df $IQ = 68 \\pm 5$. \u05d4\u05d9\u05dc\u05d3 \u05e2\u05e6\u05de\u05d0\u05d9 \u05d1\u05e8\u05d7\u05e6\u05d4 \u05d5\u05d1\u05dc\u05d1\u05d5\u05e9, \u05d0\u05da \u05de\u05ea\u05e7\u05e9\u05d4 \u05de\u05d0\u05d5\u05d3 \u05d1\u05d4\u05d1\u05e0\u05ea \u05de\u05d5\u05e9\u05d2\u05d9 \u05d6\u05de\u05df \u05d5\u05db\u05e1\u05e3 \u05d5\u05d6\u05e7\u05d5\u05e7 \u05dc\u05ea\u05d9\u05d5\u05d5\u05da \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9 \u05d1\u05d0\u05d9\u05e0\u05d8\u05e8\u05d0\u05e7\u05e6\u05d9\u05d5\u05ea \u05d7\u05d1\u05e8\u05ea\u05d9\u05d5\u05ea. \u05de\u05d4\u05d9 \u05d4\u05e7\u05d1\u05d9\u05e2\u05d4 \u05d4\u05de\u05d3\u05d5\u05d9\u05e7\u05ea \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05d2\u05d1\u05d9 \u05d0\u05d1\u05d7\u05e0\u05ea Intellectual Developmental Disorder (ID) \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR?",
      "answerOptions": [
        {
          "text": "\u05d4\u05d9\u05dc\u05d3 \u05d0\u05d9\u05e0\u05d5 \u05e2\u05d5\u05e0\u05d4 \u05e2\u05dc \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df B \u05db\u05d9\u05d5\u05d5\u05df \u05e9\u05d4\u05d5\u05d0 \u05de\u05ea\u05e4\u05e7\u05d3 \u05d1\u05d0\u05d5\u05e4\u05df \u05ea\u05d5\u05d0\u05dd \u05d2\u05d9\u05dc \u05d1\u05ea\u05d7\u05d5\u05dd \u05d4-Practical.",
          "isCorrect": false,
          "rationale": "\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df B \u05d3\u05d5\u05e8\u05e9 \u05dc\u05d9\u05e7\u05d5\u05d9 \u05d1\u05ea\u05d7\u05d5\u05dd \u05d0\u05d7\u05d3 \u05dc\u05e4\u05d7\u05d5\u05ea (Conceptual, Social, \u05d0\u05d5 Practical) \u05db\u05d3\u05d9 \u05dc\u05d4\u05ea\u05e7\u05d9\u05d9\u05dd, \u05d5\u05dc\u05d0 \u05d1\u05db\u05dc \u05d4\u05e9\u05dc\u05d5\u05e9\u05d4."
        },
        {
          "text": "\u05d4\u05d9\u05dc\u05d3 \u05e2\u05d5\u05e0\u05d4 \u05e2\u05dc \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df B \u05db\u05d9\u05d5\u05d5\u05df \u05e9\u05e7\u05d9\u05d9\u05de\u05d9\u05dd \u05dc\u05d9\u05e7\u05d5\u05d9\u05d9\u05dd \u05d1\u05ea\u05e4\u05e7\u05d5\u05d3 \u05d4\u05d4\u05e1\u05ea\u05d2\u05dc\u05d5\u05ea\u05d9 \u05d1\u05ea\u05d7\u05d5\u05de\u05d9 \u05d4-Conceptual \u05d5\u05d4-Social.",
          "isCorrect": true,
          "rationale": "\u05dc\u05e4\u05d9 \u05d4-DSM-5-TR, \u05d2\u05e8\u05e2\u05d5\u05df \u05d4\u05e1\u05ea\u05d2\u05dc\u05d5\u05ea\u05d9 \u05d1\u05d0\u05d7\u05d3 \u05d0\u05d5 \u05d9\u05d5\u05ea\u05e8 \u05de\u05ea\u05d7\u05d5\u05de\u05d9 \u05d4\u05d7\u05d9\u05d9\u05dd (\u05db\u05de\u05d5 \u05ea\u05e7\u05e9\u05d5\u05e8\u05ea \u05d0\u05d5 \u05d4\u05e9\u05ea\u05ea\u05e4\u05d5\u05ea \u05d7\u05d1\u05e8\u05ea\u05d9\u05ea) \u05e2\u05dc \u05e4\u05e0\u05d9 \u05e1\u05d1\u05d9\u05d1\u05d5\u05ea \u05de\u05e8\u05d5\u05d1\u05d5\u05ea \u05de\u05e1\u05e4\u05d9\u05e7 \u05dc\u05d0\u05d1\u05d7\u05e0\u05d4."
        },
        {
          "text": "\u05dc\u05d0 \u05e0\u05d9\u05ea\u05df \u05dc\u05d0\u05d1\u05d7\u05df ID \u05db\u05d9\u05d5\u05d5\u05df \u05e9\u05e6\u05d9\u05d5\u05df \u05d4-IQ \u05d2\u05d1\u05d5\u05d4 \u05de-65.",
          "isCorrect": false,
          "rationale": "\u05d4\u05e1\u05e3 \u05dc\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05d5\u05d0 \u05db-2 \u05e1\u05d8\u05d9\u05d5\u05ea \u05ea\u05e7\u05df \u05de\u05ea\u05d7\u05ea \u05dc\u05de\u05de\u05d5\u05e6\u05e2 ($70 \\pm 5$), \u05d5\u05dc\u05db\u05df \u05e6\u05d9\u05d5\u05df 68 \u05e0\u05de\u05e6\u05d0 \u05d1\u05d8\u05d5\u05d5\u05d7 \u05d4\u05d0\u05d1\u05d7\u05e0\u05ea\u05d9."
        },
        {
          "text": "\u05d7\u05d5\u05de\u05e8\u05ea \u05d4\u05d4\u05e4\u05e8\u05e2\u05d4 \u05ea\u05d9\u05e7\u05d1\u05e2 \u05db-Mild \u05e2\u05dc \u05d1\u05e1\u05d9\u05e1 \u05e6\u05d9\u05d5\u05df \u05d4-IQ \u05d1\u05dc\u05d1\u05d3.",
          "isCorrect": false,
          "rationale": "\u05e8\u05de\u05d5\u05ea \u05d4\u05d7\u05d5\u05de\u05e8\u05d4 \u05d1-DSM-5-TR \u05e0\u05e7\u05d1\u05e2\u05d5\u05ea \u05e2\u05dc \u05d1\u05e1\u05d9\u05e1 \u05ea\u05e4\u05e7\u05d5\u05d3 \u05d4\u05e1\u05ea\u05d2\u05dc\u05d5\u05ea\u05d9 (Adaptive Functioning) \u05d5\u05dc\u05d0 \u05e2\u05dc \u05e4\u05d9 \u05e6\u05d9\u05d5\u05e0\u05d9 IQ."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05d3\u05e8\u05d9\u05e9\u05d5\u05ea \u05d4\u05de\u05d9\u05e0\u05d9\u05de\u05dc\u05d9\u05d5\u05ea \u05dc\u05e7\u05d9\u05d5\u05dd \u05dc\u05d9\u05e7\u05d5\u05d9 \u05d4\u05e1\u05ea\u05d2\u05dc\u05d5\u05ea\u05d9 \u05d5\u05e2\u05dc \u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df \u05e9\u05e7\u05d5\u05d1\u05e2 \u05d0\u05ea \u05e8\u05de\u05ea \u05d4\u05d7\u05d5\u05de\u05e8\u05d4.",
      "citations": "(DSM p.37-38, Dulcan p.109)"
    },
    {
      "question": "\u05de\u05d8\u05d5\u05e4\u05dc \u05d1\u05df 45 \u05e2\u05dd Down Syndrome (Trisomy 21) \u05de\u05d5\u05d1\u05d0 \u05dc\u05de\u05e8\u05e4\u05d0\u05d4 \u05d1\u05e9\u05dc \u05d9\u05e8\u05d9\u05d3\u05d4 \u05ea\u05e4\u05e7\u05d5\u05d3\u05d9\u05ea \u05d7\u05d3\u05e9\u05d4, \u05d0\u05d3\u05d9\u05e9\u05d5\u05ea (Apathy) \u05d5\u05d4\u05d5\u05e4\u05e2\u05ea \u05d4\u05ea\u05e4\u05e8\u05e6\u05d5\u05d9\u05d5\u05ea \u05d6\u05e2\u05dd \u05e9\u05dc\u05d0 \u05d4\u05d9\u05d5 \u05d1\u05e2\u05d1\u05e8. \u05de\u05d4\u05d5 \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05e0\u05d5\u05d9\u05e8\u05d5\u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d4\u05e2\u05d9\u05e7\u05e8\u05d9 \u05d4\u05de\u05e1\u05d1\u05d9\u05e8 \u05d0\u05ea \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05d4\u05de\u05d5\u05d2\u05d1\u05e8 \u05e9\u05dc \u05d0\u05d5\u05db\u05dc\u05d5\u05e1\u05d9\u05d9\u05d4 \u05d6\u05d5 \u05dc\u05e4\u05ea\u05d7 Major Neurocognitive Disorder (NCD)?",
      "answerOptions": [
        {
          "text": "\u05d9\u05d9\u05e6\u05d5\u05e8 \u05d9\u05ea\u05e8 \u05e9\u05dc \u05d7\u05dc\u05d1\u05d5\u05df \u05d4-APP \u05d1\u05e9\u05dc \u05de\u05d9\u05e7\u05d5\u05de\u05d5 \u05e2\u05dc \u05db\u05e8\u05d5\u05de\u05d5\u05d6\u05d5\u05dd 21.",
          "isCorrect": true,
          "rationale": "\u05d4\u05d2\u05df \u05dc-Amyloid Precursor Protein \u05de\u05de\u05d5\u05e7\u05dd \u05e2\u05dc \u05db\u05e8\u05d5\u05de\u05d5\u05d6\u05d5\u05dd 21, \u05d5\u05d8\u05e8\u05d9\u05d6\u05d5\u05de\u05d9\u05d4 \u05de\u05d5\u05d1\u05d9\u05dc\u05d4 \u05dc-Overexpression \u05d5\u05dc\u05e6\u05d1\u05d9\u05e8\u05ea \u05e4\u05dc\u05d0\u05e7\u05d9\u05dd \u05e9\u05dc \u05d1\u05d8\u05d0-\u05e2\u05de\u05d9\u05dc\u05d5\u05d0\u05d9\u05d3 \u05de\u05d2\u05d9\u05dc \u05e6\u05e2\u05d9\u05e8."
        },
        {
          "text": "\u05d4\u05e9\u05ea\u05e7\u05d4 \u05d2\u05e0\u05d8\u05d9\u05ea (Gene Silencing) \u05e9\u05dc \u05d4\u05d2\u05df FMR1 \u05d4\u05de\u05d5\u05d1\u05d9\u05dc\u05d4 \u05dc\u05e0\u05d9\u05d5\u05d5\u05df \u05e2\u05e6\u05d1\u05d9.",
          "isCorrect": false,
          "rationale": "\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d6\u05d4 \u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05d0\u05ea \u05ea\u05e1\u05de\u05d5\u05e0\u05ea \u05d4-X \u05d4\u05e9\u05d1\u05d9\u05e8 \u05d5\u05dc\u05d0 \u05d0\u05ea \u05ea\u05e1\u05de\u05d5\u05e0\u05ea \u05d3\u05d0\u05d5\u05df."
        },
        {
          "text": "\u05d7\u05d5\u05e1\u05e8 \u05de\u05d5\u05d7\u05dc\u05d8 \u05d1\u05d0\u05e0\u05d6\u05d9\u05dd \u05d4\u05de\u05e4\u05e8\u05e7 \u05d7\u05dc\u05d1\u05d5\u05df \u05d8\u05d0\u05d5 (Tau) \u05e9\u05e2\u05d1\u05e8 \u05d4\u05d9\u05e4\u05e8-\u05e4\u05d5\u05e1\u05e4\u05d5\u05e8\u05d9\u05dc\u05e6\u05d9\u05d4.",
          "isCorrect": false,
          "rationale": "\u05d1\u05e2\u05d5\u05d3 \u05e9\u05d7\u05dc\u05d1\u05d5\u05df \u05d8\u05d0\u05d5 \u05de\u05e2\u05d5\u05e8\u05d1 \u05d1\u05e4\u05ea\u05d5\u05dc\u05d5\u05d2\u05d9\u05d4, \u05d4\u05d1\u05e2\u05d9\u05d4 \u05d4\u05e2\u05d9\u05e7\u05e8\u05d9\u05ea \u05d1\u05d3\u05d0\u05d5\u05df \u05de\u05ea\u05d7\u05d9\u05dc\u05d4 \u05de\u05d4\u05e6\u05d8\u05d1\u05e8\u05d5\u05ea \u05e2\u05de\u05d9\u05dc\u05d5\u05d0\u05d9\u05d3 \u05e2\u05e7\u05d1 \u05d4\u05e2\u05d5\u05ea\u05e7 \u05d4\u05e2\u05d5\u05d3\u05e3 \u05e9\u05dc APP."
        },
        {
          "text": "\u05e8\u05de\u05d5\u05ea \u05e0\u05de\u05d5\u05db\u05d5\u05ea \u05e9\u05dc Dopamine \u05d1-Basal Ganglia \u05db\u05d7\u05dc\u05e7 \u05de\u05ea\u05d4\u05dc\u05d9\u05da \u05d4-Nondisjunction.",
          "isCorrect": false,
          "rationale": "\u05dc\u05d9\u05e7\u05d5\u05d9 \u05d3\u05d5\u05e4\u05de\u05d9\u05e0\u05e8\u05d2\u05d9 \u05d1-Basal Ganglia \u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05d9 \u05dc\u05e4\u05e8\u05e7\u05d9\u05e0\u05e1\u05d5\u05e0\u05d9\u05d6\u05dd \u05d0\u05d5 \u05dc-DLB, \u05d0\u05da \u05d0\u05d9\u05e0\u05d5 \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05e8\u05d0\u05e9\u05d5\u05e0\u05d9 \u05e9\u05dc \u05d0\u05dc\u05e6\u05d4\u05d9\u05d9\u05de\u05e8 \u05d1\u05ea\u05e1\u05de\u05d5\u05e0\u05ea \u05d3\u05d0\u05d5\u05df."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05e7\u05e9\u05e8 \u05d1\u05d9\u05df \u05d4\u05d2\u05e0\u05d8\u05d9\u05e7\u05d4 \u05e9\u05dc \u05db\u05e8\u05d5\u05de\u05d5\u05d6\u05d5\u05dd 21 \u05dc\u05d1\u05d9\u05df \u05d4\u05e4\u05ea\u05d5\u05dc\u05d5\u05d2\u05d9\u05d4 \u05e9\u05dc Alzheimer's Disease.",
      "citations": "(Dulcan p.119, StahlNeuro p.496/1373)"
    },
    {
      "question": "\u05e0\u05e2\u05e8 \u05d1\u05df 15 \u05e2\u05dd \u05de\u05d5\u05d2\u05d1\u05dc\u05d5\u05ea \u05e9\u05db\u05dc\u05d9\u05ea \u05d1\u05d9\u05e0\u05d5\u05e0\u05d9\u05ea \u05de\u05e6\u05d9\u05d2 \u05e4\u05e0\u05d9\u05dd \u05d0\u05e8\u05d5\u05db\u05d5\u05ea, \u05d0\u05d5\u05d6\u05e0\u05d9\u05d9\u05dd \u05d1\u05d5\u05dc\u05d8\u05d5\u05ea, \u05d5\u05d3\u05d9\u05d1\u05d5\u05e8 \u05de\u05d4\u05d9\u05e8 \u05e2\u05dd \u05d7\u05d6\u05e8\u05d5\u05ea (Cluttering). \u05d1\u05d1\u05d3\u05d9\u05e7\u05d4 \u05d2\u05d5\u05e4\u05e0\u05d9\u05ea \u05e0\u05e6\u05e4\u05d4 Macro-orchidism \u05d1\u05d5\u05dc\u05d8. \u05de\u05d4\u05d5 \u05d4\u05de\u05de\u05e6\u05d0 \u05d4\u05d2\u05e0\u05d8\u05d9 \u05d4\u05e1\u05d1\u05d9\u05e8 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d0\u05e6\u05dc \u05e0\u05e2\u05e8 \u05d6\u05d4?",
      "answerOptions": [
        {
          "text": "\u05de\u05d5\u05d8\u05e6\u05d9\u05d4 \u05d3\u05d9\u05e0\u05de\u05d9\u05ea \u05e2\u05dd \u05de\u05e2\u05dc \u05dc-200 \u05d7\u05d6\u05e8\u05d5\u05ea \u05e9\u05dc \u05d4\u05e9\u05dc\u05e9\u05d9\u05d9\u05d4 CGG \u05d1\u05d2\u05df FMR1.",
          "isCorrect": true,
          "rationale": "Full Mutation \u05e9\u05dc Fragile X Syndrome \u05de\u05d5\u05d2\u05d3\u05e8\u05ea \u05db\u05de\u05e2\u05dc 200 \u05d7\u05d6\u05e8\u05d5\u05ea, \u05de\u05d4 \u05e9\u05de\u05d5\u05d1\u05d9\u05dc \u05dc\u05de\u05ea\u05d9\u05dc\u05e6\u05d9\u05d4 \u05d5\u05d4\u05e9\u05ea\u05e7\u05ea \u05d4\u05d2\u05df."
        },
        {
          "text": "\u05de\u05e6\u05d1 \u05e9\u05dc Premutation \u05e2\u05dd 55-200 \u05d7\u05d6\u05e8\u05d5\u05ea CGG.",
          "isCorrect": false,
          "rationale": "\u05de\u05e6\u05d1 \u05d6\u05d4 \u05dc\u05e8\u05d5\u05d1 \u05d0\u05d9\u05e0\u05d5 \u05d2\u05d5\u05e8\u05dd \u05dc-ID \u05e7\u05dc\u05d0\u05e1\u05d9 \u05d0\u05dc\u05d0 \u05e7\u05e9\u05d5\u05e8 \u05dc\u05ea\u05e1\u05de\u05d5\u05e0\u05d5\u05ea \u05de\u05d0\u05d5\u05d7\u05e8\u05d5\u05ea \u05db\u05de\u05d5 FXTAS \u05d0\u05d5 FXPOI."
        },
        {
          "text": "Microdeletion \u05d1\u05d0\u05d6\u05d5\u05e8 22q11.2.",
          "isCorrect": false,
          "rationale": "\u05ea\u05e1\u05de\u05d5\u05e0\u05ea \u05d6\u05d5 \u05de\u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05ea \u05d1\u05de\u05d5\u05de\u05d9 \u05dc\u05d1 \u05d5\u05d7\u05da \u05d5\u05e1\u05d9\u05db\u05d5\u05df \u05d2\u05d1\u05d5\u05d4 \u05dc-Schizophrenia, \u05d0\u05da \u05dc\u05d0 \u05d1-Macro-orchidism."
        },
        {
          "text": "\u05d8\u05e8\u05d9\u05d6\u05d5\u05de\u05d9\u05d4 \u05de\u05d5\u05d6\u05d0\u05d9\u05e7\u05d9\u05ea \u05e9\u05dc \u05db\u05e8\u05d5\u05de\u05d5\u05d6\u05d5\u05dd 21.",
          "isCorrect": false,
          "rationale": "\u05ea\u05e1\u05de\u05d5\u05e0\u05ea \u05d3\u05d0\u05d5\u05df \u05d0\u05d9\u05e0\u05d4 \u05de\u05e6\u05d9\u05d2\u05d4 \u05e4\u05e0\u05d5\u05d8\u05d9\u05e4 \u05e9\u05dc Macro-orchidism \u05d0\u05d5 \u05e4\u05e0\u05d9\u05dd \u05d0\u05e8\u05d5\u05db\u05d5\u05ea \u05d5\u05e6\u05e8\u05d5\u05ea."
        }
      ],
      "hint": "\u05d4\u05de\u05de\u05e6\u05d0 \u05d4\u05e4\u05d9\u05d6\u05d9 \u05d1\u05d0\u05e9\u05db\u05d9\u05dd \u05dc\u05d0\u05d7\u05e8 \u05d2\u05d9\u05dc \u05d4\u05d4\u05ea\u05d1\u05d2\u05e8\u05d5\u05ea \u05d4\u05d5\u05d0 \u05e1\u05d9\u05de\u05df \u05d4\u05d9\u05db\u05e8 \u05e7\u05dc\u05d0\u05e1\u05d9 \u05dc\u05ea\u05e1\u05de\u05d5\u05e0\u05ea \u05d2\u05e0\u05d8\u05d9\u05ea \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05ea.",
      "citations": "(Dulcan p.120)"
    },
    {
      "question": "\u05d1\u05ea\u05d4\u05dc\u05d9\u05da \u05d4\u05e2\u05e8\u05db\u05d4 \u05e9\u05dc \u05d9\u05dc\u05d3 \u05e2\u05dd Down Syndrome \u05d4\u05de\u05e6\u05d9\u05d2 \u05ea\u05e1\u05de\u05d9\u05e0\u05d9 ADHD \u05e7\u05e9\u05d9\u05dd, \u05d4\u05d4\u05d5\u05e8\u05d9\u05dd \u05de\u05e2\u05d5\u05e0\u05d9\u05d9\u05e0\u05d9\u05dd \u05dc\u05d4\u05ea\u05d7\u05d9\u05dc \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Methylphenidate. \u05de\u05d4\u05d9 \u05d4\u05e4\u05e2\u05d5\u05dc\u05d4 \u05d4\u05e8\u05e4\u05d5\u05d0\u05d9\u05ea \u05d4\u05e7\u05e8\u05d9\u05d8\u05d9\u05ea \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05e4\u05e0\u05d9 \u05ea\u05d7\u05d9\u05dc\u05ea \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc, \u05d1\u05d4\u05ea\u05d7\u05e9\u05d1 \u05d1\u05d0\u05d8\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05d4 \u05e9\u05dc \u05d4\u05d9\u05dc\u05d3?",
      "answerOptions": [
        {
          "text": "\u05d1\u05d9\u05e6\u05d5\u05e2 ECG \u05d5\u05d9\u05d9\u05e2\u05d5\u05e5 \u05e7\u05e8\u05d3\u05d9\u05d5\u05dc\u05d5\u05d2 \u05d9\u05dc\u05d3\u05d9\u05dd \u05d1\u05e9\u05dc \u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d2\u05d1\u05d5\u05d4\u05d4 \u05e9\u05dc \u05de\u05d5\u05de\u05d9\u05dd \u05dc\u05d1\u05d1\u05d9\u05d9\u05dd \u05de\u05d1\u05e0\u05d9\u05d9\u05dd.",
          "isCorrect": true,
          "rationale": "\u05dc\u05e4\u05d9 \u05d4-Black Box Warning \u05d5\u05e1\u05e4\u05e8\u05d9 \u05d4\u05dc\u05d9\u05de\u05d5\u05d3, \u05d9\u05e9\u05e0\u05d4 \u05d0\u05d6\u05d4\u05e8\u05d4 \u05d7\u05de\u05d5\u05e8\u05d4 \u05dc\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05e1\u05d8\u05d9\u05dc\u05de\u05d5\u05dc\u05e0\u05d8\u05d9\u05dd \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd \u05de\u05d5\u05de\u05d9\u05dd \u05dc\u05d1\u05d1\u05d9\u05d9\u05dd \u05de\u05d1\u05e0\u05d9\u05d9\u05dd, \u05d4\u05e9\u05db\u05d9\u05d7\u05d9\u05dd \u05de\u05d0\u05d5\u05d3 \u05d1\u05d3\u05d0\u05d5\u05df."
        },
        {
          "text": "\u05d1\u05d3\u05d9\u05e7\u05ea \u05e8\u05de\u05d5\u05ea Lead \u05d1\u05d3\u05dd \u05d1\u05dc\u05d1\u05d3 \u05d1\u05e9\u05dc \u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4 \u05e9\u05dc Pica.",
          "isCorrect": false,
          "rationale": "\u05d0\u05e3 \u05e9-Lead screening \u05d7\u05e9\u05d5\u05d1 \u05d1-ID, \u05d4\u05d5\u05d0 \u05d0\u05d9\u05e0\u05d5 \u05de\u05d4\u05d5\u05d5\u05d4 \u05d0\u05ea \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05d1\u05de\u05ea\u05df \u05e1\u05d8\u05d9\u05de\u05d5\u05dc\u05e0\u05d8\u05d9\u05dd \u05d1\u05de\u05e7\u05e8\u05d4 \u05e9\u05dc \u05d3\u05d0\u05d5\u05df."
        },
        {
          "text": "\u05e0\u05d9\u05d8\u05d5\u05e8 \u05d2\u05d5\u05d1\u05d4 \u05d5\u05de\u05e9\u05e7\u05dc \u05d1\u05dc\u05d1\u05d3 \u05db\u05d9\u05d5\u05d5\u05df \u05e9\u05e1\u05d8\u05d9\u05de\u05d5\u05dc\u05e0\u05d8\u05d9\u05dd \u05d0\u05d9\u05e0\u05dd \u05de\u05e9\u05e4\u05d9\u05e2\u05d9\u05dd \u05e2\u05dc \u05d4\u05dc\u05d1.",
          "isCorrect": false,
          "rationale": "\u05e1\u05d8\u05d9\u05de\u05d5\u05dc\u05e0\u05d8\u05d9\u05dd \u05d2\u05d5\u05e8\u05de\u05d9\u05dd \u05dc\u05e2\u05dc\u05d9\u05d9\u05d4 \u05d1\u05d3\u05d5\u05e4\u05e7 \u05d5\u05dc\u05d7\u05e5 \u05d3\u05dd, \u05de\u05d4 \u05e9\u05e2\u05dc\u05d5\u05dc \u05dc\u05d4\u05d9\u05d5\u05ea \u05de\u05e1\u05d5\u05db\u05df \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd \u05e4\u05ea\u05d5\u05dc\u05d5\u05d2\u05d9\u05d4 \u05dc\u05d1\u05d1\u05d9\u05ea \u05e7\u05d9\u05d9\u05de\u05ea."
        },
        {
          "text": "\u05d1\u05d9\u05e6\u05d5\u05e2 \u05d1\u05d3\u05d9\u05e7\u05ea EEG \u05dc\u05e9\u05dc\u05d9\u05dc\u05ea \u05e4\u05e8\u05db\u05d5\u05e1\u05d9\u05dd \u05e1\u05de\u05d5\u05d9\u05d9\u05dd.",
          "isCorrect": false,
          "rationale": "\u05d1\u05d3\u05d9\u05e7\u05ea EEG \u05d0\u05d9\u05e0\u05d4 \u05e0\u05d3\u05e8\u05e9\u05ea \u05db\u05e8\u05d5\u05d8\u05d9\u05e0\u05d4 \u05dc\u05e4\u05e0\u05d9 \u05ea\u05d7\u05d9\u05dc\u05ea \u05e1\u05d8\u05d9\u05de\u05d5\u05dc\u05e0\u05d8\u05d9\u05dd, \u05d0\u05dc\u05d0 \u05d0\u05dd \u05d9\u05e9 \u05d7\u05e9\u05d3 \u05e7\u05dc\u05d9\u05e0\u05d9 \u05dc\u05e4\u05e8\u05db\u05d5\u05e1\u05d9\u05dd."
        }
      ],
      "hint": "\u05d6\u05db\u05d5\u05e8 \u05d0\u05ea \u05d4\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d4\u05d2\u05d1\u05d5\u05d4\u05d4 \u05e9\u05dc AVSD \u05d1-Down Syndrome \u05d5\u05d0\u05ea \u05d4\u05d0\u05d6\u05d4\u05e8\u05d5\u05ea \u05e2\u05dc \u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05de\u05de\u05e8\u05d9\u05e6\u05d5\u05ea.",
      "citations": "(StahlKids p.11, p.207/1152, Dulcan p.119)"
    },
    {
      "question": "\u05e0\u05e2\u05e8\u05d4 \u05d1\u05ea 16 \u05d4\u05de\u05d0\u05d5\u05d1\u05d7\u05e0\u05ea \u05e2\u05dd ID \u05de\u05e6\u05d9\u05d2\u05d4 \u05e0\u05e1\u05d9\u05d2\u05d4 \u05e7\u05dc\u05d4 \u05d1\u05dc\u05d9\u05de\u05d5\u05d3\u05d9\u05dd, \u05e2\u05d9\u05d9\u05e4\u05d5\u05ea \u05de\u05d5\u05d2\u05d1\u05e8\u05ea, \u05d4\u05d0\u05d8\u05d4 \u05e4\u05e1\u05d9\u05db\u05d5\u05de\u05d5\u05d8\u05d5\u05e8\u05d9\u05ea \u05d5\u05e2\u05e6\u05d9\u05e8\u05d5\u05ea. \u05d4\u05d4\u05d5\u05e8\u05d9\u05dd \u05d7\u05d5\u05e9\u05d3\u05d9\u05dd \u05d1-Major Depressive Disorder. \u05de\u05d4\u05d5 \u05d4-Medical Mimic \u05e9\u05d7\u05d5\u05d1\u05d4 \u05dc\u05e9\u05dc\u05d5\u05dc \u05e7\u05d5\u05d3\u05dd \u05dc\u05db\u05df, \u05d1\u05de\u05d9\u05d5\u05d7\u05d3 \u05d0\u05dd \u05dc\u05e0\u05e2\u05e8\u05d4 \u05d9\u05e9 Down Syndrome?",
      "answerOptions": [
        {
          "text": "Hypothyroidism",
          "isCorrect": true,
          "rationale": "\u05ea\u05e1\u05de\u05d5\u05e0\u05ea \u05d3\u05d0\u05d5\u05df \u05e7\u05e9\u05d5\u05e8\u05d4 \u05d1\u05e9\u05d9\u05e2\u05d5\u05e8 \u05d2\u05d1\u05d5\u05d4 \u05dc\u05de\u05d7\u05dc\u05d5\u05ea \u05d0\u05d5\u05d8\u05d5\u05d0\u05d9\u05de\u05d5\u05e0\u05d9\u05d5\u05ea \u05e9\u05dc \u05d1\u05dc\u05d5\u05d8\u05ea \u05d4\u05ea\u05e8\u05d9\u05e1, \u05e9\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05d4\u05df \u05de\u05d7\u05e7\u05d9\u05dd \u05d3\u05d9\u05db\u05d0\u05d5\u05df."
        },
        {
          "text": "Hypercalcemia",
          "isCorrect": false,
          "rationale": "\u05d1\u05e2\u05d5\u05d3 \u05e9\u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd \u05d1\u05e1\u05d9\u05d3\u05df \u05d9\u05db\u05d5\u05dc\u05d9\u05dd \u05dc\u05d2\u05e8\u05d5\u05dd \u05dc\u05e2\u05d9\u05d9\u05e4\u05d5\u05ea, Hypothyroidism \u05d4\u05d5\u05d0 \u05d4\u05de\u05de\u05e6\u05d0 \u05d4\u05e9\u05db\u05d9\u05d7 \u05d5\u05d4\u05e7\u05dc\u05d0\u05e1\u05d9 \u05d9\u05d5\u05ea\u05e8 \u05d1\u05d3\u05d0\u05d5\u05df."
        },
        {
          "text": "Cushing's Syndrome",
          "isCorrect": false,
          "rationale": "\u05ea\u05e1\u05de\u05d5\u05e0\u05ea \u05d6\u05d5 \u05e7\u05e9\u05d5\u05e8\u05d4 \u05dc\u05e2\u05d5\u05d3\u05e3 \u05e7\u05d5\u05e8\u05d8\u05d9\u05d6\u05d5\u05dc \u05d5\u05d0\u05d9\u05e0\u05d4 \u05e0\u05d7\u05e9\u05d1\u05ea \u05dc\u05e7\u05d5\u05de\u05d5\u05e8\u05d1\u05d9\u05d3\u05d9\u05d5\u05ea \u05e7\u05dc\u05d0\u05e1\u05d9\u05ea \u05d5\u05e9\u05db\u05d9\u05d7\u05d4 \u05d1-ID \u05db\u05de\u05d5 \u05de\u05d7\u05dc\u05d5\u05ea \u05ea\u05e8\u05d9\u05e1."
        },
        {
          "text": "Wilson's Disease",
          "isCorrect": false,
          "rationale": "\u05de\u05d7\u05dc\u05ea \u05d5\u05d9\u05dc\u05e1\u05d5\u05df \u05e7\u05e9\u05d5\u05e8\u05d4 \u05dc\u05d4\u05e6\u05d8\u05d1\u05e8\u05d5\u05ea \u05e0\u05d7\u05d5\u05e9\u05ea \u05d5\u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd \u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9\u05d9\u05dd, \u05d0\u05da \u05d0\u05d9\u05e0\u05d4 \u05de\u05e6\u05d9\u05d2\u05d4 \u05d0\u05ea \u05d4\u05e4\u05e0\u05d5\u05d8\u05d9\u05e4 \u05e9\u05dc \u05d4\u05d0\u05d8\u05d4 \u05d5\u05e2\u05e6\u05d9\u05e8\u05d5\u05ea \u05db\u05e9\u05db\u05d9\u05d7\u05d4 \u05d1\u05d3\u05d0\u05d5\u05df."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05d1\u05d3\u05d9\u05e7\u05d4 \u05d4\u05de\u05e2\u05d1\u05d3\u05ea\u05d9\u05ea (TSH) \u05e9\u05d4\u05d9\u05d0 \u05d7\u05dc\u05e7 \u05de\u05e4\u05e8\u05d5\u05d8\u05d5\u05e7\u05d5\u05dc \u05d4\u05e1\u05e7\u05e8 \u05d4\u05e8\u05d5\u05d8\u05d9\u05e0\u05d9 \u05d1\u05d0\u05d5\u05db\u05dc\u05d5\u05e1\u05d9\u05d9\u05d4 \u05d6\u05d5.",
      "citations": "(Dulcan p.1095, Syllabus p.53)"
    },
    {
      "question": "\u05e1\u05d1\u05d0 \u05dc\u05e0\u05db\u05d3 \u05d4\u05de\u05d0\u05d5\u05d1\u05d7\u05df \u05e2\u05dd Fragile X Syndrome \u05de\u05d2\u05d9\u05e2 \u05dc\u05d9\u05d9\u05e2\u05d5\u05e5 \u05d1\u05e9\u05dc \u05e8\u05e2\u05d3 (Tremor) \u05d7\u05d3\u05e9 \u05d1\u05d9\u05d3\u05d9\u05d9\u05dd \u05d5\u05e7\u05e9\u05d9\u05d9\u05dd \u05d1\u05d4\u05dc\u05d9\u05db\u05d4 (Ataxia) \u05e9\u05d4\u05d5\u05e4\u05d9\u05e2\u05d5 \u05d1\u05d2\u05d9\u05dc 60. \u05de\u05d4\u05d5 \u05d4\u05d4\u05e1\u05d1\u05e8 \u05d4\u05e1\u05d1\u05d9\u05e8 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05de\u05e6\u05d1\u05d5?",
      "answerOptions": [
        {
          "text": "\u05d4\u05e1\u05d1\u05d0 \u05e0\u05d5\u05e9\u05d0 \u05e4\u05e8\u05d4-\u05de\u05d5\u05d8\u05e6\u05d9\u05d4 (55-200 \u05d7\u05d6\u05e8\u05d5\u05ea) \u05d5\u05e0\u05de\u05e6\u05d0 \u05d1\u05e1\u05d9\u05db\u05d5\u05df \u05dc-FXTAS.",
          "isCorrect": true,
          "rationale": "Fragile X-associated Tremor/Ataxia Syndrome \u05de\u05d5\u05e4\u05d9\u05e2\u05d4 \u05d0\u05e6\u05dc \u05e0\u05e9\u05d0\u05d9 \u05e4\u05e8\u05d4-\u05de\u05d5\u05d8\u05e6\u05d9\u05d4, \u05dc\u05e8\u05d5\u05d1 \u05d6\u05db\u05e8\u05d9\u05dd \u05de\u05e2\u05dc \u05d2\u05d9\u05dc 50."
        },
        {
          "text": "\u05d4\u05e1\u05d1\u05d0 \u05e1\u05d5\u05d1\u05dc \u05de-Early-onset Alzheimer's Disease \u05d4\u05e7\u05e9\u05d5\u05e8\u05d4 \u05dc-FMR1.",
          "isCorrect": false,
          "rationale": "\u05d0\u05dc\u05e6\u05d4\u05d9\u05d9\u05de\u05e8 \u05de\u05d5\u05e7\u05d3\u05dd \u05e7\u05e9\u05d5\u05e8 \u05dc\u05ea\u05e1\u05de\u05d5\u05e0\u05ea \u05d3\u05d0\u05d5\u05df (APP), \u05d1\u05e2\u05d5\u05d3 \u05e9-Fragile X \u05e7\u05e9\u05d5\u05e8 \u05dc\u05ea\u05e1\u05de\u05d5\u05e0\u05d5\u05ea \u05e8\u05e2\u05d3 \u05d5\u05d0\u05d8\u05e7\u05e1\u05d9\u05d4."
        },
        {
          "text": "\u05d6\u05d5\u05d4\u05d9 \u05ea\u05d5\u05e4\u05e2\u05ea \u05dc\u05d5\u05d5\u05d0\u05d9 \u05e9\u05dc \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Lithium \u05e9\u05d4\u05e1\u05d1\u05d0 \u05e0\u05d5\u05d8\u05dc.",
          "isCorrect": false,
          "rationale": "\u05d0\u05e3 \u05e9\u05dc\u05d9\u05ea\u05d9\u05d5\u05dd \u05d2\u05d5\u05e8\u05dd \u05dc\u05e8\u05e2\u05d3, \u05d4\u05d4\u05e7\u05e9\u05e8 \u05d4\u05de\u05e9\u05e4\u05d7\u05ea\u05d9 \u05dc-Fragile X \u05de\u05db\u05d5\u05d5\u05df \u05d1\u05d0\u05d5\u05e4\u05df \u05d7\u05d6\u05e7 \u05dc\u05ea\u05e1\u05de\u05d5\u05e0\u05ea \u05d4-FXTAS."
        },
        {
          "text": "\u05d4\u05e1\u05d1\u05d0 \u05e1\u05d5\u05d1\u05dc \u05de-PPM-X syndrome \u05d1\u05e9\u05dc \u05de\u05d5\u05d8\u05e6\u05d9\u05d4 \u05d1-MECP2.",
          "isCorrect": false,
          "rationale": "PPM-X syndrome \u05de\u05d5\u05e4\u05d9\u05e2\u05d4 \u05dc\u05e8\u05d5\u05d1 \u05e2\u05dd ID \u05d5\u05de\u05d0\u05e7\u05e8\u05d5-\u05d0\u05d5\u05e8\u05db\u05d9\u05d3\u05d9\u05d6\u05dd, \u05d5\u05dc\u05d0 \u05db\u05d4\u05e4\u05e8\u05e2\u05d4 \u05e0\u05d5\u05d9\u05e8\u05d5\u05d3\u05d2\u05e0\u05e8\u05d8\u05d9\u05d1\u05d9\u05ea \u05de\u05d0\u05d5\u05d7\u05e8\u05ea \u05e9\u05dc \u05d0\u05d8\u05e7\u05e1\u05d9\u05d4."
        }
      ],
      "hint": "\u05d4\u05ea\u05de\u05e7\u05d3 \u05d1\u05d4\u05e9\u05dc\u05db\u05d5\u05ea \u05e9\u05dc \u05de\u05e6\u05d1 \u05d4-Premutation \u05d0\u05e6\u05dc \u05e7\u05e8\u05d5\u05d1\u05d9 \u05de\u05e9\u05e4\u05d7\u05d4 \u05e9\u05dc \u05d7\u05d5\u05dc\u05d9 Fragile X.",
      "citations": "(Dulcan p.120)"
    },
    {
      "question": "\u05de\u05d8\u05d5\u05e4\u05dc \u05e2\u05dd ID \u05d5-ADHD \u05de\u05d0\u05d5\u05d1\u05d7\u05df \u05d2\u05dd \u05e2\u05dd \u05d4\u05e4\u05e8\u05e2\u05ea \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05e7\u05e9\u05d4. \u05d4\u05d5\u05d7\u05dc\u05d8 \u05dc\u05d4\u05ea\u05d7\u05d9\u05dc \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Guanfacine. \u05de\u05d4\u05d5 \u05d4\u05e0\u05d9\u05d8\u05d5\u05e8 \u05d4\u05e0\u05d3\u05e8\u05e9 \u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05dc\u05e4\u05d9 \u05d4-StahlKids?",
      "answerOptions": [
        {
          "text": "\u05de\u05e2\u05e7\u05d1 \u05d0\u05d7\u05e8 \u05d3\u05d5\u05e4\u05e7 \u05d5\u05dc\u05d7\u05e5 \u05d3\u05dd \u05d1\u05de\u05e6\u05d1\u05d9 \u05d9\u05e9\u05d9\u05d1\u05d4 \u05d5\u05e2\u05de\u05d9\u05d3\u05d4 \u05d1\u05e9\u05dc \u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05d1\u05e8\u05d3\u05d9\u05e7\u05e8\u05d3\u05d9\u05d4 \u05d5\u05dc\u05d7\u05e5 \u05d3\u05dd \u05e0\u05de\u05d5\u05da.",
          "isCorrect": true,
          "rationale": "Guanfacine \u05d4\u05d9\u05d0 $\\alpha_2$-adrenergic agonist \u05d4\u05de\u05d5\u05e8\u05d9\u05d3\u05d4 \u05d0\u05ea \u05d4\u05d8\u05d5\u05df \u05d4\u05e1\u05d9\u05de\u05e4\u05ea\u05d8\u05d9 \u05d5\u05e2\u05dc\u05d5\u05dc\u05d4 \u05dc\u05d2\u05e8\u05d5\u05dd \u05dc\u05d9\u05e8\u05d9\u05d3\u05d4 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05d1\u05d3\u05d5\u05e4\u05e7 \u05d5\u05dc\u05d7\u05e5 \u05d3\u05dd."
        },
        {
          "text": "\u05d1\u05d3\u05d9\u05e7\u05ea \u05e8\u05de\u05d5\u05ea Liver Function Tests \u05de\u05d3\u05d9 \u05d7\u05d5\u05d3\u05e9.",
          "isCorrect": false,
          "rationale": "Guanfacine \u05d0\u05d9\u05e0\u05d4 \u05d9\u05d3\u05d5\u05e2\u05d4 \u05db\u05d1\u05e2\u05dc\u05ea \u05e8\u05e2\u05d9\u05dc\u05d5\u05ea \u05db\u05d1\u05d3\u05d9\u05ea \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05d4\u05d3\u05d5\u05e8\u05e9\u05ea \u05e0\u05d9\u05d8\u05d5\u05e8 \u05d7\u05d5\u05d3\u05e9\u05d9."
        },
        {
          "text": "\u05e0\u05d9\u05d8\u05d5\u05e8 \u05e8\u05de\u05d5\u05ea Glucose \u05d5\u05dc\u05d9\u05e4\u05d9\u05d3\u05d9\u05dd \u05d1\u05e6\u05d5\u05dd.",
          "isCorrect": false,
          "rationale": "\u05e0\u05d9\u05d8\u05d5\u05e8 \u05de\u05d8\u05d1\u05d5\u05dc\u05d9 \u05e0\u05d3\u05e8\u05e9 \u05e2\u05d1\u05d5\u05e8 \u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05d0\u05e0\u05d8\u05d9-\u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9\u05d5\u05ea (Antipsychotics) \u05d5\u05dc\u05d0 \u05e2\u05d1\u05d5\u05e8 $\\alpha_2$ agonists."
        },
        {
          "text": "\u05d1\u05d3\u05d9\u05e7\u05ea \u05d0\u05d9\u05e1\u05d5\u05e3 \u05e9\u05ea\u05df \u05dc-24 \u05e9\u05e2\u05d5\u05ea \u05dc\u05e8\u05de\u05d5\u05ea Cortisol.",
          "isCorrect": false,
          "rationale": "\u05d0\u05d9\u05df \u05d0\u05d9\u05e0\u05d3\u05d9\u05e7\u05e6\u05d9\u05d4 \u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05dc\u05e0\u05d9\u05d8\u05d5\u05e8 \u05e7\u05d5\u05e8\u05d8\u05d9\u05d6\u05d5\u05dc \u05d1\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Guanfacine."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05e1\u05d9\u05de\u05e4\u05ea\u05d5\u05dc\u05d9\u05d8\u05d9 \u05e9\u05dc \u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 \u05d5\u05d4\u05e9\u05e4\u05e2\u05ea\u05d4 \u05e2\u05dc \u05d4\u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05d0\u05d5\u05d8\u05d5\u05e0\u05d5\u05de\u05d9\u05ea.",
      "citations": "(StahlKids p.139, p.248)"
    },
    {
      "question": "\u05de\u05d4\u05d5 \u05d4\u05d4\u05d1\u05d3\u05dc \u05d4\u05e2\u05d9\u05e7\u05e8\u05d9 \u05d1\u05d9\u05df \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9 \u05d4-DSM-5-TR \u05dc\u05d0\u05d1\u05d7\u05e0\u05ea ASD \u05d0\u05e6\u05dc \u05d9\u05dc\u05d3 \u05e2\u05dd ID \u05dc\u05e2\u05d5\u05de\u05ea \u05d9\u05dc\u05d3 \u05e2\u05dd \u05d0\u05d9\u05e0\u05d8\u05dc\u05d9\u05d2\u05e0\u05e6\u05d9\u05d4 \u05ea\u05e7\u05d9\u05e0\u05d4?",
      "answerOptions": [
        {
          "text": "\u05db\u05d3\u05d9 \u05dc\u05d0\u05d1\u05d7\u05df ASD \u05d1\u05e0\u05d5\u05db\u05d7\u05d5\u05ea ID, \u05d4\u05dc\u05d9\u05e7\u05d5\u05d9 \u05d1\u05ea\u05e7\u05e9\u05d5\u05e8\u05ea \u05d7\u05d1\u05e8\u05ea\u05d9\u05ea \u05d7\u05d9\u05d9\u05d1 \u05dc\u05d4\u05d9\u05d5\u05ea \u05de\u05ea\u05d7\u05ea \u05dc\u05de\u05e6\u05d5\u05e4\u05d4 \u05de\u05d4\u05e8\u05de\u05d4 \u05d4\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9\u05ea \u05d4\u05db\u05dc\u05dc\u05d9\u05ea.",
          "isCorrect": true,
          "rationale": "\u05dc\u05e4\u05d9 \u05d4-DSM, \u05db\u05d9\u05d5\u05d5\u05df \u05e9\u05e9\u05ea\u05d9 \u05d4\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05d7\u05d5\u05e4\u05e4\u05d5\u05ea, \u05d9\u05e9 \u05dc\u05d5\u05d5\u05d3\u05d0 \u05e9\u05d4\u05dc\u05d9\u05e7\u05d5\u05d9 \u05d4\u05d7\u05d1\u05e8\u05ea\u05d9 \u05d7\u05de\u05d5\u05e8 \u05d9\u05d5\u05ea\u05e8 \u05de\u05de\u05d4 \u05e9\u05d4\u05d9\u05d9\u05e0\u05d5 \u05de\u05e6\u05e4\u05d9\u05dd \u05e8\u05e7 \u05e2\u05dc \u05e1\u05de\u05da \u05d4\u05de\u05d5\u05d2\u05d1\u05dc\u05d5\u05ea \u05d4\u05e9\u05db\u05dc\u05d9\u05ea."
        },
        {
          "text": "\u05dc\u05d0 \u05e0\u05d9\u05ea\u05df \u05dc\u05d0\u05d1\u05d7\u05df ASD \u05d5-ID \u05d1\u05de\u05e7\u05d1\u05d9\u05dc (Comorbidity) \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR.",
          "isCorrect": false,
          "rationale": "\u05d4-DSM-5-TR \u05de\u05d0\u05e4\u05e9\u05e8 \u05d5\u05d0\u05e3 \u05de\u05e6\u05d9\u05d9\u05df \u05db\u05d9 \u05e9\u05ea\u05d9 \u05d4\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05de\u05d5\u05e4\u05d9\u05e2\u05d5\u05ea \u05dc\u05e2\u05d9\u05ea\u05d9\u05dd \u05e7\u05e8\u05d5\u05d1\u05d5\u05ea \u05d9\u05d7\u05d3 (Frequent co-occurrence)."
        },
        {
          "text": "\u05d0\u05d1\u05d7\u05e0\u05ea ASD \u05d1-ID \u05d3\u05d5\u05e8\u05e9\u05ea \u05e8\u05e7 \u05e7\u05d9\u05d5\u05dd \u05e9\u05dc \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05d9\u05d5\u05ea \u05e1\u05d8\u05e8\u05d9\u05d0\u05d5\u05d8\u05d9\u05e4\u05d9\u05d5\u05ea \u05dc\u05dc\u05d0 \u05e6\u05d5\u05e8\u05da \u05d1\u05dc\u05d9\u05e7\u05d5\u05d9 \u05d7\u05d1\u05e8\u05ea\u05d9.",
          "isCorrect": false,
          "rationale": "\u05dc\u05d9\u05e7\u05d5\u05d9 \u05d1\u05ea\u05e7\u05e9\u05d5\u05e8\u05ea \u05d7\u05d1\u05e8\u05ea\u05d9\u05ea (Criterion A) \u05d4\u05d5\u05d0 \u05d7\u05d5\u05d1\u05d4 \u05dc\u05db\u05dc \u05d0\u05d1\u05d7\u05e0\u05ea ASD, \u05dc\u05dc\u05d0 \u05e7\u05e9\u05e8 \u05dc-IQ."
        },
        {
          "text": "\u05d1\u05e0\u05d5\u05db\u05d7\u05d5\u05ea ID, \u05e8\u05de\u05ea \u05d4\u05d7\u05d5\u05de\u05e8\u05d4 \u05e9\u05dc \u05d4-ASD \u05e0\u05e7\u05d1\u05e2\u05ea \u05dc\u05e4\u05d9 \u05e6\u05d9\u05d5\u05df \u05d4-IQ \u05d1\u05dc\u05d1\u05d3.",
          "isCorrect": false,
          "rationale": "\u05e8\u05de\u05d5\u05ea \u05d4\u05d7\u05d5\u05de\u05e8\u05d4 \u05d1-ASD \u05e0\u05e7\u05d1\u05e2\u05d5\u05ea \u05dc\u05e4\u05d9 \u05de\u05d9\u05d3\u05ea \u05d4\u05ea\u05de\u05d9\u05db\u05d4 \u05d4\u05e0\u05d3\u05e8\u05e9\u05ea (Support levels) \u05d1\u05ea\u05d7\u05d5\u05de\u05d9 \u05d4\u05dc\u05d9\u05d1\u05d4 \u05e9\u05dc \u05d4\u05d0\u05d5\u05d8\u05d9\u05d6\u05dd."
        }
      ],
      "hint": "\u05e2\u05d9\u05d9\u05df \u05d1\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df E \u05e9\u05dc \u05d0\u05d1\u05d7\u05e0\u05ea ASD \u05d1-DSM-5-TR.",
      "citations": "(DSM p.57, Dulcan p.138)"
    }
  ]
