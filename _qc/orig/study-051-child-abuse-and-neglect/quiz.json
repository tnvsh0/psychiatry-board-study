        "\u05d4\u05d9\u05e4\u05d5\u05e7\u05de\u05e4\u05d5\u05e1 (Hippocampus)"
      ],
      "rationale": "\u05d4\u05d4\u05d9\u05e4\u05d5\u05e7\u05de\u05e4\u05d5\u05e1 \u05e8\u05d2\u05d9\u05e9 \u05d1\u05de\u05d9\u05d5\u05d7\u05d3 \u05dc\u05e8\u05de\u05d5\u05ea \u05e7\u05d5\u05e8\u05d8\u05d9\u05d6\u05d5\u05dc \u05d2\u05d1\u05d5\u05d4\u05d5\u05ea, \u05d5\u05d0\u05d8\u05e8\u05d5\u05e4\u05d9\u05d4 \u05e9\u05dc\u05d5 \u05de\u05e7\u05d5\u05e9\u05e8\u05ea \u05dc\u05dc\u05d9\u05e7\u05d5\u05d9\u05d9\u05dd \u05d1\u05d6\u05d9\u05db\u05e8\u05d5\u05df \u05d0\u05e4\u05d9\u05d6\u05d5\u05d3\u05d9 \u05d1\u05e0\u05e4\u05d2\u05e2\u05d9 \u05d4\u05ea\u05e2\u05dc\u05dc\u05d5\u05ea (StahlNeuro p. 269-271, Dulcan p. 524).",
      "hint": "\u05d6\u05d4\u05d5 \u05de\u05d1\u05e0\u05d4 \u05d1\u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05dc\u05d9\u05de\u05d1\u05d9\u05ea \u05d4\u05d0\u05d7\u05e8\u05d0\u05d9 \u05e2\u05dc \u05e7\u05d5\u05e0\u05e1\u05d5\u05dc\u05d9\u05d3\u05e6\u05d9\u05d4 \u05e9\u05dc \u05d6\u05d9\u05db\u05e8\u05d5\u05df."
    },
    {
      "type": "multiple_choice",
      "question": "\u05d9\u05dc\u05d3\u05d4 \u05d1\u05ea 7 \u05de\u05d5\u05d1\u05d0\u05ea \u05dc\u05d4\u05e2\u05e8\u05db\u05d4 \u05d1\u05e9\u05dc \u05d9\u05e8\u05d9\u05d3\u05d4 \u05d1\u05dc\u05d9\u05de\u05d5\u05d3\u05d9\u05dd \u05d5\u05d4\u05ea\u05e4\u05e8\u05e6\u05d5\u05d9\u05d5\u05ea \u05d6\u05e2\u05dd. \u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05e8\u05d0\u05d9\u05d5\u05df \u05d4\u05d9\u05d0 \u05de\u05e1\u05e4\u05e8\u05ea \u05e9\u05d4\u05d9\u05d0 '\u05dc\u05d0 \u05d0\u05d5\u05d4\u05d1\u05ea \u05db\u05e9\u05d0\u05d1\u05d0 \u05de\u05e7\u05dc\u05d7 \u05d0\u05d5\u05ea\u05d4 \u05db\u05d9 \u05d4\u05d5\u05d0 \u05e0\u05d5\u05d2\u05e2 \u05dc\u05d4 \u05d1\u05de\u05e7\u05d5\u05de\u05d5\u05ea \u05e4\u05e8\u05d8\u05d9\u05d9\u05dd'. \u05de\u05d4\u05d9 \u05d4\u05d3\u05e8\u05da \u05d4\u05e0\u05db\u05d5\u05e0\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05d4\u05de\u05e9\u05d9\u05da \u05d0\u05ea \u05d4\u05e8\u05d0\u05d9\u05d5\u05df \u05e2\u05dd \u05d4\u05d9\u05dc\u05d3\u05d4 \u05dc\u05e4\u05d9 \u05e2\u05e7\u05e8\u05d5\u05e0\u05d5\u05ea \u05d4\u05e8\u05d0\u05d9\u05d5\u05df \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9?",
      "answerOptions": [
        {
          "text": "\u05dc\u05d4\u05e9\u05ea\u05de\u05e9 \u05d1\u05e9\u05d0\u05dc\u05d5\u05ea \u05e4\u05ea\u05d5\u05d7\u05d5\u05ea \u05db\u05de\u05d5 '\u05e1\u05e4\u05e8\u05d9 \u05dc\u05d9 \u05e2\u05d5\u05d3 \u05e2\u05dc \u05de\u05d4 \u05e9\u05e7\u05d5\u05e8\u05d4 \u05d1\u05d6\u05de\u05df \u05d4\u05de\u05e7\u05dc\u05d7\u05ea'.",
          "isCorrect": true,
          "rationale": "\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05e9\u05d0\u05dc\u05d5\u05ea \u05e4\u05ea\u05d5\u05d7\u05d5\u05ea (Open-ended) \u05de\u05d5\u05e0\u05e2 \u05e1\u05d5\u05d2\u05e1\u05d8\u05d9\u05d1\u05d9\u05dc\u05d9\u05d5\u05ea \u05d5\u05e9\u05d5\u05de\u05e8 \u05e2\u05dc \u05d0\u05de\u05d9\u05e0\u05d5\u05ea \u05d4\u05d3\u05d9\u05d5\u05d5\u05d7 \u05e9\u05dc \u05d4\u05d9\u05dc\u05d3 (Dulcan p. 49-50, p. 647)."
