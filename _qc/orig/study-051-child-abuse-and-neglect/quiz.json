    {
      "type": "multiple_select",
      "question": "\u05d0\u05d9\u05dc\u05d5 \u05de\u05d4\u05de\u05de\u05e6\u05d0\u05d9\u05dd \u05d4\u05d1\u05d0\u05d9\u05dd \u05d1\u05d1\u05d3\u05d9\u05e7\u05d4 \u05d2\u05d5\u05e4\u05e0\u05d9\u05ea \u05d0\u05d5 \u05d4\u05d3\u05de\u05d9\u05d9\u05ea\u05d9\u05ea \u05e0\u05d7\u05e9\u05d1\u05d9\u05dd \u05dc\u05e1\u05d9\u05de\u05e0\u05d9\u05dd \u05d1\u05e2\u05dc\u05d9 \u05e1\u05d2\u05d5\u05dc\u05d9\u05d5\u05ea (Specificity) \u05d2\u05d1\u05d5\u05d4\u05d4 \u05dc\u05d4\u05ea\u05e2\u05dc\u05dc\u05d5\u05ea \u05e4\u05d9\u05d6\u05d9\u05ea \u05d1\u05ea\u05d9\u05e0\u05d5\u05e7\u05d5\u05ea (Abusive Head Trauma)?",
      "answerOptions": [
        {
          "text": "\u05d3\u05d9\u05de\u05d5\u05de\u05d9\u05dd \u05d1\u05e8\u05e9\u05ea\u05d9\u05ea (Retinal hemorrhages) \u05de\u05e8\u05d5\u05d1\u05d9\u05dd \u05d5\u05d1\u05e9\u05db\u05d1\u05d5\u05ea \u05e9\u05d5\u05e0\u05d5\u05ea.",
          "isCorrect": true,
          "rationale": "\u05d3\u05d9\u05de\u05d5\u05de\u05d9\u05dd \u05d1\u05e8\u05e9\u05ea\u05d9\u05ea \u05d4\u05dd \u05d7\u05dc\u05e7 \u05de\u05d4\u05d8\u05e8\u05d9\u05d0\u05d3\u05d4 \u05d4\u05e7\u05dc\u05d0\u05e1\u05d9\u05ea \u05e9\u05dc Whiplash Shaken Baby Syndrome \u05d5\u05e0\u05d3\u05d9\u05e8\u05d9\u05dd \u05de\u05d0\u05d5\u05d3 \u05d1\u05d7\u05d1\u05dc\u05d5\u05ea \u05de\u05e7\u05e8\u05d9\u05d5\u05ea (Dulcan p. 522)."
        },
        {
          "text": "\u05d3\u05d9\u05de\u05d5\u05dd \u05e1\u05d5\u05d1\u05d3\u05d5\u05e8\u05dc\u05d9 (Subdural hemorrhage) \u05dc\u05dc\u05d0 \u05e2\u05d3\u05d5\u05ea \u05dc\u05d8\u05e8\u05d0\u05d5\u05de\u05d4 \u05d7\u05d9\u05e6\u05d5\u05e0\u05d9\u05ea \u05dc\u05d2\u05d5\u05dc\u05d2\u05d5\u05dc\u05ea.",
          "isCorrect": true,
          "rationale": "\u05d3\u05d9\u05de\u05d5\u05dd \u05e1\u05d5\u05d1\u05d3\u05d5\u05e8\u05dc\u05d9 \u05d4\u05e0\u05d5\u05e6\u05e8 \u05de\u05db\u05d5\u05d7\u05d5\u05ea \u05d2\u05d6\u05d9\u05e8\u05d4 (Shearing) \u05d1\u05d6\u05de\u05df \u05e9\u05e7\u05e9\u05d5\u05e7 \u05d4\u05d5\u05d0 \u05e1\u05d9\u05de\u05df \u05d4\u05d9\u05db\u05e8 \u05e9\u05dc AHT (Dulcan p. 522)."
        },
        {
          "text": "\u05e9\u05d1\u05e8\u05d9 \u05e6\u05dc\u05e2\u05d5\u05ea \u05d0\u05d7\u05d5\u05e8\u05d9\u05d9\u05dd (Posterior rib fractures).",
          "isCorrect": true,
          "rationale": "\u05e9\u05d1\u05e8\u05d9\u05dd \u05d0\u05dc\u05d5 \u05e0\u05d5\u05e6\u05e8\u05d9\u05dd \u05d1\u05d3\u05e8\u05da \u05db\u05dc\u05dc \u05db\u05ea\u05d5\u05e6\u05d0\u05d4 \u05de\u05dc\u05d7\u05d9\u05e6\u05d4 \u05e2\u05d5\u05e6\u05de\u05ea\u05d9\u05ea \u05e9\u05dc \u05d1\u05d9\u05ea \u05d4\u05d7\u05d6\u05d4 \u05d1\u05d6\u05de\u05df \u05e9\u05e7\u05e9\u05d5\u05e7 \u05d0\u05d5 \u05d7\u05d1\u05dc\u05d4 \u05d9\u05e9\u05d9\u05e8\u05d4, \u05d5\u05d4\u05dd \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05d9\u05dd \u05de\u05d0\u05d5\u05d3 \u05dc\u05d4\u05ea\u05e2\u05dc\u05dc\u05d5\u05ea (Dulcan p. 521)."
        },
        {
          "text": "\u05e9\u05d1\u05e8 \u05e7\u05d5\u05d5\u05d9 \u05e4\u05e9\u05d5\u05d8 \u05d1\u05e2\u05e6\u05dd \u05d4\u05e4\u05e8\u05d9\u05d0\u05d8\u05dc\u05d9\u05ea (Simple linear skull fracture).",
          "isCorrect": false,
          "rationale": "\u05e9\u05d1\u05e8\u05d9\u05dd \u05e7\u05d5\u05d5\u05d9\u05d9\u05dd \u05e4\u05e9\u05d5\u05d8\u05d9\u05dd \u05d9\u05db\u05d5\u05dc\u05d9\u05dd \u05dc\u05d4\u05ea\u05e8\u05d7\u05e9 \u05d2\u05dd \u05d1\u05e0\u05e4\u05d9\u05dc\u05d5\u05ea \u05de\u05e7\u05e8\u05d9\u05d5\u05ea \u05de\u05d2\u05d5\u05d1\u05d4 \u05e0\u05de\u05d5\u05da \u05d5\u05d0\u05d9\u05e0\u05dd \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05d9\u05dd \u05dc\u05d4\u05ea\u05e2\u05dc\u05dc\u05d5\u05ea \u05db\u05de\u05d5 \u05e9\u05d1\u05e8\u05d9\u05dd \u05de\u05d5\u05e8\u05db\u05d1\u05d9\u05dd \u05d0\u05d5 \u05e9\u05d1\u05e8\u05d9 \u05e6\u05dc\u05e2\u05d5\u05ea (Dulcan p. 522)."
        }
      ],
      "hint": "\u05d7\u05e4\u05e9 \u05de\u05de\u05e6\u05d0\u05d9\u05dd \u05d4\u05de\u05e8\u05db\u05d9\u05d1\u05d9\u05dd \u05d0\u05ea \u05d4\u05d8\u05e8\u05d9\u05d0\u05d3\u05d4 \u05e9\u05ea\u05d9\u05d0\u05e8 John Caffey.",
      "hasAllOfTheAbove": false,
      "hasNoneOfTheAbove": false
    },
    {
      "type": "fill_in_the_blank",
      "question": "\u05de\u05d1\u05d7\u05d9\u05e0\u05d4 \u05e0\u05d5\u05d9\u05e8\u05d5\u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea, \u05d7\u05e9\u05d9\u05e4\u05d4 \u05de\u05d5\u05e7\u05d3\u05de\u05ea \u05d5\u05de\u05ea\u05de\u05e9\u05db\u05ea \u05dc\u05d4\u05ea\u05e2\u05dc\u05dc\u05d5\u05ea \u05d2\u05d5\u05e8\u05de\u05ea \u05dc\u05d4\u05d9\u05e4\u05e8\u05d0\u05e7\u05d8\u05d9\u05d1\u05d9\u05d5\u05ea \u05e9\u05dc \u05e6\u05d9\u05e8 \u05d4-HPA, \u05d4\u05de\u05d5\u05d1\u05d9\u05dc\u05d4 \u05dc\u05d4\u05e4\u05e8\u05e9\u05ea \u05d9\u05ea\u05e8 \u05e9\u05dc \u05e7\u05d5\u05e8\u05d8\u05d9\u05d6\u05d5\u05dc. \u05e8\u05de\u05d5\u05ea \u05d2\u05d1\u05d5\u05d4\u05d5\u05ea \u05d0\u05dc\u05d5 \u05e2\u05dc\u05d5\u05dc\u05d5\u05ea \u05dc\u05d2\u05e8\u05d5\u05dd \u05dc\u05e8\u05e2\u05d9\u05dc\u05d5\u05ea \u05e0\u05d5\u05d9\u05e8\u05d5\u05e0\u05dc\u05d9\u05ea \u05d5\u05dc\u05d0\u05d8\u05e8\u05d5\u05e4\u05d9\u05d4 \u05e9\u05dc \u05d4-___, \u05de\u05d4 \u05e9\u05de\u05e1\u05d1\u05d9\u05e8 \u05e4\u05d2\u05d9\u05e2\u05d5\u05ea \u05d1\u05d6\u05d9\u05db\u05e8\u05d5\u05df \u05d0\u05e6\u05dc \u05e0\u05e4\u05d2\u05e2\u05d9 \u05d8\u05e8\u05d0\u05d5\u05de\u05d4.",
      "bestAnswer": "Hippocampus",
      "acceptableAnswers": [
