{
  "title": "Abuse Quiz",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\u05e4\u05e2\u05d5\u05d8 \u05d1\u05df \u05e9\u05e0\u05ea\u05d9\u05d9\u05dd \u05de\u05d5\u05d1\u05d0 \u05dc\u05d7\u05d3\u05e8 \u05de\u05d9\u05d5\u05df \u05e2\u05dd \u05e9\u05d1\u05e8 \u05e1\u05e4\u05d9\u05e8\u05dc\u05d9 (Spiral fracture) \u05d1\u05e4\u05de\u05d5\u05e8. \u05d4\u05d0\u05dd \u05d8\u05d5\u05e2\u05e0\u05ea \u05e9\u05d4\u05d9\u05dc\u05d3 '\u05e0\u05e4\u05dc \u05de\u05d4\u05e1\u05e4\u05d4 \u05d1\u05d6\u05de\u05df \u05e9\u05e9\u05d9\u05d7\u05e7'. \u05d1\u05d1\u05d3\u05d9\u05e7\u05d4 \u05d2\u05d5\u05e4\u05e0\u05d9\u05ea \u05e0\u05e6\u05e4\u05d9\u05dd \u05e9\u05d8\u05e4\u05d9 \u05d3\u05dd (Ecchymoses) \u05de\u05e8\u05d5\u05d1\u05d9\u05dd \u05d1\u05d0\u05d6\u05d5\u05e8\u05d9 \u05d4\u05d9\u05e8\u05db\u05d9\u05d9\u05dd \u05d4\u05e4\u05e0\u05d9\u05de\u05d9\u05d5\u05ea \u05d5\u05d4\u05e2\u05db\u05d5\u05d6. \u05de\u05d4\u05d5 \u05d4\u05e6\u05e2\u05d3 \u05d4\u05d1\u05d0 \u05d4\u05e0\u05db\u05d5\u05df \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d1\u05e0\u05d9\u05d4\u05d5\u05dc \u05d4\u05de\u05e7\u05e8\u05d4 \u05de\u05d1\u05d7\u05d9\u05e0\u05d4 \u05d0\u05d1\u05d7\u05e0\u05ea\u05d9\u05ea?",
      "answerOptions": [
        {
          "text": "\u05d1\u05d9\u05e6\u05d5\u05e2 Skeletal survey \u05d5\u05e6\u05d9\u05dc\u05d5\u05dd \u05d7\u05d6\u05d4 \u05dc\u05d7\u05d9\u05e4\u05d5\u05e9 \u05e9\u05d1\u05e8\u05d9 \u05e6\u05dc\u05e2\u05d5\u05ea \u05d0\u05d7\u05d5\u05e8\u05d9\u05d9\u05dd.",
          "isCorrect": true,
          "rationale": "\u05d1\u05e4\u05e2\u05d5\u05d8\u05d5\u05ea \u05de\u05ea\u05d7\u05ea \u05dc\u05d2\u05d9\u05dc \u05e9\u05e0\u05ea\u05d9\u05d9\u05dd \u05e2\u05dd \u05d7\u05d1\u05dc\u05d5\u05ea \u05d7\u05e9\u05d5\u05d3\u05d5\u05ea (\u05db\u05de\u05d5 \u05e9\u05d1\u05e8 \u05d1\u05e4\u05de\u05d5\u05e8 \u05d1\u05d9\u05dc\u05d3 \u05e9\u05d0\u05d9\u05e0\u05d5 \u05e0\u05d9\u05d9\u05d3 \u05e2\u05e6\u05de\u05d0\u05d9\u05ea \u05d5\u05e9\u05d8\u05e4\u05d9 \u05d3\u05dd \u05d1\u05d0\u05d6\u05d5\u05e8\u05d9\u05dd \u05de\u05d5\u05d2\u05e0\u05d9\u05dd), \u05d9\u05e9 \u05dc\u05d1\u05e6\u05e2 \u05e1\u05e7\u05e8 \u05e9\u05dc\u05d3 \u05de\u05dc\u05d0 \u05dc\u05ea\u05d9\u05e2\u05d5\u05d3 \u05e9\u05d1\u05e8\u05d9\u05dd \u05d1\u05e9\u05dc\u05d1\u05d9 \u05d0\u05d9\u05d7\u05d5\u05d9 \u05e9\u05d5\u05e0\u05d9\u05dd (Dulcan p. 521-522)."
        },
        {
          "text": "\u05d4\u05e4\u05e0\u05d9\u05d4 \u05de\u05d9\u05d9\u05d3\u05d9\u05ea \u05dc\u05d1\u05d3\u05d9\u05e7\u05d4 \u05d2\u05e0\u05d8\u05d9\u05ea \u05dc\u05e9\u05dc\u05d9\u05dc\u05ea Osteogenesis Imperfecta.",
          "isCorrect": false,
          "rationale": "\u05d0\u05de\u05e0\u05dd \u05d6\u05d5 \u05d0\u05d1\u05d7\u05e0\u05d4 \u05de\u05d1\u05d3\u05dc\u05ea \u05d7\u05e9\u05d5\u05d1\u05d4, \u05d0\u05da \u05d4\u05de\u05de\u05e6\u05d0\u05d9\u05dd \u05d4\u05d2\u05d5\u05e4\u05e0\u05d9\u05d9\u05dd (\u05e9\u05d8\u05e4\u05d9 \u05d3\u05dd \u05d1\u05d9\u05e8\u05db\u05d9\u05d9\u05dd \u05e4\u05e0\u05d9\u05de\u05d9\u05d5\u05ea) \u05d5\u05d4\u05de\u05db\u05e0\u05d9\u05e7\u05d4 \u05d4\u05dc\u05d0-\u05ea\u05d5\u05d0\u05de\u05ea \u05de\u05d7\u05e9\u05d9\u05d3\u05d9\u05dd \u05e7\u05d5\u05d3\u05dd \u05db\u05dc \u05dc\u05d4\u05ea\u05e2\u05dc\u05dc\u05d5\u05ea \u05e4\u05d9\u05d6\u05d9\u05ea, \u05d5\u05d9\u05e9 \u05dc\u05d4\u05e9\u05dc\u05d9\u05dd \u05d1\u05d9\u05e8\u05d5\u05e8 \u05e4\u05d5\u05e8\u05e0\u05d6\u05d9 \u05dc\u05e4\u05e0\u05d9 \u05d1\u05d9\u05e8\u05d5\u05e8 \u05d2\u05e0\u05d8\u05d9 \u05e0\u05d3\u05d9\u05e8 (Dulcan p. 520)."
        },
        {
          "text": "\u05de\u05ea\u05df \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Lorazepam \u05dc\u05d4\u05e8\u05d2\u05e2\u05ea \u05d4\u05d9\u05dc\u05d3 \u05d5\u05d1\u05d9\u05e6\u05d5\u05e2 MRI \u05e8\u05d0\u05e9 \u05de\u05d9\u05d9\u05d3\u05d9.",
          "isCorrect": false,
          "rationale": "\u05d0\u05d9\u05df \u05d0\u05d9\u05e0\u05d3\u05d9\u05e7\u05e6\u05d9\u05d4 \u05dc-MRI \u05e8\u05d0\u05e9 \u05dc\u05dc\u05d0 \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e0\u05d5\u05d9\u05e8\u05d5\u05dc\u05d5\u05d2\u05d9\u05d9\u05dd \u05d0\u05d5 \u05d7\u05e9\u05d3 \u05dc-Abusive Head Trauma; \u05d1\u05e0\u05d5\u05e1\u05e3, Lorazepam \u05d0\u05d9\u05e0\u05d5 \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05de\u05d5\u05e2\u05d3\u05e3 \u05dc\u05d1\u05d9\u05e8\u05d5\u05e8 \u05d7\u05d1\u05dc\u05d5\u05ea \u05e9\u05dc\u05d3 (Dulcan p. 522)."
        },
        {
          "text": "\u05d1\u05d9\u05e8\u05d5\u05e8 \u05d4\u05de\u05d8\u05d5\u05dc\u05d5\u05d2\u05d9 \u05de\u05e7\u05d9\u05e3 \u05dc\u05e9\u05dc\u05d9\u05dc\u05ea von Willebrand disease \u05e2\u05e7\u05d1 \u05e9\u05d8\u05e4\u05d9 \u05d4\u05d3\u05dd.",
          "isCorrect": false,
          "rationale": "\u05d3\u05d9\u05d0\u05ea\u05d6\u05ea \u05d3\u05d9\u05de\u05d5\u05dd \u05d4\u05d9\u05d0 \u05d0\u05d1\u05d7\u05e0\u05d4 \u05de\u05d1\u05d3\u05dc\u05ea, \u05d0\u05da \u05e9\u05d1\u05e8 \u05e1\u05e4\u05d9\u05e8\u05dc\u05d9 \u05d1\u05e4\u05de\u05d5\u05e8 \u05d0\u05d9\u05e0\u05d5 \u05ea\u05d5\u05e6\u05d0\u05d4 \u05e9\u05dc \u05d4\u05e4\u05e8\u05e2\u05ea \u05e7\u05e8\u05d9\u05e9\u05d4 \u05d0\u05dc\u05d0 \u05e9\u05dc \u05db\u05d5\u05d7 \u05e1\u05d9\u05d1\u05d5\u05d1\u05d9 \u05d7\u05d9\u05e6\u05d5\u05e0\u05d9 (Dulcan p. 521)."
        }
      ],
      "hint": "\u05d4\u05ea\u05de\u05e7\u05d3 \u05d1\u05e1\u05d8\u05e0\u05d3\u05e8\u05d8 \u05d4\u05d6\u05d4\u05d1 \u05dc\u05ea\u05d9\u05e2\u05d5\u05d3 \u05e4\u05d2\u05d9\u05e2\u05d5\u05ea \u05e9\u05dc\u05d3 \u05e8\u05d1-\u05de\u05e2\u05e8\u05db\u05ea\u05d9\u05d5\u05ea \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05e6\u05e2\u05d9\u05e8\u05d9\u05dd.",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05d0\u05dd \u05de\u05d1\u05d9\u05d0\u05d4 \u05d0\u05ea \u05d1\u05ea\u05d4 \u05d1\u05ea \u05d4-4 \u05dc\u05d1\u05d3\u05d9\u05e7\u05d5\u05ea \u05d7\u05d5\u05d6\u05e8\u05d5\u05ea \u05d1\u05e9\u05dc \u05d4\u05de\u05d8\u05d5\u05e8\u05d9\u05d4 (\u05d3\u05dd \u05d1\u05e9\u05ea\u05df). \u05d1\u05d3\u05d9\u05e7\u05d5\u05ea \u05d4\u05de\u05e2\u05d1\u05d3\u05d4 \u05d1\u05d1\u05d9\u05ea \u05d4\u05d7\u05d5\u05dc\u05d9\u05dd \u05ea\u05e7\u05d9\u05e0\u05d5\u05ea, \u05d0\u05da \u05d4\u05d0\u05dd \u05de\u05e6\u05d9\u05d2\u05d4 \u05d3\u05d2\u05d9\u05de\u05d5\u05ea \u05e9\u05ea\u05df \u05d3\u05de\u05d9\u05d5\u05ea \u05e9\u05d0\u05e1\u05e4\u05d4 \u05d1\u05d1\u05d9\u05ea. \u05dc\u05d0\u05d7\u05e8 \u05de\u05e2\u05e7\u05d1 \u05d1\u05d1\u05d9\u05ea \u05d4\u05d7\u05d5\u05dc\u05d9\u05dd, \u05e0\u05ea\u05e4\u05e1\u05d4 \u05d4\u05d0\u05dd \u05db\u05e9\u05d4\u05d9\u05d0 \u05de\u05d6\u05e8\u05d9\u05e7\u05d4 \u05d3\u05dd \u05de\u05de\u05d6\u05e8\u05e7 \u05dc\u05ea\u05d5\u05da \u05db\u05d5\u05e1\u05d9\u05ea \u05d4\u05e9\u05ea\u05df \u05e9\u05dc \u05d4\u05d9\u05dc\u05d3\u05d4. \u05de\u05d4\u05d9 \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05e0\u05db\u05d5\u05e0\u05d4 \u05e2\u05d1\u05d5\u05e8 \u05d4\u05d0\u05dd \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR?",
      "answerOptions": [
        {
          "text": "Factitious Disorder Imposed on Another (F68.A).",
          "isCorrect": true,
          "rationale": "\u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05e0\u05d9\u05ea\u05e0\u05ea \u05dc\u05de\u05d1\u05e6\u05e2 \u05d4\u05e2\u05d1\u05d9\u05e8\u05d4 (\u05d4\u05d0\u05dd) \u05d4\u05de\u05d6\u05d9\u05d9\u05e3 \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d1\u05d0\u05d3\u05dd \u05d0\u05d7\u05e8, \u05d2\u05dd \u05dc\u05dc\u05d0 \u05e8\u05d5\u05d5\u05d7 \u05d7\u05d9\u05e6\u05d5\u05e0\u05d9 \u05d2\u05dc\u05d5\u05d9; \u05d4\u05e7\u05d5\u05e8\u05d1\u05df \u05de\u05e7\u05d1\u05dc \u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc \u05d4\u05ea\u05e2\u05dc\u05dc\u05d5\u05ea (DSM p. 367-368)."
        },
        {
          "text": "Somatic Symptom Disorder.",
          "isCorrect": false,
          "rationale": "\u05d4\u05e4\u05e8\u05e2\u05d4 \u05d6\u05d5 \u05de\u05ea\u05d0\u05e4\u05d9\u05d9\u05e0\u05ea \u05d1\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d2\u05d5\u05e4\u05e0\u05d9\u05d9\u05dd \u05d0\u05de\u05d9\u05ea\u05d9\u05d9\u05dd \u05d4\u05d2\u05d5\u05e8\u05de\u05d9\u05dd \u05dc\u05de\u05e6\u05d5\u05e7\u05d4 \u05d5\u05e2\u05d9\u05e1\u05d5\u05e7 \u05d9\u05ea\u05e8, \u05d5\u05dc\u05d0 \u05d1\u05d6\u05d9\u05d5\u05e3 \u05d0\u05e7\u05d8\u05d9\u05d1\u05d9 \u05e9\u05dc \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d1\u05d6\u05d5\u05dc\u05ea (DSM p. 351)."
        },
        {
          "text": "Malingering.",
          "isCorrect": false,
          "rationale": "Malingering \u05d0\u05d9\u05e0\u05d5 \u05e0\u05d7\u05e9\u05d1 \u05dc\u05d4\u05e4\u05e8\u05e2\u05d4 \u05e0\u05e4\u05e9\u05d9\u05ea \u05d1-DSM \u05d0\u05dc\u05d0 \u05dc\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05e9\u05de\u05d8\u05e8\u05ea\u05d4 \u05d4\u05e9\u05d2\u05ea \u05e8\u05d5\u05d5\u05d7 \u05d7\u05d9\u05e6\u05d5\u05e0\u05d9 \u05d1\u05e8\u05d5\u05e8 (\u05db\u05de\u05d5 \u05db\u05e1\u05e3 \u05d0\u05d5 \u05d4\u05d9\u05de\u05e0\u05e2\u05d5\u05ea \u05de\u05e6\u05d1\u05d0), \u05de\u05d4 \u05e9\u05dc\u05d0 \u05ea\u05d5\u05d0\u05e8 \u05d1\u05de\u05e7\u05e8\u05d4 \u05d6\u05d4 (DSM p. 367)."
        },
        {
          "text": "Child Physical Abuse, Confirmed (T74.12XA).",
          "isCorrect": false,
          "rationale": "\u05d6\u05d4\u05d5 \u05d4\u05e7\u05d5\u05d3 \u05d4\u05d0\u05d1\u05d7\u05e0\u05ea\u05d9 \u05e9\u05d9\u05d9\u05e0\u05ea\u05df \u05dc\u05d9\u05dc\u05d3\u05d4 (\u05d4\u05e7\u05d5\u05e8\u05d1\u05df), \u05d0\u05da \u05d4\u05e9\u05d0\u05dc\u05d4 \u05d4\u05ea\u05d9\u05d9\u05d7\u05e1\u05d4 \u05dc\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9\u05ea \u05e9\u05dc \u05d4\u05d0\u05dd (DSM p. 368)."
        }
      ],
      "hint": "\u05d6\u05db\u05d5\u05e8 \u05de\u05d9 \u05de\u05e7\u05d1\u05dc \u05d0\u05ea \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9\u05ea \u05db\u05d0\u05e9\u05e8 \u05d9\u05e9 \u05d6\u05d9\u05d5\u05e3 \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d1\u05d6\u05d5\u05dc\u05ea.",
      "imageUrls": []
    },
    {
      "type": "short_answer",
      "question": "\u05d1\u05de\u05d4\u05dc\u05da \u05e8\u05d0\u05d9\u05d5\u05df \u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9 \u05e4\u05e8\u05d8\u05d9, \u05d0\u05d1 \u05dc\u05d9\u05dc\u05d3 \u05d1\u05df 6 \u05de\u05d5\u05d3\u05d4 \u05d1\u05e4\u05e0\u05d9\u05da: '\u05dc\u05e4\u05e0\u05d9 \u05d9\u05d5\u05de\u05d9\u05d9\u05dd \u05d0\u05d9\u05d1\u05d3\u05ea\u05d9 \u05e9\u05dc\u05d9\u05d8\u05d4 \u05d5\u05d4\u05db\u05d9\u05ea\u05d9 \u05d0\u05ea \u05d4\u05d1\u05df \u05e9\u05dc\u05d9 \u05d7\u05d6\u05e7 \u05d1\u05d8\u05d5\u05e1\u05d9\u05e7, \u05e0\u05e9\u05d0\u05e8 \u05dc\u05d5 \u05e9\u05dd \u05e1\u05d9\u05de\u05df \u05db\u05d7\u05d5\u05dc \u05d2\u05d3\u05d5\u05dc'. \u05d4\u05d0\u05d1 \u05de\u05d1\u05e7\u05e9 \u05e9\u05dc\u05d0 \u05ea\u05e1\u05e4\u05e8 \u05dc\u05d0\u05e3 \u05d0\u05d7\u05d3 \u05db\u05d9 \u05d4\u05d5\u05d0 \u05de\u05e4\u05d7\u05d3 \u05e9\u05d9\u05d9\u05e7\u05d7\u05d5 \u05dc\u05d5 \u05d0\u05ea \u05d4\u05d9\u05dc\u05d3. \u05db\u05d9\u05e6\u05d3 \u05e2\u05dc\u05d9\u05da \u05dc\u05e4\u05e2\u05d5\u05dc \u05de\u05d1\u05d7\u05d9\u05e0\u05d4 \u05d7\u05d5\u05e7\u05d9\u05ea \u05d1\u05d9\u05e9\u05e8\u05d0\u05dc?",
      "grading": {
        "modelAnswer": "\u05e2\u05dc \u05e4\u05d9 \u05d7\u05d5\u05e7 \u05d4\u05e2\u05d5\u05e0\u05e9\u05d9\u05df \u05e1\u05e2\u05d9\u05e3 368\u05d3, \u05e7\u05d9\u05d9\u05de\u05ea \u05d7\u05d5\u05d1\u05ea \u05d3\u05d9\u05d5\u05d5\u05d7 \u05de\u05d5\u05d7\u05dc\u05d8\u05ea \u05e2\u05dc \u05db\u05dc \u05d7\u05e9\u05d3 \u05dc\u05d4\u05ea\u05e2\u05dc\u05dc\u05d5\u05ea \u05d1\u05e7\u05d8\u05d9\u05df \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d4\u05d0\u05d7\u05e8\u05d0\u05d9 \u05e2\u05dc\u05d9\u05d5. \u05d7\u05d5\u05d1\u05d4 \u05d6\u05d5 \u05d2\u05d5\u05d1\u05e8\u05ea \u05e2\u05dc \u05d7\u05d5\u05d1\u05ea \u05d4\u05e1\u05d5\u05d3\u05d9\u05d5\u05ea \u05d4\u05e8\u05e4\u05d5\u05d0\u05d9\u05ea, \u05d5\u05d9\u05e9 \u05dc\u05d3\u05d5\u05d5\u05d7 \u05de\u05d9\u05d9\u05d3\u05d9\u05ea \u05dc\u05de\u05e9\u05d8\u05e8\u05d4 \u05d0\u05d5 \u05dc\u05e2\u05d5\u05d1\u05d3 \u05e1\u05d5\u05e6\u05d9\u05d0\u05dc\u05d9 \u05dc\u05e4\u05d9 \u05d7\u05d5\u05e7 \u05d4\u05e0\u05d5\u05e2\u05e8 (\u05e4\u05e7\u05d9\u05d3 \u05e1\u05e2\u05d3) \u05dc\u05dc\u05d0 \u05e6\u05d5\u05e8\u05da \u05d1\u05d4\u05e1\u05db\u05de\u05ea \u05d4\u05d0\u05d1 (Syllabus p. 52, Dulcan p. 646-647).",
        "rationale": "\u05d7\u05d5\u05d1\u05ea \u05d4\u05d3\u05d9\u05d5\u05d5\u05d7 \u05d1\u05d9\u05e9\u05e8\u05d0\u05dc \u05d4\u05d9\u05d0 \u05e1\u05d8\u05d8\u05d5\u05d8\u05d5\u05e8\u05d9\u05ea \u05d5\u05d2\u05d5\u05d1\u05e8\u05ea \u05e2\u05dc \u05d7\u05d9\u05e1\u05d9\u05d5\u05df \u05de\u05d8\u05e4\u05dc-\u05de\u05d8\u05d5\u05e4\u05dc \u05d1\u05de\u05e7\u05e8\u05d9\u05dd \u05e9\u05dc \u05e4\u05d2\u05d9\u05e2\u05d4 \u05d1\u05e7\u05d8\u05d9\u05e0\u05d9\u05dd \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d4\u05d5\u05e8\u05d9\u05d4\u05dd.",
        "requiredAttributes": [
          "\u05e6\u05d9\u05d5\u05df \u05d7\u05d5\u05e7 \u05d4\u05e2\u05d5\u05e0\u05e9\u05d9\u05df \u05e1\u05e2\u05d9\u05e3 368\u05d3 \u05d0\u05d5 \u05d4\u05de\u05d5\u05e0\u05d7 '\u05d7\u05d5\u05d1\u05ea \u05d3\u05d9\u05d5\u05d5\u05d7'.",
          "\u05d4\u05d1\u05e0\u05d4 \u05e9\u05d7\u05d5\u05d1\u05ea \u05d4\u05d3\u05d9\u05d5\u05d5\u05d7 \u05d2\u05d5\u05d1\u05e8\u05ea \u05e2\u05dc \u05d4\u05e1\u05d5\u05d3\u05d9\u05d5\u05ea \u05d4\u05e8\u05e4\u05d5\u05d0\u05d9\u05ea.",
          "\u05d3\u05d9\u05d5\u05d5\u05d7 \u05dc\u05de\u05e9\u05d8\u05e8\u05d4 \u05d0\u05d5 \u05dc\u05e2\u05d5\u05d1\u05d3 \u05e1\u05d5\u05e6\u05d9\u05d0\u05dc\u05d9 \u05dc\u05e4\u05d9 \u05d7\u05d5\u05e7 \u05d4\u05e0\u05d5\u05e2\u05e8 (\u05e4\u05e7\u05d9\u05d3 \u05e1\u05e2\u05d3)."
        ],
        "errors": {
          "misconceptions": [
            "\u05de\u05d7\u05e9\u05d1\u05d4 \u05e9\u05e0\u05d9\u05ea\u05df \u05dc\u05e9\u05de\u05d5\u05e8 \u05e2\u05dc \u05e1\u05d5\u05d3\u05d9\u05d5\u05ea \u05d0\u05dd \u05d4\u05d0\u05d1 \u05de\u05d1\u05d8\u05d9\u05d7 \u05dc\u05dc\u05db\u05ea \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc.",
            "\u05d4\u05e0\u05d7\u05d4 \u05e9\u05d9\u05e9 \u05dc\u05d3\u05d5\u05d5\u05d7 \u05e8\u05e7 \u05d0\u05dd \u05d4\u05d9\u05dc\u05d3 \u05d1\u05e1\u05db\u05e0\u05ea \u05d7\u05d9\u05d9\u05dd \u05de\u05d9\u05d9\u05d3\u05d9\u05ea."
          ],
          "bluffs": [
            "\u05d0\u05de\u05d9\u05e8\u05d4 \u05db\u05dc\u05dc\u05d9\u05ea \u05e9'\u05e6\u05e8\u05d9\u05da \u05dc\u05d8\u05e4\u05dc \u05d1\u05de\u05e7\u05e8\u05d4 \u05d1\u05e8\u05d2\u05d9\u05e9\u05d5\u05ea' \u05d1\u05dc\u05d9 \u05dc\u05e6\u05d9\u05d9\u05df \u05d0\u05ea \u05d7\u05d5\u05d1\u05ea \u05d4\u05d3\u05d9\u05d5\u05d5\u05d7."
          ]
        }
      },
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05de\u05ea\u05d7 \u05e9\u05d1\u05d9\u05df \u05e1\u05d5\u05d3\u05d9\u05d5\u05ea \u05e8\u05e4\u05d5\u05d0\u05d9\u05ea \u05dc\u05d1\u05d9\u05df \u05d4\u05d2\u05e0\u05d4 \u05e2\u05dc \u05e9\u05dc\u05d5\u05dd \u05d4\u05e7\u05d8\u05d9\u05df \u05d1\u05d7\u05d5\u05e7 \u05d4\u05d9\u05e9\u05e8\u05d0\u05dc\u05d9.",
      "imageUrls": []
