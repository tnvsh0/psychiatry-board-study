{
  "title": "Disability Quiz",
  "questions": [
    {
      "question": "\u05d9\u05dc\u05d3 \u05d1\u05df 10 \u05de\u05d5\u05e4\u05e0\u05d4 \u05dc\u05d4\u05e2\u05e8\u05db\u05d4 \u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9\u05ea \u05d1\u05e9\u05dc \u05e7\u05e9\u05d9\u05d9\u05dd \u05dc\u05d9\u05de\u05d5\u05d3\u05d9\u05d9\u05dd \u05d5\u05d7\u05d1\u05e8\u05ea\u05d9\u05d9\u05dd. \u05d1\u05d1\u05d3\u05d9\u05e7\u05ea WISC-V \u05de\u05ea\u05e7\u05d1\u05dc \u05e6\u05d9\u05d5\u05df IQ \u05e9\u05dc $63$. \u05d1\u05d4\u05e2\u05e8\u05db\u05ea \u05ea\u05e4\u05e7\u05d5\u05d3 \u05d0\u05d3\u05e4\u05d8\u05d9\u05d1\u05d9, \u05e0\u05de\u05e6\u05d0 \u05db\u05d9 \u05d4\u05d9\u05dc\u05d3 \u05de\u05e1\u05d5\u05d2\u05dc \u05dc\u05d3\u05d0\u05d5\u05d2 \u05dc\u05e6\u05e8\u05db\u05d9\u05d5 \u05d4\u05d0\u05d9\u05e9\u05d9\u05d9\u05dd (\u05d0\u05db\u05d9\u05dc\u05d4, \u05e8\u05d7\u05e6\u05d4) \u05d1\u05d0\u05d5\u05e4\u05df \u05e2\u05e6\u05de\u05d0\u05d9, \u05d0\u05da \u05d6\u05e7\u05d5\u05e7 \u05dc\u05ea\u05de\u05d9\u05db\u05d4 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05d1\u05e0\u05d9\u05d4\u05d5\u05dc \u05db\u05e1\u05e4\u05d9\u05dd, \u05e7\u05e8\u05d9\u05d0\u05ea \u05e9\u05e2\u05d5\u05df \u05d5\u05d0\u05e8\u05d2\u05d5\u05df \u05de\u05e9\u05d9\u05de\u05d5\u05ea \u05de\u05d5\u05e8\u05db\u05d1\u05d5\u05ea. \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR, \u05de\u05d4\u05d5 \u05e1\u05d9\u05d5\u05d5\u05d2 \u05d7\u05d5\u05de\u05e8\u05ea \u05d4-Intellectual Disability (ID) \u05d1\u05de\u05e7\u05e8\u05d4 \u05d6\u05d4?",
      "answerOptions": [
        {
          "text": "Mild",
          "isCorrect": true,
          "rationale": "\u05e8\u05de\u05ea \u05d4\u05d7\u05d5\u05de\u05e8\u05d4 \u05e0\u05e7\u05d1\u05e2\u05ea \u05dc\u05e4\u05d9 \u05d4\u05ea\u05e4\u05e7\u05d5\u05d3 \u05d4\u05d0\u05d3\u05e4\u05d8\u05d9\u05d1\u05d9 \u05d5\u05dc\u05d0 \u05dc\u05e4\u05d9 \u05e6\u05d9\u05d5\u05df \u05d4-IQ; \u05d1\u05de\u05e7\u05e8\u05d4 \u05d6\u05d4, \u05d4\u05d9\u05db\u05d5\u05dc\u05ea \u05dc\u05d8\u05e4\u05dc \u05d1\u05e6\u05e8\u05db\u05d9\u05dd \u05d0\u05d9\u05e9\u05d9\u05d9\u05dd \u05dc\u05e6\u05d3 \u05e6\u05d5\u05e8\u05da \u05d1\u05ea\u05de\u05d9\u05db\u05d4 \u05d1\u05de\u05d8\u05dc\u05d5\u05ea \u05de\u05d5\u05e8\u05db\u05d1\u05d5\u05ea \u05ea\u05d5\u05d0\u05de\u05ea \u05d0\u05ea \u05d4\u05d3\u05d9\u05e8\u05d5\u05d2 \u05d4\u05e7\u05dc (DSM p.40-41)."
        },
        {
          "text": "Moderate",
          "isCorrect": false,
          "rationale": "\u05d1\u05e8\u05de\u05d4 \u05d4\u05d1\u05d9\u05e0\u05d5\u05e0\u05d9\u05ea, \u05dc\u05e8\u05d5\u05d1 \u05e0\u05d3\u05e8\u05e9 \u05d6\u05de\u05df \u05d4\u05d5\u05e8\u05d0\u05d4 \u05de\u05de\u05d5\u05e9\u05da \u05d5\u05d4\u05e0\u05d7\u05d9\u05d5\u05ea \u05d7\u05d5\u05d6\u05e8\u05d5\u05ea \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05e6\u05e8\u05db\u05d9\u05dd \u05d0\u05d9\u05e9\u05d9\u05d9\u05dd \u05d1\u05e1\u05d9\u05e1\u05d9\u05d9\u05dd, \u05d3\u05d1\u05e8 \u05e9\u05dc\u05d0 \u05ea\u05d5\u05d0\u05e8 \u05d1\u05de\u05e7\u05e8\u05d4 \u05d6\u05d4 (DSM p.41)."
        },
        {
          "text": "Borderline Intellectual Functioning",
          "isCorrect": false,
          "rationale": "\u05de\u05d5\u05e9\u05d2 \u05d6\u05d4 \u05d0\u05d9\u05e0\u05d5 \u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc ID, \u05d5\u05d4\u05d5\u05d0 \u05de\u05e9\u05de\u05e9 \u05dc\u05d8\u05d5\u05d5\u05d7 IQ \u05e9\u05d1\u05d9\u05df 71 \u05dc-84 \u05dc\u05dc\u05d0 \u05dc\u05d9\u05e7\u05d5\u05d9\u05d9\u05dd \u05d0\u05d3\u05e4\u05d8\u05d9\u05d1\u05d9\u05d9\u05dd \u05d4\u05de\u05e6\u05d3\u05d9\u05e7\u05d9\u05dd \u05d0\u05d1\u05d7\u05e0\u05ea ID (DSM p.37-38)."
        },
        {
          "text": "Specific Learning Disorder",
          "isCorrect": false,
          "rationale": "\u05dc\u05e7\u05d5\u05ea \u05dc\u05de\u05d9\u05d3\u05d4 \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05ea \u05de\u05d0\u05d5\u05d1\u05d7\u05e0\u05ea \u05e8\u05e7 \u05db\u05d0\u05e9\u05e8 \u05e8\u05de\u05ea \u05d4\u05dc\u05de\u05d9\u05d3\u05d4 \u05e0\u05de\u05d5\u05db\u05d4 \u05de\u05d4\u05e6\u05e4\u05d5\u05d9 \u05d1\u05d9\u05d7\u05e1 \u05dc\u05e8\u05de\u05ea \u05d4\u05d0\u05d9\u05e0\u05d8\u05dc\u05d9\u05d2\u05e0\u05e6\u05d9\u05d4 \u05d4\u05db\u05dc\u05dc\u05d9\u05ea, \u05d5\u05dc\u05d0 \u05db\u05d0\u05e9\u05e8 \u05d9\u05e9 \u05e4\u05d2\u05d9\u05e2\u05d4 \u05d2\u05dc\u05d5\u05d1\u05dc\u05d9\u05ea \u05d1-IQ (Dulcan p.112)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d1\u05d5 \u05e2\u05dc \u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df \u05d4\u05e7\u05d5\u05d1\u05e2 \u05d0\u05ea \u05e8\u05de\u05ea \u05d4\u05d7\u05d5\u05de\u05e8\u05d4 \u05d1\u05de\u05e2\u05d1\u05e8 \u05de-DSM-IV \u05dc-DSM-5-TR."
    },
    {
      "question": "\u05d9\u05dc\u05d3\u05d4 \u05d1\u05ea 4 \u05e2\u05dd \u05e2\u05d9\u05db\u05d5\u05d1 \u05e9\u05e4\u05ea\u05d9 \u05e0\u05d9\u05db\u05e8 \u05de\u05e6\u05d9\u05d2\u05d4 \u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4 \u05e9\u05dc congenital cardiac anomalies \u05d5\u05d7\u05d9\u05da \u05e9\u05e1\u05d5\u05e2. \u05d1\u05d1\u05d3\u05d9\u05e7\u05d4 \u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05d1\u05d5\u05dc\u05d8\u05d9\u05dd \u05e7\u05e9\u05d9\u05d9\u05dd \u05d1-Cognitive control \u05d5-Attention. \u05dc\u05e4\u05d9 \u05d4-Dulcan, \u05dc\u05d0\u05d9\u05d6\u05d5 \u05d4\u05e4\u05e8\u05e2\u05d4 \u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9\u05ea \u05e0\u05de\u05e6\u05d0\u05ea \u05de\u05d8\u05d5\u05e4\u05dc\u05ea \u05d6\u05d5 \u05d1\u05e1\u05d9\u05db\u05d5\u05df \u05d4\u05d2\u05d1\u05d5\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d1\u05d1\u05d2\u05e8\u05d5\u05ea\u05d4?",
      "answerOptions": [
        {
          "text": "Schizophrenia",
          "isCorrect": true,
          "rationale": "\u05ea\u05e1\u05de\u05d5\u05e0\u05ea 22q11.2 deletion \u05e0\u05d5\u05e9\u05d0\u05ea \u05d0\u05ea \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05d4\u05d2\u05e0\u05d8\u05d9 \u05d4\u05d2\u05d1\u05d5\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea Schizophrenia \u05d1\u05d1\u05d2\u05e8\u05d5\u05ea (Dulcan p.118)."
        },
        {
          "text": "Bipolar Disorder",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05e9\u05d9\u05e9\u05e0\u05d4 \u05ea\u05d7\u05dc\u05d5\u05d0\u05d4 \u05e0\u05dc\u05d5\u05d5\u05d9\u05ea \u05e9\u05dc \u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05de\u05e6\u05d1 \u05e8\u05d5\u05d7, \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05d5\u05d4\u05d9\u05d9\u05d7\u05d5\u05d3\u05d9 \u05dc\u05ea\u05e1\u05de\u05d5\u05e0\u05ea \u05d6\u05d5 \u05d4\u05d5\u05d0 \u05dc\u05e1\u05e4\u05e7\u05d8\u05e8\u05d5\u05dd \u05d4\u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9 (Dulcan p.118)."
        },
        {
          "text": "Major Neurocognitive Disorder",
          "isCorrect": false,
          "rationale": "\u05e1\u05d9\u05db\u05d5\u05df \u05de\u05d5\u05d2\u05d1\u05e8 \u05dc-Dementia \u05de\u05d5\u05e7\u05d3\u05de\u05ea \u05de\u05d6\u05d5\u05d4\u05d4 \u05d1\u05e2\u05d9\u05e7\u05e8 \u05e2\u05dd Down Syndrome \u05d5\u05dc\u05d0 \u05e2\u05dd 22q11.2 (Dulcan p.119)."
        },
        {
          "text": "Autism Spectrum Disorder (ASD)",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05e9-ASD \u05e0\u05e4\u05d5\u05e5 \u05d1\u05e7\u05e8\u05d1 \u05d4\u05dc\u05d5\u05e7\u05d9\u05dd \u05d1\u05ea\u05e1\u05de\u05d5\u05e0\u05ea, Schizophrenia \u05d4\u05d9\u05d0 \u05d4\u05e1\u05d9\u05d1\u05d5\u05da \u05d4\u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9 \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05d5\u05d4\u05e7\u05e8\u05d9\u05d8\u05d9 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05de\u05e2\u05e7\u05d1 (Dulcan p.118)."
        }
      ],
      "hint": "\u05d4\u05ea\u05e1\u05de\u05d5\u05e0\u05ea \u05d4\u05de\u05ea\u05d5\u05d0\u05e8\u05ea \u05e7\u05e9\u05d5\u05e8\u05d4 \u05dc\u05de\u05d7\u05d9\u05e7\u05d4 \u05e9\u05dc \u05de\u05e7\u05d8\u05e2 \u05db\u05e8\u05d5\u05de\u05d5\u05d6\u05d5\u05de\u05dc\u05d9 \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9 \u05d4\u05de\u05e7\u05d5\u05e9\u05e8 \u05dc\u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d4."
    },
    {
      "question": "\u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05e2\u05e8\u05db\u05ea \u05e4\u05e2\u05d5\u05d8 \u05d1\u05df \u05e9\u05e0\u05ea\u05d9\u05d9\u05dd \u05d5\u05d7\u05e6\u05d9 \u05e2\u05dd \u05d7\u05e9\u05d3 \u05dc-Global Developmental Delay (GDD), \u05d4\u05e7\u05dc\u05d9\u05e0\u05d0\u05d9 \u05de\u05e2\u05d5\u05e0\u05d9\u05d9\u05df \u05dc\u05d4\u05e9\u05ea\u05de\u05e9 \u05d1\u05db\u05dc\u05d9 \u05dc\u05d4\u05e2\u05e8\u05db\u05ea \u05ea\u05d7\u05d5\u05de\u05d9 \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea \u05e0\u05e4\u05e8\u05d3\u05d9\u05dd (\u05de\u05d5\u05d8\u05d5\u05e8\u05d9\u05e7\u05d4, \u05e7\u05d5\u05d2\u05e0\u05d9\u05e6\u05d9\u05d4, \u05e9\u05e4\u05d4). \u05d0\u05d9\u05d6\u05d4 \u05de\u05d4\u05db\u05dc\u05d9\u05dd \u05d4\u05d1\u05d0\u05d9\u05dd \u05d4\u05d5\u05d0 \u05d4\u05de\u05ea\u05d0\u05d9\u05dd \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05de\u05d8\u05e8\u05d4 \u05d6\u05d5 \u05dc\u05e4\u05d9 \u05d4-Dulcan?",
      "answerOptions": [
        {
          "text": "Bayley Scales of Infant and Toddler Development (Bayley-4)",
          "isCorrect": true,
          "rationale": "\u05d4-Bayley-4 \u05de\u05e1\u05e4\u05e7 \u05de\u05d3\u05d3\u05d9\u05dd \u05e0\u05e4\u05e8\u05d3\u05d9\u05dd \u05dc\u05d9\u05db\u05d5\u05dc\u05d5\u05ea \u05de\u05d5\u05d8\u05d5\u05e8\u05d9\u05d5\u05ea \u05d5\u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9\u05d5\u05ea \u05d5\u05de\u05d5\u05ea\u05d0\u05dd \u05d1\u05de\u05d9\u05d5\u05d7\u05d3 \u05dc\u05d2\u05d9\u05dc\u05d0\u05d9 \u05d4\u05d9\u05e0\u05e7\u05d5\u05ea \u05d5\u05d4\u05d2\u05d9\u05dc \u05d4\u05e8\u05da (Dulcan p.114)."
        },
        {
          "text": "WISC-V",
          "isCorrect": false,
          "rationale": "\u05db\u05dc\u05d9 \u05d6\u05d4 \u05de\u05d9\u05d5\u05e2\u05d3 \u05dc\u05d9\u05dc\u05d3\u05d9\u05dd \u05d1\u05d2\u05d9\u05dc\u05d0\u05d9 6 \u05e2\u05d3 16 \u05d5\u05d0\u05d9\u05e0\u05d5 \u05de\u05ea\u05d0\u05d9\u05dd \u05dc\u05d4\u05e2\u05e8\u05db\u05ea \u05e4\u05e2\u05d5\u05d8\u05d5\u05ea (Dulcan p.113)."
        },
        {
          "text": "Stanford-Binet (SB-5)",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05e9\u05d4\u05d5\u05d0 \u05de\u05ea\u05d7\u05d9\u05dc \u05de\u05d2\u05d9\u05dc \u05e9\u05e0\u05ea\u05d9\u05d9\u05dd, \u05d4\u05d5\u05d0 \u05e4\u05d7\u05d5\u05ea \u05de\u05e4\u05d5\u05e8\u05d8 \u05d1\u05d4\u05e4\u05e8\u05d3\u05ea \u05de\u05d3\u05d3\u05d9\u05dd \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9\u05d9\u05dd \u05d1\u05e1\u05d9\u05e1\u05d9\u05d9\u05dd \u05db\u05de\u05d5 \u05d4-Bayley (Dulcan p.113)."
        },
        {
          "text": "Vineland-3",
          "isCorrect": false,
          "rationale": "\u05d6\u05d4\u05d5 \u05db\u05dc\u05d9 \u05dc\u05d4\u05e2\u05e8\u05db\u05ea \u05ea\u05e4\u05e7\u05d5\u05d3 \u05d0\u05d3\u05e4\u05d8\u05d9\u05d1\u05d9 (Adaptive Behavior) \u05d5\u05dc\u05d0 \u05dc\u05d4\u05e2\u05e8\u05db\u05d4 \u05d9\u05e9\u05d9\u05e8\u05d4 \u05e9\u05dc \u05d9\u05db\u05d5\u05dc\u05d5\u05ea \u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9\u05d5\u05ea/\u05de\u05d5\u05d8\u05d5\u05e8\u05d9\u05d5\u05ea \u05e9\u05dc \u05d4\u05d9\u05dc\u05d3 (Dulcan p.115)."
        }
      ],
      "hint": "\u05d7\u05e4\u05e9\u05d5 \u05d0\u05ea \u05d4\u05db\u05dc\u05d9 \u05d4\u05de\u05e7\u05d5\u05d1\u05dc \u05dc\u05d4\u05e2\u05e8\u05db\u05ea \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea \u05de\u05d5\u05e7\u05d3\u05de\u05ea \u05d5\u05dc\u05d0 \u05de\u05d1\u05d7\u05df \u05d0\u05d9\u05e0\u05d8\u05dc\u05d9\u05d2\u05e0\u05e6\u05d9\u05d4 \u05e7\u05dc\u05d0\u05e1\u05d9."
    },
    {
      "question": "\u05e0\u05e2\u05e8 \u05e2\u05dd Fragile X Syndrome (FXS) \u05de\u05e6\u05d9\u05d2 \u05e8\u05de\u05d5\u05ea \u05d2\u05d1\u05d5\u05d4\u05d5\u05ea \u05e9\u05dc Social anxiety, Hyperarousal \u05d5-Gaze aversion. \u05d0\u05d9\u05d6\u05d4 \u05de\u05d4\u05de\u05de\u05e6\u05d0\u05d9\u05dd \u05d4\u05d1\u05d0\u05d9\u05dd \u05d4\u05d5\u05d0 \u05d1\u05e2\u05dc \u05d4\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d4\u05d2\u05d1\u05d5\u05d4\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d1\u05ea\u05d7\u05dc\u05d5\u05d0\u05d4 \u05e0\u05dc\u05d5\u05d5\u05d9\u05ea \u05dc\u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd \u05e2\u05dd FXS \u05dc\u05e4\u05d9 \u05d4-Dulcan?",
      "answerOptions": [
        {
          "text": "ADHD",
          "isCorrect": true,
          "rationale": "\u05d1\u05e7\u05e8\u05d1 \u05d6\u05db\u05e8\u05d9\u05dd \u05e2\u05dd FXS, \u05e7\u05d9\u05d9\u05dd \u05e1\u05d9\u05db\u05d5\u05df \u05d2\u05d1\u05d5\u05d4 \u05de\u05d0\u05d5\u05d3 \u05dc-ADHD, \u05d4\u05de\u05ea\u05d1\u05d8\u05d0 \u05d1\u05d4\u05d9\u05e4\u05e8\u05d0\u05e7\u05d8\u05d9\u05d1\u05d9\u05d5\u05ea \u05d5\u05e7\u05e9\u05d9\u05d9 \u05e7\u05e9\u05d1 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05d9\u05dd (Dulcan p.120)."
        },
        {
          "text": "Conduct Disorder",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05e7\u05e9\u05d9\u05d9 \u05d5\u05d9\u05e1\u05d5\u05ea, \u05d4\u05e4\u05e0\u05d5\u05d8\u05d9\u05e4 \u05d4\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea\u05d9 \u05e9\u05dc FXS \u05de\u05d0\u05d5\u05e4\u05d9\u05d9\u05df \u05d9\u05d5\u05ea\u05e8 \u05d1\u05d7\u05e8\u05d3\u05d4 \u05d7\u05d1\u05e8\u05ea\u05d9\u05ea \u05d5\u05d1\u05d9\u05d9\u05e9\u05e0\u05d5\u05ea \u05de\u05d0\u05e9\u05e8 \u05d1\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d0\u05e0\u05d8\u05d9-\u05e1\u05d5\u05e6\u05d9\u05d0\u05dc\u05d9\u05ea (Dulcan p.120)."
        },
        {
          "text": "Major Depressive Disorder",
          "isCorrect": false,
          "rationale": "\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05d7\u05e8\u05d3\u05d4 \u05e0\u05e4\u05d5\u05e6\u05d5\u05ea \u05d4\u05e8\u05d1\u05d4 \u05d9\u05d5\u05ea\u05e8 \u05de\u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05e7\u05dc\u05d9\u05e0\u05d9 \u05d1\u05e4\u05e0\u05d5\u05d8\u05d9\u05e4 \u05e9\u05dc FXS (Dulcan p.120)."
        },
        {
          "text": "Schizophrenia",
          "isCorrect": false,
          "rationale": "\u05e7\u05d9\u05d9\u05dd \u05e1\u05d9\u05db\u05d5\u05df \u05dc-Schizotypal features, \u05d0\u05da Schizophrenia \u05de\u05dc\u05d0\u05d4 \u05d0\u05d9\u05e0\u05d4 \u05d4\u05ea\u05d7\u05dc\u05d5\u05d0\u05d4 \u05d4\u05e0\u05dc\u05d5\u05d5\u05d9\u05ea \u05d4\u05de\u05d5\u05d1\u05d9\u05dc\u05d4 (Dulcan p.120)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d1\u05d5 \u05e2\u05dc \u05d4\u05d4\u05e4\u05e8\u05e2\u05d4 \u05d4\u05e0\u05d5\u05d9\u05e8\u05d5-\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9\u05ea \u05d4\u05e0\u05e4\u05d5\u05e6\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d4\u05de\u05e2\u05e8\u05d1\u05ea \u05d4\u05d9\u05e4\u05e8\u05d0\u05e7\u05d8\u05d9\u05d1\u05d9\u05d5\u05ea."
    },
    {
      "question": "\u05de\u05d8\u05d5\u05e4\u05dc \u05d1\u05df 22 \u05e2\u05dd Down Syndrome (DS) \u05de\u05d5\u05e4\u05e0\u05d4 \u05d1\u05e9\u05dc \u05d9\u05e8\u05d9\u05d3\u05d4 \u05d7\u05d3\u05d4 \u05d1\u05ea\u05e4\u05e7\u05d5\u05d3 \u05d4\u05d9\u05d5\u05de\u05d9\u05d5\u05de\u05d9, \u05e7\u05e9\u05d9\u05d9 \u05d6\u05d9\u05db\u05e8\u05d5\u05df \u05d7\u05d3\u05e9\u05d9\u05dd \u05d5\u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd \u05d1\u05d0\u05d9\u05e9\u05d9\u05d5\u05ea. \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR, \u05de\u05d4\u05d5 \u05d4\u05de\u05d4\u05dc\u05da \u05d4\u05d0\u05d1\u05d7\u05e0\u05ea\u05d9 \u05d4\u05e0\u05db\u05d5\u05df?",
      "answerOptions": [
        {
          "text": "\u05e0\u05d9\u05ea\u05df \u05dc\u05d0\u05d1\u05d7\u05df \u05d1\u05e0\u05d5\u05e1\u05e3 Major Neurocognitive Disorder (NCD)",
          "isCorrect": true,
          "rationale": "\u05d1\u05de\u05e7\u05e8\u05d9\u05dd \u05e9\u05dc \u05d0\u05d5\u05d1\u05d3\u05df \u05d9\u05db\u05d5\u05dc\u05d5\u05ea \u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9\u05d5\u05ea \u05e7\u05d5\u05d3\u05de\u05d5\u05ea, \u05db\u05e4\u05d9 \u05e9\u05e7\u05d5\u05e8\u05d4 \u05d1\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d2\u05d1\u05d5\u05d4\u05d4 \u05d1-DS \u05d1\u05e9\u05dc Alzheimer's, \u05e0\u05d9\u05ea\u05df \u05dc\u05ea\u05ea \u05d0\u05ea \u05e9\u05ea\u05d9 \u05d4\u05d0\u05d1\u05d7\u05e0\u05d5\u05ea: ID \u05d5-NCD (DSM p.43)."
        },
        {
          "text": "\u05dc\u05d0 \u05e0\u05d9\u05ea\u05df \u05dc\u05d0\u05d1\u05d7\u05df NCD \u05db\u05d9 \u05d4-ID \u05de\u05e1\u05d1\u05d9\u05e8 \u05d0\u05ea \u05db\u05dc \u05d4\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd",
          "isCorrect": false,
          "rationale": "\u05d4-DSM \u05de\u05d0\u05e4\u05e9\u05e8 \u05d1\u05de\u05e4\u05d5\u05e8\u05e9 \u05d0\u05d1\u05d7\u05e0\u05d4 \u05db\u05e4\u05d5\u05dc\u05d4 \u05db\u05d0\u05e9\u05e8 \u05d9\u05e9\u05e0\u05d4 \u05d9\u05e8\u05d9\u05d3\u05d4 \u05de\u05e2\u05d1\u05e8 \u05dc\u05d1\u05d9\u05d9\u05e1\u05dc\u05d9\u05d9\u05df \u05e9\u05dc \u05d4-ID (DSM p.45)."
        },
        {
          "text": "\u05d9\u05e9 \u05dc\u05e9\u05e0\u05d5\u05ea \u05d0\u05ea \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05de-ID \u05dc-Major NCD \u05d1\u05dc\u05d1\u05d3",
          "isCorrect": false,
          "rationale": "ID \u05d4\u05d9\u05d0 \u05d4\u05e4\u05e8\u05e2\u05d4 \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9\u05ea \u05dc\u05db\u05dc \u05d4\u05d7\u05d9\u05d9\u05dd; \u05d4-NCD \u05de\u05ea\u05d5\u05d5\u05e1\u05e3 \u05d0\u05dc\u05d9\u05d4 \u05db\u05d1\u05d9\u05d8\u05d5\u05d9 \u05dc\u05d9\u05e8\u05d9\u05d3\u05d4 \u05e4\u05ea\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea \u05de\u05d0\u05d5\u05d7\u05e8\u05ea (DSM p.45)."
        },
        {
          "text": "\u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05de\u05ea\u05d0\u05d9\u05de\u05d4 \u05d4\u05d9\u05d0 Schizophrenia, Late-onset",
          "isCorrect": false,
          "rationale": "\u05d4\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05e9\u05dc \u05d9\u05e8\u05d9\u05d3\u05d4 \u05d1\u05d6\u05d9\u05db\u05e8\u05d5\u05df \u05d5\u05ea\u05e4\u05e7\u05d5\u05d3 \u05d1-DS \u05de\u05db\u05d5\u05d5\u05e0\u05d9\u05dd \u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05dc\u05ea\u05d4\u05dc\u05d9\u05da \u05d3\u05de\u05e0\u05d8\u05d9\u05d1\u05d9 \u05d5\u05dc\u05d0 \u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9 (Dulcan p.119)."
        }
      ],
      "hint": "\u05d4\u05d0\u05dd \u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc \u05d4\u05e4\u05e8\u05e2\u05d4 \u05e0\u05d5\u05d9\u05e8\u05d5-\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9\u05ea \u05de\u05d5\u05e0\u05e2\u05ea \u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc \u05d4\u05e4\u05e8\u05e2\u05d4 \u05e0\u05d5\u05d9\u05e8\u05d5-\u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9\u05ea?"
    },
    {
      "question": "\u05d9\u05dc\u05d3 \u05d1\u05df 7 \u05de\u05e6\u05d9\u05d2 \u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05e7\u05e9\u05d1, \u05d0\u05d9\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05d5\u05ea \u05e0\u05d9\u05db\u05e8\u05ea \u05d5\u05dc\u05d9\u05e7\u05d5\u05d9\u05d9\u05dd \u05d1-Self-regulation. \u05d1\u05d1\u05d3\u05d9\u05e7\u05d4 \u05d1\u05d5\u05dc\u05d8\u05d9\u05dd philtrum \u05d7\u05dc\u05e7, \u05e9\u05e4\u05d4 \u05e2\u05dc\u05d9\u05d5\u05e0\u05d4 \u05d3\u05e7\u05d4 \u05d5\u05e6\u05de\u05e6\u05d5\u05dd \u05e9\u05dc \u05d4-Palpebral fissures. \u05dc\u05e4\u05d9 \u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05d4\u05de\u05d5\u05e6\u05e2\u05d9\u05dd \u05dc-Neurobehavioral Disorder Associated with Prenatal Alcohol Exposure (ND-PAE), \u05de\u05d4\u05d9 \u05d4\u05db\u05de\u05d5\u05ea \u05d4\u05de\u05d5\u05d2\u05d3\u05e8\u05ea \u05db-'More than minimal exposure'?",
      "answerOptions": [
        {
          "text": "\u05d9\u05d5\u05ea\u05e8 \u05de-$13$ \u05de\u05e9\u05e7\u05d0\u05d5\u05ea \u05d1\u05d7\u05d5\u05d3\u05e9 \u05d0\u05d5 \u05d9\u05d5\u05ea\u05e8 \u05de-$2$ \u05de\u05e9\u05e7\u05d0\u05d5\u05ea \u05d1\u05d0\u05d9\u05e8\u05d5\u05e2 \u05d0\u05d7\u05d3",
          "isCorrect": true,
          "rationale": "\u05d4\u05d2\u05d3\u05e8\u05ea \u05d4\u05d7\u05e9\u05d9\u05e4\u05d4 \u05d4\u05de\u05d9\u05e0\u05d9\u05de\u05dc\u05d9\u05ea \u05d4\u05e0\u05d3\u05e8\u05e9\u05ea \u05dc\u05e4\u05d9 \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df A \u05d1-ND-PAE \u05de\u05d1\u05d5\u05e1\u05e1\u05ea \u05e2\u05dc \u05e1\u05e3 \u05d6\u05d4 \u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05d4\u05d9\u05e8\u05d9\u05d5\u05df (DSM p.918)."
        },
        {
          "text": "\u05db\u05dc \u05db\u05de\u05d5\u05ea \u05e9\u05dc \u05d0\u05dc\u05db\u05d5\u05d4\u05d5\u05dc \u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05d8\u05e8\u05d9\u05de\u05e1\u05d8\u05e8 \u05d4\u05e8\u05d0\u05e9\u05d5\u05df \u05d1\u05dc\u05d1\u05d3",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05e9\u05db\u05dc \u05db\u05de\u05d5\u05ea \u05e2\u05e9\u05d5\u05d9\u05d4 \u05dc\u05d4\u05d6\u05d9\u05e7, \u05d4-DSM \u05de\u05d2\u05d3\u05d9\u05e8 \u05e1\u05e3 \u05db\u05de\u05d5\u05ea\u05d9 \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9 \u05dc\u05e6\u05d5\u05e8\u05da \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05de\u05d5\u05e6\u05e2\u05ea (DSM p.918)."
        },
        {
          "text": "\u05dc\u05e4\u05d7\u05d5\u05ea \u05de\u05e9\u05e7\u05d4 \u05d0\u05d7\u05d3 \u05d1\u05db\u05dc \u05d9\u05d5\u05dd \u05dc\u05d0\u05d5\u05e8\u05da \u05db\u05dc \u05d4\u05d4\u05d9\u05e8\u05d9\u05d5\u05df",
          "isCorrect": false,
          "rationale": "\u05d4\u05e1\u05e3 \u05d4\u05e0\u05d3\u05e8\u05e9 \u05e0\u05de\u05d5\u05da \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05de\u05de\u05e9\u05e7\u05d4 \u05d9\u05d5\u05de\u05d9; \u05de\u05e1\u05e4\u05d9\u05e7\u05d9\u05dd 13 \u05de\u05e9\u05e7\u05d0\u05d5\u05ea \u05d1\u05d7\u05d5\u05d3\u05e9 (DSM p.918)."
        },
        {
          "text": "\u05d7\u05de\u05d9\u05e9\u05d4 \u05de\u05e9\u05e7\u05d0\u05d5\u05ea (Binge drinking) \u05dc\u05e4\u05d7\u05d5\u05ea \u05e4\u05e2\u05dd \u05d0\u05d7\u05ea \u05d1\u05d8\u05e8\u05d9\u05de\u05e1\u05d8\u05e8 \u05d4\u05e9\u05e0\u05d9",
          "isCorrect": false,
          "rationale": "\u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df \u05de\u05e6\u05d9\u05d9\u05df \u05d7\u05e9\u05d9\u05e4\u05d4 \u05e9\u05dc \u05d9\u05d5\u05ea\u05e8 \u05de-2 \u05de\u05e9\u05e7\u05d0\u05d5\u05ea \u05d1\u05d0\u05d9\u05e8\u05d5\u05e2 \u05d1\u05d5\u05d3\u05d3 \u05db\u05d7\u05dc\u05e7 \u05de\u05d4\u05d4\u05d2\u05d3\u05e8\u05d4 (DSM p.918)."
        }
      ],
      "hint": "\u05d7\u05e4\u05e9\u05d5 \u05d0\u05ea \u05d4\u05de\u05e1\u05e4\u05e8\u05d9\u05dd \u05d4\u05de\u05d3\u05d5\u05d9\u05e7\u05d9\u05dd \u05d4\u05de\u05d2\u05d3\u05d9\u05e8\u05d9\u05dd \u05e6\u05e8\u05d9\u05db\u05d4 \u05d7\u05d5\u05d3\u05e9\u05d9\u05ea \u05d0\u05d5 \u05d0\u05d9\u05e8\u05d5\u05e2 \u05d1\u05d5\u05d3\u05d3 \u05d1-DSM."
    },
    {
      "question": "\u05ea\u05d9\u05e0\u05d5\u05e7 \u05d1\u05df 9 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05e2\u05dd \u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4 \u05e9\u05dc Hypotonia \u05e0\u05d9\u05db\u05e8\u05ea \u05d5\u05e7\u05e9\u05d9\u05d9 \u05d4\u05d0\u05db\u05dc\u05d4 \u05d1\u05d5\u05dc\u05d8. \u05d1\u05d2\u05d9\u05dc \u05e9\u05e0\u05ea\u05d9\u05d9\u05dd \u05d4\u05d5\u05d0 \u05de\u05e4\u05ea\u05d7 Hyperphagia \u05d5\u05de\u05ea\u05d7\u05d9\u05dc \u05dc\u05d4\u05e4\u05d2\u05d9\u05df Compulsive food-seeking. \u05d0\u05d9\u05d6\u05d4 \u05d8\u05d9\u05e4\u05d5\u05dc \u05ea\u05e8\u05d5\u05e4\u05ea\u05d9 \u05e0\u05de\u05e6\u05d0 \u05d9\u05e2\u05d9\u05dc \u05d1-Dulcan \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05dd \u05d4\u05e1\u05e4\u05e6\u05d9\u05e4\u05d9 \u05e9\u05dc Skin picking \u05d1\u05ea\u05e1\u05de\u05d5\u05e0\u05ea \u05d6\u05d5?",
      "answerOptions": [
        {
          "text": "Topiramate",
          "isCorrect": true,
