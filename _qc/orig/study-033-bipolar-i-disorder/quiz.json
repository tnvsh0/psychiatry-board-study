      ],
      "hint": "\u05d7\u05e4\u05e9\u05d5 \u05d0\u05ea \u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 \u05d4\u05d0\u05e0\u05d8\u05d9-\u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9\u05ea \u05de\u05d4\u05d3\u05d5\u05e8 \u05d4\u05e9\u05e0\u05d9 \u05e9\u05e7\u05d9\u05d1\u05dc\u05d4 \u05d0\u05d9\u05e9\u05d5\u05e8 \u05d9\u05d9\u05e2\u05d5\u05d3\u05d9 \u05dc\u05de\u05d5\u05e4\u05e2 \u05d4\u05d3\u05d9\u05db\u05d0\u05d5\u05e0\u05d9 \u05e9\u05dc \u05d4\u05de\u05d7\u05dc\u05d4 \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd."
    },
    {
      "question": "\u05dc\u05e0\u05e2\u05e8 \u05d1\u05df 13 \u05d9\u05e9 \u05d4\u05d5\u05e8\u05d4 \u05d4\u05de\u05d0\u05d5\u05d1\u05d7\u05df \u05e2\u05dd Bipolar Disorder. \u05d4\u05e0\u05e2\u05e8 \u05e1\u05d5\u05d1\u05dc \u05de\u05d4\u05e4\u05e8\u05e2\u05ea \u05d7\u05e8\u05d3\u05d4 (Generalized anxiety disorder) \u05d5\u05e7\u05e9\u05d9\u05d9 \u05e9\u05d9\u05e0\u05d4 \u05db\u05e8\u05d5\u05e0\u05d9\u05d9\u05dd. \u05dc\u05e4\u05d9 \u05de\u05d7\u05e7\u05e8\u05d9 \u05d4-High-risk, \u05de\u05d4 \u05e0\u05db\u05d5\u05df \u05dc\u05d2\u05d1\u05d9 \u05de\u05e6\u05d1\u05d5?",
      "answerOptions": [
        {
          "text": "\u05d4\u05d5\u05d0 \u05e0\u05de\u05e6\u05d0 \u05d1\u05e1\u05d9\u05db\u05d5\u05df \u05de\u05d5\u05d2\u05d1\u05e8 (\u05e4\u05d9 $2.5$ \u05d1\u05e2\u05e8\u05da) \u05dc\u05e4\u05ea\u05d7 \u05d4\u05e4\u05e8\u05e2\u05ea \u05de\u05e6\u05d1 \u05e8\u05d5\u05d7 \u05d1\u05e2\u05ea\u05d9\u05d3",
          "isCorrect": true,
          "rationale": "\u05d7\u05e8\u05d3\u05d4 \u05d5\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05e9\u05d9\u05e0\u05d4 \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05dc\u05d4\u05d5\u05e8\u05d9\u05dd \u05d1\u05d9\u05e4\u05d5\u05dc\u05e8\u05d9\u05d9\u05dd \u05de\u05d6\u05d5\u05d4\u05d9\u05dd \u05db\u05e1\u05de\u05e0\u05d9\u05dd \u05de\u05e7\u05d3\u05d9\u05de\u05d9\u05dd (Antecedents) \u05d4\u05de\u05e0\u05d1\u05d0\u05d9\u05dd \u05e1\u05d9\u05db\u05d5\u05df \u05de\u05d5\u05d2\u05d1\u05e8 \u05dc\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea \u05d4\u05e4\u05e8\u05e2\u05d4 \u05d3\u05d5-\u05e7\u05d5\u05d8\u05d1\u05d9\u05ea (Dulcan p.290)."
        },
        {
          "text": "\u05d0\u05d9\u05df \u05dc\u05d5 \u05e1\u05d9\u05db\u05d5\u05df \u05de\u05d5\u05d2\u05d1\u05e8 \u05dc\u05e4\u05ea\u05d7 Bipolar disorder \u05db\u05dc \u05e2\u05d5\u05d3 \u05d0\u05d9\u05df \u05dc\u05d5 ADHD",
          "isCorrect": false,
          "rationale": "\u05de\u05d7\u05e7\u05e8\u05d9\u05dd \u05de\u05e8\u05d0\u05d9\u05dd \u05e9-ADHD \u05d0\u05d9\u05e0\u05d5 \u05ea\u05de\u05d9\u05d3 \u05e7\u05e9\u05d5\u05e8 \u05d2\u05e0\u05d8\u05d9\u05ea \u05dc-Classic lithium-responsive bipolar disorder (Dulcan p.290)."
        },
        {
          "text": "\u05d4\u05e4\u05e8\u05e2\u05ea \u05d4\u05d7\u05e8\u05d3\u05d4 \u05e9\u05dc\u05d5 \u05d4\u05d9\u05d0 \u05d1\u05d4\u05db\u05e8\u05d7 \u05d7\u05dc\u05e7 \u05de-Manic episode",
          "isCorrect": false,
          "rationale": "\u05d7\u05e8\u05d3\u05d4 \u05d9\u05db\u05d5\u05dc\u05d4 \u05dc\u05d4\u05d5\u05e4\u05d9\u05e2 \u05db\u05d4\u05e4\u05e8\u05e2\u05d4 \u05de\u05e7\u05d3\u05d9\u05de\u05d4 \u05e9\u05e0\u05d9\u05dd \u05e8\u05d1\u05d5\u05ea \u05dc\u05e4\u05e0\u05d9 \u05d4\u05d5\u05e4\u05e2\u05ea \u05d4\u05d0\u05e4\u05d9\u05d6\u05d5\u05d3\u05d4 \u05d4\u05de\u05d0\u05e0\u05d9\u05ea \u05d4\u05e8\u05d0\u05e9\u05d5\u05e0\u05d4 (Dulcan p.290)."
        },
        {
          "text": "\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-SSRI \u05d4\u05d5\u05d0 \u05d1\u05d8\u05d5\u05d7 \u05dc\u05d7\u05dc\u05d5\u05d8\u05d9\u05df \u05e2\u05d1\u05d5\u05e8\u05d5 \u05d5\u05d0\u05d9\u05e0\u05d5 \u05d3\u05d5\u05e8\u05e9 \u05e0\u05d9\u05d8\u05d5\u05e8 \u05de\u05d9\u05d5\u05d7\u05d3",
          "isCorrect": false,
          "rationale": "\u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd \u05e8\u05e7\u05e2 \u05de\u05e9\u05e4\u05d7\u05ea\u05d9 \u05d1\u05d9\u05e4\u05d5\u05dc\u05e8\u05d9 \u05d9\u05e9 \u05dc\u05d4\u05d9\u05d6\u05d4\u05e8 \u05d1\u05de\u05ea\u05df \u05e0\u05d5\u05d2\u05d3\u05d9 \u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05e2\u05e7\u05d1 \u05e1\u05d9\u05db\u05d5\u05df \u05de\u05d5\u05d2\u05d1\u05e8 \u05dc-Activation \u05d0\u05d5 Switch (Dulcan p.253)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d1\u05d5 \u05e2\u05dc \u05d4\u05de\u05d5\u05e0\u05d7 Sequential comorbidity \u05e9\u05d1\u05d5 \u05d4\u05e4\u05e8\u05e2\u05d4 \u05d0\u05d7\u05ea \u05de\u05e0\u05d1\u05d0\u05ea \u05d4\u05d5\u05e4\u05e2\u05d4 \u05e9\u05dc \u05d0\u05d7\u05e8\u05ea."
    },
    {
      "question": "\u05de\u05d4\u05d5 \u05d4\u05de\u05de\u05e6\u05d0 \u05d4\u05e0\u05d5\u05d9\u05e8\u05d5\u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05e9\u05ea\u05d5\u05d0\u05e8 \u05db-Shared endophenotype deficit \u05d1\u05de\u05d7\u05e7\u05e8\u05d9 fMRI, \u05d4\u05de\u05d5\u05e4\u05d9\u05e2 \u05d4\u05df \u05d1\u05e6\u05e2\u05d9\u05e8\u05d9\u05dd \u05e2\u05dd Bipolar disorder \u05d5\u05d4\u05df \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d1\u05e8\u05d9\u05d0\u05d9\u05dd \u05d4\u05e0\u05de\u05e6\u05d0\u05d9\u05dd \u05d1\u05e1\u05d9\u05db\u05d5\u05df \u05d2\u05d1\u05d5\u05d4 (High-risk) \u05dc\u05d4\u05e4\u05e8\u05e2\u05d4?",
      "answerOptions": [
        {
          "text": "Abnormal brain region activation during emotion labeling tasks",
          "isCorrect": true,
          "rationale": "\u05de\u05d7\u05e7\u05e8\u05d9 fMRI \u05d6\u05d9\u05d4\u05d5 \u05d0\u05d6\u05d5\u05e8\u05d9 \u05de\u05d5\u05d7 \u05de\u05e9\u05d5\u05ea\u05e4\u05d9\u05dd \u05d4\u05de\u05d5\u05e4\u05e2\u05dc\u05d9\u05dd \u05d1\u05d0\u05d5\u05e4\u05df \u05dc\u05d0 \u05ea\u05e7\u05d9\u05df \u05d1\u05e2\u05ea \u05d6\u05d9\u05d4\u05d5\u05d9 \u05e8\u05d2\u05e9\u05d5\u05ea \u05d1\u05e4\u05e8\u05e6\u05d5\u05e4\u05d9\u05dd \u05d4\u05df \u05d1\u05d7\u05d5\u05dc\u05d9\u05dd \u05d5\u05d4\u05df \u05d1\u05e7\u05d1\u05d5\u05e6\u05d5\u05ea \u05e1\u05d9\u05db\u05d5\u05df (Dulcan p.292)."
        },
        {
          "text": "Increased volume of the anterior cingulate cortex",
          "isCorrect": false,
          "rationale": "\u05de\u05d7\u05e7\u05e8\u05d9\u05dd \u05de\u05e6\u05d1\u05d9\u05e2\u05d9\u05dd \u05d3\u05d5\u05d5\u05e7\u05d0 \u05e2\u05dc \u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd \u05d1\u05e7\u05d9\u05e9\u05d5\u05e8\u05d9\u05d5\u05ea \u05d5\u05d1\u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05d4-ACC \u05d5\u05dc\u05d0 \u05d1\u05d4\u05db\u05e8\u05d7 \u05e2\u05dc \u05d4\u05d2\u05d3\u05dc\u05ea \u05e0\u05e4\u05d7 (Dulcan p.292)."
        },
        {
          "text": "Total absence of white matter microstructure abnormalities",
          "isCorrect": false,
          "rationale": "\u05e0\u05de\u05e6\u05d0\u05d5 \u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd \u05d1\u05de\u05d9\u05e7\u05e8\u05d5-\u05e1\u05d8\u05e8\u05d5\u05e7\u05d8\u05d5\u05e8\u05d4 \u05e9\u05dc \u05d4\u05d7\u05d5\u05de\u05e8 \u05d4\u05dc\u05d1\u05df \u05d1\u05e7\u05e8\u05d1 \u05d7\u05d5\u05dc\u05d9\u05dd \u05d1-BP-I \u05d5\u05d1-DMDD (Dulcan p.292)."
        },
        {
          "text": "Over-activation of the visual cortex only",
          "isCorrect": false,
          "rationale": "\u05d4\u05dc\u05d9\u05e7\u05d5\u05d9\u05d9\u05dd \u05d4\u05e2\u05d9\u05e7\u05e8\u05d9\u05d9\u05dd \u05e7\u05e9\u05d5\u05e8\u05d9\u05dd \u05dc\u05de\u05e2\u05e8\u05db\u05d5\u05ea \u05e2\u05d9\u05d1\u05d5\u05d3 \u05e8\u05d2\u05e9\u05d9 (\u05db\u05de\u05d5 \u05d0\u05de\u05d9\u05d2\u05d3\u05dc\u05d4 \u05d5-PFC) \u05d5\u05dc\u05d0 \u05dc\u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05e8\u05d0\u05d9\u05d9\u05d4 \u05d4\u05e8\u05d0\u05e9\u05d5\u05e0\u05d9\u05ea (Dulcan p.292)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d1\u05d5 \u05e2\u05dc \u05d4\u05de\u05e9\u05d9\u05de\u05d5\u05ea \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9\u05d5\u05ea \u05d4\u05de\u05e9\u05de\u05e9\u05d5\u05ea \u05d1\u05de\u05d7\u05e7\u05e8\u05d9 fMRI \u05dc\u05d1\u05d7\u05d9\u05e0\u05ea \u05e2\u05d9\u05d1\u05d5\u05d3 \u05e8\u05d2\u05e9\u05d9 \u05d7\u05d1\u05e8\u05ea\u05d9."
    }
  ]
}