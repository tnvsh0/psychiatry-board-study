      "hint": "\u05d1\u05d3\u05e7\u05d5 \u05d0\u05ea \u05de\u05d2\u05d1\u05dc\u05d5\u05ea \u05d4\u05d2\u05d9\u05dc \u05d4\u05de\u05d3\u05d5\u05d9\u05e7\u05d5\u05ea \u05dc\u05d0\u05d9\u05e9\u05d5\u05e8 \u05d4-FDA \u05e2\u05d1\u05d5\u05e8 \u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05d0\u05e0\u05d8\u05d9-\u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9\u05d5\u05ea \u05de\u05d4\u05d3\u05d5\u05e8 \u05d4\u05e9\u05e0\u05d9."
    },
    {
      "question": "\u05de\u05d8\u05d5\u05e4\u05dc \u05d4\u05e0\u05d5\u05d8\u05dc Lithium \u05de\u05d6\u05d4 \u05d7\u05d5\u05d3\u05e9\u05d9\u05d9\u05dd \u05de\u05d2\u05d9\u05e2 \u05dc\u05de\u05d9\u05d5\u05df \u05e2\u05dd \u05d4\u05e7\u05d0\u05d5\u05ea, \u05d3\u05d9\u05d1\u05d5\u05e8 \u05de\u05e9\u05d5\u05d1\u05e9 (Slurred speech) \u05d5\u05d7\u05d5\u05e1\u05e8 \u05e7\u05d5\u05d0\u05d5\u05e8\u05d3\u05d9\u05e0\u05e6\u05d9\u05d4 (Ataxia). \u05de\u05d4\u05d5 \u05d4\u05e6\u05e2\u05d3 \u05d4\u05d1\u05d0 \u05d4\u05d4\u05db\u05e8\u05d7\u05d9 \u05d1\u05e0\u05d9\u05d4\u05d5\u05dc \u05d4\u05de\u05e7\u05e8\u05d4?",
      "answerOptions": [
        {
          "text": "\u05d4\u05e4\u05e1\u05e7\u05ea \u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 \u05d5\u05d1\u05d3\u05d9\u05e7\u05ea \u05e8\u05de\u05ea Lithium \u05d1\u05d3\u05dd",
          "isCorrect": true,
          "rationale": "\u05d3\u05d9\u05d1\u05d5\u05e8 \u05de\u05e9\u05d5\u05d1\u05e9, Ataxia \u05d5\u05d4\u05e7\u05d0\u05d5\u05ea \u05d4\u05dd \u05e1\u05d9\u05de\u05e0\u05d9 \u05e8\u05e2\u05d9\u05dc\u05d5\u05ea Lithium \u05e7\u05dc\u05d0\u05e1\u05d9\u05d9\u05dd \u05d4\u05d3\u05d5\u05e8\u05e9\u05d9\u05dd \u05d4\u05e4\u05e1\u05e7\u05d4 \u05de\u05d9\u05d9\u05d3\u05d9\u05ea \u05d5\u05d1\u05d3\u05d9\u05e7\u05ea \u05e8\u05de\u05d5\u05ea \u05d1\u05d3\u05dd (StahlKids p.285)."
        },
        {
          "text": "\u05d4\u05d5\u05e1\u05e4\u05ea Lorazepam \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Agitation",
          "isCorrect": false,
          "rationale": "\u05de\u05ea\u05df \u05d1\u05e0\u05d6\u05d5\u05d3\u05d9\u05d0\u05d6\u05e4\u05d9\u05e0\u05d9\u05dd \u05e2\u05dc\u05d5\u05dc \u05dc\u05de\u05e1\u05da \u05e1\u05d9\u05de\u05e0\u05d9\u05dd \u05e0\u05d5\u05d9\u05e8\u05d5\u05dc\u05d5\u05d2\u05d9\u05d9\u05dd \u05e9\u05dc \u05e8\u05e2\u05d9\u05dc\u05d5\u05ea \u05d5\u05dc\u05d4\u05d7\u05de\u05d9\u05e8 Ataxia (StahlKids p.285)."
        },
        {
          "text": "\u05d1\u05d3\u05d9\u05e7\u05ea \u05ea\u05e4\u05e7\u05d5\u05d3\u05d9 \u05db\u05d1\u05d3 (LFTs) \u05e2\u05e7\u05d1 \u05d7\u05e9\u05d3 \u05dc\u05e4\u05d2\u05d9\u05e2\u05d4 \u05d4\u05e4\u05d8\u05d9\u05ea",
          "isCorrect": false,
          "rationale": "Lithium \u05de\u05d5\u05e4\u05e8\u05e9 \u05d3\u05e8\u05da \u05d4\u05db\u05dc\u05d9\u05d5\u05ea \u05d5\u05dc\u05d0 \u05d3\u05e8\u05da \u05d4\u05db\u05d1\u05d3, \u05d5\u05dc\u05db\u05df \u05d1\u05d3\u05d9\u05e7\u05ea LFTs \u05d0\u05d9\u05e0\u05d4 \u05e8\u05dc\u05d5\u05d5\u05e0\u05d8\u05d9\u05ea \u05dc\u05d1\u05d9\u05e8\u05d5\u05e8 \u05e8\u05e2\u05d9\u05dc\u05d5\u05ea \u05d6\u05d5 (StahlKids p.287)."
        },
        {
          "text": "\u05d4\u05e2\u05dc\u05d0\u05ea \u05de\u05d9\u05e0\u05d5\u05df \u05d4-Lithium \u05e2\u05e7\u05d1 \u05d7\u05e9\u05d3 \u05dc\u05d4\u05d7\u05de\u05e8\u05d4 \u05d1\u05de\u05e6\u05d1 \u05d4\u05e0\u05e4\u05e9\u05d9",
          "isCorrect": false,
          "rationale": "\u05d4\u05e2\u05dc\u05d0\u05ea \u05de\u05d9\u05e0\u05d5\u05df \u05d1\u05de\u05e6\u05d1 \u05e9\u05dc \u05e8\u05e2\u05d9\u05dc\u05d5\u05ea \u05e0\u05d5\u05d9\u05e8\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea \u05de\u05e1\u05db\u05e0\u05ea \u05d0\u05ea \u05d7\u05d9\u05d9 \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05d5\u05e2\u05dc\u05d5\u05dc\u05d4 \u05dc\u05d4\u05d5\u05d1\u05d9\u05dc \u05dc\u05e4\u05e8\u05db\u05d5\u05e1\u05d9\u05dd \u05d5\u05ea\u05e8\u05d3\u05de\u05ea (StahlKids p.285)."
        }
      ],
      "hint": "\u05d4\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05d4\u05de\u05ea\u05d5\u05d0\u05e8\u05d9\u05dd \u05de\u05e6\u05d1\u05d9\u05e2\u05d9\u05dd \u05e2\u05dc \u05d7\u05e8\u05d9\u05d2\u05d4 \u05de\u05d4\u05d7\u05dc\u05d5\u05df \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc\u05d9 \u05d4\u05e6\u05e8 \u05e9\u05dc \u05d4\u05ea\u05e8\u05d5\u05e4\u05d4."
    },
    {
      "question": "\u05de\u05d8\u05d5\u05e4\u05dc\u05ea \u05d1\u05ea 17 \u05d7\u05d5\u05d5\u05d4 \u05d0\u05e4\u05d9\u05d6\u05d5\u05d3\u05d4 \u05e9\u05dc Major Depressive Episode \u05de\u05d6\u05d4 \u05d7\u05d5\u05d3\u05e9. \u05d1\u05e9\u05d1\u05d5\u05e2 \u05d4\u05d0\u05d7\u05e8\u05d5\u05df, \u05d4\u05d9\u05d0 \u05de\u05d3\u05d5\u05d5\u05d7\u05ea \u05d2\u05dd \u05e2\u05dc \u05de\u05e6\u05d1 \u05e8\u05d5\u05d7 \u05de\u05e8\u05d5\u05de\u05dd, Grandiosity, \u05d5\u05d3\u05d9\u05d1\u05d5\u05e8 \u05de\u05d4\u05d9\u05e8 (Pressured speech) \u05dc\u05d0\u05d5\u05e8\u05da \u05e8\u05d5\u05d1 \u05e9\u05e2\u05d5\u05ea \u05d4\u05d9\u05d5\u05dd. \u05de\u05d4\u05d5 \u05d4-Specifier \u05d4\u05de\u05ea\u05d0\u05d9\u05dd \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR?",
      "answerOptions": [
        {
          "text": "With mixed features",
          "isCorrect": true,
          "rationale": "\u05e7\u05d9\u05d5\u05dd \u05e9\u05dc \u05dc\u05e4\u05d7\u05d5\u05ea 3 \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05de\u05d0\u05e0\u05d9\u05d9\u05dd/\u05d4\u05d9\u05e4\u05d5\u05de\u05d0\u05e0\u05d9\u05d9\u05dd \u05d1\u05de\u05d4\u05dc\u05da \u05e8\u05d5\u05d1 \u05d4\u05d9\u05de\u05d9\u05dd \u05e9\u05dc \u05d0\u05e4\u05d9\u05d6\u05d5\u05d3\u05d4 \u05d3\u05d9\u05db\u05d0\u05d5\u05e0\u05d9\u05ea \u05de\u05dc\u05d0\u05d4 \u05de\u05d2\u05d3\u05d9\u05e8 mixed features (DSM p.171; StahlNeuro p.247)."
        },
        {
          "text": "With rapid cycling",
          "isCorrect": false,
          "rationale": "Rapid cycling \u05de\u05ea\u05d9\u05d9\u05d7\u05e1 \u05dc\u05de\u05e1\u05e4\u05e8 \u05d4\u05d0\u05e4\u05d9\u05d6\u05d5\u05d3\u05d5\u05ea \u05d1\u05e9\u05e0\u05d4 \u05d5\u05dc\u05d0 \u05dc\u05e9\u05d9\u05dc\u05d5\u05d1 \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d1\u05ea\u05d5\u05da \u05d0\u05e4\u05d9\u05d6\u05d5\u05d3\u05d4 \u05d0\u05d7\u05ea (DSM p.171)."
        },
        {
          "text": "With anxious distress",
          "isCorrect": false,
          "rationale": "Specifier \u05d6\u05d4 \u05de\u05ea\u05d9\u05d9\u05d7\u05e1 \u05dc\u05ea\u05e1\u05de\u05d9\u05e0\u05d9 \u05d7\u05e8\u05d3\u05d4 (\u05db\u05de\u05d5 \u05de\u05ea\u05d7 \u05d0\u05d5 \u05e4\u05d7\u05d3 \u05de\u05d0\u05d9\u05d1\u05d5\u05d3 \u05e9\u05dc\u05d9\u05d8\u05d4) \u05d5\u05dc\u05d0 \u05dc\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05de\u05d0\u05e0\u05d9\u05d9\u05dd (DSM p.169)."
        },
        {
          "text": "With psychotic features",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05d4-Grandiosity, \u05dc\u05d0 \u05ea\u05d5\u05d0\u05e8\u05d5 \u05d3\u05dc\u05d5\u05d6\u05d9\u05d5\u05ea \u05d0\u05d5 \u05d4\u05dc\u05d5\u05e6\u05d9\u05e0\u05e6\u05d9\u05d5\u05ea \u05d1\u05de\u05e7\u05e8\u05d4 \u05d6\u05d4 (DSM p.183)."
        }
      ],
      "hint": "\u05d7\u05e4\u05e9\u05d5 \u05d0\u05ea \u05d4\u05de\u05d5\u05e0\u05d7 \u05d4\u05de\u05ea\u05d0\u05e8 \u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05de\u05e9\u05e0\u05d9 \u05d4\u05e7\u05d8\u05d1\u05d9\u05dd \u05d1\u05d5-\u05d6\u05de\u05e0\u05d9\u05ea."
    },
    {
      "question": "\u05d1\u05de\u05e1\u05d2\u05e8\u05ea \u05d1\u05d9\u05e8\u05d5\u05e8 \u05d8\u05e8\u05dd \u05d4\u05ea\u05d7\u05dc\u05ea \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Lithium \u05d1\u05e0\u05e2\u05e8\u05d4 \u05d1\u05ea 14 \u05d4\u05de\u05d0\u05d5\u05d1\u05d7\u05e0\u05ea \u05e2\u05dd Bipolar I Disorder, \u05de\u05d4\u05df \u05d4\u05d1\u05d3\u05d9\u05e7\u05d5\u05ea \u05e9\u05d9\u05e9 \u05dc\u05d1\u05e6\u05e2 \u05db\u05d7\u05dc\u05e7 \u05de\u05d4-Baseline?",
      "answerOptions": [
        {
          "text": "Renal function, Thyroid function, ECG, and Pregnancy test",
          "isCorrect": true,
          "rationale": "\u05d9\u05e9 \u05dc\u05d1\u05d3\u05d5\u05e7 \u05ea\u05e4\u05e7\u05d5\u05d3 \u05db\u05dc\u05d9\u05d9\u05ea\u05d9 (\u05e7\u05e8\u05d9\u05d0\u05d8\u05d9\u05e0\u05d9\u05df), \u05ea\u05e4\u05e7\u05d5\u05d3 \u05d1\u05dc\u05d5\u05d8\u05ea \u05d4\u05ea\u05e8\u05d9\u05e1, ECG (\u05e2\u05e7\u05d1 \u05d4\u05e9\u05e4\u05e2\u05d4 \u05e2\u05dc \u05d4\u05d5\u05dc\u05db\u05d4) \u05d5\u05d1\u05d3\u05d9\u05e7\u05ea \u05d4\u05e8\u05d9\u05d5\u05df \u05d8\u05e8\u05dd \u05ea\u05d7\u05d9\u05dc\u05ea Lithium (StahlKids p.285)."
        },
        {
          "text": "Liver function tests (LFTs) and Prothrombin time (PT)",
          "isCorrect": false,
          "rationale": "\u05d1\u05d3\u05d9\u05e7\u05d5\u05ea \u05d0\u05dc\u05d5 \u05e8\u05dc\u05d5\u05d5\u05e0\u05d8\u05d9\u05d5\u05ea \u05d9\u05d5\u05ea\u05e8 \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Valproate \u05d0\u05da \u05dc\u05d0 \u05dc-Lithium (StahlKids p.481)."
        },
        {
          "text": "Brain CT and Electroencephalogram (EEG)",
          "isCorrect": false,
          "rationale": "\u05d0\u05dc\u05d5 \u05d0\u05d9\u05e0\u05df \u05d1\u05d3\u05d9\u05e7\u05d5\u05ea \u05e9\u05d2\u05e8\u05d4 \u05d8\u05e8\u05dd \u05d4\u05ea\u05d7\u05dc\u05ea \u05de\u05d9\u05d9\u05e6\u05d1\u05d9 \u05de\u05e6\u05d1 \u05e8\u05d5\u05d7 \u05d0\u05dc\u05d0 \u05d0\u05dd \u05d9\u05e9 \u05d0\u05d9\u05e0\u05d3\u05d9\u05e7\u05e6\u05d9\u05d4 \u05e0\u05d5\u05d9\u05e8\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05ea (Dulcan p.684)."
        },
        {
          "text": "Lipid profile and Fasting glucose only",
          "isCorrect": false,
          "rationale": "\u05d1\u05d3\u05d9\u05e7\u05d5\u05ea \u05d0\u05dc\u05d5 \u05e7\u05e8\u05d9\u05d8\u05d9\u05d5\u05ea \u05dc\u05e0\u05d9\u05d8\u05d5\u05e8 \u05ea\u05d5\u05e4\u05e2\u05d5\u05ea \u05de\u05d8\u05d1\u05d5\u05dc\u05d9\u05d5\u05ea \u05e9\u05dc \u05d0\u05e0\u05d8\u05d9-\u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9\u05d9\u05dd, \u05d0\u05da \u05d0\u05d9\u05e0\u05df \u05de\u05de\u05e6\u05d5\u05ea \u05e2\u05d1\u05d5\u05e8 Lithium (StahlKids p.285)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d1\u05d5 \u05e2\u05dc \u05d4\u05d0\u05d9\u05d1\u05e8\u05d9\u05dd \u05d4\u05e2\u05d9\u05e7\u05e8\u05d9\u05d9\u05dd \u05e9\u05e2\u05dc\u05d5\u05dc\u05d9\u05dd \u05dc\u05d4\u05d9\u05e4\u05d2\u05e2 \u05de\u05e9\u05d9\u05de\u05d5\u05e9 \u05db\u05e8\u05d5\u05e0\u05d9 \u05d1-Lithium \u05d5\u05e2\u05dc \u05d4\u05e1\u05d9\u05db\u05d5\u05e0\u05d9\u05dd \u05d4\u05d8\u05e8\u05d8\u05d5\u05d2\u05e0\u05d9\u05d9\u05dd."
    },
    {
      "question": "\u05e0\u05e2\u05e8\u05d4 \u05d1\u05ea 16 \u05e2\u05dd Bipolar I Disorder \u05d7\u05d5\u05d5\u05ea\u05d4 \u05d1\u05e9\u05e0\u05d4 \u05d4\u05d0\u05d7\u05e8\u05d5\u05e0\u05d4 \u05e9\u05ea\u05d9 \u05d0\u05e4\u05d9\u05d6\u05d5\u05d3\u05d5\u05ea \u05de\u05d0\u05e0\u05d9\u05d5\u05ea \u05de\u05dc\u05d0\u05d5\u05ea \u05d5\u05e9\u05ea\u05d9 \u05d0\u05e4\u05d9\u05d6\u05d5\u05d3\u05d5\u05ea \u05d3\u05d9\u05db\u05d0\u05d5\u05e0\u05d9\u05d5\u05ea, \u05db\u05d0\u05e9\u05e8 \u05d1\u05d9\u05df \u05d4\u05d0\u05e4\u05d9\u05d6\u05d5\u05d3\u05d5\u05ea \u05d4\u05d9\u05d5 \u05ea\u05e7\u05d5\u05e4\u05d5\u05ea \u05e9\u05dc Remission \u05de\u05dc\u05d0 \u05e9\u05e0\u05de\u05e9\u05db\u05d5 \u05d7\u05d5\u05d3\u05e9\u05d9\u05d9\u05dd. \u05de\u05d4\u05d9 \u05d4\u05d4\u05d2\u05d3\u05e8\u05d4 \u05d4\u05de\u05d3\u05d5\u05d9\u05e7\u05ea \u05dc\u05de\u05d4\u05dc\u05da \u05d6\u05d4?",
      "answerOptions": [
        {
          "text": "Rapid cycling",
          "isCorrect": true,
          "rationale": "\u05d4\u05d2\u05d3\u05e8\u05ea rapid cycling \u05d3\u05d5\u05e8\u05e9\u05ea \u05dc\u05e4\u05d7\u05d5\u05ea 4 \u05d0\u05e4\u05d9\u05d6\u05d5\u05d3\u05d5\u05ea \u05e9\u05dc \u05de\u05e6\u05d1 \u05e8\u05d5\u05d7 (\u05de\u05d0\u05e0\u05d9\u05d4, \u05d4\u05d9\u05e4\u05d5\u05de\u05d0\u05e0\u05d9\u05d4 \u05d0\u05d5 \u05d3\u05d9\u05db\u05d0\u05d5\u05df) \u05d1\u05ea\u05d5\u05da \u05ea\u05e7\u05d5\u05e4\u05d4 \u05e9\u05dc 12 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd (DSM p.171; StahlKids p.295)."
        },
        {
          "text": "Cyclothymic disorder",
          "isCorrect": false,
          "rationale": "\u05d1\u05e6\u05d9\u05e7\u05dc\u05d5\u05ea\u05d9\u05de\u05d9\u05d4 \u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05dc\u05d0\u05e4\u05d9\u05d6\u05d5\u05d3\u05d4 \u05de\u05dc\u05d0\u05d4 \u05e9\u05dc \u05de\u05d0\u05e0\u05d9\u05d4 \u05d0\u05d5 \u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05de\u05e2\u05d5\u05dc\u05dd \u05dc\u05d0 \u05d4\u05ea\u05de\u05dc\u05d0\u05d5 (DSM p.161)."
        },
        {
          "text": "Bipolar II disorder",
          "isCorrect": false,
