    {
      "type": "multiple_choice",
      "question": "\u05dc\u05e4\u05d9 \u05d4-Dulcan, \u05de\u05d4\u05d5 \u05e9\u05d9\u05e2\u05d5\u05e8 \u05d4\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d4\u05de\u05e9\u05d5\u05e2\u05e8 \u05e9\u05dc ADHD \u05d1\u05e7\u05e8\u05d1 \u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd \u05d4\u05e4\u05d5\u05e0\u05d9\u05dd \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Substance Use Disorders (SUD)?",
      "answerOptions": [
        {
          "text": "28%",
          "isCorrect": true,
          "rationale": "\u05de\u05d7\u05e7\u05e8\u05d9\u05dd \u05de\u05e6\u05d1\u05d9\u05e2\u05d9\u05dd \u05e2\u05dc \u05db\u05da \u05e9-ADHD \u05de\u05d9\u05d5\u05e6\u05d2\u05ea \u05d1\u05d9\u05ea\u05e8 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9 \u05d1\u05d0\u05d5\u05db\u05dc\u05d5\u05e1\u05d9\u05d9\u05ea \u05d4\u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd \u05d1-SUD, \u05d1\u05e9\u05d9\u05e2\u05d5\u05e8 \u05e9\u05dc \u05db-28% \u05dc\u05e2\u05d5\u05de\u05ea \u05db-5-12% \u05d1\u05d0\u05d5\u05db\u05dc\u05d5\u05e1\u05d9\u05d9\u05d4 \u05d4\u05db\u05dc\u05dc\u05d9\u05ea (Dulcan p.226)."
        },
        {
          "text": "50%",
          "isCorrect": false,
          "rationale": "\u05d6\u05d4\u05d5 \u05e9\u05d9\u05e2\u05d5\u05e8 \u05d4\u05d9\u05dc\u05d3\u05d9\u05dd \u05d1\u05de\u05e1\u05d2\u05e8\u05d5\u05ea \u05d0\u05d5\u05de\u05e0\u05d4 (foster care) \u05e9\u05de\u05d5\u05e2\u05e8\u05db\u05d9\u05dd \u05db\u05d1\u05e2\u05dc\u05d9 \u05d0\u05d1\u05d7\u05e0\u05d4 \u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9\u05ea, \u05dc\u05d0 \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05ea ADHD \u05d1-SUD (StahlKids p.30)."
        },
        {
          "text": "9.4%",
          "isCorrect": false,
          "rationale": "\u05d6\u05d4\u05d5 \u05d0\u05d5\u05de\u05d3\u05df \u05d4-lifetime prevalence \u05e9\u05dc ADHD \u05d1\u05e7\u05e8\u05d1 \u05d9\u05dc\u05d3\u05d9\u05dd \u05d5\u05e0\u05d5\u05e2\u05e8 \u05d1\u05d0\u05e8\u05d4\"\u05d1 \u05dc\u05e4\u05d9 \u05e1\u05e7\u05e8\u05d9 \u05d4\u05d5\u05e8\u05d9\u05dd, \u05dc\u05d0 \u05d1\u05e7\u05e8\u05d1 \u05e4\u05d5\u05e0\u05d9\u05dd \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc SUD (Dulcan p.212)."
        },
        {
          "text": "11.7%",
          "isCorrect": false,
          "rationale": "\u05d6\u05d4\u05d5 \u05e9\u05d9\u05e2\u05d5\u05e8 \u05d4\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d4\u05db\u05dc\u05dc\u05d9 \u05e9\u05dc SUD \u05d1\u05e7\u05e8\u05d1 \u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd \u05dc\u05e4\u05d9 \u05d4-National Comorbidity Survey, \u05dc\u05d0 \u05e9\u05d9\u05e2\u05d5\u05e8 \u05d4\u05e7\u05d5\u05de\u05d5\u05e8\u05d1\u05d9\u05d3\u05d9\u05d5\u05ea \u05e2\u05dd ADHD (Dulcan p.225)."
        }
      ],
      "hint": "\u05de\u05d3\u05d5\u05d1\u05e8 \u05d1\u05e9\u05d9\u05e2\u05d5\u05e8 \u05e9\u05d4\u05d5\u05d0 \u05d1\u05e2\u05e8\u05da \u05e4\u05d9 2 \u05e2\u05d3 5 \u05de\u05d4\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d1\u05d0\u05d5\u05db\u05dc\u05d5\u05e1\u05d9\u05d9\u05d4 \u05d4\u05db\u05dc\u05dc\u05d9\u05ea."
    },
    {
      "type": "short_answer",
      "question": "\u05d4\u05e1\u05d1\u05e8 \u05d0\u05ea \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05e0\u05d5\u05d9\u05e8\u05d5\u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05e9\u05dc \u05ea\u05d5\u05e4\u05e2\u05ea \u05d4-'Burn-out' \u05d1\u05e9\u05d9\u05de\u05d5\u05e9 \u05db\u05e8\u05d5\u05e0\u05d9 \u05d1\u05e1\u05d8\u05d9\u05de\u05d5\u05dc\u05e0\u05d8\u05d9\u05dd \u05dc\u05e4\u05d9 StahlNeuro.",
      "grading": {
        "modelAnswer": "\u05d1\u05e9\u05d9\u05de\u05d5\u05e9 \u05db\u05e8\u05d5\u05e0\u05d9, \u05d7\u05dc\u05d4 \u05d9\u05e8\u05d9\u05d3\u05d4 \u05d1-phasic Dopamine firing \u05d5\u05de\u05e2\u05d1\u05e8 \u05dc-tonic firing \u05e0\u05de\u05d5\u05da, \u05de\u05d4 \u05e9\u05de\u05d5\u05d1\u05d9\u05dc \u05dc\u05d0\u05e0\u05d4\u05d3\u05d5\u05e0\u05d9\u05d4 \u05d5\u05dc\u05d9\u05e8\u05d9\u05d3\u05d4 \u05d1\u05d9\u05db\u05d5\u05dc\u05ea \u05dc\u05d7\u05d5\u05d5\u05ea \u05d4\u05e0\u05d0\u05d4. \u05d1\u05e9\u05dc\u05d1\u05d9\u05dd \u05de\u05ea\u05e7\u05d3\u05de\u05d9\u05dd ('burn-out'), \u05d9\u05d9\u05ea\u05db\u05e0\u05d5 \u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd \u05d1\u05dc\u05ea\u05d9 \u05d4\u05e4\u05d9\u05db\u05d9\u05dd \u05d1\u05d8\u05e8\u05de\u05d9\u05e0\u05dc\u05d9\u05dd \u05d4\u05d3\u05d5\u05e4\u05de\u05d9\u05e0\u05e8\u05d2\u05d9\u05d9\u05dd \u05d4\u05db\u05d5\u05dc\u05dc\u05d9\u05dd axonal degeneration \u05d5\u05e8\u05d9\u05e7\u05d5\u05df \u05de\u05d0\u05d2\u05e8\u05d9 \u05d4-Dopamine (StahlNeuro p.546).",
        "rationale": "\u05d4\u05d4\u05e1\u05d1\u05e8 \u05de\u05d3\u05d2\u05d9\u05e9 \u05d0\u05ea \u05d4\u05de\u05e2\u05d1\u05e8 \u05de\u05d9\u05e8\u05d9 \u05d3\u05d5\u05e4\u05de\u05d9\u05e0\u05e8\u05d2\u05d9 \u05e4\u05d0\u05d6\u05d9 \u05dc\u05ea\u05d5\u05e4\u05e2\u05d5\u05ea \u05e0\u05d9\u05d5\u05d5\u05e0\u05d9\u05d5\u05ea \u05e7\u05d1\u05d5\u05e2\u05d5\u05ea \u05d1\u05e1\u05d9\u05e0\u05e4\u05e1\u05d4.",
        "requiredAttributes": [
          "\u05e6\u05d9\u05d5\u05df \u05d4\u05d9\u05e8\u05d9\u05d3\u05d4 \u05d1-phasic Dopamine firing.",
          "\u05d0\u05d6\u05db\u05d5\u05e8 \u05e9\u05dc axonal degeneration \u05d0\u05d5 \u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd \u05d1\u05dc\u05ea\u05d9 \u05d4\u05e4\u05d9\u05db\u05d9\u05dd \u05d1\u05d8\u05e8\u05de\u05d9\u05e0\u05dc\u05d9\u05dd.",
          "\u05e7\u05d9\u05e9\u05d5\u05e8 \u05dc\u05de\u05e6\u05d1 \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9 \u05e9\u05dc \u05d0\u05e0\u05d4\u05d3\u05d5\u05e0\u05d9\u05d4 \u05d0\u05d5 \u05d4\u05d9\u05e2\u05d3\u05e8 \u05d9\u05db\u05d5\u05dc\u05ea \u05dc\u05d7\u05d5\u05d5\u05ea \u05d4\u05e0\u05d0\u05d4."
        ],
        "errors": {
          "misconceptions": [
            "\u05d8\u05e2\u05d5\u05ea \u05dc\u05d7\u05e9\u05d5\u05d1 \u05e9-'burn-out' \u05d4\u05d5\u05d0 \u05de\u05e6\u05d1 \u05d6\u05de\u05e0\u05d9 \u05e9\u05d7\u05d5\u05dc\u05e3 \u05ea\u05d5\u05da \u05de\u05e1\u05e4\u05e8 \u05d9\u05de\u05d9\u05dd \u05e9\u05dc \u05d2\u05de\u05d9\u05dc\u05d4."
          ],
          "bluffs": [
            "\u05d0\u05de\u05d9\u05e8\u05d4 \u05db\u05dc\u05dc\u05d9\u05ea \u05e9\u05d4\u05de\u05d5\u05d7 \u05e4\u05e9\u05d5\u05d8 \u05de\u05ea\u05e2\u05d9\u05d9\u05e3 \u05d1\u05dc\u05d9 \u05dc\u05d4\u05e1\u05d1\u05d9\u05e8 \u05d0\u05ea \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05d3\u05d5\u05e4\u05de\u05d9\u05e0\u05e8\u05d2\u05d9."
          ]
        }
      },
      "hint": "\u05d4\u05ea\u05de\u05e7\u05d3 \u05d1\u05d4\u05d1\u05d3\u05dc \u05d1\u05d9\u05df \u05d9\u05e8\u05d9 (firing) \u05e4\u05d0\u05d6\u05d9 \u05dc\u05d8\u05d5\u05e0\u05d9 \u05d5\u05d1\u05d4\u05e9\u05e4\u05e2\u05d4 \u05e2\u05dc \u05d4\u05d8\u05e8\u05de\u05d9\u05e0\u05dc\u05d9\u05dd \u05d4\u05e2\u05e6\u05d1\u05d9\u05d9\u05dd."
    },
    {
      "type": "multiple_choice",
      "question": "\u05de\u05ea\u05d1\u05d2\u05e8 \u05e2\u05dd \u05d0\u05d1\u05d7\u05e0\u05d4 \u05db\u05e4\u05d5\u05dc\u05d4 \u05e9\u05dc Stimulant Use Disorder \u05d5-ADHD \u05e4\u05d5\u05e0\u05d4 \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc. \u05de\u05d4\u05d9 \u05d4\u05d0\u05e1\u05d8\u05e8\u05d8\u05d2\u05d9\u05d4 \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc\u05d9\u05ea \u05d4\u05de\u05d5\u05de\u05dc\u05e6\u05ea \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05e4\u05d9 \u05d4-Dulcan \u05d5\u05d4\u05de\u05e7\u05d5\u05e8\u05d5\u05ea \u05d4\u05e0\u05dc\u05d5\u05d5\u05d9\u05dd?",
      "answerOptions": [
        {
          "text": "\u05e9\u05d9\u05dc\u05d5\u05d1 \u05e9\u05dc CBT, Contingency Management \u05d5\u05d8\u05d9\u05e4\u05d5\u05dc \u05e4\u05e8\u05de\u05e7\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d1-ADHD",
          "isCorrect": true,
          "rationale": "\u05d8\u05d9\u05e4\u05d5\u05dc\u05d9\u05dd \u05e4\u05e1\u05d9\u05db\u05d5\u05e1\u05d5\u05e6\u05d9\u05d0\u05dc\u05d9\u05d9\u05dd (CBT \u05d5-CM) \u05d4\u05dd \u05e7\u05d5 \u05e8\u05d0\u05e9\u05d5\u05df \u05dc-SUD, \u05d5\u05d1\u05de\u05e7\u05e8\u05d9\u05dd \u05e9\u05dc \u05e7\u05d5\u05de\u05d5\u05e8\u05d1\u05d9\u05d3\u05d9\u05d5\u05ea \u05e2\u05dd ADHD, \u05d8\u05d9\u05e4\u05d5\u05dc \u05ea\u05e8\u05d5\u05e4\u05ea\u05d9 \u05d1-ADHD \u05e2\u05e9\u05d5\u05d9 \u05dc\u05e9\u05e4\u05e8 \u05d0\u05ea \u05d4\u05ea\u05e4\u05e7\u05d5\u05d3 \u05d4\u05db\u05dc\u05dc\u05d9 (Dulcan p.232, StahlKids p.279)."
        },
        {
          "text": "\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-FDA-approved medications \u05dc-Stimulant Use Disorder \u05d1\u05dc\u05d1\u05d3",
          "isCorrect": false,
          "rationale": "\u05e0\u05db\u05d5\u05df \u05dc\u05d4\u05d9\u05d5\u05dd, \u05d0\u05d9\u05df \u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05de\u05d0\u05d5\u05e9\u05e8\u05d5\u05ea \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d4-FDA \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05ea \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Stimulant Use Disorder (\u05de\u05e7\u05d5\u05e8: \u05d4\u05e7\u05e9\u05e8 \u05e8\u05d7\u05d1/Dulcan p.232)."
        },
        {
          "text": "\u05d4\u05e4\u05e1\u05e7\u05d4 \u05de\u05d9\u05d9\u05d3\u05d9\u05ea \u05e9\u05dc \u05db\u05dc \u05d8\u05d9\u05e4\u05d5\u05dc \u05de\u05de\u05e8\u05d9\u05e5 (Stimulants) \u05d1\u05e9\u05dc \u05e1\u05db\u05e0\u05ea \u05d4-Addiction",
          "isCorrect": false,
          "rationale": "\u05dc\u05e4\u05d9 StahlKids, \u05d8\u05d9\u05e4\u05d5\u05dc \u05e0\u05db\u05d5\u05df \u05d1-Stimulants \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd ADHD \u05d0\u05d9\u05e0\u05d5 \u05de\u05e2\u05dc\u05d4 \u05d0\u05ea \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05dc-SUD, \u05d5\u05d1\u05de\u05e7\u05e8\u05d9\u05dd \u05e9\u05dc \u05d0\u05d1\u05d7\u05e0\u05d4 \u05db\u05e4\u05d5\u05dc\u05d4 \u05d9\u05e9 \u05dc\u05e9\u05e7\u05d5\u05dc \u05d0\u05ea \u05d4\u05d9\u05ea\u05e8\u05d5\u05e0\u05d5\u05ea \u05e9\u05dc \u05d0\u05d9\u05d6\u05d5\u05df \u05d4-ADHD (StahlKids p.279)."
        },
        {
          "text": "\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-SSRI \u05d1\u05dc\u05d1\u05d3 \u05dc\u05e9\u05d9\u05e4\u05d5\u05e8 \u05de\u05e6\u05d1 \u05d4\u05e8\u05d5\u05d7 \u05d4\u05d3\u05d9\u05e1\u05e4\u05d5\u05e8\u05d9",
          "isCorrect": false,
          "rationale": "\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-SSRI \u05e2\u05e9\u05d5\u05d9 \u05dc\u05e2\u05d6\u05d5\u05e8 \u05dc\u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05e7\u05d5\u05de\u05d5\u05e8\u05d1\u05d9\u05d3\u05d9 \u05d0\u05da \u05d0\u05d9\u05e0\u05d5 \u05de\u05d4\u05d5\u05d5\u05d4 \u05de\u05e2\u05e0\u05d4 \u05dc\u05dc\u05d9\u05d1\u05ea \u05d4\u05d1\u05e2\u05d9\u05d4 \u05e9\u05dc SUD \u05d0\u05d5 ADHD (Dulcan p.232)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05e9\u05d9\u05dc\u05d5\u05d1 \u05e9\u05dc \u05d2\u05d9\u05e9\u05d5\u05ea \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea\u05d9\u05d5\u05ea \u05de\u05d1\u05d5\u05e1\u05e1\u05d5\u05ea \u05e8\u05d0\u05d9\u05d5\u05ea \u05d9\u05d7\u05d3 \u05e2\u05dd \u05d4\u05ea\u05d9\u05d9\u05d7\u05e1\u05d5\u05ea \u05dc\u05d4\u05e4\u05e8\u05e2\u05d4 \u05d4\u05d1\u05e1\u05d9\u05e1\u05d9\u05ea."
    },
    {
      "type": "fill_in_the_blank",
      "question": "\u05dc\u05e4\u05d9 \u05d4-DSM-5-TR, \u05e1\u05d9\u05de\u05df \u05e7\u05dc\u05d9\u05e0\u05d9 \u05d9\u05d9\u05d7\u05d5\u05d3\u05d9 \u05e9\u05e2\u05e9\u05d5\u05d9 \u05dc\u05e1\u05d9\u05d9\u05e2 \u05d1\u05d0\u05d1\u05d7\u05e0\u05d4 \u05de\u05d1\u05d3\u05dc\u05ea \u05d1\u05d9\u05df \u05d4\u05e8\u05e2\u05dc\u05ea Phencyclidine (PCP) \u05dc\u05d1\u05d9\u05df \u05d4\u05e8\u05e2\u05dc\u05ea \u05e1\u05d8\u05d9\u05de\u05d5\u05dc\u05e0\u05d8\u05d9\u05dd \u05d4\u05d5\u05d0 ___.",
