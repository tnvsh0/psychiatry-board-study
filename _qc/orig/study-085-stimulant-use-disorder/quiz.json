        "vertical nystagmus"
      ],
      "rationale": "\u05d1\u05e2\u05d5\u05d3 \u05e9\u05e9\u05e0\u05d9 \u05d4\u05d7\u05d5\u05de\u05e8\u05d9\u05dd \u05d9\u05db\u05d5\u05dc\u05d9\u05dd \u05dc\u05d2\u05e8\u05d5\u05dd \u05dc\u05d0\u05d2\u05d9\u05d8\u05e6\u05d9\u05d4 \u05d5\u05e1\u05d9\u05de\u05e0\u05d9\u05dd \u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05de\u05d8\u05d9\u05d9\u05dd, nystagmus (\u05d5\u05d1\u05de\u05d9\u05d5\u05d7\u05d3 \u05d0\u05e0\u05db\u05d9) \u05d4\u05d5\u05d0 \u05e1\u05d9\u05de\u05df \u05e7\u05dc\u05d0\u05e1\u05d9 \u05e9\u05dc PCP \u05d5\u05d0\u05d9\u05e0\u05d5 \u05de\u05d5\u05e4\u05d9\u05e2 \u05d1\u05d3\u05e8\u05da \u05db\u05dc\u05dc \u05d1\u05e1\u05d8\u05d9\u05de\u05d5\u05dc\u05e0\u05d8\u05d9\u05dd (DSM p.595, p.640, StahlNeuro p.568).",
      "hint": "\u05d6\u05d4\u05d5 \u05e1\u05d9\u05de\u05df \u05e0\u05d5\u05d9\u05e8\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d4\u05e7\u05e9\u05d5\u05e8 \u05dc\u05ea\u05e0\u05d5\u05e2\u05d5\u05ea \u05e2\u05d9\u05e0\u05d9\u05d9\u05dd \u05dc\u05d0 \u05e8\u05e6\u05d5\u05e0\u05d9\u05d5\u05ea."
    },
    {
      "type": "multiple_choice",
      "question": "\u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05e2\u05e8\u05db\u05d4 \u05e9\u05dc \u05e0\u05e2\u05e8 \u05d1\u05e1\u05d9\u05db\u05d5\u05df, \u05d4\u05de\u05d8\u05e4\u05dc \u05d7\u05d5\u05e9\u05d3 \u05d1\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1-Inhalants. \u05d0\u05d9\u05d6\u05d4 \u05de\u05de\u05e6\u05d0 \u05d1\u05d1\u05d3\u05d9\u05e7\u05d4 \u05d4\u05d2\u05d5\u05e4\u05e0\u05d9\u05ea \u05e2\u05e9\u05d5\u05d9 \u05dc\u05ea\u05de\u05d5\u05da \u05d1\u05d0\u05d1\u05d7\u05e0\u05d4 \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05ea \u05d6\u05d5 \u05d5\u05dc\u05d1\u05d3\u05dc\u05d4 \u05de\u05e1\u05d8\u05d9\u05de\u05d5\u05dc\u05e0\u05d8\u05d9\u05dd?",
      "answerOptions": [
        {
          "text": "\u05e4\u05e8\u05d9\u05d7\u05d4 \u05e1\u05d1\u05d9\u05d1 \u05d4\u05e4\u05d4 \u05d0\u05d5 \u05d4\u05d0\u05e3 ('Glue-sniffer's rash')",
          "isCorrect": true,
          "rationale": "\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1-Inhalants (\u05db\u05de\u05d5 \u05d3\u05d1\u05e7 \u05d0\u05d5 \u05e6\u05d1\u05e2) \u05d2\u05d5\u05e8\u05dd \u05dc\u05e2\u05d9\u05ea\u05d9\u05dd \u05e7\u05e8\u05d5\u05d1\u05d5\u05ea \u05dc\u05d2\u05d9\u05e8\u05d5\u05d9 \u05e2\u05d5\u05e8\u05d9 \u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05d9 \u05e1\u05d1\u05d9\u05d1 \u05d0\u05d6\u05d5\u05e8\u05d9 \u05d4\u05e9\u05d0\u05d9\u05e4\u05d4 (DSM p.607, p.712)."
        },
        {
          "text": "\u05e1\u05d9\u05de\u05e0\u05d9 \u05d3\u05e7\u05d9\u05e8\u05d4 (Track marks) \u05d1\u05d0\u05d6\u05d5\u05e8 \u05d4\u05de\u05e8\u05e4\u05e7",
          "isCorrect": false,
          "rationale": "\u05de\u05de\u05e6\u05d0 \u05d6\u05d4 \u05de\u05e2\u05d9\u05d3 \u05e2\u05dc \u05e9\u05d9\u05de\u05d5\u05e9 \u05ea\u05d5\u05da-\u05d5\u05e8\u05d9\u05d3\u05d9 (\u05db\u05de\u05d5 Cocaine \u05d0\u05d5 Opioids) \u05d5\u05d0\u05d9\u05e0\u05d5 \u05de\u05d0\u05e4\u05d9\u05d9\u05df Inhalants (DSM p.637)."
        },
        {
          "text": "\u05e9\u05d7\u05d9\u05e7\u05ea \u05e9\u05d9\u05e0\u05d9\u05d9\u05dd \u05d7\u05de\u05d5\u05e8\u05d4 ('Meth mouth')",
          "isCorrect": false,
          "rationale": "\u05d6\u05d4\u05d5 \u05e1\u05d9\u05de\u05df \u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05d9 \u05dc\u05e9\u05d9\u05de\u05d5\u05e9 \u05db\u05e8\u05d5\u05e0\u05d9 \u05d1-Methamphetamine \u05d5\u05dc\u05d0 \u05d1-Inhalants (DSM p.639)."
        },
        {
          "text": "\u05d9\u05e8\u05d9\u05d3\u05d4 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05d1\u05de\u05e9\u05e7\u05dc (Wasting)",
          "isCorrect": false,
          "rationale": "\u05d9\u05e8\u05d9\u05d3\u05d4 \u05d1\u05de\u05e9\u05e7\u05dc \u05e0\u05e4\u05d5\u05e6\u05d4 \u05de\u05d0\u05d5\u05d3 \u05d1\u05e9\u05d9\u05de\u05d5\u05e9 \u05db\u05e8\u05d5\u05e0\u05d9 \u05d1\u05e1\u05d8\u05d9\u05de\u05d5\u05dc\u05e0\u05d8\u05d9\u05dd \u05d1\u05e9\u05dc \u05d3\u05d9\u05db\u05d5\u05d9 \u05ea\u05d9\u05d0\u05d1\u05d5\u05df, \u05d1\u05e2\u05d5\u05d3 \u05e9-Inhalants \u05d0\u05d9\u05e0\u05dd \u05d2\u05d5\u05e8\u05de\u05d9\u05dd \u05dc\u05db\u05da \u05d1\u05d0\u05d5\u05e4\u05df \u05d9\u05e9\u05d9\u05e8 (DSM p.641)."
        }
      ],
      "hint": "\u05d7\u05e4\u05e9 \u05e1\u05d9\u05de\u05df \u05d7\u05d9\u05e6\u05d5\u05e0\u05d9 \u05d4\u05e7\u05e9\u05d5\u05e8 \u05dc\u05d3\u05e8\u05da \u05d4\u05de\u05ea\u05df \u05d4\u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05d9\u05ea \u05e9\u05dc \u05d4\u05d7\u05d5\u05de\u05e8."
    },
    {
      "type": "multiple_choice",
      "question": "\u05dc\u05e4\u05d9 \u05d4-StahlKids, \u05de\u05d4\u05d9 \u05d4\u05d4\u05de\u05dc\u05e6\u05d4 \u05dc\u05d2\u05d1\u05d9 \u05de\u05ea\u05df Stimulants \u05dc\u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd \u05e2\u05dd \u05d7\u05e9\u05d3 \u05dc-feigning (\u05d6\u05d9\u05d5\u05e3 \u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd) \u05e9\u05dc ADHD \u05d1\u05de\u05d8\u05e8\u05d4 \u05dc\u05d4\u05e9\u05d9\u05d2 \u05ea\u05e8\u05d5\u05e4\u05d5\u05ea?",
      "answerOptions": [
        {
          "text": "\u05d4\u05e4\u05e0\u05d9\u05d4 \u05dc\u05de\u05d1\u05d7\u05e0\u05d9\u05dd \u05e0\u05d5\u05d9\u05e8\u05d5-\u05e4\u05e1\u05d9\u05db\u05d5\u05dc\u05d5\u05d2\u05d9\u05d9\u05dd \u05d0\u05d5\u05d1\u05d9\u05d9\u05e7\u05d8\u05d9\u05d1\u05d9\u05d9\u05dd \u05d5\u05de\u05ea\u05df \u05d6\u05d4\u05d9\u05e8 \u05e9\u05dc \u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05d0\u05e8\u05d5\u05db\u05d5\u05ea-\u05d8\u05d5\u05d5\u05d7",
          "isCorrect": true,
          "rationale": "\u05d1\u05e9\u05dc \u05e1\u05db\u05e0\u05ea \u05d4-diversion (\u05d4\u05e1\u05d8\u05d4 \u05e9\u05dc \u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 \u05dc\u05de\u05db\u05d9\u05e8\u05d4 \u05d0\u05d5 \u05e9\u05d9\u05de\u05d5\u05e9 \u05dc\u05e8\u05e2\u05d4), \u05d9\u05e9 \u05dc\u05d0\u05de\u05ea \u05d0\u05ea \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d1\u05db\u05dc\u05d9\u05dd \u05d0\u05d5\u05d1\u05d9\u05d9\u05e7\u05d8\u05d9\u05d1\u05d9\u05d9\u05dd \u05d5\u05dc\u05d4\u05e2\u05d3\u05d9\u05e3 \u05ea\u05db\u05e9\u05d9\u05e8\u05d9\u05dd \u05e2\u05dd \u05e4\u05d5\u05d8\u05e0\u05e6\u05d9\u05d0\u05dc abuse \u05e0\u05de\u05d5\u05da \u05d9\u05d5\u05ea\u05e8 (StahlKids p.279)."
        },
        {
          "text": "\u05de\u05ea\u05df \u05de\u05d9\u05d9\u05d3\u05d9 \u05e9\u05dc Immediate-release stimulants \u05dc\u05e0\u05d9\u05e1\u05d9\u05d5\u05df \u05d8\u05d9\u05e4\u05d5\u05dc\u05d9",
          "isCorrect": false,
          "rationale": "\u05ea\u05db\u05e9\u05d9\u05e8\u05d9\u05dd \u05e7\u05e6\u05e8\u05d9 \u05d8\u05d5\u05d5\u05d7 (Immediate-release) \u05e7\u05dc\u05d9\u05dd \u05d9\u05d5\u05ea\u05e8 \u05dc\u05e9\u05d9\u05de\u05d5\u05e9 \u05dc\u05e8\u05e2\u05d4 \u05d5\u05dc\u05de\u05db\u05d9\u05e8\u05d4, \u05d5\u05dc\u05db\u05df \u05d0\u05d9\u05e0\u05dd \u05de\u05d5\u05de\u05dc\u05e6\u05d9\u05dd \u05db\u05e9\u05d9\u05e9 \u05d7\u05e9\u05d3 \u05dc\u05d6\u05d9\u05d5\u05e3 (StahlKids p.279)."
        },
        {
          "text": "\u05e1\u05d9\u05e8\u05d5\u05d1 \u05d2\u05d5\u05e8\u05e3 \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05ea\u05e8\u05d5\u05e4\u05ea\u05d9 \u05d1\u05e9\u05dc \u05d4\u05d7\u05e9\u05d3",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05d4\u05d7\u05e9\u05d3, \u05d0\u05dd \u05e7\u05d9\u05d9\u05de\u05ea \u05d4\u05e4\u05e8\u05e2\u05d4 \u05d1\u05d1\u05e1\u05d9\u05e1, \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05d6\u05db\u05d0\u05d9 \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc; \u05d4\u05e4\u05ea\u05e8\u05d5\u05df \u05d4\u05d5\u05d0 \u05d4\u05e2\u05e8\u05db\u05d4 \u05de\u05e2\u05de\u05d9\u05e7\u05d4 \u05d9\u05d5\u05ea\u05e8 \u05d5\u05dc\u05d0 \u05de\u05e0\u05d9\u05e2\u05d4 \u05d2\u05d5\u05e8\u05e4\u05ea (StahlKids p.279)."
        },
        {
          "text": "\u05de\u05ea\u05df \u05de\u05e8\u05e9\u05dd \u05dc\u05db\u05de\u05d5\u05ea \u05d2\u05d3\u05d5\u05dc\u05d4 \u05db\u05d3\u05d9 \u05dc\u05de\u05e0\u05d5\u05e2 \u05d1\u05d9\u05e7\u05d5\u05e8\u05d9\u05dd \u05d7\u05d5\u05d6\u05e8\u05d9\u05dd",
          "isCorrect": false,
          "rationale": "\u05d9\u05e9 \u05dc\u05e8\u05e9\u05d5\u05dd \u05db\u05de\u05d5\u05d9\u05d5\u05ea \u05e7\u05d8\u05e0\u05d5\u05ea \u05d5\u05de\u05ea\u05d5\u05e2\u05d3\u05d5\u05ea \u05d4\u05d9\u05d8\u05d1 \u05db\u05d3\u05d9 \u05dc\u05e6\u05de\u05e6\u05dd \u05d0\u05ea \u05d4\u05d0\u05e4\u05e9\u05e8\u05d5\u05ea \u05dc\u05e9\u05d9\u05de\u05d5\u05e9 \u05dc\u05d0 \u05d8\u05d9\u05e4\u05d5\u05dc\u05d9 (StahlKids p.279)."
        }
      ],
      "hint": "\u05d4\u05de\u05d8\u05e8\u05d4 \u05d4\u05d9\u05d0 \u05dc\u05d0\u05d6\u05df \u05d1\u05d9\u05df \u05e6\u05d5\u05e8\u05da \u05e7\u05dc\u05d9\u05e0\u05d9 \u05dc\u05d1\u05d9\u05df \u05de\u05e0\u05d9\u05e2\u05ea \u05d4\u05e1\u05d8\u05ea \u05d4\u05e1\u05dd (diversion)."
    },
    {
      "type": "multiple_choice",
      "question": "\u05d0\u05d9\u05d6\u05d4 \u05de\u05d4\u05de\u05e9\u05e4\u05d8\u05d9\u05dd \u05d4\u05d1\u05d0\u05d9\u05dd \u05e0\u05db\u05d5\u05df \u05dc\u05d2\u05d1\u05d9 \u05d4-Epidemiology \u05e9\u05dc \u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05e1\u05de\u05d9\u05dd \u05d1\u05e7\u05e8\u05d1 \u05d1\u05e0\u05d9 \u05e0\u05d5\u05e2\u05e8 \u05d1\u05d0\u05e8\u05d4\"\u05d1?",
      "answerOptions": [
        {
          "text": "\u05e9\u05d9\u05e2\u05d5\u05e8 \u05d4-SUD \u05dc-Illicit drugs \u05e2\u05d5\u05dc\u05d4 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05e2\u05dd \u05d4\u05d2\u05d9\u05dc \u05d1\u05ea\u05d5\u05da \u05ea\u05e7\u05d5\u05e4\u05ea \u05d4\u05d4\u05ea\u05d1\u05d2\u05e8\u05d5\u05ea",
          "isCorrect": true,
          "rationale": "\u05dc\u05e4\u05d9 \u05de\u05d7\u05e7\u05e8\u05d9 \u05d4-NSDUH, \u05e9\u05d9\u05e2\u05d5\u05e8 \u05d4\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05e2\u05d5\u05dc\u05d4 \u05de-3.4% \u05d1\u05d2\u05d9\u05dc\u05d0\u05d9 13-14 \u05dc-16.5% \u05d1\u05d2\u05d9\u05dc\u05d0\u05d9 17-18 (Dulcan p.225)."
        },
        {
          "text": "\u05e9\u05d9\u05e2\u05d5\u05e8 \u05d4-Alcohol Use Disorder \u05d9\u05e8\u05d3 \u05d1-24% \u05d1\u05d9\u05df \u05d4\u05e9\u05e0\u05d9\u05dd 2002 \u05dc-2014",
          "isCorrect": false,
          "rationale": "\u05d4\u05d9\u05e8\u05d9\u05d3\u05d4 \u05d1\u05e9\u05d9\u05e2\u05d5\u05e8 \u05e9\u05dc 24% \u05d3\u05d5\u05d5\u05d7\u05d4 \u05e2\u05d1\u05d5\u05e8 Marijuana use disorders, \u05dc\u05d0 \u05e2\u05d1\u05d5\u05e8 \u05d0\u05dc\u05db\u05d5\u05d4\u05d5\u05dc (Dulcan p.225)."
        },
        {
          "text": "\u05db\u05dc \u05d1\u05e0\u05d9 \u05d4\u05e0\u05d5\u05e2\u05e8 \u05de\u05ea\u05d7\u05d9\u05dc\u05d9\u05dd \u05d1-gateway drugs \u05dc\u05e4\u05e0\u05d9 \u05e9\u05d4\u05dd \u05e2\u05d5\u05d1\u05e8\u05d9\u05dd \u05dc\u05e1\u05de\u05d9\u05dd \u05e7\u05e9\u05d9\u05dd",
          "isCorrect": false,
          "rationale": "\u05dc\u05e4\u05d9 \u05d4-Dulcan, \u05dc\u05de\u05e8\u05d5\u05ea \u05e9\u05e8\u05d1\u05d9\u05dd \u05de\u05ea\u05d7\u05d9\u05dc\u05d9\u05dd \u05db\u05da, \u05d7\u05dc\u05e7 \u05de\u05d4\u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd \u05e2\u05d5\u05e7\u05e4\u05d9\u05dd \u05d0\u05ea \u05d4-gateway drugs \u05d5\u05de\u05ea\u05d7\u05d9\u05dc\u05d9\u05dd \u05d9\u05e9\u05d9\u05e8\u05d5\u05ea \u05d1\u05e1\u05de\u05d9\u05dd \u05d0\u05d7\u05e8\u05d9\u05dd (Dulcan p.232)."
        },
        {
          "text": "\u05e9\u05d9\u05e2\u05d5\u05e8\u05d9 \u05d4\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05e1\u05de\u05d9\u05dd \u05d1-NSDUH \u05d2\u05d1\u05d5\u05d4\u05d9\u05dd \u05d9\u05d5\u05ea\u05e8 \u05de\u05d0\u05e9\u05e8 \u05d1-MTF",
          "isCorrect": false,
          "rationale": "\u05e9\u05d9\u05e2\u05d5\u05e8\u05d9 \u05d4-NSDUH \u05e0\u05d5\u05d8\u05d9\u05dd \u05dc\u05d4\u05d9\u05d5\u05ea \u05e0\u05de\u05d5\u05db\u05d9\u05dd \u05d9\u05d5\u05ea\u05e8 \u05db\u05d9\u05d5\u05d5\u05df \u05e9\u05d4\u05dd \u05de\u05d3\u05d5\u05d5\u05d7\u05d9\u05dd \u05e2\u05dc \u05db\u05dc \u05e7\u05d1\u05d5\u05e6\u05ea \u05d4\u05d2\u05d9\u05dc 12-17 \u05d9\u05d7\u05d3 (Dulcan p.222)."
