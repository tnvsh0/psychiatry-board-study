{
  "title": "Stimulants Quiz",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\u05d1\u05df 17 \u05de\u05d5\u05d1\u05d0 \u05dc\u05d7\u05d3\u05e8 \u05de\u05d9\u05d5\u05df \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d4\u05de\u05e9\u05d8\u05e8\u05d4 \u05d1\u05e9\u05dc \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d0\u05d2\u05e8\u05e1\u05d9\u05d1\u05d9\u05ea \u05d5\u05d1\u05d9\u05d6\u05d0\u05e8\u05d9\u05ea. \u05d1\u05d1\u05d3\u05d9\u05e7\u05ea\u05d5: \u05d3\u05d5\u05e4\u05e7 130, \u05d0\u05d9\u05e9\u05d5\u05e0\u05d9\u05dd \u05de\u05d5\u05e8\u05d7\u05d1\u05d9\u05dd, \u05d5\u05d4\u05d5\u05d0 \u05de\u05ea\u05e2\u05e7\u05e9 \u05e9\u05d7\u05e8\u05e7\u05d9\u05dd \u05d6\u05d5\u05d7\u05dc\u05d9\u05dd \u05ea\u05d7\u05ea \u05e2\u05d5\u05e8\u05d5 (formication). \u05d4\u05d5\u05d0 \u05de\u05e9\u05d5\u05db\u05e0\u05e2 \u05e9\u05d4\u05e9\u05d5\u05d8\u05e8\u05d9\u05dd \u05d4\u05dd \u05e1\u05d5\u05db\u05e0\u05d9 \u05d7\u05dc\u05dc \u05e9\u05e0\u05e9\u05dc\u05d7\u05d5 \u05dc\u05d7\u05d8\u05d5\u05e3 \u05d0\u05d5\u05ea\u05d5. \u05d1\u05d3\u05d9\u05e7\u05ea \u05e9\u05ea\u05df \u05d7\u05d9\u05d5\u05d1\u05d9\u05ea \u05dc-Amphetamines. \u05de\u05d4\u05d9 \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05de\u05ea\u05d0\u05d9\u05de\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR?",
      "answerOptions": [
        {
          "text": "Stimulant-Induced Psychotic Disorder",
          "isCorrect": true,
          "rationale": "\u05db\u05d0\u05e9\u05e8 \u05de\u05d5\u05e4\u05d9\u05e2\u05d9\u05dd \u05de\u05d7\u05e9\u05d1\u05d5\u05ea \u05e9\u05d5\u05d5\u05d0 \u05d0\u05d5 \u05d4\u05d6\u05d9\u05d5\u05ea \u05d1\u05d4\u05d9\u05e2\u05d3\u05e8 reality testing (\u05d1\u05d5\u05d7\u05df \u05de\u05e6\u05d9\u05d0\u05d5\u05ea \u05ea\u05e7\u05d9\u05df \u05dc\u05d2\u05d1\u05d9 \u05de\u05e7\u05d5\u05e8 \u05d4\u05ea\u05e4\u05d9\u05e1\u05d4), \u05d9\u05e9 \u05dc\u05d0\u05d1\u05d7\u05df \u05d4\u05e4\u05e8\u05e2\u05d4 \u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9\u05ea \u05de\u05d5\u05e9\u05e8\u05d9\u05ea \u05d5\u05dc\u05d0 \u05e8\u05e7 Intoxication (DSM p.642, p.126)."
        },
        {
          "text": "Stimulant Intoxication",
          "isCorrect": false,
          "rationale": "\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d6\u05d5 \u05de\u05e1\u05e4\u05d9\u05e7\u05d4 \u05db\u05d0\u05e9\u05e8 \u05d9\u05e9 \u05d4\u05d6\u05d9\u05d5\u05ea \u05ea\u05d7\u05ea \u05d1\u05d5\u05d7\u05df \u05de\u05e6\u05d9\u05d0\u05d5\u05ea \u05ea\u05e7\u05d9\u05df (\u05d4\u05d0\u05d3\u05dd \u05de\u05d1\u05d9\u05df \u05e9\u05d4\u05df \u05e0\u05d5\u05d1\u05e2\u05d5\u05ea \u05de\u05d4\u05e1\u05dd), \u05d0\u05da \u05d1\u05de\u05e7\u05e8\u05d4 \u05e9\u05dc \u05de\u05d7\u05e9\u05d1\u05d5\u05ea \u05e9\u05d5\u05d5\u05d0 \u05e0\u05e8\u05d3\u05e4\u05d5\u05ea \u05d5\u05d0\u05d5\u05d1\u05d3\u05df reality testing, \u05e0\u05d3\u05e8\u05e9\u05ea \u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc Psychotic Disorder (DSM p.640, p.642)."
        },
        {
          "text": "Schizophrenia, First Episode",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05d4\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05d4\u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9\u05d9\u05dd, \u05d4\u05e7\u05e9\u05e8 \u05d4\u05d8\u05de\u05e4\u05d5\u05e8\u05dc\u05d9 \u05d4\u05de\u05d5\u05d1\u05d4\u05e7 \u05dc\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1-Amphetamines \u05d5\u05d4\u05d9\u05e2\u05d3\u05e8 \u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4 \u05de\u05d5\u05e7\u05d3\u05de\u05ea \u05de\u05db\u05d5\u05d5\u05e0\u05d9\u05dd \u05e7\u05d5\u05d3\u05dd \u05db\u05dc \u05dc\u05d4\u05e4\u05e8\u05e2\u05d4 \u05de\u05d5\u05e9\u05e8\u05d9\u05ea \u05d7\u05d5\u05de\u05e8\u05d9\u05dd (DSM p.130)."
        },
        {
          "text": "Brief Psychotic Disorder",
          "isCorrect": false,
          "rationale": "\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d6\u05d5 \u05d0\u05d9\u05e0\u05d4 \u05e0\u05d9\u05ea\u05e0\u05ea \u05db\u05d0\u05e9\u05e8 \u05d4\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05de\u05d5\u05e1\u05d1\u05e8\u05d9\u05dd \u05d8\u05d5\u05d1 \u05d9\u05d5\u05ea\u05e8 \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d4\u05d4\u05e9\u05e4\u05e2\u05d5\u05ea \u05d4\u05e4\u05d9\u05d6\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05d5\u05ea \u05e9\u05dc \u05d7\u05d5\u05de\u05e8 (DSM p.108, p.130)."
        }
      ],
      "hint": "\u05d4\u05ea\u05de\u05e7\u05d3 \u05d1\u05d1\u05d5\u05d7\u05df \u05d4\u05de\u05e6\u05d9\u05d0\u05d5\u05ea \u05e9\u05dc \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05dc\u05d2\u05d1\u05d9 \u05d4\u05ea\u05e4\u05d9\u05e1\u05d5\u05ea \u05d4\u05d7\u05d5\u05e9\u05d9\u05d5\u05ea \u05d5\u05d4\u05de\u05d7\u05e9\u05d1\u05d5\u05ea \u05e9\u05dc\u05d5."
    },
    {
      "type": "multiple_choice",
      "question": "\u05de\u05d8\u05d5\u05e4\u05dc \u05d4\u05e1\u05d5\u05d1\u05dc \u05de-Stimulant Use Disorder \u05de\u05d2\u05d9\u05e2 \u05dc\u05de\u05d9\u05d5\u05df \u05e2\u05dd \u05d7\u05d5\u05dd \u05d2\u05d5\u05e3 \u05e9\u05dc $41.1^{\\circ}C$, \u05e7\u05e9\u05d9\u05d5\u05df \u05e9\u05e8\u05d9\u05e8\u05d9\u05dd, \u05d5\u05d1\u05dc\u05d1\u05d5\u05dc \u05e2\u05de\u05d5\u05e7. \u05d1\u05d3\u05d9\u05e7\u05d5\u05ea \u05d4\u05de\u05e2\u05d1\u05d3\u05d4 \u05de\u05e8\u05d0\u05d5\u05ea \u05e8\u05de\u05d5\u05ea \u05d7\u05e8\u05d9\u05d2\u05d5\u05ea \u05e9\u05dc Creatine Phosphokinase (CPK). \u05de\u05d4\u05d5 \u05d4\u05e1\u05d9\u05d1\u05d5\u05da \u05d4\u05de\u05d9\u05d9\u05d3\u05d9 \u05d5\u05d4\u05de\u05e1\u05d5\u05db\u05df \u05d1\u05d9\u05d5\u05ea\u05e8 \u05e9\u05d9\u05e9 \u05dc\u05d7\u05e9\u05d5\u05e9 \u05de\u05de\u05e0\u05d5 \u05d1\u05de\u05e6\u05d1 \u05d6\u05d4?",
      "answerOptions": [
        {
          "text": "Acute Renal Failure \u05e2\u05e7\u05d1 Rhabdomyolysis",
          "isCorrect": true,
          "rationale": "\u05d4\u05d9\u05e4\u05e8\u05ea\u05e8\u05de\u05d9\u05d4 \u05e7\u05d9\u05e6\u05d5\u05e0\u05d9\u05ea \u05d5\u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05e9\u05e8\u05d9\u05e8\u05d9\u05ea \u05de\u05d5\u05d2\u05d1\u05e8\u05ea \u05de\u05d5\u05d1\u05d9\u05dc\u05d9\u05dd \u05dc\u05e4\u05d9\u05e8\u05d5\u05e7 \u05e9\u05e8\u05d9\u05e8 \u05de\u05d0\u05e1\u05d9\u05d1\u05d9, \u05e9\u05d7\u05e8\u05d5\u05e8 \u05de\u05d9\u05d5\u05d2\u05dc\u05d5\u05d1\u05d9\u05df \u05dc\u05db\u05dc\u05d9\u05d5\u05ea \u05d5\u05d0\u05d9-\u05e1\u05e4\u05d9\u05e7\u05d4 \u05db\u05dc\u05d9\u05d9\u05ea\u05d9\u05ea \u05d7\u05e8\u05d9\u05e4\u05d4 (StahlNeuro p.545, DSM p.639)."
        },
        {
          "text": "Serotonin Syndrome",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05d4\u05d3\u05de\u05d9\u05d5\u05df \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9, \u05d4\u05e8\u05e7\u05e2 \u05e9\u05dc \u05e9\u05d9\u05de\u05d5\u05e9 \u05db\u05d1\u05d3 \u05d1\u05e1\u05d8\u05d9\u05de\u05d5\u05dc\u05e0\u05d8\u05d9\u05dd \u05d5\u05d4\u05d9\u05e2\u05d3\u05e8 \u05e9\u05d9\u05dc\u05d5\u05d1 \u05e2\u05dd SSRI/MAOI \u05de\u05db\u05d5\u05d5\u05e0\u05d9\u05dd \u05dc\u05e1\u05d9\u05d1\u05d5\u05da \u05e9\u05dc Stimulant Toxicity (\u05de\u05e7\u05d5\u05e8: \u05d4\u05e7\u05e9\u05e8 \u05e8\u05d7\u05d1)."
