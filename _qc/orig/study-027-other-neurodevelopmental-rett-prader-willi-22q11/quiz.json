{
  "title": "Genetics Quiz",
  "questions": [
    {
      "question": "\u05d9\u05dc\u05d3\u05d4 \u05d1\u05ea $3$ \u05de\u05d5\u05e4\u05e0\u05d9\u05ea \u05dc\u05d4\u05e2\u05e8\u05db\u05d4 \u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9\u05ea \u05d1\u05e9\u05dc \u05d0\u05d5\u05d1\u05d3\u05df \u05e4\u05ea\u05d0\u05d5\u05de\u05d9 \u05e9\u05dc \u05db\u05d9\u05e9\u05d5\u05e8\u05d9 \u05e9\u05e4\u05d4 \u05d5\u05e9\u05d9\u05de\u05d5\u05e9 \u05ea\u05db\u05dc\u05d9\u05ea\u05d9 \u05d1\u05d9\u05d3\u05d9\u05d9\u05dd, \u05e9\u05d4\u05d7\u05dc \u05dc\u05e4\u05e0\u05d9 \u05db\u05d7\u05e6\u05d9 \u05e9\u05e0\u05d4. \u05d1\u05d1\u05d3\u05d9\u05e7\u05d4 \u05e0\u05e6\u05e4\u05d5 \u05ea\u05e0\u05d5\u05e2\u05d5\u05ea \u05e1\u05d8\u05e8\u05d9\u05d0\u05d5\u05d8\u05d9\u05e4\u05d9\u05d5\u05ea \u05e9\u05dc \"\u05e9\u05d8\u05d9\u05e4\u05ea \u05d9\u05d3\u05d9\u05d9\u05dd\" \u05d5\u05d0\u05d9-\u05e1\u05d3\u05d9\u05e8\u05d5\u05ea \u05d1\u05e0\u05e9\u05d9\u05de\u05d4. \u05d1\u05de\u05d9\u05d3\u05d4 \u05d5\u05ea\u05d9\u05d3\u05e8\u05e9 \u05d4\u05ea\u05e2\u05e8\u05d1\u05d5\u05ea \u05e4\u05e1\u05d9\u05db\u05d5\u05e4\u05e8\u05de\u05e7\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea \u05dc\u05e0\u05d9\u05d4\u05d5\u05dc behavioral dysregulation, \u05de\u05d4\u05d5 \u05d4\u05e0\u05d9\u05d8\u05d5\u05e8 \u05d4\u05e8\u05e4\u05d5\u05d0\u05d9 \u05d4\u05e7\u05e8\u05d9\u05d8\u05d9 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05e9\u05d9\u05e9 \u05dc\u05d1\u05e6\u05e2 \u05dc\u05e4\u05e0\u05d9 \u05d5\u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc?",
      "answerOptions": [
        {
          "text": "\u05d1\u05d9\u05e6\u05d5\u05e2 ECG \u05ea\u05e7\u05d5\u05e4\u05ea\u05d9 \u05d5\u05de\u05e2\u05e7\u05d1 \u05d0\u05d7\u05e8 \u05de\u05e8\u05d5\u05d5\u05d7 \u05d4-QT \u05d1\u05e9\u05dc \u05e1\u05d9\u05db\u05d5\u05df \u05dc-Sudden Cardiac Death.",
          "isCorrect": true,
          "rationale": "\u05de\u05d8\u05d5\u05e4\u05dc\u05d5\u05ea \u05e2\u05dd Rett syndrome (MECP2 mutations) \u05e0\u05de\u05e6\u05d0\u05d5\u05ea \u05d1\u05e1\u05d9\u05db\u05d5\u05df \u05d2\u05d1\u05d5\u05d4 \u05dc\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05e7\u05e6\u05d1 \u05dc\u05d1\u05d1\u05d9\u05d5\u05ea \u05d5\u05de\u05d5\u05d5\u05ea \u05e4\u05ea\u05d0\u05d5\u05de\u05d9, \u05d5\u05dc\u05db\u05df \u05e0\u05d3\u05e8\u05e9\u05ea \u05d6\u05d4\u05d9\u05e8\u05d5\u05ea \u05e7\u05d9\u05e6\u05d5\u05e0\u05d9\u05ea \u05e2\u05dd \u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05d4\u05de\u05d0\u05e8\u05d9\u05db\u05d5\u05ea \u05d0\u05ea \u05de\u05e8\u05d5\u05d5\u05d7 \u05d4-QT (Dulcan p.120)."
        },
        {
          "text": "\u05e0\u05d9\u05d8\u05d5\u05e8 \u05e8\u05de\u05d5\u05ea \u05d0\u05dc\u05e7\u05d8\u05e8\u05d5\u05dc\u05d9\u05d8\u05d9\u05dd \u05d1\u05d3\u05dd \u05d1\u05e9\u05dc \u05e0\u05d8\u05d9\u05d9\u05d4 \u05de\u05d5\u05d1\u05e0\u05d9\u05ea \u05dc\u05d4\u05d9\u05e4\u05e8\u05e7\u05dc\u05e6\u05de\u05d9\u05d4.",
          "isCorrect": false,
          "rationale": "\u05d4\u05d9\u05e4\u05e8\u05e7\u05dc\u05e6\u05de\u05d9\u05d4 \u05d4\u05d9\u05d0 \u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05d0\u05e0\u05d3\u05d5\u05e7\u05e8\u05d9\u05e0\u05d9 \u05d4\u05de\u05e7\u05d5\u05e9\u05e8 \u05d3\u05d5\u05d5\u05e7\u05d0 \u05dc\u05ea\u05e1\u05de\u05d5\u05e0\u05ea Williams, \u05d5\u05dc\u05d0 \u05dc\u05ea\u05e1\u05de\u05d5\u05e0\u05ea Rett (Dulcan p.118)."
        },
        {
          "text": "\u05de\u05e2\u05e7\u05d1 \u05d0\u05d7\u05e8 \u05ea\u05e4\u05e7\u05d5\u05d3\u05d9 \u05db\u05d1\u05d3 \u05d5\u05e8\u05de\u05d5\u05ea \u05d0\u05de\u05d5\u05e0\u05d9\u05d4 \u05d1\u05e9\u05dc \u05e1\u05d9\u05db\u05d5\u05df \u05dc-Neonatal Encephalopathy.",
          "isCorrect": false,
          "rationale": "\u05d1\u05e2\u05d5\u05d3 \u05e9\u05d6\u05db\u05e8\u05d9\u05dd \u05e2\u05dd \u05de\u05d5\u05d8\u05e6\u05d9\u05d4 \u05d1-MECP2 \u05e1\u05d5\u05d1\u05dc\u05d9\u05dd \u05de\u05d0\u05e0\u05e6\u05e4\u05dc\u05d5\u05e4\u05ea\u05d9\u05d4 \u05e7\u05e9\u05d4, \u05d1\u05e0\u05e7\u05d1\u05d5\u05ea \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05d9\u05d0 Rett syndrome \u05d5\u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05d1\u05d8\u05d9\u05e4\u05d5\u05dc \u05ea\u05e8\u05d5\u05e4\u05ea\u05d9 \u05d4\u05d5\u05d0 \u05dc\u05d1\u05d1\u05d9 (Dulcan p.120)."
        },
        {
          "text": "\u05d1\u05d9\u05e6\u05d5\u05e2 EEG \u05d1\u05e9\u05d9\u05e0\u05d4 \u05d1\u05dc\u05d1\u05d3 \u05d1\u05e9\u05dc \u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05e0\u05de\u05d5\u05db\u05d4 \u05e9\u05dc \u05d0\u05e4\u05d9\u05dc\u05e4\u05e1\u05d9\u05d4 \u05d1\u05ea\u05e1\u05de\u05d5\u05e0\u05ea \u05d6\u05d5.",
          "isCorrect": false,
          "rationale": "\u05d4\u05d4\u05d9\u05e4\u05da \u05d4\u05d5\u05d0 \u05d4\u05e0\u05db\u05d5\u05df; \u05de\u05e2\u05dc $90\\%$ \u05de\u05d4\u05de\u05d8\u05d5\u05e4\u05dc\u05d5\u05ea \u05e2\u05dd Rett syndrome \u05e1\u05d5\u05d1\u05dc\u05d5\u05ea \u05de\u05e4\u05e8\u05db\u05d5\u05e1\u05d9\u05dd, \u05d0\u05da \u05d4\u05e0\u05d9\u05d8\u05d5\u05e8 \u05d4\u05e7\u05e8\u05d9\u05d8\u05d9 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05de\u05d5\u05d5\u05ea \u05e4\u05ea\u05d0\u05d5\u05de\u05d9 \u05d4\u05d5\u05d0 \u05dc\u05d1\u05d1\u05d9 (Dulcan p.120)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05e1\u05d9\u05d1\u05d5\u05da \u05d4\u05d2\u05d5\u05e4\u05e0\u05d9 \u05d4\u05de\u05d4\u05d5\u05d5\u05d4 \u05d4\u05ea\u05d5\u05d5\u05d9\u05d9\u05ea-\u05e0\u05d2\u05d3 \u05d9\u05d7\u05e1\u05d9\u05ea \u05dc\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05e0\u05d5\u05d2\u05d3\u05d9 \u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d4 \u05de\u05e1\u05d5\u05d9\u05de\u05d9\u05dd \u05d1\u05ea\u05e1\u05de\u05d5\u05e0\u05ea \u05e8\u05d8.",
      "citation": "(Dulcan p.120)"
    },
    {
      "question": "\u05e0\u05e2\u05e8 \u05d1\u05df $14$ \u05e2\u05dd \u05d0\u05d1\u05d7\u05e0\u05d4 \u05d9\u05d3\u05d5\u05e2\u05d4 \u05e9\u05dc Prader-Willi Syndrome (PWS) \u05de\u05d5\u05e4\u05e0\u05d9\u05ea \u05dc\u05de\u05e8\u05e4\u05d0\u05d4 \u05d1\u05e9\u05dc \u05d4\u05d7\u05de\u05e8\u05d4 \u05d1\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05e9\u05dc \u05d7\u05d9\u05d8\u05d5\u05d8 \u05d0\u05d9\u05e0\u05d8\u05e0\u05e1\u05d9\u05d1\u05d9 \u05d1\u05e2\u05d5\u05e8 (Skin picking) \u05e2\u05d3 \u05db\u05d3\u05d9 \u05d6\u05d9\u05d4\u05d5\u05de\u05d9\u05dd \u05d7\u05d5\u05d6\u05e8\u05d9\u05dd \u05d4\u05de\u05e6\u05e8\u05d9\u05db\u05d9\u05dd \u05d0\u05e0\u05d8\u05d9\u05d1\u05d9\u05d5\u05d8\u05d9\u05e7\u05d4. \u05de\u05d4\u05d5 \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05e4\u05e1\u05d9\u05db\u05d5\u05e4\u05e8\u05de\u05e7\u05d5\u05dc\u05d5\u05d2\u05d9 \u05e9\u05d4\u05d5\u05db\u05d7 \u05db\u05d9\u05e2\u05d9\u05dc \u05dc\u05d4\u05e4\u05d7\u05ea\u05ea \u05e4\u05e0\u05d5\u05d8\u05d9\u05e4 \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea\u05d9 \u05d6\u05d4 \u05d1\u05d0\u05d5\u05db\u05dc\u05d5\u05e1\u05d9\u05d9\u05d4 \u05d6\u05d5?",
      "answerOptions": [
        {
          "text": "Topiramate",
          "isCorrect": true,
          "rationale": "\u05de\u05d7\u05e7\u05e8\u05d9\u05dd \u05d4\u05e8\u05d0\u05d5 \u05db\u05d9 Topiramate \u05e0\u05de\u05e6\u05d0 \u05d9\u05e2\u05d9\u05dc \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05d7\u05d9\u05d8\u05d5\u05d8 \u05e2\u05e6\u05de\u05d9 \u05d1\u05e2\u05d5\u05e8 \u05d1\u05e7\u05e8\u05d1 \u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd \u05e2\u05dd Prader-Willi syndrome (Dulcan p.119)."
        },
        {
          "text": "Lithium",
          "isCorrect": false,
          "rationale": "\u05de\u05d9\u05d9\u05e6\u05d1\u05d9 \u05de\u05e6\u05d1 \u05e8\u05d5\u05d7 \u05db\u05de\u05d5 Lithium \u05e0\u05de\u05e6\u05d0\u05d5 \u05db\u05d1\u05e2\u05dc\u05d9 \u05ea\u05d5\u05e2\u05dc\u05ea \u05de\u05d5\u05e2\u05d8\u05d4 \u05dc\u05e0\u05d9\u05d4\u05d5\u05dc \u05d4\u05d1\u05e2\u05d9\u05d5\u05ea \u05d4\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea\u05d9\u05d5\u05ea \u05d1-PWS (Dulcan p.119)."
        },
        {
          "text": "Vitamin D \u05d1\u05de\u05d9\u05e0\u05d5\u05df \u05d2\u05d1\u05d5\u05d4",
          "isCorrect": false,
          "rationale": "\u05de\u05ea\u05df Vitamin D \u05d0\u05d9\u05e0\u05d5 \u05e7\u05e9\u05d5\u05e8 \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-PWS, \u05d5\u05de\u05d4\u05d5\u05d5\u05d4 \u05d4\u05ea\u05d5\u05d5\u05d9\u05d9\u05ea \u05e0\u05d2\u05d3 \u05d3\u05d5\u05d5\u05e7\u05d0 \u05d1\u05ea\u05e1\u05de\u05d5\u05e0\u05ea Williams (Dulcan p.118)."
        },
        {
          "text": "Chlorpromazine",
          "isCorrect": false,
          "rationale": "\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1-antipsychotics \u05d3\u05d5\u05e8 \u05e8\u05d0\u05e9\u05d5\u05df \u05dc\u05e0\u05d9\u05d4\u05d5\u05dc \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea\u05d9 \u05e0\u05d7\u05e9\u05d1 \u05db\u05d9\u05d5\u05dd \u05dc\u05e4\u05e8\u05e7\u05d8\u05d9\u05e7\u05d4 \u05dc\u05d0 \u05de\u05d5\u05de\u05dc\u05e6\u05ea \u05d4\u05de\u05db\u05d5\u05e0\u05d4 \"chemical straightjackets\" (StahlKids p.416)."
        }
      ],
      "hint": "\u05ea\u05e8\u05d5\u05e4\u05d4 \u05d6\u05d5 \u05de\u05e9\u05de\u05e9\u05ea \u05dc\u05e2\u05d9\u05ea\u05d9\u05dd \u05d2\u05dd \u05dc\u05e0\u05d9\u05d4\u05d5\u05dc \u05d3\u05d7\u05e4\u05d9\u05dd \u05d5\u05d0\u05e4\u05d9\u05dc\u05e4\u05e1\u05d9\u05d4, \u05d5\u05e0\u05de\u05e6\u05d0\u05d4 \u05d9\u05e2\u05d9\u05dc\u05d4 \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05ea \u05dc\u05e4\u05e0\u05d5\u05d8\u05d9\u05e4 \u05e9\u05dc \u05e4\u05d2\u05d9\u05e2\u05d4 \u05e2\u05e6\u05de\u05d9\u05ea \u05d1-PWS.",
      "citation": "(Dulcan p.119)"
    },
    {
      "question": "\u05d9\u05dc\u05d3 \u05d1\u05df $7$ \u05e2\u05dd \u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc $22q11.2$ deletion syndrome (Velo-Cardio-Facial Syndrome) \u05de\u05e6\u05d9\u05d2 \u05e7\u05e9\u05d9\u05d9\u05dd \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05d9\u05dd \u05d1\u05dc\u05de\u05d9\u05d3\u05d4, \u05de\u05d5\u05e1\u05d7\u05d5\u05ea \u05d2\u05d1\u05d5\u05d4\u05d4 \u05d5\u05d4\u05d9\u05e4\u05e8\u05d0\u05e7\u05d8\u05d9\u05d1\u05d9\u05d5\u05ea. \u05d1\u05d1\u05d3\u05d9\u05e7\u05ea\u05d5 \u05e0\u05e6\u05e4\u05d5 \u05e4\u05d2\u05de\u05d9 \u05d3\u05d9\u05d1\u05d5\u05e8 \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05d9\u05dd \u05d5\u05e7\u05d5\u05dc \u05de\u05d0\u05d5\u05e0\u05e4\u05e3. \u05de\u05d4\u05d9 \u05d4\u05d4\u05de\u05dc\u05e6\u05d4 \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc\u05d9\u05ea \u05d4\u05de\u05d3\u05d5\u05d9\u05e7\u05ea \u05d1\u05d9\u05d5\u05ea\u05e8 \u05e2\u05d1\u05d5\u05e8\u05d5 \u05dc\u05e4\u05d9 \u05d4-Dulcan?",
      "answerOptions": [
        {
          "text": "\u05d9\u05e9 \u05dc\u05d8\u05e4\u05dc \u05d1\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05e9\u05dc ADHD \u05d1\u05d0\u05de\u05e6\u05e2\u05d5\u05ea \u05e1\u05d8\u05d9\u05de\u05d5\u05dc\u05e0\u05d8\u05d9\u05dd \u05db\u05d3\u05d9 \u05dc\u05d0\u05e4\u05e9\u05e8 \u05de\u05d9\u05e6\u05d5\u05d9 \u05e9\u05dc \u05d8\u05d9\u05e4\u05d5\u05dc\u05d9\u05dd \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea\u05d9\u05d9\u05dd \u05d5\u05d7\u05d9\u05e0\u05d5\u05db\u05d9\u05d9\u05dd.",
          "isCorrect": true,
          "rationale": "\u05d7\u05e9\u05d5\u05d1 \u05dc\u05d8\u05e4\u05dc \u05d1-ADHD \u05e0\u05dc\u05d5\u05d5\u05d4 \u05d1\u05d9\u05dc\u05d3\u05d9 $22q11.2$ \u05db\u05d9\u05d5\u05d5\u05df \u05e9\u05d4\u05d5\u05d0 \u05de\u05d4\u05d5\u05d5\u05d4 \u05d7\u05e1\u05dd \u05dc\u05dc\u05de\u05d9\u05d3\u05d4; \u05d8\u05d9\u05e4\u05d5\u05dc \u05ea\u05e8\u05d5\u05e4\u05ea\u05d9 \u05e7\u05dc\u05d0\u05e1\u05d9 \u05d9\u05e2\u05d9\u05dc \u05d5\u05de\u05d5\u05de\u05dc\u05e5 (Dulcan p.122)."
        },
        {
          "text": "\u05d0\u05d9\u05df \u05dc\u05ea\u05ea \u05e1\u05d8\u05d9\u05de\u05d5\u05dc\u05e0\u05d8\u05d9\u05dd \u05d1\u05e9\u05dc \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05d4\u05d2\u05d1\u05d5\u05d4 \u05dc\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea \u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d4 \u05d1\u05d2\u05d9\u05dc \u05d4\u05d4\u05ea\u05d1\u05d2\u05e8\u05d5\u05ea.",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05d4\u05e2\u05ea\u05d9\u05d3\u05d9 \u05dc\u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d4, \u05d4-ADHD \u05d1\u05d9\u05dc\u05d3\u05d5\u05ea \u05d3\u05d5\u05e8\u05e9 \u05d8\u05d9\u05e4\u05d5\u05dc, \u05d5\u05d0\u05d9\u05df \u05de\u05e0\u05d9\u05e2\u05d4 \u05dc\u05ea\u05ea \u05e1\u05d8\u05d9\u05de\u05d5\u05dc\u05e0\u05d8\u05d9\u05dd \u05d1\u05de\u05d9\u05d3\u05ea \u05d4\u05e6\u05d5\u05e8\u05da (Dulcan p.122)."
        },
        {
          "text": "\u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05d1\u05d7\u05d9\u05e8\u05d4 \u05d4\u05d5\u05d0 Antipsychotics \u05d1\u05de\u05d9\u05e0\u05d5\u05df \u05e0\u05de\u05d5\u05da \u05dc\u05de\u05e0\u05d9\u05e2\u05ea \u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d4 \u05e2\u05ea\u05d9\u05d3\u05d9\u05ea.",
          "isCorrect": false,
          "rationale": "\u05d0\u05d9\u05df \u05e2\u05d3\u05d5\u05ea \u05dc\u05db\u05da \u05e9\u05de\u05ea\u05df \u05de\u05e0\u05d9\u05e2\u05ea\u05d9 \u05e9\u05dc \u05e0\u05d5\u05d2\u05d3\u05d9 \u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d4 \u05de\u05d5\u05e0\u05e2 \u05d0\u05ea \u05e4\u05e8\u05d9\u05e6\u05ea \u05d4\u05de\u05d7\u05dc\u05d4 \u05d1-22q11.2, \u05d5\u05d4\u05de\u05d9\u05e7\u05d5\u05d3 \u05d1\u05d9\u05dc\u05d3\u05d5\u05ea \u05d4\u05d5\u05d0 \u05e2\u05dc ADHD \u05d5\u05d7\u05e8\u05d3\u05d4 (Dulcan p.118)."
        },
        {
          "text": "\u05d9\u05e9 \u05dc\u05d4\u05d9\u05de\u05e0\u05e2 \u05de\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05e7\u05dc\u05d9\u05e0\u05d0\u05d9\u05ea \u05ea\u05e7\u05e9\u05d5\u05e8\u05ea \u05e2\u05d3 \u05dc\u05ea\u05d9\u05e7\u05d5\u05df \u05db\u05d9\u05e8\u05d5\u05e8\u05d2\u05d9 \u05e9\u05dc \u05de\u05d5\u05de\u05d9 \u05d4\u05dc\u05d1.",
          "isCorrect": false,
          "rationale": "\u05d8\u05d9\u05e4\u05d5\u05dc \u05e9\u05e4\u05ea\u05d9 \u05d5\u05e7\u05dc\u05d9\u05e0\u05d0\u05d9\u05ea \u05ea\u05e7\u05e9\u05d5\u05e8\u05ea \u05d7\u05d9\u05d5\u05e0\u05d9\u05d9\u05dd \u05de\u05d5\u05e7\u05d3\u05dd \u05db\u05db\u05dc \u05d4\u05d0\u05e4\u05e9\u05e8 \u05d1\u05e9\u05dc \u05d4-Velopharyngeal Insufficiency \u05d4\u05e9\u05db\u05d9\u05d7 \u05d1\u05ea\u05e1\u05de\u05d5\u05e0\u05ea (Dulcan p.122)."
        }
      ],
      "hint": "\u05d4\u05ea\u05d9\u05d9\u05d7\u05e1 \u05dc\u05e7\u05e9\u05e8 \u05d1\u05d9\u05df \u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05e7\u05e9\u05d1 \u05dc\u05d1\u05d9\u05df \u05de\u05d9\u05e6\u05d5\u05d9 \u05e4\u05d5\u05d8\u05e0\u05e6\u05d9\u05d0\u05dc \u05dc\u05de\u05d9\u05d3\u05d4 \u05d1\u05ea\u05e1\u05de\u05d5\u05e0\u05d5\u05ea \u05d2\u05e0\u05d8\u05d9\u05d5\u05ea.",
      "citation": "(Dulcan p.122)"
    },
    {
      "question": "\u05d1\u05ea\u05d4\u05dc\u05d9\u05da \u05d4\u05e2\u05e8\u05db\u05d4 \u05e9\u05dc \u05d9\u05dc\u05d3 \u05e2\u05dd \u05e2\u05d9\u05db\u05d5\u05d1 \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9, \u05d4\u05e7\u05dc\u05d9\u05e0\u05d0\u05d9 \u05de\u05ea\u05dc\u05d1\u05d8 \u05d1\u05d9\u05df \u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc Williams Syndrome (WS) \u05dc\u05d1\u05d9\u05df Neurobehavioral Disorder Associated with Prenatal Alcohol Exposure (ND-PAE). \u05de\u05d4\u05d5 \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9 \u05d4\u05de\u05e9\u05d5\u05ea\u05e3 \u05dc\u05e9\u05ea\u05d9 \u05d4\u05d0\u05d1\u05d7\u05e0\u05d5\u05ea \u05e9\u05e2\u05e9\u05d5\u05d9 \u05dc\u05d4\u05e7\u05e9\u05d5\u05ea \u05e2\u05dc \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05de\u05d1\u05d3\u05dc\u05ea \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR?",
      "answerOptions": [
        {
          "text": "\u05d3\u05e4\u05d5\u05e1 \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d4\u05db\u05d5\u05dc\u05dc Hypersociability \u05d5\u05e4\u05e0\u05d9\u05d9\u05d4 \u05d7\u05e1\u05e8\u05ea \u05e2\u05db\u05d1\u05d5\u05ea \u05dc\u05d6\u05e8\u05d9\u05dd.",
          "isCorrect": true,
          "rationale": "\u05d4-DSM \u05de\u05e6\u05d9\u05d9\u05df \u05db\u05d9 \u05e9\u05ea\u05d9 \u05d4\u05ea\u05e1\u05de\u05d5\u05e0\u05d5\u05ea \u05d7\u05d5\u05dc\u05e7\u05d5\u05ea \u05e4\u05e0\u05d5\u05d8\u05d9\u05e4 \u05e9\u05dc \u05d7\u05d1\u05e8\u05ea\u05d9\u05d5\u05ea-\u05d9\u05ea\u05e8 \u05d5\u05d3\u05d9\u05e1\u05de\u05d5\u05e8\u05e4\u05d5\u05dc\u05d5\u05d2\u05d9\u05d4 \u05e4\u05e0\u05d9\u05de\u05d9\u05ea, \u05de\u05d4 \u05e9\u05de\u05d7\u05d9\u05d9\u05d1 \u05d4\u05e2\u05e8\u05db\u05d4 \u05d2\u05e0\u05d8\u05d9\u05ea \u05e7\u05e4\u05d3\u05e0\u05d9\u05ea (DSM p.920)."
        },
        {
          "text": "\u05e0\u05d8\u05d9\u05d9\u05d4 \u05de\u05d5\u05d1\u05e0\u05d9\u05ea \u05dc\u05d4\u05d9\u05e4\u05e8\u05e7\u05dc\u05e6\u05de\u05d9\u05d4 \u05d5\u05d7\u05e1\u05e8 \u05d1\u05d0\u05dc\u05e1\u05d8\u05d9\u05df.",
          "isCorrect": false,
          "rationale": "\u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9\u05dd \u05d0\u05dc\u05d5 \u05d9\u05d9\u05d7\u05d5\u05d3\u05d9\u05d9\u05dd \u05dc-Williams Syndrome \u05d5\u05d0\u05d9\u05e0\u05dd \u05de\u05d5\u05e4\u05d9\u05e2\u05d9\u05dd \u05d1-ND-PAE (Dulcan p.118)."
        },
        {
          "text": "\u05e1\u05d9\u05db\u05d5\u05df \u05d2\u05d1\u05d5\u05d4 \u05d1\u05de\u05d9\u05d5\u05d7\u05d3 \u05dc-Sudden Cardiac Death \u05d5\u05e6\u05d5\u05e8\u05da \u05d1-ECG.",
          "isCorrect": false,
          "rationale": "\u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05d6\u05d4 \u05e7\u05e9\u05d5\u05e8 \u05dc-Rett syndrome (MECP2) \u05d5\u05dc\u05e2\u05d9\u05ea\u05d9\u05dd \u05dc-Williams (Long QT), \u05d0\u05da \u05d0\u05d9\u05e0\u05d5 \u05d7\u05dc\u05e7 \u05de\u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05e9\u05dc ND-PAE (Dulcan p.120)."
        },
        {
          "text": "\u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05e9\u05dc '\u05de\u05d1\u05e0\u05d4 \u05db\u05d5\u05db\u05d1\u05d9' \u05d1\u05e7\u05e9\u05ea\u05d9\u05ea \u05d4\u05e2\u05d9\u05df (Stellate iris).",
          "isCorrect": false,
          "rationale": "\u05e1\u05d9\u05de\u05df \u05e4\u05d9\u05d6\u05d9\u05e7\u05dc\u05d9 \u05d6\u05d4 \u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05d9 \u05dc-Williams Syndrome \u05d0\u05da \u05d0\u05d9\u05e0\u05d5 \u05e7\u05d9\u05d9\u05dd \u05d1\u05d7\u05e9\u05d9\u05e4\u05d4 \u05e2\u05d5\u05d1\u05e8\u05d9\u05ea \u05dc\u05d0\u05dc\u05db\u05d5\u05d4\u05d5\u05dc (Dulcan p.118)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05e4\u05e0\u05d5\u05d8\u05d9\u05e4 \u05d4\u05d0\u05d9\u05e9\u05d9\u05d5\u05ea\u05d9-\u05d7\u05d1\u05e8\u05ea\u05d9 \u05d4\u05e7\u05d9\u05e6\u05d5\u05e0\u05d9 \u05e9\u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05d9\u05dc\u05d3\u05d9\u05dd \u05d0\u05dc\u05d5.",
      "citation": "(DSM p.920)"
    },
    {
      "question": "\u05d1\u05d1\u05d5\u05d0\u05e0\u05d5 \u05dc\u05d0\u05d1\u05d7\u05df Autism Spectrum Disorder (ASD) \u05d1\u05d9\u05dc\u05d3\u05d4 \u05e2\u05dd Rett Syndrome \u05d1\u05e9\u05dc\u05d1 \u05d4-Stabilization, \u05de\u05d4\u05d5 \u05d4\u05d3\u05d2\u05e9 \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05e9\u05dc \u05d4-DSM-5-TR \u05dc\u05d2\u05d1\u05d9 \u05de\u05d4\u05dc\u05da \u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd?",
      "answerOptions": [
        {
          "text": "\u05dc\u05d0\u05d7\u05e8 \u05e9\u05dc\u05d1 \u05d4\u05e8\u05d2\u05e8\u05e1\u05d9\u05d4, \u05d4\u05db\u05d9\u05e9\u05d5\u05e8\u05d9\u05dd \u05d4\u05d7\u05d1\u05e8\u05ea\u05d9\u05d9\u05dd \u05dc\u05e8\u05d5\u05d1 \u05de\u05e9\u05ea\u05e4\u05e8\u05d9\u05dd \u05d5\u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9\u05dd \u05d4\u05d0\u05d5\u05d8\u05d9\u05e1\u05d8\u05d9\u05d9\u05dd \u05de\u05e4\u05e1\u05d9\u05e7\u05d9\u05dd \u05dc\u05d4\u05d5\u05d5\u05ea \u05d0\u05ea \u05de\u05d5\u05e7\u05d3 \u05d4\u05e7\u05d5\u05e9\u05d9 \u05d4\u05de\u05e8\u05db\u05d6\u05d9.",
          "isCorrect": true,
          "rationale": "\u05d4-DSM \u05de\u05d3\u05d2\u05d9\u05e9 \u05db\u05d9 \u05d1-Rett syndrome \u05d7\u05dc \u05e9\u05d9\u05e4\u05d5\u05e8 \u05d1\u05ea\u05e7\u05e9\u05d5\u05e8\u05ea \u05d4\u05d7\u05d1\u05e8\u05ea\u05d9\u05ea \u05dc\u05d0\u05d7\u05e8 \u05d4\u05e0\u05e1\u05d9\u05d2\u05d4 \u05d4\u05e8\u05d0\u05e9\u05d5\u05e0\u05d9\u05ea, \u05d5\u05dc\u05db\u05df \u05d0\u05d1\u05d7\u05e0\u05ea ASD \u05ea\u05d9\u05e0\u05ea\u05df \u05e8\u05e7 \u05d0\u05dd \u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05d4\u05de\u05dc\u05d0\u05d9\u05dd \u05de\u05ea\u05e7\u05d9\u05d9\u05de\u05d9\u05dd \u05db\u05e2\u05ea (DSM p.67)."
        },
        {
          "text": "\u05d9\u05e9 \u05dc\u05ea\u05ea \u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc ASD \u05d1\u05d0\u05d5\u05e4\u05df \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9 \u05dc\u05db\u05dc \u05d9\u05dc\u05d3\u05d4 \u05e2\u05dd \u05de\u05d5\u05d8\u05e6\u05d9\u05d4 \u05d1-MECP2.",
          "isCorrect": false,
          "rationale": "\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d2\u05e0\u05d8\u05d9\u05ea \u05d0\u05d9\u05e0\u05d4 \u05de\u05d4\u05d5\u05d5\u05d4 \u05d0\u05d1\u05d7\u05e0\u05d4 \u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9\u05ea \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9\u05ea; \u05d9\u05e9 \u05dc\u05d5\u05d5\u05d3\u05d0 \u05e2\u05de\u05d9\u05d3\u05d4 \u05d1\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd (DSM p.67)."
        },
        {
          "text": "\u05d4\u05e8\u05d2\u05e8\u05e1\u05d9\u05d4 \u05d4\u05d7\u05d1\u05e8\u05ea\u05d9\u05ea \u05d1\u05ea\u05e1\u05de\u05d5\u05e0\u05ea \u05e8\u05d8 \u05d4\u05d9\u05d0 \u05ea\u05de\u05d9\u05d3\u05d9\u05ea \u05d5\u05de\u05d7\u05de\u05d9\u05e8\u05d4 \u05e2\u05dd \u05d4\u05d2\u05d9\u05dc, \u05d1\u05d3\u05d5\u05de\u05d4 \u05dc-ASD \u05e7\u05dc\u05d0\u05e1\u05d9.",
          "isCorrect": false,
          "rationale": "\u05d1\u05e0\u05d9\u05d2\u05d5\u05d3 \u05dc-ASD, \u05d1-Rett syndrome \u05d9\u05e9 \u05dc\u05e8\u05d5\u05d1 \u05e9\u05dc\u05d1 \u05e9\u05dc \u05d4\u05ea\u05d9\u05d9\u05e6\u05d1\u05d5\u05ea \u05d5\u05d0\u05e3 \u05e9\u05d9\u05e4\u05d5\u05e8 \u05de\u05e1\u05d5\u05d9\u05dd \u05d1\u05d0\u05d9\u05e0\u05d8\u05e8\u05d0\u05e7\u05e6\u05d9\u05d4 \u05d4\u05d7\u05d1\u05e8\u05ea\u05d9\u05ea \u05dc\u05d0\u05d7\u05e8 \u05ea\u05e7\u05d5\u05e4\u05ea \u05d4\u05e0\u05e1\u05d9\u05d2\u05d4 (DSM p.67)."
        },
        {
          "text": "\u05d0\u05d9\u05df \u05dc\u05d4\u05e9\u05ea\u05de\u05e9 \u05d1-Specifier \u05e9\u05dc \u05d0\u05d1\u05d7\u05e0\u05d4 \u05d2\u05e0\u05d8\u05d9\u05ea \u05e2\u05d1\u05d5\u05e8 ASD.",
          "isCorrect": false,
          "rationale": "\u05d4-DSM \u05de\u05d7\u05d9\u05d9\u05d1 \u05dc\u05d4\u05e9\u05ea\u05de\u05e9 \u05d1\u05de\u05e1\u05de\u05df \"associated with a known genetic condition\" \u05d1\u05de\u05e7\u05e8\u05d9\u05dd \u05db\u05d0\u05dc\u05d5 (DSM p.59)."
        }
      ],
      "hint": "\u05db\u05d9\u05e6\u05d3 \u05de\u05e9\u05ea\u05e0\u05d4 \u05d4\u05e4\u05e0\u05d5\u05d8\u05d9\u05e4 \u05d4\u05d7\u05d1\u05e8\u05ea\u05d9 \u05e9\u05dc \u05d1\u05e0\u05d5\u05ea \u05e2\u05dd \u05ea\u05e1\u05de\u05d5\u05e0\u05ea \u05e8\u05d8 \u05dc\u05d0\u05d5\u05e8\u05da \u05d6\u05de\u05df \u05d1\u05d4\u05e9\u05d5\u05d5\u05d0\u05d4 \u05dc\u05d0\u05d5\u05d8\u05d9\u05d6\u05dd?",
      "citation": "(DSM p.67)"
    },
    {
      "question": "\u05e0\u05e2\u05e8 \u05e2\u05dd $22q11.2$ deletion syndrome \u05de\u05d2\u05d9\u05e2 \u05dc\u05de\u05e2\u05e7\u05d1 \u05d1\u05d2\u05d9\u05dc $16$. \u05d4\u05d4\u05d5\u05e8\u05d9\u05dd \u05de\u05d3\u05d5\u05d5\u05d7\u05d9\u05dd \u05e2\u05dc \u05e0\u05e1\u05d9\u05d2\u05d4 \u05d7\u05d1\u05e8\u05ea\u05d9\u05ea \u05d7\u05d3\u05e9\u05d4, \u05d9\u05e8\u05d9\u05d3\u05d4 \u05d1\u05ea\u05e4\u05e7\u05d5\u05d3 \u05d4\u05dc\u05d9\u05de\u05d5\u05d3\u05d9 \u05d5\u05de\u05dc\u05de\u05d5\u05dc \u05dc\u05e2\u05e6\u05de\u05d5. \u05e2\u05dc \u05e1\u05de\u05da \u05d4\u05d9\u05d3\u05e2 \u05e2\u05dc \u05d4\u05d0\u05d8\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05d4 \u05d4\u05d2\u05e0\u05d8\u05d9\u05ea \u05e9\u05dc \u05d4\u05ea\u05e1\u05de\u05d5\u05e0\u05ea, \u05de\u05d4\u05d9 \u05d4\u05de\u05e9\u05de\u05e2\u05d5\u05ea \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05d4\u05de\u05e8\u05db\u05d6\u05d9\u05ea?",
      "answerOptions": [
        {
          "text": "\u05de\u05d7\u05d9\u05e7\u05d4 \u05d6\u05d5 \u05de\u05d4\u05d5\u05d5\u05d4 \u05d0\u05ea \u05d2\u05d5\u05e8\u05dd \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05d4\u05d2\u05e0\u05d8\u05d9 \u05d4\u05d2\u05d1\u05d5\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d4\u05de\u05d5\u05db\u05e8 \u05dc\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea Schizophrenia.",
          "isCorrect": true,
          "rationale": "\u05db-$25\\%$-$30\\%$ \u05de\u05e0\u05e9\u05d0\u05d9 \u05d4\u05de\u05d7\u05d9\u05e7\u05d4 \u05d1-$22q11.2$ \u05d9\u05e4\u05ea\u05d7\u05d5 \u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d4 \u05d0\u05d5 \u05e1\u05db\u05d9\u05d6\u05d5\u05e4\u05e8\u05e0\u05d9\u05d4, \u05d5\u05d6\u05d4\u05d5 \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05d4\u05d2\u05e0\u05d8\u05d9 \u05d4\u05d9\u05d3\u05d5\u05e2 \u05d4\u05d2\u05d1\u05d5\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05de\u05d7\u05dc\u05d4 \u05d6\u05d5 (Dulcan p.118)."
        },
        {
          "text": "\u05e1\u05d9\u05de\u05e0\u05d9\u05dd \u05d0\u05dc\u05d5 \u05d4\u05dd \u05db\u05db\u05dc \u05d4\u05e0\u05e8\u05d0\u05d4 \u05d1\u05d9\u05d8\u05d5\u05d9 \u05e9\u05dc Hypocalcemia \u05db\u05e8\u05d5\u05e0\u05d9\u05ea \u05d5\u05dc\u05d0 \u05de\u05e6\u05d1 \u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9.",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05e9\u05d9\u05db\u05d5\u05dc\u05d5\u05ea \u05dc\u05d4\u05d9\u05d5\u05ea \u05d1\u05e2\u05d9\u05d5\u05ea \u05d0\u05dc\u05e7\u05d8\u05e8\u05d5\u05dc\u05d9\u05d8\u05e8\u05d9\u05d5\u05ea, \u05d4\u05e0\u05e1\u05d9\u05d2\u05d4 \u05d4\u05ea\u05e4\u05e7\u05d5\u05d3\u05d9\u05ea \u05d5\u05d4\u05d7\u05d1\u05e8\u05ea\u05d9\u05ea \u05d1-22q \u05d1\u05d2\u05d9\u05dc \u05d6\u05d4 \u05de\u05db\u05d5\u05d5\u05e0\u05ea \u05d1\u05e8\u05d0\u05e9 \u05d5\u05d1\u05e8\u05d0\u05e9\u05d5\u05e0\u05d4 \u05dc\u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d4 (Dulcan p.118)."
        },
        {
          "text": "\u05d4\u05e0\u05e1\u05d9\u05d2\u05d4 \u05de\u05d5\u05e1\u05d1\u05e8\u05ea \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d4\u05e6\u05d8\u05d1\u05e8\u05d5\u05ea \u05e9\u05dc '\u05dc\u05d5\u05d7\u05d9\u05d5\u05ea \u05e2\u05de\u05d9\u05dc\u05d5\u05d0\u05d9\u05d3' \u05d1\u05d3\u05d5\u05de\u05d4 \u05dc-Down Syndrome.",
          "isCorrect": false,
          "rationale": "\u05e1\u05d9\u05db\u05d5\u05df \u05de\u05d5\u05d2\u05d1\u05e8 \u05dc-Alzheimer's \u05de\u05d5\u05e7\u05d3\u05dd \u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05d0\u05ea \u05ea\u05e1\u05de\u05d5\u05e0\u05ea Down, \u05d1\u05e2\u05d5\u05d3 \u05e9-22q \u05de\u05e7\u05d5\u05e9\u05e8\u05ea \u05dc\u05e1\u05db\u05d9\u05d6\u05d5\u05e4\u05e8\u05e0\u05d9\u05d4 (Dulcan p.119)."
        },
        {
          "text": "\u05de\u05d3\u05d5\u05d1\u05e8 \u05db\u05db\u05dc \u05d4\u05e0\u05e8\u05d0\u05d4 \u05d1-Behavioral Phenotype \u05e9\u05dc \u05d0\u05d2\u05e8\u05e1\u05d9\u05d1\u05d9\u05d5\u05ea \u05d5\u05d7\u05d9\u05d8\u05d5\u05d8 \u05d1\u05e2\u05d5\u05e8.",
          "isCorrect": false,
          "rationale": "\u05d7\u05d9\u05d8\u05d5\u05d8 \u05d1\u05e2\u05d5\u05e8 (Skin picking) \u05d4\u05d5\u05d0 \u05e4\u05e0\u05d5\u05d8\u05d9\u05e4 \u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05d9 \u05dc-Prader-Willi, \u05dc\u05d0 \u05dc-22q11.2 (Dulcan p.119)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05d4\u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9 \u05d4\u05de\u05d5\u05d2\u05d1\u05e8 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d4\u05de\u05e7\u05d5\u05e9\u05e8 \u05dc\u05de\u05d7\u05d9\u05e7\u05d4 \u05d6\u05d5 \u05d1\u05d1\u05d2\u05e8\u05d5\u05ea.",
      "citation": "(Dulcan p.118)"
    },
    {
      "question": "\u05de\u05d8\u05d5\u05e4\u05dc\u05ea \u05e2\u05dd Williams Syndrome (WS) \u05de\u05d5\u05e4\u05e0\u05d9\u05ea \u05dc\u05d4\u05e2\u05e8\u05db\u05d4 \u05e7\u05e8\u05d3\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea \u05ea\u05e7\u05d5\u05e4\u05ea\u05d9\u05ea. \u05de\u05e2\u05d1\u05e8 \u05dc\u05de\u05d5\u05de\u05d9 \u05dc\u05d1 \u05de\u05d1\u05e0\u05d9\u05d9\u05dd \u05db\u05de\u05d5 Supravalvular Aortic Stenosis, \u05de\u05d4\u05d5 \u05d4\u05de\u05de\u05e6\u05d0 \u05d4\u05d4\u05de\u05d5\u05d3\u05d9\u05e0\u05de\u05d9/\u05db\u05dc\u05d9\u05d9\u05ea\u05d9 \u05e9\u05d7\u05e9\u05d5\u05d1 \u05dc\u05e0\u05d8\u05e8 \u05dc\u05d0\u05d5\u05e8\u05da \u05d6\u05de\u05df \u05dc\u05e4\u05d9 \u05d4-Dulcan?",
      "answerOptions": [
        {
          "text": "\u05d4\u05d9\u05e6\u05e8\u05d5\u05ea \u05e2\u05d5\u05e8\u05e7\u05d9 \u05d4\u05db\u05dc\u05d9\u05d5\u05ea (Renal artery stenosis) \u05d5\u05d9\u05ea\u05e8 \u05dc\u05d7\u05e5 \u05d3\u05dd.",
          "isCorrect": true,
          "rationale": "\u05de\u05d8\u05d5\u05e4\u05dc\u05d9 Williams Syndrome \u05d6\u05e7\u05d5\u05e7\u05d9\u05dd \u05dc\u05de\u05e2\u05e7\u05d1 \u05d0\u05d7\u05e8 \u05dc\u05d7\u05e5 \u05d3\u05dd \u05d5\u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05d4\u05d9\u05e6\u05e8\u05d5\u05ea \u05e2\u05d5\u05e8\u05e7\u05d9 \u05d4\u05db\u05dc\u05d9\u05d5\u05ea \u05db\u05d7\u05dc\u05e7 \u05de\u05d4\u05e4\u05e0\u05d5\u05d8\u05d9\u05e4 \u05d4\u05e7\u05e8\u05d3\u05d9\u05d5\u05d5\u05e1\u05e7\u05d5\u05dc\u05e8\u05d9 (Dulcan p.118)."
        },
        {
          "text": "\u05db\u05e9\u05dc \u05d7\u05d9\u05e1\u05d5\u05e0\u05d9 \u05e9\u05dc \u05ea\u05d0\u05d9 T \u05d1\u05e9\u05dc \u05d4\u05d9\u05e4\u05d5\u05e4\u05dc\u05d6\u05d9\u05d4 \u05e9\u05dc \u05d4\u05ea\u05d9\u05de\u05d5\u05e1.",
          "isCorrect": false,
          "rationale": "\u05de\u05de\u05e6\u05d0 \u05d6\u05d4 (Thymic hypoplasia) \u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05d0\u05ea \u05ea\u05e1\u05de\u05d5\u05e0\u05ea 22q11.2 \u05d5\u05dc\u05d0 \u05d0\u05ea \u05ea\u05e1\u05de\u05d5\u05e0\u05ea Williams (Dulcan p.118)."
        },
        {
          "text": "\u05d4\u05d9\u05e4\u05d5\u05d2\u05d5\u05e0\u05d3\u05d9\u05d6\u05dd \u05d5\u05d3\u05d5\u05dd \u05e0\u05e9\u05d9\u05de\u05d4 \u05d1\u05e9\u05d9\u05e0\u05d4.",
          "isCorrect": false,
          "rationale": "\u05d0\u05dc\u05d5 \u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9\u05dd \u05e9\u05db\u05d9\u05d7\u05d9\u05dd \u05d1-Prader-Willi syndrome \u05d1\u05e9\u05dc \u05d4\u05e9\u05de\u05e0\u05ea \u05d9\u05ea\u05e8 \u05d5\u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd \u05d4\u05d5\u05e8\u05de\u05d5\u05e0\u05dc\u05d9\u05d9\u05dd (Dulcan p.119)."
        },
        {
          "text": "\u05e1\u05d9\u05db\u05d5\u05df \u05dc-Infantile spasms \u05d5\u05de\u05d9\u05e7\u05e8\u05d5\u05e6\u05e4\u05dc\u05d9\u05d4 \u05e4\u05e8\u05d5\u05d2\u05e8\u05e1\u05d9\u05d1\u05d9\u05ea.",
          "isCorrect": false,
          "rationale": "\u05de\u05d9\u05e7\u05e8\u05d5\u05e6\u05e4\u05dc\u05d9\u05d4 \u05e4\u05e8\u05d5\u05d2\u05e8\u05e1\u05d9\u05d1\u05d9\u05ea \u05d5\u05e1\u05d9\u05db\u05d5\u05df \u05d2\u05d1\u05d5\u05d4 \u05dc\u05e4\u05e8\u05db\u05d5\u05e1\u05d9\u05dd \u05de\u05d5\u05e7\u05d3\u05de\u05d9\u05dd \u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9\u05dd \u05d0\u05ea \u05ea\u05e1\u05de\u05d5\u05e0\u05ea Rett \u05d5\u05d0\u05ea Angelman syndrome (Dulcan p.119-120)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05e9\u05e4\u05e2\u05d5\u05ea \u05d4\u05de\u05d7\u05d9\u05e7\u05d4 \u05d1-7q \u05e2\u05dc \u05e8\u05e7\u05de\u05ea \u05d4\u05d7\u05d9\u05d1\u05d5\u05e8 \u05d5\u05d4\u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05d5\u05d5\u05e1\u05e7\u05d5\u05dc\u05e8\u05d9\u05ea.",
      "citation": "(Dulcan p.118)"
    },
    {
      "question": "\u05de\u05d4\u05d5 \u05d4\u05d1\u05e1\u05d9\u05e1 \u05d4\u05d0\u05d8\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9-\u05d2\u05e0\u05d8\u05d9 \u05d4\u05e9\u05db\u05d9\u05d7 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc-Prader-Willi Syndrome (PWS), \u05d5\u05db\u05d9\u05e6\u05d3 \u05d4\u05d5\u05d0 \u05de\u05e9\u05e4\u05d9\u05e2 \u05e2\u05dc \u05d4\u05de\u05d4\u05dc\u05da \u05d1\u05d9\u05e0\u05e7\u05d5\u05ea?",
      "answerOptions": [
        {
          "text": "\u05d7\u05e1\u05e8 \u05d1\u05d1\u05d9\u05d8\u05d5\u05d9 \u05e9\u05dc \u05d2\u05e0\u05d9\u05dd \u05d1\u05d0\u05d6\u05d5\u05e8 \u05d4\u05d0\u05d1\u05d4\u05d9 \u05e9\u05dc $15q11.2-q13$; \u05d2\u05d5\u05e8\u05dd \u05dc\u05d4\u05d9\u05e4\u05d5\u05d8\u05d5\u05e0\u05d9\u05d4 \u05d5\u05e7\u05e9\u05d9\u05d9 \u05d4\u05d0\u05db\u05dc\u05d4 \u05d1\u05d9\u05e0\u05e7\u05d5\u05ea.",
          "isCorrect": true,
          "rationale": "PWS \u05e0\u05d2\u05e8\u05dd \u05dc\u05e8\u05d5\u05d1 \u05de\u05de\u05d7\u05d9\u05e7\u05d4 \u05d0\u05d1\u05d4\u05d9\u05ea \u05d0\u05d5 UPD \u05d0\u05d9\u05de\u05d4\u05d9 \u05d1\u05db\u05e8\u05d5\u05de\u05d5\u05d6\u05d5\u05dd $15$, \u05d5\u05de\u05ea\u05d1\u05d8\u05d0 \u05ea\u05d7\u05d9\u05dc\u05d4 \u05d1-Hypotonia \u05d5-Failure to thrive (Dulcan p.119)."
        },
        {
          "text": "\u05de\u05d5\u05d8\u05e6\u05d9\u05d4 \u05d1\u05d2\u05df \u05d4-Elastin; \u05d2\u05d5\u05e8\u05de\u05ea \u05dc-Failure to thrive \u05d5\u05e7\u05d5\u05dc \u05e6\u05e8\u05d5\u05d3.",
          "isCorrect": false,
          "rationale": "\u05de\u05d5\u05d8\u05e6\u05d9\u05d4 \u05d0\u05d5 \u05de\u05d7\u05d9\u05e7\u05d4 \u05d1\u05d2\u05df \u05d4\u05d0\u05dc\u05e1\u05d8\u05d9\u05df (7q11.23) \u05d4\u05d9\u05d0 \u05d4\u05d1\u05e1\u05d9\u05e1 \u05dc\u05ea\u05e1\u05de\u05d5\u05e0\u05ea Williams, \u05dc\u05d0 \u05dc-PWS (Dulcan p.118)."
        },
        {
          "text": "\u05de\u05d7\u05d9\u05e7\u05d4 \u05d0\u05d9\u05de\u05d4\u05d9\u05ea \u05d1\u05d0\u05d6\u05d5\u05e8 $15q11.2-q13$; \u05d2\u05d5\u05e8\u05de\u05ea \u05dc\u05e6\u05d7\u05d5\u05e7 \u05d1\u05dc\u05ea\u05d9 \u05e0\u05e9\u05dc\u05d8 \u05d5\u05d0\u05d8\u05e7\u05e1\u05d9\u05d4.",
          "isCorrect": false,
          "rationale": "\u05de\u05d7\u05d9\u05e7\u05d4 \u05d0\u05d9\u05de\u05d4\u05d9\u05ea \u05d1\u05d0\u05d6\u05d5\u05e8 \u05d6\u05d4 \u05d2\u05d5\u05e8\u05de\u05ea \u05dc\u05ea\u05e1\u05de\u05d5\u05e0\u05ea Angelman, \u05d4\u05de\u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05ea \u05d1\u05e4\u05e0\u05d5\u05d8\u05d9\u05e4 \u05e9\u05dc \"Happy puppet\" (Dulcan p.119)."
        },
        {
          "text": "\u05d4\u05e9\u05ea\u05e7\u05d4 \u05e9\u05dc \u05d2\u05df \u05d4-FMR1; \u05d2\u05d5\u05e8\u05de\u05ea \u05dc\u05d4\u05d9\u05e4\u05e8-\u05d0\u05e7\u05e1\u05d9\u05d8\u05d1\u05d9\u05dc\u05d9\u05d5\u05ea \u05d5\u05d7\u05e8\u05d3\u05d4 \u05d7\u05d1\u05e8\u05ea\u05d9\u05ea.",
          "isCorrect": false,
          "rationale": "\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d6\u05d4 \u05d4\u05d5\u05d0 \u05d4\u05d1\u05e1\u05d9\u05e1 \u05dc\u05ea\u05e1\u05de\u05d5\u05e0\u05ea Fragile X, \u05dc\u05d0 \u05dc-PWS (Dulcan p.120)."
        }
      ],
      "hint": "\u05d4\u05ea\u05de\u05e7\u05d3 \u05d1\u05de\u05e7\u05d5\u05e8 \u05d4\u05d4\u05d5\u05e8\u05d9 \u05e9\u05dc \u05d4\u05de\u05d7\u05d9\u05e7\u05d4 \u05d1\u05db\u05e8\u05d5\u05de\u05d5\u05d6\u05d5\u05dd 15 \u05d5\u05d1\u05e9\u05dc\u05d1 \u05d4'\u05e8\u05e4\u05d5\u05d9' \u05e9\u05dc \u05d4\u05ea\u05d9\u05e0\u05d5\u05e7.",
      "citation": "(Dulcan p.119)"
    }
  ]
}