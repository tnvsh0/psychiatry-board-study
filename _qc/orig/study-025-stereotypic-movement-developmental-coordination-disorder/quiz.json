{
  "title": "Neurodevelopmental Quiz",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\u05d9\u05dc\u05d3 \u05d1\u05df 8 \u05de\u05d5\u05e4\u05e0\u05d4 \u05dc\u05d4\u05e2\u05e8\u05db\u05d4 \u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9\u05ea \u05d1\u05e9\u05dc \u05e7\u05e9\u05d9\u05d9\u05dd \u05dc\u05d9\u05de\u05d5\u05d3\u05d9\u05d9\u05dd. \u05d4\u05de\u05d5\u05e8\u05d4 \u05de\u05d3\u05d5\u05d5\u05d7\u05ea \u05db\u05d9 \u05d4\u05d5\u05d0 \u05d0\u05d9\u05d8\u05d9 \u05de\u05d0\u05d5\u05d3 \u05d1\u05de\u05d8\u05dc\u05d5\u05ea \u05db\u05ea\u05d9\u05d1\u05d4, \u05db\u05ea\u05d1 \u05d9\u05d3\u05d5 \u05db\u05de\u05e2\u05d8 \u05d0\u05d9\u05e0\u05d5 \u05e7\u05e8\u05d9\u05d0, \u05d5\u05d4\u05d5\u05d0 \u05e0\u05de\u05e0\u05e2 \u05d1\u05d0\u05d5\u05e4\u05df \u05e2\u05e7\u05d1\u05d9 \u05de\u05de\u05e9\u05d7\u05e7\u05d9 \u05db\u05d3\u05d5\u05e8 \u05d1\u05d4\u05e4\u05e1\u05e7\u05d4 \u05db\u05d9\u05d5\u05d5\u05df \u05e9\u05d4\u05d5\u05d0 '\u05ea\u05de\u05d9\u05d3 \u05de\u05e4\u05d9\u05dc \u05d0\u05ea \u05d4\u05db\u05d3\u05d5\u05e8'. \u05d1\u05d1\u05d3\u05d9\u05e7\u05d4 \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05dc\u05d0 \u05e0\u05de\u05e6\u05d0\u05d5 \u05e1\u05d9\u05de\u05e0\u05d9\u05dd \u05e9\u05dc distractibility \u05d0\u05d5 impulsivity, \u05d0\u05da \u05e0\u05e6\u05e4\u05ea\u05d4 \u05de\u05d5\u05e8\u05db\u05d1\u05d5\u05ea \u05e0\u05d9\u05db\u05e8\u05ea \u05d1\u05d1\u05d9\u05e6\u05d5\u05e2 \u05e4\u05e2\u05d5\u05dc\u05d5\u05ea \u05de\u05d5\u05d8\u05d5\u05e8\u05d9\u05d5\u05ea \u05e2\u05d3\u05d9\u05e0\u05d5\u05ea. \u05de\u05d4\u05d9 \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05e1\u05d1\u05d9\u05e8\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8?",
      "answerOptions": [
        {
          "text": "Developmental Coordination Disorder (DCD)",
          "isCorrect": true,
          "rationale": "\u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05de\u05ea\u05d1\u05e1\u05e1\u05ea \u05e2\u05dc \u05dc\u05d9\u05e7\u05d5\u05d9 \u05d1\u05e8\u05db\u05d9\u05e9\u05d4 \u05d5\u05d1\u05d9\u05e6\u05d5\u05e2 \u05e9\u05dc \u05de\u05d9\u05d5\u05de\u05e0\u05d5\u05d9\u05d5\u05ea \u05de\u05d5\u05d8\u05d5\u05e8\u05d9\u05d5\u05ea (Criterion A) \u05d4\u05de\u05e4\u05e8\u05d9\u05e2 \u05d1\u05d0\u05d5\u05e4\u05df \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9 \u05dc-ADL \u05d5\u05dc\u05d4\u05d9\u05e9\u05d2\u05d9\u05dd \u05d0\u05e7\u05d3\u05de\u05d9\u05d9\u05dd (Criterion B), \u05db\u05e4\u05d9 \u05e9\u05de\u05ea\u05d1\u05d8\u05d0 \u05d1\u05db\u05ea\u05d9\u05d1\u05d4 \u05d5\u05d1\u05de\u05e9\u05d7\u05e7\u05d9 \u05db\u05d3\u05d5\u05e8 (DSM p.86)."
        },
        {
          "text": "Attention-Deficit/Hyperactivity Disorder (ADHD)",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05e9\u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd ADHD \u05e2\u05e9\u05d5\u05d9\u05d9\u05dd \u05dc\u05d4\u05e4\u05d9\u05dc \u05d7\u05e4\u05e6\u05d9\u05dd, \u05d1\u05de\u05e7\u05e8\u05d4 \u05d6\u05d4 \u05e0\u05e9\u05dc\u05dc\u05d5 distractibility \u05d5-impulsivity, \u05d5\u05d4\u05d3\u05d2\u05e9 \u05d4\u05d5\u05d0 \u05e2\u05dc \u05d7\u05d5\u05e1\u05e8 \u05e7\u05d5\u05d0\u05d5\u05e8\u05d3\u05d9\u05e0\u05e6\u05d9\u05d4 \u05de\u05d5\u05d8\u05d5\u05e8\u05d9\u05ea \u05dc\u05d9\u05d1\u05ea\u05d9\u05ea (DSM p.88)."
        },
        {
          "text": "Autism Spectrum Disorder (ASD)",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05e9-DCD \u05e9\u05db\u05d9\u05d7 \u05d1-ASD, \u05d0\u05d9\u05df \u05d1\u05ea\u05d9\u05d0\u05d5\u05e8 \u05d4\u05de\u05e7\u05e8\u05d4 \u05e2\u05d3\u05d5\u05ea \u05dc\u05dc\u05d9\u05e7\u05d5\u05d9 \u05d1\u05ea\u05e7\u05e9\u05d5\u05e8\u05ea \u05d7\u05d1\u05e8\u05ea\u05d9\u05ea \u05d0\u05d5 \u05d3\u05e4\u05d5\u05e1\u05d9\u05dd \u05e8\u05e4\u05d8\u05d9\u05d8\u05d9\u05d1\u05d9\u05d9\u05dd \u05d4\u05de\u05d4\u05d5\u05d5\u05d9\u05dd \u05d0\u05ea \u05dc\u05d9\u05d1\u05ea \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc ASD (DSM p.88)."
        },
        {
          "text": "Specific Learning Disorder with impairment in written expression",
          "isCorrect": false,
          "rationale": "\u05d4\u05dc\u05e7\u05d5\u05ea \u05d1\u05db\u05ea\u05d9\u05d1\u05d4 \u05d1\u05de\u05e7\u05e8\u05d4 \u05d6\u05d4 \u05e0\u05d5\u05d1\u05e2\u05ea \u05de\u05e8\u05db\u05d9\u05d1 \u05de\u05d5\u05d8\u05d5\u05e8\u05d9 (Motoric component) \u05d5\u05dc\u05d0 \u05de\u05e7\u05d5\u05e9\u05d9 \u05d1\u05e9\u05e4\u05d4, \u05d0\u05d9\u05d5\u05ea \u05d0\u05d5 \u05d0\u05e8\u05d2\u05d5\u05df \u05ea\u05db\u05e0\u05d9\u05dd, \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9\u05dd \u05dc\u05e7\u05d5\u05ea \u05dc\u05de\u05d9\u05d3\u05d4 (DSM p.86)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05dc\u05d9\u05e7\u05d5\u05d9 \u05d4\u05de\u05d5\u05d8\u05d5\u05e8\u05d9 \u05d4\u05db\u05dc\u05dc\u05d9 \u05d4\u05de\u05e9\u05e4\u05d9\u05e2 \u05e2\u05dc \u05ea\u05e4\u05e7\u05d5\u05d3\u05d9 \u05d9\u05d5\u05de\u05d9\u05d5\u05dd \u05d5\u05e2\u05dc \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05de\u05d1\u05d3\u05dc\u05ea \u05de\u05d5\u05dc \u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05e7\u05e9\u05d1.",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05e4\u05e2\u05d5\u05d8 \u05d1\u05df \u05e9\u05e0\u05ea\u05d9\u05d9\u05dd \u05d5\u05d7\u05e6\u05d9 \u05de\u05d5\u05d1\u05d0 \u05dc\u05de\u05e8\u05e4\u05d0\u05d4 \u05d1\u05e9\u05dc \u05ea\u05e0\u05d5\u05e2\u05d5\u05ea '\u05de\u05d5\u05d6\u05e8\u05d5\u05ea'. \u05d4\u05d5\u05e8\u05d9\u05d5 \u05de\u05ea\u05d0\u05e8\u05d9\u05dd \u05db\u05d9 \u05d1\u05db\u05dc \u05e4\u05e2\u05dd \u05e9\u05d4\u05d5\u05d0 \u05de\u05ea\u05e8\u05d2\u05e9, \u05d4\u05d5\u05d0 \u05de\u05ea\u05d7\u05d9\u05dc \u05dc\u05e0\u05e4\u05e0\u05e3 \u05d1\u05d9\u05d3\u05d9\u05d5 \u05d1\u05ea\u05e0\u05d5\u05e2\u05d5\u05ea \u05e7\u05e6\u05d1\u05d9\u05d5\u05ea \u05e9\u05e0\u05de\u05e9\u05db\u05d5\u05ea \u05d3\u05e7\u05d4 \u05d0\u05d5 \u05e9\u05ea\u05d9\u05d9\u05dd. \u05d4\u05ea\u05e0\u05d5\u05e2\u05d5\u05ea \u05e0\u05e2\u05dc\u05de\u05d5\u05ea \u05de\u05d9\u05d3 \u05db\u05d0\u05e9\u05e8 \u05e7\u05d5\u05e8\u05d0\u05d9\u05dd \u05d1\u05e9\u05de\u05d5 \u05d0\u05d5 \u05de\u05e1\u05d9\u05d7\u05d9\u05dd \u05d0\u05ea \u05d3\u05e2\u05ea\u05d5. \u05d4\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea \u05d4\u05d7\u05d1\u05e8\u05ea\u05d9\u05ea \u05d5\u05d4\u05e9\u05e4\u05ea\u05d9\u05ea \u05ea\u05e7\u05d9\u05e0\u05d4 \u05dc\u05d2\u05d9\u05dc\u05d5. \u05de\u05d4\u05d5 \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9 \u05d4\u05de\u05d1\u05d3\u05d9\u05dc \u05de\u05e7\u05e8\u05d4 \u05d6\u05d4 \u05de-Tourette's Disorder?",
      "answerOptions": [
        {
          "text": "\u05d4\u05ea\u05e0\u05d5\u05e2\u05d5\u05ea \u05d4\u05df \u05e7\u05e6\u05d1\u05d9\u05d5\u05ea (Rhythmical) \u05d5\u05de\u05d5\u05e4\u05d9\u05e2\u05d5\u05ea \u05dc\u05e4\u05e0\u05d9 \u05d2\u05d9\u05dc 3.",
          "isCorrect": true,
          "rationale": "\u05e1\u05d8\u05e8\u05d0\u05d5\u05d8\u05d9\u05e4\u05d9\u05d5\u05ea \u05de\u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05d5\u05ea \u05d1\u05d3\u05e4\u05d5\u05e1 \u05e7\u05e6\u05d1\u05d9 \u05d5\u05e7\u05d1\u05d5\u05e2 \u05e2\u05dd \u05d2\u05d9\u05dc \u05d4\u05d5\u05e4\u05e2\u05d4 \u05de\u05d5\u05e7\u05d3\u05dd (\u05dc\u05e4\u05e0\u05d9 3), \u05d1\u05e2\u05d5\u05d3 \u05d8\u05d9\u05e7\u05d9\u05dd \u05d4\u05dd \u05d1\u05d3'\u05db \u05e4\u05ea\u05d0\u05d5\u05de\u05d9\u05d9\u05dd, \u05dc\u05d0 \u05e7\u05e6\u05d1\u05d9\u05d9\u05dd \u05d5\u05de\u05d5\u05e4\u05d9\u05e2\u05d9\u05dd \u05d1\u05de\u05de\u05d5\u05e6\u05e2 \u05d1\u05d2\u05d9\u05dc 4\u20136 (DSM p.91-92)."
        },
        {
          "text": "\u05d4\u05ea\u05e0\u05d5\u05e2\u05d5\u05ea \u05de\u05d5\u05e4\u05d9\u05e2\u05d5\u05ea \u05e8\u05e7 \u05d1\u05e2\u05ea \u05d4\u05ea\u05e8\u05d2\u05e9\u05d5\u05ea.",
          "isCorrect": false,
          "rationale": "\u05d4\u05df \u05d8\u05d9\u05e7\u05d9\u05dd \u05d5\u05d4\u05df \u05e1\u05d8\u05e8\u05d0\u05d5\u05d8\u05d9\u05e4\u05d9\u05d5\u05ea \u05d9\u05db\u05d5\u05dc\u05d9\u05dd \u05dc\u05d4\u05d7\u05de\u05d9\u05e8 \u05d1\u05e2\u05ea \u05d4\u05ea\u05e8\u05d2\u05e9\u05d5\u05ea \u05d0\u05d5 \u05de\u05ea\u05d7, \u05d5\u05dc\u05db\u05df \u05d6\u05d4\u05d5 \u05d0\u05d9\u05e0\u05d5 \u05de\u05d3\u05d3 \u05de\u05d1\u05d3\u05d9\u05dc \u05de\u05d5\u05d7\u05dc\u05d8 (DSM p.90)."
        },
        {
          "text": "\u05d4\u05ea\u05e0\u05d5\u05e2\u05d5\u05ea \u05de\u05e2\u05e8\u05d1\u05d5\u05ea \u05d0\u05ea \u05d4\u05d2\u05e4\u05d9\u05d9\u05dd \u05d4\u05e2\u05dc\u05d9\u05d5\u05e0\u05d5\u05ea.",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05e9\u05e1\u05d8\u05e8\u05d0\u05d5\u05d8\u05d9\u05e4\u05d9\u05d5\u05ea \u05de\u05e2\u05e8\u05d1\u05d5\u05ea \u05dc\u05e2\u05d9\u05ea\u05d9\u05dd \u05e7\u05e8\u05d5\u05d1\u05d5\u05ea \u05d0\u05ea \u05d4\u05d9\u05d3\u05d9\u05d9\u05dd, \u05d2\u05dd \u05d8\u05d9\u05e7\u05d9\u05dd \u05de\u05d5\u05d8\u05d5\u05e8\u05d9\u05d9\u05dd \u05de\u05d5\u05e8\u05db\u05d1\u05d9\u05dd \u05d9\u05db\u05d5\u05dc\u05d9\u05dd \u05dc\u05e2\u05e8\u05d1 \u05d2\u05e4\u05d9\u05d9\u05dd (DSM p.92)."
        },
        {
          "text": "\u05d4\u05d9\u05dc\u05d3 \u05d0\u05d9\u05e0\u05d5 \u05de\u05d3\u05d5\u05d5\u05d7 \u05e2\u05dc \u05ea\u05d7\u05d5\u05e9\u05ea \u05d3\u05d7\u05e3 \u05de\u05e7\u05d3\u05d9\u05de\u05d4 (Premonitory urge).",
          "isCorrect": false,
          "rationale": "\u05d1\u05d2\u05d9\u05dc \u05e9\u05e0\u05ea\u05d9\u05d9\u05dd \u05d5\u05d7\u05e6\u05d9, \u05d9\u05dc\u05d3\u05d9\u05dd \u05dc\u05e8\u05d5\u05d1 \u05d0\u05d9\u05e0\u05dd \u05de\u05e1\u05d5\u05d2\u05dc\u05d9\u05dd \u05dc\u05d3\u05d5\u05d5\u05d7 \u05e2\u05dc \u05d3\u05d7\u05e3 \u05de\u05e7\u05d3\u05d9\u05dd \u05d2\u05dd \u05d0\u05dd \u05de\u05d3\u05d5\u05d1\u05e8 \u05d1\u05d8\u05d9\u05e7\u05d9\u05dd, \u05d5\u05dc\u05db\u05df \u05d6\u05d4\u05d5 \u05de\u05d3\u05d3 \u05e4\u05d7\u05d5\u05ea \u05d0\u05de\u05d9\u05df \u05d1\u05d2\u05d9\u05dc \u05d4\u05e8\u05da (Dulcan p.438, p.444)."
        }
      ],
      "hint": "\u05d4\u05ea\u05de\u05e7\u05d3 \u05d1\u05d0\u05d5\u05e4\u05d9 \u05d4\u05ea\u05e0\u05d5\u05e2\u05d4 (\u05e7\u05e6\u05d1\u05d9\u05d5\u05ea) \u05d5\u05d1\u05d2\u05d9\u05dc \u05d4\u05d4\u05d5\u05e4\u05e2\u05d4 \u05d4\u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05d9 \u05dc\u05db\u05dc \u05d0\u05d7\u05ea \u05de\u05d4\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea.",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05e0\u05e2\u05e8 \u05d1\u05df 14 \u05e2\u05dd \u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc Intellectual Disability (ID) \u05e7\u05e9\u05d4 \u05d5-Autism Spectrum Disorder (ASD) \u05de\u05e6\u05d9\u05d2 \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05e4\u05d5\u05d2\u05e2\u05e0\u05d9\u05ea \u05e2\u05e6\u05de\u05d9\u05ea (SIB) \u05d7\u05de\u05d5\u05e8\u05d4 \u05de\u05e1\u05d5\u05d2 Head banging \u05d4\u05d2\u05d5\u05e8\u05de\u05ea \u05dc\u05d7\u05d1\u05dc\u05d5\u05ea. \u05dc\u05d0\u05d7\u05e8 \u05db\u05d9\u05e9\u05dc\u05d5\u05df \u05e9\u05dc \u05d4\u05ea\u05e2\u05e8\u05d1\u05d5\u05d9\u05d5\u05ea \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea\u05d9\u05d5\u05ea, \u05d4\u05d5\u05d7\u05dc\u05d8 \u05e2\u05dc \u05e9\u05d9\u05dc\u05d5\u05d1 \u05d8\u05d9\u05e4\u05d5\u05dc \u05ea\u05e8\u05d5\u05e4\u05ea\u05d9. \u05de\u05d4\u05d5 \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d4\u05e2\u05d5\u05de\u05d3 \u05d1\u05d1\u05e1\u05d9\u05e1 \u05d4\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1-Naltrexone \u05d1\u05de\u05e7\u05e8\u05d4 \u05d6\u05d4?",
      "answerOptions": [
        {
