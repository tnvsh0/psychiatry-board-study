      "question": "\u05e2\u05dc \u05e4\u05d9 \u05de\u05d7\u05e7\u05e8\u05d9\u05dd \u05e0\u05d5\u05d9\u05e8\u05d5-\u05d0\u05e0\u05d8\u05d5\u05de\u05d9\u05d9\u05dd, \u05d9\u05dc\u05d3\u05d9\u05dd \u05d4\u05e1\u05d5\u05d1\u05dc\u05d9\u05dd \u05de-Stereotypic Movement Disorder \u05de\u05e6\u05d9\u05d2\u05d9\u05dd \u05d9\u05e8\u05d9\u05d3\u05d4 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05d1\u05e0\u05e4\u05d7 \u05d4-___, \u05de\u05de\u05e6\u05d0 \u05d4\u05de\u05e8\u05de\u05d6 \u05e2\u05dc \u05e4\u05d2\u05d9\u05e2\u05d4 \u05d1\u05de\u05e1\u05dc\u05d5\u05dc\u05d9\u05dd \u05d4\u05e7\u05d5\u05e8\u05d8\u05d9\u05e7\u05d5-\u05e1\u05d8\u05e8\u05d9\u05d0\u05d8\u05dc\u05d9\u05d9\u05dd \u05d4\u05e7\u05e9\u05d5\u05e8\u05d9\u05dd \u05dc\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05d9\u05d5\u05ea \u05d4\u05e8\u05d2\u05dc.",
      "bestAnswer": "putamen",
      "acceptableAnswers": [
        "putamen volume",
        "posterior putamen"
      ],
      "rationale": "\u05de\u05d7\u05e7\u05e8\u05d9\u05dd \u05d4\u05e8\u05d0\u05d5 \u05d9\u05e8\u05d9\u05d3\u05d4 \u05d1\u05e0\u05e4\u05d7 \u05d4\u05e4\u05d5\u05d8\u05de\u05df, \u05de\u05d4 \u05e9\u05de\u05e6\u05d1\u05d9\u05e2 \u05e2\u05dc \u05de\u05e2\u05d5\u05e8\u05d1\u05d5\u05ea \u05e9\u05dc \u05de\u05e2\u05d2\u05dc\u05d9\u05dd \u05de\u05d5\u05d8\u05d5\u05e8\u05d9\u05d9\u05dd \u05d4\u05e7\u05e9\u05d5\u05e8\u05d9\u05dd \u05dc\u05d4\u05e8\u05d2\u05dc\u05d9\u05dd (Habitual behaviors) \u05d1\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d6\u05d5 (DSM p.91).",
      "hint": "\u05d6\u05d4\u05d5 \u05de\u05d1\u05e0\u05d4 \u05de\u05e8\u05db\u05d6\u05d9 \u05d1\u05e1\u05d8\u05e8\u05d9\u05d0\u05d8\u05d5\u05dd \u05d4\u05d2\u05d1\u05d9 (Dorsal Striatum) \u05d4\u05de\u05e2\u05d5\u05e8\u05d1 \u05d1\u05d1\u05e7\u05e8\u05d4 \u05de\u05d5\u05d8\u05d5\u05e8\u05d9\u05ea."
    },
    {
      "type": "multiple_select",
      "question": "\u05d0\u05d9\u05dc\u05d5 \u05de\u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9\u05dd \u05d4\u05d1\u05d0\u05d9\u05dd \u05e0\u05db\u05d5\u05e0\u05d9\u05dd \u05dc\u05d2\u05d1\u05d9 \u05d4\u05de\u05d4\u05dc\u05da \u05d5\u05d4\u05d0\u05e4\u05d9\u05d3\u05de\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05d4 \u05e9\u05dc Developmental Coordination Disorder (DCD)?",
      "answerOptions": [
        {
          "text": "\u05d4\u05e4\u05e8\u05e2\u05d4 \u05e9\u05db\u05d9\u05d7\u05d4 \u05d9\u05d5\u05ea\u05e8 \u05d1\u05d6\u05db\u05e8\u05d9\u05dd, \u05e2\u05dd \u05d9\u05d7\u05e1 \u05d6\u05db\u05e8:\u05e0\u05e7\u05d1\u05d4 \u05e9\u05e0\u05e2 \u05d1\u05d9\u05df 2:1 \u05dc-7:1.",
          "isCorrect": true,
          "rationale": "\u05d4\u05d0\u05e4\u05d9\u05d3\u05de\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05d4 \u05de\u05e8\u05d0\u05d4 \u05e2\u05d3\u05d9\u05e4\u05d5\u05ea \u05d1\u05e8\u05d5\u05e8\u05d4 \u05dc\u05d6\u05db\u05e8\u05d9\u05dd \u05d1\u05d8\u05d5\u05d5\u05d7 \u05d4\u05d9\u05d7\u05e1\u05d9\u05dd \u05e9\u05e6\u05d5\u05d9\u05df (DSM p.87)."
        },
        {
          "text": "\u05d1\u05db-50% \u05e2\u05d3 70% \u05de\u05d4\u05de\u05e7\u05e8\u05d9\u05dd, \u05d4\u05e7\u05e9\u05d9\u05d9\u05dd \u05d4\u05de\u05d5\u05d8\u05d5\u05e8\u05d9\u05d9\u05dd \u05e0\u05de\u05e9\u05db\u05d9\u05dd \u05d0\u05dc \u05d2\u05d9\u05dc \u05d4\u05d4\u05ea\u05d1\u05d2\u05e8\u05d5\u05ea \u05d5\u05d4\u05d1\u05d2\u05e8\u05d5\u05ea.",
          "isCorrect": true,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05e9\u05d9\u05d9\u05ea\u05db\u05df \u05e9\u05d9\u05e4\u05d5\u05e8, \u05e2\u05d1\u05d5\u05e8 \u05e8\u05d5\u05d1 \u05d4\u05d9\u05dc\u05d3\u05d9\u05dd \u05d4\u05d4\u05e4\u05e8\u05e2\u05d4 \u05d0\u05d9\u05e0\u05d4 \u05d7\u05d5\u05dc\u05e4\u05ea \u05d5\u05d4\u05d9\u05d0 \u05d9\u05e6\u05d9\u05d1\u05d4 \u05d9\u05d7\u05e1\u05d9\u05ea \u05dc\u05d0\u05d5\u05e8\u05da \u05d6\u05de\u05df (DSM p.87)."
        },
        {
          "text": "\u05e4\u05d2\u05d5\u05ea (Prematurity) \u05d5\u05de\u05e9\u05e7\u05dc \u05dc\u05d9\u05d3\u05d4 \u05e0\u05de\u05d5\u05da \u05de\u05d4\u05d5\u05d5\u05d9\u05dd \u05d2\u05d5\u05e8\u05de\u05d9 \u05e1\u05d9\u05db\u05d5\u05df \u05e1\u05d1\u05d9\u05d1\u05ea\u05d9\u05d9\u05dd \u05dc\u05d4\u05e4\u05e8\u05e2\u05d4.",
          "isCorrect": true,
          "rationale": "\u05d2\u05d5\u05e8\u05de\u05d9\u05dd \u05d0\u05dc\u05d5 \u05e0\u05de\u05e6\u05d0\u05d5 \u05e7\u05e9\u05d5\u05e8\u05d9\u05dd \u05dc\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea DCD (DSM p.87)."
        },
        {
          "text": "\u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05e0\u05d9\u05ea\u05e0\u05ea \u05dc\u05e8\u05d5\u05d1 \u05dc\u05e4\u05e0\u05d9 \u05d2\u05d9\u05dc 5 \u05d1\u05e9\u05dc \u05d4\u05d9\u05e6\u05d9\u05d1\u05d5\u05ea \u05e9\u05dc \u05d4\u05de\u05d3\u05d9\u05d3\u05d5\u05ea \u05d4\u05de\u05d5\u05d8\u05d5\u05e8\u05d9\u05d5\u05ea \u05d1\u05d2\u05d9\u05dc \u05d4\u05e8\u05da.",
          "isCorrect": false,
          "rationale": "\u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05dc\u05e8\u05d5\u05d1 \u05dc\u05d0 \u05e0\u05d9\u05ea\u05e0\u05ea \u05dc\u05e4\u05e0\u05d9 \u05d2\u05d9\u05dc 5 \u05d1\u05e9\u05dc \u05d5\u05e8\u05d9\u05d0\u05d1\u05d9\u05dc\u05d9\u05d5\u05ea \u05e8\u05d1\u05d4 \u05d1\u05e8\u05db\u05d9\u05e9\u05ea \u05de\u05d9\u05d5\u05de\u05e0\u05d5\u05d9\u05d5\u05ea \u05d5\u05d7\u05d5\u05e1\u05e8 \u05d9\u05e6\u05d9\u05d1\u05d5\u05ea \u05e9\u05dc \u05d4\u05de\u05d3\u05d9\u05d3\u05d5\u05ea \u05d1\u05d2\u05d9\u05dc\u05d0\u05d9\u05dd \u05e6\u05e2\u05d9\u05e8\u05d9\u05dd \u05d9\u05d5\u05ea\u05e8 (DSM p.86)."
        }
      ],
      "hint": "\u05d4\u05ea\u05de\u05e7\u05d3 \u05d1\u05d9\u05d7\u05e1 \u05d4\u05de\u05d9\u05e0\u05d9\u05dd, \u05d2\u05d5\u05e8\u05de\u05d9 \u05e1\u05d9\u05db\u05d5\u05df \u05d5\u05d4\u05e4\u05e8\u05d5\u05d2\u05e0\u05d5\u05d6\u05d4 \u05d0\u05e8\u05d5\u05db\u05ea \u05d4\u05d8\u05d5\u05d5\u05d7.",
      "hasAllOfTheAbove": false,
      "hasNoneOfTheAbove": false
    },
    {
      "type": "short_answer",
      "question": "\u05ea\u05d0\u05e8 \u05d0\u05ea \u05d4\u05d4\u05d1\u05d3\u05dc \u05d4\u05e2\u05d9\u05e7\u05e8\u05d9 \u05d1\u05d7\u05d5\u05d5\u05d9\u05d4 \u05d4\u05e8\u05d2\u05e9\u05d9\u05ea (Ego-syntonic vs. Ego-dystonic) \u05d5\u05d1\u05d9\u05db\u05d5\u05dc\u05ea \u05d4\u05d3\u05d9\u05db\u05d5\u05d9 (Suppressibility) \u05d1\u05d9\u05df Stereotypic movements \u05dc\u05d1\u05d9\u05df Tics.",
      "grading": {
        "modelAnswer": "Stereotypic movements \u05d4\u05df \u05dc\u05e8\u05d5\u05d1 \u05d0\u05d2\u05d5-\u05e1\u05d9\u05e0\u05d8\u05d5\u05e0\u05d9\u05d5\u05ea, \u05d4\u05d9\u05dc\u05d3 \u05e9\u05d5\u05d0\u05d1 \u05de\u05d4\u05df \u05d4\u05e0\u05d0\u05d4 \u05d0\u05d5 \u05d4\u05e8\u05d2\u05e2\u05d4, \u05d5\u05d4\u05df \u05e0\u05d9\u05ea\u05e0\u05d5\u05ea \u05dc\u05d4\u05e4\u05e1\u05e7\u05d4 \u05d1\u05e7\u05dc\u05d5\u05ea \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d4\u05e1\u05d7\u05ea \u05d3\u05e2\u05ea \u05d0\u05d5 \u05d2\u05d9\u05e8\u05d5\u05d9 \u05ea\u05d7\u05d5\u05e9\u05ea\u05d9. \u05dc\u05e2\u05d5\u05de\u05ea \u05d6\u05d0\u05ea, Tics \u05d4\u05dd \u05dc\u05e8\u05d5\u05d1 \u05d0\u05d2\u05d5-\u05d3\u05d9\u05e1\u05d8\u05d5\u05e0\u05d9\u05d9\u05dd (\u05e0\u05ea\u05e4\u05e1\u05d9\u05dd \u05db\u05de\u05e6\u05d9\u05e7\u05d9\u05dd), \u05de\u05dc\u05d5\u05d5\u05d9\u05dd \u05d1\u05d3\u05d7\u05e3 \u05de\u05e7\u05d3\u05d9\u05dd (Premonitory urge), \u05d5\u05e0\u05d9\u05ea\u05e0\u05d9\u05dd \u05dc\u05d3\u05d9\u05db\u05d5\u05d9 \u05e8\u05e6\u05d5\u05e0\u05d9 \u05d6\u05de\u05e0\u05d9 \u05d1\u05dc\u05d1\u05d3 \u05d4\u05db\u05e8\u05d5\u05da \u05d1\u05de\u05ea\u05d7 \u05d4\u05d5\u05dc\u05da \u05d5\u05d2\u05d5\u05d1\u05e8.",
        "rationale": "\u05d4\u05d4\u05d1\u05d3\u05dc \u05d1\u05d7\u05d5\u05d5\u05d9\u05d4 \u05d4\u05e8\u05d2\u05e9\u05d9\u05ea \u05d5\u05d9\u05db\u05d5\u05dc\u05ea \u05d4\u05d3\u05d9\u05db\u05d5\u05d9 \u05de\u05d4\u05d5\u05d5\u05d4 \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df \u05e7\u05dc\u05d9\u05e0\u05d9 \u05de\u05e8\u05db\u05d6\u05d9 \u05d1\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05de\u05d1\u05d3\u05dc\u05ea \u05d1\u05d9\u05df \u05e9\u05ea\u05d9 \u05d4\u05ea\u05d5\u05e4\u05e2\u05d5\u05ea (DSM p.92).",
        "requiredAttributes": [
          "\u05e6\u05d9\u05d5\u05df \u05e9\u05e1\u05d8\u05e8\u05d0\u05d5\u05d8\u05d9\u05e4\u05d9\u05d5\u05ea \u05d4\u05df \u05d0\u05d2\u05d5-\u05e1\u05d9\u05e0\u05d8\u05d5\u05e0\u05d9\u05d5\u05ea/\u05de\u05d4\u05e0\u05d5\u05ea.",
          "\u05e6\u05d9\u05d5\u05df \u05e9\u05d8\u05d9\u05e7\u05d9\u05dd \u05d4\u05dd \u05d0\u05d2\u05d5-\u05d3\u05d9\u05e1\u05d8\u05d5\u05e0\u05d9\u05d9\u05dd/\u05de\u05e6\u05d9\u05e7\u05d9\u05dd.",
          "\u05d4\u05e1\u05d1\u05e8 \u05e9\u05e1\u05d8\u05e8\u05d0\u05d5\u05d8\u05d9\u05e4\u05d9\u05d5\u05ea \u05e0\u05e4\u05e1\u05e7\u05d5\u05ea \u05d1\u05e7\u05dc\u05d5\u05ea \u05e2'\u05d9 \u05d4\u05e1\u05d7\u05ea \u05d3\u05e2\u05ea.",
          "\u05d4\u05e1\u05d1\u05e8 \u05e9\u05d8\u05d9\u05e7\u05d9\u05dd \u05e0\u05d9\u05ea\u05e0\u05d9\u05dd \u05dc\u05d3\u05d9\u05db\u05d5\u05d9 \u05e8\u05e6\u05d5\u05e0\u05d9 \u05d0\u05da \u05d6\u05de\u05e0\u05d9."
        ],
        "errors": {
          "misconceptions": [
            "\u05d4\u05e0\u05d7\u05d4 \u05e9\u05e1\u05d8\u05e8\u05d0\u05d5\u05d8\u05d9\u05e4\u05d9\u05d5\u05ea \u05db\u05d5\u05d0\u05d1\u05d5\u05ea \u05dc\u05d9\u05dc\u05d3 (\u05d4\u05df \u05dc\u05e8\u05d5\u05d1 \u05dc\u05d0, \u05d0\u05dc\u05d0 \u05d0\u05dd \u05d9\u05e9 SIB).",
            "\u05d4\u05e0\u05d7\u05d4 \u05e9\u05d8\u05d9\u05e7\u05d9\u05dd \u05d4\u05dd \u05e8\u05e6\u05d5\u05e0\u05d9\u05d9\u05dd \u05dc\u05d7\u05dc\u05d5\u05d8\u05d9\u05df."
          ],
          "bluffs": [
            "\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05de\u05d5\u05e0\u05d7 '\u05ea\u05e0\u05d5\u05e2\u05d5\u05ea \u05d7\u05d6\u05e8\u05ea\u05d9\u05d5\u05ea' \u05d1\u05dc\u05d9 \u05dc\u05d4\u05d1\u05d7\u05d9\u05df \u05d1\u05d9\u05df \u05d4\u05e1\u05d5\u05d2\u05d9\u05dd."
          ]
        }
      },
      "hint": "\u05d4\u05ea\u05de\u05e7\u05d3 \u05d1\u05ea\u05d7\u05d5\u05e9\u05ea \u05d4\u05d9\u05dc\u05d3 \u05db\u05dc\u05e4\u05d9 \u05d4\u05ea\u05e0\u05d5\u05e2\u05d4 \u05d5\u05d1\u05de\u05d4 \u05e9\u05e7\u05d5\u05e8\u05d4 \u05db\u05e9\u05e8\u05e7 \u05e7\u05d5\u05e8\u05d0\u05d9\u05dd \u05dc\u05d5 \u05d1\u05e9\u05de\u05d5.",
      "imageUrls": []
    }
  ]
}