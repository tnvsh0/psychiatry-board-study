{
  "title": "Motor Flashcards",
  "cards": [
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df \u05d1-DSM-5-TR \u05d4\u05e0\u05d3\u05e8\u05e9 \u05dc\u05d0\u05d1\u05d7\u05e0\u05ea Developmental Coordination Disorder (DCD) \u05db\u05d0\u05e9\u05e8 \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05e1\u05d5\u05d1\u05dc \u05de-Intellectual Developmental Disorder?",
      "back": "\u05d4\u05dc\u05d9\u05e7\u05d5\u05d9\u05d9\u05dd \u05d4\u05de\u05d5\u05d8\u05d5\u05e8\u05d9\u05d9\u05dd \u05d7\u05d9\u05d9\u05d1\u05d9\u05dd \u05dc\u05d4\u05d9\u05d5\u05ea \u05de\u05e2\u05d1\u05e8 \u05dc\u05de\u05e6\u05d5\u05e4\u05d4 \u05e2\u05d1\u05d5\u05e8 \u05d4-mental age \u05e9\u05dc \u05d4\u05de\u05d8\u05d5\u05e4\u05dc (DSM p.86)."
    },
    {
      "front": "\u05de\u05d4\u05dd \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9\u05dd \u05d4\u05de\u05d1\u05d3\u05d9\u05dc\u05d9\u05dd \u05ea\u05e0\u05d5\u05e2\u05d5\u05ea \u05e1\u05d8\u05e8\u05d0\u05d5\u05d8\u05d9\u05e4\u05d9\u05d5\u05ea (Stereotypies) \u05de\u05d8\u05d9\u05e7\u05d9\u05dd (Tics) \u05de\u05d1\u05d7\u05d9\u05e0\u05ea \u05e7\u05e6\u05d1 \u05d5\u05de\u05e9\u05da \u05d4\u05ea\u05e0\u05d5\u05e2\u05d4?",
      "back": "\u05e1\u05d8\u05e8\u05d0\u05d5\u05d8\u05d9\u05e4\u05d9\u05d5\u05ea \u05d4\u05df \u05e7\u05e6\u05d1\u05d9\u05d5\u05ea (rhythmic) \u05d5\u05d1\u05e2\u05dc\u05d5\u05ea \u05de\u05e9\u05da \u05d0\u05e8\u05d5\u05da \u05d9\u05d5\u05ea\u05e8 (\u05e9\u05e0\u05d9\u05d5\u05ea \u05e2\u05d3 \u05d3\u05e7\u05d5\u05ea), \u05dc\u05e2\u05d5\u05de\u05ea \u05d8\u05d9\u05e7\u05d9\u05dd \u05e9\u05d4\u05dd \u05de\u05d4\u05d9\u05e8\u05d9\u05dd \u05d5\u05d1\u05dc\u05ea\u05d9 \u05e1\u05d3\u05d9\u05e8\u05d9\u05dd (DSM p.97)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d4\u05de\u05d3\u05d5\u05d5\u05d7\u05ea \u05e9\u05dc DCD \u05d1\u05e7\u05e8\u05d1 \u05d9\u05dc\u05d3\u05d9\u05dd \u05d1\u05d2\u05d9\u05dc\u05d0\u05d9 5\u201311 \u05e9\u05e0\u05d9\u05dd, \u05d5\u05de\u05d4\u05d5 \u05d9\u05d7\u05e1 \u05d4\u05de\u05d9\u05e0\u05d9\u05dd (Male:Female ratio) \u05d4\u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05d9?",
      "back": "\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05e9\u05dc $5\\%$-$8\\%$, \u05e2\u05dd \u05d9\u05d7\u05e1 \u05d6\u05db\u05e8\u05d9\u05dd \u05dc\u05e0\u05e7\u05d1\u05d5\u05ea \u05e9\u05e0\u05e2 \u05d1\u05d9\u05df $2:1$ \u05dc-$7:1$ (DSM p.87)."
    },
    {
      "front": "\u05e2\u05dc \u05e4\u05d9 \u05d4-DSM-5-TR, \u05d0\u05d9\u05d6\u05d4 \u05de\u05de\u05e6\u05d0 \u05de\u05d5\u05d7\u05d9 \u05e0\u05de\u05e6\u05d0 \u05d1\u05de\u05d7\u05e7\u05e8\u05d9 \u05d4\u05d3\u05de\u05d9\u05d4 \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd \u05e1\u05d8\u05e8\u05d0\u05d5\u05d8\u05d9\u05e4\u05d9\u05d5\u05ea \u05de\u05d5\u05d8\u05d5\u05e8\u05d9\u05d5\u05ea \u05de\u05d5\u05e8\u05db\u05d1\u05d5\u05ea?",
      "back": "\u05d9\u05e8\u05d9\u05d3\u05d4 \u05de\u05d5\u05d1\u05d4\u05e7\u05ea \u05d1\u05e0\u05e4\u05d7 \u05d4-Putamen, \u05d4\u05de\u05e6\u05d1\u05d9\u05e2\u05d4 \u05e2\u05dc \u05e4\u05d2\u05d9\u05e2\u05d4 \u05d1\u05de\u05e2\u05d2\u05dc\u05d9\u05dd \u05e7\u05d5\u05e8\u05d8\u05d9\u05e7\u05d5-\u05e1\u05d8\u05e8\u05d9\u05d0\u05d8\u05dc\u05d9\u05d9\u05dd (DSM p.91)."
    },
    {
      "front": "\u05e2\u05dc \u05e4\u05d9 \u05d4-Dulcan, \u05d0\u05d9\u05d6\u05d4 \u05e1\u05d2\u05e0\u05d5\u05df \u05d4\u05ea\u05e2\u05e8\u05d1\u05d5\u05ea \u05e0\u05de\u05e6\u05d0 \u05db\u05d0\u05e4\u05e7\u05d8\u05d9\u05d1\u05d9 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05e9\u05d9\u05e4\u05d5\u05e8 \u05ea\u05e4\u05e7\u05d5\u05d3 \u05d1-Developmental Coordination Disorder?",
      "back": "\u05ea\u05d5\u05db\u05e0\u05d9\u05d5\u05ea \u05d0\u05d9\u05de\u05d5\u05df \u05de\u05d5\u05db\u05d5\u05d5\u05e0\u05d5\u05ea-\u05de\u05e9\u05d9\u05de\u05d4 (task-oriented) \u05d1\u05ea\u05d3\u05d9\u05e8\u05d5\u05ea \u05d2\u05d1\u05d5\u05d4\u05d4 \u05d5\u05d1\u05de\u05d9\u05e0\u05d5\u05df \u05d0\u05d9\u05de\u05d5\u05df \u05db\u05d5\u05dc\u05dc \u05d2\u05d3\u05d5\u05dc (Dulcan p.170)."
    },
    {
      "front": "\u05ea\u05d7\u05ea \u05d0\u05d9\u05dc\u05d5 \u05ea\u05e0\u05d0\u05d9\u05dd \u05e0\u05d9\u05ea\u05df \u05dc\u05ea\u05ea \u05d0\u05d1\u05d7\u05e0\u05d4 \u05e0\u05e4\u05e8\u05d3\u05ea \u05e9\u05dc Stereotypic Movement Disorder (SMD) \u05dc\u05de\u05d8\u05d5\u05e4\u05dc \u05e2\u05dd \u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc ASD?",
      "back": "\u05e8\u05e7 \u05db\u05d0\u05e9\u05e8 \u05e7\u05d9\u05d9\u05de\u05ea \u05e4\u05e6\u05d9\u05e2\u05d4 \u05e2\u05e6\u05de\u05d9\u05ea (SIB) \u05d0\u05d5 \u05db\u05e9\u05d4\u05ea\u05e0\u05d5\u05e2\u05d5\u05ea \u05d7\u05de\u05d5\u05e8\u05d5\u05ea \u05de\u05e1\u05e4\u05d9\u05e7 \u05db\u05d3\u05d9 \u05dc\u05d4\u05d5\u05d5\u05ea \u05de\u05d5\u05e7\u05d3 \u05d8\u05d9\u05e4\u05d5\u05dc\u05d9 \u05e2\u05e6\u05de\u05d0\u05d9 (DSM p.91)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05e0\u05d5\u05d9\u05e8\u05d5\u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05dc\u05d4\u05d9\u05d5\u05d5\u05e6\u05e8\u05d5\u05ea Tardive Dyskinesia (TD) \u05e2\u05dc \u05e4\u05d9 \u05d4-StahlNeuro?",
      "back": "\u05d7\u05e1\u05d9\u05de\u05d4 \u05db\u05e8\u05d5\u05e0\u05d9\u05ea \u05e9\u05dc \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 $D_2$ \u05d4\u05de\u05d5\u05d1\u05d9\u05dc\u05d4 \u05dc-Upregulation \u05d5-Supersensitivity \u05e9\u05dc\u05d4\u05dd, \u05de\u05d4 \u05e9\u05d2\u05d5\u05e8\u05dd \u05dc\u05e2\u05d9\u05db\u05d5\u05d1 \u05d9\u05ea\u05e8 \u05e9\u05dc \u05d4-Stop pathway (StahlNeuro p.173)."
    },
    {
      "front": "\u05de\u05d4\u05dd \u05d2\u05d5\u05e8\u05de\u05d9 \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05d4\u05e1\u05d1\u05d9\u05d1\u05ea\u05d9\u05d9\u05dd \u05d4\u05de\u05e8\u05db\u05d6\u05d9\u05d9\u05dd \u05dc-DCD \u05d4\u05de\u05e6\u05d5\u05d9\u05e0\u05d9\u05dd \u05d1-DSM-5-TR?",
      "back": "\u05e4\u05d2\u05d5\u05ea (Prematurity), \u05de\u05e9\u05e7\u05dc \u05dc\u05d9\u05d3\u05d4 \u05e0\u05de\u05d5\u05da, \u05d5\u05d7\u05e9\u05d9\u05e4\u05d4 \u05e2\u05d5\u05d1\u05e8\u05d9\u05ea \u05dc\u05d0\u05dc\u05db\u05d5\u05d4\u05d5\u05dc (DSM p.87)."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05de\u05d5\u05d2\u05d3\u05e8\u05ea \u05e8\u05de\u05ea \u05d7\u05d5\u05de\u05e8\u05d4 Moderate \u05e2\u05d1\u05d5\u05e8 Stereotypic Movement Disorder?",
      "back": "\u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d3\u05d5\u05e8\u05e9\u05d9\u05dd \u05d0\u05de\u05e6\u05e2\u05d9 \u05d4\u05d2\u05e0\u05d4 \u05de\u05e4\u05d5\u05e8\u05e9\u05d9\u05dd (explicit protective measures) \u05d5\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05e9\u05d9\u05e0\u05d5\u05d9 \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea\u05d9 (behavioral modification) (DSM p.89)."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05de\u05d1\u05d7\u05d9\u05e0\u05d9\u05dd \u05d1\u05d0\u05d1\u05d7\u05e0\u05d4 \u05de\u05d1\u05d3\u05dc\u05ea \u05d1\u05d9\u05df \u05d7\u05d5\u05e1\u05e8 \u05de\u05d9\u05d5\u05de\u05e0\u05d5\u05ea \u05de\u05d5\u05d8\u05d5\u05e8\u05d9\u05ea \u05d4\u05e0\u05d5\u05d1\u05e2\u05ea \u05de-ADHD \u05dc\u05d1\u05d9\u05df DCD?",
      "back": "\u05d1-ADHD \u05d4\u05e7\u05e9\u05d9\u05d9\u05dd \u05e0\u05d5\u05d1\u05e2\u05d9\u05dd \u05de-distractibility \u05d5\u05d0\u05d9\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05d5\u05ea, \u05d1\u05e2\u05d5\u05d3 \u05e9\u05d1-DCD \u05d4\u05dc\u05d9\u05e7\u05d5\u05d9 \u05d4\u05d5\u05d0 \u05d1\u05d9\u05db\u05d5\u05dc\u05ea \u05d4\u05de\u05d5\u05d8\u05d5\u05e8\u05d9\u05ea (core competence) (DSM p.88)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d2\u05d9\u05dc \u05d4\u05d4\u05d5\u05e4\u05e2\u05d4 (Onset) \u05d4\u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05d9 \u05dc\u05ea\u05e0\u05d5\u05e2\u05d5\u05ea \u05e1\u05d8\u05e8\u05d0\u05d5\u05d8\u05d9\u05e4\u05d9\u05d5\u05ea \u05de\u05d5\u05e8\u05db\u05d1\u05d5\u05ea \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd?",
      "back": "\u05d4\u05d5\u05e4\u05e2\u05d4 \u05d1-3 \u05d4\u05e9\u05e0\u05d9\u05dd \u05d4\u05e8\u05d0\u05e9\u05d5\u05e0\u05d5\u05ea \u05dc\u05d7\u05d9\u05d9\u05dd, \u05db\u05d0\u05e9\u05e8 \u05db-$80\\%$ \u05de\u05e6\u05d9\u05d2\u05d9\u05dd \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05dc\u05e4\u05e0\u05d9 \u05d2\u05d9\u05dc 24 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd (DSM p.90)."
    },
    {
      "front": "\u05d0\u05d9\u05d6\u05d4 \u05de\u05e1\u05dc\u05d5\u05dc \u05de\u05d5\u05d7\u05d9 (Pathway) \u05e0\u05de\u05e6\u05d0 \u05d1\u05de\u05d7\u05e7\u05e8\u05d9\u05dd \u05db\u05de\u05e2\u05d5\u05e8\u05d1 \u05d1\u05e4\u05ea\u05d5\u05e4\u05d9\u05d6\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05d4 \u05e9\u05dc Tic disorders?",
      "back": "\u05de\u05e1\u05dc\u05d5\u05dc\u05d9 \u05d4-CSTC (Cortico-striato-thalamo-cortical) (Dulcan p.443)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05e9\u05dc \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05e4\u05e6\u05d9\u05e2\u05d4 \u05e2\u05e6\u05de\u05d9\u05ea (SIB) \u05d1\u05e7\u05e8\u05d1 \u05d0\u05e0\u05e9\u05d9\u05dd \u05e2\u05dd ID \u05d7\u05de\u05d5\u05e8 \u05d4\u05e9\u05d5\u05d4\u05d9\u05dd \u05d1\u05de\u05e1\u05d2\u05e8\u05d5\u05ea \u05e4\u05e0\u05d9\u05de\u05d9\u05d9\u05ea\u05d9\u05d5\u05ea (Residential facilities)?",
      "back": "\u05d1\u05d9\u05df $10\\%$ \u05dc-$15\\%$ (DSM p.90)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05d4\u05e4\u05e8\u05e2\u05d4 \u05d4\u05e0\u05dc\u05d5\u05d5\u05d9\u05ea (Comorbidity) \u05d4\u05e9\u05db\u05d9\u05d7\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc-DCD, \u05d5\u05d1\u05d0\u05d9\u05d6\u05d4 \u05e9\u05d9\u05e2\u05d5\u05e8 \u05d4\u05d9\u05d0 \u05de\u05d5\u05e4\u05d9\u05e2\u05d4?",
      "back": "\u05d4\u05e4\u05e8\u05e2\u05ea ADHD, \u05d4\u05de\u05d5\u05e4\u05d9\u05e2\u05d4 \u05d1\u05db-$50\\%$ \u05de\u05d4\u05de\u05e7\u05e8\u05d9\u05dd (DSM p.89)."
    },
    {
      "front": "\u05d1\u05e0\u05d9\u05d2\u05d5\u05d3 \u05dc\u05d8\u05d9\u05e7\u05d9\u05dd, \u05de\u05d4\u05d9 \u05d4\u05ea\u05d2\u05d5\u05d1\u05d4 \u05d4\u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05d9\u05ea \u05e9\u05dc \u05d9\u05dc\u05d3 \u05e2\u05dd SMD \u05dc\u05d4\u05e1\u05d7\u05ea \u05d3\u05e2\u05ea (Distraction) \u05d0\u05d5 \u05e7\u05e8\u05d9\u05d0\u05d4 \u05d1\u05e9\u05de\u05d5?",
      "back": "\u05d4\u05ea\u05e0\u05d5\u05e2\u05d5\u05ea \u05d1\u05d3\u05e8\u05da \u05db\u05dc\u05dc \u05e0\u05e4\u05e1\u05e7\u05d5\u05ea \u05db\u05d0\u05e9\u05e8 \u05d4\u05d9\u05dc\u05d3 \u05de\u05d5\u05e1\u05d7 \u05d0\u05d5 \u05db\u05e9\u05ea\u05e9\u05d5\u05de\u05ea \u05d4\u05dc\u05d1 \u05de\u05d5\u05e4\u05e0\u05d9\u05ea \u05d0\u05dc\u05d9\u05d5 (DSM p.89)."
    },
    {
      "front": "\u05d0\u05d9\u05dc\u05d5 \u05e7\u05e9\u05d9\u05d9\u05dd \u05de\u05d5\u05d8\u05d5\u05e8\u05d9\u05d9\u05dd \u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05d9\u05d9\u05dd \u05dc\u05d9\u05dc\u05d3 \u05e2\u05dd DCD \u05d1\u05d2\u05d9\u05dc \u05d1\u05d9\u05ea \u05d4\u05e1\u05e4\u05e8 \u05d4\u05d9\u05e1\u05d5\u05d3\u05d9?",
      "back": "\u05d0\u05d9\u05d8\u05d9\u05d5\u05ea \u05d0\u05d5 \u05d7\u05d5\u05e1\u05e8 \u05d3\u05d9\u05d5\u05e7 \u05d1\u05d4\u05e8\u05db\u05d1\u05ea \u05e4\u05d0\u05d6\u05dc\u05d9\u05dd, \u05d1\u05e0\u05d9\u05d9\u05ea \u05de\u05d5\u05d3\u05dc\u05d9\u05dd, \u05de\u05e9\u05d7\u05e7\u05d9 \u05db\u05d3\u05d5\u05e8 \u05d5\u05db\u05ea\u05d9\u05d1\u05ea \u05d9\u05d3 (DSM p.87)."
    },
    {
