{
  "title": "Antidepressant Quiz",
  "questions": [
    {
      "question": "\u05de\u05ea\u05d1\u05d2\u05e8 \u05d1\u05df 16 \u05e2\u05dd Major Depressive Disorder (MDD) \u05e9\u05d0\u05d9\u05e0\u05d5 \u05de\u05d2\u05d9\u05d1 \u05dc-SSRIs \u05de\u05ea\u05d7\u05d9\u05dc \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Venlafaxine XR. \u05de\u05d4\u05d5 \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05e4\u05e8\u05de\u05e7\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d4\u05e6\u05e4\u05d5\u05d9 \u05d1\u05de\u05d9\u05e0\u05d5\u05df \u05d4\u05ea\u05d7\u05dc\u05ea\u05d9 \u05e0\u05de\u05d5\u05da \u05e9\u05dc $75\\,mg$ \u05dc\u05d9\u05d5\u05dd?",
      "answerOptions": [
        {
          "text": "\u05e2\u05d9\u05db\u05d5\u05d1 \u05e4\u05d5\u05d8\u05e0\u05d8\u05d9 \u05e9\u05dc SERT \u05d1\u05dc\u05d1\u05d3, \u05d1\u05d3\u05d5\u05de\u05d4 \u05dc\u05e4\u05e2\u05d5\u05dc\u05ea SSRI.",
          "isCorrect": true,
          "rationale": "\u05d1\u05de\u05d9\u05e0\u05d5\u05e0\u05d9\u05dd \u05e0\u05de\u05d5\u05db\u05d9\u05dd, \u05d4\u05d6\u05d9\u05e7\u05d4 \u05e9\u05dc Venlafaxine \u05dc-SERT \u05d2\u05d1\u05d5\u05d4\u05d4 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea (\u05e4\u05d9 30) \u05de\u05d0\u05e9\u05e8 \u05dc-NET, \u05d5\u05dc\u05db\u05df \u05d4\u05e4\u05e2\u05d5\u05dc\u05d4 \u05d4\u05d9\u05d0 \u05d1\u05e2\u05d9\u05e7\u05e8 \u05e1\u05e8\u05d5\u05d8\u05d5\u05e0\u05d9\u05e0\u05e8\u05d2\u05d9\u05ea (StahlNeuro p.299, StahlKids p.483)."
        },
        {
          "text": "\u05e2\u05d9\u05db\u05d5\u05d1 \u05de\u05e9\u05d5\u05dc\u05d1 \u05d5\u05e1\u05d9\u05de\u05d5\u05dc\u05d8\u05e0\u05d9 \u05e9\u05dc SERT \u05d5-NET \u05d1\u05de\u05d9\u05d3\u05d4 \u05e9\u05d5\u05d5\u05d4.",
          "isCorrect": false,
          "rationale": "\u05e2\u05d9\u05db\u05d5\u05d1 \u05d4-NET \u05d4\u05d5\u05e4\u05da \u05dc\u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9 \u05e8\u05e7 \u05db\u05db\u05dc \u05e9\u05d4\u05de\u05d9\u05e0\u05d5\u05df \u05e2\u05d5\u05dc\u05d4 \u05de\u05e2\u05dc \u05d4\u05d8\u05d5\u05d5\u05d7 \u05d4\u05e0\u05de\u05d5\u05da (StahlNeuro p.299)."
        },
        {
          "text": "\u05d7\u05e1\u05d9\u05de\u05d4 \u05e9\u05dc \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 $5\\text{-}HT_{2A}$ \u05d5\u05e9\u05d9\u05e4\u05d5\u05e8 \u05de\u05d9\u05d9\u05d3\u05d9 \u05d1\u05d0\u05e8\u05db\u05d9\u05d8\u05e7\u05d8\u05d5\u05e8\u05ea \u05d4\u05e9\u05d9\u05e0\u05d4.",
          "isCorrect": false,
          "rationale": "\u05dc-Venlafaxine \u05d0\u05d9\u05df \u05d6\u05d9\u05e7\u05d4 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05dc\u05e7\u05d5\u05dc\u05d8\u05e0\u05d9\u05dd \u05e4\u05d5\u05e1\u05d8-\u05e1\u05d9\u05e0\u05e4\u05d8\u05d9\u05d9\u05dd \u05db\u05de\u05d5 $5\\text{-}HT_{2A}$ (StahlNeuro p.301)."
