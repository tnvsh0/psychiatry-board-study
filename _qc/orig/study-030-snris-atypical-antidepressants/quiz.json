        },
        {
          "text": "\u05d1\u05d3\u05d9\u05e7\u05ea \u05d0\u05e7\"\u05d2 \u05dc\u05de\u05d3\u05d9\u05d3\u05ea \u05de\u05e8\u05d5\u05d5\u05d7 QTc.",
          "isCorrect": false,
          "rationale": "\u05dc-Duloxetine \u05d0\u05d9\u05df \u05d4\u05e9\u05e4\u05e2\u05d4 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05e2\u05dc \u05d4-QTc \u05d1\u05de\u05d9\u05e0\u05d5\u05e0\u05d9\u05dd \u05e8\u05d2\u05d9\u05dc\u05d9\u05dd, \u05d1\u05e0\u05d9\u05d2\u05d5\u05d3 \u05dc-TCAs (Dulcan p.716)."
        },
        {
          "text": "\u05e0\u05d9\u05d8\u05d5\u05e8 \u05e8\u05de\u05d5\u05ea \u05d2\u05dc\u05d5\u05e7\u05d5\u05d6 \u05d1\u05e6\u05d5\u05dd \u05d1\u05e9\u05dc \u05e1\u05d9\u05db\u05d5\u05df \u05dc-Diabetes.",
          "isCorrect": false,
          "rationale": "\u05ea\u05d5\u05e4\u05e2\u05d4 \u05d6\u05d5 \u05e0\u05e4\u05d5\u05e6\u05d4 \u05d1-SGAs (\u05db\u05de\u05d5 Quetiapine) \u05d0\u05da \u05dc\u05d0 \u05d1-SNRIs (StahlKids p.409)."
        },
        {
          "text": "\u05d1\u05d3\u05d9\u05e7\u05ea \u05e8\u05de\u05d5\u05ea \u05e4\u05dc\u05d6\u05de\u05d4 \u05e9\u05dc \u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 (Therapeutic Drug Monitoring).",
          "isCorrect": false,
          "rationale": "\u05d0\u05d9\u05df \u05d4\u05de\u05dc\u05e6\u05d4 \u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05e8\u05d5\u05d8\u05d9\u05e0\u05d9\u05ea \u05dc\u05e0\u05d9\u05d8\u05d5\u05e8 \u05e8\u05de\u05d5\u05ea \u05e4\u05dc\u05d6\u05de\u05d4 \u05e9\u05dc Duloxetine (StahlKids p.172)."
        }
      ],
      "hint": "\u05d4\u05d4\u05e9\u05e4\u05e2\u05d4 \u05d4\u05e0\u05d5\u05e8\u05d0\u05d3\u05e8\u05e0\u05e8\u05d2\u05d9\u05ea \u05e9\u05dc \u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 \u05de\u05d7\u05d9\u05d9\u05d1\u05ea \u05de\u05e2\u05e7\u05d1 \u05d0\u05d7\u05e8 \u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05dc\u05d1 \u05d5\u05db\u05dc\u05d9 \u05d4\u05d3\u05dd."
