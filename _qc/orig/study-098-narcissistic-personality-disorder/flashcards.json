{
  "title": "Narcissism Flashcards",
  "cards": [
    {
      "front": "\u05db\u05de\u05d4 \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05d3\u05e8\u05d5\u05e9\u05d9\u05dd \u05dc\u05d0\u05d1\u05d7\u05e0\u05ea Narcissistic Personality Disorder \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR?",
      "back": "\u05dc\u05e4\u05d7\u05d5\u05ea 5 \u05de\u05ea\u05d5\u05da 9 \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05d4\u05de\u05d5\u05e4\u05d9\u05e2\u05d9\u05dd \u05d1\u05e8\u05e9\u05d9\u05de\u05d4 (DSM p.760)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05d4\u05de\u05d1\u05d7\u05d9\u05df \u05d1\u05d9\u05df \u05d4-Vulnerable (Covert) subtype \u05dc\u05d1\u05d9\u05df \u05d4-Grandiose subtype \u05e9\u05dc NPD?",
      "back": "\u05d1-Vulnerable subtype \u05e7\u05d9\u05d9\u05de\u05ea \u05e8\u05d2\u05d9\u05e9\u05d5\u05ea \u05e7\u05d9\u05e6\u05d5\u05e0\u05d9\u05ea \u05dc\u05d1\u05d9\u05e7\u05d5\u05e8\u05ea, \u05d1\u05d5\u05e9\u05d4 \u05d5\u05ea\u05d7\u05d5\u05e9\u05ea \u05e0\u05d7\u05d9\u05ea\u05d5\u05ea, \u05d1\u05e2\u05d5\u05d3 \u05d4-Grandiose subtype \u05de\u05d0\u05d5\u05e4\u05d9\u05d9\u05df \u05d1\u05d1\u05d9\u05d8\u05d7\u05d5\u05df \u05e2\u05e6\u05de\u05d9 \u05de\u05d5\u05d7\u05e6\u05df \u05d5\u05e1\u05d8\u05d5\u05d0\u05d9\u05e6\u05d9\u05d6\u05dd (Synopsis ch.19 Personality Disorders)."
    },
    {
      "front": "\u05dc\u05e4\u05d9 \u05d4-Alternative Model (Section III), \u05d0\u05d9\u05dc\u05d5 \u05e9\u05e0\u05d9 \u05e8\u05db\u05d9\u05d1\u05d9\u05dd \u05e9\u05dc Self functioning (Criterion A) \u05e0\u05e4\u05d2\u05e2\u05d9\u05dd \u05d1-NPD?",
      "back": "\u05d6\u05d4\u05d5\u05ea (Identity) \u05d5\u05d4\u05db\u05d5\u05d5\u05e0\u05d4 \u05e2\u05e6\u05de\u05d9\u05ea (Self-direction) (DSM p.887)."
    },
    {
      "front": "\u05d0\u05d9\u05dc\u05d5 \u05ea\u05db\u05d5\u05e0\u05d5\u05ea \u05d0\u05e0\u05d8\u05d2\u05d5\u05e0\u05d9\u05e1\u05d8\u05d9\u05d5\u05ea \u05e0\u05d5\u05e1\u05e4\u05d5\u05ea \u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d5\u05ea \u05d0\u05ea \u05d4\u05de\u05d5\u05e9\u05d2 Malignant Narcissism \u05d1\u05de\u05d5\u05d3\u05dc \u05d4\u05de\u05de\u05d3\u05d9?",
      "back": "\u05de\u05e0\u05d9\u05e4\u05d5\u05dc\u05d8\u05d9\u05d1\u05d9\u05d5\u05ea (Manipulativeness), \u05e8\u05de\u05d0\u05d5\u05ea (Deceitfulness) \u05d5\u05e7\u05e9\u05d9\u05d7\u05d5\u05ea (Callousness) (DSM p.888)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d4-NPD \u05d1\u05d0\u05d5\u05db\u05dc\u05d5\u05e1\u05d9\u05d9\u05d4 \u05d4\u05db\u05dc\u05dc\u05d9\u05ea \u05dc\u05e4\u05d9 \u05de\u05d7\u05e7\u05e8 \u05d4-NESARC?",
      "back": "\u05d4\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05de\u05d5\u05e2\u05e8\u05db\u05ea \u05d1\u05db-$6.2\\%$ (DSM p.762)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d9\u05d7\u05e1 \u05d4\u05de\u05d9\u05e0\u05d9\u05dd (Sex ratio) \u05d1\u05d0\u05d1\u05d7\u05e0\u05ea Narcissistic Personality Disorder?",
      "back": "\u05db-$50\\%$-$75\\%$ \u05de\u05d4\u05de\u05d0\u05d5\u05d1\u05d7\u05e0\u05d9\u05dd \u05d4\u05dd \u05d2\u05d1\u05e8\u05d9\u05dd (DSM p.763)."
    },
    {
      "front": "\u05d1\u05d0\u05d9\u05d6\u05d4 \u05e9\u05dc\u05d1 \u05d1\u05d7\u05d9\u05d9\u05dd \u05e0\u05d5\u05d8\u05d9\u05dd \u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05e9\u05dc NPD \u05dc\u05d4\u05d7\u05de\u05d9\u05e8 \u05d0\u05d5 \u05dc\u05d4\u05d5\u05d1\u05d9\u05dc \u05dc\u05de\u05e9\u05d1\u05e8 (midlife crisis)?",
      "back": "\u05d1\u05de\u05d4\u05dc\u05da \u05ea\u05d4\u05dc\u05d9\u05da \u05d4\u05d4\u05d6\u05d3\u05e7\u05e0\u05d5\u05ea (aging), \u05d1\u05e9\u05dc \u05d0\u05d5\u05d1\u05d3\u05df \u05d9\u05d5\u05e4\u05d9, \u05db\u05d5\u05d7 \u05d5\u05e0\u05e2\u05d5\u05e8\u05d9\u05dd \u05e2\u05dc\u05d9\u05d4\u05dd \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05e0\u05e1\u05de\u05da (Synopsis ch.19 Personality Disorders)."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05e0\u05d9\u05ea\u05df \u05dc\u05d4\u05d1\u05d7\u05d9\u05df \u05d1\u05d9\u05df Grandiosity \u05d1-NPD \u05dc\u05d1\u05d9\u05df Grandiosity \u05d1\u05de\u05d4\u05dc\u05da Mania \u05d0\u05d5 Hypomania?",
      "back": "\u05d1-Mania \u05d4\u05d2\u05e8\u05e0\u05d3\u05d9\u05d5\u05d6\u05d9\u05d5\u05ea \u05de\u05d5\u05e4\u05d9\u05e2\u05d4 \u05d1\u05de\u05d4\u05dc\u05da Episodic course \u05d4\u05e7\u05e9\u05d5\u05e8 \u05dc\u05e9\u05d9\u05e0\u05d5\u05d9 \u05d1\u05de\u05e6\u05d1 \u05d4\u05e8\u05d5\u05d7, \u05d1\u05e0\u05d9\u05d2\u05d5\u05d3 \u05dc\u05d3\u05e4\u05d5\u05e1 Pervasive \u05d5\u05de\u05ea\u05de\u05e9\u05da \u05d1-NPD (DSM p.764)."
    },
    {
      "front": "\u05de\u05d4\u05df \u05e9\u05ea\u05d9 \u05d4\u05e4\u05e2\u05d5\u05dc\u05d5\u05ea \u05d4\u05de\u05e8\u05db\u05d6\u05d9\u05d5\u05ea \u05d1\u05d8\u05d9\u05e4\u05d5\u05dc Transference-Focused Psychotherapy (TFP)?",
      "back": "\u05d4\u05d1\u05d4\u05e8\u05d4 (Clarification) \u05d5\u05e2\u05d9\u05de\u05d5\u05ea (Confrontation) \u05e9\u05dc \u05e2\u05d9\u05d5\u05d5\u05ea\u05d9 \u05d4\u05d4\u05e2\u05d1\u05e8\u05d4 \u05db\u05d3\u05d9 \u05dc\u05e9\u05dc\u05d1 \u05d7\u05dc\u05e7\u05d9 \u05e2\u05e6\u05de\u05d9 \u05d5\u05d0\u05d5\u05d1\u05d9\u05d9\u05e7\u05d8 \u05de\u05e4\u05d5\u05e6\u05dc\u05d9\u05dd (Synopsis ch.19 Personality Disorders)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05de\u05d8\u05e8\u05ea \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc Mentalization-Based Therapy (MBT) \u05d1\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05d0\u05d9\u05e9\u05d9\u05d5\u05ea?",
      "back": "\u05e9\u05d9\u05e4\u05d5\u05e8 \u05d4\u05d9\u05db\u05d5\u05dc\u05ea \u05dc\u05d4\u05d1\u05d9\u05df \u05d5\u05dc\u05e4\u05e8\u05e9 \u05de\u05e6\u05d1\u05d9\u05dd \u05de\u05e0\u05d8\u05dc\u05d9\u05d9\u05dd \u05e9\u05dc \u05d4\u05e2\u05e6\u05de\u05d9 \u05d5\u05e9\u05dc \u05d0\u05d7\u05e8\u05d9\u05dd, \u05d1\u05de\u05d9\u05d5\u05d7\u05d3 \u05ea\u05d7\u05ea \u05d3\u05d7\u05e7 (Synopsis ch.19 Personality Disorders)."
    },
    {
      "front": "\u05de\u05ea\u05d9 \u05e0\u05e9\u05e7\u05d5\u05dc \u05e9\u05d9\u05de\u05d5\u05e9 \u05d1-Lithium \u05d1\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd \u05e2\u05dd NPD?",
      "back": "\u05db\u05d0\u05e9\u05e8 \u05d4\u05ea\u05de\u05d5\u05e0\u05d4 \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05db\u05d5\u05dc\u05dc\u05ea \u05ea\u05e0\u05d5\u05d3\u05d5\u05ea \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05d5\u05ea \u05d1\u05de\u05e6\u05d1 \u05d4\u05e8\u05d5\u05d7 (Mood swings) (Synopsis ch.19 Personality Disorders)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05d4\u05de\u05d1\u05d3\u05d9\u05dc NPD \u05de-Borderline Personality Disorder (BPD) \u05de\u05d1\u05d7\u05d9\u05e0\u05ea \u05d9\u05e6\u05d9\u05d1\u05d5\u05ea \u05d4\u05e2\u05e6\u05de\u05d9?",
      "back": "\u05d1-NPD \u05e7\u05d9\u05d9\u05de\u05ea \u05d9\u05e6\u05d9\u05d1\u05d5\u05ea \u05d9\u05d7\u05e1\u05d9\u05ea \u05e9\u05dc Self-image \u05d5\u05e4\u05d7\u05d5\u05ea \u05e0\u05d8\u05d9\u05d9\u05d4 \u05dc-Self-destructiveness \u05d5-Impulsivity \u05d1\u05d4\u05e9\u05d5\u05d5\u05d0\u05d4 \u05dc-BPD (DSM p.763)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05d8\u05e8\u05d9\u05d2\u05e8 \u05d4\u05e9\u05db\u05d9\u05d7 \u05dc\u05d4\u05d5\u05e4\u05e2\u05ea Major Depressive Disorder \u05d1\u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd \u05e2\u05dd NPD?",
      "back": "\u05d1\u05d9\u05e7\u05d5\u05e8\u05ea \u05d0\u05d5 \u05db\u05d9\u05e9\u05dc\u05d5\u05df \u05d4\u05de\u05d5\u05d1\u05d9\u05dc\u05d9\u05dd \u05dc\"\u05e4\u05d2\u05d9\u05e2\u05d4 \u05e0\u05e8\u05e6\u05d9\u05e1\u05d9\u05e1\u05d8\u05d9\u05ea\" \u05d5\u05d7\u05e9\u05d9\u05e4\u05ea \u05e8\u05d2\u05e9\u05d9 \u05e0\u05d7\u05d9\u05ea\u05d5\u05ea \u05d5\u05d1\u05d5\u05e9\u05d4 (Synopsis ch.19 Personality Disorders)."
    },
    {
      "front": "\u05ea\u05d7\u05ea \u05d0\u05d9\u05dc\u05d5 \u05ea\u05e0\u05d0\u05d9\u05dd \u05e0\u05d9\u05ea\u05df \u05dc\u05d0\u05d1\u05d7\u05df NPD \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d0\u05d5 \u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd?",
      "back": "\u05db\u05d0\u05e9\u05e8 \u05d4\u05ea\u05db\u05d5\u05e0\u05d5\u05ea \u05d4\u05df Pervasive, Persistent \u05d5\u05dc\u05d0 \u05de\u05d5\u05d2\u05d1\u05dc\u05d5\u05ea \u05dc\u05e9\u05dc\u05d1 \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9, \u05d5\u05d1\u05ea\u05e0\u05d0\u05d9 \u05e9\u05e0\u05de\u05e9\u05db\u05d5 \u05dc\u05e4\u05d7\u05d5\u05ea \u05e9\u05e0\u05d4 (DSM p.736)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05ea\u05d9\u05d0\u05d5\u05e8 \u05d4\u05de\u05d3\u05d5\u05d9\u05e7 \u05e9\u05dc \u05d4\u05e4\u05d2\u05d9\u05e2\u05d4 \u05d1-Empathy (\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df 7) \u05d1\u05e7\u05e8\u05d1 \u05de\u05d8\u05d5\u05e4\u05dc\u05d9 NPD?",
      "back": "\u05d7\u05d5\u05e1\u05e8 \u05e8\u05e6\u05d5\u05df (Unwillingness) \u05dc\u05d6\u05d4\u05d5\u05ea \u05d0\u05d5 \u05dc\u05d4\u05d6\u05d3\u05d4\u05d5\u05ea \u05e2\u05dd \u05d4\u05e6\u05e8\u05db\u05d9\u05dd \u05d5\u05d4\u05e8\u05d2\u05e9\u05d5\u05ea \u05e9\u05dc \u05d0\u05d7\u05e8\u05d9\u05dd (DSM p.761)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05d4\u05d1\u05d3\u05dc \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05d1\u05d2\u05d9\u05e9\u05d4 \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc\u05d9\u05ea \u05d1\u05d9\u05df Kohut \u05dc-Kernberg \u05d1-NPD?",
      "back": "\u05e7\u05d5\u05d4\u05d5\u05d8 \u05de\u05d3\u05d2\u05d9\u05e9 \u05d0\u05de\u05e4\u05ea\u05d9\u05d4 \u05d5\u05e9\u05d9\u05e7\u05d5\u05e3 (Mirroring) \u05dc\u05d1\u05e0\u05d9\u05d9\u05ea \u05d4-Self \u05d4\u05e4\u05d2\u05d5\u05dd, \u05d1\u05e2\u05d5\u05d3 \u05e7\u05e8\u05e0\u05d1\u05e8\u05d2 \u05de\u05d3\u05d2\u05d9\u05e9 \u05e2\u05d9\u05de\u05d5\u05ea \u05e2\u05dd \u05d4\u05d2\u05e8\u05e0\u05d3\u05d9\u05d5\u05d6\u05d9\u05d5\u05ea \u05d5\u05e4\u05d9\u05e8\u05d5\u05e7 \u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4-Splitting (Synopsis ch.19 Personality Disorders)."
    }
  ]
}