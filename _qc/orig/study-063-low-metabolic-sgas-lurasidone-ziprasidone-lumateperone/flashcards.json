{
  "title": "Antipsychotic Flashcards",
  "cards": [
    {
      "front": "\u05de\u05d4\u05d9 \u05db\u05de\u05d5\u05ea \u05d4\u05e7\u05dc\u05d5\u05e8\u05d9\u05d5\u05ea \u05d4\u05de\u05d9\u05e0\u05d9\u05de\u05dc\u05d9\u05ea \u05e9\u05d9\u05e9 \u05dc\u05e6\u05e8\u05d5\u05da \u05e2\u05dd \u05de\u05e0\u05ea Lurasidone \u05dc\u05d4\u05d1\u05d8\u05d7\u05ea \u05e1\u05e4\u05d9\u05d2\u05d4 \u05ea\u05e7\u05d9\u05e0\u05d4?",
      "back": "\u05dc\u05e4\u05d7\u05d5\u05ea 350 kcal \u05e9\u05dc \u05de\u05d6\u05d5\u05df (StahlKids p.301, p.303)."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05de\u05e9\u05e4\u05d9\u05e2\u05d4 \u05e0\u05d8\u05d9\u05dc\u05ea Lurasidone \u05e2\u05dc \u05e7\u05d9\u05d1\u05d4 \u05e8\u05d9\u05e7\u05d4 \u05e2\u05dc \u05d4-$C_{max}$ \u05d5\u05d4\u05d6\u05de\u05d9\u05e0\u05d5\u05ea \u05d4\u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea \u05e9\u05dc\u05d5?",
      "back": "\u05d4\u05df \u05de\u05d5\u05e4\u05d7\u05ea\u05d5\u05ea \u05d1\u05e9\u05d9\u05e2\u05d5\u05e8 \u05e9\u05dc \u05e2\u05d3 50% (StahlKids p.301, p.303; Dulcan p.786)."
    },
    {
      "front": "\u05e2\u05d1\u05d5\u05e8 \u05d0\u05d9\u05d6\u05d5 \u05d4\u05ea\u05d5\u05d5\u05d9\u05d4 \u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9\u05ea \u05de\u05d0\u05d5\u05e9\u05e8 Lurasidone \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d1\u05d2\u05d9\u05dc\u05d0\u05d9 10\u201317?",
      "back": "\u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05d1\u05d9\u05e4\u05d5\u05dc\u05e8\u05d9 (Bipolar Depression) \u05db\u05d7\u05dc\u05d5\u05e4\u05d4 \u05d9\u05d7\u05d9\u05d3\u05e0\u05d9\u05ea (Monotherapy) (Dulcan p.786; StahlKids p.298)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d8\u05d5\u05d5\u05d7 \u05d4\u05de\u05d9\u05e0\u05d5\u05e0\u05d9\u05dd \u05d4\u05de\u05d5\u05de\u05dc\u05e5 \u05dc\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1-Lurasidone \u05e2\u05d1\u05d5\u05e8 Schizophrenia \u05d1\u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd (\u05d2\u05d9\u05dc\u05d0\u05d9 13\u201317)?",
      "back": "\u05d4\u05de\u05d9\u05e0\u05d5\u05df \u05d4\u05d5\u05d0 $40-80\\text{ mg/day}$, \u05db\u05d0\u05e9\u05e8 \u05e0\u05d9\u05ea\u05df \u05dc\u05e2\u05dc\u05d5\u05ea \u05e2\u05d3 $160\\text{ mg/day}$ \u05d1\u05de\u05e7\u05e8\u05d9\u05dd \u05e2\u05de\u05d9\u05d3\u05d9\u05dd (StahlKids p.301-302)."
    },
    {
      "front": "\u05dc\u05d0\u05d9\u05d6\u05d4 \u05e7\u05d5\u05dc\u05d8\u05df \u05de\u05e6\u05d9\u05d2 Lurasidone \u05d6\u05d9\u05e7\u05d4 (Affinity) \u05d7\u05d6\u05e7\u05d4 \u05d9\u05d5\u05ea\u05e8 \u05de\u05d0\u05e9\u05e8 \u05dc\u05e7\u05d5\u05dc\u05d8\u05df $D_{2}$?",
      "back": "\u05e7\u05d5\u05dc\u05d8\u05df $5-HT_{7}$, \u05d4\u05de\u05ea\u05d5\u05d5\u05da \u05d4\u05e9\u05e4\u05e2\u05d4 \u05e0\u05d5\u05d2\u05d3\u05ea \u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05d5\u05e9\u05d9\u05e4\u05d5\u05e8 \u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9 (StahlNeuro p.206; StahlKids p.308)."
    },
    {
      "front": "\u05de\u05d3\u05d5\u05e2 \u05dc-Lurasidone \u05d9\u05e9 \u05e1\u05d9\u05db\u05d5\u05df \u05e0\u05de\u05d5\u05da \u05de\u05d0\u05d5\u05d3 \u05dc\u05d2\u05e8\u05d9\u05de\u05ea \u05e2\u05dc\u05d9\u05d9\u05d4 \u05d1\u05de\u05e9\u05e7\u05dc \u05d0\u05d5 \u05d4\u05e4\u05e8\u05e2\u05d4 \u05de\u05d8\u05d1\u05d5\u05dc\u05d9\u05ea?",
      "back": "\u05d1\u05e9\u05dc \u05d4\u05d9\u05e2\u05d3\u05e8 \u05d6\u05d9\u05e7\u05d4 (Minimal affinity) \u05dc\u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 $H_{1}$ \u05d4\u05d9\u05e1\u05d8\u05de\u05d9\u05e0\u05e8\u05d2\u05d9\u05d9\u05dd \u05d5-$M_{1}$ \u05de\u05d5\u05e1\u05e7\u05e8\u05d9\u05e0\u05d9\u05d9\u05dd (StahlNeuro p.225; StahlKids p.300)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05d9\u05ea\u05e8\u05d5\u05df \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05e9\u05dc Lurasidone \u05e2\u05dc \u05e4\u05e0\u05d9 SGA \u05d0\u05d7\u05e8\u05d9\u05dd \u05d1\u05e0\u05d5\u05d2\u05e2 \u05dc\u05d4\u05d5\u05dc\u05db\u05d4 \u05dc\u05d1\u05d1\u05d9\u05ea (ECG)?",
      "back": "\u05d4\u05d5\u05d0 \u05d0\u05d9\u05e0\u05d5 \u05d2\u05d5\u05e8\u05dd \u05dc\u05d4\u05d0\u05e8\u05db\u05ea \u05de\u05e8\u05d5\u05d5\u05d7 $QTc$ \u05d5\u05e0\u05d8\u05d5\u05dc \u05d0\u05d6\u05d4\u05e8\u05ea $QTc$ \u05d1\u05ea\u05d5\u05d5\u05d9\u05ea \u05e9\u05dc\u05d5 (StahlKids p.308)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05d9\u05d9\u05d7\u05d5\u05d3\u05d9 (Unique Mechanism) \u05e9\u05dc Lumateperone \u05e2\u05dc \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 $D_{2}$?",
      "back": "\u05d0\u05d2\u05d5\u05e0\u05d9\u05d6\u05dd \u05d7\u05dc\u05e7\u05d9 (Partial Agonism) \u05e7\u05d3\u05dd-\u05e1\u05d9\u05e0\u05e4\u05d8\u05d9 \u05d5\u05d0\u05e0\u05d8\u05d2\u05d5\u05e0\u05d9\u05d6\u05dd (Antagonism) \u05e4\u05d5\u05e1\u05d8-\u05e1\u05d9\u05e0\u05e4\u05d8\u05d9 (StahlNeuro p.238)."
    },
    {
      "front": "\u05d1\u05e0\u05d5\u05e1\u05e3 \u05dc\u05d7\u05e1\u05d9\u05de\u05ea $D_{2}$ \u05d5-$5-HT_{2A}$, \u05d0\u05d9\u05d6\u05d5 \u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05e1\u05d9\u05e0\u05e4\u05d8\u05d9\u05ea \u05e0\u05d5\u05e1\u05e4\u05ea \u05d9\u05e9 \u05dc-Lumateperone \u05d4\u05ea\u05d5\u05e8\u05de\u05ea \u05dc\u05d4\u05e9\u05e4\u05e2\u05d4 \u05e0\u05d5\u05d2\u05d3\u05ea \u05d3\u05d9\u05db\u05d0\u05d5\u05df?",
      "back": "\u05e2\u05d9\u05db\u05d5\u05d1 \u05e9\u05dc \u05d4\u05d8\u05e8\u05e0\u05e1\u05e4\u05d5\u05e8\u05d8\u05e8 \u05dc\u05e1\u05e8\u05d5\u05d8\u05d5\u05e0\u05d9\u05df ($SERT$ activity) (StahlNeuro p.239)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d0\u05d7\u05d5\u05d6 \u05ea\u05e4\u05d5\u05e1\u05ea \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 $D_{2}$ \u05d4\u05e4\u05d5\u05e1\u05d8-\u05e1\u05d9\u05e0\u05e4\u05d8\u05d9\u05d9\u05dd \u05d4\u05d3\u05e8\u05d5\u05e9 \u05dc-Lumateperone \u05dc\u05e6\u05d5\u05e8\u05da \u05d0\u05e4\u05e7\u05d8 \u05d0\u05e0\u05d8\u05d9-\u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9?",
      "back": "\u05ea\u05e4\u05d5\u05e1\u05d4 \u05e0\u05de\u05d5\u05db\u05d4 \u05d9\u05d7\u05e1\u05d9\u05ea \u05e9\u05dc \u05e4\u05d7\u05d5\u05ea \u05de-$60\\%$, \u05d4\u05d5\u05d3\u05d5\u05ea \u05dc\u05e9\u05d9\u05dc\u05d5\u05d1 \u05e2\u05dd \u05d0\u05e0\u05d8\u05d2\u05d5\u05e0\u05d9\u05d6\u05dd \u05d7\u05d6\u05e7 \u05dc-$5-HT_{2A}$ (StahlNeuro p.239)."
    },
    {
      "front": "\u05d1\u05d0\u05d9\u05dc\u05d5 \u05ea\u05e0\u05d0\u05d9\u05dd \u05de\u05d8\u05d1\u05d5\u05dc\u05d9\u05d9\u05dd \u05e0\u05d7\u05e9\u05d1 Lumateperone \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05de\u05d5\u05e2\u05d3\u05e3 (\"Metabolically Friendly\")?",
      "back": "\u05d1\u05d7\u05d5\u05dc\u05d9\u05dd \u05e2\u05dd \u05d4\u05e9\u05de\u05e0\u05ea \u05d9\u05ea\u05e8 ($Obesity$), \u05e1\u05d5\u05db\u05e8\u05ea \u05d0\u05d5 \u05d3\u05d9\u05e1\u05dc\u05d9\u05e4\u05d9\u05d3\u05de\u05d9\u05d4, \u05d1\u05e9\u05dc \u05d4\u05d9\u05e2\u05d3\u05e8 \u05d4\u05e9\u05e4\u05e2\u05d4 \u05dc\u05e8\u05e2\u05d4 \u05e2\u05dc \u05de\u05d3\u05d3\u05d9\u05dd \u05d0\u05dc\u05d5 (StahlNeuro p.239)."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05de\u05e9\u05e4\u05d9\u05e2 \u05d0\u05e0\u05d8\u05d2\u05d5\u05e0\u05d9\u05d6\u05dd \u05dc\u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 $\\alpha_{2C}$ \u05d1-Lurasidone \u05e2\u05dc \u05d4\u05ea\u05de\u05d5\u05e0\u05d4 \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9\u05ea?",
      "back": "\u05d4\u05d5\u05d0 \u05ea\u05d5\u05e8\u05dd \u05dc\u05e9\u05d9\u05e4\u05d5\u05e8 \u05d1\u05ea\u05e4\u05e7\u05d5\u05d3 \u05d4\u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9 \u05d5\u05d1\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05e9\u05dc \u05de\u05e6\u05d1 \u05e8\u05d5\u05d7 (StahlNeuro p.225)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05d0\u05e0\u05d6\u05d9\u05dd \u05d4\u05db\u05d1\u05d3\u05d9 \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05d4\u05d0\u05d7\u05e8\u05d0\u05d9 \u05e2\u05dc \u05d4\u05de\u05d8\u05d1\u05d5\u05dc\u05d9\u05d6\u05dd \u05e9\u05dc Lurasidone?",
      "back": "\u05d4\u05d0\u05e0\u05d6\u05d9\u05dd $CYP3A4$ (StahlKids p.302; Dulcan p.785)."
    },
    {
      "front": "\u05de\u05d3\u05d5\u05e2 \u05de\u05d5\u05de\u05dc\u05e5 \u05dc\u05d9\u05d8\u05d5\u05dc Lurasidone \u05d1\u05e9\u05e2\u05d5\u05ea \u05d4\u05e2\u05e8\u05d1?",
      "back": "\u05db\u05d3\u05d9 \u05dc\u05d4\u05e4\u05d7\u05d9\u05ea \u05ea\u05d5\u05e4\u05e2\u05d5\u05ea \u05dc\u05d5\u05d5\u05d0\u05d9 \u05e9\u05dc \u05e1\u05d3\u05e6\u05d9\u05d4 ($Sedation$) \u05d5\u05d0\u05e7\u05ea\u05d9\u05d6\u05d9\u05d4 ($Akathisia$) (StahlKids p.303, p.308)."
    },
    {
      "front": "\u05de\u05d4 \u05e2\u05dc\u05d4 \u05d1\u05de\u05de\u05e6\u05d0\u05d9 \u05d4\u05de\u05d7\u05e7\u05e8\u05d9\u05dd \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9\u05d9\u05dd \u05dc\u05d2\u05d1\u05d9 \u05d9\u05e2\u05d9\u05dc\u05d5\u05ea Ziprasidone \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Schizophrenia \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d5\u05e0\u05d5\u05e2\u05e8?",
      "back": "\u05d4\u05d5\u05d0 \u05dc\u05d0 \u05d4\u05e8\u05d0\u05d4 \u05d9\u05e2\u05d9\u05dc\u05d5\u05ea (Did not show efficacy) \u05d1\u05de\u05d7\u05e7\u05e8\u05d9\u05dd \u05de\u05d1\u05d5\u05e7\u05e8\u05d9\u05dd \u05d1\u05e7\u05e8\u05d1 \u05d0\u05d5\u05db\u05dc\u05d5\u05e1\u05d9\u05d9\u05d4 \u05d6\u05d5 (Dulcan p.796)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05ea\u05d5\u05e4\u05e2\u05ea \u05d4\u05dc\u05d5\u05d5\u05d0\u05d9 \u05d4\u05dc\u05d1\u05d1\u05d9\u05ea \u05d4\u05de\u05d3\u05d0\u05d9\u05d2\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d1\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1-Ziprasidone \u05d4\u05de\u05d7\u05d9\u05d9\u05d1\u05ea \u05e0\u05d9\u05d8\u05d5\u05e8?",
      "back": "\u05d4\u05d0\u05e8\u05db\u05ea \u05de\u05e8\u05d5\u05d5\u05d7 $QTc$ (Risk of $QTc$ prolongation) (Dulcan p.820)."
    },
    {
      "front": "\u05d0\u05d9\u05dc\u05d5 \u05e9\u05dc\u05d5\u05e9\u05d4 SGA \u05de\u05d0\u05d5\u05e9\u05e8\u05d9\u05dd \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d4-FDA \u05dc\u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05d1\u05d9\u05e4\u05d5\u05dc\u05e8\u05d9 \u05d1\u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd, \u05d5\u05de\u05d9 \u05de\u05d4\u05dd \u05d0\u05d5\u05e9\u05e8\u05d5 \u05d2\u05dd \u05dc\u05e0\u05d5\u05e2\u05e8?",
      "back": "\u05de\u05d0\u05d5\u05e9\u05e8\u05d9\u05dd: $OFC$, $Quetiapine$, $Lurasidone$; \u05d1\u05e7\u05e8\u05d1 \u05e0\u05d5\u05e2\u05e8 (10\u201317) \u05d0\u05d5\u05e9\u05e8\u05d5 \u05e8\u05e7 $OFC$ \u05d5-$Lurasidone$ (Dulcan p.786)."
    },
    {
      "front": "\u05d0\u05d9\u05dc\u05d5 \u05ea\u05d5\u05e4\u05e2\u05d5\u05ea \u05dc\u05d5\u05d5\u05d0\u05d9 \u05e9\u05dc \u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05d0\u05e0\u05d8\u05d9-\u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9\u05d5\u05ea \u05e0\u05e4\u05d5\u05e6\u05d5\u05ea \u05d9\u05d5\u05ea\u05e8 \u05d1\u05e7\u05e8\u05d1 \u05d9\u05dc\u05d3\u05d9\u05dd \u05d5\u05e0\u05d5\u05e2\u05e8 \u05de\u05d0\u05e9\u05e8 \u05d1\u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd?",
      "back": "\u05e1\u05d3\u05e6\u05d9\u05d4, $EPS$ (\u05e4\u05e8\u05d8 \u05dc\u05d0\u05e7\u05ea\u05d9\u05d6\u05d9\u05d4), \u05e2\u05dc\u05d9\u05d9\u05d4 \u05d1\u05de\u05e9\u05e7\u05dc, \u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd \u05d1\u05de\u05d8\u05d1\u05d5\u05dc\u05d9\u05d6\u05dd \u05d5\u05e2\u05dc\u05d9\u05d4 \u05d1\u05e4\u05e8\u05d5\u05dc\u05e7\u05d8\u05d9\u05df (Dulcan p.819)."
    }
  ]
}