{
  "title": "Antipsychotics Quiz",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\u05d1\u05df 14 \u05de\u05d0\u05d5\u05d1\u05d7\u05df \u05e2\u05dd Bipolar I Disorder, Major Depressive Episode. \u05d4\u05d5\u05d0 \u05de\u05d8\u05d5\u05e4\u05dc \u05d1-Lurasidone \u05d1\u05de\u05d9\u05e0\u05d5\u05df $60\\ mg/day$. \u05dc\u05de\u05e8\u05d5\u05ea \u05d4\u05d9\u05e2\u05e0\u05d5\u05ea \u05d8\u05d5\u05d1\u05d4 \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc, \u05e8\u05de\u05ea \u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 \u05d1\u05d3\u05dd \u05d0\u05d9\u05e0\u05d4 \u05de\u05d2\u05d9\u05e2\u05d4 \u05dc\u05d8\u05d5\u05d5\u05d7 \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc\u05d9 \u05d5\u05d4\u05e0\u05e2\u05e8 \u05d0\u05d9\u05e0\u05d5 \u05de\u05d2\u05d9\u05d1 \u05e7\u05dc\u05d9\u05e0\u05d9\u05ea. \u05d1\u05d1\u05d9\u05e8\u05d5\u05e8 \u05de\u05e2\u05de\u05d9\u05e7 \u05de\u05ea\u05d2\u05dc\u05d4 \u05db\u05d9 \u05d4\u05d5\u05d0 \u05e0\u05d5\u05d8\u05dc \u05d0\u05ea \u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 \u05d1\u05d1\u05d5\u05e7\u05e8 \u05e2\u05dc \u05e7\u05d9\u05d1\u05d4 \u05e8\u05d9\u05e7\u05d4. \u05de\u05d4\u05d9 \u05d4\u05de\u05e9\u05de\u05e2\u05d5\u05ea \u05d4\u05e4\u05e8\u05de\u05e7\u05d5\u05e7\u05d9\u05e0\u05d8\u05d9\u05ea \u05e9\u05dc \u05e6\u05d5\u05e8\u05ea \u05e0\u05d8\u05d9\u05dc\u05d4 \u05d6\u05d5? (StahlKids p.301)",
      "answerOptions": [
        {
          "text": "\u05d4\u05d6\u05de\u05d9\u05e0\u05d5\u05ea \u05d4\u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea (Bioavailability) \u05d5\u05d4- $C_{max}$ \u05e9\u05dc \u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 \u05d9\u05d5\u05e8\u05d3\u05d9\u05dd \u05d1\u05e2\u05d3 50%.",
          "isCorrect": true,
          "rationale": "\u05e1\u05e4\u05d9\u05d2\u05ea \u05d4-Lurasidone \u05ea\u05dc\u05d5\u05d9\u05d4 \u05d1\u05d0\u05d5\u05e4\u05df \u05e7\u05e8\u05d9\u05d8\u05d9 \u05d1\u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05de\u05d6\u05d5\u05df (\u05dc\u05e4\u05d7\u05d5\u05ea 350 \u05e7\u05dc\u05d5\u05e8\u05d9\u05d5\u05ea); \u05e0\u05d8\u05d9\u05dc\u05d4 \u05dc\u05dc\u05d0 \u05d0\u05d5\u05db\u05dc \u05e4\u05d5\u05d2\u05e2\u05ea \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05d1\u05d6\u05de\u05d9\u05e0\u05d5\u05ea \u05d4\u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea \u05e9\u05dc \u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 (StahlKids p.301, p.303)."
        },
        {
          "text": "\u05e4\u05d9\u05e0\u05d5\u05d9 \u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 \u05d3\u05e8\u05da \u05d4\u05db\u05dc\u05d9\u05d5\u05ea \u05de\u05d5\u05d0\u05e5 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05d1\u05d4\u05d9\u05e2\u05d3\u05e8 \u05d7\u05dc\u05d1\u05d5\u05e0\u05d9\u05dd \u05d1\u05e7\u05d9\u05d1\u05d4.",
          "isCorrect": false,
          "rationale": "\u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d0\u05d9\u05e0\u05d5 \u05e7\u05e9\u05d5\u05e8 \u05dc\u05e4\u05d9\u05e0\u05d5\u05d9 \u05db\u05dc\u05d9\u05d9\u05ea\u05d9 \u05d0\u05dc\u05d0 \u05dc\u05e1\u05e4\u05d9\u05d2\u05d4 \u05d1\u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05e2\u05d9\u05db\u05d5\u05dc (Bioavailability) \u05d4\u05ea\u05dc\u05d5\u05d9\u05d4 \u05d1\u05e7\u05dc\u05d5\u05e8\u05d9\u05d5\u05ea (StahlKids p.301)."
        },
        {
          "text": "\u05e7\u05e6\u05d1 \u05d4\u05de\u05d8\u05d1\u05d5\u05dc\u05d9\u05d6\u05dd \u05d1\u05db\u05d1\u05d3 \u05e2\u05dc \u05d9\u05d3\u05d9 CYP3A4 \u05e2\u05d5\u05dc\u05d4 \u05d1-75%.",
          "isCorrect": false,
          "rationale": "\u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05de\u05d6\u05d5\u05df \u05d0\u05d9\u05e0\u05d4 \u05de\u05e9\u05e0\u05d4 \u05d0\u05ea \u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05d4\u05d0\u05e0\u05d6\u05d9\u05dd CYP3A4 \u05d0\u05dc\u05d0 \u05d0\u05ea \u05d9\u05e2\u05d9\u05dc\u05d5\u05ea \u05d4\u05e1\u05e4\u05d9\u05d2\u05d4 \u05d4\u05e8\u05d0\u05e9\u05d5\u05e0\u05d9\u05ea \u05e9\u05dc \u05d4\u05de\u05d5\u05dc\u05e7\u05d5\u05dc\u05d4 (StahlKids p.302)."
        },
        {
          "text": "\u05d4\u05d6\u05d9\u05e7\u05d4 (Affinity) \u05dc\u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 D2 \u05e2\u05d5\u05dc\u05d4 \u05d5\u05dc\u05db\u05df \u05de\u05d5\u05e4\u05d9\u05e2\u05d5\u05ea \u05d9\u05d5\u05ea\u05e8 \u05ea\u05d5\u05e4\u05e2\u05d5\u05ea \u05dc\u05d5\u05d5\u05d0\u05d9 EPS.",
          "isCorrect": false,
          "rationale": "\u05e0\u05d8\u05d9\u05dc\u05d4 \u05dc\u05dc\u05d0 \u05de\u05d6\u05d5\u05df \u05de\u05d5\u05e8\u05d9\u05d3\u05d4 \u05d0\u05ea \u05e8\u05de\u05d5\u05ea \u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 \u05d1\u05d3\u05dd, \u05de\u05d4 \u05e9\u05e6\u05e4\u05d5\u05d9 \u05dc\u05d4\u05e4\u05d7\u05d9\u05ea \u05d6\u05d9\u05e7\u05d4 \u05e4\u05d5\u05e1\u05d8-\u05e1\u05d9\u05e0\u05e4\u05d8\u05d9\u05ea \u05d5\u05dc\u05d0 \u05dc\u05d4\u05e2\u05dc\u05d5\u05ea \u05d0\u05d5\u05ea\u05d4 (StahlKids p.301)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05e9\u05e4\u05e2\u05ea \u05d4\u05de\u05d6\u05d5\u05df \u05e2\u05dc \u05d4-Bioavailability \u05e9\u05dc \u05ea\u05e8\u05d5\u05e4\u05d4 \u05d6\u05d5.",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05d1\u05d3\u05d9\u05d5\u05df \u05e2\u05dc \u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05e4\u05e2\u05d5\u05dc\u05d4 \u05d4\u05d9\u05d9\u05d7\u05d5\u05d3\u05d9 \u05e9\u05dc Lumateperone, \u05de\u05d4\u05d5 \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05d4\u05e0\u05d5\u05d9\u05e8\u05d5\u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d4\u05de\u05d5\u05e6\u05e2 \u05e9\u05de\u05d1\u05d3\u05d9\u05dc \u05d0\u05d5\u05ea\u05d4 \u05de\u05e0\u05d5\u05d2\u05d3\u05d9 \u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d4 \u05d0\u05d7\u05e8\u05d9\u05dd \u05de\u05d3\u05d5\u05e8 \u05e9\u05e0\u05d9 (SGA) \u05dc\u05d2\u05d1\u05d9 \u05d4\u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05d3\u05d5\u05e4\u05de\u05d9\u05e0\u05e8\u05d2\u05d9\u05ea? (StahlNeuro p.227)",
      "answerOptions": [
        {
          "text": "\u05d0\u05d2\u05d5\u05e0\u05d9\u05d6\u05dd \u05d7\u05dc\u05e7\u05d9 \u05dc\u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 D2 \u05e4\u05e8\u05d4-\u05e1\u05d9\u05e0\u05e4\u05d8\u05d9\u05d9\u05dd \u05d1\u05e9\u05d9\u05dc\u05d5\u05d1 \u05e2\u05dd \u05d0\u05e0\u05d8\u05d2\u05d5\u05e0\u05d9\u05d6\u05dd \u05e4\u05d5\u05e1\u05d8-\u05e1\u05d9\u05e0\u05e4\u05d8\u05d9.",
          "isCorrect": true,
          "rationale": "\u05e9\u05d9\u05dc\u05d5\u05d1 \u05d6\u05d4 \u05de\u05d0\u05e4\u05e9\u05e8 \u05d4\u05e4\u05d7\u05ea\u05ea \u05e1\u05d9\u05e0\u05ea\u05d6\u05ea \u05d3\u05d5\u05e4\u05de\u05d9\u05df \u05e4\u05e8\u05d4-\u05e1\u05d9\u05e0\u05e4\u05d8\u05d9\u05ea, \u05de\u05d4 \u05e9\u05de\u05e6\u05e8\u05d9\u05da \u05e4\u05d7\u05d5\u05ea \u05d7\u05e1\u05d9\u05de\u05d4 \u05e4\u05d5\u05e1\u05d8-\u05e1\u05d9\u05e0\u05e4\u05d8\u05d9\u05ea \u05dc\u05d4\u05e9\u05d2\u05ea \u05d0\u05e4\u05e7\u05d8 \u05d0\u05e0\u05d8\u05d9-\u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9 (StahlNeuro p.227)."
        },
        {
          "text": "\u05d0\u05e0\u05d8\u05d2\u05d5\u05e0\u05d9\u05d6\u05dd \u05d1\u05dc\u05ea\u05d9 \u05d4\u05e4\u05d9\u05da (Irreversible) \u05dc\u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 D2 \u05d1\u05de\u05e1\u05dc\u05d5\u05dc \u05d4\u05e0\u05d9\u05d2\u05e8\u05d5\u05e1\u05d8\u05e8\u05d9\u05d0\u05d8\u05dc\u05d9.",
          "isCorrect": false,
          "rationale": "\u05d7\u05e1\u05d9\u05de\u05d4 \u05d1\u05dc\u05ea\u05d9 \u05d4\u05e4\u05d9\u05db\u05d4 \u05d4\u05d9\u05d9\u05ea\u05d4 \u05d2\u05d5\u05e8\u05de\u05ea \u05dc-EPS \u05e7\u05e9\u05d4 \u05d5\u05e7\u05d1\u05d5\u05e2, \u05d1\u05e2\u05d5\u05d3 \u05e9-Lumateperone \u05de\u05ea\u05d0\u05e4\u05d9\u05d9\u05e0\u05ea \u05d1\u05e9\u05d9\u05e2\u05d5\u05e8 EPS \u05e0\u05de\u05d5\u05da \u05d1\u05de\u05d9\u05d5\u05d7\u05d3 (StahlNeuro p.226)."
        },
        {
          "text": "\u05e2\u05dc\u05d9\u05d9\u05d4 \u05d1\u05ea\u05e4\u05d5\u05e1\u05ea \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 D2 \u05e4\u05d5\u05e1\u05d8-\u05e1\u05d9\u05e0\u05e4\u05d8\u05d9\u05d9\u05dd \u05dc\u05e8\u05de\u05d4 \u05e9\u05dc \u05de\u05e2\u05dc 80% \u05d1\u05de\u05d9\u05e0\u05d5\u05e0\u05d9\u05dd \u05e0\u05de\u05d5\u05db\u05d9\u05dd.",
          "isCorrect": false,
          "rationale": "Lumateperone \u05e4\u05d5\u05e2\u05dc\u05ea \u05d1\u05d9\u05e2\u05d9\u05dc\u05d5\u05ea \u05d0\u05e0\u05d8\u05d9-\u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9\u05ea \u05d2\u05dd \u05d1\u05ea\u05e4\u05d5\u05e1\u05ea D2 \u05e0\u05de\u05d5\u05db\u05d4 \u05d9\u05d7\u05e1\u05d9\u05ea (\u05de\u05ea\u05d7\u05ea \u05dc-60%) \u05d1\u05e9\u05dc \u05d4\u05e9\u05e4\u05e2\u05d5\u05ea\u05d9\u05d4 \u05d4\u05e0\u05d5\u05e1\u05e4\u05d5\u05ea (StahlNeuro p.226)."
        },
        {
          "text": "\u05d7\u05e1\u05d9\u05de\u05d4 \u05e1\u05dc\u05e7\u05d8\u05d9\u05d1\u05d9\u05ea \u05e9\u05dc \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 D1 \u05d1\u05dc\u05d1\u05d3 \u05dc\u05dc\u05d0 \u05d4\u05e9\u05e4\u05e2\u05d4 \u05e2\u05dc D2.",
          "isCorrect": false,
          "rationale": "\u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 \u05e4\u05d5\u05e2\u05dc\u05ea \u05d2\u05dd \u05e2\u05dc \u05e7\u05d5\u05dc\u05d8\u05e0\u05d9 D2, D1 \u05d5-SERT, \u05d0\u05da \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05de\u05d1\u05d3\u05d9\u05dc \u05d4\u05e2\u05d9\u05e7\u05e8\u05d9 \u05d4\u05d5\u05d0 \u05d4\u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05d4\u05e4\u05e8\u05d4-\u05e1\u05d9\u05e0\u05e4\u05d8\u05d9\u05ea \u05d1-D2 (StahlNeuro p.226)."
        }
      ],
      "hint": "\u05d4\u05ea\u05de\u05e7\u05d3 \u05d1\u05d4\u05d1\u05d3\u05dc \u05e9\u05d1\u05d9\u05df \u05d4\u05e9\u05e4\u05e2\u05d4 \u05e4\u05e8\u05d4-\u05e1\u05d9\u05e0\u05e4\u05d8\u05d9\u05ea \u05dc\u05e4\u05d5\u05e1\u05d8-\u05e1\u05d9\u05e0\u05e4\u05d8\u05d9\u05ea \u05e2\u05dc \u05e7\u05d5\u05dc\u05d8\u05df \u05d4\u05d3\u05d5\u05e4\u05de\u05d9\u05df \u05d4\u05de\u05e8\u05db\u05d6\u05d9.",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05de\u05ea\u05d1\u05d2\u05e8\u05ea \u05d1\u05ea 16 \u05de\u05d5\u05d1\u05d0\u05ea \u05dc\u05d7\u05d3\u05e8 \u05de\u05d9\u05d5\u05df \u05d1\u05de\u05e6\u05d1 \u05e9\u05dc \u05d0\u05d2\u05d9\u05d8\u05e6\u05d9\u05d4 \u05e4\u05e1\u05d9\u05db\u05d5\u05de\u05d5\u05d8\u05d5\u05e8\u05d9\u05ea \u05d7\u05e8\u05d9\u05e4\u05d4 \u05e2\u05dc \u05e8\u05e7\u05e2 \u05d4\u05ea\u05dc\u05e7\u05d7\u05d5\u05ea \u05e1\u05db\u05d9\u05d6\u05d5\u05e4\u05e8\u05e0\u05d9\u05ea. \u05d4\u05e6\u05d5\u05d5\u05ea \u05e9\u05d5\u05e7\u05dc \u05de\u05ea\u05df \u05d8\u05d9\u05e4\u05d5\u05dc \u05d0\u05e0\u05d8\u05d9-\u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9 \u05d1\u05d4\u05d6\u05e8\u05e7\u05d4 (Short-acting IM) \u05d0\u05e9\u05e8 \u05d9\u05e6\u05d9\u05e2 \u05e4\u05e8\u05d5\u05e4\u05d9\u05dc \u05d1\u05d8\u05d9\u05d7\u05d5\u05ea\u05d9 \u05de\u05d9\u05d8\u05d1\u05d9 \u05de\u05d1\u05d7\u05d9\u05e0\u05d4 \u05de\u05d8\u05d1\u05d5\u05dc\u05d9\u05ea. \u05de\u05d4\u05d9 \u05d4\u05d0\u05d5\u05e4\u05e6\u05d9\u05d4 \u05d4\u05de\u05ea\u05d0\u05d9\u05de\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05e4\u05d9 \u05d4\u05de\u05e7\u05d5\u05e8\u05d5\u05ea? (Dulcan p.786, p.830)",
      "answerOptions": [
        {
          "text": "Ziprasidone IM",
          "isCorrect": true,
          "rationale": "Ziprasidone \u05d6\u05de\u05d9\u05df \u05d1\u05ea\u05e6\u05d5\u05e8\u05ea IM \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05d0\u05d2\u05d9\u05d8\u05e6\u05d9\u05d4 \u05d7\u05e8\u05d9\u05e4\u05d4 \u05d5\u05e0\u05d7\u05e9\u05d1 \u05dc\u05d1\u05e2\u05dc \u05e1\u05d9\u05db\u05d5\u05df \u05e0\u05de\u05d5\u05da \u05de\u05d0\u05d5\u05d3 \u05dc\u05e2\u05dc\u05d9\u05d9\u05d4 \u05d1\u05de\u05e9\u05e7\u05dc \u05d5\u05ea\u05d5\u05e4\u05e2\u05d5\u05ea \u05de\u05d8\u05d1\u05d5\u05dc\u05d9\u05d5\u05ea (Dulcan p.786, p.830)."
        },
        {
