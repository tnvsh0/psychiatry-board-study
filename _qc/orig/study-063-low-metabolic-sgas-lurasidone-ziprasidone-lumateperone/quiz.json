      ],
      "hint": "\u05d4\u05ea\u05de\u05e7\u05d3 \u05d1\u05e0\u05ea\u05d5\u05df \u05d4\u05e4\u05e8\u05de\u05e7\u05d5\u05e7\u05d9\u05e0\u05d8\u05d9 \u05d4\u05de\u05ea\u05d0\u05e8 \u05d0\u05ea \u05d6\u05de\u05df \u05d4\u05d9\u05e9\u05e8\u05d3\u05d5\u05ea \u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 \u05d1\u05d6\u05e8\u05dd \u05d4\u05d3\u05dd.",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05e0\u05e2\u05e8 \u05d1\u05df 17 \u05e2\u05dd \u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc Schizophrenia \u05de\u05d8\u05d5\u05e4\u05dc \u05d1-Ziprasidone. \u05d1\u05d1\u05d3\u05d9\u05e7\u05ea ECG \u05e9\u05d2\u05e8\u05ea\u05d9\u05ea \u05e0\u05de\u05e6\u05d0\u05d4 \u05d4\u05d0\u05e8\u05db\u05d4 \u05e9\u05dc \u05de\u05e8\u05d5\u05d5\u05d7 \u05d4-QTc \u05dc-470 \u05de\u05d9\u05dc\u05d9-\u05e9\u05e0\u05d9\u05d5\u05ea. \u05de\u05d4 \u05de\u05e6\u05d9\u05d9\u05e0\u05d9\u05dd \u05d4\u05de\u05e7\u05d5\u05e8\u05d5\u05ea \u05dc\u05d2\u05d1\u05d9 \u05e1\u05d9\u05db\u05d5\u05df \u05d4-QTc \u05d1-Ziprasidone \u05dc\u05e2\u05d5\u05de\u05ea \u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05db\u05de\u05d5 Thioridazine? (Dulcan p.820, p.826)",
