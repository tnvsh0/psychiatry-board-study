{
  "title": "Genetics Flashcards",
  "cards": [
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05d0\u05d8\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05d4 \u05d4\u05e6\u05d9\u05d8\u05d5\u05d2\u05e0\u05d8\u05d9\u05ea \u05e9\u05dc \u05ea\u05e1\u05de\u05d5\u05e0\u05ea \u05d5\u05d9\u05dc\u05d9\u05d0\u05de\u05e1 (Williams Syndrome)?",
      "back": "\u05de\u05d9\u05e7\u05e8\u05d5-\u05d3\u05dc\u05e6\u05d9\u05d4 \u05db\u05e8\u05d5\u05de\u05d5\u05d6\u05d5\u05de\u05dc\u05d9\u05ea \u05e1\u05e4\u05d5\u05e8\u05d3\u05d9\u05ea (spontaneous de novo) \u05d1\u05d0\u05d6\u05d5\u05e8 $7q11.23$, \u05d4\u05db\u05d5\u05dc\u05dc\u05ea \u05d0\u05ea \u05d4\u05d2\u05df \u05dc\u05d0\u05dc\u05e1\u05d8\u05d9\u05df ($ELN$) (\u05de\u05e7\u05d5\u05e8: Dulcan p.118)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05e4\u05e0\u05d5\u05d8\u05d9\u05e4 \u05d4\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea\u05d9 \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05d0\u05ea \u05d4\u05dc\u05d5\u05e7\u05d9\u05dd \u05d1\u05ea\u05e1\u05de\u05d5\u05e0\u05ea \u05d5\u05d9\u05dc\u05d9\u05d0\u05de\u05e1 (Williams Syndrome)?",
      "back": "\u05d7\u05d1\u05e8\u05ea\u05d9\u05d5\u05ea-\u05d9\u05ea\u05e8 (Hypersociability) \u05d5\u05e4\u05e0\u05d9\u05d9\u05d4 \u05d1\u05dc\u05ea\u05d9 \u05de\u05d1\u05d5\u05e7\u05e8\u05ea \u05dc\u05d6\u05e8\u05d9\u05dd (Indiscriminate friendliness), \u05dc\u05e6\u05d3 \u05d0\u05de\u05e4\u05ea\u05d9\u05d4 \u05d5\u05e8\u05d2\u05d9\u05e9\u05d5\u05ea \u05d1\u05d9\u05df-\u05d0\u05d9\u05e9\u05d9\u05ea \u05de\u05d5\u05d2\u05d1\u05e8\u05ea (\u05de\u05e7\u05d5\u05e8: Dulcan p.118, DSM p.918)."
    },
    {
      "front": "\u05d0\u05d9\u05d6\u05d4 \u05e8\u05db\u05d9\u05d1 \u05ea\u05d6\u05d5\u05e0\u05ea\u05d9 \u05de\u05d4\u05d5\u05d5\u05d4 \u05e7\u05d5\u05e0\u05d8\u05e8\u05d0-\u05d0\u05d9\u05e0\u05d3\u05d9\u05e7\u05e6\u05d9\u05d4 \u05d1\u05d7\u05d5\u05dc\u05d9 \u05ea\u05e1\u05de\u05d5\u05e0\u05ea \u05d5\u05d9\u05dc\u05d9\u05d0\u05de\u05e1 \u05d1\u05e9\u05dc \u05e0\u05d8\u05d9\u05d9\u05d4 \u05dc\u05d4\u05d9\u05e4\u05e8\u05e7\u05dc\u05e6\u05de\u05d9\u05d4?",
      "back": "\u05d9\u05e9 \u05dc\u05d4\u05d9\u05de\u05e0\u05e2 \u05de\u05de\u05ea\u05df Vitamin D (\u05de\u05e7\u05d5\u05e8: Dulcan p.118)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05d0\u05d8\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05d4 \u05d4\u05d2\u05e0\u05d8\u05d9\u05ea \u05d4\u05e9\u05db\u05d9\u05d7\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05ea\u05e1\u05de\u05d5\u05e0\u05ea \u05e4\u05e8\u05d0\u05d3\u05e8-\u05d5\u05d5\u05d9\u05dc\u05d9 (Prader-Willi Syndrome)?",
      "back": "\u05d0\u05d5\u05d1\u05d3\u05df \u05d1\u05d9\u05d8\u05d5\u05d9 \u05e9\u05dc \u05d2\u05e0\u05d9\u05dd \u05de\u05d5\u05d7\u05ea\u05de\u05d9\u05dd (imprinted) \u05d1\u05d6\u05e8\u05d5\u05e2 \u05d4\u05d0\u05e8\u05d5\u05db\u05d4 \u05e9\u05dc \u05db\u05e8\u05d5\u05de\u05d5\u05d6\u05d5\u05dd $15$ \u05d4\u05d0\u05d1\u05d4\u05d9, \u05dc\u05e8\u05d5\u05d1 \u05e2\u05e7\u05d1 Paternal Deletion \u05d1\u05db-$70\\%$ \u05de\u05d4\u05de\u05e7\u05e8\u05d9\u05dd (\u05de\u05e7\u05d5\u05e8: Dulcan p.119)."
    },
    {
      "front": "\u05d1\u05ea\u05e1\u05de\u05d5\u05e0\u05ea \u05e4\u05e8\u05d0\u05d3\u05e8-\u05d5\u05d5\u05d9\u05dc\u05d9, \u05de\u05d4\u05d5 \u05d4\u05de\u05e2\u05d1\u05e8 \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9 \u05d4\u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05d9 \u05d1\u05d9\u05df \u05e9\u05dc\u05d1 \u05d4\u05d9\u05e0\u05e7\u05d5\u05ea \u05dc\u05d9\u05dc\u05d3\u05d5\u05ea \u05d4\u05de\u05d5\u05e7\u05d3\u05de\u05ea?",
      "back": "\u05de\u05e2\u05d1\u05e8 \u05de\u05d4\u05d9\u05e4\u05d5\u05d8\u05d5\u05e0\u05d9\u05d4 (Hypotonia) \u05d5\u05e7\u05e9\u05d9\u05d9 \u05d4\u05d0\u05db\u05dc\u05d4 (FTT) \u05d1\u05d9\u05e0\u05e7\u05d5\u05ea \u05dc\u05d4\u05d9\u05e4\u05e8\u05e4\u05d0\u05d2\u05d9\u05d4 (Hyperphagia) \u05d5\u05d7\u05d9\u05e4\u05d5\u05e9 \u05de\u05d6\u05d5\u05df \u05db\u05e4\u05d9\u05d9\u05ea\u05d9 \u05d4\u05d7\u05dc \u05de\u05d2\u05d9\u05dc $2$ (\u05de\u05e7\u05d5\u05e8: Dulcan p.119)."
    },
    {
      "front": "\u05d0\u05d9\u05d6\u05d4 \u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d2\u05e0\u05d8\u05d9 \u05d1\u05ea\u05e1\u05de\u05d5\u05e0\u05ea \u05e4\u05e8\u05d0\u05d3\u05e8-\u05d5\u05d5\u05d9\u05dc\u05d9 \u05e7\u05e9\u05d5\u05e8 \u05dc\u05e1\u05d9\u05db\u05d5\u05df \u05de\u05d5\u05d2\u05d1\u05e8 \u05d1\u05de\u05d9\u05d5\u05d7\u05d3 \u05dc\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea Psychosis \u05d5-Depression?",
      "back": "\u05d3\u05d9\u05d6\u05d5\u05de\u05d9\u05d4 \u05d7\u05d3-\u05d4\u05d5\u05e8\u05d9\u05ea \u05d0\u05d9\u05de\u05d4\u05d9\u05ea (Maternal Uniparental Disomy - UPD 15) (\u05de\u05e7\u05d5\u05e8: Dulcan p.119)."
    },
    {
      "front": "\u05de\u05d4\u05dd \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9\u05dd \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9\u05d9\u05dd \u05e9\u05dc \u05d4-Behavioral Phenotype \u05d1\u05ea\u05e1\u05de\u05d5\u05e0\u05ea \u05d0\u05e0\u05d2\u05dc\u05de\u05df (Angelman Syndrome)?",
      "back": "\u05de\u05d6\u05d2 \u05e2\u05dc\u05d9\u05d6 (Happy demeanor), \u05e6\u05d7\u05d5\u05e7 \u05ea\u05db\u05d5\u05e3 \u05d5\u05d1\u05dc\u05ea\u05d9 \u05de\u05d5\u05ea\u05d0\u05dd, \u05d0\u05d9\u05e9\u05d9\u05d5\u05ea \u05e0\u05e8\u05d2\u05e9\u05ea, \u05d5\u05e0\u05d5\u05e7\u05e9\u05d5\u05ea \u05de\u05d5\u05d8\u05d5\u05e8\u05d9\u05ea \u05e2\u05dd \u05e0\u05e4\u05e0\u05d5\u05e4\u05d9 \u05d9\u05d3\u05d9\u05d9\u05dd (\u05de\u05e7\u05d5\u05e8: Dulcan p.118-119)."
    },
    {
      "front": "\u05d0\u05d9\u05dc\u05d5 \u05ea\u05e8\u05d5\u05e4\u05d5\u05ea Anticonvulsants \u05d4\u05df \u05e7\u05d5\u05e0\u05d8\u05e8\u05d0-\u05d0\u05d9\u05e0\u05d3\u05d9\u05e7\u05e6\u05d9\u05d4 \u05de\u05d5\u05d7\u05dc\u05d8\u05ea \u05d1\u05ea\u05e1\u05de\u05d5\u05e0\u05ea \u05d0\u05e0\u05d2\u05dc\u05de\u05df \u05d1\u05e9\u05dc \u05d7\u05e9\u05e9 \u05dc\u05d4\u05d7\u05de\u05e8\u05ea \u05e4\u05e8\u05db\u05d5\u05e1\u05d9\u05dd?",
      "back": "Vigabatrin \u05d5-Tiagabine (\u05de\u05e7\u05d5\u05e8: Dulcan p.119)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05d4\u05d2\u05e0\u05d8\u05d9 \u05dc\u05e4\u05ea\u05d7 Schizophrenia \u05d1\u05e7\u05e8\u05d1 \u05d7\u05d5\u05dc\u05d9\u05dd \u05e2\u05dd \u05ea\u05e1\u05de\u05d5\u05e0\u05ea \u05d3\u05dc\u05e6\u05d9\u05d9\u05ea $22q11.2$?",
      "back": "\u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05de\u05d5\u05e2\u05e8\u05da \u05d1\u05db-$25\\%$, \u05d5\u05d6\u05d5\u05d4\u05d9 \u05d4\u05ea\u05e1\u05de\u05d5\u05e0\u05ea \u05e2\u05dd \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05d4\u05d2\u05e0\u05d8\u05d9 \u05d4\u05d2\u05d1\u05d5\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d4 (\u05de\u05e7\u05d5\u05e8: Dulcan p.118)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05dc\u05d9\u05e7\u05d5\u05d9 \u05d4\u05d0\u05e0\u05d8\u05d5\u05de\u05d9 \u05d1\u05de\u05d1\u05e0\u05d4 \u05d4\u05d7\u05da \u05d4\u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05d9 \u05dc\u05ea\u05e1\u05de\u05d5\u05e0\u05ea $22q11.2$ \u05d5\u05de\u05d4 \u05d4\u05e9\u05e4\u05e2\u05ea\u05d5 \u05e2\u05dc \u05d4\u05d3\u05d9\u05d1\u05d5\u05e8?",
      "back": "\u05d0\u05d9-\u05e1\u05e4\u05d9\u05e7\u05ea \u05d4\u05d7\u05da \u05d5\u05d4\u05dc\u05d5\u05e2 (Velopharyngeal Insufficiency - VPI), \u05d4\u05d2\u05d5\u05e8\u05de\u05ea \u05dc\u05d3\u05d9\u05d1\u05d5\u05e8 \u05d0\u05e4\u05e1\u05d9 (Hypernasal speech) (\u05de\u05e7\u05d5\u05e8: Dulcan p.118)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05de\u05de\u05e6\u05d0 \u05d4\u05d2\u05d5\u05e4\u05e0\u05d9 \u05d4\u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05d9 \u05d1\u05d6\u05db\u05e8\u05d9\u05dd \u05e2\u05dd Fragile X Syndrome \u05dc\u05d0\u05d7\u05e8 \u05d4\u05d1\u05d2\u05e8\u05d5\u05ea \u05d4\u05de\u05d9\u05e0\u05d9\u05ea?",
      "back": "\u05de\u05d0\u05e7\u05e8\u05d5-\u05d0\u05d5\u05e8\u05db\u05d9\u05d3\u05d9\u05d6\u05dd (Macro-orchidism) (\u05de\u05e7\u05d5\u05e8: Dulcan p.120)."
    },
    {
      "front": "\u05d0\u05d9\u05d6\u05d5 \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d7\u05d1\u05e8\u05ea\u05d9\u05ea \u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05d9\u05ea \u05de\u05d4\u05d5\u05d5\u05d4 \u05e1\u05de\u05df \u05e4\u05e0\u05d5\u05d8\u05d9\u05e4\u05d9 \u05dc-Fragile X Syndrome \u05d5\u05de\u05d1\u05d3\u05d9\u05dc\u05d4 \u05d0\u05d5\u05ea\u05d4 \u05de-ASD \u05e7\u05dc\u05d0\u05e1\u05d9?",
      "back": "\u05e0\u05e1\u05d9\u05d2\u05ea \u05de\u05d1\u05d8 (Gaze aversion) (\u05de\u05e7\u05d5\u05e8: Dulcan p.120)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05de\u05d4\u05dc\u05da \u05d4\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9 \u05d4\u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05d9 \u05dc\u05ea\u05e1\u05de\u05d5\u05e0\u05ea \u05e8\u05d8 (Rett Syndrome) \u05d1\u05d1\u05e0\u05d5\u05ea?",
      "back": "\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea \u05ea\u05e7\u05d9\u05e0\u05d4 \u05dc\u05db\u05d0\u05d5\u05e8\u05d4 \u05d1\u05de\u05e9\u05da $6-18$ \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd, \u05d5\u05dc\u05d0\u05d7\u05e8\u05d9\u05d4 \u05e0\u05e1\u05d9\u05d2\u05d4 (Regression) \u05de\u05d4\u05d9\u05e8\u05d4 \u05d1\u05db\u05d9\u05e9\u05d5\u05e8\u05d9\u05dd \u05de\u05d5\u05d8\u05d5\u05e8\u05d9\u05d9\u05dd \u05d5\u05e9\u05e4\u05ea\u05d9\u05d9\u05dd (\u05de\u05e7\u05d5\u05e8: Dulcan p.120)."
    },
    {
      "front": "\u05de\u05d4\u05df \u05d4\u05e1\u05d8\u05e8\u05d9\u05d0\u05d5\u05d8\u05d9\u05e4\u05d9\u05d5\u05ea \u05d4\u05de\u05d5\u05d8\u05d5\u05e8\u05d9\u05d5\u05ea \u05d4\u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05d9\u05d5\u05ea \u05dc\u05ea\u05e1\u05de\u05d5\u05e0\u05ea \u05e8\u05d8 (Rett Syndrome)?",
      "back": "\u05e1\u05d8\u05e8\u05d9\u05d0\u05d5\u05d8\u05d9\u05e4\u05d9\u05d5\u05ea \u05e9\u05dc \u05e0\u05e4\u05e0\u05d5\u05e3 \u05d0\u05d5 \u05e9\u05e4\u05e9\u05d5\u05e3 \u05d9\u05d3\u05d9\u05d9\u05dd (Hand-wringing/Hand-washing stereotypies) (\u05de\u05e7\u05d5\u05e8: Dulcan p.120)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05d1\u05d9\u05d8\u05d5\u05d9 \u05d4\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea\u05d9 \u05d4\u05e7\u05d9\u05e6\u05d5\u05e0\u05d9 \u05d1\u05ea\u05e1\u05de\u05d5\u05e0\u05ea \u05dc\u05e9-\u05e0\u05d9\u05d4\u05df (Lesch-Nyhan Syndrome) \u05d4\u05e0\u05d5\u05d1\u05e2 \u05de\u05d7\u05e1\u05e8 \u05d1\u05d0\u05e0\u05d6\u05d9\u05dd HGPRT?",
      "back": "\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05e9\u05dc Self-mutilation \u05d7\u05de\u05d5\u05e8\u05d4 \u05d5\u05d1\u05dc\u05ea\u05d9 \u05e0\u05e9\u05dc\u05d8\u05ea, \u05d4\u05db\u05d5\u05dc\u05dc\u05ea \u05e0\u05e9\u05d9\u05db\u05ea \u05e9\u05e4\u05ea\u05d9\u05d9\u05dd \u05d5\u05d0\u05e6\u05d1\u05e2\u05d5\u05ea (\u05de\u05e7\u05d5\u05e8: Dulcan p.121)."
    },
    {
      "front": "\u05d0\u05d9\u05d6\u05d4 \u05e0\u05d9\u05d8\u05d5\u05e8 \u05de\u05e2\u05d1\u05d3\u05ea\u05d9 \u05d7\u05d9\u05d5\u05e0\u05d9 \u05dc\u05d1\u05e6\u05e2 \u05d1\u05d7\u05d5\u05dc\u05d9 $22q11.2$ \u05dc\u05e4\u05e0\u05d9 \u05d4\u05ea\u05d7\u05dc\u05ea \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05ea\u05e8\u05d5\u05e4\u05d5\u05ea Antipsychotic?",
      "back": "\u05e8\u05de\u05d5\u05ea \u05e1\u05d9\u05d3\u05df \u05d1\u05d3\u05dd (Serum Calcium) \u05d5\u05d1\u05d9\u05e6\u05d5\u05e2 ECG \u05dc\u05d4\u05e2\u05e8\u05db\u05ea \u05de\u05e7\u05d8\u05e2 QT (\u05de\u05e7\u05d5\u05e8: Dulcan p.118)."
    },
    {
