{
  "title": "Psychiatry Quiz",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\u05d1\u05df 9 \u05de\u05d5\u05e4\u05e0\u05d4 \u05dc\u05d4\u05e2\u05e8\u05db\u05d4 \u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9\u05ea \u05d1\u05e9\u05dc \u05d4\u05ea\u05e4\u05e8\u05e6\u05d5\u05d9\u05d5\u05ea \u05d6\u05e2\u05dd (temper outbursts) \u05d4\u05de\u05ea\u05e8\u05d7\u05e9\u05d5\u05ea \u05db-4 \u05e4\u05e2\u05de\u05d9\u05dd \u05d1\u05e9\u05d1\u05d5\u05e2 \u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05e9\u05e0\u05d4 \u05d4\u05d0\u05d7\u05e8\u05d5\u05e0\u05d4, \u05d4\u05df \u05d1\u05d1\u05d9\u05ea \u05d5\u05d4\u05df \u05d1\u05d1\u05d9\u05ea \u05d4\u05e1\u05e4\u05e8. \u05d1\u05d9\u05df \u05d4\u05d4\u05ea\u05e4\u05e8\u05e6\u05d5\u05d9\u05d5\u05ea, \u05de\u05e6\u05d1 \u05e8\u05d5\u05d7\u05d5 \u05e9\u05dc \u05d4\u05d9\u05dc\u05d3 irritable \u05d5\u05d6\u05e2\u05d5\u05e3 \u05e8\u05d5\u05d1 \u05e9\u05e2\u05d5\u05ea \u05d4\u05d9\u05d5\u05dd. \u05d4\u05d4\u05d5\u05e8\u05d9\u05dd \u05e9\u05d5\u05dc\u05dc\u05d9\u05dd \u05ea\u05e7\u05d5\u05e4\u05d5\u05ea \u05e9\u05dc \u05d9\u05e8\u05d9\u05d3\u05d4 \u05d1\u05e6\u05d5\u05e8\u05da \u05d1\u05e9\u05d9\u05e0\u05d4 \u05d0\u05d5 \u05d2\u05e8\u05e0\u05d3\u05d9\u05d5\u05d6\u05d9\u05d5\u05ea. \u05de\u05d4\u05d5 \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9 \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05d4\u05de\u05d1\u05d3\u05d9\u05dc \u05de\u05e7\u05e8\u05d4 \u05d6\u05d4 \u05de-Bipolar Disorder \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR?",
      "answerOptions": [
        {
          "text": "\u05d4\u05e0\u05d5\u05db\u05d7\u05d5\u05ea \u05e9\u05dc Chronic, persistent irritability \u05dc\u05e2\u05d5\u05de\u05ea \u05d0\u05e4\u05d9\u05d6\u05d5\u05d3\u05d9\u05d5\u05ea \u05e9\u05dc \u05de\u05d0\u05e0\u05d9\u05d4.",
          "isCorrect": true,
          "rationale": "\u05d4-DSM-5-TR \u05de\u05d3\u05d2\u05d9\u05e9 \u05db\u05d9 DMDD \u05e0\u05d5\u05e1\u05e4\u05d4 \u05db\u05d3\u05d9 \u05dc\u05ea\u05d0\u05e8 \u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd \u05e8\u05d2\u05d6\u05e0\u05d5\u05ea \u05db\u05e8\u05d5\u05e0\u05d9\u05ea \u05e9\u05d0\u05d9\u05e0\u05d4 \u05d0\u05e4\u05d9\u05d6\u05d5\u05d3\u05d9\u05ea, \u05d1\u05e2\u05d5\u05d3 \u05e9-Bipolar Disorder \u05de\u05d7\u05d9\u05d9\u05d1\u05ea \u05d0\u05e4\u05d9\u05d6\u05d5\u05d3\u05d5\u05ea \u05d1\u05e8\u05d5\u05e8\u05d5\u05ea \u05e9\u05dc \u05de\u05d0\u05e0\u05d9\u05d4 \u05d0\u05d5 \u05d4\u05d9\u05e4\u05d5\u05de\u05d0\u05e0\u05d9\u05d4 (DSM p. 179)."
        },
        {
          "text": "\u05d7\u05d5\u05de\u05e8\u05ea \u05d4\u05ea\u05e4\u05e8\u05e6\u05d5\u05d9\u05d5\u05ea \u05d4\u05d6\u05e2\u05dd \u05d5\u05d4\u05e4\u05d2\u05d9\u05e2\u05d4 \u05d4\u05ea\u05e4\u05e7\u05d5\u05d3\u05d9\u05ea \u05d1\u05d1\u05d9\u05ea \u05d4\u05e1\u05e4\u05e8.",
          "isCorrect": false,
          "rationale": "\u05d7\u05d5\u05de\u05e8\u05d4 \u05d5\u05e4\u05d2\u05d9\u05e2\u05d4 \u05ea\u05e4\u05e7\u05d5\u05d3\u05d9\u05ea \u05e7\u05d9\u05d9\u05de\u05d5\u05ea \u05d1\u05e9\u05ea\u05d9 \u05d4\u05d0\u05d1\u05d7\u05e0\u05d5\u05ea \u05d5\u05d0\u05d9\u05e0\u05df \u05de\u05d4\u05d5\u05d5\u05ea \u05d0\u05ea \u05d4\u05de\u05d1\u05d7\u05d9\u05df \u05d4\u05e2\u05d9\u05e7\u05e8\u05d9 \u05d1\u05d9\u05df \u05d4\u05de\u05e6\u05d1\u05d9\u05dd (Dulcan p. 268)."
        },
        {
          "text": "\u05d2\u05d9\u05dc \u05d4\u05e4\u05e8\u05d9\u05e6\u05d4 \u05e9\u05dc \u05d4\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05dc\u05e4\u05e0\u05d9 \u05d2\u05d9\u05dc 10.",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05e9-DMDD \u05d3\u05d5\u05e8\u05e9\u05ea \u05d4\u05ea\u05d7\u05dc\u05d4 \u05dc\u05e4\u05e0\u05d9 \u05d2\u05d9\u05dc 10, \u05de\u05d0\u05e0\u05d9\u05d4 \u05d9\u05db\u05d5\u05dc\u05d4 \u05dc\u05d4\u05d5\u05e4\u05d9\u05e2 \u05d1\u05db\u05dc \u05d2\u05d9\u05dc, \u05d5\u05dc\u05db\u05df \u05d4\u05d2\u05d9\u05dc \u05dc\u05d1\u05d3\u05d5 \u05d0\u05d9\u05e0\u05d5 \u05d4\u05de\u05d1\u05d7\u05d9\u05df \u05d4\u05e4\u05e0\u05d5\u05de\u05e0\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d4\u05de\u05e8\u05db\u05d6\u05d9 (DSM p. 178)."
        },
        {
          "text": "\u05d4\u05d9\u05e2\u05d3\u05e8 \u05ea\u05d2\u05d5\u05d1\u05d4 \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Lithium \u05d0\u05d5 \u05de\u05d9\u05d9\u05e6\u05d1\u05d9 \u05de\u05e6\u05d1 \u05e8\u05d5\u05d7.",
          "isCorrect": false,
          "rationale": "\u05d0\u05d1\u05d7\u05e0\u05d4 \u05e0\u05e2\u05e9\u05d9\u05ea \u05e2\u05dc \u05e1\u05de\u05da \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05e7\u05dc\u05d9\u05e0\u05d9\u05d9\u05dd \u05d5\u05dc\u05d0 \u05e2\u05dc \u05e1\u05de\u05da \u05ea\u05d2\u05d5\u05d1\u05d4 \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05ea\u05e8\u05d5\u05e4\u05ea\u05d9, \u05de\u05d4 \u05d2\u05dd \u05e9\u05d4\u05e1\u05e4\u05e8\u05d5\u05ea \u05e2\u05dc \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-DMDD \u05e2\u05d3\u05d9\u05d9\u05df \u05de\u05ea\u05d2\u05d1\u05e9\u05ea (Dulcan p. 303)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d1\u05d5 \u05e2\u05dc \u05e6\u05d9\u05e8 \u05d4\u05d6\u05de\u05df \u05e9\u05dc \u05de\u05e6\u05d1 \u05d4\u05e8\u05d5\u05d7 - \u05d4\u05d0\u05dd \u05d4\u05d5\u05d0 \u05de\u05d5\u05e4\u05d9\u05e2 \u05d1\u05d2\u05dc\u05d9\u05dd \u05d0\u05d5 \u05e9\u05d4\u05d5\u05d0 \u05e7\u05d1\u05d5\u05e2 \u05dc\u05d0\u05d5\u05e8\u05da \u05d6\u05de\u05df?",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05de\u05ea\u05d1\u05d2\u05e8 \u05d4\u05de\u05d0\u05d5\u05d1\u05d7\u05df \u05e2\u05dd ADHD \u05d5\u05de\u05d8\u05d5\u05e4\u05dc \u05d1-Methylphenidate \u05de\u05e6\u05d9\u05d2 \u05d4\u05d3\u05e8\u05d3\u05e8\u05d5\u05ea \u05ea\u05e4\u05e7\u05d5\u05d3\u05d9\u05ea, \u05d4\u05e1\u05ea\u05d2\u05e8\u05d5\u05ea \u05d5\u05d1\u05d9\u05d8\u05d5\u05d9\u05d9\u05dd \u05e9\u05dc self-hatred. \u05e2\u05dc \u05e4\u05d9 \u05d4-StahlKids, \u05de\u05d4\u05d5 \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9 \u05d4\u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9 \u05e9\u05d9\u05e9 \u05dc\u05e0\u05d8\u05e8 \u05d1\u05e7\u05e4\u05d9\u05d3\u05d4 \u05d0\u05e6\u05dc \u05d7\u05d5\u05dc\u05d9 ADHD \u05d4\u05de\u05e4\u05ea\u05d7\u05d9\u05dd Comorbid MDD?",
      "answerOptions": [
        {
          "text": "\u05e1\u05d9\u05db\u05d5\u05df \u05de\u05d5\u05d2\u05d1\u05e8 \u05dc\u05de\u05e2\u05e9\u05d9\u05dd \u05d0\u05d9\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05d9\u05dd \u05e9\u05dc \u05e4\u05d2\u05d9\u05e2\u05d4 \u05e2\u05e6\u05de\u05d9\u05ea \u05d5\u05d0\u05d5\u05d1\u05d3\u05e0\u05d5\u05ea.",
          "isCorrect": true,
          "rationale": "\u05d7\u05d5\u05dc\u05d9 ADHD \u05e0\u05de\u05e6\u05d0\u05d9\u05dd \u05d1\u05e1\u05d9\u05db\u05d5\u05df \u05d2\u05d1\u05d5\u05d4 \u05dc\u05d0\u05d5\u05d1\u05d3\u05e0\u05d5\u05ea \u05e2\u05e7\u05d1 \u05e9\u05d9\u05dc\u05d5\u05d1 \u05e9\u05dc \u05d3\u05d9\u05de\u05d5\u05d9 \u05e2\u05e6\u05de\u05d9 \u05e0\u05de\u05d5\u05da, \u05d0\u05d9\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05d5\u05ea \u05d5\u05d4\u05d5\u05e4\u05e2\u05ea \u05d3\u05d9\u05db\u05d0\u05d5\u05df (StahlKids p. 152)."
        },
        {
          "text": "\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea \u05e9\u05dc Psychosis \u05de\u05e9\u05e0\u05d9\u05ea \u05dc\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1-Stimulants.",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05e9\u05e4\u05e1\u05d9\u05db\u05d5\u05d6\u05d4 \u05d4\u05d9\u05d0 \u05ea\u05d5\u05e4\u05e2\u05ea \u05dc\u05d5\u05d5\u05d0\u05d9 \u05d0\u05e4\u05e9\u05e8\u05d9\u05ea, \u05d4\u05d9\u05d0 \u05e0\u05d3\u05d9\u05e8\u05d4 \u05d9\u05d5\u05ea\u05e8 \u05de\u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05d4\u05d0\u05d5\u05d1\u05d3\u05e0\u05d9 \u05d1\u05d4\u05e7\u05e9\u05e8 \u05e9\u05dc \u05e7\u05d5\u05de\u05d5\u05e8\u05d1\u05d9\u05d3\u05d9\u05d5\u05ea \u05e2\u05dd \u05d3\u05d9\u05db\u05d0\u05d5\u05df (StahlKids p. 288)."
        },
        {
          "text": "\u05d9\u05e8\u05d9\u05d3\u05d4 \u05d1\u05d9\u05e2\u05d9\u05dc\u05d5\u05ea \u05d4-Stimulants \u05d4\u05d3\u05d5\u05e8\u05e9\u05ea \u05d4\u05e2\u05dc\u05d0\u05ea \u05de\u05d9\u05e0\u05d5\u05df \u05de\u05d9\u05d9\u05d3\u05d9\u05ea.",
          "isCorrect": false,
          "rationale": "\u05d4\u05d5\u05e4\u05e2\u05ea \u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05d3\u05d5\u05e8\u05e9\u05ea \u05d4\u05ea\u05d9\u05d9\u05d7\u05e1\u05d5\u05ea \u05d0\u05d1\u05d7\u05e0\u05ea\u05d9\u05ea \u05d5\u05d8\u05d9\u05e4\u05d5\u05dc\u05d9\u05ea \u05dc\u05de\u05e6\u05d1 \u05d4\u05e8\u05d5\u05d7, \u05d5\u05dc\u05d0 \u05e8\u05e7 \u05d4\u05e2\u05dc\u05d0\u05ea \u05de\u05d9\u05e0\u05d5\u05df \u05dc-ADHD (Dulcan p. 255)."
        },
        {
          "text": "\u05d4\u05d5\u05e4\u05e2\u05d4 \u05e9\u05dc Tics \u05de\u05d5\u05d8\u05d5\u05e8\u05d9\u05d9\u05dd \u05d5\u05e7\u05d5\u05dc\u05d9\u05d9\u05dd \u05de\u05d5\u05e8\u05db\u05d1\u05d9\u05dd.",
          "isCorrect": false,
          "rationale": "\u05d8\u05d9\u05e7\u05d9\u05dd \u05d4\u05dd \u05ea\u05d5\u05e4\u05e2\u05ea \u05dc\u05d5\u05d5\u05d0\u05d9 \u05de\u05d5\u05db\u05e8\u05ea \u05e9\u05dc \u05e1\u05d8\u05d9\u05de\u05d5\u05dc\u05e0\u05d8\u05d9\u05dd, \u05d0\u05da \u05d4\u05dd \u05d0\u05d9\u05e0\u05dd \u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05d4\u05de\u05e7\u05d5\u05e9\u05e8 \u05dc\u05e9\u05d9\u05dc\u05d5\u05d1 \u05e9\u05dc ADHD \u05d5\u05d3\u05d9\u05db\u05d0\u05d5\u05df (Dulcan p. 89)."
        }
      ],
      "hint": "\u05d4\u05ea\u05de\u05e7\u05d3\u05d5 \u05d1\u05e9\u05d9\u05dc\u05d5\u05d1 \u05e9\u05d1\u05d9\u05df \u05d7\u05d5\u05e1\u05e8 \u05e2\u05db\u05d1\u05d5\u05ea (Impulsivity) \u05dc\u05d1\u05d9\u05df \u05d9\u05d9\u05d0\u05d5\u05e9 \u05e2\u05de\u05d5\u05e7.",
      "imageUrls": []
    },
    {
      "type": "multiple_select",
      "question": "\u05d9\u05dc\u05d3\u05d4 \u05d1\u05ea 5 \u05d4\u05d5\u05d1\u05d0\u05d4 \u05dc\u05de\u05e8\u05e4\u05d0\u05d4 \u05dc\u05d0\u05d7\u05e8 \u05e9\u05e0\u05d7\u05e9\u05e4\u05d4 \u05dc\u05d0\u05d9\u05e8\u05d5\u05e2 \u05d8\u05e8\u05d0\u05d5\u05de\u05d8\u05d9. \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR, \u05d0\u05d9\u05dc\u05d5 \u05de\u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9\u05dd \u05d4\u05d1\u05d0\u05d9\u05dd \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05d9\u05dd \u05dc\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05e9\u05dc PTSD \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d1\u05d2\u05d9\u05dc 6 \u05d5\u05de\u05d8\u05d4 (Preschool PTSD)?",
      "answerOptions": [
        {
          "text": "\u05e9\u05d7\u05d6\u05d5\u05e8 \u05d4\u05d8\u05e8\u05d0\u05d5\u05de\u05d4 \u05e2\u05e9\u05d5\u05d9 \u05dc\u05d4\u05d5\u05e4\u05d9\u05e2 \u05d3\u05e8\u05da \u05de\u05e9\u05d7\u05e7 (Traumatic play) \u05e9\u05d0\u05d9\u05e0\u05d5 \u05e0\u05ea\u05e4\u05e1 \u05d1\u05d4\u05db\u05e8\u05d7 \u05db\u05de\u05e2\u05d5\u05e8\u05e8 \u05de\u05e6\u05d5\u05e7\u05d4.",
          "isCorrect": true,
          "rationale": "\u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05e6\u05e2\u05d9\u05e8\u05d9\u05dd, \u05d6\u05d9\u05db\u05e8\u05d5\u05e0\u05d5\u05ea \u05d7\u05d5\u05d3\u05e8\u05e0\u05d9\u05d9\u05dd \u05e2\u05e9\u05d5\u05d9\u05d9\u05dd \u05e9\u05dc\u05d0 \u05dc\u05d4\u05d9\u05e8\u05d0\u05d5\u05ea \u05db\u05de\u05e6\u05d5\u05e7\u05d4 \u05d9\u05e9\u05d9\u05e8\u05d4 \u05d0\u05dc\u05d0 \u05dc\u05d4\u05d5\u05e4\u05d9\u05e2 \u05db\u05de\u05e9\u05d7\u05e7 \u05d7\u05d5\u05d6\u05e8 \u05d4\u05de\u05d1\u05d8\u05d0 \u05d0\u05ea \u05d4\u05ea\u05d5\u05db\u05df \u05d4\u05d8\u05e8\u05d0\u05d5\u05de\u05d8\u05d9 (DSM p. 303)."
        },
        {
          "text": "\u05e6\u05de\u05e6\u05d5\u05dd \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9 \u05d1\u05d9\u05db\u05d5\u05dc\u05ea \u05dc\u05d7\u05d5\u05d5\u05ea \u05e8\u05d2\u05e9\u05d5\u05ea \u05d7\u05d9\u05d5\u05d1\u05d9\u05d9\u05dd (Constricted affect).",
          "isCorrect": true,
