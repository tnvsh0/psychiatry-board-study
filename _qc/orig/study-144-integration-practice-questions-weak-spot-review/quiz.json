      "hint": "\u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05de\u05e6\u05d1 \u05d6\u05d4 \u05d4\u05d5\u05d0 \u05e7\u05d5\u05d3\u05dd \u05db\u05dc \u05d0\u05d8\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d5\u05e1\u05d1\u05d9\u05d1\u05ea\u05d9.",
      "imageUrls": []
