      "hint": "\u05d7\u05d9\u05e9\u05d1\u05d5 \u05db\u05d9\u05e6\u05d3 \u05d9\u05dc\u05d3\u05d9\u05dd \u05e7\u05d8\u05e0\u05d9\u05dd \u05de\u05e2\u05d1\u05d3\u05d9\u05dd \u05de\u05d9\u05d3\u05e2 \u05d1\u05e6\u05d5\u05e8\u05d4 \u05dc\u05d0 \u05de\u05d9\u05dc\u05d5\u05dc\u05d9\u05ea \u05d5\u05de\u05e9\u05d7\u05e7\u05d9\u05ea.",
      "hasAllOfTheAbove": false,
      "hasNoneOfTheAbove": false,
      "imageUrls": []
