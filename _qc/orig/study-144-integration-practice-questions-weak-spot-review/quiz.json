        },
        {
          "text": "\u05d1\u05d9\u05d3\u05d5\u05d3 (Seclusion) \u05de\u05d9\u05d9\u05d3\u05d9 \u05d1\u05d7\u05d3\u05e8 \u05d7\u05e9\u05d5\u05da \u05dc\u05de\u05e0\u05d9\u05e2\u05ea \u05d2\u05d9\u05e8\u05d5\u05d9\u05d9\u05dd.",
          "isCorrect": false,
