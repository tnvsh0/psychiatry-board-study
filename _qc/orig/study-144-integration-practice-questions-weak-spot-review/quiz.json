        },
        {
          "text": "\u05d4\u05ea\u05d7\u05dc\u05d4 \u05de\u05d9\u05d9\u05d3\u05d9\u05ea \u05e9\u05dc SSRI \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05d7\u05e8\u05d3\u05d4 \u05d4\u05e0\u05dc\u05d5\u05d5\u05d9\u05ea.",
          "isCorrect": false,
