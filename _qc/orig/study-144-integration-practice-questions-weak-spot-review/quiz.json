    {
      "type": "short_answer",
      "question": "\u05de\u05d3\u05d5\u05e2 \u05de\u05de\u05dc\u05d9\u05e5 \u05d4-StahlKids \u05dc\u05d4\u05d9\u05de\u05e0\u05e2 \u05db\u05db\u05dc \u05d4\u05d0\u05e4\u05e9\u05e8 \u05de\u05de\u05ea\u05df \u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05de\u05de\u05e8\u05d9\u05e6\u05d5\u05ea (Stimulants) \u05d1\u05de\u05d4\u05dc\u05da \u05e9\u05e2\u05d5\u05ea \u05d1\u05d9\u05ea \u05d4\u05e1\u05e4\u05e8?",
      "grading": {
        "modelAnswer": "\u05de\u05ea\u05df \u05ea\u05e8\u05d5\u05e4\u05d4 \u05d1\u05d1\u05d9\u05ea \u05d4\u05e1\u05e4\u05e8 \u05e2\u05dc\u05d5\u05dc \u05dc\u05d4\u05d5\u05d1\u05d9\u05dc \u05dc\u05e1\u05d8\u05d9\u05d2\u05de\u05d4 \u05d7\u05d1\u05e8\u05ea\u05d9\u05ea, \u05dc\u05d4\u05d9\u05de\u05e0\u05e2\u05d5\u05ea \u05e9\u05dc \u05d4\u05d9\u05dc\u05d3 \u05de\u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05de\u05ea\u05d5\u05da \u05e8\u05e6\u05d5\u05df \u05dc\u05d4\u05e1\u05ea\u05d9\u05e8 \u05d0\u05d5\u05ea\u05d5, \u05d5\u05dc\u05e1\u05d9\u05db\u05d5\u05df \u05e9\u05dc \u05d4\u05d8\u05d9\u05d9\u05ea \u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 (Diversion) \u05dc\u05d9\u05d3\u05d9\u05d9\u05dd \u05d0\u05d7\u05e8\u05d5\u05ea.",
        "rationale": "\u05d4\u05d4\u05de\u05dc\u05e6\u05d4 \u05e0\u05d5\u05d1\u05e2\u05ea \u05de\u05e9\u05d9\u05e7\u05d5\u05dc\u05d9\u05dd \u05e4\u05e1\u05d9\u05db\u05d5-\u05e1\u05d5\u05e6\u05d9\u05d0\u05dc\u05d9\u05d9\u05dd \u05d5\u05d1\u05d8\u05d9\u05d7\u05d5\u05ea\u05d9\u05d9\u05dd \u05d4\u05e7\u05e9\u05d5\u05e8\u05d9\u05dd \u05dc\u05e1\u05d1\u05d9\u05d1\u05ea \u05d1\u05d9\u05ea \u05d4\u05e1\u05e4\u05e8 (StahlKids p. 152).",
        "requiredAttributes": [
          "\u05e6\u05d9\u05d5\u05df \u05e0\u05d5\u05e9\u05d0 \u05d4\u05e1\u05d8\u05d9\u05d2\u05de\u05d4 (Stigma).",
