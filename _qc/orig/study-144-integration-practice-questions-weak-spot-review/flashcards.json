{
  "title": "Psychiatry Flashcards",
  "cards": [
    {
      "front": "\u05de\u05d4\u05d5 \u05d2\u05d9\u05dc \u05d4\u05e1\u05e3 \u05dc\u05d4\u05d5\u05e4\u05e2\u05ea \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d1\u05d0\u05d1\u05d7\u05e0\u05ea ADHD \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR?",
      "back": "\u05d7\u05dc\u05e7 \u05de\u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d4\u05de\u05d2\u05d3\u05d9\u05e8\u05d9\u05dd \u05d0\u05ea \u05d4\u05d4\u05e4\u05e8\u05e2\u05d4 \u05d7\u05d9\u05d9\u05d1\u05d9\u05dd \u05dc\u05d4\u05d5\u05e4\u05d9\u05e2 \u05dc\u05e4\u05e0\u05d9 \u05d2\u05d9\u05dc 12 (DSM p.68)."
    },
    {
      "front": "\u05db\u05de\u05d4 \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e0\u05d3\u05e8\u05e9\u05d9\u05dd \u05dc\u05d0\u05d1\u05d7\u05e0\u05ea Inattention \u05d1\u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd \u05d1\u05e0\u05d9 $17$ \u05d5\u05de\u05e2\u05dc\u05d4?",
      "back": "\u05e0\u05d3\u05e8\u05e9\u05d9\u05dd \u05dc\u05e4\u05d7\u05d5\u05ea 5 \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd, \u05d1\u05e0\u05d9\u05d2\u05d5\u05d3 \u05dc-6 \u05d4\u05e0\u05d3\u05e8\u05e9\u05d9\u05dd \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05e6\u05e2\u05d9\u05e8\u05d9\u05dd \u05d9\u05d5\u05ea\u05e8 (DSM p.68)."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05e2\u05e9\u05d5\u05d9\u05d4 \u05dc\u05d4\u05d5\u05e4\u05d9\u05e2 \u05d0\u05d1\u05d7\u05e0\u05ea Depressed mood \u05d1\u05e7\u05e8\u05d1 \u05d9\u05dc\u05d3\u05d9\u05dd \u05d5\u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd?",
      "back": "\u05d4\u05de\u05e6\u05d1 \u05e2\u05e9\u05d5\u05d9 \u05dc\u05d4\u05ea\u05d1\u05d8\u05d0 \u05db-Irritable mood \u05d1\u05de\u05e7\u05d5\u05dd \u05de\u05e6\u05d1 \u05e8\u05d5\u05d7 \u05e2\u05e6\u05d5\u05d1 \u05d0\u05d5 \u05d9\u05e8\u05d5\u05d3 (DSM p.183)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05de\u05e9\u05da \u05d4\u05d6\u05de\u05df \u05d4\u05e0\u05d3\u05e8\u05e9 \u05dc\u05d0\u05d1\u05d7\u05e0\u05ea Persistent Depressive Disorder \u05d1\u05e7\u05e8\u05d1 \u05d9\u05dc\u05d3\u05d9\u05dd?",
      "back": "\u05de\u05e9\u05da \u05d6\u05de\u05df \u05e9\u05dc \u05e9\u05e0\u05d4 \u05d0\u05d7\u05ea \u05dc\u05e4\u05d7\u05d5\u05ea, \u05d1\u05e0\u05d9\u05d2\u05d5\u05d3 \u05dc\u05e9\u05e0\u05ea\u05d9\u05d9\u05dd \u05d4\u05e0\u05d3\u05e8\u05e9\u05d5\u05ea \u05d1\u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd (DSM p.193)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d8\u05d5\u05d5\u05d7 \u05d4\u05d2\u05d9\u05dc\u05d9\u05dd \u05e9\u05d1\u05d5 \u05e0\u05d9\u05ea\u05df \u05dc\u05ea\u05ea \u05dc\u05e8\u05d0\u05e9\u05d5\u05e0\u05d4 \u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc Disruptive Mood Dysregulation Disorder?",
      "back": "\u05d0\u05d9\u05df \u05dc\u05ea\u05ea \u05d0\u05ea \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05dc\u05e8\u05d0\u05e9\u05d5\u05e0\u05d4 \u05dc\u05e4\u05e0\u05d9 \u05d2\u05d9\u05dc 6 \u05d0\u05d5 \u05dc\u05d0\u05d7\u05e8 \u05d2\u05d9\u05dc 18 (DSM p.178)."
    },
    {
      "front": "\u05dc\u05e4\u05d9 \u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05e9\u05dc DMDD, \u05dc\u05e4\u05e0\u05d9 \u05d0\u05d9\u05d6\u05d4 \u05d2\u05d9\u05dc \u05d7\u05d9\u05d9\u05d1 \u05dc\u05d4\u05d9\u05d5\u05ea \u05d4-Onset \u05e9\u05dc \u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd?",
      "back": "\u05d2\u05d9\u05dc \u05d4\u05d4\u05d5\u05e4\u05e2\u05d4 \u05e9\u05dc \u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05d7\u05d9\u05d9\u05d1 \u05dc\u05d4\u05d9\u05d5\u05ea \u05dc\u05e4\u05e0\u05d9 \u05d2\u05d9\u05dc 10 (DSM p.178)."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05de\u05d5\u05d2\u05d3\u05e8\u05ea \u05ea\u05d3\u05d9\u05e8\u05d5\u05ea \u05d4-Temper outbursts \u05d4\u05e0\u05d3\u05e8\u05e9\u05ea \u05dc\u05d0\u05d1\u05d7\u05e0\u05ea DMDD?",
      "back": "\u05d4\u05ea\u05e4\u05e8\u05e6\u05d5\u05d9\u05d5\u05ea \u05d4\u05d6\u05e2\u05dd \u05d7\u05d9\u05d9\u05d1\u05d5\u05ea \u05dc\u05d4\u05ea\u05e8\u05d7\u05e9 \u05d1\u05de\u05de\u05d5\u05e6\u05e2 3 \u05e4\u05e2\u05de\u05d9\u05dd \u05d0\u05d5 \u05d9\u05d5\u05ea\u05e8 \u05d1\u05e9\u05d1\u05d5\u05e2 (DSM p.178)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05d4\u05de\u05d1\u05d3\u05d9\u05dc \u05d4\u05e2\u05d9\u05e7\u05e8\u05d9 \u05d1\u05d9\u05df DMDD \u05dc\u05d1\u05d9\u05df Bipolar Disorder \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd?",
      "back": "\u05d1-DMDD \u05d4\u05de\u05e6\u05d1 \u05d4\u05d5\u05d0 \u05db\u05e8\u05d5\u05e0\u05d9 \u05d5\u05dc\u05d0 \u05d0\u05e4\u05d9\u05d6\u05d5\u05d3\u05d9, \u05dc\u05dc\u05d0 \u05ea\u05e7\u05d5\u05e4\u05d5\u05ea \u05de\u05d5\u05d2\u05d3\u05e8\u05d5\u05ea \u05e9\u05dc Mania \u05d0\u05d5 Hypomania (Dulcan p.181)."
    },
    {
      "front": "\u05d0\u05d9\u05dc\u05d5 \u05ea\u05e1\u05de\u05d9\u05e0\u05d9 Mania \u05d9\u05d9\u05d7\u05d5\u05d3\u05d9\u05d9\u05dd \u05e2\u05e9\u05d5\u05d9\u05d9\u05dd \u05dc\u05d4\u05d5\u05e4\u05d9\u05e2 \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d1\u05e0\u05d9\u05d2\u05d5\u05d3 \u05dc\u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd?",
      "back": "\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e9\u05dc \"Goofiness\" \u05d0\u05d5 \u05e2\u05dc\u05d9\u05d6\u05d5\u05ea \u05de\u05d5\u05d2\u05d6\u05de\u05ea \u05e9\u05d0\u05d9\u05e0\u05d4 \u05ea\u05d5\u05d0\u05de\u05ea \u05d0\u05ea \u05d4\u05d4\u05e7\u05e9\u05e8 \u05d4\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9 (DSM p.144)."
    },
    {
      "front": "\u05dc\u05e4\u05d9 \u05e0\u05ea\u05d5\u05e0\u05d9 \u05d4-CDC, \u05d0\u05d9\u05d6\u05d4 \u05d0\u05d7\u05d5\u05d6 \u05de\u05ea\u05dc\u05de\u05d9\u05d3\u05d9 \u05d4\u05ea\u05d9\u05db\u05d5\u05df \u05d3\u05d9\u05d5\u05d5\u05d7\u05d5 \u05e2\u05dc \u05de\u05d7\u05e9\u05d1\u05d5\u05ea \u05d0\u05d5\u05d1\u05d3\u05e0\u05d9\u05d5\u05ea \u05e8\u05e6\u05d9\u05e0\u05d9\u05d5\u05ea \u05d1\u05e9\u05e0\u05d4 \u05d4\u05d0\u05d7\u05e8\u05d5\u05e0\u05d4?",
      "back": "\u05d1\u05d9\u05df $15\\%$ \u05dc-$20\\%$ \u05de\u05ea\u05dc\u05de\u05d9\u05d3\u05d9 \u05d4\u05ea\u05d9\u05db\u05d5\u05df \u05d3\u05d9\u05d5\u05d5\u05d7\u05d5 \u05e2\u05dc \u05de\u05d7\u05e9\u05d1\u05d5\u05ea \u05db\u05d0\u05dc\u05d5 (StahlKids p.1)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d0\u05d7\u05d5\u05d6 \u05d4\u05e0\u05d9\u05e1\u05d9\u05d5\u05e0\u05d5\u05ea \u05d4\u05d0\u05d5\u05d1\u05d3\u05e0\u05d9\u05d9\u05dd \u05d4\u05de\u05d3\u05d5\u05d5\u05d7 \u05d1\u05e7\u05e8\u05d1 \u05ea\u05dc\u05de\u05d9\u05d3\u05d9 \u05ea\u05d9\u05db\u05d5\u05df \u05d1\u05e9\u05e0\u05d4 \u05d4\u05d0\u05d7\u05e8\u05d5\u05e0\u05d4?",
      "back": "\u05d1\u05d9\u05df $8\\%$ \u05dc-$10\\%$ \u05de\u05ea\u05dc\u05de\u05d9\u05d3\u05d9 \u05d4\u05ea\u05d9\u05db\u05d5\u05df \u05d1\u05d9\u05e6\u05e2\u05d5 \u05e0\u05d9\u05e1\u05d9\u05d5\u05df \u05d0\u05d5\u05d1\u05d3\u05e0\u05d9 (StahlKids p.1)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05ea\u05e8\u05d5\u05e4\u05ea\u05d9 \u05e7\u05d5 \u05e8\u05d0\u05e9\u05d5\u05df \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd MDD \u05d0\u05d5 Anxiety Disorders?",
      "back": "\u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05de\u05de\u05e9\u05e4\u05d7\u05ea \u05d4-SSRI \u05e0\u05d7\u05e9\u05d1\u05d5\u05ea \u05dc\u05e7\u05d5 \u05e8\u05d0\u05e9\u05d5\u05df \u05d1\u05e9\u05dc \u05e1\u05d1\u05d9\u05dc\u05d5\u05ea\u05df \u05d5\u05d9\u05e2\u05d9\u05dc\u05d5\u05ea\u05df \u05d4\u05de\u05d5\u05db\u05d7\u05ea (Dulcan p.756)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 \u05e0\u05d5\u05d2\u05d3\u05ea \u05d4\u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05d4\u05d9\u05d7\u05d9\u05d3\u05d4 \u05d4\u05de\u05d0\u05d5\u05e9\u05e8\u05ea \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d4-FDA \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-MDD \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd?",
      "back": "\u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 Fluoxetine \u05d4\u05d9\u05d0 \u05d4\u05d9\u05d7\u05d9\u05d3\u05d4 \u05d4\u05de\u05d0\u05d5\u05e9\u05e8\u05ea \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05d2\u05dd \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d5\u05d2\u05dd \u05d1\u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd (Dulcan p.756)."
    },
    {
      "front": "\u05d0\u05d9\u05d6\u05d5 \u05ea\u05e8\u05d5\u05e4\u05d4 \u05de\u05d0\u05d5\u05e9\u05e8\u05ea \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d4-FDA \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-MDD \u05d1\u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd \u05d1\u05dc\u05d1\u05d3?",
      "back": "\u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 Escitalopram \u05de\u05d0\u05d5\u05e9\u05e8\u05ea \u05dc\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd \u05d4\u05e1\u05d5\u05d1\u05dc\u05d9\u05dd \u05de-MDD (Dulcan p.756)."
    },
    {
      "front": "\u05d0\u05d9\u05dc\u05d5 \u05e9\u05dc\u05d5\u05e9 \u05ea\u05e8\u05d5\u05e4\u05d5\u05ea SSRI \u05de\u05d0\u05d5\u05e9\u05e8\u05d5\u05ea \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d4-FDA \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Pediatric OCD?",
      "back": "\u05d4\u05ea\u05e8\u05d5\u05e4\u05d5\u05ea Fluoxetine, Sertraline, \u05d5-Fluvoxamine \u05de\u05d0\u05d5\u05e9\u05e8\u05d5\u05ea \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-OCD \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd (Dulcan p.756)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05de\u05d1\u05d3\u05dc\u05ea \u05e9\u05d9\u05e9 \u05dc\u05e9\u05e7\u05d5\u05dc \u05e2\u05d1\u05d5\u05e8 \u05d9\u05dc\u05d3 \u05e2\u05dd Outbursts \u05d5-Irritability \u05db\u05e8\u05d5\u05e0\u05d9\u05ea \u05d1\u05d9\u05df \u05d4\u05d4\u05ea\u05e4\u05e8\u05e6\u05d5\u05d9\u05d5\u05ea?",
      "back": "\u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05de\u05ea\u05d0\u05d9\u05de\u05d4 \u05d4\u05d9\u05d0 DMDD \u05d5\u05dc\u05d0 Intermittent Explosive Disorder (DSM p.181)."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05e0\u05d9\u05ea\u05df \u05dc\u05d4\u05d1\u05d3\u05d9\u05dc \u05d1\u05d9\u05df \u05e7\u05e9\u05d9\u05d9 \u05e8\u05d9\u05db\u05d5\u05d6 \u05e9\u05dc ADHD \u05dc\u05d0\u05dc\u05d5 \u05e9\u05dc Generalized Anxiety Disorder?",
      "back": "\u05d1-GAD \u05d4\u05e7\u05d5\u05e9\u05d9 \u05d1\u05e8\u05d9\u05db\u05d5\u05d6 \u05e0\u05d5\u05d1\u05e2 \u05de\u05e2\u05d9\u05e1\u05d5\u05e7 \u05d9\u05ea\u05e8 \u05d1\u05d3\u05d0\u05d2\u05d5\u05ea (Anxious preoccupation) \u05d5\u05dc\u05d0 \u05de\u05dc\u05d9\u05e7\u05d5\u05d9 \u05e7\u05e9\u05d1 \u05e8\u05d0\u05e9\u05d5\u05e0\u05d9 (Dulcan p.324)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d2\u05d9\u05dc \u05d4-Onset \u05d4\u05de\u05de\u05d5\u05e6\u05e2 \u05e2\u05d1\u05d5\u05e8 Anxiety Disorders \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd?",
      "back": "\u05d2\u05d9\u05dc \u05d4\u05d4\u05d5\u05e4\u05e2\u05d4 \u05d4\u05d7\u05e6\u05d9\u05d5\u05e0\u05d9 \u05e9\u05dc \u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05d7\u05e8\u05d3\u05d4 \u05d1\u05d9\u05dc\u05d3\u05d5\u05ea \u05d4\u05d5\u05d0 \u05d2\u05d9\u05dc 6 (Dulcan p.322)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05e9\u05d9\u05e0\u05d5\u05d9 \u05d4\u05d0\u05e4\u05d9\u05d3\u05de\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d1\u05e9\u05db\u05d9\u05d7\u05d5\u05ea Anxiety Disorders \u05d4\u05de\u05ea\u05e8\u05d7\u05e9 \u05d1\u05ea\u05e7\u05d5\u05e4\u05ea \u05d2\u05d9\u05dc \u05d4\u05d4\u05ea\u05d1\u05d2\u05e8\u05d5\u05ea?",
      "back": "\u05de\u05ea\u05e8\u05d7\u05e9\u05ea \u05e2\u05dc\u05d9\u05d9\u05d4 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05d1\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d1\u05e7\u05e8\u05d1 \u05d1\u05e0\u05d5\u05ea \u05d1\u05d4\u05e9\u05d5\u05d5\u05d0\u05d4 \u05dc\u05d1\u05e0\u05d9\u05dd \u05e1\u05d1\u05d9\u05d1 \u05d2\u05d9\u05dc \u05d4\u05d4\u05ea\u05d1\u05d2\u05e8\u05d5\u05ea (Dulcan p.323)."
    },
    {
      "front": "\u05de\u05d4\u05dd \u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05dc\u05d0\u05d1\u05d7\u05e0\u05ea PANDAS?",
      "back": "\u05d4\u05d5\u05e4\u05e2\u05ea OCD \u05d0\u05d5 Tics \u05d1\u05d2\u05d9\u05dc \u05d4\u05d9\u05dc\u05d3\u05d5\u05ea \u05d4\u05de\u05dc\u05d5\u05d5\u05d4 \u05d1\u05d6\u05d9\u05d4\u05d5\u05dd \u05e1\u05d8\u05e8\u05e4\u05d8\u05d5\u05e7\u05d5\u05e7\u05dc\u05d9 \u05de\u05d5\u05db\u05d7 \u05d5\u05de\u05d4\u05dc\u05da \u05d0\u05e4\u05d9\u05d6\u05d5\u05d3\u05d9 (Dulcan p.371)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05d4\u05d9\u05d9\u05d7\u05d5\u05d3\u05d9 \u05e9\u05dc PANS (Pediatric Acute-onset Neuropsychiatric Syndrome)?",
      "back": "\u05d4\u05d5\u05e4\u05e2\u05d4 \u05e4\u05ea\u05d0\u05d5\u05de\u05d9\u05ea \u05d5\u05d3\u05e8\u05de\u05d8\u05d9\u05ea \u05e9\u05dc OCD \u05d0\u05d5 \u05d4\u05d2\u05d1\u05dc\u05ea \u05d0\u05db\u05d9\u05dc\u05d4 \u05d7\u05de\u05d5\u05e8\u05d4 \u05dc\u05dc\u05d0 \u05d4\u05e1\u05d1\u05e8 \u05e8\u05e4\u05d5\u05d0\u05d9 \u05d0\u05d7\u05e8 (Dulcan p.371)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05d4\u05d1\u05d3\u05dc \u05d4\u05e2\u05d9\u05e7\u05e8\u05d9 \u05d1\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d4\u05e9\u05dc\u05d9\u05dc\u05d9\u05d9\u05dd \u05d1\u05d9\u05df Early Onset Schizophrenia \u05dc\u05d1\u05d9\u05df Adult Onset Schizophrenia?",
      "back": "\u05d7\u05d5\u05dc\u05d9\u05dd \u05e2\u05dd EOS \u05e0\u05d5\u05d8\u05d9\u05dd \u05dc\u05d4\u05e4\u05d2\u05d9\u05df \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e9\u05dc\u05d9\u05dc\u05d9\u05d9\u05dd \u05d7\u05de\u05d5\u05e8\u05d9\u05dd \u05d9\u05d5\u05ea\u05e8 \u05de\u05d0\u05dc\u05d5 \u05e2\u05dd AOS (Dulcan p.390)."
    },
    {
      "front": "\u05de\u05d3\u05d5\u05e2 \u05e7\u05e9\u05d4 \u05dc\u05d0\u05d1\u05d7\u05df Psychotic disorders \u05d1\u05d2\u05d9\u05dc \u05d4\u05d2\u05df (Preschool)?",
      "back": "\u05d1\u05e9\u05dc \u05de\u05d5\u05d2\u05d1\u05dc\u05d5\u05ea \u05e9\u05e4\u05ea\u05d9\u05ea \u05d5\u05d4\u05e7\u05d5\u05e9\u05d9 \u05d4\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9 \u05dc\u05d4\u05d1\u05d7\u05d9\u05df \u05d1\u05d9\u05df \u05e4\u05e0\u05d8\u05d6\u05d9\u05d4 \u05e0\u05d5\u05e8\u05de\u05d8\u05d9\u05d1\u05d9\u05ea \u05dc\u05de\u05e6\u05d9\u05d0\u05d5\u05ea (Dulcan p.52)."
    },
    {
      "front": "\u05d0\u05d9\u05d6\u05d5 \u05ea\u05e8\u05d5\u05e4\u05d4 \u05d4\u05e8\u05d0\u05ea\u05d4 \u05d9\u05e2\u05d9\u05dc\u05d5\u05ea \u05d1\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Self-injurious skin picking \u05d1\u05e7\u05e8\u05d1 \u05d7\u05d5\u05dc\u05d9 Prader-Willi Syndrome?",
      "back": "\u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 Topiramate \u05d4\u05d5\u05db\u05d7\u05d4 \u05db\u05d9\u05e2\u05d9\u05dc\u05d4 \u05dc\u05d4\u05e4\u05d7\u05ea\u05ea \u05ea\u05d5\u05e4\u05e2\u05d4 \u05d6\u05d5 \u05d1\u05de\u05d7\u05e7\u05e8\u05d9\u05dd \u05de\u05e1\u05d5\u05d9\u05de\u05d9\u05dd (Dulcan p.159)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05de\u05d5\u05e2\u05d3\u05e3 \u05e2\u05d1\u05d5\u05e8 Impulsive aggression \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd?",
      "back": "\u05d8\u05d9\u05e4\u05d5\u05dc \u05ea\u05e8\u05d5\u05e4\u05ea\u05d9 \u05e0\u05d7\u05e9\u05d1 \u05dc\u05d9\u05e2\u05d9\u05dc \u05d1\u05e2\u05d9\u05e7\u05e8 \u05e2\u05d1\u05d5\u05e8 \u05d0\u05d2\u05e8\u05e1\u05d9\u05d1\u05d9\u05d5\u05ea \u05d0\u05d9\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05ea \u05d5\u05dc\u05d0 \u05e2\u05d1\u05d5\u05e8 \u05d0\u05d2\u05e8\u05e1\u05d9\u05d1\u05d9\u05d5\u05ea \u05de\u05ea\u05d5\u05db\u05e0\u05e0\u05ea (Dulcan p.594)."
    },
    {
      "front": "\u05de\u05d3\u05d5\u05e2 \u05d9\u05e9 \u05dc\u05d4\u05d9\u05d6\u05d4\u05e8 \u05d1\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1-Antipsychotics \u05d0\u05d5 Lithium \u05d1\u05d7\u05d5\u05dc\u05d9\u05dd \u05e2\u05dd \u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4 \u05e9\u05dc Seizures?",
      "back": "\u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05d0\u05dc\u05d5 \u05e2\u05dc\u05d5\u05dc\u05d5\u05ea \u05dc\u05d4\u05d5\u05e8\u05d9\u05d3 \u05d0\u05ea \u05e1\u05e3 \u05d4\u05e4\u05e8\u05db\u05d5\u05e1 (Lower the seizure threshold) (Dulcan p.684)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d9\u05d7\u05e1 \u05d4\u05de\u05d9\u05e0\u05d9\u05dd (Male:Female) \u05d1-Major Depressive Disorder \u05d1\u05d9\u05dc\u05d3\u05d5\u05ea \u05dc\u05e2\u05d5\u05de\u05ea \u05d2\u05d9\u05dc \u05d4\u05d4\u05ea\u05d1\u05d2\u05e8\u05d5\u05ea?",
      "back": "\u05d4\u05d9\u05d7\u05e1 \u05d4\u05d5\u05d0 $1:1$ \u05d1\u05d9\u05dc\u05d3\u05d5\u05ea, \u05d0\u05da \u05de\u05e9\u05ea\u05e0\u05d4 \u05dc-$1:2$ \u05dc\u05d8\u05d5\u05d1\u05ea \u05d1\u05e0\u05d5\u05ea \u05d1\u05ea\u05e7\u05d5\u05e4\u05ea \u05d4\u05d4\u05ea\u05d1\u05d2\u05e8\u05d5\u05ea (Dulcan p.247)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05de\u05e9\u05da \u05d4\u05d6\u05de\u05df \u05d4\u05de\u05d9\u05e0\u05d9\u05de\u05dc\u05d9 \u05d4\u05e0\u05d3\u05e8\u05e9 \u05dc\u05d0\u05d1\u05d7\u05e0\u05ea \u05d0\u05e4\u05d9\u05d6\u05d5\u05d3\u05d4 \u05e9\u05dc Mania \u05d0\u05d5 Hypomania \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd?",
      "back": "\u05d4\u05d0\u05e4\u05d9\u05d6\u05d5\u05d3\u05d4 \u05d7\u05d9\u05d9\u05d1\u05ea \u05dc\u05d4\u05d9\u05de\u05e9\u05da \u05dc\u05e4\u05d7\u05d5\u05ea 4 \u05d9\u05de\u05d9\u05dd \u05e8\u05e6\u05d5\u05e4\u05d9\u05dd \u05db\u05d3\u05d9 \u05dc\u05d4\u05d9\u05d7\u05e9\u05d1 \u05db\u05e1\u05de\u05de\u05df \u05e7\u05dc\u05d9\u05e0\u05d9 \u05dc-Bipolar disorder (DSM p.71)."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05de\u05e9\u05e4\u05d9\u05e2 \u05e9\u05d9\u05de\u05d5\u05e9 \u05d1-Stimulants \u05e2\u05dc \u05d9\u05dc\u05d3\u05d9\u05dd \u05d4\u05e1\u05d5\u05d1\u05dc\u05d9\u05dd \u05de-DMDD \u05d5-ADHD \u05e7\u05d5\u05de\u05d5\u05e8\u05d1\u05d9\u05d3\u05d9?",
      "back": "\u05e1\u05d8\u05d9\u05de\u05d5\u05dc\u05e0\u05d8\u05d9\u05dd \u05e2\u05e9\u05d5\u05d9\u05d9\u05dd \u05dc\u05e2\u05d6\u05d5\u05e8 \u05dc\u05ea\u05e1\u05de\u05d9\u05e0\u05d9 \u05d4-ADHD \u05d0\u05da \u05dc\u05e2\u05d9\u05ea\u05d9\u05dd \u05d0\u05d9\u05e0\u05dd \u05e0\u05e1\u05d1\u05dc\u05d9\u05dd \u05d1\u05e7\u05e8\u05d1 \u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd DMDD (StahlKids p.1)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05de\u05ea\u05d0\u05d9\u05de\u05d4 \u05dc\u05d9\u05dc\u05d3 \u05d4\u05de\u05e6\u05d9\u05d2 \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d0\u05d5\u05e4\u05d5\u05d6\u05d9\u05e6\u05d9\u05d5\u05e0\u05d9\u05ea \u05e8\u05e7 \u05db\u05ea\u05d2\u05d5\u05d1\u05d4 \u05dc\u05e1\u05d8\u05e8\u05e1\u05d5\u05e8 \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9?",
      "back": "\u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05d9\u05d0 Adjustment disorder with disturbance of conduct (Dulcan p.527)."
    }
  ]
