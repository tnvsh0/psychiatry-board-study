{
  "title": "Sleep Quiz",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\u05d9\u05dc\u05d3 \u05d1\u05df 7 \u05de\u05d5\u05e4\u05e0\u05d4 \u05dc\u05d4\u05e2\u05e8\u05db\u05d4 \u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9\u05ea \u05d1\u05e9\u05dc \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d1\u05d5\u05dc\u05d8\u05d9\u05dd \u05e9\u05dc \u05d4\u05d9\u05e4\u05e8\u05d0\u05e7\u05d8\u05d9\u05d1\u05d9\u05d5\u05ea, \u05d0\u05d9\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05d5\u05ea \u05d5\u05e7\u05e9\u05d9\u05d9 \u05e8\u05d9\u05db\u05d5\u05d6 \u05d1\u05db\u05d9\u05ea\u05d4. \u05d1\u05e8\u05d0\u05d9\u05d5\u05df \u05e2\u05dd \u05d4\u05d4\u05d5\u05e8\u05d9\u05dd \u05e2\u05d5\u05dc\u05d4 \u05db\u05d9 \u05d4\u05d9\u05dc\u05d3 \u05e0\u05d5\u05d7\u05e8 \u05d1\u05d0\u05d5\u05e4\u05df \u05e7\u05d1\u05d5\u05e2 \u05d5\u05e1\u05d5\u05d1\u05dc \u05de\u05d4\u05e8\u05d8\u05d1\u05ea \u05dc\u05d9\u05dc\u05d4 \u05de\u05e9\u05e0\u05d9\u05ea. \u05d1\u05d1\u05d3\u05d9\u05e7\u05ea Polysomnography (PSG) \u05e0\u05de\u05e6\u05d0 \u05de\u05d3\u05d3 $AHI$ (Apnea-Hypopnea Index) \u05e9\u05dc 2 \u05d0\u05d9\u05e8\u05d5\u05e2\u05d9\u05dd \u05d1\u05e9\u05e2\u05d4. \u05de\u05d4\u05d9 \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05e1\u05d1\u05d9\u05e8\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d5\u05de\u05d4\u05d5 \u05d4\u05e6\u05e2\u05d3 \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc\u05d9 \u05d4\u05de\u05d5\u05de\u05dc\u05e5 \u05db\u05e7\u05d5 \u05e8\u05d0\u05e9\u05d5\u05df?",
      "answerOptions": [
        {
          "text": "\u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc Pediatric OSA; \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05de\u05d5\u05de\u05dc\u05e5 \u05d4\u05d5\u05d0 Adenotonsillectomy.",
          "isCorrect": true,
          "rationale": "\u05d1\u05e0\u05d9\u05d2\u05d5\u05d3 \u05dc\u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd, \u05e1\u05e3 \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05dc-OSA \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d4\u05d5\u05d0 $AHI \\ge 1$, \u05d5\u05d4\u05d2\u05d5\u05e8\u05dd \u05d4\u05d0\u05e0\u05d8\u05d5\u05de\u05d9 \u05d4\u05e9\u05db\u05d9\u05d7 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d4\u05d5\u05d0 \u05d4\u05d9\u05e4\u05e8\u05d8\u05e8\u05d5\u05e4\u05d9\u05d4 \u05e9\u05dc \u05d4\u05e9\u05e7\u05d3\u05d9\u05dd \u05d5\u05d4\u05d0\u05d3\u05e0\u05d5\u05d0\u05d9\u05d3\u05d9\u05dd (Dulcan p.487, DSM p.431)."
        },
        {
          "text": "\u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc ADHD; \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05de\u05d5\u05de\u05dc\u05e5 \u05d4\u05d5\u05d0 Methylphenidate.",
          "isCorrect": false,
          "rationale": "\u05de\u05d3\u05d3 $AHI$ \u05e9\u05dc 2 \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05e0\u05d7\u05e9\u05d1 \u05e4\u05ea\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d5\u05de\u05e6\u05d1\u05d9\u05e2 \u05e2\u05dc OSA, \u05d0\u05e9\u05e8 \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05d4 \u05de\u05d7\u05e7\u05d9\u05dd \u05d1\u05d0\u05d5\u05e4\u05df \u05de\u05d3\u05d5\u05d9\u05e7 \u05d4\u05e4\u05e8\u05e2\u05ea \u05e7\u05e9\u05d1 \u05d5\u05e8\u05d9\u05db\u05d5\u05d6 (Dulcan p.491)."
        },
        {
          "text": "\u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc Primary Snoring; \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05de\u05d5\u05de\u05dc\u05e5 \u05d4\u05d5\u05d0 \u05de\u05e2\u05e7\u05d1 \u05e7\u05dc\u05d9\u05e0\u05d9 \u05d1\u05dc\u05d1\u05d3.",
          "isCorrect": false,
          "rationale": "Primary Snoring \u05de\u05d5\u05d2\u05d3\u05e8 \u05db\u05e0\u05d7\u05d9\u05e8\u05d5\u05ea \u05dc\u05dc\u05d0 \u05e2\u05d3\u05d5\u05ea \u05dc\u05d0\u05d9\u05e8\u05d5\u05e2\u05d9\u05dd \u05e0\u05e9\u05d9\u05de\u05ea\u05d9\u05d9\u05dd \u05d1-PSG, \u05d0\u05da \u05db\u05d0\u05df \u05d4\u05de\u05d3\u05d3 \u05d2\u05d1\u05d5\u05d4 \u05de\u05d4\u05e0\u05d5\u05e8\u05de\u05d4 \u05d4\u05e4\u05d3\u05d9\u05d0\u05d8\u05e8\u05d9\u05ea (DSM p.432)."
        },
        {
          "text": "\u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc Pediatric OSA; \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05de\u05d5\u05de\u05dc\u05e5 \u05d4\u05d5\u05d0 \u05d4\u05ea\u05d7\u05dc\u05ea CPAP \u05d1\u05d0\u05d5\u05e4\u05df \u05de\u05d9\u05d9\u05d3\u05d9.",
          "isCorrect": false,
          "rationale": "CPAP \u05e0\u05d7\u05e9\u05d1 \u05dc\u05e7\u05d5 \u05e9\u05e0\u05d9 \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d4\u05de\u05d9\u05d5\u05e2\u05d3 \u05dc\u05de\u05e7\u05e8\u05d9\u05dd \u05d1\u05d4\u05dd \u05e0\u05d9\u05ea\u05d5\u05d7 \u05db\u05e9\u05dc \u05d0\u05d5 \u05db\u05e9\u05d9\u05e9\u05e0\u05d4 \u05d4\u05e9\u05de\u05e0\u05d4 \u05e7\u05d9\u05e6\u05d5\u05e0\u05d9\u05ea, \u05d1\u05e2\u05d5\u05d3 \u05e0\u05d9\u05ea\u05d5\u05d7 \u05d4\u05d5\u05d0 \u05d4\u05e7\u05d5 \u05d4\u05e8\u05d0\u05e9\u05d5\u05df (Dulcan p.487)."
        }
