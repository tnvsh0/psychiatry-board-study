    {
      "type": "multiple_choice",
      "question": "\u05e0\u05e2\u05e8 \u05d1\u05df 16 \u05de\u05ea\u05dc\u05d5\u05e0\u05df \u05e2\u05dc \u05e7\u05d5\u05e9\u05d9 \u05dc\u05d4\u05d9\u05e8\u05d3\u05dd \u05dc\u05e4\u05e0\u05d9 \u05d4\u05e9\u05e2\u05d4 02:00 \u05d1\u05dc\u05d9\u05dc\u05d4 \u05d5\u05e7\u05d5\u05e9\u05d9 \u05e7\u05d9\u05e6\u05d5\u05e0\u05d9 \u05dc\u05d4\u05ea\u05e2\u05d5\u05e8\u05e8 \u05dc\u05d1\u05d9\u05ea \u05d4\u05e1\u05e4\u05e8 \u05d1\u05e9\u05e2\u05d4 07:00. \u05d4\u05d5\u05d0 \u05de\u05d3\u05d5\u05d5\u05d7 \u05db\u05d9 \u05d1\u05e1\u05d5\u05e4\u05d9 \u05e9\u05d1\u05d5\u05e2 \u05d5\u05d1\u05d7\u05d5\u05e4\u05e9\u05d5\u05ea \u05d4\u05d5\u05d0 \u05d9\u05e9\u05df \u05de\u05e6\u05d5\u05d9\u05df \u05d1\u05d9\u05df \u05d4\u05e9\u05e2\u05d5\u05ea 03:00 \u05dc-12:00 \u05d1\u05e6\u05d4\u05e8\u05d9\u05d9\u05dd. \u05de\u05d4\u05d9 \u05d4\u05d4\u05de\u05dc\u05e6\u05d4 \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc\u05d9\u05ea \u05d4\u05d0\u05d5\u05e4\u05d8\u05d9\u05de\u05dc\u05d9\u05ea \u05dc\u05d1\u05d9\u05e6\u05d5\u05e2 \u05d1\u05e9\u05e2\u05d5\u05ea \u05d4\u05d1\u05d5\u05e7\u05e8 \u05de\u05d9\u05d3 \u05e2\u05dd \u05d4\u05d9\u05e7\u05d9\u05e6\u05d4 \u05e2\u05d1\u05d5\u05e8 Delayed Sleep Phase Type (DSPS)?",
      "answerOptions": [
        {
          "text": "\u05d7\u05e9\u05d9\u05e4\u05d4 \u05dc\u05d0\u05d5\u05e8 \u05d1\u05d4\u05d9\u05e8 (Bright Light Therapy) \u05d1\u05e2\u05d5\u05e6\u05de\u05d4 \u05e9\u05dc 5,000\u201310,000 Lux.",
          "isCorrect": true,
          "rationale": "\u05d7\u05e9\u05d9\u05e4\u05d4 \u05dc\u05d0\u05d5\u05e8 \u05d1\u05d1\u05d5\u05e7\u05e8 \u05d2\u05d5\u05e8\u05de\u05ea \u05dc-Phase Advance \u05e9\u05dc \u05d4\u05e9\u05e2\u05d5\u05df \u05d4\u05e6\u05d9\u05e8\u05e7\u05d3\u05d9\u05d0\u05e0\u05d9, \u05de\u05d4 \u05e9\u05e2\u05d5\u05d6\u05e8 \u05dc\u05d4\u05e7\u05d3\u05d9\u05dd \u05d0\u05ea \u05e9\u05e2\u05ea \u05d4\u05d4\u05d9\u05e8\u05d3\u05de\u05d5\u05ea (Dulcan p.490, StahlNeuro p.438)."
        },
        {
          "text": "\u05de\u05ea\u05df \u05de\u05d9\u05e0\u05d5\u05df \u05d2\u05d1\u05d5\u05d4 \u05e9\u05dc Melatonin (\u05db-10 \u05de\"\u05d2).",
          "isCorrect": false,
          "rationale": "\u05de\u05dc\u05d8\u05d5\u05e0\u05d9\u05df \u05d1\u05d1\u05d5\u05e7\u05e8 \u05d9\u05d7\u05de\u05d9\u05e8 \u05d0\u05ea \u05d4\u05d9\u05e9\u05e0\u05d5\u05e0\u05d9\u05d5\u05ea \u05d5\u05d9\u05e2\u05db\u05d1 \u05d0\u05ea \u05d4\u05e1\u05e0\u05db\u05e8\u05d5\u05df; \u05de\u05dc\u05d8\u05d5\u05e0\u05d9\u05df \u05dc-DSPS \u05e0\u05d9\u05ea\u05df \u05d1\u05e9\u05e2\u05d5\u05ea \u05d4\u05e2\u05e8\u05d1, \u05db-1-2 \u05e9\u05e2\u05d5\u05ea \u05dc\u05e4\u05e0\u05d9 \u05e9\u05e2\u05ea \u05d4\u05e9\u05d9\u05e0\u05d4 \u05d4\u05de\u05d9\u05d5\u05e2\u05d3\u05ea (Dulcan p.490)."
        },
        {
          "text": "\u05d4\u05ea\u05d7\u05dc\u05ea \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-Modafinil \u05dc\u05e9\u05d9\u05e4\u05d5\u05e8 \u05d4\u05e2\u05e8\u05e0\u05d5\u05ea \u05d1\u05d1\u05d5\u05e7\u05e8.",
          "isCorrect": false,
          "rationale": "\u05d6\u05d4\u05d5 \u05d8\u05d9\u05e4\u05d5\u05dc \u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d8\u05d9 \u05d1\u05d9\u05e9\u05e0\u05d5\u05e0\u05d9\u05d5\u05ea \u05d5\u05d0\u05d9\u05e0\u05d5 \u05de\u05d8\u05e4\u05dc \u05d1\u05d1\u05e2\u05d9\u05d9\u05ea \u05d4\u05e1\u05e0\u05db\u05e8\u05d5\u05df \u05d4\u05e6\u05d9\u05e8\u05e7\u05d3\u05d9\u05d0\u05e0\u05d9 \u05d4\u05d1\u05e1\u05d9\u05e1\u05d9\u05ea (Dulcan p.484)."
        },
        {
          "text": "\u05d1\u05d9\u05e6\u05d5\u05e2 Chronotherapy \u05e9\u05dc \u05d3\u05d7\u05d9\u05d9\u05ea \u05e9\u05e2\u05ea \u05d4\u05e9\u05d9\u05e0\u05d4 \u05d1-3 \u05e9\u05e2\u05d5\u05ea \u05db\u05dc \u05dc\u05d9\u05dc\u05d4.",
          "isCorrect": false,
          "rationale": "\u05d6\u05d5\u05d4\u05d9 \u05d8\u05db\u05e0\u05d9\u05e7\u05d4 \u05e7\u05e9\u05d4 \u05de\u05d0\u05d5\u05d3 \u05dc\u05d9\u05d9\u05e9\u05d5\u05dd \u05e9\u05d0\u05d9\u05e0\u05d4 \u05de\u05d4\u05d5\u05d5\u05d4 \u05e7\u05d5 \u05e8\u05d0\u05e9\u05d5\u05df \u05e1\u05d8\u05e0\u05d3\u05e8\u05d8\u05d9 \u05d1\u05d4\u05e9\u05d5\u05d5\u05d0\u05d4 \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05d0\u05d5\u05e8 (Dulcan p.490)."
        }
      ],
      "hint": "\u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05de\u05d9\u05d5\u05e2\u05d3 \u05dc\u05d1\u05d9\u05e6\u05d5\u05e2 \u05d1\u05d1\u05d5\u05e7\u05e8 \u05db\u05d3\u05d9 \u05dc\u05e1\u05e0\u05db\u05e8\u05df \u05d0\u05ea \u05d4\u05e9\u05e2\u05d5\u05df \u05d4\u05e6\u05d9\u05e8\u05e7\u05d3\u05d9\u05d0\u05e0\u05d9 \u05de\u05d7\u05d3\u05e9.",
      "imageUrls": []
    },
    {
      "type": "short_answer",
      "question": "\u05de\u05d3\u05d5\u05e2 \u05d9\u05dc\u05d3\u05d9\u05dd \u05d4\u05e1\u05d5\u05d1\u05dc\u05d9\u05dd \u05de-Obstructive Sleep Apnea (OSA) \u05de\u05e6\u05d9\u05d2\u05d9\u05dd \u05dc\u05e2\u05d9\u05ea\u05d9\u05dd \u05e7\u05e8\u05d5\u05d1\u05d5\u05ea \u05d4\u05d9\u05e4\u05e8\u05d0\u05e7\u05d8\u05d9\u05d1\u05d9\u05d5\u05ea \u05d5\u05d7\u05d5\u05e1\u05e8 \u05e7\u05e9\u05d1 \u05d1\u05de\u05e7\u05d5\u05dd \u05d9\u05e9\u05e0\u05d5\u05e0\u05d9\u05d5\u05ea \u05d9\u05ea\u05e8 (EDS), \u05d5\u05de\u05d4\u05d5 \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05e0\u05d5\u05d9\u05e8\u05d5\u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d4\u05de\u05d5\u05e6\u05e2 \u05dc\u05db\u05da?",
      "grading": {
        "modelAnswer": "\u05d1\u05d9\u05dc\u05d3\u05d9\u05dd, \u05d4\u05d9\u05e4\u05d5\u05e7\u05e1\u05de\u05d9\u05d4 \u05dc\u05d9\u05dc\u05d9\u05ea \u05e1\u05d9\u05e8\u05d5\u05d2\u05d9\u05ea \u05d5\u05e7\u05d9\u05d8\u05d5\u05e2 \u05e9\u05d9\u05e0\u05d4 (Sleep fragmentation) \u05d2\u05d5\u05e8\u05de\u05d9\u05dd \u05dc\u05e4\u05d2\u05d9\u05e2\u05d4 \u05ea\u05e4\u05e7\u05d5\u05d3\u05d9\u05ea \u05d1\u05de\u05e2\u05d2\u05dc\u05d9\u05dd \u05d4\u05e7\u05d5\u05e8\u05d8\u05d9\u05e7\u05d5-\u05e1\u05d8\u05e8\u05d9\u05d0\u05d8\u05dc\u05d9\u05d9\u05dd \u05d1-Prefrontal Cortex. \u05e4\u05d2\u05d9\u05e2\u05d4 \u05d6\u05d5 \u05de\u05d5\u05d1\u05d9\u05dc\u05d4 \u05dc\u05e0\u05d9\u05d4\u05d5\u05dc \u05dc\u05e7\u05d5\u05d9 \u05e9\u05dc \u05d3\u05d7\u05e4\u05d9\u05dd \u05d5\u05e7\u05e9\u05d1, \u05d4\u05de\u05ea\u05d1\u05d8\u05d0 \u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05db\u05d4\u05d9\u05e4\u05e8\u05d0\u05e7\u05d8\u05d9\u05d1\u05d9\u05d5\u05ea \u05d5\u05d0\u05d9\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05d5\u05ea \u05d4\u05de\u05d7\u05e7\u05d9\u05dd ADHD (ADHD Mimicry) (Dulcan p.487, p.491, DSM p.432).",
        "rationale": "\u05d4\u05e4\u05d2\u05d9\u05e2\u05d4 \u05d1\u05ea\u05e4\u05e7\u05d5\u05d3\u05d9\u05dd \u05e0\u05d9\u05d4\u05d5\u05dc\u05d9\u05d9\u05dd \u05e7\u05d3\u05de\u05d9\u05d9\u05dd \u05e2\u05e7\u05d1 \u05d7\u05e1\u05e8 \u05d7\u05de\u05e6\u05df \u05dc\u05d9\u05dc\u05d9 \u05de\u05ea\u05d1\u05d8\u05d0\u05ea \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05db\u05e2\u05d5\u05e8\u05e8\u05d5\u05ea \u05d9\u05ea\u05e8 \u05ea\u05d2\u05d5\u05d1\u05ea\u05d9\u05ea \u05d5\u05dc\u05d0 \u05db\u05d9\u05e9\u05e0\u05d5\u05e0\u05d9\u05d5\u05ea \u05e4\u05e1\u05d9\u05d1\u05d9\u05ea.",
        "requiredAttributes": [
          "\u05d0\u05d6\u05db\u05d5\u05e8 \u05d4\u05e4\u05d2\u05d9\u05e2\u05d4 \u05d1-Prefrontal Cortex \u05d0\u05d5 \u05d1\u05de\u05e2\u05d2\u05dc\u05d9\u05dd \u05e7\u05d5\u05e8\u05d8\u05d9\u05e7\u05d5-\u05e1\u05d8\u05e8\u05d9\u05d0\u05d8\u05dc\u05d9\u05d9\u05dd.",
          "\u05d0\u05d6\u05db\u05d5\u05e8 \u05d4\u05d9\u05e4\u05d5\u05e7\u05e1\u05de\u05d9\u05d4 \u05e1\u05d9\u05e8\u05d5\u05d2\u05d9\u05ea \u05d0\u05d5 \u05e7\u05d9\u05d8\u05d5\u05e2 \u05e9\u05d9\u05e0\u05d4 \u05db\u05d2\u05d5\u05e8\u05dd.",
          "\u05d4\u05e1\u05d1\u05e8 \u05e9\u05d4\u05d1\u05d9\u05d8\u05d5\u05d9 \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9 \u05de\u05d7\u05e7\u05d4 \u05ea\u05e1\u05de\u05d9\u05e0\u05d9 ADHD (\u05d4\u05d9\u05e4\u05e8\u05d0\u05e7\u05d8\u05d9\u05d1\u05d9\u05d5\u05ea/\u05d0\u05d9\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05d5\u05ea)."
        ],
        "errors": {
          "misconceptions": [
            "\u05d8\u05e2\u05e0\u05d4 \u05e9\u05d9\u05dc\u05d3\u05d9\u05dd \u05dc\u05d0 \u05d7\u05d5\u05d5\u05d9\u05dd \u05d9\u05e9\u05e0\u05d5\u05e0\u05d9\u05d5\u05ea \u05db\u05dc\u05dc \u05d1\u05d2\u05dc\u05dc \u05e2\u05d5\u05d3\u05e3 \u05de\u05e8\u05e5 \u05d8\u05d1\u05e2\u05d9."
          ],
          "bluffs": [
            "\u05d4\u05e1\u05d1\u05e8\u05d9\u05dd \u05db\u05dc\u05dc\u05d9\u05d9\u05dd \u05e2\u05dc \u05e2\u05d9\u05d9\u05e4\u05d5\u05ea \u05e9\u05d2\u05d5\u05e8\u05de\u05ea \u05dc\u05e2\u05e6\u05d1\u05e0\u05d5\u05ea \u05dc\u05dc\u05d0 \u05e7\u05e9\u05e8 \u05dc\u05de\u05e2\u05d2\u05dc\u05d9\u05dd \u05de\u05d5\u05d7\u05d9\u05d9\u05dd \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05d9\u05dd."
          ]
        }
      },
      "hint": "\u05d4\u05ea\u05de\u05e7\u05d3 \u05d1\u05d4\u05e9\u05e4\u05e2\u05ea \u05d7\u05d5\u05e1\u05e8 \u05d4\u05d7\u05de\u05e6\u05df \u05e2\u05dc \u05d0\u05d6\u05d5\u05e8\u05d9 \u05d4\u05de\u05d5\u05d7 \u05d4\u05d0\u05d7\u05e8\u05d0\u05d9\u05dd \u05e2\u05dc \u05ea\u05e4\u05e7\u05d5\u05d3\u05d9\u05dd \u05e0\u05d9\u05d4\u05d5\u05dc\u05d9\u05d9\u05dd."
    },
    {
      "type": "multiple_choice",
      "question": "\u05de\u05d4\u05d9 \u05d0\u05d6\u05d4\u05e8\u05ea \u05d4\u05d1\u05d8\u05d9\u05d7\u05d5\u05ea \u05d4\u05d7\u05de\u05d5\u05e8\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05e9\u05d9\u05e9 \u05dc\u05ea\u05ea \u05dc\u05d4\u05d5\u05e8\u05d9 \u05d9\u05dc\u05d3 \u05d4\u05de\u05d8\u05d5\u05e4\u05dc \u05d1-Clonidine \u05e2\u05d1\u05d5\u05e8 \u05d0\u05d9\u05e0\u05e1\u05d5\u05de\u05e0\u05d9\u05d4 \u05e0\u05dc\u05d5\u05d5\u05d9\u05ea \u05dc-ADHD, \u05d1\u05de\u05d9\u05d5\u05d7\u05d3 \u05dc\u05d2\u05d1\u05d9 \u05d4\u05e4\u05e1\u05e7\u05ea \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc?",
      "answerOptions": [
        {
          "text": "\u05e1\u05d9\u05db\u05d5\u05df \u05dc-Rebound Hypertension (\u05e2\u05dc\u05d9\u05d9\u05d4 \u05d7\u05d3\u05d4 \u05d5\u05e4\u05ea\u05d0\u05d5\u05de\u05d9\u05ea \u05d1\u05dc\u05d7\u05e5 \u05d4\u05d3\u05dd) \u05d1\u05d4\u05e4\u05e1\u05e7\u05d4 \u05e4\u05ea\u05d0\u05d5\u05de\u05d9\u05ea.",
          "isCorrect": true,
          "rationale": "\u05e7\u05dc\u05d5\u05e0\u05d9\u05d3\u05d9\u05df \u05d4\u05d5\u05d0 \u05d0\u05d2\u05d5\u05e0\u05d9\u05e1\u05d8 $\\alpha_2$ \u05d4\u05de\u05e9\u05e4\u05d9\u05e2 \u05e2\u05dc \u05d4\u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05e1\u05d9\u05de\u05e4\u05ea\u05d8\u05d9\u05ea, \u05d5\u05d4\u05e4\u05e1\u05e7\u05d4 \u05e4\u05ea\u05d0\u05d5\u05de\u05d9\u05ea \u05e2\u05dc\u05d5\u05dc\u05d4 \u05dc\u05d4\u05d5\u05d1\u05d9\u05dc \u05dc\u05de\u05e9\u05d1\u05e8 \u05d9\u05ea\u05e8 \u05dc\u05d7\u05e5 \u05d3\u05dd (Dulcan p.482, StahlKids p.139)."
        },
        {
          "text": "\u05e1\u05d9\u05db\u05d5\u05df \u05dc-Priapism \u05d4\u05de\u05d7\u05d9\u05d9\u05d1 \u05e4\u05e0\u05d9\u05d9\u05d4 \u05d3\u05d7\u05d5\u05e4\u05d4 \u05dc\u05de\u05d9\u05d5\u05df.",
          "isCorrect": false,
          "rationale": "\u05d6\u05d5\u05d4\u05d9 \u05ea\u05d5\u05e4\u05e2\u05ea \u05dc\u05d5\u05d5\u05d0\u05d9 \u05e0\u05d3\u05d9\u05e8\u05d4 \u05d0\u05da \u05d7\u05de\u05d5\u05e8\u05d4 \u05d4\u05e7\u05e9\u05d5\u05e8\u05d4 \u05dc-Trazodone, \u05dc\u05d0 \u05dc\u05e7\u05dc\u05d5\u05e0\u05d9\u05d3\u05d9\u05df (Dulcan p.482)."
        },
        {
          "text": "\u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05d4\u05d5\u05e4\u05e2\u05ea \u05e1\u05d9\u05d5\u05d8\u05d9 \u05dc\u05d9\u05dc\u05d4 (Nightmares) \u05e7\u05d9\u05e6\u05d5\u05e0\u05d9\u05d9\u05dd.",
          "isCorrect": false,
          "rationale": "\u05d1\u05e2\u05d5\u05d3 \u05e9\u05d7\u05dc\u05e7 \u05de\u05d4\u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05de\u05e9\u05e4\u05d9\u05e2\u05d5\u05ea \u05e2\u05dc \u05d7\u05dc\u05d5\u05de\u05d5\u05ea, \u05d6\u05d5 \u05d0\u05d9\u05e0\u05d4 \u05d4\u05d0\u05d6\u05d4\u05e8\u05d4 \u05d4\u05e7\u05e8\u05d9\u05d8\u05d9\u05ea \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05ea \u05d0\u05ea \u05d4\u05e4\u05e1\u05e7\u05ea \u05d4\u05e7\u05dc\u05d5\u05e0\u05d9\u05d3\u05d9\u05df (StahlKids p.144)."
        },
        {
          "text": "\u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05e2\u05e6\u05d9\u05e8\u05ea \u05d2\u05d3\u05d9\u05dc\u05d4 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd.",
          "isCorrect": false,
          "rationale": "\u05e2\u05e6\u05d9\u05e8\u05ea \u05d2\u05d3\u05d9\u05dc\u05d4 \u05d4\u05d9\u05d0 \u05d3\u05d0\u05d2\u05d4 \u05d4\u05e7\u05e9\u05d5\u05e8\u05d4 \u05dc\u05e1\u05d8\u05d9\u05de\u05d5\u05dc\u05e0\u05d8\u05d9\u05dd (Psychostimulants), \u05d1\u05e2\u05d5\u05d3 \u05e9\u05e7\u05dc\u05d5\u05e0\u05d9\u05d3\u05d9\u05df \u05e2\u05dc\u05d5\u05dc \u05dc\u05d2\u05e8\u05d5\u05dd \u05dc\u05d1\u05e8\u05d3\u05d9\u05e7\u05e8\u05d3\u05d9\u05d4 \u05d5\u05d4\u05d9\u05e4\u05d5\u05d8\u05e0\u05e9\u05df (Dulcan p.482, StahlKids p.328)."
        }
