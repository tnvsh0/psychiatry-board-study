    {
      "type": "multiple_select",
      "question": "\u05d0\u05d9\u05dc\u05d5 \u05de\u05d4\u05d4\u05d9\u05d2\u05d3\u05d9\u05dd \u05d4\u05d1\u05d0\u05d9\u05dd \u05e0\u05db\u05d5\u05e0\u05d9\u05dd \u05dc\u05d2\u05d1\u05d9 \u05d4\u05e0\u05d5\u05d9\u05e8\u05d5\u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05d4 \u05d5\u05d4\u05ea\u05e4\u05e7\u05d5\u05d3 \u05e9\u05dc \u05e9\u05dc\u05d1 \u05d4\u05e9\u05d9\u05e0\u05d4 NREM Stage N3 (Slow-Wave Sleep)?",
      "answerOptions": [
        {
          "text": "\u05d1\u05de\u05d4\u05dc\u05da \u05e9\u05dc\u05d1 \u05d6\u05d4 \u05d7\u05dc\u05d4 \u05d4\u05e4\u05e8\u05e9\u05d4 \u05de\u05e1\u05d9\u05d1\u05d9\u05ea \u05e9\u05dc Growth Hormone (GH) \u05de\u05d1\u05dc\u05d5\u05d8\u05ea \u05d4\u05d4\u05d9\u05e4\u05d5\u05e4\u05d9\u05d6\u05d4.",
          "isCorrect": true,
