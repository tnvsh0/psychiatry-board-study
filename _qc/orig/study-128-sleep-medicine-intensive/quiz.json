      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05d0\u05d3\u05e8\u05e0\u05e8\u05d2\u05d9 \u05e9\u05dc \u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 \u05d5\u05d4\u05e9\u05e4\u05e2\u05ea\u05d5 \u05e2\u05dc \u05d4\u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05e7\u05e8\u05d3\u05d9\u05d5\u05d5\u05e1\u05e7\u05d5\u05dc\u05e8\u05d9\u05ea.",
      "imageUrls": []
    },
    {
      "type": "multiple_select",
      "question": "\u05e0\u05e2\u05e8 \u05d1\u05df 15 \u05de\u05d2\u05d9\u05e2 \u05dc\u05d4\u05e2\u05e8\u05db\u05d4 \u05d1\u05e9\u05dc \u05d9\u05e9\u05e0\u05d5\u05e0\u05d9\u05d5\u05ea \u05d9\u05ea\u05e8 \u05e7\u05d9\u05e6\u05d5\u05e0\u05d9\u05ea \u05d1\u05d9\u05d5\u05dd (EDS) \u05d5\u05d4\u05ea\u05e7\u05e4\u05d9 \u05d7\u05d5\u05dc\u05e9\u05d4 \u05d1\u05e9\u05e8\u05d9\u05e8\u05d9\u05dd \u05d1\u05d6\u05de\u05df \u05e6\u05d7\u05d5\u05e7. \u05d0\u05d9\u05dc\u05d5 \u05de\u05de\u05e6\u05d0\u05d9\u05dd \u05e0\u05d5\u05e1\u05e4\u05d9\u05dd \u05e2\u05e9\u05d5\u05d9\u05d9\u05dd \u05dc\u05ea\u05de\u05d5\u05da \u05d1\u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc Narcolepsy \u05e2\u05dc \u05e4\u05d9 \u05d4-DSM-5-TR \u05d5\u05d4\u05e1\u05e4\u05e8\u05d5\u05ea \u05d4\u05e0\u05d5\u05d9\u05e8\u05d5\u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea?",
      "answerOptions": [
        {
          "text": "\u05d4\u05e9\u05de\u05e0\u05ea \u05d9\u05ea\u05e8 (Obesity) \u05d5\u05d4\u05ea\u05d1\u05d2\u05e8\u05d5\u05ea \u05de\u05d9\u05e0\u05d9\u05ea \u05de\u05d5\u05e7\u05d3\u05de\u05ea (Precocious Puberty).",
          "isCorrect": true,
          "rationale": "\u05d1\u05de\u05e6\u05d2 \u05e4\u05d3\u05d9\u05d0\u05d8\u05e8\u05d9 \u05e9\u05dc \u05e0\u05e8\u05e7\u05d5\u05dc\u05e4\u05e1\u05d9\u05d4, \u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd \u05d0\u05e0\u05d3\u05d5\u05e7\u05e8\u05d9\u05e0\u05d9\u05d9\u05dd \u05d0\u05dc\u05d5 \u05e9\u05db\u05d9\u05d7\u05d9\u05dd \u05d1\u05e9\u05dc \u05d4\u05de\u05e2\u05d5\u05e8\u05d1\u05d5\u05ea \u05d4\u05d4\u05d9\u05e4\u05d5\u05ea\u05dc\u05de\u05d9\u05ea (DSM p.425, Dulcan p.483)."
        },
        {
          "text": "\u05d7\u05d1\u05d9\u05d5\u05df \u05e9\u05d9\u05e0\u05ea REM (REM Latency) \u05e7\u05d8\u05df \u05de-15 \u05d3\u05e7\u05d5\u05ea \u05d1\u05d1\u05d3\u05d9\u05e7\u05ea Multiple Sleep Latency Test (MSLT).",
          "isCorrect": true,
          "rationale": "\u05db\u05e0\u05d9\u05e1\u05d4 \u05de\u05d4\u05d9\u05e8\u05d4 \u05dc\u05e9\u05e0\u05ea REM (SOREMPs) \u05d4\u05d9\u05d0 \u05e1\u05d9\u05de\u05df \u05d4\u05d9\u05db\u05e8 \u05d0\u05d1\u05d7\u05e0\u05ea\u05d9 \u05dc\u05e0\u05e8\u05e7\u05d5\u05dc\u05e4\u05e1\u05d9\u05d4 (DSM p.422, Dulcan p.478)."
        },
        {
          "text": "\u05e8\u05de\u05d5\u05ea \u05d2\u05d1\u05d5\u05d4\u05d5\u05ea \u05d1\u05de\u05d9\u05d5\u05d7\u05d3 \u05e9\u05dc Orexin/Hypocretin \u05d1\u05e0\u05d5\u05d6\u05dc \u05d4\u05e9\u05d3\u05e8\u05d4 (CSF).",
          "isCorrect": false,
          "rationale": "\u05dc\u05d4\u05d9\u05e4\u05da, \u05e0\u05e8\u05e7\u05d5\u05dc\u05e4\u05e1\u05d9\u05d4 \u05de\u05e1\u05d5\u05d2 1 \u05de\u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05ea \u05d1\u05d0\u05d5\u05d1\u05d3\u05df \u05e0\u05d5\u05d9\u05e8\u05d5\u05e0\u05d9\u05dd \u05de\u05d9\u05d9\u05e6\u05e8\u05d9 \u05d0\u05d5\u05e8\u05e7\u05e1\u05d9\u05df \u05d5\u05e8\u05de\u05d5\u05ea \u05e0\u05de\u05d5\u05db\u05d5\u05ea \u05d0\u05d5 \u05d0\u05e4\u05e1\u05d9\u05d5\u05ea \u05e9\u05dc\u05d5 \u05d1-CSF (StahlNeuro p.407)."
        },
        {
          "text": "\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e9\u05dc \u05d7\u05e8\u05d3\u05d4 \u05d7\u05d1\u05e8\u05ea\u05d9\u05ea \u05e7\u05d9\u05e6\u05d5\u05e0\u05d9\u05ea \u05d5\u05d4\u05d9\u05de\u05e0\u05e2\u05d5\u05ea \u05de\u05de\u05d2\u05e2.",
          "isCorrect": false,
          "rationale": "\u05d1\u05e2\u05d5\u05d3 \u05e9\u05d9\u05db\u05d5\u05dc\u05d4 \u05dc\u05d4\u05d9\u05d5\u05ea \u05e7\u05d5\u05de\u05d5\u05e8\u05d1\u05d9\u05d3\u05d9\u05d5\u05ea, \u05d0\u05dc\u05d5 \u05d0\u05d9\u05e0\u05dd \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05d0\u05d1\u05d7\u05e0\u05ea\u05d9\u05d9\u05dd \u05d0\u05d5 \u05e1\u05d9\u05de\u05e0\u05d9\u05dd \u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05d9\u05dd \u05dc\u05de\u05d7\u05dc\u05d4 (DSM p.422)."
        }
      ],
      "hint": "\u05d7\u05e4\u05e9 \u05e1\u05d9\u05de\u05e0\u05d9\u05dd \u05d4\u05e7\u05e9\u05d5\u05e8\u05d9\u05dd \u05dc\u05ea\u05d6\u05de\u05d5\u05df \u05e9\u05e0\u05ea \u05d4-REM \u05d5\u05dc\u05ea\u05e4\u05e7\u05d9\u05d3 \u05d4\u05d4\u05d9\u05e4\u05d5\u05ea\u05dc\u05de\u05d5\u05e1.",
      "hasAllOfTheAbove": false,
      "hasNoneOfTheAbove": false
    },
    {
      "type": "multiple_choice",
      "question": "\u05d1\u05e2\u05ea \u05d0\u05d1\u05d7\u05d5\u05df Restless Legs Syndrome (RLS) \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd, \u05de\u05d4\u05d5 \u05d4\u05d4\u05d1\u05d3\u05dc \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05d1\u05ea\u05d9\u05d0\u05d5\u05e8 \u05d4\u05e1\u05d5\u05d1\u05d9\u05d9\u05e7\u05d8\u05d9\u05d1\u05d9 \u05e9\u05dc \u05d4\u05d9\u05dc\u05d3 \u05dc\u05e2\u05d5\u05de\u05ea \u05de\u05d1\u05d5\u05d2\u05e8, \u05e2\u05dc \u05e4\u05d9 \u05d4-DSM-5-TR?",
      "answerOptions": [
        {
          "text": "\u05d9\u05dc\u05d3\u05d9\u05dd \u05e0\u05d5\u05d8\u05d9\u05dd \u05dc\u05d4\u05e9\u05ea\u05de\u05e9 \u05d1\u05ea\u05d9\u05d0\u05d5\u05e8\u05d9\u05dd \u05db\u05de\u05d5 \"\u05d4\u05e8\u05d2\u05dc\u05d9\u05d9\u05dd \u05d7\u05d9\u05d9\u05d1\u05d5\u05ea \u05dc\u05d6\u05d5\u05d6\" \u05d1\u05de\u05e7\u05d5\u05dd \u05d1\u05de\u05d5\u05e0\u05d7 \"\u05d3\u05d7\u05e3\" (Urge).",
          "isCorrect": true,
          "rationale": "\u05d9\u05dc\u05d3\u05d9\u05dd \u05de\u05ea\u05d7\u05ea \u05dc\u05d2\u05d9\u05dc 6-10 \u05de\u05ea\u05e7\u05e9\u05d9\u05dd \u05dc\u05d4\u05d1\u05d9\u05df \u05d0\u05ea \u05d4\u05de\u05d5\u05e9\u05d2 \u05d4\u05de\u05d5\u05e4\u05e9\u05d8 '\u05d3\u05d7\u05e3' \u05d5\u05de\u05ea\u05d0\u05e8\u05d9\u05dd \u05e6\u05d5\u05e8\u05da \u05e4\u05d9\u05d6\u05d9 \u05ea\u05e0\u05d5\u05e2\u05ea\u05d9 \u05d1\u05de\u05d9\u05dc\u05d5\u05ea\u05d9\u05d4\u05dd \u05e9\u05dc\u05d4\u05dd (DSM p.466, Dulcan p.484)."
        },
        {
          "text": "\u05d9\u05dc\u05d3\u05d9\u05dd \u05de\u05d3\u05d5\u05d5\u05d7\u05d9\u05dd \u05e2\u05dc \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05e8\u05e7 \u05d1\u05e9\u05e2\u05d5\u05ea \u05d4\u05d1\u05d5\u05e7\u05e8 \u05d4\u05de\u05d5\u05e7\u05d3\u05de\u05d5\u05ea.",
          "isCorrect": false,
          "rationale": "RLS \u05de\u05d0\u05d5\u05e4\u05d9\u05d9\u05df \u05d1\u05d4\u05d7\u05de\u05e8\u05d4 \u05d1\u05e2\u05e8\u05d1 \u05d5\u05d1\u05dc\u05d9\u05dc\u05d4; \u05db\u05e9\u05e0\u05d9 \u05e9\u05dc\u05d9\u05e9\u05d9\u05dd \u05de\u05d4\u05d9\u05dc\u05d3\u05d9\u05dd \u05de\u05d3\u05d5\u05d5\u05d7\u05d9\u05dd \u05e2\u05dc \u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d2\u05dd \u05d1\u05d9\u05d5\u05dd \u05d1\u05d6\u05de\u05df \u05d9\u05e9\u05d9\u05d1\u05d4 \u05de\u05de\u05d5\u05e9\u05db\u05ea (DSM p.466)."
        },
        {
          "text": "\u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05de\u05ea\u05d1\u05e1\u05e1\u05ea \u05d0\u05da \u05d5\u05e8\u05e7 \u05e2\u05dc \u05d3\u05d9\u05d5\u05d5\u05d7\u05d9 \u05d4\u05d4\u05d5\u05e8\u05d9\u05dd \u05dc\u05dc\u05d0 \u05e6\u05d5\u05e8\u05da \u05d1\u05ea\u05d9\u05d0\u05d5\u05e8 \u05d4\u05d9\u05dc\u05d3.",
          "isCorrect": false,
          "rationale": "\u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05e4\u05d3\u05d9\u05d0\u05d8\u05e8\u05d9\u05ea \u05de\u05d7\u05d9\u05d9\u05d1\u05ea \u05ea\u05d9\u05d0\u05d5\u05e8 \u05d1\u05de\u05d9\u05dc\u05d5\u05ea\u05d9\u05d5 \u05e9\u05dc \u05d4\u05d9\u05dc\u05d3 \u05e2\u05e6\u05de\u05d5 \u05db\u05d3\u05d9 \u05dc\u05d4\u05d1\u05d3\u05d9\u05dc \u05de\u05de\u05e6\u05d1\u05d9\u05dd \u05d0\u05d7\u05e8\u05d9\u05dd (DSM p.466)."
        },
        {
          "text": "\u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05de\u05d5\u05e7\u05dc\u05d9\u05dd \u05d1\u05d6\u05de\u05df \u05de\u05e0\u05d5\u05d7\u05d4 \u05de\u05d5\u05d7\u05dc\u05d8\u05ea \u05dc\u05dc\u05d0 \u05ea\u05e0\u05d5\u05e2\u05d4.",
          "isCorrect": false,
          "rationale": "\u05dc\u05d4\u05d9\u05e4\u05da, \u05d0\u05d7\u05d3 \u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05d4\u05de\u05e8\u05db\u05d6\u05d9\u05d9\u05dd \u05d4\u05d5\u05d0 \u05e9\u05d4\u05d3\u05d7\u05e3 \u05dc\u05d6\u05d5\u05d6 \u05de\u05d5\u05e4\u05d9\u05e2 \u05d0\u05d5 \u05de\u05d7\u05de\u05d9\u05e8 \u05d1\u05d6\u05de\u05df \u05de\u05e0\u05d5\u05d7\u05d4 \u05d0\u05d5 \u05d7\u05d5\u05e1\u05e8 \u05e4\u05e2\u05d9\u05dc\u05d5\u05ea (DSM p.465)."
        }
      ],
      "hint": "\u05d7\u05e9\u05d5\u05d1 \u05e2\u05dc \u05d4\u05d0\u05d5\u05e4\u05df \u05e9\u05d1\u05d5 \u05d9\u05dc\u05d3\u05d9\u05dd \u05de\u05d1\u05d8\u05d0\u05d9\u05dd \u05de\u05d9\u05dc\u05d5\u05dc\u05d9\u05ea \u05ea\u05d7\u05d5\u05e9\u05d5\u05ea \u05d2\u05d5\u05e4\u05e0\u05d9\u05d5\u05ea \u05e4\u05e0\u05d9\u05de\u05d9\u05d5\u05ea.",
