        },
        {
          "text": "\u05d6\u05d4\u05d5 \u05d4\u05e9\u05dc\u05d1 \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05d1\u05d5 \u05e4\u05d5\u05e2\u05dc\u05ea \u05d4-Glymphatic System \u05dc\u05e0\u05d9\u05e7\u05d5\u05d9 \u05e4\u05e1\u05d5\u05dc\u05ea \u05de\u05d8\u05d1\u05d5\u05dc\u05d9\u05ea \u05de\u05d4\u05de\u05d5\u05d7.",
          "isCorrect": true,
          "rationale": "\u05e9\u05e0\u05ea \u05d4-N3 \u05de\u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05ea \u05d1\u05d4\u05ea\u05e8\u05d7\u05d1\u05d5\u05ea \u05d4\u05d7\u05dc\u05dc \u05d4\u05d1\u05d9\u05df-\u05ea\u05d0\u05d9 \u05d4\u05de\u05d0\u05e4\u05e9\u05e8\u05ea \u05e9\u05d8\u05d9\u05e4\u05ea \u05ea\u05d5\u05e6\u05e8\u05d9 \u05dc\u05d5\u05d5\u05d0\u05d9 \u05e9\u05dc \u05d4\u05e2\u05e8\u05d5\u05ea (StahlNeuro p.414)."
        },
        {
          "text": "\u05e9\u05dc\u05d1 \u05d6\u05d4 \u05de\u05e8\u05d5\u05db\u05d6 \u05d1\u05e2\u05d9\u05e7\u05e8 \u05d1\u05e9\u05dc\u05d9\u05e9 \u05d4\u05d0\u05d7\u05e8\u05d5\u05df \u05e9\u05dc \u05d4\u05dc\u05d9\u05dc\u05d4 \u05d5\u05d1\u05e9\u05e2\u05d5\u05ea \u05d4\u05d1\u05d5\u05e7\u05e8 \u05d4\u05de\u05d5\u05e7\u05d3\u05de\u05d5\u05ea.",
          "isCorrect": false,
