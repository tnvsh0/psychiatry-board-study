{
  "title": "Anxiety Flashcards",
  "cards": [
    {
      "front": "\u05de\u05d4\u05d5 \u05de\u05e9\u05da \u05d4\u05d6\u05de\u05df \u05d4\u05de\u05d9\u05e0\u05d9\u05de\u05dc\u05d9 \u05d4\u05e0\u05d3\u05e8\u05e9 \u05e9\u05dc \u05d3\u05d0\u05d2\u05d4 \u05d5\u05d7\u05e8\u05d3\u05d4 \u05de\u05d5\u05e4\u05e8\u05d6\u05ea \u05dc\u05d2\u05d1\u05d9 \u05de\u05e1\u05e4\u05e8 \u05d0\u05d9\u05e8\u05d5\u05e2\u05d9\u05dd \u05d0\u05d5 \u05e4\u05e2\u05d9\u05dc\u05d5\u05d9\u05d5\u05ea \u05dc\u05e6\u05d5\u05e8\u05da \u05d0\u05d1\u05d7\u05e0\u05ea Generalized Anxiety Disorder (GAD)?",
      "back": "\u05dc\u05e4\u05d7\u05d5\u05ea 6 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd, \u05d4\u05de\u05d5\u05e4\u05d9\u05e2\u05d9\u05dd \u05d1\u05e8\u05d5\u05d1 \u05d4\u05d9\u05de\u05d9\u05dd (DSM p.252)."
    },
    {
      "front": "\u05db\u05de\u05d4 \u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05e4\u05d9\u05d6\u05d9\u05d9\u05dd \u05d0\u05d5 \u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9\u05d9\u05dd \u05de\u05ea\u05d5\u05da \u05e8\u05e9\u05d9\u05de\u05ea \u05d4-DSM \u05e0\u05d3\u05e8\u05e9\u05d9\u05dd \u05dc\u05d0\u05d1\u05d7\u05e0\u05ea GAD \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05dc\u05e2\u05d5\u05de\u05ea \u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd?",
      "back": "\u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05e0\u05d3\u05e8\u05e9 \u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05dd \u05d0\u05d7\u05d3 \u05d1\u05dc\u05d1\u05d3, \u05d1\u05e2\u05d5\u05d3 \u05e9\u05d1\u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd \u05e0\u05d3\u05e8\u05e9\u05d9\u05dd \u05dc\u05e4\u05d7\u05d5\u05ea \u05e9\u05dc\u05d5\u05e9\u05d4 (DSM p.252)."
    },
    {
      "front": "\u05de\u05d4\u05dd \u05e9\u05e9\u05ea \u05d4\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05d4\u05e0\u05dc\u05d5\u05d5\u05d9\u05dd \u05d4\u05de\u05d5\u05e4\u05d9\u05e2\u05d9\u05dd \u05d1\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df C \u05e9\u05dc \u05d0\u05d1\u05d7\u05e0\u05ea GAD \u05d1-DSM-5-TR?",
      "back": "Restlessness, Fatigue, \u05e7\u05d5\u05e9\u05d9 \u05d1\u05e8\u05d9\u05db\u05d5\u05d6/Mind going blank, Irritability, Muscle tension, \u05d5-Sleep disturbance (DSM p.252)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4-Mean age of onset \u05e2\u05d1\u05d5\u05e8 GAD \u05d1-North America, \u05d5\u05db\u05d9\u05e6\u05d3 \u05d4\u05d5\u05d0 \u05de\u05d5\u05e9\u05d5\u05d5\u05d4 \u05dc\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05d7\u05e8\u05d3\u05d4 \u05d0\u05d7\u05e8\u05d5\u05ea?",
      "back": "\u05d4\u05d2\u05d9\u05dc \u05d4\u05de\u05de\u05d5\u05e6\u05e2 \u05d4\u05d5\u05d0 35 \u05e9\u05e0\u05d9\u05dd, \u05d5\u05d4\u05d5\u05d0 \u05e0\u05d5\u05d8\u05d4 \u05dc\u05d4\u05d9\u05d5\u05ea \u05de\u05d0\u05d5\u05d7\u05e8 \u05d9\u05d5\u05ea\u05e8 \u05de\u05e9\u05d0\u05e8 \u05d4-Anxiety disorders (DSM p.253)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05e9\u05db\u05d9\u05d7\u05d5\u05ea (12-month prevalence) \u05e9\u05dc GAD \u05d1\u05e7\u05e8\u05d1 \u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd (Adolescents) \u05d1\u05d0\u05e8\u05d4\"\u05d1?",
      "back": "\u05d4\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05e0\u05d0\u05de\u05d3\u05ea \u05d1-0.9% (DSM p.252)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05d4\u05de\u05d2\u05d3\u05e8\u05d9\u05ea \u05e9\u05dc GAD \u05d1\u05e7\u05e8\u05d1 \u05e0\u05e9\u05d9\u05dd \u05dc\u05e2\u05d5\u05de\u05ea \u05d2\u05d1\u05e8\u05d9\u05dd \u05d1\u05d0\u05d5\u05db\u05dc\u05d5\u05e1\u05d9\u05d9\u05ea \u05d4\u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd?",
      "back": "\u05e0\u05e9\u05d9\u05dd \u05e0\u05d5\u05d8\u05d5\u05ea \u05dc\u05e1\u05d1\u05d5\u05dc \u05de\u05d4\u05d4\u05e4\u05e8\u05e2\u05d4 \u05e4\u05d9 2 \u05d9\u05d5\u05ea\u05e8 \u05de\u05d2\u05d1\u05e8\u05d9\u05dd (DSM p.252)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4-Odds Ratio (OR) \u05d4\u05de\u05d5\u05ea\u05d0\u05dd \u05dc\u05e4\u05ea\u05d7 Depressive disorder \u05d1\u05e7\u05e8\u05d1 \u05e0\u05d5\u05e2\u05e8 \u05e2\u05dd GAD \u05dc\u05e2\u05d5\u05de\u05ea \u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05d7\u05e8\u05d3\u05d4 \u05d0\u05d7\u05e8\u05d5\u05ea?",
      "back": "\u05d4-OR \u05d4\u05de\u05d5\u05ea\u05d0\u05dd \u05d4\u05d5\u05d0 2.2 (Dulcan p.320)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05e9\u05d9\u05e2\u05d5\u05e8 \u05d4-Heritability \u05d4\u05de\u05d5\u05e2\u05e8\u05da \u05e2\u05d1\u05d5\u05e8 GAD \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR?",
      "back": "\u05db\u05e9\u05dc\u05d9\u05e9 ($1/3$) \u05de\u05d4\u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05d7\u05d5\u05d5\u05ea GAD \u05d4\u05d5\u05d0 \u05d2\u05e0\u05d8\u05d9 (DSM p.253)."
    },
    {
      "front": "\u05d0\u05d9\u05dc\u05d5 \u05e7\u05d1\u05d5\u05e6\u05d5\u05ea \u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05e0\u05d7\u05e9\u05d1\u05d5\u05ea \u05dc\u05e7\u05d5 \u05e8\u05d0\u05e9\u05d5\u05df (First-line) \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-GAD \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d5\u05e0\u05d5\u05e2\u05e8 \u05dc\u05e4\u05d9 \u05d4-Dulcan?",
      "back": "\u05ea\u05e8\u05d5\u05e4\u05d5\u05ea \u05de\u05e7\u05d1\u05d5\u05e6\u05ea SSRI \u05d5-SNRI (Dulcan p.330)."
    },
    {
      "front": "\u05d0\u05d9\u05d6\u05d5 \u05ea\u05e8\u05d5\u05e4\u05d4 \u05d4\u05d9\u05d0 \u05d4\u05d9\u05d7\u05d9\u05d3\u05d4 \u05e9\u05de\u05d0\u05d5\u05e9\u05e8\u05ea \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d4-FDA \u05d1\u05d0\u05d5\u05e4\u05df \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9 \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-GAD \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d5\u05d1\u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd?",
      "back": "\u05d4\u05ea\u05e8\u05d5\u05e4\u05d4 Duloxetine (StahlKids p.139)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05de\u05e9\u05da \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05ea\u05e8\u05d5\u05e4\u05ea\u05d9 \u05d4\u05de\u05d5\u05de\u05dc\u05e5 \u05dc\u05d0\u05d7\u05e8 \u05d4\u05e9\u05d2\u05ea \u05ea\u05d2\u05d5\u05d1\u05d4 (Response) \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd GAD?",
      "back": "\u05d9\u05e9 \u05dc\u05d4\u05de\u05e9\u05d9\u05da \u05d1\u05d8\u05d9\u05e4\u05d5\u05dc \u05dc\u05de\u05e9\u05da 12 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd (Dulcan p.336)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05de\u05e8\u05db\u05d9\u05d1 \u05d4\u05e7\u05e8\u05d9\u05d8\u05d9 (Crucial component) \u05d1\u05d8\u05d9\u05e4\u05d5\u05dc CBT \u05d4\u05de\u05e0\u05d1\u05d0 \u05e9\u05d9\u05e4\u05d5\u05e8 \u05e7\u05dc\u05d9\u05e0\u05d9 \u05d1-Anxiety disorders \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd?",
      "back": "\u05ea\u05e8\u05d2\u05d5\u05dc \u05d7\u05e9\u05d9\u05e4\u05d4 (Exposure practice) (Dulcan p.336)."
    },
    {
      "front": "\u05d0\u05d9\u05d6\u05d4 \u05e9\u05d0\u05dc\u05d5\u05df \u05e1\u05d9\u05e0\u05d5\u05df (Screening tool) \u05de\u05d4\u05d9\u05e8, \u05d4\u05db\u05d5\u05dc\u05dc 7 \u05e4\u05e8\u05d9\u05d8\u05d9\u05dd, \u05e0\u05de\u05e6\u05d0 \u05e8\u05d2\u05d9\u05e9 \u05dc\u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd \u05ea\u05dc\u05d5\u05d9\u05d9 \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05de\u05ea\u05d1\u05d2\u05e8\u05d9\u05dd \u05e2\u05dd GAD?",
      "back": "\u05d4-GAD-7 (Dulcan p.328)."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05e0\u05e7\u05e8\u05d0 \u05db\u05dc\u05d9 \u05d4\u05d3\u05d9\u05e8\u05d5\u05d2 \u05d4\u05e7\u05dc\u05d9\u05e0\u05d9 (Clinician-rated) \u05d4\u05db\u05d5\u05dc\u05dc 50 \u05e4\u05e8\u05d9\u05d8\u05d9\u05dd \u05d5\u05de\u05e9\u05de\u05e9 \u05dc\u05d4\u05e2\u05e8\u05db\u05ea \u05d7\u05d5\u05de\u05e8\u05ea \u05d7\u05e8\u05d3\u05d4 \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd?",
      "back": "PARS (Pediatric Anxiety Rating Scale) (Dulcan p.328)."
    },
    {
      "front": "\u05d0\u05d9\u05dc\u05d5 \u05de\u05e6\u05d1\u05d9\u05dd \u05e8\u05e4\u05d5\u05d0\u05d9\u05d9\u05dd (Medical mimics) \u05d9\u05e9 \u05dc\u05e9\u05dc\u05d5\u05dc \u05db\u05d7\u05dc\u05e7 \u05de\u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05de\u05d1\u05d3\u05dc\u05ea \u05dc-GAD \u05d4\u05de\u05dc\u05d5\u05d5\u05d4 \u05d1\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05d0\u05d5\u05d8\u05d5\u05e0\u05d5\u05de\u05d9\u05d9\u05dd?",
      "back": "Hyperthyroidism, Pheochromocytoma, \u05d5\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05d7\u05d5\u05de\u05e8\u05d9\u05dd \u05db\u05de\u05d5 Caffeine (DSM p.254)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05d4\u05d1\u05d3\u05dc \u05d4\u05e2\u05d9\u05e7\u05e8\u05d9 \u05d1\u05ea\u05d5\u05db\u05df \u05d4\u05d3\u05d0\u05d2\u05d4 (Content of worry) \u05d1\u05d9\u05df \u05d9\u05dc\u05d3\u05d9\u05dd \u05dc\u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd \u05e2\u05dd GAD?",
      "back": "\u05d9\u05dc\u05d3\u05d9\u05dd \u05e0\u05d5\u05d8\u05d9\u05dd \u05dc\u05d3\u05d0\u05d5\u05d2 \u05dc\u05d2\u05d1\u05d9 \u05d4\u05db\u05e9\u05d9\u05e8\u05d5\u05ea \u05e9\u05dc\u05d4\u05dd (Competence) \u05d0\u05d5 \u05d0\u05d9\u05db\u05d5\u05ea \u05d4\u05d1\u05d9\u05e6\u05d5\u05e2\u05d9\u05dd, \u05d1\u05e2\u05d5\u05d3 \u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd \u05d3\u05d5\u05d0\u05d2\u05d9\u05dd \u05dc\u05e0\u05e1\u05d9\u05d1\u05d5\u05ea \u05d7\u05d9\u05d9\u05dd \u05d9\u05d5\u05de\u05d9\u05d5\u05de\u05d9\u05d5\u05ea (DSM p.252)."
    },
    {
      "front": "\u05dc\u05e4\u05d9 \u05d4-StahlNeuro, \u05e4\u05d2\u05d9\u05e2\u05d4 \u05d1\u05d0\u05d9\u05dc\u05d5 \u05de\u05e2\u05d2\u05dc\u05d9\u05dd \u05de\u05d5\u05d7\u05d9\u05d9\u05dd (Neurocircuitry) \u05e2\u05d5\u05de\u05d3\u05ea \u05d1\u05d1\u05e1\u05d9\u05e1 \u05d4-Fear-based anxiety disorders?",
      "back": "\u05e9\u05d9\u05d1\u05d5\u05e9 \u05d1\u05de\u05e2\u05d2\u05dc\u05d9 Prefrontal amygdala circuitry (Dulcan p.337 / StahlNeuro p.360)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d0\u05d7\u05ea \u05d4\u05d0\u05d5\u05e4\u05e6\u05d9\u05d5\u05ea \u05d4\u05ea\u05e8\u05d5\u05e4\u05ea\u05d9\u05d5\u05ea \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-GAD \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05db\u05e9\u05d9\u05e9 \u05e6\u05d5\u05e8\u05da \u05d1\u05d8\u05d9\u05e4\u05d5\u05dc Prn \u05d0\u05d5 \"Bridge\" \u05d4\u05ea\u05d7\u05dc\u05ea\u05d9?",
      "back": "\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1-Hydroxyzine \u05d0\u05d5 \u05d1-Benzodiazepines \u05d1\u05d0\u05d5\u05e4\u05df \u05e9\u05de\u05e8\u05e0\u05d9 (StahlKids p.139)."
    }
  ]
}