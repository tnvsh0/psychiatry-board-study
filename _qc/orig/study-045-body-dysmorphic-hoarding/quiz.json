    {
      "type": "multiple_choice",
      "question": "\u05dc\u05e4\u05d9 \u05d4-DSM-5-TR, \u05d0\u05d9\u05dc\u05d5 \u05de\u05d4\u05de\u05e6\u05d1\u05d9\u05dd \u05d4\u05e8\u05e4\u05d5\u05d0\u05d9\u05d9\u05dd \u05d4\u05d1\u05d0\u05d9\u05dd \u05de\u05d4\u05d5\u05d5\u05d9\u05dd \"Medical Mimics\" (\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df E) \u05e9\u05d9\u05e9 \u05dc\u05e9\u05dc\u05d5\u05dc \u05dc\u05e4\u05e0\u05d9 \u05d0\u05d1\u05d7\u05d5\u05df Hoarding Disorder?",
      "answerOptions": [
        {
          "text": "Traumatic brain injury (TBI) \u05d5-Prader-Willi syndrome.",
          "isCorrect": true,
          "rationale": "\u05d0\u05d2\u05d9\u05e8\u05d4 \u05d9\u05db\u05d5\u05dc\u05d4 \u05dc\u05d4\u05d9\u05d5\u05ea \u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05dd \u05d9\u05e9\u05d9\u05e8 \u05e9\u05dc \u05e4\u05d2\u05d9\u05e2\u05d4 \u05de\u05d5\u05d7\u05d9\u05ea (\u05d1\u05de\u05d9\u05d5\u05d7\u05d3 \u05d1-ventromedial prefrontal cortex) \u05d0\u05d5 \u05d7\u05dc\u05e7 \u05de\u05ea\u05e1\u05de\u05d5\u05e0\u05ea \u05d2\u05e0\u05d8\u05d9\u05ea \u05db\u05de\u05d5 \u05e4\u05e8\u05d0\u05d3\u05e8-\u05d5\u05d5\u05d9\u05dc\u05d9 (DSM p.280)."
        },
        {
          "text": "Hyperthyroidism \u05d5-Diabetes Type 1.",
          "isCorrect": false,
          "rationale": "\u05de\u05e6\u05d1\u05d9\u05dd \u05d0\u05dc\u05d5 \u05d0\u05d9\u05e0\u05dd \u05de\u05e7\u05d5\u05e9\u05e8\u05d9\u05dd \u05d9\u05e9\u05d9\u05e8\u05d5\u05ea \u05dc\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d0\u05d2\u05d9\u05e8\u05d4 \u05e7\u05d5\u05de\u05e4\u05d5\u05dc\u05e1\u05d9\u05d1\u05d9\u05ea (DSM p.280)."
        },
        {
          "text": "Asthma \u05d5-Chronic Fatigue Syndrome.",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05e9\u05e2\u05d9\u05d9\u05e4\u05d5\u05ea \u05d9\u05db\u05d5\u05dc\u05d4 \u05dc\u05d4\u05d5\u05d1\u05d9\u05dc \u05dc\u05d4\u05d6\u05e0\u05d7\u05d4, \u05d4\u05d9\u05d0 \u05d0\u05d9\u05e0\u05d4 \u05de\u05e1\u05d1\u05d9\u05e8\u05d4 \u05d0\u05ea \u05d4\u05e6\u05d5\u05e8\u05da \u05d4\u05d0\u05e7\u05d8\u05d9\u05d1\u05d9 \u05dc\u05e9\u05de\u05d5\u05e8 \u05d7\u05e4\u05e6\u05d9\u05dd \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05d0\u05d2\u05d9\u05e8\u05d4 (DSM p.281)."
        },
        {
          "text": "Vitamin D deficiency \u05d5-Iron deficiency anemia.",
          "isCorrect": false,
          "rationale": "\u05d7\u05d5\u05e1\u05e8\u05d9\u05dd \u05ea\u05d6\u05d5\u05e0\u05ea\u05d9\u05d9\u05dd \u05d0\u05dc\u05d5 \u05d0\u05d9\u05e0\u05dd \u05e0\u05d7\u05e9\u05d1\u05d9\u05dd \u05dc\u05d0\u05d8\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05d4 \u05e8\u05e4\u05d5\u05d0\u05d9\u05ea \u05dc\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d0\u05d2\u05d9\u05e8\u05d4 (DSM p.280)."
        }
      ],
      "hint": "\u05d7\u05e4\u05e9\u05d5 \u05de\u05e6\u05d1\u05d9\u05dd \u05d4\u05de\u05e9\u05e4\u05d9\u05e2\u05d9\u05dd \u05e2\u05dc \u05ea\u05e4\u05e7\u05d5\u05d3 \u05e4\u05e8\u05d5\u05e0\u05d8\u05dc\u05d9 \u05d0\u05d5 \u05ea\u05e1\u05de\u05d5\u05e0\u05d5\u05ea \u05e0\u05d5\u05d9\u05e8\u05d5-\u05d2\u05e0\u05d8\u05d9\u05d5\u05ea \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05d5\u05ea.",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05de\u05d4\u05d5 \u05e9\u05d9\u05e2\u05d5\u05e8 \u05d4\u05ea\u05d7\u05dc\u05d5\u05d0\u05d4 \u05d4\u05e0\u05dc\u05d5\u05d5\u05d9\u05ea (Comorbidity) \u05d4\u05e9\u05db\u05d9\u05d7 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d1\u05e7\u05e8\u05d1 \u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd \u05e2\u05dd Hoarding Disorder?",
      "answerOptions": [
        {
          "text": "Major Depressive Disorder (\u05db-30% \u05e2\u05d3 50%).",
          "isCorrect": true,
          "rationale": "\u05d3\u05d9\u05db\u05d0\u05d5\u05df \u05de\u05d6'\u05d5\u05e8\u05d9 \u05d4\u05d5\u05d0 \u05d4\u05d4\u05e4\u05e8\u05e2\u05d4 \u05d4\u05e0\u05dc\u05d5\u05d5\u05d9\u05ea \u05d4\u05e9\u05db\u05d9\u05d7\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05d0\u05d2\u05d9\u05e8\u05d4, \u05d5\u05d0\u05d7\u05e8\u05d9\u05d5 \u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05d7\u05e8\u05d3\u05d4 (DSM p.281)."
        },
        {
          "text": "Schizophrenia (\u05db-70%).",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05e9\u05d0\u05d2\u05d9\u05e8\u05d4 \u05d9\u05db\u05d5\u05dc\u05d4 \u05dc\u05d4\u05d5\u05e4\u05d9\u05e2 \u05d1\u05e1\u05db\u05d9\u05d6\u05d5\u05e4\u05e8\u05e0\u05d9\u05d4, \u05d4\u05d9\u05d0 \u05dc\u05e8\u05d5\u05d1 \u05ea\u05d5\u05e6\u05d0\u05d4 \u05e9\u05dc \u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05e9\u05dc\u05d9\u05dc\u05d9\u05d9\u05dd \u05d5\u05dc\u05d0 \u05d4\u05e4\u05e8\u05e2\u05d4 \u05e2\u05e6\u05de\u05d0\u05d9\u05ea (DSM p.281)."
        },
        {
          "text": "Autism Spectrum Disorder (\u05db-60%).",
          "isCorrect": false,
          "rationale": "\u05d0\u05d2\u05d9\u05e8\u05d4 \u05d9\u05db\u05d5\u05dc\u05d4 \u05dc\u05d4\u05d5\u05e4\u05d9\u05e2 \u05d1-ASD \u05db\u05d7\u05dc\u05e7 \u05de\u05ea\u05d7\u05d5\u05de\u05d9 \u05e2\u05e0\u05d9\u05d9\u05df \u05de\u05d5\u05d2\u05d1\u05dc\u05d9\u05dd, \u05d0\u05da \u05d4\u05d9\u05d0 \u05d0\u05d9\u05e0\u05d4 \u05d4\u05ea\u05d7\u05dc\u05d5\u05d0\u05d4 \u05d4\u05e0\u05dc\u05d5\u05d5\u05d9\u05ea \u05d4\u05e9\u05db\u05d9\u05d7\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 (DSM p.281)."
        },
        {
          "text": "Substance Use Disorder (\u05db-80%).",
          "isCorrect": false,
          "rationale": "\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05d7\u05d5\u05de\u05e8\u05d9\u05dd \u05e0\u05e4\u05d5\u05e5 \u05d9\u05d5\u05ea\u05e8 \u05d1-BDD (\u05d1\u05de\u05d9\u05d5\u05d7\u05d3 \u05e1\u05d8\u05e8\u05d5\u05d0\u05d9\u05d3\u05d9\u05dd) \u05de\u05d0\u05e9\u05e8 \u05db\u05e1\u05d9\u05d1\u05d5\u05da \u05de\u05e8\u05db\u05d6\u05d9 \u05d1\u05d0\u05d2\u05d9\u05e8\u05d4 (DSM p.277, p.281)."
        }
      ],
      "hint": "\u05d4\u05ea\u05d9\u05d9\u05d7\u05e1\u05d5 \u05dc\u05e0\u05ea\u05d5\u05e0\u05d9\u05dd \u05d4\u05d0\u05e4\u05d9\u05d3\u05de\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05d9\u05dd \u05d1\u05e4\u05e8\u05e7 \u05d4-Comorbidity \u05d1-DSM.",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05de\u05d4\u05d5 \u05d4\u05d2\u05d9\u05dc \u05d4\u05de\u05de\u05d5\u05e6\u05e2 \u05d5\u05d4\u05d8\u05d9\u05e4\u05d5\u05e1\u05d9 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05d4\u05d5\u05e4\u05e2\u05ea \u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd (onset) \u05e9\u05dc Body Dysmorphic Disorder, \u05d5\u05de\u05d4\u05d5 \u05d4\u05de\u05d4\u05dc\u05da \u05d4\u05e9\u05db\u05d9\u05d7 \u05e9\u05dc \u05d4\u05d4\u05e4\u05e8\u05e2\u05d4?",
      "answerOptions": [
        {
          "text": "\u05d2\u05d9\u05dc\u05d0\u05d9 12\u201313 \u05e9\u05e0\u05d9\u05dd; \u05de\u05d4\u05dc\u05da \u05db\u05e8\u05d5\u05e0\u05d9 \u05dc\u05e8\u05d5\u05d1.",
          "isCorrect": true,
          "rationale": "\u05dc\u05e4\u05d9 \u05d4-DSM, \u05d4\u05d2\u05d9\u05dc \u05d4\u05e9\u05db\u05d9\u05d7 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05d4\u05ea\u05d7\u05dc\u05d4 \u05d4\u05d5\u05d0 12-13, \u05d5\u05d4\u05d4\u05e4\u05e8\u05e2\u05d4 \u05e0\u05d5\u05d8\u05d4 \u05dc\u05d4\u05d9\u05d5\u05ea \u05db\u05e8\u05d5\u05e0\u05d9\u05ea \u05dc\u05dc\u05d0 \u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05d5\u05dc\u05dd (DSM p.274)."
        },
        {
          "text": "\u05d2\u05d9\u05dc\u05d0\u05d9 20\u201325 \u05e9\u05e0\u05d9\u05dd; \u05de\u05d4\u05dc\u05da \u05e9\u05dc \u05d4\u05ea\u05e7\u05e4\u05d9\u05dd \u05d5\u05d4\u05e4\u05d5\u05d2\u05d5\u05ea (waxing and waning).",
          "isCorrect": false,
          "rationale": "\u05d1\u05e8\u05d5\u05d1 \u05d4\u05de\u05e7\u05e8\u05d9\u05dd (\u05e9\u05e0\u05d9 \u05e9\u05dc\u05d9\u05e9) \u05d4\u05d4\u05e4\u05e8\u05e2\u05d4 \u05de\u05ea\u05d7\u05d9\u05dc\u05d4 \u05dc\u05e4\u05e0\u05d9 \u05d2\u05d9\u05dc 18, \u05d5\u05d4\u05de\u05d4\u05dc\u05da \u05dc\u05e8\u05d5\u05d1 \u05d0\u05d9\u05e0\u05d5 \u05de\u05d0\u05d5\u05e4\u05d9\u05d9\u05df \u05d1\u05d4\u05e4\u05d5\u05d2\u05d5\u05ea \u05e1\u05e4\u05d5\u05e0\u05d8\u05e0\u05d9\u05d5\u05ea (DSM p.274)."
        },
        {
          "text": "\u05d2\u05d9\u05dc\u05d0\u05d9 5\u20137 \u05e9\u05e0\u05d9\u05dd; \u05dc\u05e8\u05d5\u05d1 \u05d7\u05d5\u05dc\u05e3 \u05de\u05e2\u05e6\u05de\u05d5 \u05dc\u05d0\u05d7\u05e8 \u05d2\u05d9\u05dc \u05d4\u05d4\u05ea\u05d1\u05d2\u05e8\u05d5\u05ea.",
          "isCorrect": false,
          "rationale": "\u05d4\u05d5\u05e4\u05e2\u05d4 \u05d1\u05d9\u05dc\u05d3\u05d5\u05ea \u05d4\u05de\u05d5\u05e7\u05d3\u05de\u05ea \u05d4\u05d9\u05d0 \u05e0\u05d3\u05d9\u05e8\u05d4 \u05de\u05d0\u05d5\u05d3, \u05d5\u05d4\u05d4\u05e4\u05e8\u05e2\u05d4 \u05d0\u05d9\u05e0\u05d4 \u05e0\u05d5\u05d8\u05d4 \u05dc\u05d7\u05dc\u05d5\u05e3 \u05dc\u05dc\u05d0 \u05d4\u05ea\u05e2\u05e8\u05d1\u05d5\u05ea (DSM p.274)."
        },
        {
          "text": "\u05d2\u05d9\u05dc\u05d0\u05d9 40 \u05d5\u05de\u05e2\u05dc\u05d4; \u05e7\u05e9\u05d5\u05e8 \u05dc\u05e9\u05d9\u05e0\u05d5\u05d9\u05d9 \u05d2\u05d9\u05dc \u05e4\u05d9\u05d6\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05d9\u05dd.",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05e9\u05d4\u05e4\u05e8\u05e2\u05d4 \u05e7\u05d9\u05d9\u05de\u05ea \u05d1\u05de\u05d1\u05d5\u05d2\u05e8\u05d9\u05dd, \u05d2\u05d9\u05dc \u05d4\u05d4\u05d5\u05e4\u05e2\u05d4 \u05d4\u05d8\u05d9\u05e4\u05d5\u05e1\u05d9 \u05d4\u05d5\u05d0 \u05d1\u05d2\u05d9\u05dc \u05d4\u05d4\u05ea\u05d1\u05d2\u05e8\u05d5\u05ea \u05d4\u05de\u05d5\u05e7\u05d3\u05dd (DSM p.274)."
        }
      ],
      "hint": "\u05d7\u05d9\u05e9\u05d1\u05d5 \u05e2\u05dc \u05ea\u05e7\u05d5\u05e4\u05ea \u05d4\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea \u05d1\u05d4 \u05d4\u05de\u05d5\u05d3\u05e2\u05d5\u05ea \u05d4\u05e2\u05e6\u05de\u05d9\u05ea \u05dc\u05de\u05e8\u05d0\u05d4 \u05d4\u05d5\u05e4\u05db\u05ea \u05dc\u05de\u05e8\u05db\u05d6\u05d9\u05ea.",
      "imageUrls": []
    }
  ]
}