{
  "title": "Psychiatry Quiz",
  "questions": [
    {
      "type": "multiple_choice",
      "question": "\u05de\u05ea\u05d1\u05d2\u05e8 \u05d1\u05df 17 \u05de\u05d5\u05e4\u05e0\u05d4 \u05dc\u05d4\u05e2\u05e8\u05db\u05d4 \u05d1\u05e9\u05dc \u05e2\u05d9\u05e1\u05d5\u05e7 \u05d0\u05d9\u05e0\u05d8\u05e0\u05e1\u05d9\u05d1\u05d9 \u05d1\u05de\u05d1\u05e0\u05d4 \u05d2\u05d5\u05e4\u05d5. \u05d4\u05d5\u05d0 \u05de\u05d1\u05dc\u05d4 4 \u05e9\u05e2\u05d5\u05ea \u05d1\u05d9\u05d5\u05dd \u05d1\u05d7\u05d3\u05e8 \u05d4\u05db\u05d5\u05e9\u05e8, \u05de\u05e7\u05e4\u05d9\u05d3 \u05e2\u05dc \u05d3\u05d9\u05d0\u05d8\u05d4 \u05e2\u05ea\u05d9\u05e8\u05ea \u05d7\u05dc\u05d1\u05d5\u05df \u05e0\u05d5\u05e7\u05e9\u05d4, \u05d5\u05de\u05e9\u05ea\u05de\u05e9 \u05d1-anabolic steroids. \u05dc\u05de\u05e8\u05d5\u05ea \u05d4\u05d9\u05d5\u05ea\u05d5 \u05e9\u05e8\u05d9\u05e8\u05d9 \u05de\u05d0\u05d5\u05d3, \u05d4\u05d5\u05d0 \u05de\u05e9\u05d5\u05db\u05e0\u05e2 \u05dc\u05d7\u05dc\u05d5\u05d8\u05d9\u05df (absent insight) \u05e9\u05d4\u05d5\u05d0 \u05e0\u05e8\u05d0\u05d4 \"\u05e6\u05e0\u05d5\u05dd \u05d5\u05d7\u05dc\u05e9\". \u05d4\u05d5\u05d0 \u05e0\u05de\u05e0\u05e2 \u05de\u05d0\u05d9\u05e8\u05d5\u05e2\u05d9\u05dd \u05d7\u05d1\u05e8\u05ea\u05d9\u05d9\u05dd \u05e9\u05d1\u05d4\u05dd \u05e2\u05dc\u05d9\u05d5 \u05dc\u05d7\u05e9\u05d5\u05e3 \u05d0\u05ea \u05d2\u05d5\u05e4\u05d5. \u05de\u05d4\u05d9 \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05de\u05ea\u05d0\u05d9\u05de\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR?",
      "answerOptions": [
        {
          "text": "Body Dysmorphic Disorder with muscle dysmorphia specifier.",
          "isCorrect": true,
          "rationale": "\u05d4\u05ea\u05d9\u05d0\u05d5\u05e8 \u05de\u05ea\u05d0\u05d9\u05dd \u05dc\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05e9\u05dc BDD (\u05e2\u05d9\u05e1\u05d5\u05e7 \u05d1\u05e4\u05d2\u05dd \u05e0\u05ea\u05e4\u05e1, \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05d7\u05d6\u05e8\u05ea\u05d9\u05ea \u05e9\u05dc \u05d0\u05d9\u05de\u05d5\u05df \u05d9\u05ea\u05e8) \u05e2\u05dd \u05d4\u05de\u05e4\u05e8\u05d8 \u05d4\u05e1\u05e4\u05e6\u05d9\u05e4\u05d9 muscle dysmorphia \u05d4\u05e9\u05db\u05d9\u05d7 \u05d1\u05d2\u05d1\u05e8\u05d9\u05dd \u05d5\u05de\u05ea\u05d0\u05e4\u05d9\u05d9\u05df \u05d1\u05d0\u05de\u05d5\u05e0\u05d4 \u05e9\u05d4\u05d2\u05d5\u05e3 \u05d0\u05d9\u05e0\u05d5 \u05e9\u05e8\u05d9\u05e8\u05d9 \u05de\u05e1\u05e4\u05d9\u05e7 (DSM p.272)."
        },
        {
          "text": "Anorexia Nervosa, binge-eating/purging type.",
          "isCorrect": false,
          "rationale": "\u05d4\u05e2\u05d9\u05e1\u05d5\u05e7 \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05db\u05d0\u05df \u05d4\u05d5\u05d0 \u05d1\u05d7\u05d5\u05e1\u05e8 \u05e9\u05e8\u05d9\u05e8\u05d9\u05d5\u05ea \u05d5\u05dc\u05d0 \u05d1\u05d9\u05e8\u05d9\u05d3\u05d4 \u05d1\u05de\u05e9\u05e7\u05dc \u05d0\u05d5 \u05e4\u05d7\u05d3 \u05de\u05d4\u05e9\u05de\u05e0\u05d4, \u05d5\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df D \u05e9\u05dc BDD \u05de\u05e6\u05d9\u05d9\u05df \u05e9\u05d4\u05e4\u05e8\u05e2\u05d4 \u05dc\u05d0 \u05ea\u05d5\u05e1\u05d1\u05e8 \u05d8\u05d5\u05d1 \u05d9\u05d5\u05ea\u05e8 \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d4\u05e4\u05e8\u05e2\u05ea \u05d0\u05db\u05d9\u05dc\u05d4 (DSM p.272, p.381)."
        },
        {
          "text": "Obsessive-Compulsive Disorder (OCD).",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05e9\u05d9\u05e9 \u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05d9\u05d5\u05ea \u05d7\u05d6\u05e8\u05ea\u05d9\u05d5\u05ea, \u05d4\u05de\u05d9\u05e7\u05d5\u05d3 \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05d4\u05d5\u05d0 \u05d1\u05de\u05e8\u05d0\u05d4 \u05d4\u05d7\u05d9\u05e6\u05d5\u05e0\u05d9 (appearance concerns), \u05de\u05d4 \u05e9\u05de\u05db\u05d5\u05d5\u05df \u05dc\u05d0\u05d1\u05d7\u05e0\u05d4 \u05d4\u05e1\u05e4\u05e6\u05d9\u05e4\u05d9\u05ea \u05e9\u05dc BDD \u05d5\u05dc\u05d0 OCD \u05db\u05dc\u05dc\u05d9 (DSM p.266)."
        },
        {
          "text": "Delusional Disorder, Somatic Type.",
          "isCorrect": false,
          "rationale": "\u05db\u05d0\u05e9\u05e8 \u05d4\u05d0\u05de\u05d5\u05e0\u05d5\u05ea \u05d4\u05d3\u05dc\u05d5\u05d6\u05d9\u05d5\u05e0\u05dc\u05d9\u05d5\u05ea \u05de\u05d5\u05d2\u05d1\u05dc\u05d5\u05ea \u05dc\u05ea\u05d5\u05db\u05df \u05e9\u05dc BDD, \u05d4-DSM \u05de\u05e0\u05d7\u05d4 \u05dc\u05ea\u05ea \u05d0\u05d1\u05d7\u05e0\u05ea BDD \u05e2\u05dd \u05de\u05e4\u05e8\u05d8 \u05e9\u05dc absent insight \u05d5\u05dc\u05d0 \u05d0\u05d1\u05d7\u05e0\u05d4 \u05e0\u05e4\u05e8\u05d3\u05ea \u05e9\u05dc \u05d4\u05e4\u05e8\u05e2\u05d4 \u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9\u05ea (DSM p.272)."
        }
      ],
      "hint": "\u05e9\u05d9\u05de\u05d5 \u05dc\u05d1 \u05dc\u05de\u05d9\u05e7\u05d5\u05d3 \u05d4\u05e1\u05e4\u05e6\u05d9\u05e4\u05d9 \u05d1\u05de\u05d1\u05e0\u05d4 \u05d4\u05d2\u05d5\u05e3 (\u05e9\u05e8\u05d9\u05e8\u05d9\u05d5\u05ea) \u05d5\u05dc\u05d3\u05e8\u05d2\u05ea \u05d4\u05ea\u05d5\u05d1\u05e0\u05d4 \u05e9\u05dc \u05d4\u05de\u05d8\u05d5\u05e4\u05dc.",
      "imageUrls": []
    },
    {
      "type": "multiple_choice",
      "question": "\u05de\u05d8\u05d5\u05e4\u05dc\u05ea \u05d1\u05ea 60 \u05de\u05d2\u05d9\u05e2\u05d4 \u05dc\u05d4\u05e2\u05e8\u05db\u05d4 \u05dc\u05d1\u05e7\u05e9\u05ea \u05d9\u05dc\u05d3\u05d9\u05d4. \u05d1\u05d1\u05d9\u05e7\u05d5\u05e8 \u05d1\u05d9\u05ea, \u05d4\u05d3\u05d9\u05e8\u05d4 \u05e0\u05e8\u05d0\u05d9\u05ea \u05de\u05e1\u05d5\u05d3\u05e8\u05ea \u05d5\u05e0\u05e7\u05d9\u05d9\u05d4, \u05d0\u05da \u05d4\u05d9\u05dc\u05d3\u05d9\u05dd \u05de\u05d3\u05d5\u05d5\u05d7\u05d9\u05dd \u05db\u05d9 \u05d6\u05d4 \u05d4\u05de\u05e6\u05d1 \u05e8\u05e7 \u05de\u05e9\u05d5\u05dd \u05e9\u05d4\u05dd \u05e9\u05db\u05e8\u05d5 \u05e9\u05d9\u05e8\u05d5\u05ea\u05d9 \u05e0\u05d9\u05e7\u05d9\u05d5\u05df \u05de\u05e7\u05e6\u05d5\u05e2\u05d9\u05d9\u05dd \u05d5\u05e4\u05d9\u05e0\u05d5 \u05d7\u05e4\u05e6\u05d9\u05dd \u05d1\u05db\u05e4\u05d9\u05d9\u05d4 \u05d1\u05e9\u05d1\u05d5\u05e2 \u05e9\u05e2\u05d1\u05e8. \u05d4\u05de\u05d8\u05d5\u05e4\u05dc\u05ea \u05de\u05d3\u05d5\u05d5\u05d7\u05ea \u05e2\u05dc \u05de\u05e6\u05d5\u05e7\u05d4 \u05e7\u05e9\u05d4 \u05de\u05d0\u05d5\u05d3 (marked distress) \u05d1\u05e2\u05e7\u05d1\u05d5\u05ea \u05d4\u05e4\u05d9\u05e0\u05d5\u05d9 \u05d5\u05d8\u05d5\u05e2\u05e0\u05ea \u05e9\u05d4\u05d9\u05d9\u05ea\u05d4 \u05e6\u05e8\u05d9\u05db\u05d4 \u05db\u05dc \u05e4\u05e8\u05d9\u05d8 \u05d5\u05e4\u05e8\u05d9\u05d8. \u05db\u05d9\u05e6\u05d3 \u05de\u05e9\u05e4\u05d9\u05e2\u05d4 \u05d4\u05ea\u05e2\u05e8\u05d1\u05d5\u05ea \u05d4\u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dc \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05e9\u05dc Hoarding Disorder?",
      "answerOptions": [
        {
          "text": "\u05d4\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df \u05d4\u05d0\u05d1\u05d7\u05e0\u05ea\u05d9 \u05de\u05ea\u05e7\u05d9\u05d9\u05dd, \u05e9\u05db\u05df \u05d7\u05d5\u05e1\u05e8 \u05d1\u05e2\u05d5\u05de\u05e1 (clutter) \u05e0\u05d5\u05d1\u05e2 \u05e8\u05e7 \u05de\u05d4\u05ea\u05e2\u05e8\u05d1\u05d5\u05ea \u05e6\u05d3 \u05e9\u05dc\u05d9\u05e9\u05d9.",
          "isCorrect": true,
          "rationale": "\u05dc\u05e4\u05d9 \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df C, \u05d0\u05dd \u05d0\u05d6\u05d5\u05e8\u05d9 \u05d4\u05de\u05d2\u05d5\u05e8\u05d9\u05dd \u05d0\u05d9\u05e0\u05dd \u05e2\u05de\u05d5\u05e1\u05d9\u05dd \u05e8\u05e7 \u05d1\u05e9\u05dc \u05d4\u05ea\u05e2\u05e8\u05d1\u05d5\u05ea \u05e9\u05dc \u05e6\u05d3\u05d3\u05d9\u05dd \u05e9\u05dc\u05d9\u05e9\u05d9\u05d9\u05dd (\u05de\u05e9\u05e4\u05d7\u05d4, \u05e8\u05e9\u05d5\u05d9\u05d5\u05ea), \u05d4\u05d0\u05d1\u05d7\u05e0\u05d4 \u05e2\u05d3\u05d9\u05d9\u05df \u05e2\u05d5\u05de\u05d3\u05ea (DSM p.278)."
        },
        {
          "text": "\u05dc\u05d0 \u05e0\u05d9\u05ea\u05df \u05dc\u05d0\u05d1\u05d7\u05df Hoarding Disorder \u05d1\u05d4\u05d9\u05e2\u05d3\u05e8 clutter \u05e4\u05e2\u05d9\u05dc \u05d1\u05d0\u05d6\u05d5\u05e8\u05d9 \u05d4\u05de\u05d2\u05d5\u05e8\u05d9\u05dd \u05d1\u05e2\u05ea \u05d4\u05d1\u05d3\u05d9\u05e7\u05d4.",
          "isCorrect": false,
          "rationale": "\u05d4-DSM \u05de\u05db\u05d9\u05e8 \u05d1\u05db\u05da \u05e9\u05d4\u05ea\u05e2\u05e8\u05d1\u05d5\u05ea \u05d7\u05d9\u05e6\u05d5\u05e0\u05d9\u05ea (forced cleanout) \u05d9\u05db\u05d5\u05dc\u05d4 \u05dc\u05de\u05e1\u05da \u05d0\u05ea \u05d4\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05dd \u05e9\u05dc \u05d4\u05e6\u05d8\u05d1\u05e8\u05d5\u05ea, \u05d0\u05da \u05d4\u05e7\u05d5\u05e9\u05d9 \u05d4\u05d1\u05e1\u05d9\u05e1\u05d9 \u05d5\u05d4\u05de\u05e6\u05d5\u05e7\u05d4 \u05e0\u05e9\u05d0\u05e8\u05d9\u05dd (DSM p.278)."
        },
        {
          "text": "\u05d9\u05e9 \u05dc\u05d0\u05d1\u05d7\u05df Obsessive-Compulsive Personality Disorder (OCPD) \u05d1\u05e9\u05dc \u05d4\u05e7\u05d5\u05e9\u05d9 \u05dc\u05d4\u05d9\u05e4\u05e8\u05d3 \u05de\u05d7\u05e4\u05e6\u05d9\u05dd.",
          "isCorrect": false,
          "rationale": "\u05dc\u05de\u05e8\u05d5\u05ea \u05e9-OCPD \u05db\u05d5\u05dc\u05dc \u05d7\u05d5\u05e1\u05e8 \u05d9\u05db\u05d5\u05dc\u05ea \u05dc\u05d6\u05e8\u05d5\u05e7 \u05d7\u05e4\u05e6\u05d9\u05dd, \u05d1\u05de\u05e7\u05e8\u05d4 \u05d6\u05d4 \u05d9\u05e9\u05e0\u05d4 \u05de\u05e6\u05d5\u05e7\u05d4 \u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05d5\u05d4\u05e6\u05d8\u05d1\u05e8\u05d5\u05ea \u05e9\u05e4\u05d5\u05d2\u05e2\u05ea \u05d1\u05ea\u05e4\u05e7\u05d5\u05d3 \u05d4\u05d3\u05d9\u05e8\u05d4, \u05de\u05d4 \u05e9\u05de\u05db\u05d5\u05d5\u05df \u05dc\u05d4\u05e4\u05e8\u05e2\u05ea \u05d0\u05d2\u05d9\u05e8\u05d4 (DSM p.773, p.775)."
        },
        {
          "text": "\u05d9\u05e9 \u05dc\u05d0\u05d1\u05d7\u05df Major Depressive Disorder \u05db\u05d2\u05d5\u05e8\u05dd \u05e8\u05d0\u05e9\u05d5\u05e0\u05d9 \u05dc\u05d0\u05d2\u05d9\u05e8\u05d4.",
          "isCorrect": false,
          "rationale": "\u05d0\u05d1\u05d7\u05e0\u05ea \u05d0\u05d2\u05d9\u05e8\u05d4 \u05dc\u05d0 \u05e0\u05d9\u05ea\u05e0\u05ea \u05e8\u05e7 \u05d0\u05dd \u05d4\u05e6\u05d8\u05d1\u05e8\u05d5\u05ea \u05d4\u05d9\u05d0 \u05ea\u05d5\u05e6\u05d0\u05d4 \u05d9\u05e9\u05d9\u05e8\u05d4 \u05e9\u05dc \u05d7\u05d5\u05e1\u05e8 \u05d0\u05e0\u05e8\u05d2\u05d9\u05d4 \u05d1\u05d3\u05d9\u05db\u05d0\u05d5\u05df; \u05db\u05d0\u05df \u05d4\u05de\u05e6\u05d5\u05e7\u05d4 \u05e0\u05d5\u05d1\u05e2\u05ea \u05de\u05d4\u05e6\u05d5\u05e8\u05da \u05dc\u05e9\u05de\u05d5\u05e8 \u05d0\u05ea \u05d4\u05d7\u05e4\u05e6\u05d9\u05dd (DSM p.281)."
        }
      ],
      "hint": "\u05d1\u05d3\u05e7\u05d5 \u05d0\u05ea \u05d4\u05d4\u05e2\u05e8\u05d5\u05ea \u05d4\u05de\u05d9\u05d5\u05d7\u05d3\u05d5\u05ea \u05d1\u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df C \u05d1\u05e0\u05d5\u05d2\u05e2 \u05dc\u05e1\u05d1\u05d9\u05d1\u05ea \u05d4\u05de\u05d2\u05d5\u05e8\u05d9\u05dd.",
