{
  "title": "Psychiatry Flashcards",
  "cards": [
    {
      "front": "\u05de\u05d4\u05d5 \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df A \u05dc\u05d4\u05e4\u05e8\u05e2\u05ea \u05d2\u05d5\u05e3 \u05d3\u05d9\u05e1\u05de\u05d5\u05e8\u05e4\u05d9\u05ea (BDD) \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR?",
      "back": "Preoccupation (\u05e2\u05d9\u05e1\u05d5\u05e7 \u05de\u05d5\u05e4\u05e8\u05d6) \u05d1\u05e4\u05d2\u05dd \u05d0\u05d7\u05d3 \u05d0\u05d5 \u05d9\u05d5\u05ea\u05e8 \u05d1\u05d4\u05d5\u05e4\u05e2\u05d4 \u05d4\u05d7\u05d9\u05e6\u05d5\u05e0\u05d9\u05ea \u05e9\u05d0\u05d9\u05e0\u05d5 \u05e0\u05e8\u05d0\u05d4 \u05dc\u05d0\u05d7\u05e8\u05d9\u05dd \u05d0\u05d5 \u05e9\u05e0\u05e8\u05d0\u05d4 \u05de\u05d6\u05e2\u05e8\u05d9 (slight) \u05d1\u05dc\u05d1\u05d3 (DSM p.272)."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05de\u05d5\u05d2\u05d3\u05e8 \u05d4\u05de\u05e4\u05e8\u05d8 \"With muscle dysmorphia\" \u05d1-BDD?",
      "back": "\u05e2\u05d9\u05e1\u05d5\u05e7 \u05de\u05d5\u05e4\u05e8\u05d6 \u05d1\u05de\u05d7\u05e9\u05d1\u05d4 \u05e9\u05de\u05d1\u05e0\u05d4 \u05d4\u05d2\u05d5\u05e3 \u05e7\u05d8\u05df \u05de\u05d3\u05d9 \u05d0\u05d5 \u05e9\u05d0\u05d9\u05e0\u05d5 \u05e9\u05e8\u05d9\u05e8\u05d9 \u05de\u05e1\u05e4\u05d9\u05e7, \u05d4\u05de\u05d5\u05e4\u05d9\u05e2 \u05db\u05de\u05e2\u05d8 \u05d1\u05dc\u05e2\u05d3\u05d9\u05ea \u05d1\u05d6\u05db\u05e8\u05d9\u05dd (DSM p.272)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05e9\u05dc \u05e8\u05de\u05ea \u05ea\u05d5\u05d1\u05e0\u05d4 \u05de\u05e1\u05d5\u05d2 \"absent insight/delusional beliefs\" \u05d1\u05e7\u05e8\u05d1 \u05d4\u05e1\u05d5\u05d1\u05dc\u05d9\u05dd \u05de-BDD?",
      "back": "\u05db\u05e9\u05dc\u05d9\u05e9 ($33\\%$) \u05d0\u05d5 \u05d9\u05d5\u05ea\u05e8 \u05de\u05d4\u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd \u05de\u05e9\u05d5\u05db\u05e0\u05e2\u05d9\u05dd \u05dc\u05d7\u05dc\u05d5\u05d8\u05d9\u05df \u05e9\u05d4\u05d0\u05de\u05d5\u05e0\u05d5\u05ea \u05dc\u05d2\u05d1\u05d9 \u05d4\u05de\u05e8\u05d0\u05d4 \u05e9\u05dc\u05d4\u05dd \u05e0\u05db\u05d5\u05e0\u05d5\u05ea \u05d5\u05de\u05d3\u05d5\u05d9\u05e7\u05d5\u05ea (DSM p.273)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05d2\u05d9\u05dc \u05d4\u05d7\u05e6\u05d9\u05d5\u05e0\u05d9 (median) \u05dc\u05e4\u05e8\u05d5\u05e5 \u05d4\u05e4\u05e8\u05e2\u05ea BDD?",
      "back": "\u05d4\u05d2\u05d9\u05dc \u05d4\u05d7\u05e6\u05d9\u05d5\u05e0\u05d9 \u05dc\u05d4\u05d5\u05e4\u05e2\u05ea \u05d4\u05d4\u05e4\u05e8\u05e2\u05d4 \u05d4\u05d5\u05d0 $15$ \u05e9\u05e0\u05d9\u05dd, \u05db\u05d0\u05e9\u05e8 \u05e9\u05d9\u05d0 \u05d4\u05d5\u05e4\u05e2\u05ea \u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05d4\u05d5\u05d0 \u05d1\u05d2\u05d9\u05dc\u05d0\u05d9 $12-13$ (DSM p.274)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05dc\u05d9\u05e7\u05d5\u05d9 \u05d1\u05e2\u05d9\u05d1\u05d5\u05d3 \u05d4\u05d5\u05d9\u05d6\u05d5\u05d0\u05dc\u05d9 \u05d4\u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05de\u05d8\u05d5\u05e4\u05dc\u05d9\u05dd \u05e2\u05dd BDD?",
      "back": "\u05e0\u05d8\u05d9\u05d9\u05d4 \u05dc\u05e2\u05d9\u05d1\u05d5\u05d3 \u05d5\u05e4\u05d9\u05e8\u05d5\u05d8 \u05d9\u05ea\u05e8 \u05e9\u05dc \u05e4\u05e8\u05d8\u05d9\u05dd (encoding details) \u05e2\u05dc \u05d7\u05e9\u05d1\u05d5\u05df \u05ea\u05e4\u05d9\u05e1\u05d4 \u05d4\u05d5\u05dc\u05d9\u05e1\u05d8\u05d9\u05ea \u05d0\u05d5 \u05e7\u05d5\u05e0\u05e4\u05d9\u05d2\u05d5\u05e8\u05d8\u05d9\u05d1\u05d9\u05ea (DSM p.274)."
    },
    {
      "front": "\u05d0\u05d9\u05dc\u05d5 \u05d0\u05d6\u05d5\u05e8\u05d9\u05dd \u05de\u05d5\u05d7\u05d9\u05d9\u05dd \u05de\u05e2\u05d5\u05e8\u05d1\u05d9\u05dd \u05d1\u05e4\u05ea\u05d5\u05e4\u05d9\u05d6\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05d4 \u05e9\u05dc BDD \u05dc\u05e4\u05d9 \u05d4\u05de\u05d5\u05d3\u05dc \u05d4-CSTC?",
      "back": "\u05dc\u05d9\u05e7\u05d5\u05d9\u05d9\u05dd \u05d1-Orbitofrontal cortex (OFC) \u05d5\u05d1-Anterior cingulate cortex (ACC) \u05d4\u05de\u05e2\u05d5\u05e8\u05d1\u05d9\u05dd \u05d1\u05d1\u05e7\u05e8\u05d4 \u05e2\u05dc \u05d3\u05d7\u05e4\u05d9\u05dd \u05d5\u05d7\u05e8\u05d3\u05d4 (StahlNeuro p.540)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df \u05d4-Differential Diagnosis \u05d4\u05de\u05d1\u05d3\u05d9\u05dc \u05d1\u05d9\u05df BDD \u05dc\u05d4\u05e4\u05e8\u05e2\u05ea \u05d0\u05db\u05d9\u05dc\u05d4?",
      "back": "\u05d4\u05e2\u05d9\u05e1\u05d5\u05e7 \u05d1\u05de\u05e8\u05d0\u05d4 \u05d0\u05d9\u05e0\u05d5 \u05de\u05d5\u05e1\u05d1\u05e8 \u05d8\u05d5\u05d1 \u05d9\u05d5\u05ea\u05e8 \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d3\u05d0\u05d2\u05d5\u05ea \u05dc\u05d2\u05d1\u05d9 \u05e9\u05d5\u05de\u05df \u05d2\u05d5\u05e3 \u05d0\u05d5 \u05de\u05e9\u05e7\u05dc \u05d1\u05e4\u05e8\u05d8 \u05e9\u05e2\u05d5\u05e0\u05d4 \u05e2\u05dc \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05e0\u05d9\u05dd \u05dc\u05d4\u05e4\u05e8\u05e2\u05ea \u05d0\u05db\u05d9\u05dc\u05d4 (DSM p.272)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05d4\u05e4\u05e8\u05e2\u05d4 \u05d4\u05e0\u05dc\u05d5\u05d5\u05d9\u05ea (Comorbidity) \u05d4\u05e9\u05db\u05d9\u05d7\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d1-BDD?",
      "back": "Major Depressive Disorder (MDD), \u05d4\u05de\u05d5\u05e4\u05d9\u05e2\u05d4 \u05dc\u05e8\u05d5\u05d1 \u05dc\u05d0\u05d7\u05e8 \u05e4\u05e8\u05d5\u05e5 \u05d4-BDD (DSM p.277)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df C \u05d1\u05d0\u05d1\u05d7\u05e0\u05ea Hoarding Disorder?",
      "back": "\u05d4\u05e6\u05d8\u05d1\u05e8\u05d5\u05ea \u05d7\u05e4\u05e6\u05d9\u05dd \u05d4\u05d2\u05d5\u05d3\u05e9\u05ea \u05d5\u05de\u05de\u05dc\u05d0\u05ea \u05d0\u05ea \u05d0\u05d6\u05d5\u05e8\u05d9 \u05d4\u05de\u05d2\u05d5\u05e8\u05d9\u05dd \u05d4\u05e4\u05e2\u05d9\u05dc\u05d9\u05dd (active living areas) \u05d5\u05e4\u05d5\u05d2\u05e2\u05ea \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05d1\u05e9\u05d9\u05de\u05d5\u05e9 \u05d4\u05de\u05d9\u05d5\u05e2\u05d3 \u05e9\u05dc\u05d4\u05dd (DSM p.278)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05e9\u05db\u05d9\u05d7\u05d5\u05ea \u05e9\u05dc \u05d4\u05de\u05e4\u05e8\u05d8 \"With excessive acquisition\" \u05d1\u05e7\u05e8\u05d1 \u05d4\u05e1\u05d5\u05d1\u05dc\u05d9\u05dd \u05de\u05d4\u05e4\u05e8\u05e2\u05ea \u05d0\u05d2\u05d9\u05e8\u05d4?",
      "back": "\u05db-$80\\%$ \u05e2\u05d3 $90\\%$ \u05de\u05d4\u05dc\u05d5\u05e7\u05d9\u05dd \u05d1\u05d4\u05e4\u05e8\u05e2\u05d4 \u05de\u05e6\u05d9\u05d2\u05d9\u05dd \u05e8\u05db\u05d9\u05e9\u05d4 \u05de\u05d5\u05d2\u05d6\u05de\u05ea \u05e9\u05dc \u05e4\u05e8\u05d9\u05d8\u05d9\u05dd \u05e9\u05d0\u05d9\u05e0\u05dd \u05e0\u05d7\u05d5\u05e6\u05d9\u05dd (DSM p.279)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05de\u05d4\u05dc\u05da \u05d4\u05d8\u05d9\u05e4\u05d5\u05e1\u05d9 (Course) \u05e9\u05dc \u05d4\u05e4\u05e8\u05e2\u05ea \u05d0\u05d2\u05d9\u05e8\u05d4 \u05de\u05d2\u05d9\u05dc \u05d4\u05d4\u05ea\u05d1\u05d2\u05e8\u05d5\u05ea \u05d5\u05e2\u05d3 \u05d4\u05d1\u05d2\u05e8\u05d5\u05ea?",
      "back": "\u05d4\u05ea\u05e1\u05de\u05d9\u05e0\u05d9\u05dd \u05de\u05d5\u05e4\u05d9\u05e2\u05d9\u05dd \u05d1\u05d2\u05d9\u05dc\u05d0\u05d9 $15-19$, \u05de\u05ea\u05d7\u05d9\u05dc\u05d9\u05dd \u05dc\u05d4\u05e4\u05e8\u05d9\u05e2 \u05dc\u05ea\u05e4\u05e7\u05d5\u05d3 \u05d1\u05d0\u05de\u05e6\u05e2 \u05e9\u05e0\u05d5\u05ea \u05d4-$20$, \u05d5\u05d2\u05d5\u05e8\u05de\u05d9\u05dd \u05dc\u05e4\u05d2\u05d9\u05e2\u05d4 \u05e7\u05dc\u05d9\u05e0\u05d9\u05ea \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05d1\u05d0\u05de\u05e6\u05e2 \u05e9\u05e0\u05d5\u05ea \u05d4-$30$ (DSM p.280)."
    },
    {
      "front": "\u05de\u05d4\u05dd \u05d4\u05d0\u05d6\u05d5\u05e8\u05d9\u05dd \u05d4\u05de\u05d5\u05d7\u05d9\u05d9\u05dd \u05e9\u05e4\u05d2\u05d9\u05e2\u05d4 \u05d1\u05d4\u05dd \u05e0\u05de\u05e6\u05d0\u05d4 \u05e7\u05e9\u05d5\u05e8\u05d4 \u05dc\u05d0\u05d2\u05d9\u05e8\u05d4 \u05e4\u05ea\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea (Hoarding symptoms)?",
      "back": "\u05d4-Anterior ventromedial prefrontal cortex \u05d5\u05d4-Cingulate cortex (DSM p.281)."
    },
    {
      "front": "\u05db\u05d9\u05e6\u05d3 \u05de\u05d1\u05d3\u05d9\u05dc\u05d9\u05dd \u05d1\u05d9\u05df \u05d0\u05d2\u05d9\u05e8\u05d4 \u05d1-OCD \u05dc\u05d1\u05d9\u05df Hoarding Disorder?",
      "back": "\u05d1-OCD \u05d4\u05d0\u05d2\u05d9\u05e8\u05d4 \u05d4\u05d9\u05d0 \u05ea\u05d5\u05e6\u05d0\u05d4 \u05e9\u05dc \u05d0\u05d5\u05d1\u05e1\u05e1\u05d9\u05d5\u05ea (\u05db\u05d2\u05d5\u05df \u05e4\u05d7\u05d3 \u05de\u05d6\u05d9\u05d4\u05d5\u05dd \u05d0\u05d5 \u05e4\u05d7\u05d3 \u05de\u05d4\u05d7\u05de\u05e6\u05ea \u05de\u05d9\u05d3\u05e2) \u05d5\u05d4\u05d9\u05d0 \u05dc\u05e8\u05d5\u05d1 \u05d0\u05d9\u05e0\u05d4 \u05e8\u05e6\u05d5\u05d9\u05d4 \u05d5\u05d2\u05d5\u05e8\u05de\u05ea \u05dc\u05de\u05e6\u05d5\u05e7\u05d4 \u05d2\u05d1\u05d5\u05d4\u05d4 (DSM p.281)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05e4\u05e1\u05d9\u05db\u05d5\u05ea\u05e8\u05e4\u05d9 \u05e9\u05e0\u05d7\u05e9\u05d1 \u05dc\u05e7\u05d5 \u05e8\u05d0\u05e9\u05d5\u05df \u05e2\u05d1\u05d5\u05e8 Hoarding Disorder?",
      "back": "CBT \u05d9\u05d9\u05e2\u05d5\u05d3\u05d9 \u05d4\u05db\u05d5\u05dc\u05dc \u05d0\u05d9\u05de\u05d5\u05df \u05d1\u05de\u05d9\u05d5\u05df (sorting), \u05e7\u05d1\u05dc\u05ea \u05d4\u05d7\u05dc\u05d8\u05d5\u05ea, \u05d7\u05e9\u05d9\u05e4\u05d4 \u05dc\u05d4\u05e9\u05dc\u05db\u05ea \u05d7\u05e4\u05e6\u05d9\u05dd \u05d5\u05de\u05e0\u05d9\u05e2\u05ea \u05e8\u05db\u05d9\u05e9\u05d4 (Dulcan p.377)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d9\u05e2\u05d9\u05dc\u05d5\u05ea \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05ea\u05e8\u05d5\u05e4\u05ea\u05d9 \u05d1-SSRIs \u05e2\u05d1\u05d5\u05e8 \u05ea\u05e1\u05de\u05d9\u05e0\u05d9 \u05d0\u05d2\u05d9\u05e8\u05d4 (Hoarding symptoms)?",
      "back": "\u05d4\u05ea\u05d2\u05d5\u05d1\u05d4 \u05e9\u05dc \u05ea\u05e1\u05de\u05d9\u05e0\u05d9 \u05d0\u05d2\u05d9\u05e8\u05d4 \u05dc-SSRIs \u05d4\u05d9\u05d0 \u05dc\u05e8\u05d5\u05d1 \u05de\u05d5\u05d2\u05d1\u05dc\u05ea \u05d5\u05e4\u05d7\u05d5\u05ea\u05d4 \u05d1\u05d4\u05e9\u05d5\u05d5\u05d0\u05d4 \u05dc\u05ea\u05d2\u05d5\u05d1\u05d4 \u05e9\u05dc \u05ea\u05e1\u05de\u05d9\u05e0\u05d9 OCD \u05e7\u05dc\u05d0\u05e1\u05d9\u05d9\u05dd (StahlNeuro p.576)."
    },
    {
      "front": "\u05d1\u05d0\u05d9\u05d6\u05d4 \u05de\u05d9\u05e0\u05d5\u05df \u05e9\u05dc SSRIs \u05e0\u05d4\u05d5\u05d2 \u05dc\u05d4\u05e9\u05ea\u05de\u05e9 \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-BDD \u05d5-OCD \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d5\u05e0\u05d5\u05e2\u05e8?",
      "back": "\u05dc\u05e8\u05d5\u05d1 \u05e0\u05d3\u05e8\u05e9\u05d9\u05dd \u05de\u05d9\u05e0\u05d5\u05e0\u05d9\u05dd \u05d2\u05d1\u05d5\u05d4\u05d9\u05dd (high doses), \u05dc\u05e2\u05d9\u05ea\u05d9\u05dd \u05de\u05e2\u05d1\u05e8 \u05dc\u05de\u05d9\u05e0\u05d5\u05e0\u05d9\u05dd \u05d4\u05de\u05e7\u05d5\u05d1\u05dc\u05d9\u05dd \u05d1-MDD, \u05db\u05d3\u05d9 \u05dc\u05d4\u05e9\u05d9\u05d2 \u05ea\u05d2\u05d5\u05d1\u05d4 \u05e7\u05dc\u05d9\u05e0\u05d9\u05ea (StahlKids p.202)."
    },
    {
      "front": "\u05de\u05d4 \u05de\u05d0\u05e4\u05d9\u05d9\u05df \u05d0\u05d2\u05d9\u05e8\u05ea \u05d7\u05d9\u05d5\u05ea (Animal Hoarding) \u05dc\u05e2\u05d5\u05de\u05ea \u05d0\u05d2\u05d9\u05e8\u05ea \u05d7\u05e4\u05e6\u05d9\u05dd?",
      "back": "\u05d0\u05d2\u05d9\u05e8\u05ea \u05d7\u05d9\u05d5\u05ea \u05de\u05d0\u05d5\u05e4\u05d9\u05d9\u05e0\u05ea \u05d1\u05ea\u05e0\u05d0\u05d9\u05dd \u05ea\u05d1\u05e8\u05d5\u05d0\u05ea\u05d9\u05d9\u05dd (sanitation) \u05e7\u05e9\u05d9\u05dd \u05d9\u05d5\u05ea\u05e8 \u05d5\u05d1\u05ea\u05d5\u05d1\u05e0\u05d4 (insight) \u05d9\u05e8\u05d5\u05d3\u05d4 \u05d9\u05d5\u05ea\u05e8 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea (DSM p.280)."
    },
    {
      "front": "\u05d0\u05d9\u05dc\u05d5 \u05de\u05e6\u05d1\u05d9\u05dd \u05e8\u05e4\u05d5\u05d0\u05d9\u05d9\u05dd \u05de\u05d4\u05d5\u05d5\u05d9\u05dd \u05d0\u05d1\u05d7\u05e0\u05d4 \u05de\u05d1\u05d3\u05dc\u05ea (Medical Mimics) \u05dc\u05d0\u05d2\u05d9\u05e8\u05d4 \u05e4\u05ea\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea?",
      "back": "\u05e4\u05d2\u05d9\u05e2\u05ea \u05de\u05d5\u05d7 \u05d8\u05e8\u05d0\u05d5\u05de\u05d8\u05d9\u05ea (TBI), \u05de\u05d7\u05dc\u05d4 \u05e6\u05e8\u05d1\u05e8\u05d5\u05d5\u05e1\u05e7\u05d5\u05dc\u05e8\u05d9\u05ea, \u05d5\u05ea\u05e1\u05de\u05d5\u05e0\u05ea Prader-Willi (DSM p.281)."
    },
    {
      "front": "\u05de\u05d4\u05d5 \u05e9\u05d9\u05e2\u05d5\u05e8 \u05d4\u05ea\u05d7\u05dc\u05d5\u05d0\u05d4 \u05d4\u05e0\u05dc\u05d5\u05d5\u05d9\u05ea \u05e9\u05dc \u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05d7\u05e8\u05d3\u05d4 \u05d1\u05e7\u05e8\u05d1 \u05d9\u05dc\u05d3\u05d9\u05dd \u05d5\u05e0\u05d5\u05e2\u05e8 \u05e2\u05dd OCD?",
      "back": "\u05e2\u05d3 \u05db\u05de\u05d7\u05e6\u05d9\u05ea ($50\\%$) \u05de\u05d4\u05d9\u05dc\u05d3\u05d9\u05dd \u05d5\u05d4\u05e0\u05d5\u05e2\u05e8 \u05e2\u05dd OCD \u05e1\u05d5\u05d1\u05dc\u05d9\u05dd \u05de\u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05d7\u05e8\u05d3\u05d4 \u05e0\u05dc\u05d5\u05d5\u05ea (Dulcan p.369)."
    },
    {
      "front": "\u05de\u05d4\u05d9 \u05d4\u05d4\u05de\u05dc\u05e6\u05d4 \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc\u05d9\u05ea \u05e2\u05d1\u05d5\u05e8 \u05de\u05d8\u05d5\u05e4\u05dc \u05e2\u05dd \u05e7\u05d5\u05de\u05d5\u05e8\u05d1\u05d9\u05d3\u05d9\u05d5\u05ea \u05e9\u05dc OCD \u05d5-Bipolar Disorder?",
      "back": "\u05d9\u05e9 \u05dc\u05d9\u05d9\u05e6\u05d1 \u05d0\u05ea \u05de\u05e6\u05d1 \u05d4\u05e8\u05d5\u05d7 (Mood stabilization) \u05dc\u05e4\u05e0\u05d9 \u05ea\u05d7\u05d9\u05dc\u05ea \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1-SSRIs, \u05e2\u05e7\u05d1 \u05d7\u05e9\u05e9 \u05de\u05d4\u05d7\u05de\u05e8\u05d4 \u05e9\u05dc \u05d4\u05d9\u05e4\u05d5\u05de\u05d0\u05e0\u05d9\u05d4 \u05d0\u05d5 Mixed states (Dulcan p.370)."
    }
  ]
