    {
      "type": "short_answer",
      "question": "\u05de\u05d8\u05d5\u05e4\u05dc \u05e2\u05dd OCD \u05de\u05e9\u05d5\u05db\u05e0\u05e2 \u05dc\u05d7\u05dc\u05d5\u05d8\u05d9\u05df \u05e9\u05d4\u05d0\u05d5\u05db\u05dc \u05e9\u05dc\u05d5 \u05de\u05d5\u05e8\u05e2\u05dc \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d2\u05d5\u05e8\u05de\u05d9\u05dd \u05e2\u05d5\u05d9\u05e0\u05d9\u05dd. \u05db\u05d9\u05e6\u05d3 \u05d9\u05e9 \u05dc\u05e7\u05d1\u05d5\u05e2 \u05d4\u05d0\u05dd \u05dc\u05d0\u05d1\u05d7\u05df \u05d4\u05e4\u05e8\u05e2\u05d4 \u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9\u05ea \u05e0\u05d5\u05e1\u05e4\u05ea \u05de\u05e2\u05d1\u05e8 \u05dc-OCD \u05dc\u05e4\u05d9 \u05d4-DSM-5-TR?",
      "grading": {
        "modelAnswer": "\u05d9\u05e9 \u05dc\u05d0\u05d1\u05d7\u05df \u05d4\u05e4\u05e8\u05e2\u05d4 \u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9\u05ea \u05e0\u05d5\u05e1\u05e4\u05ea \u05e8\u05e7 \u05d0\u05dd \u05ea\u05d5\u05db\u05df \u05d3\u05d7\u05e4\u05d9 \u05d4\u05e9\u05d5\u05d5\u05d0 (Delusional beliefs) \u05d7\u05d5\u05e8\u05d2 \u05de\u05e2\u05d1\u05e8 \u05dc\u05ea\u05d7\u05d5\u05de\u05d9 \u05d4-OCD \u05d4\u05d8\u05d9\u05e4\u05d5\u05e1\u05d9\u05d9\u05dd. \u05d0\u05dd \u05d4\u05ea\u05d5\u05db\u05df \u05e7\u05e9\u05d5\u05e8 \u05d9\u05e9\u05d9\u05e8\u05d5\u05ea \u05dc\u05d0\u05d5\u05d1\u05e1\u05e1\u05d9\u05d5\u05ea (\u05db\u05de\u05d5 \u05d6\u05d9\u05d4\u05d5\u05dd/\u05d4\u05e8\u05e2\u05dc\u05d4), \u05d9\u05e9 \u05dc\u05d4\u05e9\u05ea\u05de\u05e9 \u05d1\u05de\u05e4\u05e8\u05d8 'with absent insight/delusional beliefs' \u05d1\u05de\u05e7\u05d5\u05dd \u05d0\u05d1\u05d7\u05e0\u05d4 \u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9\u05ea \u05e0\u05e4\u05e8\u05d3\u05ea.",
        "rationale": "\u05d4-DSM-5-TR \u05e7\u05d5\u05d1\u05e2 \u05e9\u05d0\u05d9\u05df \u05dc\u05d0\u05d1\u05d7\u05df \u05d4\u05e4\u05e8\u05e2\u05d4 \u05e4\u05e1\u05d9\u05db\u05d5\u05d8\u05d9\u05ea \u05e0\u05d5\u05e1\u05e4\u05ea \u05d0\u05dd \u05d4\u05d0\u05de\u05d5\u05e0\u05d5\u05ea \u05d4\u05d3\u05dc\u05d5\u05d6\u05d9\u05d5\u05e0\u05dc\u05d9\u05d5\u05ea \u05de\u05d5\u05d2\u05d1\u05dc\u05d5\u05ea \u05dc\u05ea\u05d5\u05db\u05df \u05d4-OCD, \u05db\u05d3\u05d9 \u05dc\u05de\u05e0\u05d5\u05e2 \u05d0\u05d1\u05d7\u05d5\u05df \u05d9\u05ea\u05e8 \u05e9\u05dc \u05e1\u05db\u05d9\u05d6\u05d5\u05e4\u05e8\u05e0\u05d9\u05d4 (DSM p.265, p.108).",
        "requiredAttributes": [
