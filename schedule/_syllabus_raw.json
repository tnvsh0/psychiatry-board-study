u05d9\u05db\u05d5\u05e4\u05e8\u05de\u05e7\u05d5\u05dc\u05d5\u05d2\u05d9\u05d4 [48]\",\n  \"    \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea \u05e0\u05d5\u05e8\u05de\u05d8\u05d9\u05d1\u05d9\u05ea \u05d5\u05d4\u05d2\u05d9\u05dc \u05d4\u05e8\u05da [49]\",\n  \"      \u05ea\u05d4\u05dc\u05d9\u05db\u05d9 \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea [49]\",\n  \"      \u05d4\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea \u05e2\u05dc \u05e4\u05d9 \u05d4\u05ea\u05d9\u05d0\u05d5\u05e8\u05d9\u05d5\u05ea \u05d4\u05d1\u05d0\u05d5\u05ea [50]\",\n  \"      \u05de\u05d0\u05e4\u05d9\u05d9\u05e0\u05d9 \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea \u05dc\u05e4\u05d9 \u05d2\u05d9\u05dc\u05d9\u05dd [51]\",\n  \"      \u05d8\u05de\u05e4\u05e8\u05de\u05e0\u05d8 [51]\",\n  \"      \u05d4\u05ea\u05e7\u05e9\u05e8\u05d5\u05ea (attachment) [51]\",\n  \"      \u05d0\u05d1\u05d7\u05e0\u05d4 \u05d5\u05d0\u05d1\u05d7\u05e0\u05d4 \u05de\u05d1\u05d3\u05dc\u05ea \u05d1\u05d2\u05d9\u05dc \u05d4\u05d9\u05e0\u05e7\u05d5\u05ea [52]\",\n  \"      \u05d4\u05d3\u05de\u05d9\u05d5\u05ea \u05de\u05d5\u05d7 \u05d1\u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9\u05d4 [53]\",\n  \"      \u05d2\u05e0\u05d8\u05d9\u05e7\u05d4 \u05d1\u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9\u05d4 \u05e9\u05dc \u05d4\u05d9\u05dc\u05d3 [53]\",\n  \"      \u05e0\u05d5\u05d9\u05e8\u05d5\u05d0\u05e0\u05d8\u05d5\u05de\u05d9\u05d4 \u05d5\u05e0\u05d5\u05d9\u05e8\u05d5\u05e4\u05d9\u05d6\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05d4 [54]\",\n  \"      \u05e0\u05d5\u05d9\u05e8\u05d5\u05d1\u05d9\u05d5\u05db\u05d9\u05de\u05d9\u05d4 [55]\",\n  \"      \u05e0\u05d5\u05d9\u05e8\u05d5\u05d0\u05e0\u05d3\u05d5\u05e7\u05e8\u05d9\u05e0\u05d5\u05dc\u05d5\u05d2\u05d9\u05d4 [55]\",\n  \"      \u05de\u05d0\u05d2\u05e8 \u05e9\u05d0\u05dc\u05d5\u05ea \u05d1\u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea, \u05d2\u05e0\u05d8\u05d9\u05e7\u05d4, \u05e0\u05d5\u05d9\u05e8\u05d5\u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05d4 \u05d5\u05d4\u05d2\u05d9\u05dc \u05d4\u05e8\u05da [55]\",\n  \"    \u05e0\u05d5\u05d9\u05e8\u05d5\u05dc\u05d5\u05d2\u05d9\u05d4 [56]\",\n  \"      \u05e0\u05d5\u05e9\u05d0\u05d9\u05dd [56]\",\n  \"        1. \u05e0\u05d5\u05d9\u05e8\u05d5\u05d0\u05e0\u05d8\u05d5\u05de\u05d9\u05d4 \u05d5\u05e0\u05d5\u05d9\u05e8\u05d5\u05e4\u05d9\u05d6\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05d4 [56]\",\n  \"        2. \u05d4\u05d1\u05d3\u05d9\u05e7\u05d4 \u05d4\u05e0\u05d5\u05d9\u05e8\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea [57]\",\n  \"        3. \u05d4\u05e2\u05e8\u05db\u05d4 \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9\u05ea \u05d5\u05e7\u05d5\u05d2\u05e0\u05d9\u05d8\u05d9\u05d1\u05d9\u05ea [57]\",\n  \"        4. \u05e1\u05d9\u05de\u05e0\u05d9\u05dd, \u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd \u05d5\u05e1\u05d9\u05e0\u05d3\u05e8\u05d5\u05de\u05d9\u05dd \u05d4\u05e7\u05e9\u05d5\u05e8\u05d9\u05dd \u05d1\u05e9\u05d9\u05e0\u05d5\u05d9 \u05d1\u05de\u05e6\u05d1 \u05d4\u05d4\u05db\u05e8\u05d4 [58]\",\n  \"        5. \u05d4\u05d3\u05de\u05d9\u05d9\u05ea \u05de\u05d5\u05d7 \u05d1\u05e0\u05d5\u05d9\u05e8\u05d5\u05dc\u05d5\u05d2\u05d9\u05d4 [58]\",\n  \"        6. \u05e4\u05d2\u05d9\u05e2\u05d5\u05ea \u05d8\u05e8\u05d0\u05d5\u05de\u05d8\u05d9\u05d5\u05ea (\u05d7\u05d1\u05dc\u05d5\u05ea \u05e8\u05d0\u05e9) \u05d5\u05d4\u05e9\u05dc\u05db\u05d5\u05ea \u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9\u05d5\u05ea [58]\",\n  \"        7. \u05d6\u05d9\u05d4\u05d5\u05de\u05d9\u05dd \u05d1\u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05e2\u05e6\u05d1\u05d9\u05dd \u05d4\u05de\u05e8\u05db\u05d6\u05d9\u05ea [59]\",\n  \"        8. \u05d0\u05e4\u05d9\u05dc\u05e4\u05e1\u05d9\u05d4 [59]\",\n  \"        9. \u05e9\u05d9\u05ea\u05d5\u05e7 \u05de\u05d5\u05d7\u05d9\u05df [60]\",\n  \"        10. \u05d2\u05d9\u05d3\u05d5\u05dc\u05d9 \u05de\u05d5\u05d7 [60]\",\n  \"        11. \u05de\u05d7\u05dc\u05d5\u05ea \u05e0\u05d5\u05d9\u05e8\u05d5\u05d3\u05d2\u05e0\u05e8\u05d8\u05d9\u05d1\u05d9\u05d5\u05ea [61]\",\n  \"        12. \u05de\u05d7\u05dc\u05d5\u05ea \u05e0\u05d5\u05d9\u05e8\u05d5\u05e7\u05d5\u05d8\u05e0\u05d0\u05d9\u05d5\u05ea [61]\",\n  \"        13. \u05db\u05d0\u05d1 \u05e8\u05d0\u05e9 \u05d5\u05de\u05d9\u05d2\u05e8\u05e0\u05d4 [61]\",\n  \"        14. \u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05ea\u05e0\u05d5\u05e2\u05d4 [62]\",\n  \"        15. \u05ea\u05e1\u05de\u05d5\u05e0\u05d5\u05ea \u05e0\u05d5\u05d9\u05e8\u05d5\u05d2\u05e0\u05d8\u05d9\u05d5\u05ea \u05d1\u05e2\u05dc\u05d5\u05ea \u05d4\u05e9\u05dc\u05db\u05d4 \u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9\u05ea [62]\",\n  \"        16. \u05d4\u05e4\u05e8\u05e2\u05d5\u05ea \u05d4\u05ea\u05e4\u05ea\u05d7\u05d5\u05ea\u05d9\u05d5\u05ea \u05d5\u05de\u05d1\u05e0\u05d9\u05d5\u05ea \u05e9\u05dc \u05d4\u05de\u05d5\u05d7 [62]\",\n  \"        17. \u05de\u05d7\u05dc\u05d5\u05ea \u05de\u05d8\u05d1\u05d5\u05dc\u05d9\u05d5\u05ea \u05e2\u05dd \u05d1\u05d9\u05d8\u05d5\u05d9\u05d9\u05dd \u05e4\u05e1\u05d9\u05db\u05d9\u05d0\u05d8\u05e8\u05d9\u05d9\u05dd \u05d0\u05e4\u05e9\u05e8\u05d9\u05d9\u05dd [63]\",\n  \"        18. \u05de\u05d7\u05dc\u05d5\u05ea \u05d0\u05d5\u05d8\u05d5\u05d0\u05d9\u05de\u05d5\u05e0\u05d9\u05d5\u05ea [63]\",\n  \"      \u05e9\u05d0\u05dc\u05d5\u05ea [63]\",\n  \"        \u05d4\u05d3\u05de\u05d9\u05d4 \u05d5\u05d0\u05e0\u05d8\u05d5\u05de\u05d9\u05d4 [63]\",\n  \"        \u05d1\u05d3\u05d9\u05e7\u05d4 \u05e0\u05d5\u05d9\u05e8\u05d5\u05dc\u05d5\u05d2\u05d9\u05ea [63]\"\n]\n```",
