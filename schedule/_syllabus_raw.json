8\u05d2\u05e2\u05d9\u05dd \u05de\u05e8\u05d2\u05e9\u05d9\u05dd \u05d5\u05de\u05ea\u05e1\u05db\u05dc\u05d9\u05dd [30]\",\n  \"        \u05d0\u05d9\u05e8\u05d5\u05e2\u05d9\u05dd \u05de\u05e6\u05d9\u05d0\u05d5\u05ea\u05d9\u05d9\u05dd, \u05d7\u05e9\u05d9\u05e4\u05d4 \u05e2\u05e6\u05de\u05d9\u05ea \u05e9\u05dc \u05d4\u05de\u05d8\u05e4\u05dc, enactment [30]\",\n  \"        \u05d4\u05d3\u05e8\u05db\u05d4 [31]\",\n  \"        \u05d7\u05dc\u05d5\u05de\u05d5\u05ea \u05d1\u05d8\u05d9\u05e4\u05d5\u05dc [31]\",\n  \"        \u05ea\u05d4\u05dc\u05d9\u05db\u05d9\u05dd \u05de\u05e7\u05d3\u05de\u05d9\u05dd/\u05de\u05e8\u05e4\u05d0\u05d9\u05dd \u05d1\u05d8\u05d9\u05e4\u05d5\u05dc [32]\",\n  \"        \u05de\u05e2\u05e6\u05d5\u05e8\u05d9\u05dd/\u05e7\u05e9\u05d9\u05d9\u05dd \u05e9\u05d9\u05e9 \u05dc\u05d4\u05ea\u05d9\u05d9\u05d7\u05e1 \u05d0\u05dc\u05d9\u05d4\u05dd \u05d1\u05d8\u05d9\u05e4\u05d5\u05dc [32]\",\n  \"        \u05e1\u05d9\u05d5\u05dd \u05d8\u05d9\u05e4\u05d5\u05dc [33]\",\n  \"        \u05d4\u05d1\u05e0\u05ea \u05d4\u05de\u05e7\u05e8\u05d4 [33]\",\n  \"        \u05d0\u05d9\u05e0\u05d8\u05d2\u05e8\u05e6\u05d9\u05d4 \u05d1\u05d9\u05df \u05d4\u05d1\u05e0\u05ea \u05d4\u05de\u05e7\u05e8\u05d4 \u05dc\u05ea\u05d9\u05d0\u05d5\u05e8\u05d9\u05d4 [34]\",\n  \"        \u05d4\u05de\u05e9\u05d7\u05e7 \u05d1\u05d8\u05d9\u05e4\u05d5\u05dc [35]\",\n  \"        \u05db\u05dc\u05dc\u05d9 [35]\",\n  \"        \u05d0\u05e0\u05d4 \u05e4\u05e8\u05d5\u05d9\u05d3-\u05de\u05dc\u05e0\u05d9 \u05e7\u05dc\u05d9\u05d9\u05df [36]\",\n  \"        \u05e7\u05d5\u05d4\u05d5\u05d8 [36]\",\n  \"        Attachment theory and reflective function/metallization [37]\",\n  \"        \u05d1\u05d7\u05d9\u05e8\u05ea \u05e1\u05d5\u05d2 \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc [37]\",\n  \"        \u05d4\u05d7\u05d5\u05d6\u05d4 \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc\u05d9 [38]\",\n  \"        \u05d4\u05d1\u05e8\u05d9\u05ea \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc\u05d9\u05ea [39]\",\n  \"        \u05e1\u05d5\u05d3\u05d9\u05d5\u05